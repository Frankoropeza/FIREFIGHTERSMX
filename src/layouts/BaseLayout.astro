---
import '../styles/global.css';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import SEO from '@components/common/SEO.astro';
import WhatsAppButton from '@components/common/WhatsAppButton.astro';
import { CONTACTO_DIRECTO_ACTIVO } from '@config/site';

export interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
  noBrandSuffix?: boolean;
  schema?: object | object[];
}

const {
  title,
  description,
  canonicalURL = Astro.url.href,
  ogImage = '/images/og-default.jpg',
  ogType = 'website',
  noindex = false,
  noBrandSuffix = false,
  schema,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es-MX" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Inter autoalojada (public/fonts): sin dominios de terceros, preload del archivo
         variable y fallback con métricas ajustadas (ver global.css) → sin salto de layout. -->
    <link rel="preload" href="/fonts/inter-latin-var.woff2" as="font" type="font/woff2" crossorigin />

    <!-- SEO Component -->
    <SEO
      title={title}
      description={description}
      canonicalURL={canonicalURL}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      noBrandSuffix={noBrandSuffix}
      schema={schema}
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#FFFFFF" />

    <!-- Slot for extra head content -->
    <slot name="head" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    <!-- Ahrefs Web Analytics -->
    <link rel="preconnect" href="https://analytics.ahrefs.com" />
    <script is:inline src="https://analytics.ahrefs.com/analytics.js" data-key="V39kZsbF0O5bbTDIvVBtPA" async></script>
  </head>
  <body class="min-h-screen flex flex-col" style="background-color:#FFFFFF;color:#344054">
    <!-- Skip to main content (accesibilidad) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50
             btn-primary py-2 px-4 rounded-lg text-sm font-semibold"
    >
      Ir al contenido principal
    </a>

    <!-- Header -->
    <Header />

    <!-- Main Content -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- Interlinking: barra de secciones arriba del footer (todo el sitio) -->
    <QuickLinksBar variant="footer" />

    <!-- Footer -->
    <Footer />

    {/* Botón flotante de WhatsApp: sólo con un número real publicado */}
    {CONTACTO_DIRECTO_ACTIVO && <WhatsAppButton />}


    <!-- Analytics (carga diferida) -->
    <slot name="analytics" />
  </body>
</html>
