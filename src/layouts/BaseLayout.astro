---
import '../styles/global.css';
import Header from '@components/common/Header.astro';
import Footer from '@components/common/Footer.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import SEO from '@components/common/SEO.astro';
import WhatsAppButton from '@components/common/WhatsAppButton.astro';

export interface Props {
  title: string;
  description: string;
  canonicalURL?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
  noBrandSuffix?: boolean;
  schema?: object | object[];
}

const {
  title,
  description,
  canonicalURL = Astro.url.href,
  ogImage = '/images/og-default.jpg',
  ogType = 'website',
  noindex = false,
  noBrandSuffix = false,
  schema,
} = Astro.props;
---
<!DOCTYPE html>
<html lang="es-MX" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <!-- Fonts: preconnect + hoja no bloqueante (sustituye al @import de CSS) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Rajdhani:wght@500;600;700&family=Sora:wght@300;400;500;600;700&display=swap"
    />

    <!-- SEO Component -->
    <SEO
      title={title}
      description={description}
      canonicalURL={canonicalURL}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      noBrandSuffix={noBrandSuffix}
      schema={schema}
    />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#040A12" />

    <!-- Slot for extra head content -->
    <slot name="head" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
  </head>
  <body class="min-h-screen flex flex-col" style="background-color:#040A12;color:#CBD5E1">
    <!-- Skip to main content (accesibilidad) -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50
             btn-primary py-2 px-4 rounded-lg text-sm font-semibold"
    >
      Ir al contenido principal
    </a>

    <!-- Header -->
    <Header />

    <!-- Main Content -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- Interlinking: barra de secciones arriba del footer (todo el sitio) -->
    <QuickLinksBar variant="footer" />

    <!-- Footer -->
    <Footer />

    <!-- WhatsApp Floating Button -->
    <WhatsAppButton />


    <!-- Analytics (carga diferida) -->
    <slot name="analytics" />
  </body>
</html>
