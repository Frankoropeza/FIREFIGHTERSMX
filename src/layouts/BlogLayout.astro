---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { whatsappUrl } from '@config/site';
import { slugifyTag } from '@lib/slug';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, author, category, tags, image } = post.data;

const readingTime = Math.ceil((post.body ?? '').split(' ').length / 200);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: image?.url ?? '/images/og-default.jpg',
  author: { '@type': 'Person', name: author },
  publisher: {
    '@type': 'Organization',
    name: 'FIREFIGHTERS MX',
    logo: { '@type': 'ImageObject', url: 'https://firefighters.mx/logo.png', width: 512, height: 512 },
  },
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  mainEntityOfPage: Astro.url.href,
};
---
<BaseLayout
  title={`${title} | Blog FIREFIGHTERS MX`}
  description={description}
  ogType="article"
  ogImage={image?.url}
  schema={articleSchema}
>
  <!-- LCP preload hint -->
  {image?.url && (
    <link slot="head" rel="preload" as="image" href={image.url} fetchpriority="high" />
  )}

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:#4A7599">
        <li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/blog" class="hover:text-[#FF6B26]">Blog</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:#94A3B8" class="truncate" aria-current="page">{title}</span></li>
      </ol>
    </div>
  </nav>

  <article class="section" style="background:#040A12">
    <div class="container-site" style="max-width:52rem">

      <!-- Meta -->
      <div class="flex flex-wrap items-center gap-2 mb-6">
        <span class="badge badge-fire">{category}</span>
        {tags?.map((tag: string) => (
          <a href={`/blog/tag/${slugifyTag(tag)}`} class="badge badge-dark hover:text-[#FF6B26]">{tag}</a>
        ))}
      </div>

      <!-- Título -->
      <h1 class="font-display font-bold mb-6 text-balance" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">{title}</h1>

      <!-- Meta del artículo (autor + lectura, sin fecha) -->
      <div class="flex flex-wrap items-center gap-6 text-sm pb-8 mb-10" style="color:#94A3B8;border-bottom:1px solid rgba(74,117,153,0.18)">
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="#FF6B26" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
          </svg>
          <span class="font-display font-semibold" style="color:#E2E8F0">{author}</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="#FF6B26" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <span>{readingTime} min de lectura</span>
        </div>
      </div>

      <!-- Imagen hero -->
      {image && (
        <figure class="mb-10 overflow-hidden" style="border:1px solid rgba(74,117,153,0.18)">
          <img
            src={image.url}
            alt={image.alt}
            class="w-full aspect-video object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="800"
            height="450"
          />
          {image.caption && (
            <figcaption class="text-center text-sm mt-3 italic" style="color:#64748B">{image.caption}</figcaption>
          )}
        </figure>
      )}

      <!-- Contenido del artículo -->
      <div class="prose prose-invert prose-lg max-w-none
                  prose-headings:font-display prose-headings:text-white
                  prose-h2:text-2xl prose-h3:text-xl
                  prose-p:text-[#CBD5E1]
                  prose-li:text-[#CBD5E1]
                  prose-strong:text-white
                  prose-a:text-[#FF8F57] prose-a:no-underline hover:prose-a:underline
                  prose-code:text-[#FFB088] prose-code:bg-[#0C1825] prose-code:rounded prose-code:px-1.5 prose-code:py-0.5
                  prose-img:rounded prose-img:border prose-img:border-[rgba(74,117,153,0.18)]
                  prose-blockquote:border-l-4 prose-blockquote:border-[#F75000] prose-blockquote:bg-[#0C1825] prose-blockquote:text-[#E2E8F0]
                  prose-th:text-white prose-td:text-[#CBD5E1]">
        <slot />
      </div>

      <!-- CTA post-artículo -->
      <div class="mt-12 p-8 text-center" style="background:linear-gradient(135deg, #0C1825 0%, rgba(247,80,0,0.14) 130%);border:1px solid rgba(247,80,0,0.3)">
        <h2 class="font-display font-bold text-2xl mb-3" style="color:#FFFFFF">¿Necesitas asesoría o cotización?</h2>
        <p class="mb-6" style="color:#94A3B8">Nuestros especialistas te ayudan a elegir el equipo correcto según norma.</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href={whatsappUrl(`Hola, leí el artículo "${title}" y quiero asesoría.`)} target="_blank" rel="noopener" class="btn btn-primary">Cotizar por WhatsApp</a>
          <a href="/contacto" class="btn btn-ghost">Contáctanos</a>
        </div>
      </div>

      <!-- Volver al blog -->
      <div class="mt-8">
        <a href="/blog" class="inline-flex items-center gap-2 text-sm font-display font-semibold uppercase tracking-wider" style="color:#FF6B26;letter-spacing:0.08em">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5M11 5l-7 7 7 7"/>
          </svg>
          Volver al blog
        </a>
      </div>

    </div>
  </article>
</BaseLayout>
