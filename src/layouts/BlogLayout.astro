---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { portadaBlog } from '@lib/portada-blog';
import { whatsappUrl, CANAL_CONTACTO } from '@config/site';
import { slugifyTag } from '@lib/slug';
import RelatedLinks from '@components/common/RelatedLinks.astro';
import { faqSchemaDesdeMarkdown } from '@lib/faq-blog';
import { giroDeBlog } from '@lib/enlaces-directorio';

export interface Props {
  post: CollectionEntry<'blog'>;
  headings?: { depth: number; slug: string; text: string }[];
}

const { post, headings = [] } = Astro.props;

// Índice «En este artículo»: H2 del cuerpo sin la sección de fuentes; sólo si hay 4 o más.
const indice = headings.filter((h) => h.depth === 2 && !/^(Fuentes|Referencias)$/i.test(h.text.trim()));
const { title, seoTitle, description, pubDate, updatedDate, author, category, tags } = post.data;
const image = portadaBlog(post);

const readingTime = Math.ceil((post.body ?? '').split(' ').length / 200);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: image?.url ?? '/images/og-default.jpg',
  author: { '@type': 'Person', name: author },
  publisher: {
    '@type': 'Organization',
    name: 'FIREFIGHTERS MX',
    logo: { '@type': 'ImageObject', url: 'https://firefighters.mx/logo.png', width: 512, height: 512 },
  },
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  mainEntityOfPage: Astro.url.href,
};

// FAQPage derivado de la sección «Preguntas frecuentes» visible del artículo.
const faqSchema = faqSchemaDesdeMarkdown(post.body);
---
{/* Sin sufijo fijo en el title: los titulares de blog ya son largos y el
    sufijo sólo provocaba que Google truncara. SEO.astro lo anexa si cabe. */}
<BaseLayout
  title={seoTitle ?? title}
  description={description}
  ogType="article"
  ogImage={image?.url}
  schema={faqSchema ? [articleSchema, faqSchema] : articleSchema}
>
  <!-- LCP preload hint -->
  {image?.url && (
    <link slot="head" rel="preload" as="image" href={image.url} fetchpriority="high" />
  )}

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:var(--c-bg-alt);border-bottom:1px solid var(--c-line)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0 min-w-0" style="color:var(--forge-300)">
        <li><a href="/" class="hover:text-[var(--c-accent)]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/blog" class="hover:text-[var(--c-accent)]">Blog</a></li>
        <li aria-hidden="true">/</li>
        <li class="min-w-0"><span style="color:var(--c-text-2)" class="block truncate" aria-current="page">{title}</span></li>
      </ol>
    </div>
  </nav>

  <article class="section" style="background:var(--c-bg)">
    <div class="container-site" style="max-width:52rem">

      <!-- Meta -->
      <div class="flex flex-wrap items-center gap-2 mb-6">
        <span class="badge badge-fire">{category}</span>
        {tags?.map((tag: string) => (
          <a href={`/blog/tag/${slugifyTag(tag)}`} class="badge badge-dark hover:text-[var(--c-accent)]">{tag}</a>
        ))}
      </div>

      <!-- Título -->
      <h1 class="font-display font-bold mb-6 text-balance" style="color:var(--c-ink);font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">{title}</h1>

      <!-- Meta del artículo (autor + lectura, sin fecha) -->
      <div class="flex flex-wrap items-center gap-6 text-sm pb-8 mb-10" style="color:var(--c-text-2);border-bottom:1px solid var(--c-line)">
        <div class="flex items-center gap-2">
          
          <span class="font-display font-semibold" style="color:var(--c-ink-2)">{author}</span>
        </div>
        <div class="flex items-center gap-2">
          
          <span>{readingTime} min de lectura</span>
        </div>
      </div>

      <!-- Imagen hero -->
      {image && (
        <figure class="mb-10 overflow-hidden" style="border:1px solid var(--c-line)">
          <img
            src={image.url}
            alt={image.alt}
            class="w-full aspect-video object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="800"
            height="450"
          />
          {image.caption && (
            <figcaption class="text-center text-sm mt-3 italic" style="color:var(--c-muted)">{image.caption}</figcaption>
          )}
        </figure>
      )}

      <!-- Índice del artículo (H2). <details> nativo: sin animación. -->
      {indice.length >= 4 && (
        <nav class="mb-10 p-6" aria-label="Contenido del artículo" style="background:var(--c-surface);border:1px solid var(--c-line)">
          <details open>
            <summary class="font-display font-bold text-sm uppercase cursor-pointer" style="color:var(--c-ink);letter-spacing:0.08em">En este artículo</summary>
            <ul class="mt-4 space-y-2 list-none p-0 m-0">
              {indice.map((h) => (
                <li><a href={`#${h.slug}`} class="text-sm hover:underline" style="color:var(--c-text)">{h.text}</a></li>
              ))}
            </ul>
          </details>
        </nav>
      )}

      <!-- Contenido del artículo -->
      <div class="prose prose-lg max-w-none min-w-0 prose-table:block prose-table:overflow-x-auto prose-table:whitespace-nowrap sm:prose-table:whitespace-normal prose-headings:font-display prose-headings:text-[var(--c-ink)] prose-headings:tracking-[-0.02em] prose-h2:text-2xl prose-h3:text-xl prose-p:text-[var(--c-text)] prose-li:text-[var(--c-text)] prose-strong:text-[var(--c-ink-2)] prose-a:text-[var(--c-accent)] prose-a:font-medium prose-a:no-underline hover:prose-a:underline prose-code:text-[#C8102E] prose-code:bg-[var(--c-surface-2)] prose-code:rounded prose-code:px-1.5 prose-code:py-0.5 prose-img:rounded prose-img:border prose-img:border-[var(--c-line)] prose-blockquote:border-l-4 prose-blockquote:border-[var(--c-line-strong)] prose-blockquote:bg-[var(--c-bg-alt)] prose-blockquote:text-[var(--c-ink-2)] prose-th:text-[var(--c-ink)] prose-th:bg-[var(--c-bg-alt)] prose-td:text-[var(--c-text)]">
        <slot />
      </div>

      <!-- CTA post-artículo -->
      <RelatedLinks ruta={`/blog/${post.id}/`} giro={giroDeBlog(category)} />

      <div class="mt-12 p-8 text-center" style="background:var(--c-bg-alt);border:1px solid var(--c-line)">
        <h2 class="font-display font-bold text-2xl mb-3" style="color:var(--c-ink)">¿Necesitas asesoría o cotización?</h2>
        <p class="mb-6" style="color:var(--c-text-2)">Nuestros especialistas te ayudan a elegir el equipo correcto según norma.</p>
        <div class="flex flex-wrap justify-center gap-3">
          <a href={whatsappUrl(`Hola, leí el artículo "${title}" y quiero asesoría.`)} target="_blank" rel="noopener" class="btn btn-primary">Cotizar por {CANAL_CONTACTO}</a>
          <a href="/contacto" class="btn btn-ghost">Contáctanos</a>
        </div>
      </div>

      <!-- Volver al blog -->
      <div class="mt-8">
        <a href="/blog" class="inline-flex items-center gap-2 text-sm font-display font-semibold uppercase tracking-wider" style="color:var(--c-accent);letter-spacing:0.08em">
          
          Volver al blog
        </a>
      </div>

    </div>
  </article>
</BaseLayout>
