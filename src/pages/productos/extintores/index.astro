    { label: 'Guía para solicitar cotización', href: '/cotizacion/', text: 'Datos para comparar propuestas.' },
  ],
  sources: [
    { label: 'NOM-154-SCFI-2005 — Diario Oficial de la Federación', href: 'https://dof.gob.mx/normasOficiales/791/NOM-154-SCFI-2005/NOM-154-SCFI-2005.htm' },
    { label: 'NOM-002-STPS-2010 — Diario Oficial de la Federación', href: 'https://dof.gob.mx/normasOficiales/4228/stps.htm' },
    { label: 'NFPA 10 — información oficial', href: 'https://www.nfpa.org/10' },
  ],
  directoryHeading: 'Localiza proveedores de extintores y confirma disponibilidad directamente.',
  directoryHref: '/empresas/extintores/', directoryLabel: 'Buscar empresas de extintores',
