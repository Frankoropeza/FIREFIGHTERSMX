---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import ProductCard from '@components/products/ProductCard.astro';
import { categories } from '@data/categories';
import { featuredProducts } from '@data/products';
import { SITE, whatsappUrl } from '@config/site';

const cat = categories.find((c) => c.slug === 'extintores')!;
const canonicalURL = `${SITE.url}/productos/extintores/`;

const seoMeta = {
  title: `Extintores Certificados NOM-154-SCFI y NFPA 10 — Venta, Recarga y Mantenimiento · México`,
  description: 'Extintores certificados NOM-154-SCFI y NFPA 10 en México: PQS ABC, CO₂, Tipo K y agente limpio. Venta, recarga con collar de garantía y mantenimiento con reporte para Protección Civil.',
  canonicalURL,
};

/* ── Productos por línea ─────────────────────────────────────────────────── */
const pqsProducts = featuredProducts.filter(
  (p) => p.category === 'Extintores' && p.brand === 'PQS ABC'
);
const co2Products = featuredProducts.filter(
  (p) => p.category === 'Extintores' && p.brand === 'CO₂'
);
const especializadosProducts = featuredProducts.filter(
  (p) => p.category === 'Extintores' && p.brand === 'Especializados'
);
const ruedaProducts = featuredProducts.filter(
  (p) => p.category === 'Extintores' && p.brand === 'Sobre Ruedas'
);

/* Tipos de agente (educativo — 6 tipos) */
const tipos = [
  {
    title: 'PQS ABC',
    norm: 'NOM-154-SCFI · NFPA 10',
    accent: '#F75000',
    desc: 'Polvo químico seco multiuso para fuegos clase A, B y C. El estándar obligatorio en oficinas, comercios, bodegas e industria general. De 1 kg a 12 kg.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M15 6v-3a3 3 0 0 0-6 0v3"/><rect x="6" y="6" width="12" height="14" rx="2"/><path d="M12 10v4M10 12h4"/></svg>`,
  },
  {
    title: 'CO₂',
    norm: 'NOM-100-SCFI · NFPA 10',
    accent: '#60A5FA',
    desc: 'Dióxido de carbono sin residuo para fuegos clase B y C. La única opción segura para tableros eléctricos, servidores y equipos electrónicos de alto valor.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path d="M9 10a3 3 0 0 1 6 0c0 2-3 3-3 3"/><path d="M12 16h.01"/></svg>`,
  },
  {
    title: 'Agua',
    norm: 'NOM-154-SCFI · NFPA 10',
    accent: '#38BDF8',
    desc: 'El agente más ecológico para fuegos clase A: sólidos combustibles como madera, papel y cartón. Sin residuo tóxico. NUNCA usar en presencia de corriente eléctrica.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>`,
  },
  {
    title: 'Espuma AFFF',
    norm: 'NOM-154-SCFI · NFPA 11',
    accent: '#FB923C',
    desc: 'Espuma formadora de película acuosa para fuegos clase A y B. Sella la superficie del combustible e impide la re-ignición — el más eficaz para hidrocarburos derramados.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3C8 7 6 11 6 14a6 6 0 0 0 12 0c0-3-2-7-6-11z"/><path d="M9 14s1 1 3 1 3-1 3-1"/></svg>`,
  },
  {
    title: 'Tipo K',
    norm: 'NOM-154-SCFI · UL 300',
    accent: '#F5A623',
    desc: 'Acetato de potasio para fuegos clase K: aceites y grasas vegetales y animales a alta temperatura. Obligatorio en cocinas industriales y restaurantes con freidoras.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2c-4 4-6 8-6 11a6 6 0 0 0 12 0c0-3-2-7-6-11z"/><path d="M12 12v4"/></svg>`,
  },
  {
    title: 'Agente Limpio',
    norm: 'NFPA 2001 · UL 2129',
    accent: '#34D399',
    desc: 'HFC-227ea (FM-200) para data centers y salas de control. Extinción en segundos sin residuo, sin daño a equipos, espacio habitable e ininterrumpible tras descarga.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="4"/><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/></svg>`,
  },
];

/* Trust Pillars */
const razones = [
  {
    n: '01',
    t: 'Certificación NOM-154-SCFI verificable',
    d: 'Todos los extintores incluyen etiqueta NOM con número de dictamen verificable ante la SE. Documentación completa para Protección Civil, IMSS, STPS y dictámenes de bomberos.',
  },
  {
    n: '02',
    t: 'Recarga con collar de garantía',
    d: 'Recargamos con agente original certificado y colocamos collar de garantía con fecha de recarga, técnico responsable y próxima revisión — el estándar que exige cualquier inspección de NOM-002-STPS.',
  },
  {
    n: '03',
    t: 'Programa anual de mantenimiento',
    d: 'Administramos tu inventario y te avisamos cuándo vence la inspección, la recarga y la prueba hidrostática. Sin sorpresas en auditorías de Protección Civil, STPS o aseguradoras.',
  },
  {
    n: '04',
    t: 'Capacitación de uso básico incluida',
    d: 'Cada compra institucional incluye capacitación básica de uso con el método PASS y el plan de evacuación. Registros de asistencia para tu expediente de la brigada de emergencias.',
  },
];

/* Tabla: qué extintor para qué fuego */
const tabla = [
  { clase: 'A — Sólidos',        ejemplo: 'Madera · papel · tela · plástico',      pqs: '✓ Recomendado', co2: '—',       tipok: '—',              limpio: '—',       ruedas: '✓' },
  { clase: 'B — Líquidos',       ejemplo: 'Gasolina · aceite · solvente · pintura', pqs: '✓ Recomendado', co2: '✓',       tipok: '—',              limpio: '✓',       ruedas: '✓' },
  { clase: 'C — Eléctrico',      ejemplo: 'Tableros · motores · cableado vivo',     pqs: '✓',             co2: '✓ Ideal', tipok: '—',              limpio: '✓ Ideal', ruedas: '—' },
  { clase: 'D — Metales',        ejemplo: 'Magnesio · titanio · litio',             pqs: '—',             co2: '—',       tipok: '—',              limpio: '—',       ruedas: 'Agente D' },
  { clase: 'K — Aceites/grasas', ejemplo: 'Freidoras · cocinas industriales',       pqs: '—',             co2: '—',       tipok: '✓ Único válido', limpio: '—',       ruedas: '—' },
];

/* Servicios */
const servicios = [
  {
    n: '01',
    t: 'Recarga certificada',
    d: 'Recarga de todos los tipos de agente (PQS, CO₂, Tipo K, espuma) con collar de garantía, etiqueta de inspección vigente y reporte documental para tu expediente de Protección Civil. Conforme NOM-154-SCFI.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 4v5h.582m15.356 2A8.001 8.001 0 0 0 4.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 0 1-15.357-2m15.357 2H15"/></svg>`,
  },
  {
    n: '02',
    t: 'Inspección y mantenimiento anual',
    d: 'Programa anual conforme a NOM-002-STPS: revisión de presión, válvula, manguera, precinto y etiqueta. Reporte firmado por técnico certificado para tu expediente ante el IMSS, STPS y autoridades de PC.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M9 12l2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>`,
  },
  {
    n: '03',
    t: 'Prueba hidrostática',
    d: 'Prueba obligatoria de presión del cilindro cada 5 años (PQS y CO₂). Garantiza la integridad estructural del recipiente bajo presión. Bitácora con número de serie, presión de prueba y resultado, lista para auditoría.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>`,
  },
  {
    n: '04',
    t: 'Señalización y ubicación',
    d: 'Instalación de soportes murales, señalamientos NOM-003-SEGOB y plan de ubicación conforme al dictamen de Protección Civil. Entregamos el plano de distribución para tu expediente de PC municipal.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 0 1-2.827 0l-4.244-4.243a8 8 0 1 1 11.314 0z"/><path d="M15 11a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/></svg>`,
  },
];

/* Guía de selección */
const guia = [
  { n: '01', t: 'Identifica las clases de fuego presentes en cada área: oficina, bodega, cocina, sala de servidores o planta industrial. La clase de fuego determina el agente — nunca al revés.' },
  { n: '02', t: 'Revisa si hay equipos electrónicos o activos de alto valor: el PQS ABC deja residuo que daña equipos. CO₂ o agente limpio son la única opción para tableros y servidores.' },
  { n: '03', t: 'Calcula la capacidad según la carga de fuego del área: NOM-002-STPS establece la dotación mínima por m² y tipo de riesgo. Te hacemos el cálculo sin costo.' },
  { n: '04', t: 'Define el programa de mantenimiento: la NOM-002-STPS exige revisión anual y recarga al disparo o cada 5 años. El programa administrado garantiza el expediente vigente en toda inspección.' },
];

/* Artículos del blog */
const articulos = [
  { label: 'Tipos de extintores en México',     desc: 'Guía por clase de fuego y norma',             href: '/blog/tipos-de-extintores-mexico' },
  { label: 'NOM-002-STPS: guía completa',        desc: 'Dotación, inspección y brigadas de emergencia', href: '/blog/nom-002-stps-guia-completa' },
  { label: 'Cómo equipar una estación desde cero', desc: 'Checklist y presupuesto por prioridad',      href: '/blog/como-equipar-estacion-bomberos-desde-cero' },
  { label: 'Licitaciones de equipo contra incendio', desc: 'Cómo cumplir NOM y NFPA en concurso',     href: '/blog/licitaciones-equipo-contra-incendio-mexico-nom-nfpa' },
];

/* FAQ */
const faqs = [
  {
    q: '¿Qué extintor necesito para un tablero eléctrico o sala de servidores?',
    a: 'CO₂ o agente limpio (HFC-227ea / Novec). Nunca PQS ABC: el polvo daña los equipos electrónicos y es muy difícil de limpiar. El CO₂ extingue sin residuo y no conduce electricidad. Para data centers con equipos de alto valor y operación continua, el agente limpio (sistema fijo o portátil) es la solución óptima: no deja residuo y el espacio sigue habitable.',
  },
  {
    q: '¿Cuándo es obligatorio el extintor Tipo K en una cocina?',
    a: 'La NOM-154-SCFI y las normas de Protección Civil establecen el Tipo K (acetato de potasio) como obligatorio en cocinas industriales donde se usen aceites o grasas vegetales y animales a alta temperatura (freidoras, salamandras). El PQS ABC no es eficaz en fuegos de clase K — la grasa se re-enciende. Siempre debe complementarse con el sistema de supresión automático de la campana.',
  },
  {
    q: '¿Cada cuánto se revisa y se recarga un extintor?',
    a: 'La NOM-002-STPS exige inspección visual mensual (por el usuario) y mantenimiento anual por técnico certificado. La recarga es obligatoria tras cualquier disparo, aunque sea parcial, y preventiva cuando el fabricante lo indica o cuando la inspección detecta pérdida de presión. La prueba hidrostática del cilindro se realiza cada 5 años para PQS y CO₂.',
  },
  {
    q: '¿Qué documentos entrega el mantenimiento para Protección Civil?',
    a: 'Etiqueta de inspección con fecha, técnico responsable y próxima revisión; collar de garantía en la recarga; reporte de mantenimiento firmado con número de serie, tipo de agente, presión verificada y resultado; plano de ubicación de extintores. El expediente completo cumple con NOM-002-STPS y los requisitos de dictamen de Protección Civil municipal.',
  },
  {
    q: '¿Cuántos extintores necesita mi establecimiento?',
    a: 'Depende del tipo de riesgo (bajo, ordinario o alto) y del área en m². La NOM-002-STPS establece una unidad extintora mínima por cada 250 m² en riesgo bajo, con recorrido máximo de 23 m hasta el extintor. Hacemos el cálculo de dotación sin costo — solo dinos el área, la actividad y si hay riesgos especiales (cocina, tableros, almacén de materiales).',
  },
];

/* Normativa */
const normas = [
  { clave: 'NOM-154-SCFI', titulo: 'Extintores contra incendio',        desc: 'La norma de referencia para venta en México — el dictamen NOM en la etiqueta es obligatorio para todo extintor portátil comercializado en el país.' },
  { clave: 'NOM-002-STPS', titulo: 'Prevención contra incendio',        desc: 'Establece la dotación mínima de extintores por área, el programa anual de revisión, la capacitación de brigadas y el expediente que exige la STPS en inspecciones.' },
  { clave: 'NOM-003-SEGOB', titulo: 'Señalización',                     desc: 'Define los señalamientos de seguridad y emergencia para la ubicación e identificación de los extintores conforme a Protección Civil.' },
  { clave: 'NFPA 10',       titulo: 'Portable Fire Extinguishers',      desc: 'Estándar internacional de referencia para la selección, instalación, inspección, mantenimiento y recarga. Referenciada en proyectos con aseguradoras internacionales.' },
];

/* JSON-LD */
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio',    item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Productos', item: `${SITE.url}/productos` },
    { '@type': 'ListItem', position: 3, name: 'Extintores', item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: 'Extintores certificados NOM-154-SCFI y NFPA 10 — México',
  description: seoMeta.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const otrasCategorias = categories.filter((c) => c.slug !== 'extintores').slice(0, 6);
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema, faqSchema]}>

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0 flex-wrap" style="color:#4A7599">
        <li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/productos" class="hover:text-[#FF6B26]">Productos</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:#94A3B8" aria-current="page">Extintores</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background:#040A12;padding-block:5rem">
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" style="background:radial-gradient(ellipse 80% 70% at 90% 30%, rgba(245,166,35,0.08) 0%, transparent 65%)" aria-hidden="true"></div>

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="section-eyebrow mb-5 inline-flex">{cat.norm} · Venta · Recarga · Mantenimiento</span>
          <h1 class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2.5rem,5.5vw,4.5rem);line-height:0.95">
            Extintores<br/>
            <span style="color:#F5A623">certificados.</span>
          </h1>
          <p class="text-base leading-relaxed mb-8 max-w-xl" style="color:#94A3B8">
            Venta, recarga y mantenimiento de extintores portátiles y sobre ruedas certificados
            NOM-154-SCFI y NFPA 10. Reporte documental completo para tu expediente de Protección Civil,
            STPS y aseguradoras en todo México.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href={whatsappUrl('Hola, quiero cotizar extintores certificados NOM-154-SCFI para mi establecimiento.')} target="_blank" rel="noopener" class="btn btn-primary btn-lg">Cotizar por WhatsApp</a>
            <a href="/cotizacion" class="btn btn-ghost btn-lg">Cotización formal</a>
          </div>
        </div>
        <div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,0.1)">
          {cat.intro.map((p) => (
            <p class="text-sm leading-[1.9] mb-5" style="color:#94A3B8">{p}</p>
          ))}
          <div class="flex flex-wrap gap-2">
            {['NOM-154-SCFI','NOM-002-STPS','NFPA 10','PQS ABC','CO₂','Tipo K','Agente limpio','Collar de garantía'].map(n => (
              <span class="badge badge-dark font-display text-[10px]">{n}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-px" style="background:linear-gradient(90deg, transparent, rgba(245,166,35,0.4) 30%, rgba(245,166,35,0.4) 70%, transparent)" aria-hidden="true"></div>
  </section>

  <!-- Accesos rápidos -->
  <QuickLinksBar />

  <!-- Trust Pillars -->
  <section class="section-tight" style="background:#070E1A" aria-label="Por qué somos tu proveedor de extintores">
    <div class="container-site">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px" style="border:1px solid rgba(74,117,153,0.18)">
        {razones.map((r, i) => (
          <div class="flex flex-col gap-3 p-6" style={`background:#080F1A;${i < 3 ? 'border-right:1px solid rgba(74,117,153,0.12)' : ''}`}>
            <span class="font-display font-bold text-2xl" style="color:#F5A623">{r.n}</span>
            <h3 class="font-display font-bold text-sm uppercase tracking-wide" style="color:#FFFFFF">{r.t}</h3>
            <p class="text-xs leading-relaxed m-0" style="color:#64748B">{r.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tipos de agente -->
  <section class="section" style="background:#040A12" aria-labelledby="tipos-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Seis agentes, cada uno para su fuego</span>
          <h2 id="tipos-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
            El agente correcto<br/>
            <span style="color:#F5A623">según el riesgo.</span>
          </h2>
        </div>
        <div style="border-left:2px solid rgba(245,166,35,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed" style="color:#94A3B8">
            Usar el agente equivocado no solo no extingue el fuego — puede agravarlo. La clase de fuego
            determina el agente, nunca al revés. Te asesoramos la dotación correcta por área sin costo.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-5">
        {tipos.map((t) => (
          <article class="flex flex-col gap-4 p-7" style="background:#080F1A;border:1px solid rgba(74,117,153,0.18)">
            <div class="flex items-center justify-center" style={`width:52px;height:52px;background:${t.accent}1a;border:1.5px solid ${t.accent}59;color:${t.accent}`}>
              <span class="block" style="width:24px;height:24px" set:html={t.icon}/>
            </div>
            <div class="flex items-center justify-between gap-2 flex-wrap">
              <h3 class="font-display font-bold text-xl" style="color:#FFFFFF">{t.title}</h3>
              <span class="badge badge-dark text-[9px]">{t.norm.split(' · ')[0]}</span>
            </div>
            <p class="text-sm leading-relaxed m-0" style="color:#94A3B8">{t.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- PQS ABC -->
  <section class="section" style="background:#070E1A" aria-labelledby="pqs-title">
    <div class="container-site">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">El estándar de uso general</span>
          <h2 id="pqs-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
            Extintores PQS ABC<br/>
            <span style="color:#F5A623">certificados NOM.</span>
          </h2>
        </div>
        <div style="border-left:2px solid rgba(245,166,35,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed mb-4" style="color:#94A3B8">
            El polvo químico seco ABC es el agente más versátil del mercado: actúa sobre los tres tipos
            de fuego más comunes (A, B y C) con una sola unidad. Obligatorio en la mayoría de los programas
            de Protección Civil — la opción estándar para oficinas, comercios, bodegas e industria general.
          </p>
          <div class="flex flex-wrap gap-2">
            {['NOM-154-SCFI','NFPA 10','Clase A · B · C','Polvo químico seco','4.5 · 6 · 9 · 12 kg'].map(b => (
              <span class="badge badge-dark text-[9px]">{b}</span>
            ))}
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {pqsProducts.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>

      <div class="mt-10 pt-8 flex flex-col sm:flex-row gap-4 items-start" style="border-top:1px solid rgba(74,117,153,0.15)">
        <div class="flex-1">
          <p class="text-sm leading-relaxed m-0" style="color:#64748B">
            ¿Necesitas cotizar por volumen, programa de mantenimiento anual o extintores PQS en
            capacidades 6 kg y 12 kg? Te enviamos propuesta con ficha técnica para tu expediente.
