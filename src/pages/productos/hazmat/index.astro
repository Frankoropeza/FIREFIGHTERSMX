---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import RelatedLinks from '@components/common/RelatedLinks.astro';
import ProductCard from '@components/products/ProductCard.astro';
import { categories } from '@data/categories';
import { featuredProducts } from '@data/products';
import { SITE, whatsappUrl, CANAL_CONTACTO } from '@config/site';

const cat = categories.find((c) => c.slug === 'hazmat')!;
const canonicalURL = `${SITE.url}/productos/hazmat/`;

const seoMeta = {
  title: 'Traje HAZMAT: niveles A, B, C y D y certificación NFPA 1990',
  description: 'Trajes HAZMAT de protección química: qué son, niveles de protección, NFPA 1990 (1991, 1992 y 1994), encapsulados vs. no encapsulados, descontaminación y cómo elegir.',
  canonicalURL,
};

/* ── Productos por marca ─────────────────────────────────────────────────── */
const dupontProducts   = featuredProducts.filter((p) => p.category === 'Equipos HAZMAT' && p.brand === 'DuPont Tychem'      && p.specs);
const lakelandProducts = featuredProducts.filter((p) => p.category === 'Equipos HAZMAT' && p.brand === 'Lakeland Industries' && p.specs);
const msaProducts      = featuredProducts.filter((p) => p.category === 'Equipos HAZMAT' && p.brand === 'MSA Safety'          && p.specs);
const kapplerProducts  = featuredProducts.filter((p) => p.category === 'Equipos HAZMAT' && p.brand === 'Kappler'              && p.specs);
const todosHazmat      = featuredProducts.filter((p) => p.category === 'Equipos HAZMAT' && p.specs);

/* ── Niveles de protección EPA ───────────────────────────────────────────── */
const niveles = [
  {
    id: 'nivel-a',
    nivel: 'Nivel A',
    norm: 'EPA · Nivel de protección',
    accent: '#EF4444',
    escenario: 'Atmósferas desconocidas · CBRN · vapor y gas tóxico',
    desc: 'Máxima protección disponible. Traje encapsulado hermético (vapor-tight) con SCBA interno. Obligatorio cuando el agente es desconocido, la concentración es alta o existe riesgo de exposición cutánea a vapores tóxicos. La selección de Nivel A no puede basarse solo en el nivel — requiere verificación con la tabla de permeación del traje para el agente específico.',
    marcas: 'DuPont Tychem 10000 · Lakeland ChemMax 4',
    cuando: ['Agente desconocido o potencialmente letal por inhalación o contacto cutáneo', 'Concentraciones atmosféricas que requieren máxima protección respiratoria y cutánea', 'Operaciones CBRN y respuesta a terrorismo con agentes de guerra química', 'Entrada inicial a zona caliente sin caracterización completa del agente'],
  },
  {
    id: 'nivel-b',
    nivel: 'Nivel B',
    norm: 'EPA · Nivel de protección',
    accent: '#F5A623',
    escenario: 'Agente conocido · salpicadura de líquidos · SCBA externo',
    desc: 'Protección contra salpicadura de líquidos con máxima protección respiratoria (SCBA externo). El agente debe ser conocido y la ruta de exposición debe ser por líquido —no vapor— verificada con tabla de permeación. Menor estrés térmico que Nivel A, permite operaciones más prolongadas cuando el riesgo de vapor ya fue descartado.',
    marcas: 'DuPont Tychem 4000S · Lakeland ChemMax 4 Plus',
    cuando: ['Agente identificado con riesgo por salpicadura de líquido —no vapor— verificado con tabla de permeación', 'Operaciones de descontaminación en zona templada', 'Respuesta a derrames de ácidos, bases y solventes con concentración atmosférica baja', 'Segunda entrada tras establecer la caracterización del agente en Nivel A'],
  },
  {
    id: 'nivel-c',
    nivel: 'Nivel C',
    norm: 'EPA · Nivel de protección',
    accent: '#34D399',
    escenario: 'Agente conocido · bajo riesgo respiratorio · APR en lugar de SCBA',
    desc: 'Protección contra salpicadura con respirador purificador de aire (APR) en lugar de SCBA. Solo aplica cuando el agente está completamente caracterizado, la concentración atmosférica es conocida y no supera los umbrales que requieren SCBA. Usado principalmente en descontaminación de segunda línea y muestreo ambiental.',
    marcas: 'DuPont Tychem 2000 · Lakeland Pyrolon CRFR',
    cuando: ['Concentración del agente verificada por debajo del umbral de IDLH (Immediately Dangerous to Life or Health)', 'Actividades de soporte fuera de la zona caliente con agente plenamente caracterizado', 'Operaciones de post-emergencia y muestreo ambiental en zonas ya descontaminadas', 'Descontaminación de personal de salida de zona templada'],
  },
  {
    id: 'reconocimiento',
    nivel: 'Reconocimiento',
    norm: 'Pre-entrada',
    accent: '#60A5FA',
    escenario: 'Antes de seleccionar el nivel · caracterización del agente',
    desc: 'El paso más crítico de la respuesta HAZMAT es caracterizar el agente antes de seleccionar el nivel de protección. Un detector configurado para los gases esperados permite monitorear la atmósfera durante la operación; sin reconocimiento, la selección del nivel de protección es una estimación.',
    marcas: 'MSA ALTAIR 4XR · MSA ALTAIR 2X',
    cuando: ['Primera acción en todo incidente HAZMAT: caracterizar el agente antes de entrar', 'Verificación continua de la atmósfera durante la operación en todas las zonas', 'Confirmación de que el área fue descontaminada antes de reducir el nivel de protección', 'Monitoreo de espacios confinados antes de autorizar la entrada (OSHA 1910.146 / NOM-027-STPS)'],
  },
];

/* ── Trust Pillars ───────────────────────────────────────────────────────── */
const razones = [
  {
    n: '01',
    t: 'Tablas de permeación verificadas por agente',
    d: 'La selección de un traje HAZMAT por nivel (A, B, C) es insuficiente sin verificar la compatibilidad con el agente específico. Te entregamos las tablas de permeación de DuPont y Lakeland para las sustancias de tu operación — el documento que acredita la selección ante cualquier auditoría de seguridad industrial.',
  },
  {
    n: '02',
    t: 'Certificación para atmósferas explosivas',
    d: 'Antes de entrar a una atmósfera potencialmente explosiva, confirma en la ficha y en la placa del detector su certificación de área peligrosa (por ejemplo, ATEX o Clase I División 1) y que corresponde a la clasificación del área.',
  },
  {
    n: '03',
    t: 'Asesoría de selección por operación y agente',
    d: 'Analizamos los agentes específicos de tu operación (refinería, transporte, respuesta municipal), la concentración de exposición y la duración de las operaciones para recomendar el nivel de protección y el traje correcto. La selección correcta reduce el riesgo de fallo del EPP y el estrés térmico del técnico.',
  },
  {
    n: '04',
    t: 'Documentación completa para plan de respuesta',
    d: 'Entregamos las tablas de permeación, fichas de seguridad (SDS) de los agentes, procedimientos de vestido y desvestido, y guías de descontaminación. El paquete completo que exige un plan de respuesta HAZMAT certificado por Protección Civil y auditado bajo NOM-005-STPS.',
  },
];

/* ── FAQ ────────────────────────────────────────────────────────────────── */
const faqs = [
  {
    q: '¿Cuál es la diferencia entre Nivel A, B y C según la EPA?',
    a: 'La EPA define 4 niveles de protección personal para HAZMAT. Nivel A: traje encapsulado hermético (vapor-tight) + SCBA interno — máxima protección cutánea y respiratoria para agentes desconocidos o vapores letales. Nivel B: traje resistente a salpicadura de líquidos + SCBA externo — máxima protección respiratoria cuando el riesgo de vapor ya fue descartado. Nivel C: traje resistente a salpicadura + APR (respirador purificador) — para agentes caracterizados por debajo del umbral de IDLH. Nivel D: EPP mínimo (overol, guantes) para exposición nula a vapores y salpicadura. La selección no puede hacerse solo por el nivel: requiere tabla de permeación para el agente específico.',
  },
  {
    q: '¿Por qué necesito tabla de permeación además de la certificación NFPA 1990?',
    a: 'La certificación NFPA 1990 garantiza que el traje cumple requisitos generales de protección — pero no certifica la resistencia contra todos los agentes posibles. Un traje Nivel A puede permearse en minutos ante ciertos solventes clorados o ácidos concentrados que atraviesan algunos materiales específicos. La tabla de permeación documenta el breakthrough time (tiempo hasta permeación) y la tasa de permeación para el agente y concentración exacta de tu operación. Es el documento técnico-legal que valida la selección.',
  },
  {
    q: '¿DuPont Tychem 10000 o Lakeland ChemMax 4 — cuál elegir?',
    a: 'Ambos son Nivel A NFPA 1990 técnicamente equivalentes. La diferencia está en la documentación: Tychem 10000 tiene tablas para 280+ sustancias; ChemMax 4 tiene 350+. Para brigadas con mayor variedad de agentes posibles, ChemMax 4 ofrece mayor cobertura documental. Para licitaciones que especifican DuPont por nombre, el Tychem 10000 es la opción directa. Te facilitamos ambas tablas para el agente específico de tu operación y hacemos la recomendación según la sustancia.',
  },
  {
    q: '¿Cuándo usar MSA ALTAIR 4XR vs ALTAIR 2X?',
    a: 'ALTAIR 4XR es un detector multigás para combustibles, oxígeno y pares tóxicos según la configuración. ALTAIR 2X es un detector monogás o de configuraciones dobles. La elección depende de los gases identificados en la evaluación de riesgos.',
  },
  {
    q: '¿Qué documentación entregan para un plan de respuesta HAZMAT certificado?',
    a: 'Entregamos: tablas de permeación de DuPont y Lakeland para los agentes específicos de tu operación, fichas técnicas NFPA 1990 con número de modelo y certificación verificable, procedimientos de vestido y desvestido (donning/doffing) con lista de verificación, guías de descontaminación del traje y el técnico, y protocolo de calibración y prueba de choque para los monitores MSA Altair. El paquete completo para un plan de respuesta auditado bajo NOM-005-STPS.',
  },
];

/* ── JSON-LD ─────────────────────────────────────────────────────────────── */
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio',        item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Productos',     item: `${SITE.url}/productos` },
    { '@type': 'ListItem', position: 3, name: 'Equipos HAZMAT', item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: 'Equipos HAZMAT NFPA 1990 — México',
  description: seoMeta.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: todosHazmat.length,
    itemListElement: todosHazmat.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.title, url: `${SITE.url}${p.href}` })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const otrasCategorias = categories.filter((c) => c.slug !== 'hazmat').slice(0, 6);

/* ── Guía de selección ───────────────────────────────────────────────────── */
const guia = [
  { n: '01', t: 'Identifica el agente o familia de agentes antes de seleccionar el nivel. Nivel A (traje encapsulado) para agentes desconocidos o vapores IDLH; Nivel B (traje resistente + SCBA externo) cuando el riesgo de vapor fue descartado; Nivel C cuando el agente está caracterizado y la concentración permite APR. Sin identificación, no hay selección válida.' },
  { n: '02', t: 'Solicita la tabla de permeación para el agente específico, no solo para el nivel. Un traje Nivel A NFPA 1990 puede permearse en minutos ante ciertos solventes clorados — la tabla documentará el breakthrough time y la tasa de permeación para tu operación. Es el documento técnico-legal que valida la selección ante una auditoría.' },
  { n: '03', t: 'Verifica que los monitores de gas que entren a la zona de riesgo tengan certificación para atmósferas explosivas (por ejemplo, ATEX o Clase I División 1) acorde con la clasificación del área.' },
  { n: '04', t: 'Arma el paquete documental del plan de respuesta: tabla de permeación, ficha técnica NFPA 1990 con laboratorio verificable, procedimiento de donning/doffing, guía de descontaminación y protocolo de calibración del monitor. Protección Civil y aseguradoras industriales exigen estos documentos para validar el plan.' },
];

/* ── Artículos del blog ───────────────────────────────────────────────────── */
const articulos = [
  { label: 'Niveles EPA A, B, C y D explicados',    desc: 'Cuándo usar cada nivel y qué protege',          href: '/blog/niveles-proteccion-hazmat-epa-abc' },
  { label: 'Tablas de permeación DuPont vs Lakeland', desc: 'Cómo leerlas y usarlas en la selección',      href: '/blog/tablas-permeacion-dupont-lakeland-hazmat' },
  { label: 'MSA ALTAIR 4XR y 2X — comparativa',     desc: 'Detección multigás y monogás',                  href: '/blog/detectores-gas-bomberos-msa-industrial-scientific-draeger' },
  { label: 'Plan de respuesta HAZMAT certificado',   desc: 'Documentos requeridos por Protección Civil',    href: '/blog/categoria/equipos-hazmat' },
];
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema, faqSchema]}>

  {/* ══ BREADCRUMB ══════════════════════════════════════════════════════ */}
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0 flex-wrap" style="color:var(--forge-300)">
        <li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/productos" class="hover:text-[#FF6B26]">Productos</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:#94A3B8" aria-current="page">Equipos HAZMAT</span></li>
      </ol>
    </div>
  </nav>

  {/* ══ HERO ════════════════════════════════════════════════════════════ */}
  <section class="relative overflow-hidden" style="background:#040A12;padding-block:5rem">
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" style="background:radial-gradient(ellipse 80% 70% at 90% 30%, rgba(239,68,68,0.07) 0%, transparent 65%)" aria-hidden="true"></div>

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <div>
          <span class="section-eyebrow mb-5 inline-flex">{cat.norm} · DuPont Tychem · Lakeland ChemMax · MSA Altair · Distribuidor Autorizado MX</span>
          <h1 class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2.5rem,5.5vw,4.5rem);line-height:0.95">
            Traje HAZMAT<br/>
            <span style="color:#EF4444">trajes de protección química y materiales peligrosos.</span>
          </h1>
          <p class="text-lg leading-relaxed mb-8 max-w-xl" style="color:#94A3B8">
            Trajes encapsulados Nivel A, trajes de salpicadura Nivel B/C y monitores
            multi-gas certificados ATEX para respuesta a materiales peligrosos. Cada
            selección se respalda con tablas de permeación verificadas por agente — no
            solo la certificación de nivel.
          </p>

          <div class="flex flex-wrap gap-3 mb-8">
            {['NFPA 1990 por modelo','Nivel A · B · C · D','DuPont Tychem 10000','Lakeland ChemMax','MSA ALTAIR 4XR y 2X','Tablas de permeación'].map(b => (
              <span class="badge badge-dark">{b}</span>
            ))}
          </div>

          <div class="flex flex-wrap gap-4">
            <a href={whatsappUrl('Hola, quiero asesoría para seleccionar equipos HAZMAT NFPA 1990 para mi brigada.')}
              target="_blank" rel="noopener" class="btn btn-primary btn-lg">
              Solicitar asesoría HAZMAT 
            </a>
            <a href="#dupont" class="btn btn-ghost btn-lg">Trajes HAZMAT por marca </a>
            <a href="/productos/hazmat/detectores-de-gas/" class="btn btn-ghost btn-lg">Detectores de gas </a>
          </div>
        </div>

        <div class="hidden lg:flex flex-col gap-4">
          <div class="grid grid-cols-3 gap-3">
            {[
              { v: 'NFPA 1990', l: 'Según modelo' },
              { v: 'ALTAIR', l: 'Detectores de gas' },
              { v: 'A · B · C · D', l: 'Niveles EPA' },
            ].map(s => (
              <div class="flex flex-col items-center justify-center text-center p-5" style="background:#070E1A;border:1px solid rgba(74,117,153,0.2)">
                <span class="font-display font-bold text-xl mb-1" style="color:#EF4444">{s.v}</span>
                <span class="text-[10px] uppercase tracking-widest" style="color:var(--forge-300)">{s.l}</span>
              </div>
            ))}
          </div>
          <div class="p-6" style="background:#070E1A;border:1px solid rgba(74,117,153,0.2);border-left:3px solid #EF4444">
            <p class="text-xs font-bold uppercase tracking-widest mb-2" style="color:#EF4444">Regla de selección HAZMAT</p>
            <p class="text-sm leading-relaxed m-0" style="color:#64748B">
              El nivel de protección (A, B, C) se determina por el agente <strong style="color:#94A3B8">y</strong> su
              concentración — verificados con la tabla de permeación del fabricante. El nivel solo es un
              punto de partida, no la selección completa.
            </p>
          </div>
          <div class="grid grid-cols-2 gap-3">
            {[
              { v: '4XR / 2X', l: 'Detectores MSA vigentes' },
              { v: 'NOM-005', l: 'Norma STPS manejo de sustancias' },
            ].map(s => (
              <div class="flex flex-col items-center justify-center text-center p-5" style="background:#070E1A;border:1px solid rgba(74,117,153,0.2)">
                <span class="font-display font-bold text-xl mb-1" style="color:#EF4444">{s.v}</span>
                <span class="text-[10px] uppercase tracking-widest" style="color:var(--forge-300)">{s.l}</span>
              </div>
            ))}
          </div>
        </div>

      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-px" style="background:linear-gradient(90deg, transparent, rgba(239,68,68,0.4) 30%, rgba(239,68,68,0.4) 70%, transparent)" aria-hidden="true"></div>
  </section>

  <section id="guia-hazmat" class="section" style="background:#040A12" aria-labelledby="guia-hazmat-title">
    <div class="container-site content-copy">
      <div class="section-head mb-5">
        <h2 id="guia-hazmat-title">¿Qué es un traje HAZMAT y qué significa HAZMAT?</h2>
      </div>
      <p class="mb-8">HAZMAT viene del inglés <em>hazardous materials</em>, es decir, materiales peligrosos. Un traje HAZMAT es ropa de protección química que aísla al usuario de sustancias químicas, agentes tóxicos, vapores, líquidos, aerosoles y partículas peligrosas. Lo usan bomberos, brigadas industriales y equipos de respuesta a emergencias para atender fugas, derrames y otros incidentes con materiales peligrosos. Suministramos trajes de protección química DuPont Tychem y Kappler, desde overoles para partículas hasta trajes encapsulados certificados NFPA 1990.</p>

      <div class="section-head mt-14 mb-5">
        <h2>Niveles de protección de los trajes HAZMAT</h2>
      </div>
      <p>La EPA de Estados Unidos define cuatro niveles de protección que se usan como referencia para elegir el equipo de protección personal (EPP):</p>
      <div class="overflow-x-auto max-w-full min-w-0 mb-8">
        <table class="w-full text-left text-sm" style="border-collapse:collapse;min-width:640px;color:#CBD5E1">
          <thead>
            <tr>
              <th class="p-3" style="background:#0C1825;color:#FFFFFF">Nivel</th>
              <th class="p-3" style="background:#0C1825;color:#FFFFFF">Cuándo se usa</th>
              <th class="p-3" style="background:#0C1825;color:#FFFFFF">Equipo típico</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="p-3" style="border-bottom:1px solid rgba(74,117,153,.18)">Nivel A</td>
              <td class="p-3" style="border-bottom:1px solid rgba(74,117,153,.18)">Mayor exposición posible: máxima protección de piel, vías respiratorias y ojos</td>
              <td class="p-3" style="border-bottom:1px solid rgba(74,117,153,.18)">Traje encapsulado a prueba de vapores con protección respiratoria</td>
            </tr>
            <tr>
              <td class="p-3" style="border-bottom:1px solid rgba(74,117,153,.18)">Nivel B</td>
              <td class="p-3" style="border-bottom:1px solid rgba(74,117,153,.18)">Máxima protección respiratoria con menor protección de la piel</td>
              <td class="p-3" style="border-bottom:1px solid rgba(74,117,153,.18)">Traje contra salpicaduras con equipo de respiración autónoma</td>
            </tr>
            <tr>
              <td class="p-3" style="border-bottom:1px solid rgba(74,117,153,.18)">Nivel C</td>
              <td class="p-3" style="border-bottom:1px solid rgba(74,117,153,.18)">Se conocen la concentración y el tipo de contaminante y se pueden usar respiradores con filtro</td>
              <td class="p-3" style="border-bottom:1px solid rgba(74,117,153,.18)">Overol de protección química y respirador</td>
            </tr>
            <tr>
              <td class="p-3">Nivel D</td>
              <td class="p-3">Protección mínima, sin contaminantes ni riesgo de salpicadura</td>
              <td class="p-3">Overol de trabajo o traje desechable contra polvo</td>
            </tr>
          </tbody>
        </table>
      </div>

      <div class="section-head mt-14 mb-5">
        <h2>Normas: NFPA 1990 para trajes de protección química</h2>
      </div>
      <p>La NFPA 1990 (edición 2022) reunió en una sola norma tres estándares que antes estaban separados:</p>
      <ul class="list-disc pl-6 space-y-2 text-sm leading-relaxed" style="color:#CBD5E1">
        <li><strong>NFPA 1991:</strong> trajes a prueba de vapores para emergencias con materiales peligrosos.</li>
        <li><strong>NFPA 1992:</strong> ropa de protección contra salpicaduras de líquidos.</li>
        <li><strong>NFPA 1994:</strong> ropa para incidentes CBRN, clasificada por clases.</li>
      </ul>
      <p>La certificación aplica a modelos específicos: los DuPont Tychem 10000 TK612T y TK613T cuentan con NFPA 1990 (1994 Clase 2); el Kappler Frontline 500 F5H582-91/F5H583-91 cuenta con NFPA 1990 (1991); y los DuPont Tychem 6000 FR TP198T y TP199T cuentan con NFPA 1990 (1992). Revisa siempre el número de modelo y la etiqueta del traje. En México, la NOM-017-STPS-2008 regula la selección, el uso y el manejo del EPP en los centros de trabajo.</p>

      <div class="section-head mt-14 mb-5"><h2>Materiales de los trajes de protección química</h2></div>
      <p>Los trajes HAZMAT se fabrican con películas y laminados de polímeros que forman una barrera contra sustancias químicas. La resistencia química depende de cada sustancia y del tiempo de exposición: consulta siempre la tabla de permeación del fabricante.</p>

      <div class="section-head mt-14 mb-5"><h2>Trajes encapsulados vs. no encapsulados</h2></div>
      <ul class="list-disc pl-6 space-y-2 text-sm leading-relaxed" style="color:#CBD5E1">
        <li><strong>Trajes encapsulados:</strong> cubren el cuerpo y el equipo de respiración; el interior queda aislado del ambiente. Se usan ante fugas de vapores y gases tóxicos.</li>
        <li><strong>Trajes no encapsulados:</strong> overol con capucha que deja el equipo respiratorio por fuera; protegen contra salpicaduras de líquidos.</li>
        <li><strong>Trajes desechables:</strong> overoles ligeros para polvo, partículas y salpicaduras ligeras en el entorno de trabajo.</li>
      </ul>

      <div class="section-head mt-14 mb-5"><h2>¿Los trajes HAZMAT protegen contra el fuego y la radiación?</h2></div>
      <p>Un traje de protección química no es un traje de bombero: salvo que el fabricante indique una opción de protección contra fogonazo para escape, no está diseñado para el calor ni las llamas. En incidentes radiológicos, el traje evita que las partículas contaminantes toquen la piel, pero no bloquea la radiación penetrante; para eso se requiere control de tiempo, distancia y blindaje.</p>

      <div class="section-head mt-14 mb-5"><h2>Descontaminación y reutilización</h2></div>
      <p>Al salir de la zona caliente, el usuario pasa por un corredor de descontaminación donde se lava el traje antes de retirarlo. Algunos trajes son de uso limitado y se desechan tras la exposición; otros pueden reutilizarse solo si el fabricante lo permite y el traje supera la inspección y las pruebas de hermeticidad. Registra cada uso y almacénalo conforme al manual.</p>

      <div class="section-head mt-14 mb-5"><h2>¿Cómo elegir el traje HAZMAT adecuado?</h2></div>
      <ol class="list-none pl-6 space-y-2 text-sm leading-relaxed" style="color:#CBD5E1">
        <li>Identifica la sustancia peligrosa, su estado y su concentración.</li>
        <li>Define el nivel de protección (A, B, C o D) según la evaluación de riesgos.</li>
        <li>Verifica la certificación NFPA 1990 del modelo y la tabla de permeación para esa sustancia.</li>
        <li>Asegura la compatibilidad con el equipo de respiración, guantes y botas.</li>
        <li>Elige las tallas correctas y capacita a la brigada en colocación, uso y descontaminación.</li>
      </ol>
      <p>Cotiza tus trajes HAZMAT con un especialista y recibe la recomendación por nivel de protección y sustancia.</p>
    </div>
  </section>

