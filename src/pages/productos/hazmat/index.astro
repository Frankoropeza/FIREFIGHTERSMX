---
import EditorialCategoryHub from '@components/products/EditorialCategoryHub.astro';
const page = {
  slug:'hazmat', breadcrumb:'Equipos HAZMAT', title:'Equipos HAZMAT para Materiales Peligrosos en México',
  description:'Guía de equipos HAZMAT para materiales peligrosos: traje químico, protección personal, detector multigás, descontaminación, normativa y empresas en México.',
  eyebrow:'Guía editorial · Materiales peligrosos', h1:'Equipos HAZMAT para', h1Accent:'materiales peligrosos', accent:'#EF4444',
  image:'/images/categorias/hazmat.avif', imageAlt:'Equipo HAZMAT de referencia con traje químico y protección respiratoria',
  intro:['La respuesta a materiales peligrosos exige identificar la sustancia química, concentración, estado físico, vías de exposición y tareas. Ningún traje o detector es universal.','Esta guía organiza equipo de protección personal, trajes HAZMAT, protección respiratoria, detección de gas y descontaminación para el control de materiales peligrosos. Si el alcance incluye transporte de materiales y residuos peligrosos, también debe verificarse la regulación de transporte aplicable.'],
  badges:['Trajes químicos','SCBA','Multigás','Permeación','Descontaminación','NFPA 1990'],
  typesHeading:'Equipos HAZMAT y protección para sustancias peligrosas.', compareHeading:'Cómo seleccionar equipo ante un incidente HAZMAT.', standardsHeading:'Normativas y cumplimiento para materiales peligrosos.',
  types:[
    {title:'Trajes encapsulados',eyebrow:'Protección de cuerpo completo',text:'La configuración y nivel de hermeticidad deben corresponder a la sustancia y tarea. Compara material, costuras, visor, guantes, botas, válvulas y uso con SCBA.'},
    {title:'Ropa contra salpicaduras',eyebrow:'Alcance definido',text:'Puede utilizarse cuando el análisis permita menor encapsulado. La clasificación por letras o niveles no sustituye una tabla de permeación y un conjunto compatible.'},
    {title:'Detección multigás',eyebrow:'Atmósfera',text:'Los sensores se seleccionan por gases y rangos previstos. Revisa configuración, alarmas, prueba funcional, calibración, registro y limitaciones cruzadas.'},
    {title:'Descontaminación',eyebrow:'Control posterior',text:'Incluye zonas, contención de derrames, herramientas, soluciones, residuos y retiro seguro del equipo. Debe planearse antes de entrar, no después de la exposición.'},
  ],
  compare:['Identifica sustancias mediante hojas de seguridad (SDS) y fuentes confiables; no selecciones solo por nombre comercial.','Define concentración, estado, temperatura, duración, tarea y riesgo de salpicadura, vapor, fuga o incendio.','Compara permeación, degradación, penetración y compatibilidad del conjunto completo.','Verifica sensores, rangos, interferencias, prueba funcional, calibración y monitoreo del detector multigás.','Integra protección respiratoria, comunicación, descontaminación, rescate de respaldo y protección del medio ambiente.'],
  documentation:['SDS de las sustancias y evaluación del escenario.','Tabla de permeación del material para sustancia, concentración y temperatura.','Ficha, manual y certificación del modelo cuando aplique.','Lista de componentes compatibles del conjunto.','Procedimientos de vestido, entrada, descontaminación, retiro y disposición.'],
  standards:[
    {title:'NFPA 1990',text:'Contiene requisitos para conjuntos de protección en operaciones con materiales peligrosos y determinadas operaciones médicas. Verifica clase y alcance.'},
    {title:'NIOSH para respiradores',text:'La aprobación de un respirador debe comprobarse por configuración en la Certified Equipment List; CBRN requiere identificación específica.'},
    {title:'Transporte terrestre',text:'Cuando el alcance incluya transportar mercancía peligrosa, aplica un marco distinto al equipo de respuesta. Verifica reglamento, clasificación, documentos y NOM vigentes de la SICT.'},
  ],
  maintenanceTitle:'Preparación y control del equipo HAZMAT.',
  maintenance:[{title:'Antes de la entrada',text:'Verifica integridad, talla, cierres, válvulas, guantes, botas, SCBA, comunicación, detector y equipo de respaldo.'},{title:'Detectores',text:'Realiza prueba funcional y calibración conforme al fabricante y programa; documenta sensores, gas patrón, resultado y fecha.'},{title:'Después del incidente',text:'Controla descontaminación, inspección, exposición, almacenamiento y retiro. Algunos equipos son limitados o desechables según su diseño y condición.'}],
  quoteData:['Sustancias y SDS disponibles.','Concentración, estado y temperatura esperados.','Tareas, duración y nivel de encapsulado.','Tallas y número de usuarios.','Gases, sensores y rangos de medición.','SCBA, comunicación, descontaminación, capacitación y repuestos.'],
  faqs:[
    {q:'¿Qué significa HAZMAT?',a:'Es una abreviatura de hazardous materials, o materiales peligrosos. En respuesta a emergencias abarca identificación, control, protección, monitoreo y descontaminación.'},
    {q:'¿Cómo elegir un traje HAZMAT?',a:'Parte de la sustancia, concentración, temperatura, exposición y tarea. Comprueba permeación, degradación, costuras y compatibilidad del conjunto; el nivel por sí solo no basta.'},
    {q:'¿Qué gases debe medir un detector multigás?',a:'Depende del escenario. Oxígeno, inflamabilidad y gases tóxicos comunes pueden ser relevantes, pero los sensores deben seleccionarse mediante la evaluación de peligros.'},
    {q:'¿Un monitor multigás siempre es apto para atmósferas explosivas?',a:'No debe asumirse. Verifica el marcado y aprobación del modelo para la clasificación del lugar y conserva la configuración autorizada.'},
    {q:'¿Qué documentos pedir a una empresa HAZMAT?',a:'Ficha y manual, tablas de permeación, certificaciones aplicables, compatibilidad, vida de almacenamiento, mantenimiento, calibración y alcance de capacitación.'},
  ],
  related:[{label:'Empresas de equipo para bomberos',href:'/empresas/venta-equipo/',text:'Directorio nacional por estado.'},{label:'Equipos SCBA',href:'/productos/equipos-scba/',text:'Protección respiratoria autónoma.'},{label:'Capacitación contra incendios',href:'/empresas/capacitacion/',text:'Empresas clasificadas por estado.'},{label:'Normas y certificaciones',href:'/certificaciones/',text:'Cómo verificar documentos.'}],
  sources:[{label:'NFPA 1990 — información oficial',href:'https://www.nfpa.org/1990'},{label:'NIOSH — Certified Equipment List',href:'https://wwwn.cdc.gov/niosh-cel/'},{label:'SICT — NOM de materiales y residuos peligrosos',href:'https://micrs.sct.gob.mx/transporte-y-medicina-preventiva/autotransporte-federal/marco-normativo/noms-de-materiales-y-residuos-peligrosos/'}],
  directoryHref:'/empresas/venta-equipo/', directoryLabel:'Buscar empresas de equipo',
};
---
<EditorialCategoryHub {...page} />
