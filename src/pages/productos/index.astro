---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import CategoryCard from '@components/products/CategoryCard.astro';
import CategoryGuia from '@components/products/CategoryGuia.astro';
import L2Sidebar from '@components/l2/L2Sidebar.astro';
import L2Cotizar from '@components/l2/L2Cotizar.astro';
import { bloqueCategorias, bloqueMarcas, bloqueIndustrias, bloqueServicios, bloqueGuias, GUIAS_CATALOGO, anchoFila } from '@lib/l2';
import '@styles/l2.css';
import ProductosPorCategoria from '@components/products/ProductosPorCategoria.astro';
import LineaCard from '@components/products/LineaCard.astro';
import { allCategories, type Category } from '@data/categories';
import { catalogo, type LineaCatalogo } from '@data/catalogo';
import { imagenLinea } from '@lib/linea-card';
import { SITE, whatsappUrl, CANAL_CONTACTO } from '@config/site';

const canonicalURL = `${SITE.url}/productos/`;

const seoMeta = {
  title: 'Equipo para bomberos y equipo contra incendio certificado',
  description:
    'Catálogo de equipo para bomberos certificado NFPA y NOM: trajes, cascos, SCBA, herramientas de rescate, extintores, sistemas contra incendio y HAZMAT.',
  canonicalURL,
};

/* ─── JSON-LD ──────────────────────────────────────────────── */

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Productos', item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: 'Catálogo de equipo para bomberos y contra incendio',
  description: seoMeta.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: allCategories.length,
    itemListElement: allCategories.map((cat, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: cat.label,
      url: `${SITE.url}/productos/${cat.slug}`,
    })),
  },
};

/* Pilares de confianza bajo el hero */
const trustPoints = [
  { title: 'Originales verificables', text: 'Número de serie validable con fábrica y certificado de laboratorio acreditado.' },
  { title: 'Documentación completa', text: 'Ficha técnica, certificado de conformidad y manifiesto de normas en cada entrega.' },
  { title: 'Stock permanente', text: 'EPP estructural en tallas S–2XL listo para envío en 24–48 h desde CDMX.' },
  { title: 'Precios institucionales', text: 'Esquemas preferenciales para bomberos, Protección Civil y compras por volumen.' },
];

/* Rediseño 2026-09-30: secciones de la columna principal (anclas de la barra lateral) */
const secciones = [
  { id: 'categorias', label: 'Categorías' },
  { id: 'productos', label: 'Productos' },
  { id: 'guias', label: 'Guías' },
  { id: 'como-cotizar', label: 'Cotizar' },
];

/* Familias de catalogo.ts + categorías con página propia que no son línea (drones) */
const EXTRA_FAMILIA: Record<string, string[]> = { 'equipo-bomberos': ['drones-emergencia'] };
type ItemFamilia = { tipo: 'linea'; l: LineaCatalogo } | { tipo: 'categoria'; cat: Category };
const familias = catalogo.map((f) => ({
  ...f,
  items: [
    ...f.lineas.map((l): ItemFamilia => ({ tipo: 'linea', l })),
    ...(EXTRA_FAMILIA[f.slug] ?? [])
      .map((slug) => allCategories.find((c) => c.slug === slug))
      .filter((c): c is Category => !!c)
      .map((cat): ItemFamilia => ({ tipo: 'categoria', cat })),
  ],
}));

const pasos = [
    `Mándanos tu lista por ${CANAL_CONTACTO}, las bases de tu licitación o una foto del equipo a renovar.`,
    'Te regresamos propuesta con precios, disponibilidad, fichas técnicas y tiempos de entrega.',
    'Confirmas, entregamos con documentación completa y queda asignado tu ejecutivo de seguimiento.',
];

const tambien = [
              { label: 'Guía de normas y certificaciones', desc: 'Qué NOM y NFPA aplican según tu giro', href: '/certificaciones' },
              { label: 'Servicios de mantenimiento y recarga', desc: 'Extintores, SCBA e hidráulicas — NFPA 1850', href: '/servicios/mantenimiento' },
              { label: 'Soporte para licitaciones', desc: 'CompraNet, PEMEX, CFE y municipios', href: '/licitaciones' },
              { label: 'Marcas que distribuimos', desc: 'Globe, MSA, Dräger, Holmatro y más', href: '/marcas' },
              { label: 'Cobertura de entrega', desc: '24–48 h CDMX · 3–5 días nacional', href: '/cobertura' },
              { label: 'Conoce la empresa', desc: 'Quiénes somos, cobertura y certificaciones', href: '/empresa' },
];
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema]}>

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:var(--c-bg-alt);border-bottom:1px solid var(--c-line)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
        <li><a href="/" class="hover:text-[var(--c-accent)]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:var(--c-text-2)" aria-current="page">Productos</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero del catálogo -->
  <section class="relative overflow-hidden" style="background:var(--c-bg);padding-block:5rem">

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <div>
          <span class="section-eyebrow mb-5 inline-flex">Catálogo completo · NFPA y NOM</span>
          <h1 class="font-display font-bold mb-6" style="color:var(--c-ink);font-size:clamp(2.25rem,4.5vw,3.5rem);line-height:1.08">
            Equipo para Bomberos<br/>
            <span style="color:var(--c-accent)">y Contra Incendio</span>
          </h1>
          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href={whatsappUrl('Hola, quiero cotizar equipo del catálogo.')}
              target="_blank" rel="noopener"
              class="btn btn-primary btn-lg"
            >
              Cotizar por {CANAL_CONTACTO}
            </a>
            <a href="/cotizacion" class="btn btn-ghost btn-lg">Cotización formal</a>
          </div>
        </div>

        <div class="lg:pl-16" style="border-left:1px solid var(--c-line)">
          <p class="text-sm leading-[1.9] mb-5" style="color:var(--c-text-2)">
            Nueve categorías de equipamiento certificado para cuerpos de bomberos, brigadas
            industriales y protección civil: <strong style="color:var(--c-text)">trajes estructurales NFPA 1970 (antes 1971),
            cascos, equipos de respiración autónoma SCBA, herramientas de rescate
            Holmatro, extintores PQS NOM-100-STPS y CO₂ NOM-102-STPS, sistemas contra incendio, cámaras térmicas
            NFPA 1930, trajes HAZMAT, drones de emergencia, señalamientos de seguridad, lámparas de emergencia y botiquines de primeros auxilios</strong>.
          </p>
          <p class="text-sm leading-[1.9] mb-6" style="color:var(--c-muted)">
            Somos distribuidores autorizados de Globe, MSA, Dräger, Bullard, Holmatro y 3M Scott
            en México. Cada equipo se entrega con número de serie verificable, certificado de
            laboratorio acreditado y ficha técnica lista para licitación, auditoría STPS o
            expediente de Protección Civil.
          </p>
          <div class="flex flex-wrap gap-2">
            {['NFPA 1970','NFPA 1850','NFPA 1960','NFPA 1930','NOM-100-STPS','NOM-002-STPS'].map(n => (
            <span class="badge badge-dark font-display text-[10px]">{n}</span>
          ))}
          </div>
        </div>

      </div>
    </div>

  </section>
  <!-- Accesos rápidos (interlinking) -->
  <QuickLinksBar />


  <!-- Pilares de confianza -->
  <section class="section-tight" style="background:var(--c-bg-alt)" aria-labelledby="garantias-title">
    <div class="container-site">
      <h2 id="garantias-title" class="sr-only">Garantías de compra</h2>
      <div class="l2-trust">
        {trustPoints.map((t) => (
          <div><h3>{t.title}</h3><p>{t.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Catálogo: barra lateral fija + columna principal (rediseño 2026-09-30) -->
  <div class="container-site l2-shell">
    <L2Sidebar
      resumen="Navegar el catálogo"
      secciones={secciones}
      bloques={[bloqueCategorias(), bloqueMarcas(), bloqueIndustrias(), bloqueServicios(), bloqueGuias(GUIAS_CATALOGO)]}
      cotizar={{ titulo: 'Cotiza tu equipo', texto: 'Envíanos tu lista, las bases de tu licitación o una foto del equipo a renovar.', msg: 'Hola, quiero cotizar equipo del catálogo.' }}
    />

    <div class="l2-main">

      <!-- Categorías por familia -->
      <section id="categorias" class="l2-sec" aria-labelledby="categorias-title">
        <header class="l2-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Categorías</span>
          <h2 id="categorias-title" class="l2-h2">Categorías de equipo contra incendio</h2>
          <p class="l2-lead">
            Cada categoría tiene su propia página con líneas disponibles, normas aplicables
            y productos destacados. Si no encuentras un modelo específico, lo conseguimos:
            trabajamos directo con fábrica y manejamos pedidos especiales sobre especificación técnica.
          </p>
        </header>

        {familias.map((familia) => (
          <div class="l2-fam" id={`familia-${familia.slug}`} aria-labelledby={`fam-${familia.slug}`}>
            <header class="l2-fam-head">
              <div>
                <p class="l2-fam-eyebrow">{familia.eyebrow}</p>
                <h3 id={`fam-${familia.slug}`} class="l2-fam-title">{familia.titulo}</h3>
              </div>
              <p class="l2-fam-text">{familia.texto}</p>
            </header>
            <ul class="l2-grid" role="list">
              {familia.items.map((it, i) => {
                const ancho = anchoFila(i, familia.items.length);
                return (
                  <li class={ancho || undefined}>
                    {it.tipo === 'linea'
                      ? <LineaCard href={it.l.href} norma={it.l.norma} titulo={it.l.titulo} texto={it.l.texto} imagen={imagenLinea(it.l.slug)} imagenAlt={it.l.imagenAlt} hijas={it.l.hijas} cta={it.l.cta} />
                      : <CategoryCard cat={it.cat} />}
                  </li>
                );
              })}
            </ul>
            <div class="l2-hub"><a href={familia.hub.href} class="btn btn-ghost">{familia.hub.label}</a></div>
          </div>
        ))}
      </section>

      <!-- Productos por categoría -->
      <section id="productos" class="l2-sec" aria-labelledby="productos-title">
        <header class="l2-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Lo más cotizado</span>
          <h2 id="productos-title" class="l2-h2">Productos por categoría</h2>
          <p class="l2-lead">Modelos con ficha técnica propia, agrupados por categoría, con su marca y la norma que cumplen.</p>
        </header>
        <ProductosPorCategoria />
      </section>

      <!-- Guías de selección (antes: módulos spotlight a pantalla completa) -->
      <section id="guias" class="l2-sec" aria-labelledby="guias-title">
        <header class="l2-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Guías de selección</span>
          <h2 id="guias-title" class="l2-h2">Cómo elegir el equipo de cada categoría</h2>
          <p class="l2-lead">Qué distingue a cada línea, qué norma aplica y qué revisar antes de cotizar.</p>
        </header>
        <div class="l2-guias">
          {allCategories.filter((cat) => cat.spotlight).map((cat) => <CategoryGuia cat={cat} />)}
        </div>
      </section>

      <!-- Cómo cotizar + cross-links -->
      <L2Cotizar
        id="como-cotizar"
        eyebrow="Cómo cotizar"
        titulo="Del catálogo a tu operación"
        destacado="en menos de 24 horas."
        pasos={pasos}
        cta={{ label: 'Iniciar cotización', msg: 'Hola, quiero cotizar equipo del catálogo.' }}
        tambien={tambien}
      />

    </div>
  </div>



</BaseLayout>
