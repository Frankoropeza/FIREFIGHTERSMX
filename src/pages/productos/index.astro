---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import CategoryCard from '@components/products/CategoryCard.astro';
import CategorySpotlight from '@components/products/CategorySpotlight.astro';
import { allCategories } from '@data/categories';
import { featuredProducts } from '@data/products';
import { SITE, whatsappUrl } from '@config/site';

const canonicalURL = `${SITE.url}/productos`;

const seoMeta = {
  title: `Catálogo de Equipo para Bomberos y Contra Incendio — ${SITE.name}`,
  description:
    'Catálogo certificado NFPA y NOM: trajes, cascos, SCBA, herramientas de rescate, extintores, sistemas CI, cámaras térmicas, HAZMAT y drones. Cotización en 24 h.',
  canonicalURL,
};

/* ─── JSON-LD ──────────────────────────────────────────────── */

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Productos', item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: 'Catálogo de equipo para bomberos y contra incendio',
  description: seoMeta.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: allCategories.length,
    itemListElement: allCategories.map((cat, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: cat.label,
      url: `${SITE.url}/productos/${cat.slug}`,
    })),
  },
};

/* Pilares de confianza bajo el hero */
const trustPoints = [
  { title: 'Originales verificables', text: 'Número de serie validable con fábrica y certificado de laboratorio acreditado.' },
  { title: 'Documentación completa', text: 'Ficha técnica, certificado de conformidad y manifiesto de normas en cada entrega.' },
  { title: 'Stock permanente', text: 'EPP estructural en tallas S–2XL listo para envío en 24–48 h desde CDMX.' },
  { title: 'Precios institucionales', text: 'Esquemas preferenciales para bomberos, Protección Civil y compras por volumen.' },
];
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema]}>

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:#4A7599">
        <li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:#94A3B8" aria-current="page">Productos</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero del catálogo -->
  <section class="relative overflow-hidden" style="background:#040A12;padding-block:5rem">
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" style="background:radial-gradient(ellipse 80% 70% at 90% 30%, rgba(247,80,0,0.08) 0%, transparent 65%)" aria-hidden="true"></div>

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <div>
          <span class="section-eyebrow mb-5 inline-flex">Catálogo completo · NFPA y NOM</span>
          <h1 class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2.5rem,5.5vw,4.5rem);line-height:0.95">
            Equipo para Bomberos<br/>
            <span style="color:#F75000">y Contra Incendio</span>
          </h1>
          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href={whatsappUrl('Hola, quiero cotizar equipo del catálogo.')}
              target="_blank" rel="noopener"
              class="btn btn-primary btn-lg"
            >
              Cotizar por WhatsApp
            </a>
            <a href="/cotizacion" class="btn btn-ghost btn-lg">Cotización formal</a>
          </div>
        </div>

        <div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,0.1)">
          <p class="text-sm leading-[1.9] mb-5" style="color:#94A3B8">
            Nueve categorías de equipamiento certificado para cuerpos de bomberos, brigadas
            industriales y protección civil: <strong style="color:#CBD5E1">trajes estructurales NFPA 1970 (antes 1971),
            cascos, equipos de respiración autónoma SCBA, herramientas de rescate
            Holmatro, extintores NOM-154-SCFI, sistemas contra incendio, cámaras térmicas
            NFPA 1930, trajes HAZMAT y drones de emergencia</strong>.
          </p>
          <p class="text-sm leading-[1.9] mb-6" style="color:#64748B">
            Somos distribuidores autorizados de Globe, MSA, Dräger, Bullard, Holmatro y 3M Scott
            en México. Cada equipo se entrega con número de serie verificable, certificado de
            laboratorio acreditado y ficha técnica lista para licitación, auditoría STPS o
            expediente de Protección Civil.
          </p>
          <div class="flex flex-wrap gap-2">
            {['NFPA 1970','NFPA 1850','NFPA 1936','NFPA 1930','NOM-154-SCFI','NOM-002-STPS'].map(n => (
              <span class="badge badge-dark font-display text-[10px]">{n}</span>
            ))}
          </div>
        </div>

      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-px" style="background:linear-gradient(90deg, transparent, rgba(247,80,0,0.4) 30%, rgba(247,80,0,0.4) 70%, transparent)" aria-hidden="true"></div>
  </section>
  <!-- Accesos rápidos (interlinking) -->
  <QuickLinksBar />


  <!-- Pilares de confianza -->
  <section class="section-tight" style="background:#070E1A" aria-label="Garantías de compra">
    <div class="container-site">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4" style="border:1px solid rgba(74,117,153,0.18)">
        {trustPoints.map((t, i) => (
          <div class="flex flex-col gap-2 p-6" style={`background:#0C1825;${i < 3 ? 'border-right:1px solid rgba(74,117,153,0.18);' : ''}`}>
            <h2 class="font-display font-bold text-sm uppercase tracking-wider" style="color:#FF6B26">{t.title}</h2>
            <p class="text-xs leading-relaxed" style="color:#64748B">{t.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Categorías -->
  <section class="section" style="background:#040A12" aria-labelledby="categorias-title">
    <div class="container-site">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Categorías</span>
          <h2 id="categorias-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
            Nueve categorías,<br/>
            <span style="color:#F75000">todo certificado.</span>
          </h2>
        </div>
        <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed" style="color:#94A3B8">
            Cada categoría tiene su propia página con líneas disponibles, normas aplicables
            y productos destacados. Si no encuentras un modelo específico, lo conseguimos:
            trabajamos directo con fábrica y manejamos pedidos especiales sobre especificación técnica.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {allCategories.map((cat) => <CategoryCard cat={cat} />)}
      </div>

    </div>
  </section>

  <!-- Módulos destacados por categoría (texto izquierda, imagen derecha; fondos alternados) -->
  {allCategories
    .filter((cat) => cat.spotlight)
    .map((cat, i) => (
      <CategorySpotlight cat={cat} background={i % 2 === 0 ? '#070E1A' : '#040A12'} />
    ))}

  <!-- Productos destacados -->
  <section class="section" style="background:#070E1A" aria-labelledby="destacados-title">
    <div class="container-site">

      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Lo más cotizado</span>
          <h2 id="destacados-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
            Productos<br/>
            <span style="color:#F75000">destacados.</span>
          </h2>
        </div>
        <a href={whatsappUrl('Hola, quiero cotizar productos del catálogo.')} target="_blank" rel="noopener" class="btn btn-outline btn-sm self-start sm:self-auto shrink-0">
          Cotizar ahora →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px" style="background:rgba(74,117,153,0.18);border:1px solid rgba(74,117,153,0.18)">
        {featuredProducts.map((product) => (
          <a href={product.href} class="grid-cell group flex flex-col gap-3 p-6">
            <div class="flex gap-2 flex-wrap">
              {product.norm && <span class="badge badge-fire">{product.norm}</span>}
              {product.brand && <span class="badge badge-dark">{product.brand}</span>}
              {product.badge && <span class="badge badge-gold">{product.badge}</span>}
            </div>
            <h3 class="font-display font-bold text-lg leading-snug group-hover:text-[#FF6B26]" style="color:#FFFFFF">{product.title}</h3>
            <p class="text-xs leading-relaxed" style="color:#64748B">{product.description}</p>
            <span class="text-xs font-display font-semibold uppercase tracking-wider mt-auto" style="color:#FF8F57">Ver detalles →</span>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- Cómo cotizar + cross-links -->
  <section class="section" style="background:#040A12" aria-labelledby="como-cotizar-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">

        <div>
          <span class="section-eyebrow mb-4 inline-flex">Cómo cotizar</span>
          <h2 id="como-cotizar-title" class="font-display font-bold mb-6" style="color:#FFFFFF;font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
            Del catálogo a tu operación<br/>
            <span style="color:#F75000">en menos de 24 horas.</span>
          </h2>
          <ol class="flex flex-col gap-4 list-none m-0 p-0">
            {[
              { n: '01', t: 'Mándanos tu lista por WhatsApp, las bases de tu licitación o una foto del equipo a renovar.' },
              { n: '02', t: 'Te regresamos propuesta con precios, disponibilidad, fichas técnicas y tiempos de entrega.' },
              { n: '03', t: 'Confirmas, entregamos con documentación completa y queda asignado tu ejecutivo de seguimiento.' },
            ].map((s) => (
              <li class="flex items-start gap-4">
                <span class="font-display font-bold text-xl shrink-0" style="color:#F75000">{s.n}</span>
                <p class="text-sm leading-relaxed m-0" style="color:#94A3B8">{s.t}</p>
              </li>
            ))}
          </ol>
          <div class="flex flex-col sm:flex-row gap-3 mt-8">
            <a href={whatsappUrl('Hola, quiero cotizar equipo del catálogo.')} target="_blank" rel="noopener" class="btn btn-primary">
              Iniciar cotización
            </a>
          </div>
        </div>

        <div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,0.15)">
          <h2 class="font-display font-bold text-sm uppercase tracking-widest mb-5" style="color:#4A7599">
            También te puede servir
          </h2>
          <ul class="flex flex-col list-none m-0 p-0" style="border-top:1px solid rgba(74,117,153,0.15)">
            {[
              { label: 'Guía de normas y certificaciones', desc: 'Qué NOM y NFPA aplican según tu giro', href: '/certificaciones' },
              { label: 'Servicios de mantenimiento y recarga', desc: 'Extintores, SCBA e hidráulicas — NFPA 1850', href: '/servicios/mantenimiento' },
              { label: 'Soporte para licitaciones', desc: 'CompraNet, PEMEX, CFE y municipios', href: '/licitaciones' },
              { label: 'Marcas que distribuimos', desc: 'Globe, MSA, Dräger, Holmatro y más', href: '/marcas' },
              { label: 'Cobertura de entrega', desc: '24–48 h CDMX · 3–5 días nacional', href: '/cobertura' },
              { label: 'Conoce la empresa', desc: 'Quiénes somos, cobertura y certificaciones', href: '/empresa' },
            ].map((l) => (
              <li style="border-bottom:1px solid rgba(74,117,153,0.15)">
                <a href={l.href} class="group flex items-center justify-between gap-4 py-4">
                  <span class="flex flex-col gap-0.5">
                    <span class="font-display font-semibold text-sm group-hover:text-[#FF6B26]" style="color:#FFFFFF">{l.label}</span>
                    <span class="text-xs" style="color:#64748B">{l.desc}</span>
                  </span>
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="#4A7599" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>
