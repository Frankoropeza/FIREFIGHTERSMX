---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import CategoryCard from '@components/products/CategoryCard.astro';
import { allCategories } from '@data/categories';
import { featuredProducts } from '@data/products';
import { SITE } from '@config/site';

const canonicalURL = `${SITE.url}/productos/`;

const seoMeta = {
  title: `Equipo para Bomberos y Contra Incendios en México | Guía`,
  description:
    'Guía nacional de equipo para bomberos y contra incendios en México: trajes, cascos, SCBA, extintores, sistemas, rescate, HAZMAT y directorio de empresas.',
  canonicalURL,
};

/* ─── JSON-LD ──────────────────────────────────────────────── */

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Productos', item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: 'Guía de equipo para bomberos y equipo contra incendios en México',
  description: seoMeta.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: allCategories.length,
    itemListElement: allCategories.map((cat, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: cat.label,
      url: `${SITE.url}/productos/${cat.slug}`,
    })),
  },
};

/* Pilares de confianza bajo el hero */
const trustPoints = [
  { title: 'Categorías por necesidad', text: 'Explora familias de equipo para bomberos, extintores, sistemas contra incendio y rescate.' },
  { title: 'Fichas de referencia', text: 'Consulta características y normas publicadas en cada página antes de comparar opciones.' },
  { title: 'Búsqueda nacional', text: 'Usa el directorio de empresas para localizar proveedores por giro, estado y ciudad.' },
  { title: 'Información por confirmar', text: 'La disponibilidad, precio, cobertura y certificación deben confirmarse con cada empresa o fabricante.' },
];

const faqs = [
  {
    q: '¿Cuáles son los equipos de protección personal esenciales para bomberos?',
    a: 'El conjunto suele incluir traje de protección, casco, capucha, guantes, botas y equipo de respiración autónoma (SCBA). La selección depende del tipo de operación, el riesgo, la norma aplicable y la ficha técnica de cada fabricante.',
  },
  {
    q: '¿Qué tipos de equipos y sistemas de protección contra incendios existen?',
    a: 'El sector incluye extintores portátiles y sobre ruedas, sistemas de rociadores, detección y alarma, redes hidráulicas, equipo de protección personal, herramientas de rescate, cámaras térmicas y soluciones HAZMAT.',
  },
  {
    q: '¿Qué certificaciones deben revisarse en México?',
    a: 'La respuesta depende del producto y del uso. Pueden intervenir normas NOM, estándares NFPA y certificaciones del fabricante. La norma no debe asumirse como prueba automática: conviene revisar la edición aplicable, el alcance y la documentación del modelo.',
  },
  {
    q: '¿Dónde localizar empresas de equipo para bomberos en México?',
    a: 'El directorio nacional de FIREFIGHTERS MX organiza empresas por giro y estado. La disponibilidad, cobertura, precios y certificaciones deben confirmarse directamente con cada empresa.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: { '@type': 'Answer', text: faq.a },
  })),
};
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema, faqSchema]} noBrandSuffix>

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
        <li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:#94A3B8" aria-current="page">Productos</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero del catálogo -->
  <section class="relative overflow-hidden" style="background:#040A12;padding-block:5rem">
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" style="background:radial-gradient(ellipse 80% 70% at 90% 30%, rgba(247,80,0,0.08) 0%, transparent 65%)" aria-hidden="true"></div>

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <div>
          <span class="section-eyebrow mb-5 inline-flex">Guía nacional · Equipo para bomberos · Equipo contra incendios</span>
          <h1 class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2.5rem,5.5vw,4.5rem);line-height:0.95">
            Equipo para Bomberos<br/>
            <span style="color:#F75000">y Contra Incendios</span><br/>
            <span style="color:#CBD5E1">en México</span>
          </h1>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="/empresas/" class="btn btn-primary btn-lg">Buscar empresas proveedoras</a>
            <a href="/empresa/" class="btn btn-ghost btn-lg">Cómo funciona el directorio</a>
          </div>
        </div>

        <div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,0.1)">
          <p class="text-sm leading-[1.9] mb-5" style="color:#94A3B8">
            Consulta categorías de equipo para cuerpos de bomberos, brigadas industriales y Protección Civil: <strong style="color:#CBD5E1">trajes estructurales, cascos, equipos SCBA, herramientas de rescate, extintores, sistemas contra incendios, cámaras térmicas, HAZMAT y drones de emergencia</strong>.
          </p>
          <p class="text-sm leading-[1.9] mb-6" style="color:#64748B">
            Las páginas funcionan como referencia editorial. Las especificaciones, normas, marcas, disponibilidad y condiciones de compra deben validarse en la ficha técnica correspondiente y directamente con la empresa del directorio.
          </p>
          <div class="flex flex-wrap gap-2">
            {['NFPA 1970','NFPA 1850','NFPA 1936','NFPA 1930','NOM-154-SCFI','NOM-002-STPS'].map(n => (
              <span class="badge badge-dark font-display text-[10px]">{n}</span>
            ))}
          </div>
        </div>

      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-px" style="background:linear-gradient(90deg, transparent, rgba(247,80,0,0.4) 30%, rgba(247,80,0,0.4) 70%, transparent)" aria-hidden="true"></div>
  </section>
  <!-- Accesos rápidos (interlinking) -->
  <QuickLinksBar />


  <!-- Pilares de confianza -->
  <section class="section-tight" style="background:#070E1A" aria-label="Criterios editoriales de la guía">
    <div class="container-site">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4" style="border:1px solid rgba(74,117,153,0.18)">
        {trustPoints.map((t, i) => (
          <div class="flex flex-col gap-2 p-6" style={`background:#0C1825;${i < 3 ? 'border-right:1px solid rgba(74,117,153,0.18);' : ''}`}>
            <h2 class="font-display font-bold text-sm uppercase tracking-wider" style="color:#FF6B26">{t.title}</h2>
            <p class="text-xs leading-relaxed" style="color:#64748B">{t.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Categorías -->
  <section class="section" style="background:#040A12" aria-labelledby="categorias-title">
    <div class="container-site">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Categorías</span>
          <h2 id="categorias-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
            Categorías para comparar,<br/>
            <span style="color:#F75000">una decisión informada.</span>
          </h2>
        </div>
        <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed" style="color:#94A3B8">
            Cada categoría tiene su propia página con familias de producto, especificaciones y referencias normativas cuando están disponibles. Después puedes consultar el directorio para localizar empresas del giro correspondiente.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {allCategories.map((cat) => <CategoryCard cat={cat} />)}
      </div>

    </div>
  </section>

  <!-- Productos destacados -->
  <section class="section" style="background:#070E1A" aria-labelledby="destacados-title">
    <div class="container-site">

      <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
        <div>
        <span class="section-eyebrow mb-4 inline-flex">Referencias de producto</span>
          <h2 id="destacados-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
            Referencias para<br/>
            <span style="color:#F75000">comparar opciones.</span>
          </h2>
        </div>
        <a href="/empresas/" class="btn btn-outline btn-sm self-start sm:self-auto shrink-0">
          Buscar proveedor →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px" style="background:rgba(74,117,153,0.18);border:1px solid rgba(74,117,153,0.18)">
        {featuredProducts.map((product) => (
          <a href={product.href} class="grid-cell group flex flex-col gap-3 p-6">
            <div class="flex gap-2 flex-wrap">
              {product.norm && <span class="badge badge-fire">{product.norm}</span>}
              {product.brand && <span class="badge badge-dark">{product.brand}</span>}
              {product.badge && <span class="badge badge-gold">{product.badge}</span>}
            </div>
            <h3 class="font-display font-bold text-lg leading-snug group-hover:text-[#FF6B26]" style="color:#FFFFFF">{product.title}</h3>
            <p class="text-xs leading-relaxed" style="color:#64748B">{product.description}</p>
            <span class="text-xs font-display font-semibold uppercase tracking-wider mt-auto" style="color:#FF8F57">Ficha técnica de {product.title} →</span>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- Cómo cotizar + cross-links -->
  <section class="section" style="background:#040A12" aria-labelledby="como-cotizar-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">

        <div>
          <span class="section-eyebrow mb-4 inline-flex">Cómo cotizar</span>
          <h2 id="como-cotizar-title" class="font-display font-bold mb-6" style="color:#FFFFFF;font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
            Del catálogo al proveedor<br/>
            <span style="color:#F75000">que necesitas localizar.</span>
          </h2>
          <ol class="flex flex-col gap-4 list-none m-0 p-0">
            {[
              { n: '01', t: 'Identifica la categoría y las especificaciones que necesitas.' },
              { n: '02', t: 'Consulta el directorio por giro, estado y ciudad.' },
              { n: '03', t: 'Confirma directamente con cada empresa sus datos, cobertura y condiciones.' },
            ].map((s) => (
              <li class="flex items-start gap-4">
                <span class="font-display font-bold text-xl shrink-0" style="color:#F75000">{s.n}</span>
                <p class="text-sm leading-relaxed m-0" style="color:#94A3B8">{s.t}</p>
              </li>
            ))}
          </ol>
          <div class="flex flex-col sm:flex-row gap-3 mt-8">
            <a href="/empresas/" class="btn btn-primary">Ir al directorio nacional</a>
          </div>
        </div>

        <div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,0.15)">
          <h2 class="font-display font-bold text-sm uppercase tracking-widest mb-5" style="color:var(--forge-300)">
            También te puede servir
          </h2>
          <ul class="flex flex-col list-none m-0 p-0" style="border-top:1px solid rgba(74,117,153,0.15)">
            {[
              { label: 'Guía de normas y certificaciones', desc: 'Qué NOM y NFPA aplican según tu giro', href: '/certificaciones' },
              { label: 'Guía de mantenimiento y recarga', desc: 'Cómo comparar empresas, alcance y documentación', href: '/servicios/mantenimiento' },
              { label: 'Guía para licitaciones', desc: 'Checklist editorial de requisitos y proveedores', href: '/licitaciones' },
              { label: 'Marcas y fabricantes de referencia', desc: 'Globe, MSA, Dräger, Holmatro y más', href: '/marcas' },
              { label: 'Cobertura del directorio', desc: 'Empresas organizadas por estado y ciudad', href: '/cobertura' },
              { label: 'Cómo funciona', desc: 'Fuentes, alcance y contacto editorial', href: '/empresa' },
            ].map((l) => (
              <li style="border-bottom:1px solid rgba(74,117,153,0.15)">
                <a href={l.href} class="group flex items-center justify-between gap-4 py-4">
                  <span class="flex flex-col gap-0.5">
                    <span class="font-display font-semibold text-sm group-hover:text-[#FF6B26]" style="color:#FFFFFF">{l.label}</span>
                    <span class="text-xs" style="color:#64748B">{l.desc}</span>
                  </span>
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="var(--forge-300)" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>

  <section class="section" style="background:#070E1A" aria-labelledby="faq-productos-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.7fr] gap-12 lg:gap-20">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Preguntas frecuentes</span>
          <h2 id="faq-productos-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
            Cómo elegir<br/><span style="color:#F75000">equipo contra incendios.</span>
          </h2>
          <p class="text-sm leading-relaxed mt-5" style="color:#94A3B8">
            Usa esta guía para definir qué información necesitas antes de comparar empresas del sector.
          </p>
        </div>
        <div class="flex flex-col">
          {faqs.map((faq, i) => (
            <details class="faq-item group" style={`border-top:1px solid rgba(74,117,153,0.18);${i === faqs.length - 1 ? 'border-bottom:1px solid rgba(74,117,153,0.18);' : ''}`}>
              <summary class="flex items-center justify-between gap-4 py-5 cursor-pointer">
                <span class="font-display font-semibold text-sm" style="color:#FFFFFF">{faq.q}</span>
                <span class="faq-icon font-display font-bold text-xl shrink-0" style="color:#F75000">+</span>
              </summary>
              <p class="text-sm leading-relaxed pb-5 m-0" style="color:#94A3B8">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
