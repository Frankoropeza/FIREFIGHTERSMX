---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import CategoryCard from '@components/products/CategoryCard.astro';
import CategoryGuia from '@components/products/CategoryGuia.astro';
import CatalogoSidebar from '@components/products/CatalogoSidebar.astro';
import ProductosPorCategoria from '@components/products/ProductosPorCategoria.astro';
import LineaCard from '@components/products/LineaCard.astro';
import { allCategories, type Category } from '@data/categories';
import { catalogo, type LineaCatalogo } from '@data/catalogo';
import { imagenLinea } from '@lib/linea-card';
import { SITE, whatsappUrl, CANAL_CONTACTO } from '@config/site';

const canonicalURL = `${SITE.url}/productos/`;

const seoMeta = {
  title: `Catálogo de Equipo para Bomberos y Contra Incendio — ${SITE.name}`,
  description:
    'Catálogo certificado NFPA y NOM: trajes, cascos, SCBA, herramientas de rescate, extintores, sistemas CI, cámaras térmicas, HAZMAT y drones. Cotización en 24 h.',
  canonicalURL,
};

/* ─── JSON-LD ──────────────────────────────────────────────── */

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Productos', item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: 'Catálogo de equipo para bomberos y contra incendio',
  description: seoMeta.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: allCategories.length,
    itemListElement: allCategories.map((cat, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: cat.label,
      url: `${SITE.url}/productos/${cat.slug}`,
    })),
  },
};

/* Pilares de confianza bajo el hero */
const trustPoints = [
  { title: 'Originales verificables', text: 'Número de serie validable con fábrica y certificado de laboratorio acreditado.' },
  { title: 'Documentación completa', text: 'Ficha técnica, certificado de conformidad y manifiesto de normas en cada entrega.' },
  { title: 'Stock permanente', text: 'EPP estructural en tallas S–2XL listo para envío en 24–48 h desde CDMX.' },
  { title: 'Precios institucionales', text: 'Esquemas preferenciales para bomberos, Protección Civil y compras por volumen.' },
];

/* Rediseño 2026-09-30: secciones de la columna principal (anclas de la barra lateral) */
const secciones = [
  { id: 'categorias', label: 'Categorías de equipo' },
  { id: 'productos', label: 'Productos por categoría' },
  { id: 'guias', label: 'Guías de selección' },
  { id: 'como-cotizar', label: 'Cómo cotizar' },
];

/* Familias de catalogo.ts + categorías con página propia que no son línea (drones) */
const EXTRA_FAMILIA: Record<string, string[]> = { 'equipo-bomberos': ['drones-emergencia'] };
type ItemFamilia = { tipo: 'linea'; l: LineaCatalogo } | { tipo: 'categoria'; cat: Category };
const familias = catalogo.map((f) => ({
  ...f,
  items: [
    ...f.lineas.map((l): ItemFamilia => ({ tipo: 'linea', l })),
    ...(EXTRA_FAMILIA[f.slug] ?? [])
      .map((slug) => allCategories.find((c) => c.slug === slug))
      .filter((c): c is Category => !!c)
      .map((cat): ItemFamilia => ({ tipo: 'categoria', cat })),
  ],
}));

const pasos = [
    `Mándanos tu lista por ${CANAL_CONTACTO}, las bases de tu licitación o una foto del equipo a renovar.`,
    'Te regresamos propuesta con precios, disponibilidad, fichas técnicas y tiempos de entrega.',
    'Confirmas, entregamos con documentación completa y queda asignado tu ejecutivo de seguimiento.',
];

const tambien = [
              { label: 'Guía de normas y certificaciones', desc: 'Qué NOM y NFPA aplican según tu giro', href: '/certificaciones' },
              { label: 'Servicios de mantenimiento y recarga', desc: 'Extintores, SCBA e hidráulicas — NFPA 1850', href: '/servicios/mantenimiento' },
              { label: 'Soporte para licitaciones', desc: 'CompraNet, PEMEX, CFE y municipios', href: '/licitaciones' },
              { label: 'Marcas que distribuimos', desc: 'Globe, MSA, Dräger, Holmatro y más', href: '/marcas' },
              { label: 'Cobertura de entrega', desc: '24–48 h CDMX · 3–5 días nacional', href: '/cobertura' },
              { label: 'Conoce la empresa', desc: 'Quiénes somos, cobertura y certificaciones', href: '/empresa' },
];
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema]}>

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:var(--c-bg-alt);border-bottom:1px solid var(--c-line)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
        <li><a href="/" class="hover:text-[var(--c-accent)]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:var(--c-text-2)" aria-current="page">Productos</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero del catálogo -->
  <section class="relative overflow-hidden" style="background:var(--c-bg);padding-block:5rem">

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <div>
          <span class="section-eyebrow mb-5 inline-flex">Catálogo completo · NFPA y NOM</span>
          <h1 class="font-display font-bold mb-6" style="color:var(--c-ink);font-size:clamp(2.25rem,4.5vw,3.5rem);line-height:1.08">
            Equipo para Bomberos<br/>
            <span style="color:var(--c-accent)">y Contra Incendio</span>
          </h1>
          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href={whatsappUrl('Hola, quiero cotizar equipo del catálogo.')}
              target="_blank" rel="noopener"
              class="btn btn-primary btn-lg"
            >
              Cotizar por {CANAL_CONTACTO}
            </a>
            <a href="/cotizacion" class="btn btn-ghost btn-lg">Cotización formal</a>
          </div>
        </div>

        <div class="lg:pl-16" style="border-left:1px solid var(--c-line)">
          <p class="text-sm leading-[1.9] mb-5" style="color:var(--c-text-2)">
            Nueve categorías de equipamiento certificado para cuerpos de bomberos, brigadas
            industriales y protección civil: <strong style="color:var(--c-text)">trajes estructurales NFPA 1970 (antes 1971),
            cascos, equipos de respiración autónoma SCBA, herramientas de rescate
            Holmatro, extintores PQS NOM-100-STPS y CO₂ NOM-102-STPS, sistemas contra incendio, cámaras térmicas
            NFPA 1930, trajes HAZMAT, drones de emergencia, señalamientos de seguridad, lámparas de emergencia y botiquines de primeros auxilios</strong>.
          </p>
          <p class="text-sm leading-[1.9] mb-6" style="color:var(--c-muted)">
            Somos distribuidores autorizados de Globe, MSA, Dräger, Bullard, Holmatro y 3M Scott
            en México. Cada equipo se entrega con número de serie verificable, certificado de
            laboratorio acreditado y ficha técnica lista para licitación, auditoría STPS o
            expediente de Protección Civil.
          </p>
          <div class="flex flex-wrap gap-2">
            {['NFPA 1970','NFPA 1850','NFPA 1960','NFPA 1930','NOM-100-STPS','NOM-002-STPS'].map(n => (
            <span class="badge badge-dark font-display text-[10px]">{n}</span>
          ))}
          </div>
        </div>

      </div>
    </div>

  </section>
  <!-- Accesos rápidos (interlinking) -->
  <QuickLinksBar />


  <!-- Pilares de confianza -->
  <section class="section-tight" style="background:var(--c-bg-alt)" aria-label="Garantías de compra">
    <div class="container-site">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4" style="border:1px solid var(--c-line)">
        {trustPoints.map((t, i) => (
          <div class="flex flex-col gap-2 p-6" style={`background:var(--c-surface);${i < 3 ? 'border-right:1px solid var(--c-line);' : ''}`}>
            <h3 class="font-display font-bold text-sm" style="color:var(--c-accent)">{t.title}</h3>
            <p class="text-xs leading-relaxed" style="color:var(--c-muted)">{t.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Catálogo: barra lateral fija + columna principal (rediseño 2026-09-30) -->
  <div class="container-site pc-shell">
    <CatalogoSidebar secciones={secciones} />

    <div class="pc-main">

      <!-- Categorías por familia -->
      <section id="categorias" class="pc-sec" aria-labelledby="categorias-title">
        <header class="pc-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Categorías</span>
          <h2 id="categorias-title" class="pc-h2">Categorías de equipo contra incendio</h2>
          <p class="pc-lead">
            Cada categoría tiene su propia página con líneas disponibles, normas aplicables
            y productos destacados. Si no encuentras un modelo específico, lo conseguimos:
            trabajamos directo con fábrica y manejamos pedidos especiales sobre especificación técnica.
          </p>
        </header>

        {familias.map((familia) => (
          <div class="pc-fam" id={`familia-${familia.slug}`} aria-labelledby={`fam-${familia.slug}`}>
            <header class="pc-fam-head">
              <div>
                <p class="pc-fam-eyebrow">{familia.eyebrow}</p>
                <h3 id={`fam-${familia.slug}`} class="pc-fam-title">{familia.titulo}</h3>
              </div>
              <p class="pc-fam-text">{familia.texto}</p>
            </header>
            <ul class="pc-grid" role="list">
              {familia.items.map((it, i) => {
                const n = familia.items.length, r = n % 3, ultima = r > 0 && i >= n - r;
                const ancho = !ultima ? '' : r === 1 ? 'pc-span-6' : 'pc-span-3';
                return (
                  <li class={ancho || undefined}>
                    {it.tipo === 'linea'
                      ? <LineaCard href={it.l.href} norma={it.l.norma} titulo={it.l.titulo} texto={it.l.texto} imagen={imagenLinea(it.l.slug)} imagenAlt={it.l.imagenAlt} hijas={it.l.hijas} cta={it.l.cta} />
                      : <CategoryCard cat={it.cat} />}
                  </li>
                );
              })}
            </ul>
            <div class="pc-hub"><a href={familia.hub.href} class="btn btn-ghost">{familia.hub.label}</a></div>
          </div>
        ))}
      </section>

      <!-- Productos por categoría -->
      <section id="productos" class="pc-sec" aria-labelledby="productos-title">
        <header class="pc-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Lo más cotizado</span>
          <h2 id="productos-title" class="pc-h2">Productos por categoría</h2>
          <p class="pc-lead">Modelos con ficha técnica propia, agrupados por categoría, con su marca y la norma que cumplen.</p>
        </header>
        <ProductosPorCategoria />
      </section>

      <!-- Guías de selección (antes: módulos spotlight a pantalla completa) -->
      <section id="guias" class="pc-sec" aria-labelledby="guias-title">
        <header class="pc-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Guías de selección</span>
          <h2 id="guias-title" class="pc-h2">Cómo elegir el equipo de cada categoría</h2>
          <p class="pc-lead">Qué distingue a cada línea, qué norma aplica y qué revisar antes de cotizar.</p>
        </header>
        <div class="pc-guias">
          {allCategories.filter((cat) => cat.spotlight).map((cat) => <CategoryGuia cat={cat} />)}
        </div>
      </section>

      <!-- Cómo cotizar + cross-links -->
      <section id="como-cotizar" class="pc-sec" aria-labelledby="como-cotizar-title">
        <div class="pc-cotizar">
          <div>
            <span class="section-eyebrow mb-4 inline-flex">Cómo cotizar</span>
            <h2 id="como-cotizar-title" class="pc-h2">
              Del catálogo a tu operación<br/>
              <span style="color:var(--c-accent)">en menos de 24 horas.</span>
            </h2>
            <ol class="pc-steps" role="list">
              {pasos.map((t) => <li>{t}</li>)}
            </ol>
            <div class="flex flex-col sm:flex-row gap-3 mt-8">
              <a href={whatsappUrl('Hola, quiero cotizar equipo del catálogo.')} target="_blank" rel="noopener" class="btn btn-primary">
                Iniciar cotización
              </a>
            </div>
          </div>

          <div class="pc-also">
            <h2 class="pc-also-title">También te puede servir</h2>
            <ul class="pc-also-list" role="list">
              {tambien.map((l) => (
                <li>
                  <a href={l.href} class="pc-also-link">
                    <span class="pc-also-label">{l.label}</span>
                    <span class="pc-also-desc">{l.desc}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

    </div>
  </div>

<style>
  .pc-shell { display: grid; gap: 2rem; padding-block: 3rem 5rem; }
  @media (min-width: 1024px) { .pc-shell { grid-template-columns: 17rem minmax(0, 1fr); gap: 3rem; align-items: start; padding-block: 4rem 6rem; } }
  @media (min-width: 1440px) { .pc-shell { grid-template-columns: 18rem minmax(0, 1fr); gap: 3.5rem; } }
  .pc-main { min-width: 0; }

  .pc-sec { scroll-margin-top: calc(var(--header-height) + 1rem); }
  .pc-sec + .pc-sec { margin-top: 4rem; padding-top: 4rem; border-top: 1px solid var(--c-line); }
  .pc-sec-head { max-width: 48rem; margin-bottom: 2.25rem; }
  .pc-h2 { margin: 0; font-family: var(--font-display); font-weight: 700; color: var(--c-ink); font-size: clamp(1.625rem, 2.6vw, 2.25rem); line-height: 1.1; letter-spacing: -.02em; text-wrap: balance; }
  .pc-lead { margin: 1rem 0 0; font-size: 1rem; line-height: 1.7; color: var(--c-text-2); }

  /* Familias */
  .pc-fam { scroll-margin-top: calc(var(--header-height) + 1rem); }
  .pc-fam + .pc-fam { margin-top: 3.5rem; padding-top: 3.5rem; border-top: 1px solid var(--c-line); }
  .pc-fam-head { display: grid; gap: 1rem; margin-bottom: 1.75rem; }
  @media (min-width: 1280px) {
    .pc-fam-head { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0; align-items: center; }
    .pc-fam-head > :first-child { padding-right: 2.5rem; }
    .pc-fam-head > :last-child { padding-left: 2.5rem; border-left: 1px solid var(--c-line); text-align: justify; hyphens: auto; }
  }
  .pc-fam-eyebrow { margin: 0; font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--c-accent); }
  .pc-fam-title { margin: .375rem 0 0; font-family: var(--font-display); font-size: clamp(1.375rem, 2vw, 1.875rem); font-weight: 700; letter-spacing: -.02em; line-height: 1.2; color: var(--c-ink); }
  .pc-fam-text { margin: 0; font-size: .9375rem; line-height: 1.7; color: var(--c-text-2); }

  /* Rejilla: 1 · 2 · 3 por fila (6 subcolumnas en escritorio) */
  .pc-grid { display: grid; gap: 1.25rem; margin: 0; padding: 0; list-style: none; grid-template-columns: minmax(0, 1fr); }
  @media (min-width: 640px) { .pc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) {
    .pc-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .pc-grid > li { grid-column: span 2; }
    .pc-grid > li.pc-span-3 { grid-column: span 3; }
    .pc-grid > li.pc-span-6 { grid-column: span 6; }
    /* Fila final de 2: cards verticales a media fila, imagen panorámica a la misma altura que las de 3 */
    .pc-span-3 :global(.lc-media) { aspect-ratio: 5 / 2; }
    /* Fila final de 1: card horizontal a fila completa */
    .pc-span-6 :global(.lc) { flex-direction: row; }
    .pc-span-6 :global(.lc-media) { flex: 0 0 40%; aspect-ratio: auto; min-height: 100%; }
    .pc-span-6 :global(.lc-body) { padding: 1.5rem; }
  }
  .pc-hub { display: flex; justify-content: flex-end; margin-top: 1.5rem; }
  @media (max-width: 639px) { .pc-hub .btn { width: 100%; justify-content: center; white-space: normal; text-align: center; } }

  .pc-guias { display: flex; flex-direction: column; gap: 1.5rem; }

  /* Cómo cotizar */
  .pc-cotizar { display: grid; gap: 3rem; }
  @media (min-width: 1280px) { .pc-cotizar { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0; } .pc-cotizar > :first-child { padding-right: 3rem; } .pc-cotizar > :last-child { padding-left: 3rem; border-left: 1px solid var(--c-line); } }
  .pc-steps { margin: 1.75rem 0 0; padding: 0; list-style: none; border-top: 1px solid var(--c-line); }
  .pc-steps li { padding: 1rem 0; font-size: .9375rem; line-height: 1.65; color: var(--c-text-2); border-bottom: 1px solid var(--c-line); }
  .pc-also-title { margin: 0 0 1.25rem; font-family: var(--font-display); font-size: .875rem; font-weight: 700; color: var(--c-muted); }
  .pc-also-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--c-line); }
  .pc-also-list li { border-bottom: 1px solid var(--c-line); }
  .pc-also-link { display: flex; flex-direction: column; gap: .125rem; padding: 1rem .5rem 1rem 0; text-decoration: none; }
  .pc-also-label { font-family: var(--font-display); font-size: .9375rem; font-weight: 600; color: var(--c-ink); transition: color .15s; }
  .pc-also-desc { font-size: .8125rem; color: var(--c-muted); }
  .pc-also-link:hover .pc-also-label, .pc-also-link:focus-visible .pc-also-label { color: var(--c-accent); }
</style>

</BaseLayout>
