---
import EditorialCategoryHub from '@components/products/EditorialCategoryHub.astro';
const page = {
  slug:'camaras-termicas', breadcrumb:'Cámaras térmicas para bomberos', title:'Cámaras Termográficas para Bomberos en México | Guía',
  description:'Guía de cámara térmica y termográfica para bomberos: imagen infrarroja, búsqueda, rescate, extinción de incendios, NFPA 1930 y empresas del sector en México.',
  eyebrow:'Guía editorial · Imagen térmica', h1:'Cámaras termográficas', h1Accent:'para bomberos en México', accent:'#F75000',
  image:'/images/categorias/camaras-termicas.avif', imageAlt:'Cámara térmica para bomberos mostrando una imagen de calor',
  intro:['Las cámaras térmicas ayudan a interpretar diferencias de temperatura durante búsqueda y rescate, extinción de incendios, reconocimiento y revisión. Una cámara infrarroja detecta radiación de superficies y genera una imagen térmica; no sustituye entrenamiento ni evaluación del entorno.','Esta guía explica criterios para comparar una cámara térmica o cámara termográfica para bomberos. Las prestaciones y certificaciones deben comprobarse en la ficha del modelo y con la empresa correspondiente.'],
  badges:['Imagen térmica','Búsqueda','Rango','Modos','Batería','NFPA 1930'],
  typesHeading:'Tipos de cámara termográfica para incendio y rescate.', compareHeading:'Cómo elegir una cámara térmica de bomberos.', standardsHeading:'NFPA y documentación de cámaras termográficas.',
  types:[
    {title:'Cámara de mano',eyebrow:'Uso compartido',text:'Formato dedicado para búsqueda, reconocimiento y evaluación. Compara agarre con guantes, pantalla, controles, peso, resistencia y mejora de imagen.'},
    {title:'Cámara personal',eyebrow:'Asignación individual',text:'Prioriza portabilidad y acceso rápido. Evalúa campo de visión, autonomía, sujeción y limitaciones frente a una unidad de mayor tamaño.'},
    {title:'Imagen para mando',eyebrow:'Documentación y transmisión',text:'Algunos equipos incorporan grabación o transmisión. Confirma alcance, almacenamiento, seguridad de datos y utilidad dentro del sistema de mando.'},
    {title:'Inspección técnica',eyebrow:'Aplicación diferenciada',text:'Una cámara termográfica de alta resolución para inspección puede medir y documentar temperatura, pero no debe confundirse automáticamente con una cámara diseñada para lucha contra incendios.'},
  ],
  compare:['Define tareas: búsqueda, orientación, revisión, mando, HAZMAT o inspección.','Compara resolución, campo de visión, rango, frecuencia y forma de presentar temperaturas.','Evalúa modos de imagen, paletas y comportamiento cuando cambia el rango térmico.','Prueba controles, pantalla, agarre, correa y lectura con EPP y baja visibilidad.','Revisa batería, carga, repuestos, actualizaciones, garantía y mantenimiento.'],
  documentation:['Ficha técnica y manual del modelo.','Descripción de modos, rangos, precisión y limitaciones.','Documento de certificación cuando sea requisito.','Baterías, cargadores, accesorios y repuestos compatibles.','Procedimiento de inspección, limpieza, actualización y servicio.'],
  standards:[
    {title:'NFPA 1930',text:'La edición 2025 incluye el uso de cámaras térmicas por servicios de bomberos y emergencia, junto con otros equipos operativos.'},
    {title:'Alcance del modelo',text:'No todas las cámaras térmicas son equipos para combate. Verifica que el diseño, ensayos y documentación correspondan al uso previsto.'},
    {title:'Formación del usuario',text:'La interpretación de la imagen depende del escenario, emisividad, reflejos, humo, agua y límites del sensor; requiere práctica documentada.'},
  ],
  maintenanceTitle:'Control operativo de la cámara térmica.',
  maintenance:[{title:'Revisión antes del uso',text:'Confirma batería, pantalla, lente, carcasa, controles, accesorios y funcionamiento general.'},{title:'Limpieza y actualización',text:'Sigue las instrucciones del fabricante para lente, sellos, software y almacenamiento; evita métodos que dañen el sensor.'},{title:'Registro de fallas',text:'Documenta golpes, exposición, anomalías de imagen, baterías degradadas y reparaciones para decidir disponibilidad.'}],
  quoteData:['Uso principal y usuarios previstos.','Resolución, rango y campo de visión requeridos.','Modos, grabación o transmisión.','Peso, montaje y operación con guantes.','Número de baterías, cargadores y accesorios.','Norma, capacitación, garantía y mantenimiento.'],
  faqs:[
    {q:'¿Para qué sirve una cámara térmica en un incendio?',a:'Puede apoyar búsqueda, orientación, localización de diferencias térmicas y revisión. La imagen debe interpretarse junto con condiciones, procedimientos y otras señales.'},
    {q:'¿Una cámara térmica permite ver a través del humo o paredes?',a:'Puede formar imagen en determinadas condiciones de humo, pero no ve a través de paredes. Detecta radiación térmica de superficies dentro de su campo de visión y sus límites deben conocerse.'},
    {q:'¿Qué especificaciones conviene comparar?',a:'Resolución, campo de visión, rango, frecuencia, modos, pantalla, ergonomía, batería, resistencia, accesorios, documentación y soporte.'},
    {q:'¿Qué diferencia hay con una cámara de inspección?',a:'Las prioridades pueden ser distintas. Una cámara de bomberos enfatiza operación y resistencia en emergencias; una radiométrica puede priorizar medición. Verifica el uso declarado.'},
    {q:'¿Cómo verificar NFPA 1930?',a:'Solicita modelo y documento exactos y confirma edición y alcance. No asumas que toda la línea de una marca comparte la misma certificación.'},
  ],
  related:[{label:'Empresas de equipo para bomberos',href:'/empresas/venta-equipo/',text:'Directorio nacional por estado.'},{label:'Drones para bomberos',href:'/productos/drones-emergencia/',text:'Plataformas aéreas e imagen térmica.'},{label:'Herramientas de rescate',href:'/productos/herramientas-rescate/',text:'Equipo para extricación.'},{label:'Guía para cotizar',href:'/cotizacion/',text:'Datos para comparar propuestas.'}],
  sources:[{label:'NFPA 1930 — edición 2025',href:'https://link.nfpa.org/all-publications/1930/2025'}],
  directoryHref:'/empresas/venta-equipo/', directoryLabel:'Buscar empresas de equipo',
};
---
<EditorialCategoryHub {...page} />
