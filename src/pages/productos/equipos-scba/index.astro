---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import RelatedLinks from '@components/common/RelatedLinks.astro';
import ProductCard from '@components/products/ProductCard.astro';
import { categories } from '@data/categories';
import { featuredProducts } from '@data/products';
import { SITE, whatsappUrl, CANAL_CONTACTO } from '@config/site';

const cat = categories.find((c) => c.slug === 'equipos-scba')!;
const canonicalURL = `${SITE.url}/productos/equipos-scba/`;

const seoMeta = {
  title: 'Equipo de respiración autónoma NFPA 1970 | MSA, Scott, Dräger',
  description: 'Equipo de respiración autónoma SCBA para bomberos e industria: componentes, tipos, autonomía y NFPA 1970. MSA G1, Scott Air-Pak X3 Pro y Dräger PSS 7000.',
  canonicalURL,
};

/* Productos por marca */
const msaProducts = featuredProducts.filter(
  (p) => p.category === 'Equipos SCBA' && p.brand === 'MSA Safety' && p.specs
);
const dragerProducts = featuredProducts.filter(
  (p) => p.category === 'Equipos SCBA' && p.brand === 'Dräger' && p.specs
);
const scottProducts = featuredProducts.filter(
  (p) => p.category === 'Equipos SCBA' && p.brand === '3M Scott' && p.specs
);

/* Configuraciones (educativo) */
const configuraciones = [
  {
    title: 'Estructural',
    badge: 'NFPA 1970 · 30/45 min',
    accent: '#C8102E',
    desc: 'Combate de incendio en edificios. Cilindro de fibra de carbono 4500 psi de 30 ó 45 minutos, presión positiva, EOSTI y alarma PASS integrados.',
    icon: ``,
  },
  {
    title: 'Industrial / 60 min',
    badge: 'NFPA 1970 · 60 min',
    accent: '#B54708',
    desc: 'Autonomía extendida para industria pesada, petroquímica, túneles y espacios confinados. Opción ATEX antiestática. Mayor peso, mayor margen operativo.',
    icon: ``,
  },
  {
    title: 'CBRN / HAZMAT',
    badge: 'NIOSH CBRN · NFPA 1970',
    accent: '#067647',
    desc: 'Aprobación NIOSH CBRN para agentes químicos, biológicos, radiológicos y nucleares. Materiales descontaminables, compatible con trajes Nivel A encapsulados.',
    icon: ``,
  },
  {
    title: 'RIT / Rescate',
    badge: 'NFPA 1970 · RIT',
    accent: '#175CD3',
    desc: 'Rescate de bombero caído: segunda fuente de aire, conexión de transferencia (buddy breathing) y bolsa de despliegue rápido de alta visibilidad.',
    icon: ``,
  },
];

/* Tabla comparativa */
const comparativa = [
  ['Autonomía', '30 / 45 min', '60 min', 'Según botella', 'Segunda botella'],
  ['Cilindro', 'Fibra carbono 4500 psi', 'Fibra carbono 4500 psi', 'Fibra carbono 4500 psi', 'Fibra carbono 4500 psi'],
  ['Electrónica', 'EOSTI + PASS', 'EOSTI + telemetría', 'EOSTI + PASS · CBRN', 'EOSTI + transferencia'],
  ['Escenario', 'Incendio estructural', 'Industria · túneles', 'HAZMAT · CBRN', 'Rescate de bombero'],
  ['Norma', 'NFPA 1970', 'NFPA 1970', 'NFPA 1970 + NIOSH CBRN', 'NFPA 1970'],
];

/* Guía de selección */
const guia = [
  { n: '01', t: 'Define el escenario dominante: combate estructural (30/45 min), industria/confinados (60 min), HAZMAT/CBRN (NIOSH CBRN) o rescate de bombero (RIT). La configuración sale de ahí.' },
  { n: '02', t: 'Compara las tres marcas: MSA G1 integra PASS, EOSTI y telemetría; Dräger PSS 7000 existe en versión europea EN 137 y en versión certificada NFPA para América; 3M Scott Air-Pak X3 Pro está certificado NFPA 1970 (2025) por SEI con aprobación NIOSH.' },
  { n: '03', t: 'Exige certificación NFPA 1970 y aprobación NIOSH verificable por número de modelo —no de distribuidor. Para CBRN: aprobación NIOSH CBRN documentada por modelo exacto.' },
  { n: '04', t: 'Asegura el programa de mantenimiento: prueba de flujo anual, hidrostática de cilindro cada 5 años (vida útil 15 años) y servicio técnico autorizado con bitácora NFPA 1850.' },
];

/* Artículos relacionados */
const articulos = [
  { label: 'NFPA 1970: qué cubre y qué exige', desc: 'La norma que reemplazó a NFPA 1981', href: '/blog/guia-compra-scba-equipos-respiracion-autonoma' },
  { label: 'MSA G1 vs Dräger vs 3M Scott', desc: 'Comparativa técnica de tres SCBA internacionales', href: '/blog/msa-g1-vs-drager-pss7000-scba' },
  { label: 'Prueba hidrostática de cilindros', desc: 'Cuándo, cómo y por qué hacerla', href: '/blog/prueba-hidrostatica-cilindros-scba-nfpa' },
  { label: 'SCBA para espacios confinados', desc: 'Diferencias vs SCBA estructural', href: '/blog/cilindros-scba-fibra-carbono-vs-acero' },
];

/* FAQ */
const faqs = [
  { q: '¿Bajo qué norma debe estar certificado un SCBA de bombero en México?', a: 'Bajo NFPA 1970 (consolidó a la NFPA 1981 desde 2024) con aprobación NIOSH. Para HAZMAT se exige además aprobación NIOSH CBRN. Los pliegos de licitación pública en México referencian directamente NFPA 1970 y NIOSH por edición.' },
  { q: '¿Qué autonomía elijo: 30, 45 o 60 minutos?', a: 'La autonomía nominal asume consumo de referencia; el tiempo real depende del esfuerzo. 30 min es el estándar urbano, 45 min da margen para combate prolongado, 60 min es para industria, túneles y confinados donde la salida es larga. A mayor autonomía, mayor peso y volumen del cilindro.' },
  { q: '¿Cuál es la diferencia entre MSA G1, Dräger PSS 7000 y 3M Scott Air-Pak X3 Pro?', a: 'El MSA G1 integra PASS y EOSTI, telemetría y cilindros de 2216, 4500 y 5500 psi. El Dräger PSS 7000 existe en versión europea EN 137 y en versión certificada NFPA para América. El 3M Scott Air-Pak X3 Pro está certificado NFPA 1970 (2025) por SEI con aprobación NIOSH.' },
  { q: '¿Qué mantenimiento exige un SCBA y cada cuánto?', a: 'La NFPA 1850 (edición 2026, antes NFPA 1852) consolida el mantenimiento de SCBA. La recalificación de cilindros se realiza según su permiso especial y el control de su vida útil de 15 años.' },
  { q: '¿Entregan ficha técnica y servicio para licitación pública?', a: 'Sí. Cada SCBA incluye certificado de conformidad NFPA 1970, aprobación NIOSH y ficha técnica por configuración. Para concursos públicos (CompraNet, IMSS, Pemex, gobiernos estatales) generamos el manifiesto de cumplimiento por partida e incluimos el plan de servicio técnico autorizado para toda la vida útil.' },
];

/* Trust Pillars */
const razones = [
  {
    n: '01',
    t: 'Tres marcas internacionales',
    d: 'MSA Safety (NYSE: MSA), Dräger y 3M Scott — tres fabricantes de SCBA. Una sola fuente, servicio técnico autorizado y refacciones originales para toda la vida útil del equipo.',
  },
  {
    n: '02',
    t: 'Certificación verificable por número de serie',
    d: 'Cada SCBA incluye etiqueta de trazabilidad con número de modelo, lote y aprobación NIOSH verificable en la base pública de NIOSH. Documentación lista para auditorías NFPA 1850 y licitaciones públicas.',
  },
  {
    n: '03',
    t: 'Servicio técnico autorizado',
    d: 'Somos servicio técnico autorizado: recalificación de cilindros según su permiso especial y control de su vida útil de 15 años, prueba de flujo anual, mantenimiento de reguladores y refacciones originales con bitácora para auditoría.',
  },
  {
    n: '04',
    t: 'Stock permanente en CDMX',
    d: 'Inventario de modelos con entrega en 24–48 h desde CDMX. Para licitaciones generamos el manifiesto de cumplimiento de norma por partida e incluimos el plan de servicio técnico autorizado.',
  },
];

/* JSON-LD */
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Productos', item: `${SITE.url}/productos` },
    { '@type': 'ListItem', position: 3, name: 'Equipos SCBA', item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: 'Equipos SCBA certificados NFPA 1970 y NIOSH',
  description: cat.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: msaProducts.length + dragerProducts.length + scottProducts.length,
    itemListElement: [...msaProducts, ...dragerProducts, ...scottProducts].map((p, i) => ({
      '@type': 'ListItem', position: i + 1, name: p.title, url: `${SITE.url}${p.href}`,
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const otrasCategorias = categories.filter((c) => c.slug !== 'equipos-scba').slice(0, 6);
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema, faqSchema]}>

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:var(--c-bg-alt);border-bottom:1px solid var(--c-line)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center flex-wrap gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
        <li><a href="/" class="hover:text-[var(--c-accent)]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/productos" class="hover:text-[var(--c-accent)]">Productos</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:var(--c-text-2)" aria-current="page">Equipos SCBA</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background:var(--c-bg);padding-block:5rem">

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="section-eyebrow mb-5 inline-flex">{cat.norm}</span>
          <h1 class="font-display font-bold mb-4" style="color:var(--c-ink);font-size:clamp(2.25rem,4.5vw,3.5rem);line-height:1.08">
            Equipo de respiración autónoma<br/>
            <span style="color:var(--c-accent)">SCBA para bomberos e industria.</span>
          </h1>
          <p class="text-base leading-relaxed mb-8 max-w-xl" style="color:var(--c-text-2)">
            Distribuidores autorizados de MSA Safety, Dräger y 3M Scott en México. Equipos de
            respiración autónoma certificados NFPA 1970 — presión positiva, 30/45/60 min,
            sistemas PASS y EOSTI integrados para combate estructural, industrial y CBRN.
          </p>
          <div class="flex flex-col sm:flex-row sm:flex-wrap gap-3 w-full sm:w-auto min-w-0">
            <a href={whatsappUrl('Hola, quiero cotizar equipos SCBA NFPA 1970.')} target="_blank" rel="noopener" class="btn btn-primary btn-lg">Cotizar por {CANAL_CONTACTO}</a>
            <a href="/cotizacion" class="btn btn-ghost btn-lg">Cotización formal</a>
          </div>
        </div>
        <div class="lg:pl-16" style="border-left:1px solid var(--c-line)">
          {cat.intro.map((p) => (
            <p class="text-sm leading-[1.9] mb-5" style="color:var(--c-text-2)">{p}</p>
          ))}
          <div class="flex flex-wrap gap-2">
            {['NFPA 1970','NIOSH CBRN','4500 psi','30/45/60 min','EOSTI','PASS','MSA · Dräger · 3M Scott'].map(n => (
            <span class="badge badge-dark font-display text-[10px]">{n}</span>
          ))}
          </div>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-px" style="background:linear-gradient(90deg, transparent, rgba(200,16,46,0.4) 30%, rgba(200,16,46,0.4) 70%, transparent)" aria-hidden="true"></div>
  </section>

  <section id="guia-scba" class="section" style="background:var(--c-bg)" aria-labelledby="guia-scba-title">
    <div class="container-site content-copy">
      <div class="section-head mb-5">
        <h2 id="guia-scba-title">¿Qué es un equipo de respiración autónoma?</h2>
      </div>
      <p class="mb-8">Un equipo de respiración autónoma (ERA o SCBA, por sus siglas en inglés: self-contained breathing apparatus) es un equipo de protección respiratoria que permite al usuario respirar aire limpio de una botella que lleva en la espalda, sin depender del aire del entorno. Es el equipo que usan los bomberos para entrar a un incendio y el que usa la industria para trabajar en atmósferas IDLH, espacios confinados, túneles, alcantarillas o áreas con gases tóxicos.</p>
      <div class="section-head mt-14 mb-5"><h2>Componentes de un equipo de respiración autónoma</h2></div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {[
          ['Espaldera y arnés:', 'sostienen la botella y distribuyen el peso.'],
          ['Botella de aire comprimido:', 'de fibra de carbono (composite) con liner de aluminio, a alta presión (2216, 4500 o 5500 psi según el modelo).'],
          ['Regulador de presión:', 'reduce la presión del aire de la botella.'],
          ['Pulmoautomático:', 'entrega el aire respirable a la máscara a demanda, en presión positiva.'],
          ['Máscara facial:', 'sella el rostro y aísla al usuario del aire nocivo.'],
          ['Manómetro y alarma de fin de servicio (EOSTI):', 'indican el aire restante y avisan cuando hay que salir.'],
          ['PASS:', 'alarma de hombre muerto que suena si el bombero deja de moverse.'],
        ].map(([titulo, texto]) => <p class="p-5 m-0" style="background:var(--c-bg-alt);border:1px solid var(--c-line)"><strong>{titulo}</strong> {texto}</p>)}
      </div>
      <div class="section-head mt-14 mb-5"><h2>¿Cómo funciona un SCBA de circuito abierto?</h2></div>
      <p>El usuario inhala el aire de la botella a través del regulador y del pulmoautomático, y al exhalar el aire sale al exterior. La presión positiva mantiene la máscara ligeramente presurizada para que, ante una fuga, el aire salga en lugar de entrar el humo. Los equipos de circuito cerrado, en cambio, reciclan el aire exhalado y agregan oxígeno; se usan en rescate minero y operaciones prolongadas.</p>
      <div class="section-head mt-14 mb-5"><h2>¿Cuándo usar un equipo de aire autónomo?</h2></div>
      <p>Siempre que el aire del entorno no sea respirable o no se conozca su composición: extinción de incendios en interiores, rescate en humo, fugas de gas o de productos químicos, atmósferas con poco oxígeno, espacios confinados, tanques y alcantarillas. Una mascarilla con filtro no sirve en esos casos, porque depende del aire exterior; el equipo autónomo aísla por completo al usuario y le suministra aire de su propia botella.</p>
      <div class="section-head mt-14 mb-5"><h2>Tipos de equipos de protección respiratoria autónomos</h2></div>
      <div class="overflow-x-auto max-w-full min-w-0"><table class="w-full text-left text-sm" style="border-collapse:collapse;min-width:700px"><thead><tr style="background:var(--c-surface);color:var(--c-ink)"><th class="p-4">Tipo</th><th class="p-4">Uso</th></tr></thead><tbody>{[['SCBA estructural de circuito abierto', 'Extinción de incendios y rescate de bomberos'], ['SCBA industrial de larga duración', 'Petroquímica, minería, túneles y espacios confinados'], ['SCBA con aprobación NIOSH CBRN', 'Materiales peligrosos y agentes químicos, biológicos, radiológicos y nucleares'], ['Equipo de línea de aire', 'Trabajos largos con suministro de aire externo desde un compresor o banco de cilindros'], ['Equipo de escape', 'Evacuación de corta duración'], ['Circuito cerrado', 'Rescate minero y operaciones prolongadas']].map((fila) => <tr style="border-bottom:1px solid var(--c-line);color:var(--c-text-2)"><td class="p-4 font-display font-bold" style="color:var(--c-ink)">{fila[0]}</td><td class="p-4">{fila[1]}</td></tr>)}</tbody></table></div>
      <div class="section-head mt-14 mb-5"><h2>¿Cuánto dura un equipo de respiración autónoma?</h2></div>
      <p>Las botellas se clasifican en 30, 45 y 60 minutos, pero esa es una duración nominal. La autonomía real depende del consumo de aire del usuario: el esfuerzo, el calor y el estrés la reducen. Por eso la NFPA 1970 recalibró la alarma de fin de servicio para que suene entre el 28 % y el 34 % de la presión (31 % en un equipo de 4500 psi). La vida útil de las botellas de fibra de carbono es de 15 años.</p>
      <div class="section-head mt-14 mb-5"><h2>Cómo se coloca y se revisa antes de usarlo</h2></div>
      <ol class="flex flex-col gap-4 list-none m-0 p-0">{['Revisa que la botella esté llena en el manómetro y que la válvula abra por completo.', 'Colócate la espaldera y ajusta hombreras y cinturón para que el peso quede en la cadera.', 'Ponte la máscara, ajusta las correas y comprueba el sello antes de conectar el pulmoautomático.', 'Verifica que suenen las alarmas y que el PASS esté activo.', 'Después de cada uso: limpieza, inspección, recarga de la botella y registro de la revisión.'].map((paso, index) => <li class="flex items-start gap-4"><span class="font-display font-bold text-xl shrink-0" style="color:var(--c-accent)">{index + 1}</span><span>{paso}</span></li>)}</ol>
      <div class="section-head mt-14 mb-5"><h2>Normativa: NFPA 1970, NIOSH y NFPA 1850</h2></div>
      <p>En 2024 la NFPA consolidó en la NFPA 1970 las normas de trajes, ropa de trabajo, SCBA (antes NFPA 1981) y PASS (antes NFPA 1982). Para SCBA exige certificación por un tercero como SEI y la aprobación de respiradores de NIOSH; los equipos CBRN llevan además la aprobación NIOSH CBRN. El mantenimiento de los SCBA se rige hoy por la NFPA 1850, edición 2026, que integró la antigua NFPA 1852. En Europa el estándar equivalente es EN 137.</p>
      <div class="section-head mt-14 mb-5"><h2>Marcas de SCBA que manejamos</h2></div>
      <ul><li><strong>MSA G1:</strong> PASS y EOSTI integrados, telemetría y cilindros de 2216, 4500 y 5500 psi; la versión G1 XR está certificada NFPA 1970 (2025).</li><li><strong>3M Scott Air-Pak X3 Pro:</strong> certificado NFPA 1970 (2025).</li><li><strong>Dräger PSS 7000:</strong> en versión certificada NFPA para América y en versión EN 137; Dräger fue fundada en Lübeck en 1889.</li></ul>
      <div class="section-head mt-14 mb-5"><h2>¿Cuánto cuesta un equipo de respiración autónoma?</h2></div>
      <p>El precio depende de la marca y el modelo, la presión y duración de la botella, la electrónica (PASS, telemetría), la aprobación CBRN y los accesorios. Cotizamos por configuración completa para que compares equipos equivalentes.</p>
    </div>
  </section>

  <!-- Accesos rápidos -->
  <QuickLinksBar />

  <!-- Trust Pillars -->
  <section class="section-tight" style="background:var(--c-bg-alt)" aria-label="Por qué distribuimos estas marcas">
    <div class="container-site">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px" style="border:1px solid var(--c-line)">
        {razones.map((r, i) => (
          <div class="flex flex-col gap-3 p-6" style={`background:var(--c-bg-alt);${i < 3 ? 'border-right:1px solid rgba(74,117,153,0.12)' : ''}`}>
            
            <h3 class="font-display font-bold text-sm" style="color:var(--c-ink)">{r.t}</h3>
            <p class="text-xs leading-relaxed m-0" style="color:var(--c-muted)">{r.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Configuraciones -->
  <section class="section" style="background:var(--c-bg)" aria-labelledby="conf-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Cuatro escenarios, una plataforma</span>
          <h2 id="conf-title" class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
            La configuración correcta<br/>
            <span style="color:var(--c-accent)">según la operación.</span>
          </h2>
        </div>
        <div style="border-left:2px solid rgba(200,16,46,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed" style="color:var(--c-text-2)">
            Un SCBA estructural no es lo mismo que uno industrial de 60 minutos, ni que un equipo CBRN.
            Elegir la configuración según el riesgo dominante de tu brigada —y la autonomía real de la operación—
            es lo que garantiza protección y cumplimiento normativo.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {configuraciones.map((c) => (
          <article class="flex flex-col gap-4 p-7" style="background:var(--c-bg-alt);border:1px solid var(--c-line)">
            <div class="flex flex-col gap-1">
              <h3 class="font-display font-bold text-lg" style="color:var(--c-ink)">{c.title}</h3>
              <span class="badge badge-dark text-[9px]">{c.badge}</span>
            </div>
            <p class="text-sm leading-relaxed m-0" style="color:var(--c-text-2)">{c.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- MSA G1 -->
  <section class="section" style="background:var(--c-bg-alt)" aria-labelledby="msa-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">MSA Safety · NYSE: MSA · Distribuidor Autorizado MX</span>
          <h2 id="msa-title" class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
            SCBA MSA G1<br/>
            <span style="color:var(--c-accent)">certificado NFPA.</span>
          </h2>
        </div>
        <div style="border-left:2px solid rgba(200,16,46,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed mb-4" style="color:var(--c-text-2)">
            MSA Safety cotiza en la Bolsa de Nueva York (NYSE: MSA). El G1 integra PASS y EOSTI,
            telemetría y cilindros de 2216, 4500 y 5500 psi.
          </p>
          <div class="flex flex-wrap gap-2">
            {['NFPA 1970','NIOSH CBRN','EOSTI integrado','Telemetría ICM','4500 psi','Distribuidor autorizado MX'].map(b => (
              <span class="badge badge-dark text-[9px]">{b}</span>
            ))}
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {msaProducts.map((p) => (
