---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import ProductCard from '@components/products/ProductCard.astro';
import { trajesBombero, categories } from '@data/categories';
import { featuredProducts } from '@data/products';
import { SITE, whatsappUrl } from '@config/site';

const cat = trajesBombero;
const canonicalURL = `${SITE.url}/productos/trajes-bombero/`;

const seoMeta = {
  title: `Trajes para Bomberos NFPA 1970 y 1950 — 5 marcas en MX`,
  description: cat.description,
  canonicalURL,
};

/* Productos Globe — 5 modelos */
const globeProducts = featuredProducts.filter(
  (p) => p.category === 'Trajes Bombero' && p.brand === 'Globe Manufacturing' && p.specs
);

/* Productos Lion Apparel — 6 modelos */
const lionProducts = featuredProducts.filter(
  (p) => p.category === 'Trajes Bombero' && p.brand === 'Lion Apparel' && p.specs
);

/* Productos Honeywell Morning Pride — 6 modelos */
const honeywellProducts = featuredProducts.filter(
  (p) => p.category === 'Trajes Bombero' && p.brand === 'Honeywell Morning Pride' && p.specs
);

/* Productos Fire-Dex — 6 modelos */
const firedexProducts = featuredProducts.filter(
  (p) => p.category === 'Trajes Bombero' && p.brand === 'Fire-Dex' && p.specs
);

/* Productos Sköld — 6 modelos (fabricación mexicana) */
const skoldProducts = featuredProducts.filter(
  (p) => p.category === 'Trajes Bombero' && p.brand === 'Sköld' && p.specs
);

/* Producto real con ficha L4 (legado) */
const productos = featuredProducts.filter((p) => p.category === 'Trajes Bombero');

/* Tipos de traje (educativo) */
const tipos = [
  {
    title: 'Estructural',
    norm: 'NFPA 1970',
    accent: '#F75000',
    desc: 'Combate de incendio dentro de edificios. Tres capas —shell, barrera de humedad y forro térmico— para calor radiante intenso, llama súbita y vapor a presión.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>`,
  },
  {
    title: 'Proximidad',
    norm: 'NFPA 1970',
    accent: '#F5A623',
    desc: 'Conjunto aluminizado que refleja el calor radiante. Para aproximación a fuegos de combustible, ARFF en aeropuertos, refinerías y fundiciones.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="5"/><path d="M12 1v3M12 20v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M1 12h3M20 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"/></svg>`,
  },
  {
    title: 'Forestal',
    norm: 'NFPA 1950',
    accent: '#34D399',
    desc: 'Monocapa ligera y transpirable para incendio de vegetación e interfaz. Privilegia movilidad y manejo del estrés por calor en jornadas largas.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2 4 22h16L12 2z"/><path d="M12 8v8"/></svg>`,
  },
];

/* Modelos / líneas */
const modelos = [
  ...productos.map((p) => ({
    title: p.title,
    norm: p.norm ?? 'NFPA 1970',
    brand: p.brand,
    desc: p.description,
    href: p.href,
    cta: 'Ver ficha técnica',
    external: false,
  })),
  {
    title: 'Lion TechGen / V-Force',
    norm: 'NFPA 1970',
    brand: 'Lion',
    desc: 'Estructural de uso intensivo con excelente THL y opciones de protección CBRN. Disponible bajo pedido con asesoría de tallaje.',
    href: whatsappUrl('Hola, quiero cotizar trajes Lion TechGen NFPA 1970.'),
    cta: 'Cotizar',
    external: true,
  },
  {
    title: 'Trajes de proximidad aluminizados',
    norm: 'NFPA 1970',
    brand: 'ARFF',
    desc: 'Conjunto reflejante para exposición radiante extrema: aeropuertos, combustibles y procesos calientes. Refleja gran parte del calor radiante.',
    href: whatsappUrl('Hola, quiero cotizar trajes de proximidad aluminizados para ARFF.'),
    cta: 'Cotizar',
    external: true,
  },
  {
    title: 'Trajes forestales NFPA 1950',
    norm: 'NFPA 1950',
    brand: 'Nomex IIIA',
    desc: 'Camisola y pantalón ligeros y transpirables para incendio vegetal e interfaz, diseñados para jornadas largas con golpe de calor mínimo.',
    href: whatsappUrl('Hola, quiero cotizar trajes forestales NFPA 1950.'),
    cta: 'Cotizar',
    external: true,
  },
];

/* Tabla comparativa */
const comparativa = [
  ['Capas', '3 (shell + humedad + térmica)', '3 + shell aluminizado', '1 (monocapa FR)'],
  ['Peso aprox.', '4–5 kg', '5–6 kg', '1.5–2.5 kg'],
  ['Protección radiante', 'Alta', 'Muy alta (reflejante)', 'Moderada'],
  ['Transpirabilidad', 'Baja', 'Baja', 'Alta'],
  ['Escenario', 'Incendio en edificio', 'Combustibles · ARFF', 'Vegetación · interfaz'],
  ['Norma', 'NFPA 1970', 'NFPA 1970', 'NFPA 1950'],
];

/* Guía de selección */
const guia = [
  { n: '01', t: 'Define el escenario dominante: estructura, aproximación a combustible o incendio forestal. La norma correcta (1970 o 1977) sale de ahí.' },
  { n: '02', t: 'Exige certificación de tercera parte acreditada y la hoja de datos con valores THL y TPP del modelo exacto.' },
  { n: '03', t: 'Verifica que la capucha incluya bloqueo de partículas — obligatorio bajo NFPA 1970.' },
  { n: '04', t: 'Asegura tallaje S–4XL con asesoría de ajuste y el programa de inspección y mantenimiento NFPA 1850.' },
];

/* Artículos del blog relacionados */
const articulos = [
  { label: 'NFPA 1970: la nueva norma de trajes', desc: 'Qué cambió y cómo afecta tu compra', href: '/blog/nfpa-1970-nueva-norma-trajes-bombero' },
  { label: 'Estructural, proximidad o forestal', desc: 'Cuál necesita tu brigada', href: '/blog/traje-estructural-proximidad-forestal-diferencias' },
  { label: 'Anatomía de un traje de bombero', desc: 'Capas, materiales y marcas', href: '/blog/anatomia-traje-bombero-capas-materiales' },
  { label: 'Inspección, cuidado y vida útil', desc: 'Guía NFPA 1850 y retiro a 10 años', href: '/blog/inspeccion-cuidado-vida-util-traje-bombero' },
  { label: 'Traje fabricado en México', desc: 'Qué significa "equivalente a NFPA" y cuándo sirve', href: '/blog/traje-bombero-fabricado-mexico-equivalente-nfpa' },
];

/* FAQ */
const faqs = [
  { q: '¿Bajo qué norma debo comprar un traje estructural hoy?', a: 'Bajo NFPA 1970, la norma que desde 2024 consolidó a la NFPA 1971. Todo traje estructural nuevo debe estar certificado NFPA 1970 por laboratorio acreditado, con capucha de bloqueo de partículas incluida.' },
  { q: '¿Cuánto dura un traje de bombero?', a: 'La NFPA 1850 establece un retiro máximo a los 10 años desde la fecha de fabricación, sin importar su apariencia. Antes de ese límite, se retira si hay daño, contaminación irreversible o falla de la barrera de humedad.' },
  { q: '¿Qué tallas manejan y hacen ajuste a medida?', a: 'Manejamos tallas S–4XL con asesoría de ajuste. Para pedidos por volumen ofrecemos configuraciones a medida y entrega en 24–48 h en CDMX desde stock permanente.' },
  { q: '¿Cuál es la diferencia entre traje estructural y de proximidad?', a: 'El estructural es para entrar al fuego en edificios; el de proximidad añade una capa aluminizada que refleja el calor radiante para aproximarse a fuegos de combustible (ARFF, refinerías) sin entrar directamente a la llama.' },
  { q: '¿Entregan ficha técnica para licitación?', a: 'Sí. Cada traje incluye certificado de conformidad, ficha técnica del fabricante con THL/TPP y, para concursos públicos, el manifiesto de cumplimiento de norma por partida.' },
];

/* ─── JSON-LD ──────────────────────────────────────────────── */
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Productos', item: `${SITE.url}/productos` },
    { '@type': 'ListItem', position: 3, name: 'Trajes para Bomberos', item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: 'Trajes para Bomberos certificados NFPA 1970 y 1950',
  description: cat.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: modelos.length,
    itemListElement: modelos.map((m, i) => ({ '@type': 'ListItem', position: i + 1, name: m.title })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const otrasCategorias = categories.slice(0, 6);

/* Trust Pillars */
const razones = [
  {
    n: '01',
    t: 'Cinco marcas, tier-1 y nacional',
    d: 'Globe Manufacturing (MSA Safety), Lion Apparel, Honeywell Morning Pride y Fire-Dex — las cuatro marcas más licitadas en México — más Sköld Safety, fabricante mexicano con planta en Monterrey. Distribuidor autorizado con un solo expediente para todo el EPP.',
  },
  {
    n: '02',
    t: 'Certificación verificable por número de serie',
    d: 'Cada traje incluye etiqueta de trazabilidad con número de serie, lote y laboratorio acreditado. Documentación lista para auditorías NFPA 1850, licitaciones públicas y procesos de acreditación institucional.',
  },
  {
    n: '03',
    t: 'Tallas S–4XL con asesoría de ajuste',
    d: 'Stock permanente en CDMX con entrega en 24–48 h. Para pedidos por volumen ofrecemos configuraciones a medida y asesoría de tallaje. El traje mal ajustado es tan peligroso como el traje sin certificar.',
  },
  {
    n: '04',
    t: 'Soporte completo para licitaciones',
    d: 'Generamos el manifiesto de cumplimiento de norma por partida — NFPA 1970 o 1950 por edición — con ficha técnica y certificado de conformidad del fabricante, para CompraNet, IMSS, Pemex y gobiernos estatales.',
  },
];
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema, faqSchema]}>

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center flex-wrap gap-2 text-xs list-none m-0 p-0" style="color:#4A7599">
        <li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/productos" class="hover:text-[#FF6B26]">Productos</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:#94A3B8" aria-current="page">Trajes para Bomberos</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background:#040A12;padding-block:5rem">
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" style="background:radial-gradient(ellipse 80% 70% at 90% 30%, rgba(247,80,0,0.08) 0%, transparent 65%)" aria-hidden="true"></div>

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="section-eyebrow mb-5 inline-flex">{cat.norm}</span>
          <h1 class="font-display font-bold uppercase mb-4" style="color:#FFFFFF;font-size:clamp(2.5rem,5.5vw,4.5rem);line-height:0.95">
            Trajes para<br/>
            <span style="color:#F75000">Bomberos</span>
          </h1>
          <p class="text-base leading-relaxed mb-8 max-w-xl" style="color:#94A3B8">
            Distribuidores autorizados de Globe Manufacturing, Lion Apparel, Honeywell Morning Pride
            y Fire-Dex en México, más la línea nacional Sköld Safety. Trajes estructurales certificados
            NFPA 1970 con PBI, Nomex y Crosstech — todos los materiales de alta performance en un solo
            distribuidor.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href={whatsappUrl('Hola, quiero cotizar trajes para bomberos.')} target="_blank" rel="noopener" class="btn btn-primary btn-lg">Cotizar por WhatsApp</a>
            <a href="/cotizacion" class="btn btn-ghost btn-lg">Cotización formal</a>
          </div>
        </div>
        <div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,0.1)">
          {cat.intro.map((p) => (
            <p class="text-sm leading-[1.9] mb-5" style="color:#94A3B8">{p}</p>
          ))}
          <div class="flex flex-wrap gap-2">
            {['NFPA 1970','NFPA 1950','NFPA 1850','PBI','Crosstech','5 marcas · tier-1 y nacional'].map(n => (
              <span class="badge badge-dark font-display text-[10px]">{n}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-px" style="background:linear-gradient(90deg, transparent, rgba(247,80,0,0.4) 30%, rgba(247,80,0,0.4) 70%, transparent)" aria-hidden="true"></div>
  </section>

  <!-- Accesos rápidos -->
  <QuickLinksBar />

  <!-- Trust Pillars -->
  <section class="section-tight" style="background:#070E1A" aria-label="Por qué distribuimos estas marcas">
    <div class="container-site">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px" style="border:1px solid rgba(74,117,153,0.18)">
        {razones.map((r, i) => (
          <div class="flex flex-col gap-3 p-6" style={`background:#080F1A;${i < 3 ? 'border-right:1px solid rgba(74,117,153,0.12)' : ''}`}>
            <span class="font-display font-bold text-2xl" style="color:#F75000">{r.n}</span>
            <h3 class="font-display font-bold text-sm uppercase tracking-wide" style="color:#FFFFFF">{r.t}</h3>
            <p class="text-xs leading-relaxed m-0" style="color:#64748B">{r.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tipos de traje -->
  <section class="section" style="background:#040A12" aria-labelledby="tipos-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Tres tipos, tres físicas</span>
          <h2 id="tipos-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
            El traje correcto<br/>
            <span style="color:#F75000">según el fuego.</span>
          </h2>
        </div>
        <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed" style="color:#94A3B8">
            No todos los incendios son iguales. Elegir entre estructural, proximidad o forestal
            según el riesgo dominante de tu brigada es lo que separa una compra acertada de
            una cara equivocación.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {tipos.map((t) => (
          <article class="flex flex-col gap-4 p-7" style="background:#080F1A;border:1px solid rgba(74,117,153,0.18)">
            <div class="flex items-center justify-center rounded-full" style={`width:52px;height:52px;background:${t.accent}1a;border:1.5px solid ${t.accent}59;color:${t.accent}`}>
              <span class="block" style="width:24px;height:24px" set:html={t.icon}/>
            </div>
            <div class="flex items-center justify-between gap-2">
              <h3 class="font-display font-bold text-xl" style="color:#FFFFFF">{t.title}</h3>
              <span class="badge badge-dark text-[9px]">{t.norm}</span>
            </div>
            <p class="text-sm leading-relaxed m-0" style="color:#94A3B8">{t.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Productos Globe — 5 cards profesionales -->
  <section class="section" style="background:#070E1A" aria-labelledby="modelos-title">
    <div class="container-site">

      {/* Header de sección */}
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Globe Manufacturing · MSA Safety</span>
          <h2 id="modelos-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
            Trajes Globe<br/>
            <span style="color:#F75000">certificados NFPA.</span>
          </h2>
        </div>
        <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed mb-4" style="color:#94A3B8">
            Globe Manufacturing — parte de MSA Safety — es la marca de trajes estructurales
            más solicitada en licitaciones mexicanas tier-1. Más de 110 años fabricando el
            traje en el que confían departamentos en los 32 estados.
          </p>
          <div class="flex flex-wrap gap-2">
            {['NFPA 1970','PBI Matrix','GORE-TEX CrossTech','Distribuidor autorizado MX'].map(b => (
              <span class="badge badge-dark text-[9px]">{b}</span>
            ))}
          </div>
        </div>
      </div>

      {/* Grid de productos — 3 por fila */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {globeProducts.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>

      {/* CTA — catálogo Globe + link L2 */}
      <div class="mt-10 pt-8 flex flex-col sm:flex-row gap-4 items-start" style="border-top:1px solid rgba(74,117,153,0.15)">
        <div class="flex-1">
          <p class="text-sm leading-relaxed m-0" style="color:#64748B">
            ¿Quieres ver la comparativa técnica completa, el FAQ de Globe o cotizar con ficha técnica para licitación?
            Accede al catálogo dedicado de la marca.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a href="/productos/trajes-bombero/globe-manufacturing" class="btn btn-primary btn-lg">
            Catálogo Globe completo →
          </a>
          <a
            href={whatsappUrl('Hola, quiero cotizar trajes Globe Manufacturing NFPA 1970.')}
            target="_blank" rel="noopener"
            class="btn btn-ghost btn-lg"
          >
            Cotizar por WhatsApp
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- Productos Lion Apparel — 6 cards -->
  <section class="section" style="background:#040A12" aria-labelledby="lion-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Lion Apparel · 135 años de historia</span>
          <h2 id="lion-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
            Trajes Lion<br/>
            <span style="color:#F75000">certificados NFPA.</span>
          </h2>
        </div>
        <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed mb-4" style="color:#94A3B8">
            Lion Apparel — fundada en 1889 — es el segundo fabricante de trajes de bombero
            más licitado en México. Fuerte en departamentos metropolitanos, corporativos
            industriales y brigadas ARFF. Líneas estructurales, de proximidad y forestales NFPA 1950.
          </p>
          <div class="flex flex-wrap gap-2">
            {['NFPA 1970','NFPA 1950','PBI Matrix','V-Force®','Distribuidor autorizado MX'].map(b => (
              <span class="badge badge-dark text-[9px]">{b}</span>
            ))}
          </div>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {lionProducts.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>
      <div class="mt-10 pt-8 flex flex-col sm:flex-row gap-4 items-start" style="border-top:1px solid rgba(74,117,153,0.15)">
        <div class="flex-1">
          <p class="text-sm leading-relaxed m-0" style="color:#64748B">
            ¿Necesitas configuración personalizada de tallas o un modelo Lion específico para licitación?
            Cotizamos cualquier modelo sobre especificación técnica con entrega verificada.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a href="/productos/trajes-bombero/lion-apparel" class="btn btn-primary btn-lg">
            Catálogo Lion completo →
          </a>
          <a href={whatsappUrl('Hola, quiero cotizar trajes Lion Apparel NFPA 1970.')} target="_blank" rel="noopener" class="btn btn-ghost btn-lg">
            Cotizar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Productos Honeywell Morning Pride — 6 cards -->
  <section class="section" style="background:#070E1A" aria-labelledby="honeywell-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Honeywell Morning Pride · Pemex · Refinería</span>
          <h2 id="honeywell-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
            Trajes Honeywell<br/>
            <span style="color:#F75000">certificados NFPA.</span>
          </h2>
        </div>
        <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed mb-4" style="color:#94A3B8">
            Honeywell Morning Pride es la marca de referencia para operaciones de alto riesgo
            en petroquímica, refinerías y brigadas HAZMAT. Fuerte presencia en Pemex, CFE
            y aeropuertos internacionales en México. Líneas estructurales, proximity y CBRN.
          </p>
          <div class="flex flex-wrap gap-2">
            {['NFPA 1970','NFPA 2112','PBI Gold','CarbonX®','BioClad® CBRN'].map(b => (
              <span class="badge badge-dark text-[9px]">{b}</span>
            ))}
          </div>
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
