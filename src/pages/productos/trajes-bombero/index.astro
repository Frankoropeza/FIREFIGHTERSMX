---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { featuredProducts } from '@data/products';

const breadcrumb = [
  { label:"Inicio", href:"/" },
  { label:"Productos", href:"/productos" },
  { label:"Trajes para Bomberos", href:"/productos/trajes-bombero" },
];

const trajes = featuredProducts.filter(p => p.category ==="Trajes Bombero");
---
<BaseLayout
  title="Trajes para Bomberos NFPA 1971 — FIREFIGHTERS MX México"
  description="Trajes estructurales y de proximidad para bomberos certificados NFPA 1971 en México. Globe, Lion, MSA. Entrega en 32 estados. Cotización gratis."
>
  <nav class="bg-dark-50 border-b border-dark-100 py-3" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-sm text-dark-400">
        {breadcrumb.map((crumb, i) => (
          <>
            {i > 0 && <li aria-hidden="true" class="text-dark-300">/</li>}
            <li>
              {i === breadcrumb.length - 1 ? (
                <span class="text-dark-600 font-medium">{crumb.label}</span>
              ) : (
                <a href={crumb.href} class="hover:text-fire-700">{crumb.label}</a>
              )}
            </li>
          </>
        ))}
      </ol>
    </div>
  </nav>

  <section class="bg-gradient-fire py-16">
    <div class="container-site text-white">
      <h1 class="section-title text-white mb-4">Trajes para Bomberos</h1>
      <p class="section-subtitle text-fire-200 max-w-2xl">
        Trajes estructurales, de proximidad y para incendios forestales.
        Certificados NFPA 1971:2018. Disponibles en tallas S–4XL.
      </p>
    </div>
  </section>
  <!-- Accesos rápidos (interlinking) -->
  <QuickLinksBar />


  <section class="section bg-white">
    <div class="container-site">
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        {[
          { title:"Trajes Estructurales", desc:"Para combate interior de edificios. 3 capas: shell, barrera humedad, forro térmico. NFPA 1971.", href:"#estructurales" },
          { title:"Trajes de Proximidad", desc:"Para exposición radiante intensa: pistas aéreas, refinerías, carga de aviones. Aluminizados.", href:"#proximidad" },
          { title:"Trajes Forestales", desc:"Ligeros y transpirables para incendios vegetales. NFPA 1977.", href:"#forestales" },
        ].map((tipo) => (
          <a href={tipo.href} class="card-fire p-6 group">
            <h3 class="font-heading font-bold text-dark-900 group-hover:text-fire-700 mb-2">{tipo.title}</h3>
            <p class="text-dark-500 text-sm">{tipo.desc}</p>
          </a>
        ))}
      </div>

      <div id="estructurales" class="mb-16">
        <h2 class="section-title mb-8">Trajes Estructurales Certificados</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {trajes.length > 0 ? trajes.map((product) => (
            <a href={product.href} class="card group p-6 flex flex-col gap-3 hover:shadow-fire">
              <div class="flex gap-2 flex-wrap">
                <span class="badge-fire">{product.norm}</span>
                {product.brand && <span class="badge-dark">{product.brand}</span>}
              </div>
              <h3 class="font-heading font-bold text-dark-900 group-hover:text-fire-700">{product.title}</h3>
              <p class="text-dark-500 text-sm line-clamp-2">{product.description}</p>
              <span class="text-fire-700 text-sm font-semibold mt-auto">Ver detalles →</span>
            </a>
          )) : (
            <div class="col-span-3 text-center py-12">
              <p class="text-dark-400 mb-4">Catálogo completo disponible en cotización.</p>
              <a href="/cotizacion" class="btn-primary">Solicitar catálogo completo</a>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-gradient-fire">
    <div class="container-site text-center text-white">
      <h2 class="font-heading font-black text-3xl mb-6">¿No encuentras el traje que buscas?</h2>
      <p class="text-fire-200 mb-8 max-w-xl mx-auto">
        Contamos con más de 40 modelos de trajes estructurales, de proximidad y forestales.
        Solicita el catálogo completo con fichas técnicas.
      </p>
      <a href="/cotizacion" class="btn-gold btn-lg">Solicitar catálogo y cotización</a>
    </div>
  </section>
</BaseLayout>
