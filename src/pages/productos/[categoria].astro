---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { allCategories, type Category } from '@data/categories';
import { featuredProducts } from '@data/products';
import { brandPages } from '@data/brandPages';
import { SITE, whatsappUrl } from '@config/site';

export function getStaticPaths() {
  // Slugs con página estática dedicada (productos/<slug>/index.astro) — excluir del dinámico
  const staticL3 = ['trajes-bombero', 'cascos-nfpa', 'drones-emergencia'];
  return allCategories
    .filter((cat) => !staticL3.includes(cat.slug))
    .map((cat) => ({
      params: { categoria: cat.slug },
      props: { cat },
    }));
}

interface Props {
  cat: Category;
}

const { cat } = Astro.props;
const products = cat.productCategory
  ? featuredProducts.filter((p) => p.category === cat.productCategory)
  : [];
/* Marcas con página L4 dedicada en esta categoría (sistema BrandPage) */
const marcas = brandPages.filter((b) => b.categorySlug === cat.slug);

const canonicalURL = `${SITE.url}/productos/${cat.slug}/`;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Productos', item: `${SITE.url}/productos` },
    { '@type': 'ListItem', position: 3, name: cat.label, item: canonicalURL },
  ],
};

const otherCategories = allCategories.filter((c) => c.slug !== cat.slug).slice(0, 5);
---

<BaseLayout
  title={`${cat.label} ${cat.norm.split('·')[0].trim()} — ${SITE.name} México`}
  description={cat.description}
  canonicalURL={canonicalURL}
  schema={breadcrumbSchema}
>
  <!-- Breadcrumb -->
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:#4A7599">
        <li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/productos" class="hover:text-[#FF6B26]">Productos</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:#94A3B8" aria-current="page">{cat.label}</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero de categoría -->
  <section class="relative overflow-hidden" style="background:#040A12" aria-labelledby={`hero-${cat.slug}`}>
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" style="background:radial-gradient(ellipse 80% 70% at 90% 30%, rgba(247,80,0,0.08) 0%, transparent 65%)" aria-hidden="true"></div>

    <div class="container-site relative z-10">
      <div class="flex flex-col justify-center py-14 lg:py-20">
        <span class="section-eyebrow mb-5 inline-flex">{cat.norm}</span>
        <h1 id={`hero-${cat.slug}`} class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2.5rem,6vw,4.5rem);line-height:0.95">
          {cat.label}
        </h1>
        <div class="flex flex-col gap-4 mb-8" style="max-width:48rem">
          {cat.intro.map((p) => (
            <p class="text-sm leading-[1.9]" style="color:#94A3B8">{p}</p>
          ))}
        </div>
        <div class="flex flex-col sm:flex-row gap-3">
          <a
            href={whatsappUrl(`Hola, quiero cotizar ${cat.label.toLowerCase()}.`)}
            target="_blank" rel="noopener"
            class="btn btn-primary"
          >
            Cotizar {cat.label.toLowerCase()}
          </a>
          <a href="/productos" class="btn btn-ghost">Todas las guías de equipo para bomberos</a>
        </div>
      </div>
    </div>
  </section>
  <!-- Accesos rápidos (interlinking) -->
  <QuickLinksBar />

  <!-- Catálogo por marca (páginas L4 dedicadas) -->
  {marcas.length > 0 && (
    <section class="section" style="background:#070E1A" aria-labelledby="marcas-title">
      <div class="container-site">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-10">
          <div>
            <span class="section-eyebrow mb-4 inline-flex">Marcas autorizadas</span>
            <h2 id="marcas-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.8rem,3.5vw,2.8rem);line-height:1.05">
              Catálogo por<br/>
              <span style="color:#F75000">marca.</span>
            </h2>
          </div>
          <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
            <p class="text-sm leading-relaxed" style="color:#94A3B8">
              Cada marca tiene su catálogo dedicado con comparativa técnica, anatomía del modelo insignia, guía de
              selección y FAQ. Distribuidor autorizado con stock en CDMX y ficha para licitación.
            </p>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {marcas.map((b) => (
            <a href={`/productos/${b.categorySlug}/${b.slug}`} class="group flex flex-col gap-3 p-7" style="background:#040A12;border:1px solid rgba(74,117,153,0.18)">
              <h3 class="font-display font-bold text-xl group-hover:text-[#FF6B26]" style="color:#FFFFFF">{b.brandLabel}</h3>
              <p class="text-xs leading-relaxed flex-1" style="color:#64748B">{b.crossDesc}</p>
              <span class="inline-flex items-center gap-1.5 text-xs font-display font-semibold uppercase tracking-wider" style="color:#FF8F57">
                Ver catálogo
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/></svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}


  <!-- Líneas / modelos -->
  <section class="section" style="background:#070E1A" aria-labelledby="lineas-title">
    <div class="container-site">
      <h2 id="lineas-title" class="font-display font-bold mb-8" style="color:#FFFFFF;font-size:clamp(1.5rem,2.5vw,2.25rem)">
        Líneas disponibles
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4" style="border-top:1px solid rgba(74,117,153,0.18);border-left:1px solid rgba(74,117,153,0.18)">
        {cat.items.map((item) => (
          <div class="grid-cell flex flex-col gap-2 p-6" style="border-right:1px solid rgba(74,117,153,0.18);border-bottom:1px solid rgba(74,117,153,0.18)">
            <h3 class="font-display font-bold text-base" style="color:#FFFFFF">{item.name}</h3>
            <p class="text-xs leading-relaxed" style="color:#64748B">{item.detail}</p>
          </div>
        ))}
      </div>

      {products.length > 0 && (
        <div class="mt-12">
          <h2 class="font-display font-bold mb-8" style="color:#FFFFFF;font-size:clamp(1.5rem,2.5vw,2.25rem)">
            Productos destacados
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px" style="background:rgba(74,117,153,0.18);border:1px solid rgba(74,117,153,0.18)">
            {products.map((product) => (
              <a href={product.href} class="grid-cell group flex flex-col overflow-hidden">
                {product.image && (
                  <div class="relative overflow-hidden shrink-0" style="aspect-ratio:16/9">
                    <img
                      src={product.image}
                      alt={product.title}
                      width="480"
                      height="270"
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full block"
                      style="object-fit:cover;object-position:center"
                    />
                    <div class="absolute inset-0 pointer-events-none" style="background:linear-gradient(to top, rgba(4,10,18,0.85) 0%, rgba(4,10,18,0.0) 60%)" aria-hidden="true"></div>
                  </div>
                )}
                <div class="flex flex-col gap-3 p-6 flex-1">
                  <div class="flex gap-2 flex-wrap">
                    {product.norm && <span class="badge badge-fire">{product.norm}</span>}
                    {product.brand && <span class="badge badge-dark">{product.brand}</span>}
                  </div>
                  <h3 class="font-display font-bold text-lg leading-snug group-hover:text-[#FF6B26]" style="color:#FFFFFF">{product.title}</h3>
                  <p class="text-xs leading-relaxed" style="color:#64748B">{product.description}</p>
                  <span class="text-xs font-display font-semibold uppercase tracking-wider mt-auto" style="color:#FF8F57">Ficha técnica de {product.title} →</span>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Otras categorías (internal linking) -->
  <section class="section-tight" style="background:#040A12" aria-labelledby="otras-title">
    <div class="container-site">
      <h2 id="otras-title" class="font-display font-bold text-sm uppercase tracking-widest mb-6" style="color:#4A7599">
        Otras categorías del catálogo
      </h2>
      <div class="flex flex-wrap gap-3">
        {otherCategories.map((c) => (
          <a href={`/productos/${c.slug}`} class="btn btn-sm btn-dark">{c.label}</a>
        ))}
        <a href="/productos" class="btn btn-sm btn-outline">Catálogo completo →</a>
      </div>
    </div>
  </section>
</BaseLayout>
