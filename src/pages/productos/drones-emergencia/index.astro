---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import RelatedLinks from '@components/common/RelatedLinks.astro';
import ProductCard from '@components/products/ProductCard.astro';
import { categories, allCategories } from '@data/categories';
import { featuredProducts } from '@data/products';
import { brandPages } from '@data/brandPages';
import { SITE, whatsappUrl, CANAL_CONTACTO } from '@config/site';

const cat = categories.find((c) => c.slug === 'drones-emergencia')!;
const canonicalURL = `${SITE.url}/productos/drones-emergencia/`;

/* Marca DJI y sus productos */
const marcas = brandPages.filter((b) => b.categorySlug === 'drones-emergencia');
const dronesProducts = featuredProducts.filter((p) => p.category === 'Drones Emergencia' && p.specs);

const seoMeta = {
  title: 'Dron con cámara térmica para bomberos y protección civil en México',
  description: 'Drones con cámara térmica radiométrica para bomberos: usos, especificaciones, DJI Matrice y Mavic 3 Thermal, estaciones Dock y requisitos de la NOM-107-SCT3-2019.',
  canonicalURL,
};

/* Tipos de misión */
const misiones = [
  {
    title: 'Evaluación de incendios',
    norm: 'ISR aéreo',
    accent: '#F75000',
    desc: 'Vista cenital del avance del fuego, puntos calientes y rutas de ataque en estructural y forestal. Información táctica en minutos, no horas.',
    icon: ``,
  },
  {
    title: 'Búsqueda y rescate',
    norm: 'Cámara térmica',
    accent: '#F5A623',
    desc: 'Sensor radiométrico que detecta firmas de calor humanas de noche, entre vegetación o en estructuras colapsadas. Encuentra lo que el ojo no ve.',
    icon: ``,
  },
  {
    title: 'Reconocimiento HAZMAT',
    norm: 'Sin exposición',
    accent: '#34D399',
    desc: 'Lectura visual de fugas, derrames y placas de identificación a distancia segura antes de comprometer al equipo en la zona caliente.',
    icon: ``,
  },
  {
    title: 'Vigilancia y seguridad pública',
    norm: 'Patrullaje 24/7',
    accent: '#60A5FA',
    desc: 'Monitoreo de eventos masivos, perímetros en incidentes críticos y evaluación de daños post-sismo o inundación. Dock 2 opera sin piloto en sitio.',
    icon: ``,
  },
];


/* Tabla comparativa */
const comparativa = [
  ['Sensor térmico', 'Radiométrica 640×512', 'Radiométrica 640×512', 'Matrice 3TD'],
  ['Autonomía', '41 min', '45 min', 'Ilimitada (dock)'],
  ['Alcance', '15 km', '15 km FCC / 8 km CE', '10 km radio'],
  ['Despliegue', '< 5 min', '< 2 min', 'Autónomo'],
  ['IP / protección', 'IP55', 'No certificado', 'IP55 (estación)'],
  ['Escenario ideal', 'Operación institucional', 'Respuesta rápida', 'Vigilancia 24/7'],
];

/* Guía de selección */
const guia = [
  { n: '01', t: 'Define la misión dominante: ¿es evaluación táctica de incendios estructurales, búsqueda de personas o vigilancia continua? La aeronave correcta surge de ahí.' },
  { n: '02', t: 'Verifica que el sensor sea radiométrico real — no solo paleta de colores. La medición de temperatura es lo que diferencia un dron de rescate de un dron con filtro naranja.' },
  { n: '03', t: 'Tramita el permiso AFAC antes de operar. Para instituciones, existe la figura de operador aéreo no tripulado institucional que simplifica el proceso.' },
  { n: '04', t: 'Incluye capacitación de piloto y protocolos de operación en el presupuesto. El equipo sin entrenamiento es un recurso que no va a la emergencia.' },
];

/* Artículos del blog */
const articulos = [
  { label: 'FLIR vs MSA vs Bullard', desc: 'Comparativa de cámaras térmicas por escenario', href: '/blog/flir-vs-msa-vs-bullard-camaras-termicas' },
  { label: 'NFPA 1930: cámaras térmicas', desc: 'Qué certifica la norma y qué no', href: '/blog/nfpa-1801-camaras-termicas-bomberos' },
  { label: 'Cómo equipar una estación desde cero', desc: 'Prioridades de inversión por etapa', href: '/blog/como-equipar-estacion-bomberos-desde-cero' },
  { label: 'Guía de compra NFPA México 2026', desc: 'Referencia para licitadores y evaluadores', href: '/blog/guia-compra-equipo-bomberos-nfpa-mexico-2026' },
];

/* FAQ */
const faqs = [
  { q: '¿Necesito permiso para volar un dron en una emergencia?', a: 'Sí. En México la AFAC regula toda operación de RPAS. Para instituciones existe la figura de Operador Aéreo No Tripulado que simplifica el trámite y permite operaciones en zonas restringidas. Incluimos acompañamiento completo en el proceso de registro.' },
  { q: '¿Cuál es la diferencia entre una cámara térmica radiométrica y una normal?', a: 'Una cámara radiométrica mide la temperatura de cada píxel en grados reales; una cámara térmica convencional solo asigna colores de paleta sin valor numérico. Para búsqueda y rescate o evaluación de puntos calientes, la radiometría es indispensable.' },
  { q: '¿El DJI Matrice 30T puede volar en lluvia?', a: 'Sí. El Matrice 30T tiene certificación IP55 tanto en aeronave como en estación de carga, lo que permite operaciones bajo lluvia moderada — condición habitual en emergencias.' },
  { q: '¿Cuánto tarda en implementarse un programa de drones en un cuerpo de bomberos?', a: 'Con el paquete completo (aeronave + capacitación + AFAC), el tiempo promedio es de 6–8 semanas desde la firma de pedido hasta el primer vuelo operacional certificado. El trámite AFAC institucional toma 3–4 semanas en condiciones normales.' },
  { q: '¿Manejan refacciones y baterías de repuesto?', a: 'Sí. Mantenemos stock de baterías, hélices y módulos de cámara para los modelos que distribuimos, con entrega en 24–48 h en CDMX. Para brigadas fuera de la ZMVM enviamos por paquetería el mismo día.' },
];

/* Trust Pillars */
const razones = [
  {
    n: '01',
    t: 'DJI Enterprise: el estándar de la respuesta',
    d: 'DJI Enterprise es una plataforma de drones para cuerpos de bomberos y protección civil. Distribuidor autorizado en México con soporte técnico, refacciones y baterías en stock.',
  },
  {
    n: '02',
    t: 'Térmica radiométrica real',
    d: 'Todos los modelos que distribuimos integran sensor térmico radiométrico — medición de temperatura en grados reales, no solo paleta de colores. Lo que marca la diferencia en búsqueda y rescate nocturno.',
  },
  {
    n: '03',
    t: 'Trámite AFAC incluido',
    d: 'Acompañamos el registro ante la Agencia Federal de Aviación Civil para operación institucional legal. Capacitación de piloto, protocolos de misión y documentación completa para licitaciones.',
  },
  {
    n: '04',
    t: 'Solución llave en mano',
    d: 'Aeronave + cámara térmica + baterías adicionales + capacitación + AFAC en un solo contrato. Sin integrar proveedores distintos ni coordinar trámites por separado.',
  },
];

/* JSON-LD */
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Productos', item: `${SITE.url}/productos` },
    { '@type': 'ListItem', position: 3, name: 'Drones de Emergencia', item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: 'Drones de Emergencia con cámara térmica — DJI Enterprise México',
  description: cat.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: dronesProducts.length,
    itemListElement: dronesProducts.map((m, i) => ({ '@type': 'ListItem', position: i + 1, name: m.title })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const otrasCategorias = allCategories.filter((c) => c.slug !== 'drones-emergencia').slice(0, 6);
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema, faqSchema]}>

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:var(--c-bg-alt);border-bottom:1px solid var(--c-line)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center flex-wrap gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
        <li><a href="/" class="hover:text-[var(--c-accent)]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/productos" class="hover:text-[var(--c-accent)]">Productos</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:var(--c-text-2)" aria-current="page">Drones de Emergencia</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background:var(--c-bg);padding-block:5rem">
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" style="background:radial-gradient(ellipse 80% 70% at 90% 30%, rgba(6,118,71,0.06) 0%, transparent 65%)" aria-hidden="true"></div>

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="section-eyebrow mb-5 inline-flex">{cat.norm}</span>
          <h1 class="font-display font-bold uppercase mb-4" style="color:var(--c-ink);font-size:clamp(2.5rem,5.5vw,4.5rem);line-height:0.95">
            Dron con cámara térmica<br/>
            <span style="color:var(--c-accent)">drones DJI Enterprise para bomberos y protección civil.</span>
          </h1>
          <p class="text-base leading-relaxed mb-8 max-w-xl" style="color:var(--c-text-2)">
            Distribuidores autorizados de DJI Enterprise en México. Matrice 30T con térmica radiométrica,
            Mavic 3 Thermal y Dock 2 autónomo — más capacitación de piloto y trámite AFAC incluidos.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href={whatsappUrl('Hola, quiero cotizar drones de emergencia con cámara térmica.')} target="_blank" rel="noopener" class="btn btn-primary btn-lg">Cotizar por {CANAL_CONTACTO}</a>
            <a href="/cotizacion" class="btn btn-ghost btn-lg">Cotización formal</a>
          </div>
        </div>
        <div class="lg:pl-16" style="border-left:1px solid var(--c-line)">
          {cat.intro.map((p) => (
            <p class="text-sm leading-[1.9] mb-5" style="color:var(--c-text-2)">{p}</p>
          ))}
          <div class="flex flex-wrap gap-2">
            {['DJI Matrice 30T','Mavic 3 Thermal','Dock 2','AFAC México','Térmica radiométrica','Rescate · HAZMAT · ISR'].map(n => (
            <span class="badge badge-dark font-display text-[10px]">{n}</span>
          ))}
          </div>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-px" style="background:linear-gradient(90deg, transparent, rgba(200,16,46,0.4) 30%, rgba(200,16,46,0.4) 70%, transparent)" aria-hidden="true"></div>
  </section>

  <section id="guia-drones" class="section" style="background:var(--c-bg)" aria-labelledby="guia-drones-title">
    <div class="container-site content-copy">
      <div class="section-head mb-5"><h2 id="guia-drones-title">¿Para qué sirve un dron con cámara térmica en emergencias?</h2></div>
      <p class="mb-8">Un dron con cámara térmica permite ver el calor desde el aire, de día y de noche. Los cuerpos de bomberos y de protección civil lo usan en combate de incendios, búsqueda y rescate, inspección y operaciones nocturnas. Desde el aire, el mando obtiene una vista completa del incidente sin exponer al personal.</p>

      <div class="section-head mt-14 mb-5"><h2>Cámara térmica radiométrica: qué la hace diferente</h2></div>
      <p>Una cámara radiométrica mide la temperatura de cada píxel, no solo muestra contraste. Los modelos DJI Matrice 30T, Mavic 3 Thermal y Matrice 4T usan sensores de 640×512 con precisión de ±2 °C o ±2 %. Así se pueden registrar temperaturas en la imagen y compararlas entre vuelos.</p>

      <div class="section-head mt-14 mb-5"><h2>Comparativa de drones térmicos DJI Enterprise</h2></div>
      <div class="overflow-x-auto max-w-full min-w-0 mb-4"><table class="w-full text-left text-sm" style="border-collapse:collapse;min-width:640px;color:var(--c-text)">
        <thead><tr><th class="p-3" style="background:var(--c-surface);color:var(--c-ink)">Modelo</th><th class="p-3" style="background:var(--c-surface);color:var(--c-ink)">Térmica</th><th class="p-3" style="background:var(--c-surface);color:var(--c-ink)">Vuelo</th><th class="p-3" style="background:var(--c-surface);color:var(--c-ink)">Protección</th><th class="p-3" style="background:var(--c-surface);color:var(--c-ink)">Peso</th></tr></thead>
        <tbody>
          <tr><td class="p-3" style="border-bottom:1px solid var(--c-line)">Mavic 3 Thermal</td><td class="p-3" style="border-bottom:1px solid var(--c-line)">640×512 radiométrica</td><td class="p-3" style="border-bottom:1px solid var(--c-line)">45 min</td><td class="p-3" style="border-bottom:1px solid var(--c-line)">Sin IP</td><td class="p-3" style="border-bottom:1px solid var(--c-line)">920 g</td></tr>
          <tr><td class="p-3" style="border-bottom:1px solid var(--c-line)">Matrice 4T</td><td class="p-3" style="border-bottom:1px solid var(--c-line)">640×512 radiométrica</td><td class="p-3" style="border-bottom:1px solid var(--c-line)">49 min</td><td class="p-3" style="border-bottom:1px solid var(--c-line)">—</td><td class="p-3" style="border-bottom:1px solid var(--c-line)">1.22 kg</td></tr>
          <tr><td class="p-3" style="border-bottom:1px solid var(--c-line)">Matrice 30T</td><td class="p-3" style="border-bottom:1px solid var(--c-line)">640×512 radiométrica + telémetro láser</td><td class="p-3" style="border-bottom:1px solid var(--c-line)">41 min</td><td class="p-3" style="border-bottom:1px solid var(--c-line)">IP55</td><td class="p-3" style="border-bottom:1px solid var(--c-line)">3.77 kg</td></tr>
          <tr><td class="p-3" style="border-bottom:1px solid var(--c-line)">Matrice 350 RTK</td><td class="p-3" style="border-bottom:1px solid var(--c-line)">Según carga útil</td><td class="p-3" style="border-bottom:1px solid var(--c-line)">55 min sin carga</td><td class="p-3" style="border-bottom:1px solid var(--c-line)">IP55</td><td class="p-3" style="border-bottom:1px solid var(--c-line)">9.2 kg máx. al despegue</td></tr>
        </tbody>
      </table></div>

      <div class="section-head mt-14 mb-5"><h2>Estaciones Dock: vuelo automatizado</h2></div>
      <p>Las estaciones DJI Dock guardan, cargan y despachan el dron para misiones programadas o remotas. El <strong>Dock 2</strong> opera con los Matrice 3D/3TD en un radio de 10 km; el <strong>Dock 3</strong> opera con los Matrice 4D/4TD, tiene base IP56 y se puede montar en un vehículo. Ambos se gestionan con <strong>DJI FlightHub 2</strong>, una plataforma en la nube para coordinar misiones y transmisiones.</p>

      <div class="section-head mt-14 mb-5"><h2>Normativa: NOM-107-SCT3-2019</h2></div>
      <p>En México, los drones se regulan con la NOM-107-SCT3-2019, vigente y confirmada en 2024. Lo más importante para bomberos y protección civil:</p>
      <ul class="list-disc pl-6 space-y-2 text-sm leading-relaxed" style="color:var(--c-text)">
        <li>Todo dron de más de 250 g requiere registro ante la autoridad aeronáutica.</li>
        <li>Categorías por peso: micro (hasta 2 kg), pequeño (más de 2 y hasta 25 kg) y grande (más de 25 kg).</li>
        <li>Las operaciones de gobierno siguen los requisitos del uso privado no comercial: seguro de responsabilidad civil y, en drones pequeños, autorización de operación y de piloto.</li>
        <li>Límites generales: 122 m de altura, 457 m de distancia horizontal, siempre a la vista del piloto y a 9.2 km de aeródromos; las operaciones especiales tienen reglas propias.</li>
      </ul>
      <p>Por peso, el Mavic 3 Thermal y el Matrice 4T son micro; el Matrice 30T y el Matrice 350 RTK son pequeños.</p>

      <div class="section-head mt-14 mb-5"><h2>¿Cómo elegir un dron térmico?</h2></div>
      <ol class="list-none pl-6 space-y-2 text-sm leading-relaxed" style="color:var(--c-text)">
        <li>Define la misión: respuesta rápida, búsqueda y rescate de largo alcance o patrullaje automatizado.</li>
        <li>Elige entre un dron compacto (despliegue rápido) y uno con protección IP55 para lluvia y polvo.</li>
        <li>Verifica que la cámara sea radiométrica si necesitas medir temperaturas.</li>
        <li>Considera la categoría NOM-107 del equipo y los trámites que implica.</li>
        <li>Planea capacitación de pilotos, baterías de reserva y software de gestión de misiones.</li>
      </ol>
      <p>Cotiza tu dron con cámara térmica y recibe la recomendación según tu operación.</p>
    </div>
  </section>

  <!-- Accesos rápidos -->
  <QuickLinksBar />

  <!-- Trust Pillars -->
  <section class="section-tight" style="background:var(--c-bg-alt)" aria-label="Por qué distribuimos DJI Enterprise">
    <div class="container-site">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px" style="border:1px solid var(--c-line)">
        {razones.map((r, i) => (
          <div class="flex flex-col gap-3 p-6" style={`background:var(--c-bg-alt);${i < 3 ? 'border-right:1px solid rgba(74,117,153,0.12)' : ''}`}>
            
            <h3 class="font-display font-bold text-sm uppercase tracking-wide" style="color:var(--c-ink)">{r.t}</h3>
            <p class="text-xs leading-relaxed m-0" style="color:var(--c-muted)">{r.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tipos de misión -->
  <section class="section" style="background:var(--c-bg)" aria-labelledby="misiones-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Cuatro escenarios críticos</span>
          <h2 id="misiones-title" class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
            El dron correcto<br/>
            <span style="color:var(--c-accent)">según la misión.</span>
          </h2>
        </div>
        <div style="border-left:2px solid rgba(200,16,46,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed" style="color:var(--c-text-2)">
            No todas las emergencias piden lo mismo. La evaluación táctica de un incendio estructural,
            la búsqueda nocturna de una persona o el reconocimiento de un derrame HAZMAT tienen
            configuraciones distintas — y la plataforma correcta sale de la misión, no del catálogo.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {misiones.map((m) => (
          <article class="flex flex-col gap-4 p-7" style="background:var(--c-bg-alt);border:1px solid var(--c-line)">
            <div class="flex items-center justify-center rounded-full" style={`width:52px;height:52px;background:${m.accent}1a;border:1.5px solid ${m.accent}59;color:${m.accent}`}>
              <span class="block" style="width:24px;height:24px" set:html={m.icon}/>
            </div>
            <div class="flex items-center justify-between gap-2">
              <h3 class="font-display font-bold text-base" style="color:var(--c-ink)">{m.title}</h3>
              <span class="badge badge-dark text-[9px]">{m.norm}</span>
            </div>
            <p class="text-sm leading-relaxed m-0" style="color:var(--c-text-2)">{m.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Marca DJI Enterprise — card L4 -->
  {marcas.length > 0 && (
    <section class="section" style="background:var(--c-bg-alt)" aria-labelledby="marcas-title">
      <div class="container-site">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-10">
          <div>
            <span class="section-eyebrow mb-4 inline-flex">Distribuidor autorizado</span>
            <h2 id="marcas-title" class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
              Plataformas DJI<br/>
              <span style="color:var(--c-accent)">para emergencias.</span>
            </h2>
          </div>
          <div style="border-left:2px solid rgba(200,16,46,0.4);padding-left:1.75rem">
            <p class="text-sm leading-relaxed" style="color:var(--c-text-2)">
              DJI Enterprise es una plataforma de drones para cuerpos de bomberos y protección
              civil a nivel mundial. Distribuimos los tres modelos de referencia con soporte técnico,
              capacitación y trámite AFAC en un solo paquete llave en mano.
            </p>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {marcas.map((b) => (
            <a href={`/productos/${b.categorySlug}/${b.slug}`} class="group flex flex-col gap-3 p-7" style="background:var(--c-bg);border:1px solid var(--c-line)">
              <h3 class="font-display font-bold text-xl group-hover:text-[var(--c-accent)]" style="color:var(--c-ink)">{b.brandLabel}</h3>
              <p class="text-xs leading-relaxed flex-1" style="color:var(--c-muted)">{b.crossDesc}</p>
              <span class="inline-flex items-center gap-1.5 text-xs font-display font-semibold uppercase tracking-wider" style="color:var(--c-accent)">
                Catálogo completo de drones de emergencia
                
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Productos DJI — 3 fichas técnicas -->
  <section class="section" style="background:var(--c-bg)" aria-labelledby="modelos-title">
    <div class="container-site">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Matrice 30T · Mavic 3 Thermal · Dock 2</span>
          <h2 id="modelos-title" class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
            Tres modelos,<br/>
            <span style="color:var(--c-accent)">tres misiones.</span>
          </h2>
        </div>
        <div style="border-left:2px solid rgba(200,16,46,0.4);padding-left:1.75rem">
