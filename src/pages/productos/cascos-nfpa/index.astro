---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import ProductCard from '@components/products/ProductCard.astro';
import { categories } from '@data/categories';
import { featuredProducts } from '@data/products';
import { SITE, whatsappUrl } from '@data/site';

const cat = categories.find((c) => c.slug === 'cascos-nfpa')!;
const canonicalURL = `${SITE.url}/productos/cascos-nfpa`;

const seoMeta = {
  title: 'Cascos para Bomberos NFPA 1970 — MSA Gallet, Bullard, Cairns · México',
  description: 'Catálogo completo de cascos para bomberos certificados NFPA 1970 y 1977 en México. MSA Gallet F1 XF, Bullard USTM/USTERM y Cairns N6A Houston. Distribuidor autorizado · stock CDMX · fichas para licitación.',
  canonicalURL,
};

/* ── Productos por marca ───────────────────────────────────────────────────── */
const msaProducts = featuredProducts.filter(
  (p) => p.category === 'Cascos NFPA' && p.brand === 'MSA Safety' && p.specs
);
const bullardProducts = featuredProducts.filter(
  (p) => p.category === 'Cascos NFPA' && p.brand === 'Bullard' && p.specs
);
const cairnsProducts = featuredProducts.filter(
  (p) => p.category === 'Cascos NFPA' && p.brand === 'Cairns' && p.specs
);
const todosCascos = featuredProducts.filter((p) => p.category === 'Cascos NFPA' && p.specs);

/* ── Estilos de casco (educativo) ─────────────────────────────────────────── */
const tipos = [
  {
    title: 'Europeo integral',
    norm: 'NFPA 1970',
    accent: '#F75000',
    desc: 'Cubierta envolvente tipo jet con visor retráctil interno, protección nucal integrada y módulos de lámpara y comunicación. El estándar en cuerpos metropolitanos y ARFF. Referente: MSA Gallet F1 XF.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 14a9 9 0 0 1 18 0M3 14h18v3a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1zM8 14v-2"/>`,
  },
  {
    title: 'Americano tradicional',
    norm: 'NFPA 1970',
    accent: '#F5A623',
    desc: 'Casco de ala completa en composite o cuero. Escudo frontal personalizable con emblema institucional. Protege del escurrimiento de agua y brasas. El ícono histórico del servicio. Referentes: Bullard USTM · Cairns N6A.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M4 15a8 8 0 0 1 16 0M2 15h20M12 7V5"/>`,
  },
  {
    title: 'Forestal NFPA 1977',
    norm: 'NFPA 1977',
    accent: '#34D399',
    desc: 'Ligero y ventilado para incendio de vegetación e interfaz urbano-forestal. Compatible con goggles, capucha y protección auditiva en jornadas largas. Privilegia movilidad y manejo del estrés por calor.',
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M4 14a8 8 0 0 1 16 0M3 14h18M7 11l1.5-1.5M17 11l-1.5-1.5"/>`,
  },
];

/* ── Tabla comparativa estilos ─────────────────────────────────────────────── */
const comparativa = [
  { caract: 'Construcción',      europeo: 'Termoplástico/fibra de vidrio',    americano: 'Composite / cuero',              forestal: 'Termoplástico ventilado' },
  { caract: 'Protección facial', europeo: 'Visor retráctil interno + ocular',  americano: 'Escudo frontal + goggles ext.',  forestal: 'Goggles independientes' },
  { caract: 'Peso aprox.',       europeo: '1.3–1.6 kg',                        americano: '1.5–1.8 kg',                    forestal: '0.4–0.6 kg' },
  { caract: 'Protección nucal',  europeo: 'Integrada articulada',              americano: 'Ala trasera completa',           forestal: 'Cubrenuca textil' },
  { caract: 'Accesorios',        europeo: 'Lámpara · comunicación · TIC',      americano: 'Escudo personalizable · lámpara', forestal: 'Goggles · capucha' },
  { caract: 'Norma',             europeo: 'NFPA 1970',                         americano: 'NFPA 1970',                     forestal: 'NFPA 1977' },
  { caract: 'Escenario ideal',   europeo: 'Metropolitano · ARFF · industrial', americano: 'Cuerpos con identidad histórica', forestal: 'Vegetación · interfaz' },
];

/* ── Razones / trust pillars ──────────────────────────────────────────────── */
const razones = [
  {
    n: '01',
    t: 'Tres marcas líderes mundiales',
    d: 'MSA Gallet (fibra de vidrio europeo), Bullard (composite americano) y Cairns (cuero/composite icónico) — las tres referencias internacionales de cascos estructurales NFPA, disponibles con un solo distribuidor en México.',
  },
  {
    n: '02',
    t: 'Certificación verificable por número de serie',
    d: 'Cada casco incluye etiqueta de trazabilidad con número de serie, lote de fabricación y laboratorio acreditado. Documentación lista para auditorías NFPA 1850, licitaciones públicas y procesos de acreditación institucional.',
  },
  {
    n: '03',
    t: 'Configuración completa para tu operación',
    d: 'Asesoramos la configuración exacta: visor o goggles, lámpara integrada, soporte para cámara térmica, módulo de comunicación y barboquejo. Todo original de fábrica para conservar la certificación vigente.',
  },
  {
    n: '04',
    t: 'Stock permanente en CDMX',
    d: 'Inventario de los modelos más demandados con entrega en 24–48 h desde CDMX. Para licitaciones gestionamos el pedido a fábrica con ficha técnica y manifiesto de cumplimiento de norma por partida.',
  },
];

/* ── Guía de selección ────────────────────────────────────────────────────── */
const guia = [
  { n: '01', t: 'Define el escenario dominante: estructural en edificios → NFPA 1970; incendio de vegetación → NFPA 1977. Este primer paso elimina la mitad de las opciones.' },
  { n: '02', t: 'Elige el estilo según tu tradición e identidad: europeo integral para cuerpos metropolitanos y ARFF; americano para corporaciones con historia; forestal para interfaz.' },
  { n: '03', t: 'Configura los accesorios: visor retráctil o goggles exteriores, módulo de lámpara, soporte para cámara térmica, barboquejo y sistemas de comunicación.' },
  { n: '04', t: 'Verifica compatibilidad con el SCBA y la capucha de partículas NFPA 1970, y asegura refacciones originales —visor, suspensión, barboquejo— para conservar la certificación.' },
];

/* ── Artículos del blog ───────────────────────────────────────────────────── */
const articulos = [
  { label: 'NFPA 1970: la nueva norma',      desc: 'Qué cambió en el conjunto estructural',       href: '/blog/nfpa-1970-nueva-norma-trajes-bombero' },
  { label: 'Inspección y vida útil de EPP',   desc: 'Criterios de retiro NFPA 1850',               href: '/blog/inspeccion-cuidado-vida-util-traje-bombero' },
  { label: 'Especificar EPP en licitaciones', desc: 'Bases por desempeño y certificación',          href: '/blog/especificaciones-traje-bombero-licitaciones' },
  { label: 'Normas y certificaciones',        desc: 'NFPA 1970, 1977 y 1850 explicadas',           href: '/certificaciones' },
];

/* ── FAQ ──────────────────────────────────────────────────────────────────── */
const faqs = [
  {
    q: '¿Bajo qué norma debe estar certificado un casco de bombero en México?',
    a: 'NFPA 1970 para combate estructural (la norma que consolidó a la NFPA 1971 desde 2024) o NFPA 1977 para incendio forestal. La certificación la emite un laboratorio de tercera parte acreditado y debe constar en la etiqueta interna con número de serie verificable con fábrica. En licitaciones públicas en México, el pliego suele referenciar directamente NFPA 1970 o NFPA 1977 por edición.',
  },
  {
    q: '¿Cada cuánto se retira un casco del servicio activo?',
    a: 'El casco se retira según las instrucciones del fabricante y la inspección periódica conforme a NFPA 1850. Independientemente de la antigüedad, se retira de inmediato ante impacto severo, grieta, deformación o exposición térmica que comprometa la cubierta o la suspensión. MSA, Bullard y Cairns publican sus propias guías de retiro: te facilitamos las fichas de cada marca.',
  },
  {
    q: '¿Casco europeo MSA Gallet o americano Bullard/Cairns?',
    a: 'El europeo (MSA Gallet F1 XF) ofrece visor retráctil interno, menor perfil, módulos integrados de lámpara y comunicación, y es el estándar en cuerpos metropolitanos y ARFF. El americano (Bullard USTM, Cairns N6A) conserva el ala completa, el escudo frontal personalizable y la identidad histórica del servicio — clave en corporaciones con tradición institucional. Ambos certifican NFPA 1970; la elección es operacional e identitaria.',
  },
  {
    q: '¿Son compatibles con SCBA y cámara térmica?',
    a: 'Sí. Todos los modelos que distribuimos están disponibles con adaptadores verificados para máscara full-face de SCBA (MSA G1, Dräger PSS 7000, 3M Scott Air-Pak NxG7), montajes para cámara de imagen térmica (Bullard TXS, MSA G1-TIC) y módulos de lámpara. Te asesoramos para que el conjunto casco-SCBA-capucha funcione sin interferencias y mantenga la certificación.',
  },
  {
    q: '¿Entregan ficha técnica y certificado para licitación pública?',
    a: 'Sí. Cada casco incluye el certificado de conformidad del fabricante, la ficha técnica con número de modelo y lote, y el reporte del laboratorio acreditado. Para concursos públicos (CompraNet, IMSS, Pemex, gobiernos estatales) generamos el manifiesto de cumplimiento de norma por partida, con identificación del estándar exacto (NFPA 1970-2018 o NFPA 1977-2021).',
  },
];

/* ── JSON-LD ──────────────────────────────────────────────────────────────── */
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio',      item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Productos',   item: `${SITE.url}/productos` },
    { '@type': 'ListItem', position: 3, name: 'Cascos NFPA', item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: 'Cascos para Bomberos certificados NFPA 1970 y 1977 — México',
  description: seoMeta.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: todosCascos.length,
    itemListElement: todosCascos.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p.title, url: `${SITE.url}${p.href}` })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const otrasCategorias = categories.filter((c) => c.slug !== 'cascos-nfpa').slice(0, 6);
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema, faqSchema]}>

  {/* ══ BREADCRUMB ══════════════════════════════════════════════════════ */}
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0 flex-wrap" style="color:#4A7599">
        <li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/productos" class="hover:text-[#FF6B26]">Productos</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:#94A3B8" aria-current="page">Cascos NFPA</span></li>
      </ol>
    </div>
  </nav>

  {/* ══ HERO ════════════════════════════════════════════════════════════ */}
  <section class="relative overflow-hidden" style="background:#040A12;padding-block:5rem">
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" style="background:radial-gradient(ellipse 80% 70% at 90% 30%, rgba(247,80,0,0.08) 0%, transparent 65%)" aria-hidden="true"></div>

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <div>
          <span class="section-eyebrow mb-5 inline-flex">{cat.norm} · MSA Gallet · Bullard · Cairns · Distribuidor Autorizado MX</span>
          <h1 class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2.5rem,5.5vw,4.5rem);line-height:0.95">
            Cascos para<br/>
            <span style="color:#F75000">Bomberos NFPA.</span>
          </h1>
          <p class="text-sm leading-relaxed mb-8" style="color:#94A3B8">
            Distribuidor autorizado de MSA Gallet, Bullard y Cairns en México. Stock permanente
            con entrega en 24–48 h en CDMX y ficha técnica completa para licitación.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href={whatsappUrl('Hola, quiero cotizar cascos para bomberos NFPA 1970.')} target="_blank" rel="noopener" class="btn btn-primary btn-lg">
              Cotizar por WhatsApp
            </a>
            <a href="/cotizacion" class="btn btn-ghost btn-lg">Cotización formal</a>
          </div>
        </div>

        <div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,0.1)">
          {cat.intro.map((p) => (
            <p class="text-sm leading-[1.9] mb-5" style="color:#94A3B8">{p}</p>
          ))}
          <div class="flex flex-wrap gap-2">
            {['NFPA 1970','NFPA 1977','MSA Gallet F1 XF','Bullard USTM','Cairns N6A','Visor integrado','Distribuidor autorizado MX'].map(n => (
              <span class="badge badge-dark font-display text-[10px]">{n}</span>
            ))}
          </div>
        </div>

      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-px" style="background:linear-gradient(90deg, transparent, rgba(247,80,0,0.4) 30%, rgba(247,80,0,0.4) 70%, transparent)" aria-hidden="true"></div>
  </section>

  {/* ══ QUICK LINKS ═════════════════════════════════════════════════════ */}
  <QuickLinksBar />

  {/* ══ TRUST PILLARS ══════════════════════════════════════════════════ */}
  <section class="section-tight" style="background:#070E1A" aria-label="Por qué distribuimos estas marcas">
    <div class="container-site">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px" style="border:1px solid rgba(74,117,153,0.18)">
        {razones.map((r, i) => (
          <div class="flex flex-col gap-3 p-6" style={`background:#080F1A;${i < 3 ? 'border-right:1px solid rgba(74,117,153,0.12)' : ''}`}>
            <span class="font-display font-bold text-2xl" style="color:#F75000">{r.n}</span>
            <h3 class="font-display font-bold text-sm uppercase tracking-wide" style="color:#FFFFFF">{r.t}</h3>
            <p class="text-xs leading-relaxed m-0" style="color:#64748B">{r.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ══ TIPOS DE CASCO ══════════════════════════════════════════════════ */}
  <section class="section" style="background:#040A12" aria-labelledby="tipos-title">
    <div class="container-site">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Tres estilos, un estándar</span>
          <h2 id="tipos-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
            El casco correcto<br/>
            <span style="color:#F75000">para tu operación.</span>
          </h2>
        </div>
        <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed" style="color:#94A3B8">
            La elección del casco combina norma, escenario y tradición del cuerpo. Los tres estilos
            cumplen las exigencias físicas de la NFPA — la diferencia está en cómo integran protección,
            identidad y compatibilidad con el resto del EPP.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {tipos.map((t) => (
          <article class="flex flex-col gap-4 p-7" style="background:#080F1A;border:1px solid rgba(74,117,153,0.18)">
            <div class="flex items-center justify-center" style={`width:52px;height:52px;background:${t.accent}1a;border:1.5px solid ${t.accent}59;color:${t.accent}`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" style="width:24px;height:24px" set:html={t.icon}/>
            </div>
            <div class="flex items-center justify-between gap-2">
              <h3 class="font-display font-bold text-xl" style="color:#FFFFFF">{t.title}</h3>
              <span class="badge badge-dark text-[9px]">{t.norm}</span>
            </div>
            <p class="text-sm leading-relaxed m-0" style="color:#94A3B8">{t.desc}</p>
          </article>
        ))}
      </div>

    </div>
  </section>

  {/* ══ MSA SAFETY — GALLET ═════════════════════════════════════════════ */}
  <section class="section" style="background:#070E1A" aria-labelledby="msa-title">
    <div class="container-site">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">MSA Safety · Gallet · Distribuidor Autorizado MX</span>
          <h2 id="msa-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
            Cascos MSA Gallet<br/>
            <span style="color:#F75000">certificados NFPA.</span>
          </h2>
        </div>
        <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed mb-4" style="color:#94A3B8">
            MSA Safety —NYSE: MSA— es el grupo industrial de seguridad más grande del mundo.
            Su línea Gallet define el estándar europeo de casco estructural: visor retráctil interno,
            fibra de vidrio termoendurecida y módulos integrados de lámpara y comunicación.
            El F1 XF es el casco más solicitado en cuerpos metropolitanos y ARFF de México.
          </p>
          <div class="flex flex-wrap gap-2">
            {['NFPA 1970','NFPA 1977','Fibra de vidrio','Optrel retráctil','MSA Safety · NYSE','Distribuidor autorizado MX'].map(b => (
              <span class="badge badge-dark text-[9px]">{b}</span>
            ))}
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {msaProducts.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>

      <div class="mt-10 pt-8 flex flex-col sm:flex-row gap-4 items-start" style="border-top:1px solid rgba(74,117,153,0.15)">
        <div class="flex-1">
          <p class="text-sm leading-relaxed m-0" style="color:#64748B">
            ¿Quieres la comparativa de las 8 configuraciones Gallet, la anatomía del F1 XF y el FAQ técnico,
            o cotizar con ficha para licitación? Accede al catálogo dedicado de la marca.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a href="/productos/cascos-nfpa/msa-gallet" class="btn btn-primary btn-lg">
            Catálogo MSA Gallet completo →
          </a>
          <a
            href={whatsappUrl('Hola, quiero cotizar cascos MSA Gallet F1 XF NFPA 1970.')}
            target="_blank" rel="noopener"
            class="btn btn-ghost btn-lg"
          >
            Cotizar por WhatsApp
          </a>
        </div>
      </div>

    </div>
  </section>

  {/* ══ BULLARD ═════════════════════════════════════════════════════════ */}
  <section class="section" style="background:#040A12" aria-labelledby="bullard-title">
    <div class="container-site">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Bullard · Desde 1898 · Estilo americano</span>
          <h2 id="bullard-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
            Cascos Bullard<br/>
            <span style="color:#F75000">certificados NFPA.</span>
          </h2>
        </div>
        <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed mb-4" style="color:#94A3B8">
            Bullard lleva más de 125 años fabricando EPP para bomberos desde California. Su línea
            USTM/USTERM define el estilo americano de ala completa en material composite: escudo frontal
            personalizable con emblema institucional, alta resistencia térmica y amplia compatibilidad
            con sistemas de cámara de imagen térmica. La primera opción para corporaciones con identidad histórica.
          </p>
          <div class="flex flex-wrap gap-2">
            {['NFPA 1970','Composite ABS / USTERM','Ala completa','Escudo frontal','TIC Mount','Distribuidor autorizado MX'].map(b => (
              <span class="badge badge-dark text-[9px]">{b}</span>
            ))}
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {bullardProducts.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>

      <div class="mt-10 pt-8 flex flex-col sm:flex-row gap-4 items-start" style="border-top:1px solid rgba(74,117,153,0.15)">
        <div class="flex-1">
          <p class="text-sm leading-relaxed m-0" style="color:#64748B">
            ¿Quieres la comparativa de las 8 configuraciones Bullard, la anatomía del USTM y el FAQ técnico,
            o cotizar con ficha para licitación? Accede al catálogo dedicado de la marca.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a href="/productos/cascos-nfpa/bullard" class="btn btn-primary btn-lg">
            Catálogo Bullard completo →
          </a>
          <a
            href={whatsappUrl('Hola, quiero cotizar cascos Bullard USTM o USTERM NFPA 1970.')}
            target="_blank" rel="noopener"
            class="btn btn-ghost btn-lg"
          >
            Cotizar por WhatsApp
          </a>
        </div>
      </div>

    </div>
  </section>

  {/* ══ CAIRNS ══════════════════════════════════════════════════════════ */}
  <section class="section" style="background:#070E1A" aria-labelledby="cairns-title">
    <div class="container-site">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Cairns · Desde 1836 · El casco icónico</span>
          <h2 id="cairns-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
            Cascos Cairns<br/>
            <span style="color:#F75000">certificados NFPA.</span>
          </h2>
