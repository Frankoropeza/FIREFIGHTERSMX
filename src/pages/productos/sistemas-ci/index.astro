---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import ProductCard from '@components/products/ProductCard.astro';
import { categories } from '@data/categories';
import { featuredProducts } from '@data/products';
import { SITE, whatsappUrl } from '@data/site';

const cat = categories.find((c) => c.slug === 'sistemas-ci')!;
const canonicalURL = `${SITE.url}/productos/sistemas-ci`;

const tycoProducts        = featuredProducts.filter((p) => p.category === 'Sistemas CI' && p.brand === 'Tyco Viking'        && p.specs);
const honeywellProducts   = featuredProducts.filter((p) => p.category === 'Sistemas CI' && p.brand === 'Honeywell Notifier' && p.specs);
const kiddeFenwalProducts = featuredProducts.filter((p) => p.category === 'Sistemas CI' && p.brand === 'Kidde Fenwal'       && p.specs);
const redHidraulicaProducts = featuredProducts.filter((p) => p.category === 'Sistemas CI' && p.brand === 'Red Hidráulica'   && p.specs);

const seoMeta = {
  title: `Sistemas Contra Incendio NFPA 13 · 72 · 2001 — Diseño, Instalación y Memoria de Cálculo · México`,
  description: 'Diseño e instalación de sistemas contra incendio en México: rociadores NFPA 13 (Tyco/Viking), detección NFPA 72 (Honeywell/Notifier) y supresión agente limpio NFPA 2001 (FM-200/Novec). Memoria de cálculo y entregables para aseguradoras.',
  canonicalURL,
};

/* Subsistemas */
const subsistemas = [
  {
    id: 'rociadores',
    norm: 'NFPA 13',
    label: 'Rociadores Automáticos',
    marcas: 'Tyco · Viking · Victaulic',
    accent: '#34D399',
    aplicacion: 'Bodegas · naves industriales · centros comerciales · hoteles · edificios de oficinas · plantas de manufactura',
    desc: 'El sistema de supresión más extendido a nivel mundial. Los rociadores automáticos activan únicamente en el área del fuego, controlando el incendio antes de que se propague. El diseño hidráulico por densidad de riesgo conforme NFPA 13 garantiza la cobertura correcta para cada tipo de ocupación.',
    items: [
      { t: 'Riesgo ligero (Light Hazard)', d: 'Oficinas, hospitales, museos, hoteles — densidad 4.1 mm/min sobre área de 139 m²' },
      { t: 'Riesgo ordinario Grupo 1 y 2', d: 'Bodegas, manufactura, comercios — el rango más común en instalaciones industriales mexicanas' },
      { t: 'Riesgo alto (Extra Hazard)', d: 'Pintura, madera, textiles, manufactura de alto riesgo — densidades especiales y cálculo individual' },
      { t: 'Estantes ESFR (Early Suppression)', d: 'Almacenes de alta estiba — supresión temprana directamente sobre la mercancía almacenada' },
    ],
    entregables: ['Memoria de cálculo hidráulico firmada por DRO', 'Planos isométricos y de distribución', 'Lista de materiales y hojas de datos de rociadores', 'Reporte de prueba hidrostática'],
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12"/></svg>`,
  },
  {
    id: 'deteccion',
    norm: 'NFPA 72',
    label: 'Detección y Alarma',
    marcas: 'Honeywell · Notifier · System Sensor',
    accent: '#60A5FA',
    aplicacion: 'Cualquier inmueble — complementa el sistema de rociadores o es el único sistema en áreas donde los rociadores no aplican',
    desc: 'Un sistema de detección temprana puede dar 3 a 10 minutos adicionales de evacuación antes de que lleguen los rociadores. Los paneles FACP (Fire Alarm Control Panel) direccionables de Honeywell y Notifier identifican el detector exacto en alarma, aceleran la respuesta y se integran con HVAC, elevadores y supresión.',
    items: [
      { t: 'Detectores de humo fotoeléctricos', d: 'Detección de humo visible — óptimos en pasillos, oficinas y habitaciones' },
      { t: 'Detectores iónicos de humo', d: 'Detección de partículas de combustión invisibles — cocinas y áreas con vapores' },
      { t: 'Detectores de calor fijo y combinados', d: 'Áreas con polvo o vapor que causarían falsas alarmas en detectores de humo' },
      { t: 'Detectores por aspiración (VESDA)', d: 'Detección ultra-temprana para data centers y cuartos de control críticos — alerta antes de que haya humo visible' },
      { t: 'Detectores de llama UV/IR', d: 'Plantas industriales con riesgo de fuego abierto sin humo previo — respuesta en milisegundos' },
      { t: 'Paneles FACP direccionables', d: 'Honeywell Fire-Lite/Notifier NFS2-3030 — hasta 3,000 puntos, monitoreo NFPA 72, integración BMS' },
    ],
    entregables: ['Diseño de zonificación conforme NFPA 72', 'Programación del panel FACP y matrices de causa-efecto', 'Reporte de pruebas de aceptación (NFPA 72 Capítulo 14)', 'Manual de usuario y plan de mantenimiento anual'],
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>`,
  },
  {
    id: 'agente-limpio',
    norm: 'NFPA 2001',
    label: 'Supresión Agente Limpio',
    marcas: 'Kidde Fenwal · Fike · Amerex',
    accent: '#A78BFA',
    aplicacion: 'Data centers · salas de servidores · cuartos de control · archivos críticos · telecomunicaciones · salas de arte',
    desc: 'La solución óptima para activos que no pueden mojarse, polvearse ni quedar fuera de servicio. Los agentes limpios FM-200 (HFC-227ea) y Novec 1230 (FK-5-1-12) extinguen en menos de 10 segundos sin residuo, sin dañar equipos y en un espacio seguro para personas. El sistema fijo con detección VESDA o dual-knock ofrece la respuesta más rápida posible.',
    items: [
      { t: 'FM-200 (HFC-227ea)', d: 'El agente limpio más instalado globalmente. ODP = 0, extinción en 8–10 s, aprobado UL/FM, concentración de diseño 7-8% v/v' },
      { t: 'Novec 1230 (FK-5-1-12)', d: 'Sin potencial de calentamiento global significativo. GWP = 1. Alternativa preferida en proyectos con criterios de sostenibilidad ESG' },
      { t: 'Sistema de disparo dual-knock', d: 'Dos detectores en cross-zoning antes de disparar — elimina falsas descargas que dañarían el agente y el cilindro' },
      { t: 'Integración con VESDA / ASD', d: 'Detección por aspiración en data centers — alarma temprana antes de humo visible, tiempo para investigar antes del disparo' },
    ],
    entregables: ['Diseño de concentración conforme NFPA 2001 (cálculo de masa)', 'Análisis de integridad del recinto (door fan test)', 'Planos de distribución de boquillas y cilindros', 'Procedimiento de descarga, reposición y mantenimiento anual'],
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3v1m0 16v1m9-9h-1M4 12H3"/><circle cx="12" cy="12" r="4"/><path d="M5.636 5.636l.707.707M17.657 17.657l.707.707M5.636 18.364l.707-.707M17.657 6.343l.707-.707"/></svg>`,
  },
  {
    id: 'redes-bombas',
    norm: 'NFPA 20',
    label: 'Redes Hidráulicas y Bombas',
    marcas: 'Grundfos · Armstrong · Aurora',
    accent: '#FB923C',
    aplicacion: 'Todo sistema de rociadores o gabinetes requiere una red hidráulica y, en la mayoría de los casos, un cuarto de bombas NFPA 20',
    desc: 'El corazón del sistema de rociadores: la red de tuberías y el cuarto de bombas que garantizan el caudal y la presión en cada rociador. El diseño hidráulico por computadora (pipe schedule o cálculo por densidad) determina los diámetros, la presión residual y la bomba necesaria — todo conforme NFPA 20 y la memoria de cálculo que exige tu aseguradora.',
    items: [
      { t: 'Bombas centrífugas horizontales y verticales', d: 'Listadas UL / certificadas FM — caudales desde 100 hasta 5,000 GPM según el riesgo' },
      { t: 'Bomba jockey (presurización)', d: 'Mantiene la presión del sistema y detecta fugas antes de que activen los rociadores' },
      { t: 'Tablero de control NFPA 20', d: 'Control automático, alarma de presión baja, registro de eventos — integrable con BMS y panel FACP' },
      { t: 'Red de tuberías y conexiones', d: 'Programas pipe-schedule y hidráulico. Acero negro, CPVC o tubing de cobre según ocupación y norma local' },
    ],
    entregables: ['Memoria de cálculo hidráulico con curva bomba-sistema', 'Planos isométricos de la red de tuberías', 'Data sheet de bombas y tablero de control', 'Protocolo de prueba de la bomba conforme NFPA 20'],
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/><path d="M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3"/></svg>`,
  },
];

/* Proceso de proyecto */
const etapas = [
  {
    n: '01',
    t: 'Ingeniería y diseño',
    d: 'Visita de sitio, levantamiento arquitectónico, clasificación del riesgo (NFPA 13 / 72 / 2001), selección de sistema y cálculo hidráulico. Elaboramos la memoria de cálculo firmada por Director Responsable de Obra (DRO) — el documento que exige la aseguradora.',
  },
  {
    n: '02',
    t: 'Propuesta y aprobación',
    d: 'Propuesta técnica-económica con especificaciones, planos preliminares, cronograma y presupuesto desglosado. Incluye comparativa de alternativas y análisis de ROI para proyectos de alta inversión.',
  },
  {
    n: '03',
    t: 'Suministro de materiales',
    d: 'Adquisición de materiales certificados UL/FM de proveedores autorizados Tyco, Viking, Honeywell, Notifier, Kidde Fenwal y Fike. Trazabilidad de lote y hojas de datos para el expediente.',
  },
  {
    n: '04',
    t: 'Instalación y pruebas',
    d: 'Instalación por cuadrilla especializada. Prueba hidrostática de la red (200 psi / 2 h), prueba de aceptación del panel FACP conforme NFPA 72 Capítulo 14, y corrida completa del sistema antes de la entrega.',
  },
  {
    n: '05',
    t: 'Puesta en marcha y entregables',
    d: 'Activación oficial, capacitación al personal de mantenimiento, entrega del dossier completo: planos as-built, reportes de prueba, hojas de datos de cada componente, manual de usuario y plan de mantenimiento anual.',
  },
];

/* Entregables del proyecto */
const entregables = [
  { t: 'Memoria de cálculo', d: 'Firmada por DRO. Requerida por aseguradoras y Protección Civil.' },
  { t: 'Planos as-built', d: 'Planta, isométrico y detalles conforme a lo instalado.' },
  { t: 'Reportes de prueba', d: 'Hidrostática (rociadores), aceptación (detección), door fan test (agente limpio).' },
  { t: 'Hojas de datos y trazabilidad', d: 'Data sheet de cada componente y número de lote.' },
  { t: 'Manual de usuario', d: 'Operación, alarmas, rutas de evacuación y contactos de emergencia.' },
  { t: 'Plan de mantenimiento', d: 'Calendario anual NFPA 25 (rociadores) y NFPA 72 (detección).' },
];

/* Trust Pillars */
const razones = [
  {
    n: '01',
    t: 'Materiales listados UL / FM Global',
    d: 'Solo rociadores, paneles y agentes con listing UL o certificación FM — los únicos aceptados por aseguradoras internacionales y la mayoría de pólizas industriales en México.',
  },
  {
    n: '02',
    t: 'Memoria de cálculo firmada por DRO',
    d: 'El documento técnico-legal que acredita el diseño ante la aseguradora, la autoridad y el propietario. Sin memoria firmada, el sistema no es aceptado en la mayoría de las pólizas.',
  },
  {
    n: '03',
    t: 'Pruebas de aceptación documentadas',
    d: 'Entregamos reportes de prueba hidrostática y de aceptación NFPA 72 con firma de técnico responsable — el expediente que exige Protección Civil y la aseguradora al comisionar el sistema.',
  },
  {
    n: '04',
    t: 'Soporte post-instalación NFPA 25',
    d: 'Programa de inspección, prueba y mantenimiento anual conforme NFPA 25 para rociadores y NFPA 72 para detección, con reporte documentado para la renovación de tu póliza.',
  },
];

/* Normativa */
const normas = [
  {
    clave: 'NFPA 13',
    titulo: 'Instalación de Rociadores',
    desc: 'Estándar de referencia mundial para el diseño e instalación de sistemas de rociadores automáticos. Define clasificación de riesgos, densidades de diseño, espaciado y obstrucciones — la base de toda memoria de cálculo de rociadores.',
  },
  {
    clave: 'NFPA 72',
    titulo: 'Código Nacional de Alarma de Incendio',
    desc: 'Rige el diseño, instalación, inspección, prueba y mantenimiento de sistemas de detección y alarma. Capítulo 14 establece los protocolos de prueba de aceptación que se entregan al propietario y a la aseguradora.',
  },
  {
    clave: 'NFPA 2001',
    titulo: 'Sistemas de Supresión con Agente Limpio',
    desc: 'Estándar para el diseño, instalación y mantenimiento de sistemas de supresión con agentes limpios (FM-200, Novec 1230). Incluye requerimientos de concentración de diseño, integridad del recinto y procedimientos de prueba.',
  },
  {
    clave: 'NFPA 20',
    titulo: 'Bombas de Agua para Supresión',
    desc: 'Regula la selección, instalación, prueba y mantenimiento de bombas para sistemas de protección contra incendio. Establece los requerimientos del cuarto de bombas, tablero de control y protocolos de prueba semanal y anual.',
  },
  {
    clave: 'NFPA 25',
    titulo: 'Inspección, Prueba y Mantenimiento',
    desc: 'Define el programa de mantenimiento de sistemas de agua (rociadores, redes, bombas): prueba mensual de la bomba jockey, prueba trimestral del flujo, y prueba hidrostática quinquenal — el calendario que presentas a tu aseguradora.',
  },
];

/* FAQ */
const faqs = [
  {
    q: '¿Cuándo es obligatorio un sistema de rociadores NFPA 13?',
    a: 'En México, la obligatoriedad depende del tipo de ocupación, la superficie y el reglamento de construcción local. El Reglamento de Construcciones del DF/CDMX lo requiere en edificios de más de 3,500 m² de bodega, plantas industriales de alto riesgo, centros comerciales y hoteles con más de 5 pisos. Las aseguradoras suelen requerirlo independientemente de la normativa local para emitir pólizas de daños en bodegas y plantas con valor de activos alto. Podemos revisar tu caso específico sin costo.',
  },
  {
    q: '¿Qué es la memoria de cálculo y por qué la exige mi aseguradora?',
    a: 'La memoria de cálculo hidráulico es el documento técnico que demuestra que el sistema fue diseñado correctamente: clasifica el riesgo, calcula la densidad de rociamiento, determina el área de operación, y verifica que la bomba entrega el caudal y la presión requeridos en el rociador más desfavorable. Las aseguradoras la exigen porque es la única prueba de que el sistema fue diseñado, no solo instalado. Debe estar firmada por un DRO o ingeniero responsable.',
  },
  {
    q: '¿Cuál es la diferencia entre FM-200 y Novec 1230?',
    a: 'FM-200 (HFC-227ea) es el agente limpio más instalado globalmente — eficaz, listado UL/FM, con décadas de historial. Novec 1230 (FK-5-1-12) es el agente de nueva generación con GWP (Potencial de Calentamiento Global) extremadamente bajo (GWP = 1 vs. 3,220 del FM-200), lo que lo convierte en la opción preferida para proyectos con compromisos ESG o que anticipan regulaciones de HFCs más estrictas. Ambos extinguen en menos de 10 segundos y son seguros para personas. La decisión depende del presupuesto, la disponibilidad local y los criterios de sostenibilidad del proyecto.',
  },
  {
    q: '¿Puedo agregar detección y alarma a un sistema de rociadores existente?',
    a: 'Sí, y es muy recomendable: la detección temprana NFPA 72 puede alertar de un incendio antes de que active el rociador, dando tiempo adicional de evacuación. El panel FACP se integra con el flujo de agua del sistema de rociadores (switch de flujo) para reportar cuál zona está activa. La integración es estándar y no requiere modificar la red de tuberías existente.',
  },
  {
    q: '¿Qué mantenimiento requiere el sistema una vez instalado?',
    a: 'NFPA 25 establece el programa para sistemas de agua: inspección visual semanal de manómetros, prueba mensual de la bomba jockey, prueba trimestral del caudal de la bomba principal, e inspección anual completa de rociadores, válvulas y accesorios. NFPA 72 requiere prueba anual del panel FACP, detectores y dispositivos de notificación. Ofrecemos contrato anual de mantenimiento con reporte documentado para la renovación de tu póliza de seguros.',
  },
];

/* JSON-LD */
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Productos', item: `${SITE.url}/productos` },
    { '@type': 'ListItem', position: 3, name: 'Sistemas Contra Incendio', item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: 'Sistemas Contra Incendio NFPA 13 · 72 · 2001 — México',
  description: seoMeta.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Diseño e Instalación de Sistemas Contra Incendio',
  description: seoMeta.description,
  url: canonicalURL,
  areaServed: { '@type': 'Country', name: 'Mexico' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Sistemas Contra Incendio NFPA',
    itemListElement: subsistemas.map((s) => ({
      '@type': 'Offer',
      name: `${s.label} (${s.norm})`,
      description: s.desc,
    })),
  },
};

const otrasCategorias = categories.filter((c) => c.slug !== 'sistemas-ci').slice(0, 6);

/* Guía de selección */
const guia = [
  { n: '01', t: 'Clasifica el riesgo de la ocupación conforme NFPA 13 — riesgo ligero (oficinas, hoteles), ordinario (bodegas, manufactura) o alto (pintura, madera). Esta clasificación determina la densidad de rociamiento y el área de operación; sin ella no hay memoria de cálculo válida.' },
  { n: '02', t: 'Determina los subsistemas requeridos: la aseguradora puede exigir rociadores y detección en paralelo; el tipo de activo (data center, sala de arte, archivo crítico) define si se necesita agente limpio. Verifica si la normativa local del municipio tiene requerimientos adicionales.' },
  { n: '03', t: 'Revisa las normas aplicables por subsistema: NFPA 13 para rociadores, NFPA 72 para detección, NFPA 2001 para agente limpio, NFPA 20 para bombas, NFPA 25 para el mantenimiento posterior. Cada norma tiene entregables distintos — el dossier final debe cubrir todos.' },
  { n: '04', t: 'Solicita la memoria de cálculo firmada por DRO junto con la propuesta. Sin memoria, el sistema no es aceptado por la mayoría de las aseguradoras. La memoria es el documento técnico-legal que demuestra diseño correcto — no solo instalación.' },
];

/* Artículos del blog */
const articulos = [
  { label: 'NFPA 13: clasificación de riesgos', desc: 'Riesgo ligero, ordinario y extra hazard explicados', href: '/blog/nfpa-13-clasificacion-riesgos-rociadores' },
  { label: 'FM-200 vs Novec 1230',               desc: 'Cuál agente limpio elegir para tu data center',   href: '/blog/fm200-vs-novec-1230-data-center' },
  { label: 'Memoria de cálculo para aseguradoras', desc: 'Qué incluye y por qué la exigen',               href: '/blog/memoria-calculo-sistema-contra-incendio-aseguradora' },
  { label: 'NFPA 25: mantenimiento anual',        desc: 'El calendario que salva tu póliza de seguros',   href: '/blog/nfpa-25-mantenimiento-rociadores-deteccion' },
];

/* Tabla comparativa subsistemas */
const tablaComparativa = [
  { sub: 'Rociadores automáticos', norm: 'NFPA 13', activ: 'Automática — calor 68–93 °C', ocup: 'Bodegas · manufactura · comercios · hoteles', entr: 'Memoria de cálculo + prueba hidrostática', mant: 'NFPA 25 · anual', accent: '#34D399' },
  { sub: 'Detección y alarma',     norm: 'NFPA 72', activ: 'Automática — humo · calor · CO · llama', ocup: 'Cualquier inmueble, complementa rociadores', entr: 'Reporte aceptación NFPA 72 Cap. 14 + matrices', mant: 'NFPA 72 · anual', accent: '#60A5FA' },
  { sub: 'Agente limpio',          norm: 'NFPA 2001', activ: 'Automática — dual-knock (2 detectores)', ocup: 'Data centers · cuartos de control · archivos', entr: 'Cálculo de masa + door fan test integridad', mant: 'NFPA 2001 · semestral', accent: '#A78BFA' },
  { sub: 'Redes y bombas',         norm: 'NFPA 20', activ: 'Automática — switch de presión o flujo', ocup: 'Todo sistema de rociadores o gabinetes', entr: 'Memoria hidráulica + curva bomba-sistema', mant: 'NFPA 20 · semanal (jockey) + anual', accent: '#FB923C' },
];
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema, faqSchema, serviceSchema]}>

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0 flex-wrap" style="color:#4A7599">
        <li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/productos" class="hover:text-[#FF6B26]">Productos</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:#94A3B8" aria-current="page">Sistemas Contra Incendio</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background:#040A12;padding-block:5rem">
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" style="background:radial-gradient(ellipse 80% 70% at 90% 30%, rgba(52,211,153,0.07) 0%, transparent 65%)" aria-hidden="true"></div>

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="section-eyebrow mb-5 inline-flex">{cat.norm} · Diseño · Instalación · Entregables</span>
          <h1 class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2.25rem,5vw,4rem);line-height:0.95">
            Sistemas<br/>contra incendio<br/>
            <span style="color:#34D399">que tu aseguradora</span><br/>
            <span style="color:#34D399">acepta.</span>
          </h1>
