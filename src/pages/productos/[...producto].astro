---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { featuredProducts, type Product } from '@data/products';
import { categories } from '@data/categories';
import { SITE, whatsappUrl } from '@data/site';

export function getStaticPaths() {
  return featuredProducts.map((product) => ({
    params: { producto: product.href.replace(/^\/productos\//, '') },
    props: { product },
  }));
}

interface Props { product: Product; }

const { product } = Astro.props;
const canonicalURL = `${SITE.url}${product.href}`;
const categoryPath = product.href.split('/').slice(0, 3).join('/');

/* ── Brand page URL ────────────────────────────────────────────────────── */
const brandSlug = product.brand
  ? product.brand.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/-$/, '')
  : null;
const brandPath = brandSlug ? `${categoryPath}/${brandSlug}` : null;

/* ── H1 split — word 1 white, rest orange ──────────────────────────────── */
const titleWords  = product.title.split(' ');
const h1line1     = titleWords[0] ?? product.title;
const h1line2     = titleWords.slice(1).join(' ');

/* ── Related: same brand first, then same category ─────────────────────── */
const relatedBrand = featuredProducts.filter(
  (p) => p.slug !== product.slug && p.brand === product.brand && p.specs,
).slice(0, 2);
const relatedCat = featuredProducts.filter(
  (p) =>
    p.slug !== product.slug &&
    p.category === product.category &&
    p.specs &&
    !relatedBrand.find((r) => r.slug === p.slug),
).slice(0, 4 - relatedBrand.length);
const related = [...relatedBrand, ...relatedCat].slice(0, 4);

/* ── Spec metadata: label + explanation + benchmark ────────────────────── */
type SpecMeta = { label: string; explica: string; min?: string; alto?: string };
const specMeta: Record<string, SpecMeta> = {
  tpp:        { label: 'TPP (cal/cm²)',     explica: 'Thermal Protective Performance — resistencia combinada al calor radiante y de llama. NFPA 1970 establece un mínimo de 35 cal/cm² para trajes estructurales.', min: '35 cal/cm²', alto: '50+ cal/cm²' },
  thl:        { label: 'THL (W/m²)',        explica: 'Total Heat Loss — capacidad del traje de disipar el calor generado por el propio cuerpo. A mayor THL, menor estrés térmico en operaciones largas.', min: '130 W/m²', alto: '205+ W/m²' },
  outer:      { label: 'Shell exterior',    explica: 'Material de la capa externa del sistema de 3 capas. Determina resistencia al desgaste, agentes químicos y calor de contacto.' },
  weight:     { label: 'Peso total',        explica: 'Peso del conjunto completo de 3 capas. Incide directamente en la fatiga del bombero durante operaciones de larga duración.' },
  extra:      { label: 'Especificación',    explica: 'Característica adicional del fabricante relevante para la selección del modelo.' },
  norma:      { label: 'Norma NFPA',        explica: 'Certificación vigente del equipo. NFPA 1970/1971 para cascos estructurales; NFPA 1977 para incendios forestales; NFPA 1971 Proximity para ARFF.' },
  material:   { label: 'Material carcasa',  explica: 'Material de la carcasa externa del casco. Fibra de vidrio ofrece máxima resistencia térmica; composite aramida/PP es más ligero; ABS es económico y durable.' },
  protector:  { label: 'Visera facial',     explica: 'Tipo de protector facial — retráctil integrado o abatible exterior. El integrado preserva el perfil de certificación NFPA y es de operación con una sola mano.' },
  suspension: { label: 'Suspensión',        explica: 'Sistema de suspensión y ajuste interno — define comodidad, absorción de impacto y distribución del peso sobre la cabeza del bombero.' },
  peso:       { label: 'Peso del equipo',   explica: 'Peso del casco sin accesorios opcionales. Menor peso reduce la fatiga cervical en operaciones prolongadas; límite recomendado NFPA: ≤ 1.8 kg.' },
  colores:    { label: 'Colores dispon.',   explica: 'Colores disponibles para pedido. Los códigos de color identifican función y rango en escena: rojo (bombero base), blanco (mando), dorado (jefe de sector), plateado (comandante).' },
  cert_lab:   { label: 'Lab. certificador', explica: 'Organismo independiente que realizó los ensayos de certificación. UL (Underwriters Laboratories) y SGS son los más aceptados en licitaciones mexicanas (CompraNet, IMSS, PEMEX).' },
  autonomia:  { label: 'Autonomía',         explica: 'Duración nominal del cilindro bajo demanda respiratoria estándar. NFPA 1981 exige que el sistema entregue el volumen declarado bajo condiciones certificadas.' },
  cilindro:   { label: 'Cilindro',          explica: 'Material y presión de trabajo del cilindro. Fibra de carbono ofrece menor peso; acero, mayor robustez mecánica y costo menor.' },
  electronica:{ label: 'PASS / HUD',        explica: 'Sistema de alarma de hombre sin movimiento (PASS) y visualizador de presión integrado (HUD). Ambos son requeridos por NFPA 1981 para combate estructural.' },
  resolucion: { label: 'Resolución sensor', explica: 'Resolución del sensor infrarrojo. 160×120 px es suficiente para búsqueda interior; 320×240 px mejora la imagen de mando y documentación.' },
  sensor:     { label: 'NETD (sensib.)',    explica: 'Noise Equivalent Temperature Difference — sensibilidad térmica del sensor. Un valor menor (≤50 mK) detecta diferencias más pequeñas de temperatura.' },
  fuerza:     { label: 'Fuerza máx.',       explica: 'Fuerza de apertura o corte. Vehículos modernos con acero de ultra-alta resistencia exigen herramientas de más de 80 kN para apertura efectiva.' },
  rango:      { label: 'Rango / carrera',   explica: 'Apertura o carrera máxima de la herramienta. Determina el ancho de brecha o la longitud de corte posible en una sola operación.' },
  fuente:     { label: 'Fuente de poder',   explica: 'Sistema de alimentación de la herramienta. Eléctrico/batería ofrece movilidad total; hidráulico, mayor potencia sostenida.' },
  tipo_sis:   { label: 'Tipo de sistema',   explica: 'Subsistema de protección — rociadores automáticos, detección de humo/calor, agente limpio o red de gabinetes. Cada uno rige una norma NFPA distinta.' },
  cobertura:  { label: 'Cobertura',         explica: 'Área de protección diseñada por el sistema. Determinada mediante memoria de cálculo hidráulico conforme NFPA 13 o 72.' },
  listado:    { label: 'Listado',           explica: 'Organismo que certifica el equipo — UL (Underwriters Laboratories) o FM (Factory Mutual). Requerido por la mayoría de aseguradoras en México.' },
  ideal:      { label: 'Ocupación ideal',   explica: 'Tipo de inmueble u operación para el que el sistema fue diseñado y calculado.' },
  nivel_haz:  { label: 'Nivel EPA',         explica: 'Nivel de protección personal EPA: A = encapsulado + SCBA interno; B = resistente salpicadura + SCBA externo; C = resistente salpicadura + APR. Siempre requiere tabla de permeación.' },
  barrera:    { label: 'Barrera química',   explica: 'Material de la capa de barrera del traje HAZMAT. Determina la compatibilidad con agentes específicos y el breakthrough time documentado.' },
  gases:      { label: 'Gases detectables', explica: 'Sensores integrados en el monitor multi-gas. La combinación O₂/LEL/CO/H₂S es el mínimo para monitoreo HAZMAT completo.' },
  /* Drones */
  alcance:    { label: 'Alcance',           explica: 'Distancia máxima de transmisión entre la aeronave y el controlador bajo condiciones óptimas. En operaciones urbanas restar 30–40 % por interferencias.' },
  ip:         { label: 'Protección IP',     explica: 'Grado de protección IEC 60529 contra ingreso de polvo y agua. IP55 resiste lluvia y polvo en operaciones de campo; fundamental para uso en emergencias.' },
};

type SpecRow = { label: string; val: string; explica: string; min?: string; alto?: string };
const specRows: SpecRow[] = product.specs
  ? (Object.entries(product.specs) as [string, string | undefined][])
      .filter(([, v]) => v)
      .map(([k, v]) => ({
        label:   specMeta[k]?.label   ?? k,
        val:     v as string,
        explica: specMeta[k]?.explica ?? '',
        min:     specMeta[k]?.min,
        alto:    specMeta[k]?.alto,
      }))
  : [];

/* ── Hero right col — dos párrafos SEO/marketing ────────────────────── */
const specSummary = specRows.length
  ? ` Con ${specRows.map((s) => `${s.label} ${s.val}`).slice(0, 3).join(', ')}.`
  : '';
const introPara1 = `${product.title} es la referencia${product.tier ? ` ${product.tier.toLowerCase()}` : ''} de ${product.brand ?? product.category} para el mercado mexicano. ${product.description}${specSummary} Certificado bajo ${product.norm ?? 'norma NFPA'} por laboratorio acreditado — número de modelo y serie verificables directamente con el fabricante.`;
const introPara2 = `Como distribuidores autorizados de ${product.brand ?? 'esta marca'} en México, entregamos el dossier documental completo para licitaciones públicas (CompraNet, IMSS, gobiernos estatales) y corporativas: certificado de conformidad ${product.norm ?? 'NFPA'}, ficha técnica oficial en español, carta de distribuidor autorizado y manifiesto de cumplimiento de norma por partida. Stock permanente en CDMX con entrega en 24–48 h.`;
const heroParas = [introPara1, introPara2];

const heroBadges = [
  product.norm,
  product.brand,
  product.badge,
  product.tier,
  'Distribuidor autorizado MX',
  'Stock CDMX · 24–48 h',
  'Ficha técnica incluida',
  'Licitación pública / privada',
  ...specRows.slice(0, 2).map((s) => `${s.label}: ${s.val}`),
].filter(Boolean) as string[];

/* ── Use cases por categoría ───────────────────────────────────────────── */
type UseCases = { si: string[]; considera: string[] };
const catUseCases: Record<string, UseCases> = {
  'Trajes Bombero': {
    si: [
      'Incendios estructurales en edificios residenciales, comerciales e industriales',
      'Operaciones con riesgo de exposición al calor radiante intenso y llama directa',
      'Rescate técnico en entornos con riesgo térmico confirmado',
      'Brigadas industriales con exposición a derrames controlados (Nivel C EPA)',
      'Cuerpos de bomberos en licitaciones públicas que exigen certificación NFPA 1970',
      'Operaciones de sobrehaul con riesgo de puntos calientes ocultos en estructura',
    ],
    considera: [
      'Para incendios forestales se requiere traje certificado NFPA 1977 — no el 1970 estructural',
      'Para HAZMAT con vapores tóxicos o desconocidos se necesita traje encapsulado NFPA 1991',
      'Para rescate acuático se requiere traje específico NFPA 1952',
      'El peso del sistema (4–5 kg) es factor relevante en operaciones de resistencia prolongada',
    ],
  },
  'Cascos NFPA': {
    si: [
      'Combate estructural en edificios residenciales, comerciales e industriales',
      'Rescate urbano con riesgo de impacto por escombro o colapso parcial',
      'Brigadas que integran cámara térmica y máscara SCBA en un mismo conjunto EPP',
      'Cuerpos con licitaciones que exigen certificación NFPA 1971 verificable',
      'Operaciones nocturnas con requerimientos de lámpara y reflectivos integrados',
    ],
    considera: [
      'Para incendios forestales se requiere casco certificado NFPA 1977',
      'Los cascos de estilo americano tienen mayor campo visual pero menos integración con SCBA europeo',
      'Verificar compatibilidad con la máscara de SCBA antes de definir el modelo',
    ],
  },
  'Equipos SCBA': {
    si: [
      'Combate de incendios estructurales en atmósfera IDLH (Immediately Dangerous to Life or Health)',
      'Entrada a espacios confinados con riesgo atmosférico (NOM-027-STPS / OSHA 1910.146)',
      'Respuesta HAZMAT Nivel A y B donde se requiere SCBA de presión positiva',
      'Operaciones en atmósferas con agentes CBRN (químicos, biológicos, radiológicos)',
      'Sobrehaul con posible presencia de gases de combustión residuales',
    ],
    considera: [
      'Para atmósferas caracterizadas por debajo del IDLH puede utilizarse APR — es más ligero y ágil',
      'El cilindro de 60 min agrega peso significativo — evaluar la autonomía real según operación',
      'Verificar compatibilidad de la máscara con el casco antes de adquirir el sistema',
    ],
  },
  'Cámaras Térmicas': {
    si: [
      'Búsqueda y rescate de víctimas en interiores con visibilidad cero por humo denso',
      'Localización de focos calientes ocultos tras muros, techos y pisos en sobrehaul',
      'Comando e incidente: transmisión de imagen en tiempo real al puesto de mando exterior',
      'Verificación de zona quemada — confirmar ausencia de puntos activos antes de retirar EPP',
      'Formación y documentación de incidentes para análisis táctico posterior',
    ],
    considera: [
      'La cámara es herramienta de apoyo a la decisión — no reemplaza la evaluación táctica del bombero',
      'Resolución 160×120 es suficiente para búsqueda; para mando y documentación preferir 320×240',
      'En incendios con temperatura superior a 500 °C la pantalla se satura — verificar rango del modelo',
    ],
  },
  'Equipos HAZMAT': {
    si: [
      'Respuesta a derrames de sustancias peligrosas con agente identificado y tabla de permeación',
      'Entrada a zonas contaminadas con nivel de protección definido por protocolo HAZMAT',
      'Monitoreo continuo de la atmósfera durante todas las fases de la operación',
      'Reconocimiento de escena con muestreo remoto antes de determinar el nivel de protección',
      'Brigadas industriales con atención a instalaciones petroquímicas, químicas y de transporte',
    ],
    considera: [
      'La selección del nivel A/B/C requiere obligatoriamente tabla de permeación para el agente específico',
      'El traje encapsulado Nivel A genera estrés térmico severo — planificar rotación de personal',
      'Para agentes desconocidos siempre iniciar en Nivel A y degradar únicamente con información verificada',
    ],
  },
  'Herramientas Rescate': {
    si: [
      'Excarcelación vehicular en accidentes de tránsito con víctimas atrapadas',
      'Apertura de accesos en colapsos estructurales para rescate de personas',
      'Corte de materiales de construcción en entornos de colapso parcial',
      'Operaciones de rescate en altura donde se requiere equipo portátil y autónomo',
      'Brigadas municipales y estatales con recursos para equipo hidráulico o eléctrico',
    ],
    considera: [
      'Los vehículos modernos con acero de ultra-alta resistencia pueden requerir herramientas de mayor fuerza',
      'El sistema hidráulico ofrece mayor potencia sostenida; el eléctrico, mayor movilidad sin mangueras',
      'Verificar el peso operativo total incluyendo la unidad de potencia antes de asignar al equipo',
    ],
  },
  'Extintores': {
    si: [
      'Riesgo de fuego clase A (sólidos), B (líquidos) o C (eléctrico) en cualquier inmueble o vehículo',
      'Cumplimiento de NOM-002-STPS: puntos de extintor requeridos según área y tipo de riesgo',
      'Cocinas industriales con aceite a alta temperatura — única clase que exige extintor Tipo K (UL 300)',
      'Tableros eléctricos, salas de TI y servidores donde el PQS ABC dañaría los equipos (CO₂ o FM-200)',
      'Programas de Protección Civil municipales, estatales e institucionales — licitaciones NOM-154-SCFI',
      'Plantas industriales, helipuertos y terminales de combustible con riesgo de alta magnitud (sobre ruedas)',
    ],
    considera: [
      'El PQS ABC no es válido para fuegos de aceite a alta temperatura (Clase K) — usar Tipo K con certificación UL 300',
      'El PQS ABC daña equipos electrónicos por residuo — en tableros y servidores usar CO₂ o agente limpio FM-200',
      'El extintor de agua no debe usarse en presencia de riesgos eléctricos — puede causar electrocución',
      'Ningún extintor portátil reemplaza un sistema fijo de supresión en instalaciones de alta disponibilidad',
    ],
  },
  'Sistemas CI': {
    si: [
      'Protección de inmuebles bajo obligación normativa (NOM-002-STPS, NOM-022-STPS)',
      'Instalaciones que exigen certificación de aseguradora con listado UL o FM',
      'Proyectos que requieren memoria de cálculo firmada por DRO para aprobación municipal',
      'Inmuebles con alta concentración de personas o activos críticos no recuperables',
      'Proyectos con auditoría periódica de Protección Civil estatal o municipal',
    ],
    considera: [
      'El tipo de sistema depende del riesgo de ocupación (ligero, ordinario, extra hazard — NFPA 13)',
      'Data centers y cuartos de control requieren agente limpio — no rociadores de agua',
      'La memoria de cálculo firmada por DRO es requisito para la mayoría de aseguradoras en México',
    ],
  },
};

const useCases: UseCases = catUseCases[product.category] ?? {
  si: [
    'Operaciones que requieren certificación ' + (product.norm ?? 'NFPA') + ' verificable',
    'Equipamiento para cuerpos de bomberos y brigadas industriales certificadas',
    'Licitaciones públicas con especificación de norma NFPA por partida',
    'Corporaciones que exigen documentación de distribuidor autorizado',
  ],
  considera: [
    'Verificar compatibilidad con el resto del equipo de protección personal del cuerpo',
    'Solicitar la ficha técnica completa y el certificado de conformidad antes de la compra',
  ],
};

/* ── Galería: imagen principal + 5 de la misma categoría ───────────────── */
type GalleryImg = { src: string; alt: string };
const galleryImages: GalleryImg[] = [
  ...(product.image ? [{ src: product.image, alt: product.title }] : []),
  ...featuredProducts
    .filter((p) => p.category === product.category && p.image && p.slug !== product.slug)
    .slice(0, 5)
    .map((p) => ({ src: p.image!, alt: p.title })),
].slice(0, 6);

/* ── Sidebar: productos de la misma marca ──────────────────────────────── */
const sidebarBrandProds = featuredProducts
  .filter((p) => p.category === product.category && p.brand === product.brand && p.slug !== product.slug)
  .slice(0, 5);

const sidebarCatProds = featuredProducts
  .filter(
    (p) =>
      p.category === product.category &&
      p.slug !== product.slug &&
      !sidebarBrandProds.find((b) => b.slug === p.slug),
  )
  .slice(0, Math.max(0, 5 - sidebarBrandProds.length));

/* ── Sidebar: otras categorías ─────────────────────────────────────────── */
const currentCatSlug = categoryPath.split('/')[2];
const sidebarCats = categories.filter((c) => c.slug !== currentCatSlug);

/* ── Sidebar: artículos por categoría ──────────────────────────────────── */
type SbArt = { label: string; desc: string; href: string };
const catArticulos: Record<string, SbArt[]> = {
  'Trajes Bombero': [
    { label: 'NFPA 1970: la nueva norma estructural', desc: 'Qué cambió para trajes y EPP en 2024', href: '/blog/nfpa-1970-nueva-norma-trajes-bombero' },
    { label: 'PBI Matrix vs Nomex IIIA', desc: 'Desempeño, durabilidad y costo comparados', href: '/blog/pbi-matrix-vs-nomex-trajes-bombero' },
    { label: 'TPP y THL: los dos parámetros clave', desc: 'Cómo leer e interpretar los valores de norma', href: '/blog/tpp-thl-trajes-bombero-nfpa' },
    { label: 'Inspección y retiro NFPA 1850', desc: 'Criterios y periodicidad para EPP estructural', href: '/blog/inspeccion-cuidado-vida-util-traje-bombero' },
  ],
  'Cascos NFPA': [
    { label: 'Casco europeo vs americano', desc: 'Cuándo elegir cada estilo para tu corporación', href: '/blog/casco-bombero-europeo-vs-americano' },
    { label: 'Compatibilidad casco-SCBA', desc: 'Cómo verificar el perfil de máscara', href: '/blog/compatibilidad-casco-scba-bomberos' },
    { label: 'NFPA 1970: cambios en cascos', desc: 'Lo que certifica la norma actualizada', href: '/blog/nfpa-1970-cascos-bomberos' },
    { label: 'Vida útil y criterios de retiro', desc: 'Inspección NFPA 1850 aplicada a cascos', href: '/blog/inspeccion-cuidado-vida-util-traje-bombero' },
  ],
  'Equipos SCBA': [
    { label: 'MSA G1 vs Dräger PSS 7000', desc: 'Comparativa técnica para combate estructural', href: '/blog/msa-g1-vs-drager-pss7000-scba' },
    { label: 'Cilindros fibra de carbono vs acero', desc: 'Peso, robustez y costo total a 10 años', href: '/blog/cilindros-scba-fibra-carbono-vs-acero' },
    { label: 'NFPA 1970: el nuevo estándar SCBA', desc: 'Diferencias respecto a la NFPA 1981 anterior', href: '/blog/nfpa-1970-scba-bomberos' },
    { label: 'Prueba hidrostática en México', desc: 'Plazos, costos y talleres autorizados', href: '/blog/prueba-hidrostatica-cilindros-scba' },
  ],
  'Cámaras Térmicas': [
    { label: 'NFPA 1801: qué certifica y qué no', desc: 'Guía técnica para evaluadores y licitadores', href: '/blog/nfpa-1801-camaras-termicas-bomberos' },
    { label: 'FLIR vs MSA vs Bullard', desc: 'Comparativa técnica por escenario de uso', href: '/blog/flir-vs-msa-vs-bullard-camaras-termicas' },
    { label: 'Cámara de mando vs cámara de entrada', desc: 'Cuándo necesitas una y cuándo la otra', href: '/blog/camara-termica-mando-vs-entrada-bomberos' },
    { label: 'Mantenimiento de cámaras NFPA 1801', desc: 'Calibración, baterías y criterios de retiro', href: '/blog/mantenimiento-camaras-termicas-bomberos' },
  ],
  'Equipos HAZMAT': [
    { label: 'Niveles EPA A, B, C y D explicados', desc: 'Cuándo usar cada nivel y qué protege', href: '/blog/niveles-proteccion-hazmat-epa-abc' },
    { label: 'Tablas de permeación DuPont vs Lakeland', desc: 'Cómo leerlas y usarlas en la selección', href: '/blog/tablas-permeacion-dupont-lakeland-hazmat' },
    { label: 'MSA Altair 5X vs 4XR — comparativa', desc: 'Reconocimiento vs monitoreo continuo HAZMAT', href: '/blog/msa-altair-5x-vs-4xr-deteccion-hazmat' },
    { label: 'Plan de respuesta HAZMAT certificado', desc: 'Documentos requeridos por Protección Civil', href: '/blog/plan-respuesta-hazmat-proteccion-civil' },
  ],
  'Herramientas Rescate': [
    { label: 'Holmatro vs Lukas — comparativa', desc: 'Acero de ultra-alta resistencia y excarcelación', href: '/blog/holmatro-vs-lukas-herramientas-rescate' },
    { label: 'NFPA 1936 explicada', desc: 'Qué pruebas aplican a cada herramienta', href: '/blog/nfpa-1936-herramientas-rescate-excarcelacion' },
    { label: 'Herramientas hidráulicas vs eléctricas', desc: 'Cuándo la batería supera al hidráulico', href: '/blog/hidraulico-vs-electrico-herramientas-rescate' },
    { label: 'Excarcelación en vehículos modernos', desc: 'Nuevos aceros y su impacto operativo', href: '/blog/excarcelacion-vehiculos-modernos-acero-avanzado' },
  ],
  'Extintores': [
    { label: 'NOM-002-STPS: dotación obligatoria de extintores', desc: 'Cómo calcular la dotación por área y riesgo', href: '/blog/nom-002-stps-dotacion-extintores' },
    { label: 'PQS ABC vs CO₂ vs Tipo K', desc: 'Cuándo usar cada agente y por qué importa', href: '/blog/pqs-abc-vs-co2-vs-tipo-k-extintores' },
    { label: 'NOM-154-SCFI explicada', desc: 'Qué certifica y qué no — guía para evaluadores', href: '/blog/nom-154-scfi-extintores-guia' },
    { label: 'Mantenimiento y recarga NOM', desc: 'Periodicidad, costos y documentación requerida', href: '/blog/mantenimiento-recarga-extintores-nom' },
  ],
  'Sistemas CI': [
    { label: 'NFPA 13 vs 13R vs 13D', desc: 'Cuál aplica a tu proyecto y por qué', href: '/blog/nfpa-13-vs-13r-vs-13d-rociadores' },
    { label: 'FM-200 vs Novec 1230', desc: 'Comparativa técnica y ambiental de agentes limpios', href: '/blog/fm200-vs-novec-1230-agente-limpio' },
    { label: 'Memoria de cálculo hidráulico', desc: 'Por qué la exigen aseguradoras y Protección Civil', href: '/blog/memoria-calculo-hidraulico-sistemas-ci' },
    { label: 'Tableros FACP de detección inteligente', desc: 'Qué funciones requiere tu proyecto', href: '/blog/tableros-deteccion-facp-incendio' },
  ],
};
const sidebarArticulos: SbArt[] = catArticulos[product.category] ?? [
  { label: 'Certificaciones NFPA en México', desc: 'Guía completa para licitadores y evaluadores', href: '/blog/certificaciones-nfpa-mexico' },
  { label: 'Cómo especificar EPP en licitaciones', desc: 'Bases técnicas por desempeño y norma', href: '/blog/especificaciones-traje-bombero-licitaciones' },
  { label: 'Normatividad vigente de bomberos MX', desc: 'NOM, NFPA y requisitos actualizados', href: '/blog/normatividad-bomberos-mexico' },
];

/* ── Sidebar: Completa tu equipo (cross-categoría) ─────────────────────── */
type CatLink = { label: string; href: string; brands: string };
const equipoMap: Record<string, CatLink[]> = {
  'Trajes Bombero': [
    { label: 'Cascos NFPA',       href: '/productos/cascos-nfpa',       brands: 'MSA Gallet · Bullard · Cairns' },
    { label: 'Equipos SCBA',      href: '/productos/equipos-scba',      brands: 'MSA G1 · Dräger · 3M Scott' },
    { label: 'Cámaras Térmicas',  href: '/productos/camaras-termicas',  brands: 'FLIR · MSA Evolution · Bullard TXS' },
  ],
  'Cascos NFPA': [
    { label: 'Trajes Bombero',    href: '/productos/trajes-bombero',    brands: 'Globe · Lion · Honeywell · Fire-Dex' },
    { label: 'Equipos SCBA',      href: '/productos/equipos-scba',      brands: 'MSA G1 · Dräger · 3M Scott' },
  ],
  'Equipos SCBA': [
    { label: 'Trajes Bombero',    href: '/productos/trajes-bombero',    brands: 'Globe · Lion · Honeywell · Fire-Dex' },
    { label: 'Cascos NFPA',       href: '/productos/cascos-nfpa',       brands: 'MSA Gallet · Bullard · Cairns' },
    { label: 'Cámaras Térmicas',  href: '/productos/camaras-termicas',  brands: 'FLIR · MSA Evolution · Bullard TXS' },
  ],
  'Cámaras Térmicas': [
    { label: 'Equipos SCBA',      href: '/productos/equipos-scba',      brands: 'MSA G1 · Dräger · 3M Scott' },
    { label: 'Trajes Bombero',    href: '/productos/trajes-bombero',    brands: 'Globe · Lion · Honeywell · Fire-Dex' },
  ],
  'Herramientas Rescate': [
    { label: 'Equipos SCBA',      href: '/productos/equipos-scba',      brands: 'MSA G1 · Dräger · 3M Scott' },
    { label: 'Trajes Bombero',    href: '/productos/trajes-bombero',    brands: 'Globe · Lion · Honeywell · Fire-Dex' },
  ],
  'Extintores': [
    { label: 'Sistemas CI',       href: '/productos/sistemas-ci',       brands: 'Tyco Viking · Notifier · Kidde Fenwal' },
    { label: 'Herramientas Rescate', href: '/productos/herramientas-rescate', brands: 'Holmatro · Hurst · Weber Rescue' },
  ],
  'Sistemas CI': [
    { label: 'Extintores',        href: '/productos/extintores',        brands: 'PQS ABC · CO₂ · Agente limpio · Tipo K' },
    { label: 'Herramientas Rescate', href: '/productos/herramientas-rescate', brands: 'Holmatro · Hurst · Weber Rescue' },
  ],
  'Equipos HAZMAT': [
    { label: 'Equipos SCBA',      href: '/productos/equipos-scba',      brands: 'MSA G1 · Dräger · 3M Scott' },
    { label: 'Extintores',        href: '/productos/extintores',        brands: 'PQS ABC · CO₂ · Agente limpio · Tipo K' },
  ],
};
const catEquipo: CatLink[] = equipoMap[product.category] ?? [];

/* ── JSON-LD ────────────────────────────────────────────────────────────── */
const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: product.title,
  description: product.description,
  url: canonicalURL,
  category: product.category,
  ...(product.image ? { image: `${SITE.url}${product.image}` } : {}),
  ...(product.brand ? { brand: { '@type': 'Brand', name: product.brand } } : {}),
  offers: {
    '@type': 'Offer',
    url: canonicalURL,
    priceCurrency: 'MXN',
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'Organization', name: SITE.name },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio',         item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Productos',      item: `${SITE.url}/productos` },
    { '@type': 'ListItem', position: 3, name: product.category, item: `${SITE.url}${categoryPath}` },
    { '@type': 'ListItem', position: 4, name: product.title,    item: canonicalURL },
  ],
};

const seoTitle = `${product.title}${product.norm ? ` ${product.norm}` : ''} — ${product.brand ?? product.category} · ${SITE.name}`;
const seoDesc  = `${product.description} Distribuidor autorizado ${product.brand ?? ''} en México. ${product.norm ?? ''} certificado con documentación completa para licitación.`.replace(/\s+/g, ' ').trim().slice(0, 158);
---

<BaseLayout
  title={seoTitle}
  description={seoDesc}
  canonicalURL={canonicalURL}
  ogType="product"
  schema={[productSchema, breadcrumbSchema]}
>

  {/* ══ BREADCRUMB ══════════════════════════════════════════════════════ */}
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center flex-wrap gap-2 text-xs list-none m-0 p-0" style="color:#4A7599">
        <li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/productos" class="hover:text-[#FF6B26]">Productos</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={categoryPath} class="hover:text-[#FF6B26]">{product.category}</a></li>
        <li aria-hidden="true">/</li>
        {brandPath && product.brand && (
          <>
            <li><a href={brandPath} class="hover:text-[#FF6B26]">{product.brand}</a></li>
            <li aria-hidden="true">/</li>
          </>
        )}
        <li><span style="color:#94A3B8" aria-current="page">{product.title}</span></li>
      </ol>
    </div>
  </nav>

  {/* ══ HERO — patrón idéntico al resto del sitio ═══════════════════════ */}
  <section class="relative overflow-hidden" style="background:#040A12;padding-block:5rem">
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none"
         style="background:radial-gradient(ellipse 80% 70% at 90% 30%, rgba(247,80,0,0.08) 0%, transparent 65%)"
         aria-hidden="true"></div>

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        {/* ── Columna izquierda ─────────────────────────────────────── */}
        <div>
          <span class="section-eyebrow mb-5 inline-flex">
            {[product.brand, product.norm, product.tier].filter(Boolean).join(' · ')}
          </span>

          <h1 class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2.5rem,5.5vw,4.5rem);line-height:0.95">
            {h1line1}{h1line2 && (
              <><br/><span style="color:#F75000">{h1line2}</span></>
            )}
          </h1>

          <p class="text-sm leading-relaxed mb-8" style="color:#94A3B8">
            {product.description}
            {product.norm && <> Certificado <strong style="color:#FFFFFF">{product.norm}</strong>.</>}
            {' '}Distribuidor autorizado en México.
          </p>

          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href={whatsappUrl(`Hola, quiero cotizar el ${product.title}${product.norm ? ` (${product.norm})` : ''}. ¿Me pueden enviar precio y disponibilidad?`)}
              target="_blank" rel="noopener"
              class="btn btn-primary btn-lg"
            >
              Cotizar por WhatsApp →
            </a>
            {brandPath && (
              <a href={brandPath} class="btn btn-ghost btn-lg">
                Ver catálogo {product.brand}
              </a>
            )}
          </div>
        </div>

        {/* ── Columna derecha — párrafos SEO/marketing ────────────────── */}
        <div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,0.1)">
          {heroParas.map((p) => (
            <p class="text-sm leading-[1.9] mb-5" style="color:#94A3B8">{p}</p>
          ))}
        </div>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-px"
         style="background:linear-gradient(90deg, transparent, rgba(247,80,0,0.4) 30%, rgba(247,80,0,0.4) 70%, transparent)"
         aria-hidden="true"></div>
  </section>

  {/* ══ QUICKLINKS ══════════════════════════════════════════════════════ */}
  <QuickLinksBar />

  {/* ══ LAYOUT PRINCIPAL: MAIN + SIDEBAR ════════════════════════════════ */}
  <div style="background:#070E1A">
    <div class="container-site" style="padding-block:3.5rem">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_340px] gap-10 items-start">

        {/* ── MAIN CONTENT ─────────────────────────────────────────────── */}
        <main class="flex flex-col gap-8">

          {/* Galería 3×2 */}
          {galleryImages.length > 0 && (
            <div>
              <div class="grid grid-cols-3 gap-1.5" aria-label={`Galería ${product.category} — ${product.brand ?? ''}`}>
                {galleryImages.map((img, i) => (
                  <figure class="m-0 overflow-hidden group relative"
                          style="background:#060D18;border:1px solid rgba(74,117,153,0.18)">
                    <img
                      src={img.src}
                      alt={`${img.alt} — ${product.norm ?? product.category}`}
                      width="400" height="300"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      class="w-full block transition-transform group-hover:scale-105"
                      style="aspect-ratio:4/3;object-fit:cover;object-position:center"
                    />
                    {i === 0 && product.badge && (
                      <div class="absolute top-2 left-2 pointer-events-none">
                        <span class="text-[9px] font-display font-bold uppercase tracking-widest px-2 py-1"
                              style="background:#F75000;color:#FFFFFF">★ {product.badge}</span>
                      </div>
                    )}
                  </figure>
                ))}
                {/* Rellenar con placeholders si hay menos de 6 imágenes */}
                {Array.from({ length: Math.max(0, 6 - galleryImages.length) }).map((_, i) => (
                  <div class="flex flex-col items-center justify-center gap-2"
                       style="aspect-ratio:4/3;background:#060D18;border:1px solid rgba(74,117,153,0.12)">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="rgba(74,117,153,0.2)" stroke-width="1.5" aria-hidden="true">
                      <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/>
                      <path d="M21 15l-5-5L5 21"/>
                    </svg>
                  </div>
                ))}
              </div>
              <p class="text-[10px] mt-2 text-right" style="color:#4A7599">
                {product.category} · {product.brand ?? ''} · Distribuidor autorizado México
              </p>
            </div>
          )}

          {/* Descripción + specs */}
          <div style="background:#040A12;border:1px solid rgba(74,117,153,0.18)">
            <div class="p-6 pb-0">
              <span class="section-eyebrow mb-4 inline-flex">{product.norm ?? product.category} · {product.brand ?? 'Fabricante'}</span>
              <h2 class="font-display font-bold mb-5" style="color:#FFFFFF;font-size:clamp(1.5rem,3vw,2.25rem);line-height:1.1">
                Descripción técnica <span style="color:#F75000">del equipo.</span>
              </h2>
              <p class="text-sm leading-[1.9] mb-4" style="color:#94A3B8">{product.description}</p>
              <p class="text-sm leading-[1.9] mb-4" style="color:#94A3B8">
                Como distribuidor autorizado de {product.brand ?? 'esta marca'} en México, entregamos cada unidad con número de serie verificable, certificado de conformidad {product.norm ?? 'NFPA'} con el número de laboratorio acreditado, y documentación completa para licitación pública o proceso de compra corporativo.
              </p>
              {product.brand && (
                <p class="text-sm leading-[1.9] mb-5" style="color:#94A3B8">
                  {product.brand} es referencia mundial en {product.category.toLowerCase()} con presencia activa en los principales cuerpos de bomberos y brigadas industriales de América Latina. La línea {product.title} representa el estándar tier-1 en licitaciones públicas en México.
                </p>
              )}
              <a href={whatsappUrl(`Hola, quiero la ficha técnica completa del ${product.title} (${product.norm ?? ''}) para evaluación.`)} target="_blank" rel="noopener" class="btn btn-ghost" style="margin-bottom:1.5rem">
                Solicitar ficha técnica →
              </a>
            </div>

            {/* Specs table */}
            {specRows.length > 0 && (
              <div style="border-top:1px solid rgba(74,117,153,0.18)">
                <div class="px-6 py-3" style="background:#080F1A">
                  <span class="text-[10px] font-display font-bold uppercase tracking-widest" style="color:#4A7599">Especificaciones técnicas</span>
                </div>
                <div style="overflow-x:auto">
                  <table style="width:100%;border-collapse:collapse;min-width:400px">
                    <thead>
                      <tr style="background:#080F1A;border-bottom:1px solid rgba(74,117,153,0.25)">
                        <th class="text-left p-3 text-[10px] font-display font-bold uppercase tracking-widest" style="color:#4A7599;width:30%">Parámetro</th>
                        <th class="text-left p-3 text-[10px] font-display font-bold uppercase tracking-widest" style="color:#F75000;width:22%">Valor</th>
                        <th class="text-left p-3 text-[10px] font-display font-bold uppercase tracking-widest" style="color:#4A7599">Referencia</th>
                      </tr>
                    </thead>
                    <tbody>
                      {specRows.map((s, i) => (
                        <tr style={`border-bottom:1px solid rgba(74,117,153,0.1);background:${i % 2 === 0 ? '#040A12' : '#080F1A'}`}>
                          <td class="p-3 font-display font-semibold text-xs" style="color:#CBD5E1">{s.label}</td>
                          <td class="p-3 font-display font-bold text-xs" style="color:#F75000">{s.val}</td>
                          <td class="p-3 text-xs leading-relaxed" style="color:#64748B">{s.explica}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                {specRows.some((s) => s.min || s.alto) && (
                  <div class="p-4" style="border-top:1px solid rgba(74,117,153,0.15);background:#080F1A">
                    <p class="text-[10px] font-display font-bold uppercase tracking-widest mb-3" style="color:#4A7599">Contexto de desempeño</p>
                    <div class="flex flex-col gap-2">
                      {specRows.filter((s) => s.min || s.alto).map((s) => (
                        <div class="flex items-center gap-3 text-xs flex-wrap">
                          <span style="color:#64748B;min-width:80px">{s.label}</span>
                          {s.min && <span class="px-2 py-0.5" style="background:#040A12;color:#4A7599;border:1px solid rgba(74,117,153,0.2)">Mín NFPA: {s.min}</span>}
                          <span class="px-2 py-0.5 font-semibold" style="background:rgba(247,80,0,0.12);color:#F75000;border:1px solid rgba(247,80,0,0.3)">Este modelo: {s.val}</span>
                          {s.alto && <span class="px-2 py-0.5" style="background:#040A12;color:#34D399;border:1px solid rgba(52,211,153,0.2)">Alta perf: {s.alto}</span>}
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            )}
          </div>

          {/* Características */}
          {product.features && product.features.length > 0 && (
            <div style="background:#040A12;border:1px solid rgba(74,117,153,0.18)">
              <div class="px-6 py-4 flex items-center gap-3" style="border-bottom:1px solid rgba(74,117,153,0.18)">
                <span class="section-eyebrow inline-flex">Características · {product.norm ?? product.category}</span>
              </div>
              <div class="p-6 pb-4">
                <h2 class="font-display font-bold mb-2" style="color:#FFFFFF;font-size:clamp(1.25rem,2.5vw,1.875rem);line-height:1.1">
                  Lo que distingue <span style="color:#F75000">a este equipo.</span>
                </h2>
                <p class="text-sm leading-relaxed mb-6" style="color:#64748B">
                  Documentado en la ficha técnica oficial — verificable por número de modelo y laboratorio acreditado.
                </p>
              </div>
              <div class={`grid grid-cols-1 ${product.features.length === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-3'} gap-px`}
                   style="border-top:1px solid rgba(74,117,153,0.18)">
                {product.features.map((feat, i) => {
                  const colors = ['#F75000','#F5A623','#34D399','#60A5FA','#A78BFA'];
                  const color = colors[i % colors.length];
                  return (
                    <div class="flex flex-col gap-3 p-5" style={`background:#080F1A;border-top:3px solid ${color}`}>
                      <div class="w-8 h-8 flex items-center justify-center rounded-full" style={`background:${color}18`}>
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={color} stroke-width="2.5" aria-hidden="true">
                          <path d="M20 6L9 17l-5-5"/>
                        </svg>
                      </div>
                      <p class="text-xs leading-relaxed m-0" style="color:#94A3B8">{feat}</p>
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          {/* Aplicaciones */}
          <div style="background:#040A12;border:1px solid rgba(74,117,153,0.18)">
            <div class="px-6 py-4" style="border-bottom:1px solid rgba(74,117,153,0.18)">
              <span class="section-eyebrow inline-flex">Cuándo es la opción correcta</span>
            </div>
            <div class="p-6 pb-4">
              <h2 class="font-display font-bold mb-6" style="color:#FFFFFF;font-size:clamp(1.25rem,2.5vw,1.875rem);line-height:1.1">
                Aplicaciones y <span style="color:#F75000">casos de uso.</span>
              </h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-px" style="border-top:1px solid rgba(74,117,153,0.18)">
              <div style="background:#080F1A;border-top:3px solid #34D399">
                <div class="px-5 pt-4 pb-3" style="border-bottom:1px solid rgba(74,117,153,0.12)">
                  <span class="text-[10px] font-display font-bold uppercase tracking-widest" style="color:#34D399">✓ Ideal para</span>
                </div>
                <ul class="flex flex-col list-none m-0 p-0">
                  {useCases.si.map((item, i) => (
                    <li class="flex items-start gap-2 px-5 py-3"
                        style={`border-bottom:${i < useCases.si.length - 1 ? '1px solid rgba(74,117,153,0.08)' : 'none'}`}>
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#34D399" stroke-width="2.5" class="shrink-0 mt-1" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                      <span class="text-xs leading-relaxed" style="color:#94A3B8">{item}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <div style="background:#080F1A;border-top:3px solid #F5A623">
                <div class="px-5 pt-4 pb-3" style="border-bottom:1px solid rgba(74,117,153,0.12)">
                  <span class="text-[10px] font-display font-bold uppercase tracking-widest" style="color:#F5A623">⚠ A considerar</span>
                </div>
                <ul class="flex flex-col list-none m-0 p-0">
                  {useCases.considera.map((item, i) => (
                    <li class="flex items-start gap-2 px-5 py-3"
                        style={`border-bottom:${i < useCases.considera.length - 1 ? '1px solid rgba(74,117,153,0.08)' : 'none'}`}>
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2.5" class="shrink-0 mt-1" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                      <span class="text-xs leading-relaxed" style="color:#94A3B8">{item}</span>
                    </li>
                  ))}
                </ul>
                <div class="px-5 py-4" style="border-top:1px solid rgba(74,117,153,0.12)">
                  <a href={whatsappUrl(`Hola, necesito asesoría para saber si el ${product.title} es la opción correcta para mi operación.`)} target="_blank" rel="noopener" class="text-xs font-display font-semibold hover:text-[#FF6B26]" style="color:#4A7599">
                    Consulta técnica gratuita →
                  </a>
                </div>
              </div>
            </div>
          </div>

          {/* Documentación para licitación */}
          <div style="background:#040A12;border:1px solid rgba(74,117,153,0.18)">
            <div class="px-6 py-4" style="border-bottom:1px solid rgba(74,117,153,0.18)">
              <span class="section-eyebrow inline-flex">Distribuidor autorizado · Stock CDMX</span>
            </div>
            <div class="p-6">
              <h2 class="font-display font-bold mb-3" style="color:#FFFFFF;font-size:clamp(1.25rem,2.5vw,1.875rem);line-height:1.1">
                Todo lo que necesitas <span style="color:#F75000">para la licitación.</span>
              </h2>
              <p class="text-sm leading-relaxed mb-5" style="color:#64748B">
                Entregamos el dossier completo para CompraNet, IMSS, gobiernos estatales y corporativos. Respuesta en &lt;24 h.
              </p>
              <div class="grid grid-cols-2 gap-px mb-5" style="border:1px solid rgba(74,117,153,0.18)">
                {[
                  { svg: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>`, t: `Certificado ${product.norm ?? 'NFPA'}`, d: 'Laboratorio acreditado, verificable', color: '#34D399' },
                  { svg: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>`, t: 'Ficha técnica oficial', d: 'Datasheet en español del fabricante', color: '#60A5FA' },
                  { svg: `<path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>`, t: 'Carta de distribuidor', d: 'FIREFIGHTERSMX distribuidor autorizado', color: '#F5A623' },
                  { svg: `<path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>`, t: 'Garantía de fábrica', d: 'Refacciones y servicio directo con fábrica', color: '#A78BFA' },
                ].map((d, i) => (
                  <div class="flex items-start gap-3 p-4" style={`background:${i % 2 === 0 ? '#060D18' : '#080F1A'};border-top:2px solid ${d.color}`}>
                    <div class="shrink-0 w-7 h-7 flex items-center justify-center" style={`background:${d.color}18`}>
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke={d.color} stroke-width="1.8" aria-hidden="true">
                        <Fragment set:html={d.svg} />
                      </svg>
                    </div>
                    <div>
                      <p class="font-display font-bold text-xs mb-0.5" style="color:#FFFFFF">{d.t}</p>
                      <p class="text-[11px] leading-relaxed m-0" style="color:#64748B">{d.d}</p>
                    </div>
                  </div>
                ))}
              </div>
              <div class="flex flex-col sm:flex-row gap-3">
                <a href={whatsappUrl(`Hola, necesito el dossier de licitación para el ${product.title} (${product.norm ?? ''}): certificado NFPA, ficha técnica y carta de distribuidor.`)} target="_blank" rel="noopener" class="btn btn-primary">
                  Solicitar dossier completo →
                </a>
                <a href="/cotizacion" class="btn btn-ghost">Cotización formal</a>
              </div>
            </div>
          </div>

        </main>

        {/* ── SIDEBAR ──────────────────────────────────────────────────── */}
        <aside class="flex flex-col gap-4" style="position:sticky;top:1.5rem">

          {/* CTA cotizar */}
          <div style="background:#F75000;border:1px solid rgba(247,80,0,0.6)">
            <div class="p-5">
              <p class="text-[10px] font-display font-bold uppercase tracking-widest mb-1" style="color:rgba(255,255,255,0.7)">Cotización inmediata</p>
              <p class="font-display font-bold text-base mb-3" style="color:#FFFFFF;line-height:1.2">{product.title}</p>
              {product.norm && <p class="text-[10px] mb-4" style="color:rgba(255,255,255,0.75)">{product.norm} · Distribuidor autorizado MX</p>}
              <a href={whatsappUrl(`Hola, quiero cotizar el ${product.title}${product.norm ? ` (${product.norm})` : ''}. ¿Precio y disponibilidad?`)} target="_blank" rel="noopener"
                 class="block text-center text-sm font-display font-bold py-3 px-4 w-full transition-opacity hover:opacity-90"
                 style="background:#FFFFFF;color:#F75000">
                Cotizar por WhatsApp →
              </a>
              <a href="/cotizacion" class="block text-center text-xs mt-2 py-2 font-display font-semibold" style="color:rgba(255,255,255,0.8)">
                Cotización formal
              </a>
            </div>
          </div>

          {/* Especificaciones rápidas */}
          {specRows.length > 0 && (
            <div style="background:#080F1A;border:1px solid rgba(74,117,153,0.18)">
              <div class="px-4 py-3" style="background:#040A12;border-bottom:1px solid rgba(74,117,153,0.18)">
                <span class="text-[9px] font-display font-bold uppercase tracking-widest" style="color:#4A7599">Especificaciones</span>
              </div>
              <div class="flex flex-col">
                {specRows.map((s, i) => (
                  <div class="flex items-center justify-between gap-2 px-4 py-2.5"
                       style={`border-bottom:${i < specRows.length - 1 ? '1px solid rgba(74,117,153,0.1)' : 'none'}`}>
                    <span class="text-[11px]" style="color:#64748B">{s.label}</span>
                    <span class="font-display font-bold text-xs" style="color:#F75000">{s.val}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          {/* Más productos de la marca */}
          {sidebarBrandProds.length > 0 && (
            <div style="background:#080F1A;border:1px solid rgba(74,117,153,0.18)">
              <div class="px-4 py-3" style="background:#040A12;border-bottom:1px solid rgba(74,117,153,0.18)">
                <span class="text-[9px] font-display font-bold uppercase tracking-widest" style="color:#4A7599">Más de {product.brand}</span>
              </div>
              <div class="flex flex-col">
                {sidebarBrandProds.map((p, i) => (
                  <a href={p.href}
                     class="flex items-center gap-3 px-4 py-3 group transition-colors hover:bg-[#040A12]"
                     style={`border-bottom:${i < sidebarBrandProds.length - 1 ? '1px solid rgba(74,117,153,0.1)' : 'none'}`}>
                    {p.image ? (
                      <img src={p.image} alt={p.title} width="48" height="48" loading="lazy"
                           class="shrink-0" style="width:48px;height:48px;object-fit:cover;object-position:center;background:#060D18" />
                    ) : (
                      <div class="shrink-0 flex items-center justify-center" style="width:48px;height:48px;background:#060D18;border:1px solid rgba(74,117,153,0.15)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="rgba(74,117,153,0.3)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
                      </div>
                    )}
                    <div class="flex-1 min-w-0">
                      <p class="font-display font-semibold text-xs truncate group-hover:text-[#F75000] transition-colors" style="color:#FFFFFF">{p.title}</p>
                      {p.norm && <p class="text-[10px] mt-0.5" style="color:#4A7599">{p.norm}</p>}
                    </div>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#4A7599" stroke-width="2" class="shrink-0" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
                  </a>
                ))}
              </div>
              {brandPath && (
                <div class="px-4 py-3" style="border-top:1px solid rgba(74,117,153,0.15)">
                  <a href={brandPath} class="text-[10px] font-display font-semibold hover:text-[#FF6B26] transition-colors" style="color:#4A7599">
                    Ver catálogo completo {product.brand} →
                  </a>
                </div>
              )}
            </div>
          )}

          {/* Más en la categoría */}
          {sidebarCatProds.length > 0 && (
            <div style="background:#080F1A;border:1px solid rgba(74,117,153,0.18)">
              <div class="px-4 py-3" style="background:#040A12;border-bottom:1px solid rgba(74,117,153,0.18)">
                <span class="text-[9px] font-display font-bold uppercase tracking-widest" style="color:#4A7599">Más en {product.category}</span>
              </div>
              <div class="flex flex-col">
                {sidebarCatProds.map((p, i) => (
                  <a href={p.href}
                     class="flex items-center gap-3 px-4 py-3 group transition-colors hover:bg-[#040A12]"
                     style={`border-bottom:${i < sidebarCatProds.length - 1 ? '1px solid rgba(74,117,153,0.1)' : 'none'}`}>
                    {p.image ? (
                      <img src={p.image} alt={p.title} width="40" height="40" loading="lazy"
                           class="shrink-0" style="width:40px;height:40px;object-fit:cover;background:#060D18" />
                    ) : (
                      <div class="shrink-0" style="width:40px;height:40px;background:#060D18;border:1px solid rgba(74,117,153,0.12)"></div>
                    )}
                    <div class="flex-1 min-w-0">
                      <p class="font-display font-semibold text-xs truncate group-hover:text-[#F75000] transition-colors" style="color:#CBD5E1">{p.title}</p>
                      {p.brand && <p class="text-[10px] mt-0.5" style="color:#4A7599">{p.brand}</p>}
                    </div>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#4A7599" stroke-width="2" class="shrink-0" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
                  </a>
                ))}
              </div>
              <div class="px-4 py-3" style="border-top:1px solid rgba(74,117,153,0.15)">
                <a href={categoryPath} class="text-[10px] font-display font-semibold hover:text-[#FF6B26] transition-colors" style="color:#4A7599">
                  Ver todo en {product.category} →
                </a>
              </div>
            </div>
          )}

          {/* Otras categorías */}
          <div style="background:#080F1A;border:1px solid rgba(74,117,153,0.18)">
            <div class="px-4 py-3" style="background:#040A12;border-bottom:1px solid rgba(74,117,153,0.18)">
              <span class="text-[9px] font-display font-bold uppercase tracking-widest" style="color:#4A7599">Otras categorías</span>
            </div>
            <div class="grid grid-cols-2 gap-px" style="border-bottom:1px solid rgba(74,117,153,0.15)">
              {sidebarCats.slice(0, 8).map((cat) => (
                <a href={`/productos/${cat.slug}`}
                   class="flex items-center gap-2 px-3 py-2.5 group transition-colors hover:bg-[#040A12]"
                   style="border-right:1px solid rgba(74,117,153,0.1)">
                  <div class="shrink-0 w-5 h-5 flex items-center justify-center" style="color:#4A7599">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" set:html={cat.icon} aria-hidden="true"/>
                  </div>
                  <span class="text-[10px] font-display font-semibold truncate group-hover:text-[#F75000] transition-colors" style="color:#94A3B8">{cat.name}</span>
                </a>
              ))}
            </div>
            <div class="px-4 py-3">
              <a href="/productos" class="text-[10px] font-display font-semibold hover:text-[#FF6B26] transition-colors" style="color:#4A7599">
                Ver todos los productos →
              </a>
            </div>
          </div>

          {/* Artículos relacionados */}
          <div style="background:#080F1A;border:1px solid rgba(74,117,153,0.18)">
            <div class="px-4 py-3" style="background:#040A12;border-bottom:1px solid rgba(74,117,153,0.18)">
              <span class="text-[9px] font-display font-bold uppercase tracking-widest" style="color:#4A7599">Artículos relacionados</span>
            </div>
            <div class="flex flex-col">
              {sidebarArticulos.map((art, i) => (
                <a href={art.href}
                   class="flex flex-col gap-0.5 px-4 py-3 group transition-colors hover:bg-[#040A12]"
                   style={`border-bottom:${i < sidebarArticulos.length - 1 ? '1px solid rgba(74,117,153,0.1)' : 'none'}`}>
                  <span class="text-xs font-display font-semibold leading-snug group-hover:text-[#F75000] transition-colors" style="color:#FFFFFF">{art.label}</span>
                  <span class="text-[11px]" style="color:#64748B">{art.desc}</span>
                </a>
              ))}
            </div>
            <div class="px-4 py-3" style="border-top:1px solid rgba(74,117,153,0.15)">
              <a href="/blog" class="text-[10px] font-display font-semibold hover:text-[#FF6B26] transition-colors" style="color:#4A7599">
                Ver todos los artículos →
              </a>
            </div>
          </div>

          {/* Completa tu equipo */}
          {catEquipo.length > 0 && (
            <div style="background:#080F1A;border:1px solid rgba(74,117,153,0.18)">
              <div class="px-4 py-3" style="background:#040A12;border-bottom:1px solid rgba(74,117,153,0.18)">
                <span class="text-[9px] font-display font-bold uppercase tracking-widest" style="color:#4A7599">Completa tu equipo</span>
              </div>
              <div class="flex flex-col">
                {catEquipo.map((eq, i) => (
                  <a href={eq.href}
                     class="flex flex-col gap-0.5 px-4 py-3 group transition-colors hover:bg-[#040A12]"
                     style={`border-bottom:${i < catEquipo.length - 1 ? '1px solid rgba(74,117,153,0.1)' : 'none'}`}>
                    <span class="text-xs font-display font-semibold leading-snug group-hover:text-[#F75000] transition-colors" style="color:#FFFFFF">{eq.label}</span>
                    <span class="text-[11px]" style="color:#64748B">{eq.brands}</span>
                  </a>
                ))}
              </div>
              <div class="px-4 py-3" style="border-top:1px solid rgba(74,117,153,0.15)">
                <a href="/productos" class="text-[10px] font-display font-semibold hover:text-[#FF6B26] transition-colors" style="color:#4A7599">
                  Ver catálogo completo →
                </a>
              </div>
            </div>
          )}

          {/* ¿Necesitas ayuda? */}
          <div style="background:#040A12;border:1px solid rgba(74,117,153,0.22);border-top:2px solid #F75000">
            <div class="p-5">
              <p class="font-display font-bold text-sm mb-1" style="color:#FFFFFF">¿Necesitas asesoría técnica?</p>
              <p class="text-xs leading-relaxed mb-4" style="color:#64748B">
                Nuestro equipo te ayuda a elegir el equipo correcto para tu operación y presupuesto — sin compromiso.
              </p>
              <a href={whatsappUrl('Hola, necesito asesoría técnica para elegir el equipo correcto para mi operación.')}
                 target="_blank" rel="noopener"
                 class="block text-center text-xs font-display font-bold py-2.5 px-4 w-full transition-opacity hover:opacity-90"
                 style="background:#F75000;color:#FFFFFF">
                Hablar con un asesor →
              </a>
              <a href="/certificaciones" class="block text-center text-[10px] mt-2 font-display" style="color:#4A7599">
                Ver certificaciones y normas
              </a>
            </div>
          </div>

        </aside>

      </div>
    </div>
  </div>

  {/* ══ BRAND STRIP ═════════════════════════════════════════════════════ */}
  {brandPath && product.brand && (
    <section class="section-tight" style="background:#070E1A;border-top:1px solid rgba(74,117,153,0.15)" aria-label={`Catálogo ${product.brand}`}>
      <div class="container-site">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <span class="text-[9px] font-bold uppercase tracking-widest block mb-1" style="color:#4A7599">
              Distribuidor autorizado en México
            </span>
            <p class="font-display font-bold text-lg m-0" style="color:#FFFFFF">
              {product.brand}
              <span style="color:#F75000"> · </span>
              <span style="color:#94A3B8;font-size:0.875rem;font-weight:400">Catálogo completo de modelos</span>
            </p>
          </div>
          <a href={brandPath} class="btn btn-ghost shrink-0">
            Ver todos los modelos {product.brand} →
          </a>
        </div>
      </div>
    </section>
  )}

  {/* ══ RELACIONADOS ════════════════════════════════════════════════════ */}
  {related.length > 0 && (
    <section class="section" style="background:#040A12" aria-labelledby="related-title">
      <div class="container-site">

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-10">
          <div>
            <span class="section-eyebrow mb-4 inline-flex">Catálogo {product.category}</span>
            <h2 id="related-title" class="font-display font-bold"
                style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
              Otros modelos<br/>
              <span style="color:#F75000">que pueden interesarte.</span>
            </h2>
          </div>
          <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
            <p class="text-sm leading-relaxed" style="color:#94A3B8">
              Todos los modelos que distribuimos están certificados {product.norm ?? 'NFPA'} con documentación
              completa. Te asesoramos para identificar la opción más adecuada para tu operación y presupuesto.
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {related.map((p) => (
            <a
              href={p.href}
              class="group flex flex-col overflow-hidden transition-colors"
              style="background:#080F1A;border:1px solid rgba(74,117,153,0.18)"
            >
              {p.image ? (
                <div class="overflow-hidden" style="aspect-ratio:4/3;background:#060D18">
                  <img
                    src={p.image} alt={p.title}
                    width="400" height="300"
                    loading="lazy" decoding="async"
                    class="w-full h-full block transition-transform group-hover:scale-105"
                    style="object-fit:cover;object-position:center"
                  />
                </div>
              ) : (
                <div class="flex items-center justify-center" style="aspect-ratio:4/3;background:#060D18">
                  <span class="text-[9px] uppercase tracking-widest" style="color:rgba(74,117,153,0.3)">Sin imagen</span>
                </div>
              )}

              <div class="flex flex-col gap-2 p-4 flex-1">
                <div class="flex flex-wrap gap-1.5">
                  {p.norm  && <span class="badge badge-fire text-[9px]">{p.norm}</span>}
                  {p.badge && <span class="badge badge-gold text-[9px]">{p.badge}</span>}
                </div>
                <h3 class="font-display font-bold text-sm leading-snug group-hover:text-[#F75000] transition-colors"
                    style="color:#FFFFFF">{p.title}</h3>
                <p class="text-xs leading-relaxed m-0 line-clamp-2" style="color:#64748B">{p.description}</p>

                {p.specs && (
                  <div class="flex flex-wrap gap-1 mt-2">
                    {(Object.entries(p.specs) as [string, string | undefined][])
                      .filter(([, v]) => !!v)
                      .slice(0, 3)
                      .map(([k, v]) => (
                        <span class="text-[9px] font-semibold px-1.5 py-0.5"
                              style="background:#040A12;color:#4A7599;border:1px solid rgba(74,117,153,0.2)">
                          {specMeta[k]?.label ?? k}: {v}
                        </span>
                      ))}
                  </div>
                )}

                <span class="text-xs font-display font-semibold uppercase tracking-wider mt-auto pt-2"
                      style="color:#F75000">Ver detalles →</span>
              </div>
            </a>
          ))}
        </div>

        <div class="mt-8 pt-6" style="border-top:1px solid rgba(74,117,153,0.15)">
          <a href={categoryPath}
             class="text-sm font-display font-semibold hover:text-[#FF6B26] transition-colors"
             style="color:#4A7599">
            ← Ver catálogo completo de {product.category}
          </a>
        </div>

      </div>
    </section>
  )}

</BaseLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
