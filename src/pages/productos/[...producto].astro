---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { featuredProducts, type Product } from '@data/products';
import { brandPages } from '@data/brandPages';
import { SITE } from '@config/site';

export function getStaticPaths() {
  return featuredProducts.map((product) => ({ params: { producto: product.href.replace(/^\/productos\//, '') }, props: { product } }));
}

interface Props { product: Product }
const { product } = Astro.props;
const canonicalURL = `${SITE.url}${product.href}/`;
const categoryPath = product.href.split('/').slice(0, 3).join('/');
const brandEntry = product.brand ? brandPages.find((item) => `/productos/${item.categorySlug}` === categoryPath && item.brand === product.brand) : undefined;
const brandPath = brandEntry ? `/productos/${brandEntry.categorySlug}/${brandEntry.slug}` : null;
const related = featuredProducts.filter((item) => item.slug !== product.slug && (item.brand === product.brand || item.category === product.category)).slice(0, 4);
const directoryByCategory: Record<string, string> = { 'Extintores': '/empresas/extintores/', 'Sistemas CI': '/empresas/sistemas-ci/' };
const directoryHref = directoryByCategory[product.category] ?? '/empresas/venta-equipo/';
const description = `Ficha editorial de referencia de ${product.title}, en la categoría ${product.category}. Consulta qué datos verificar y localiza empresas del sector en México.`;
const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Guías de equipo', item: `${SITE.url}/productos/` },
    { '@type': 'ListItem', position: 3, name: product.category, item: `${SITE.url}${categoryPath}/` },
    { '@type': 'ListItem', position: 4, name: product.title, item: canonicalURL },
  ],
};
const pageSchema = { '@context': 'https://schema.org', '@type': 'WebPage', '@id': `${canonicalURL}#webpage`, name: product.title, description, url: canonicalURL, inLanguage: 'es-MX', isPartOf: { '@id': `${SITE.url}/#website` } };
---

<BaseLayout title={`${product.title} | Ficha de Referencia`} description={description} canonicalURL={canonicalURL} schema={[breadcrumbSchema, pageSchema]} noBrandSuffix>
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,.15)" aria-label="Breadcrumb">
    <div class="container-site"><ol class="flex items-center flex-wrap gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
      <li><a href="/">Inicio</a></li><li aria-hidden="true">/</li><li><a href="/productos/">Guías de equipo</a></li><li aria-hidden="true">/</li>
      <li><a href={`${categoryPath}/`}>{product.category}</a></li><li aria-hidden="true">/</li><li aria-current="page" style="color:#94A3B8">{product.title}</li>
    </ol></div>
  </nav>

  <section class="section" style="background:#040A12" aria-labelledby="product-heading">
    <div class="container-site grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <div>
        <span class="section-eyebrow mb-5 inline-flex">Ficha editorial de referencia</span>
        <h1 id="product-heading" class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2.4rem,5vw,4.2rem);line-height:.98">{product.title}</h1>
        <p class="text-sm leading-[1.9] mb-4" style="color:#94A3B8">Esta página identifica una referencia incluida en el catálogo editorial de {product.category.toLowerCase()}. No representa una oferta de venta ni confirma distribución, existencia, precio, entrega o relación comercial con la marca.</p>
        <p class="text-sm leading-[1.9] mb-7" style="color:#94A3B8">Las especificaciones, configuraciones y aprobaciones pueden cambiar entre versiones. Antes de comprar o integrar una licitación, solicita la ficha vigente y comprueba el modelo exacto con el fabricante, el organismo correspondiente y cada empresa consultada.</p>
        <div class="flex flex-wrap gap-2 mb-8">
          <span class="badge badge-dark">{product.category}</span>
          {product.brand && <span class="badge badge-dark">Marca declarada: {product.brand}</span>}
          {product.norm && <span class="badge badge-dark">Referencia normativa por verificar: {product.norm}</span>}
        </div>
        <div class="flex flex-col sm:flex-row gap-3"><a href={directoryHref} class="btn btn-primary btn-lg">Buscar empresas del sector</a><a href={`${categoryPath}/`} class="btn btn-ghost btn-lg">Ver guía de categoría</a></div>
      </div>
      <figure class="overflow-hidden aspect-[4/3]" style="background:#070E1A;border:1px solid rgba(74,117,153,.2)">
        {product.image ? <img src={product.image} alt={`Referencia visual de ${product.title}`} width="960" height="720" loading="eager" fetchpriority="high" class="w-full h-full object-cover" /> : <div class="w-full h-full flex items-center justify-center text-xs" style="color:#64748B">Imagen no disponible</div>}
      </figure>
    </div>
  </section>

  <QuickLinksBar />

  <section class="section" style="background:#070E1A" aria-labelledby="verify-heading">
    <div class="container-site grid grid-cols-1 lg:grid-cols-[.9fr_1.1fr] gap-12 lg:gap-20">
      <div><span class="section-eyebrow mb-4 inline-flex">Control documental</span><h2 id="verify-heading" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.2rem);line-height:1.05">Qué verificar antes de considerar esta referencia.</h2></div>
      <ol class="grid grid-cols-1 sm:grid-cols-2 gap-3 m-0 p-0 list-none">
        {['Nombre, código y configuración exacta del modelo.','Ficha técnica y manual vigentes del fabricante.','Documento de certificación o ensayo, cuando sea requisito.','Compatibilidad de accesorios y componentes del conjunto.','Mantenimiento, refacciones y criterios de retiro.','Alcance, condiciones y responsable de la propuesta comercial.'].map((item, index) => <li class="p-5 text-sm leading-relaxed" style="background:#040A12;color:#CBD5E1;border:1px solid rgba(74,117,153,.18)"><strong class="font-display mr-2" style="color:#F75000">{String(index + 1).padStart(2,'0')}</strong>{item}</li>)}
      </ol>
    </div>
  </section>

  <section class="section-tight" style="background:#040A12;border-block:1px solid rgba(247,80,0,.3)">
    <div class="container-site flex flex-col lg:flex-row justify-between gap-6 items-start lg:items-center"><div><p class="font-display font-bold text-xs uppercase tracking-widest mb-2" style="color:#F75000">Directorio nacional</p><h2 class="font-display font-bold text-2xl" style="color:#FFFFFF">Compara empresas y solicita documentación verificable.</h2></div><a href={directoryHref} class="btn btn-primary btn-lg">Consultar empresas</a></div>
  </section>

  <section class="section" style="background:#070E1A" aria-labelledby="resources-heading">
    <div class="container-site"><h2 id="resources-heading" class="font-display font-bold text-2xl mb-8" style="color:#FFFFFF">Recursos relacionados</h2><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <a href={`${categoryPath}/`} class="p-5" style="background:#040A12;border:1px solid rgba(74,117,153,.18)"><strong class="block mb-2" style="color:#FFFFFF">Guía de {product.category}</strong><span class="text-xs" style="color:#64748B">Criterios técnicos y documentales.</span></a>
      {brandPath && product.brand && <a href={`${brandPath}/`} class="p-5" style="background:#040A12;border:1px solid rgba(74,117,153,.18)"><strong class="block mb-2" style="color:#FFFFFF">Referencias {product.brand}</strong><span class="text-xs" style="color:#64748B">Familias catalogadas de la marca.</span></a>}
      <a href="/certificaciones/" class="p-5" style="background:#040A12;border:1px solid rgba(74,117,153,.18)"><strong class="block mb-2" style="color:#FFFFFF">Verificar certificaciones</strong><span class="text-xs" style="color:#64748B">Edición, alcance y documento.</span></a>
      <a href="/cotizacion/" class="p-5" style="background:#040A12;border:1px solid rgba(74,117,153,.18)"><strong class="block mb-2" style="color:#FFFFFF">Preparar una solicitud</strong><span class="text-xs" style="color:#64748B">Datos para comparar propuestas.</span></a>
    </div></div>
  </section>

  {related.length > 0 && <section class="section" style="background:#040A12" aria-labelledby="related-heading"><div class="container-site"><h2 id="related-heading" class="font-display font-bold text-2xl mb-8" style="color:#FFFFFF">Otras referencias de la categoría</h2><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">{related.map((item) => <a href={`${item.href}/`} class="p-5" style="background:#070E1A;border:1px solid rgba(74,117,153,.18)"><span class="text-[10px] uppercase tracking-widest" style="color:#F75000">{item.brand ?? item.category}</span><strong class="block mt-2" style="color:#FFFFFF">{item.title}</strong></a>)}</div></div></section>}
</BaseLayout>
