---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { featuredProducts } from '@data/products';
import { SITE, whatsappUrl, CANAL_CONTACTO } from '@config/site';

const canonicalURL = 'https://firefighters.mx/productos/alarma-contra-incendio/';
const seoMeta = {
  title: 'Alarma contra incendio: sistemas de detección NFPA 72',
  description: 'Sistemas de alarma contra incendio NFPA 72 en México: paneles direccionables Notifier, detectores de humo y calor, estaciones manuales y sirenas. Diseño e instalación.',
  canonicalURL,
};

const componentSlugs = [
  'notifier-nfs2-640', 'notifier-nfs2-3030', 'honeywell-detector-humo',
  'notifier-sd851-detector-calor', 'system-sensor-spcrl',
  'notifier-fmm-1-modulo-monitor', 'kidde-autopulse-panel',
];
const shortLabels: Record<string, string> = {
  'notifier-nfs2-640': 'Panel NFS2-640',
  'notifier-nfs2-3030': 'Panel NFS2-3030',
  'honeywell-detector-humo': 'Detector de humo Honeywell',
  'notifier-sd851-detector-calor': 'Detector de calor SD851',
  'system-sensor-spcrl': 'Sirena-estrobo SPCRL',
  'notifier-fmm-1-modulo-monitor': 'Módulo monitor FMM-1',
  'kidde-autopulse-panel': 'Panel Kidde AutoPulse',
};
const productComponents = componentSlugs
  .map((slug) => featuredProducts.find((product) => product.slug === slug))
  .filter((product): product is NonNullable<typeof product> => Boolean(product))
  .map((product) => ({ ...product, shortLabel: shortLabels[product.slug] }));
const components = [
  ...productComponents.slice(0, 6),
  {
    slug: 'estacion-manual',
    title: 'Estación manual contra incendio',
    norm: undefined,
    href: '/cotizacion/',
    image: undefined,
    shortLabel: 'Estación manual contra incendio',
    description: 'Estaciones manuales de doble acción para activar la alarma manualmente desde las rutas de evacuación.',
  },
  ...productComponents.slice(6),
];

const systemTypes = [
  ['Convencional', 'Por zonas: el panel indica el área, no el dispositivo', 'Oficinas, comercios y edificios pequeños'],
  ['Direccionable', 'Cada detector tiene dirección propia: el panel indica el punto exacto', 'Hospitales, hoteles, plantas y edificios de varios niveles'],
  ['Inalámbrico', 'Dispositivos por radiofrecuencia enlazados al panel', 'Inmuebles históricos o donde no se puede cablear'],
  ['Por aspiración (ASD)', 'Toma muestras de aire por tubería y detecta partículas de humo', 'Centros de datos, cuartos limpios y bodegas de gran altura'],
];
const detectorTypes = [
  ['Detector de humo fotoeléctrico', 'detección de humo visible de fuegos latentes; el más usado en oficinas, habitaciones y pasillos.'],
  ['Detector de calor o de temperatura', 'se activa a temperatura fija o por aumento rápido; para cocinas, estacionamientos y áreas con polvo o vapor donde un detector de humo daría falsas alarmas.'],
  ['Detector de flama', 'identifica la radiación de la flama; para naves con líquidos inflamables.'],
  ['Detección por aspiración', 'detección muy temprana en centros de datos y áreas críticas.'],
  ['Detector de gas', 'complementa la alarma en cuartos de máquinas y áreas con gases inflamables.'],
];
const steps = [
  'Levantamiento y diseño con plano de dispositivos.',
  'Instalación de cableado, panel y dispositivos.',
  'Programación de zonas o direcciones y de la secuencia de salidas.',
  'Pruebas de funcionamiento con acta de entrega.',
  'Mantenimiento periódico: prueba de detectores y sirenas, revisión de baterías y limpieza de suciedad y polvo, con bitácora para Protección Civil.',
];
const faqs = [
  ['¿Cómo funciona la alarma contra incendios?', 'Los detectores o una estación manual mandan la señal al panel de control, que identifica la zona o el dispositivo y activa sirenas y estrobos para evacuar. El panel supervisa el cableado y usa baterías de respaldo si falla la energía.'],
  ['¿Cuáles son los tipos de alarmas contra incendios?', 'Convencionales (por zonas), direccionables (identifican cada dispositivo), inalámbricas y por aspiración. La elección depende del tamaño del inmueble, el número de niveles y el tipo de riesgo.'],
  ['¿Cuánto cuesta una alarma contra incendios?', 'Depende del número de dispositivos, el tipo de panel, el cableado y la superficie. Cotizamos por proyecto con el plano o una visita técnica y entregamos la propuesta con fichas técnicas.'],
  ['¿Qué es un sistema de detección y alarma de incendios?', 'Es el conjunto de detectores, estaciones manuales, panel de control y dispositivos de notificación que identifica un incendio y alerta a los ocupantes. Se diseña conforme a la NFPA 72.'],
  ['¿La NOM-002-STPS-2010 obliga a tener alarma contra incendio?', 'En los centros de trabajo de riesgo alto, sí: la norma pide alarma de incendio y sistemas fijos de protección. En riesgo ordinario se recomienda para detectar el fuego a tiempo.'],
  ['¿Qué diferencia hay entre un detector de humo y una alarma de humo?', 'El detector de un sistema sólo detecta y envía la señal al panel, que es quien activa la alarma. La alarma de humo autónoma detecta y suena por sí misma, sin panel; se usa en casas.'],
  ['¿Cada cuándo se da mantenimiento a una alarma contra incendio?', 'Se prueba y se da mantenimiento de forma periódica según la NFPA 72 y el programa de mantenimiento del inmueble; registramos cada servicio en la bitácora para la inspección de Protección Civil.'],
];
const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Productos', item: `${SITE.url}/productos/` },
    { '@type': 'ListItem', position: 3, name: 'Sistemas contra incendio', item: `${SITE.url}/productos/sistemas-ci/` },
    { '@type': 'ListItem', position: 4, name: 'Alarma contra incendio', item: canonicalURL },
  ],
};
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })) };
const itemListSchema = { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: productComponents.map((product, index) => ({ '@type': 'ListItem', position: index + 1, name: product.title, url: `${SITE.url}${product.href}/` })) };
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, faqSchema, itemListSchema]}>
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb"><div class="container-site"><ol class="flex items-center gap-2 text-xs list-none m-0 p-0 flex-wrap" style="color:var(--forge-300)"><li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li><li aria-hidden="true">/</li><li><a href="/productos/" class="hover:text-[#FF6B26]">Productos</a></li><li aria-hidden="true">/</li><li><a href="/productos/sistemas-ci/" class="hover:text-[#FF6B26]">Sistemas contra incendio</a></li><li aria-hidden="true">/</li><li><span style="color:#94A3B8" aria-current="page">Alarma contra incendio</span></li></ol></div></nav>

  <section class="relative overflow-hidden" style="background:#040A12;padding-block:5rem"><div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" style="background:radial-gradient(ellipse 80% 70% at 90% 30%,rgba(96,165,250,0.08) 0%,transparent 65%)" aria-hidden="true"></div><div class="container-site relative z-10"><div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"><div><span class="section-eyebrow mb-5 inline-flex">Detección y alarma de incendio · NFPA 72</span><h1 class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2.5rem,5.5vw,4.5rem);line-height:.95">Alarma contra incendio<br/><span style="color:#60A5FA">detección y alarma NFPA 72.</span></h1><p class="text-base leading-relaxed mb-8 max-w-xl" style="color:#94A3B8">Un sistema de alarma contra incendio detecta el fuego en su etapa inicial y avisa a los ocupantes antes de que el humo bloquee las rutas de evacuación. Se diseña conforme a la NFPA 72 y, en México, forma parte de las condiciones de seguridad que la NOM-002-STPS-2010 exige a los centros de trabajo; en los de riesgo alto, la alarma de incendio es obligatoria.</p><div class="flex flex-col sm:flex-row gap-3"><a href="/cotizacion/" class="btn btn-primary btn-lg">Cotizar alarma contra incendio</a><a href={whatsappUrl('Hola, quiero cotizar un sistema de alarma contra incendio.')} target="_blank" rel="noopener" class="btn btn-ghost btn-lg">WhatsApp {CANAL_CONTACTO}</a></div></div><div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,.1)"><p class="text-sm leading-[1.9] m-0" style="color:#94A3B8">Suministramos el sistema de detección y alarma de incendios completo: panel de control, detectores de humo y de calor, estaciones manuales, sirenas con estrobo y módulos de supervisión, con marcas Honeywell Notifier y System Sensor. Diseñamos la ubicación de cada dispositivo según el plano y el tipo de riesgo, instalamos y entregamos la documentación para Protección Civil.</p></div></div></div></section>
  <QuickLinksBar />

  <section class="section" style="background:#070E1A" aria-labelledby="funciona-title"><div class="container-site"><div class="section-head"><span class="section-eyebrow">Detección · control · notificación</span><h2 id="funciona-title">¿Cómo funciona una alarma contra incendio?</h2></div><p class="content-copy">Todo sistema de detección de incendios tiene tres partes que trabajan en secuencia:</p><div class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-8">{[['Iniciación','los detectores y las estaciones manuales identifican el incendio. Sus sensores están diseñados para detectar partículas de combustión, un aumento de temperatura o la radiación de la flama, y mandan la señal al panel.'],['Control','el panel de control de alarma de incendio (FACP) recibe la señal, identifica la zona o el dispositivo exacto, supervisa los dispositivos asociados y el cableado, registra averías y ejecuta la secuencia de salidas que se programa en la puesta en marcha.'],['Notificación','el panel emite la señal de alarma con sirenas y estrobos para alertar a los ocupantes e iniciar la evacuación; también puede enviar la señal a monitoreo, liberar puertas o activar un sistema de supresión.']].map(([title, text]) => <article class="p-6" style="background:#080F1A;border:1px solid rgba(74,117,153,.18)"><h3 class="font-display font-bold text-lg mb-3" style="color:#FFFFFF">{title}</h3><p class="text-sm leading-relaxed m-0" style="color:#94A3B8">{text}</p></article>)}</div><p class="content-copy mt-8">Si falla la energía eléctrica, las baterías de respaldo mantienen el sistema en reposo y le permiten sonar en caso de incendio, con la autonomía que exige la NFPA 72 para el tipo de sistema.</p></div></section>

  <section class="section" style="background:#040A12" aria-labelledby="sistemas-title"><div class="container-site"><div class="section-head"><span class="section-eyebrow">Selección según el inmueble</span><h2 id="sistemas-title">Tipos de sistemas de alarma contra incendios</h2></div><div class="overflow-x-auto"><table class="w-full text-left text-sm" style="border-collapse:collapse"><thead><tr style="background:#0C1825;color:#FFFFFF"><th class="p-4">Tipo</th><th class="p-4">Cómo identifica el evento</th><th class="p-4">Dónde conviene</th></tr></thead><tbody>{systemTypes.map(([type, event, place]) => <tr style="border-bottom:1px solid rgba(74,117,153,.18);color:#94A3B8"><td class="p-4 font-display font-bold" style="color:#FFFFFF">{type}</td><td class="p-4">{event}</td><td class="p-4">{place}</td></tr>)}</tbody></table></div></div></section>

  <section class="section" style="background:#070E1A" aria-labelledby="componentes-title"><div class="container-site"><div class="section-head"><span class="section-eyebrow">Paneles · detectores · notificación</span><h2 id="componentes-title">Componentes del sistema de detección y alarma</h2></div><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">{components.map((component) => <article class="flex flex-col overflow-hidden" style="background:#080F1A;border:1px solid rgba(74,117,153,.18)">{component.image ? <img src={component.image} alt={component.title} width="480" height="270" loading="lazy" decoding="async" class="w-full" style="aspect-ratio:16/9;object-fit:cover" /> : <div class="flex items-center justify-center" style="aspect-ratio:16/9;background:#060D18;border-bottom:1px solid rgba(74,117,153,.12)"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="rgba(74,117,153,.45)" stroke-width="1.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg></div>}<div class="p-5 flex flex-col flex-1"><span class="badge badge-dark text-[9px] self-start mb-3">{component.norm ?? 'Alarma contra incendio'}</span><h3 class="font-display font-bold text-base leading-snug mb-3" style="color:#FFFFFF">{component.title}</h3>{component.slug === 'estacion-manual' && <p class="text-sm leading-relaxed mt-0 mb-4" style="color:#94A3B8">{component.description}</p>}<a href={component.href} class="mt-auto text-sm font-bold hover:text-[#60A5FA]" style="color:#FFFFFF">{component.shortLabel} →</a></div></article>)}</div></div></section>

  <section class="section" style="background:#040A12" aria-labelledby="detectores-title"><div class="container-site"><div class="section-head"><span class="section-eyebrow">Detección según el riesgo</span><h2 id="detectores-title">Tipos de detectores de incendio</h2></div><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">{detectorTypes.map(([title, desc]) => <article class="p-6" style="background:#080F1A;border:1px solid rgba(74,117,153,.18)"><h3 class="font-display font-bold text-lg mb-3" style="color:#FFFFFF">{title}</h3><p class="text-sm leading-relaxed m-0" style="color:#94A3B8">{desc}</p></article>)}</div></div></section>

  <section class="section" style="background:#070E1A"><div class="container-site prose-block"><h2>¿Dónde se colocan las alarmas contra incendio?</h2><p>La ubicación y el espaciamiento de detectores, estaciones manuales y sirenas se calculan con la NFPA 72 según la altura del techo, la ventilación y el uso del área de la edificación. Como regla de diseño, las estaciones manuales se ubican junto a las salidas y en las rutas de evacuación, y las sirenas con estrobo deben escucharse y verse desde cualquier punto ocupado. Con el plano del inmueble entregamos la propuesta de distribución.</p><h2>Monitoreo y conexión con otros sistemas contra incendios</h2><p>El panel puede conectarse a una central de monitoreo, al sistema de rociadores —supervisión de válvulas y flujo con módulos monitor— y a la supresión con agentes limpios. En caso de incendio, la activación de la alarma puede cerrar puertas cortafuego, detener la ventilación y liberar el agente. El sistema de detección da la detección temprana; el extintor y el rociador son los que combaten el fuego.</p><h2>Kit de alarma o sistema diseñado</h2><p>Un kit de alarma genérico no considera la altura del techo, el uso del área ni el tipo de riesgo. Diseñamos cada sistema con equipos de fabricantes con listado UL y de las marcas más reconocidas del mercado, para garantizar que cada dispositivo quede donde la norma lo pide.</p></div></section>

  <section class="section" style="background:#040A12"><div class="container-site"><div class="section-head"><span class="section-eyebrow">Puesta en marcha y conservación</span><h2>Instalación, pruebas y mantenimiento</h2></div><ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4 list-none p-0 m-0">{steps.map((step, index) => <li class="p-5" style="background:#080F1A;border:1px solid rgba(74,117,153,.18)"><span class="font-display font-bold text-xl block mb-3" style="color:#60A5FA">0{index + 1}</span><p class="text-sm leading-relaxed m-0" style="color:#94A3B8">{step}</p></li>)}</ol></div></section>
  <section class="section-tight" style="background:#070E1A"><div class="container-site prose-block"><h2>Cómo evitar falsas alarmas</h2><p>Elegir el detector correcto para cada área (calor en cocinas, humo en oficinas), limpiar los detectores en el mantenimiento programado, supervisar las averías que reporta el panel y capacitar al personal para no activar las estaciones manuales por error.</p></div></section>

  <section class="section" style="background:#040A12" aria-labelledby="faq-title"><div class="container-site"><div class="section-head"><span class="section-eyebrow">Preguntas frecuentes</span><h2 id="faq-title">FAQ</h2></div><div class="grid gap-3">{faqs.map(([question, answer]) => <details class="p-5" style="background:#080F1A;border:1px solid rgba(74,117,153,.18)"><summary class="font-display font-bold cursor-pointer" style="color:#FFFFFF">{question}</summary><p class="text-sm leading-relaxed mt-4 mb-0" style="color:#94A3B8">{answer}</p></details>)}</div></div></section>

  <section class="section" style="background:#0C1825"><div class="container-site"><div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center"><div><span class="section-eyebrow mb-4 inline-flex">Propuesta por proyecto</span><h2 class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">¿Necesitas una alarma contra incendio para tu empresa?</h2></div><div><p class="text-sm leading-relaxed mb-6" style="color:#94A3B8">Envíanos el plano o las medidas del inmueble y te proponemos el sistema de detección y alarma con fichas técnicas.</p><div class="flex flex-col sm:flex-row gap-3"><a href="/cotizacion/" class="btn btn-primary btn-lg">Cotizar alarma contra incendio</a><a href={whatsappUrl('Hola, quiero cotizar un sistema de alarma contra incendio.')} target="_blank" rel="noopener" class="btn btn-ghost btn-lg">WhatsApp {CANAL_CONTACTO}</a></div></div></div></div></section>
  <section class="section-tight" style="background:#070E1A"><div class="container-site"><h2 class="font-display font-bold text-2xl mb-6" style="color:#FFFFFF">Productos relacionados</h2><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">{[['/productos/sistemas-ci/','Sistemas contra incendio'],['/productos/sistemas-ci/honeywell-notifier/','Honeywell Notifier'],['/servicios/instalacion-sistemas-ci/','Instalación de sistemas contra incendio'],['/blog/deteccion-alarma-supresion-nfpa-72-2001/','Detección, alarma y supresión']].map(([href, label]) => <a href={href} class="p-5 font-display font-bold hover:text-[#60A5FA]" style="color:#FFFFFF;background:#080F1A;border:1px solid rgba(74,117,153,.18)">{label} →</a>)}</div></div></section>
</BaseLayout>

<style>
  .section-head { display:grid; grid-template-columns:1fr; gap:1rem; margin-bottom:2.5rem; }
  .section-head h2, .prose-block h2 { color:#fff; font-family:var(--font-display); font-size:clamp(1.8rem,3.5vw,2.75rem); font-weight:700; line-height:1.08; margin:0; }
  .content-copy, .prose-block p { color:#94A3B8; font-size:.95rem; line-height:1.8; max-width:65rem; }
  .prose-block { display:grid; gap:1rem; max-width:70rem; }
  .prose-block h2:not(:first-child) { margin-top:2.25rem; }
</style>
