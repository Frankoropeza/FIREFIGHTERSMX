---
import EditorialCategoryHub from '@components/products/EditorialCategoryHub.astro';
const page = {
  slug:'herramientas-rescate', breadcrumb:'Herramientas de rescate vehicular', title:'Herramientas Hidráulicas de Rescate Vehicular | México',
  description:'Guía de herramientas hidráulicas de rescate vehicular y extricación en México: cizallas, separadores, equipos para bomberos, NFPA 1936 y empresas nacionales.',
  eyebrow:'Guía editorial · Extricación y rescate', h1:'Herramientas de rescate', h1Accent:'vehicular en México', accent:'#F75000',
  image:'/images/categorias/herramientas-rescate.avif', imageAlt:'Herramienta hidráulica de rescate vehicular de referencia',
  intro:['Las herramientas de rescate vehicular forman un sistema para cortar, separar, empujar, estabilizar y crear acceso. Esta guía ayuda a comparar equipo de extricación, fuentes de energía y soporte.','El desempeño depende de la herramienta, accesorios, técnica y escenario. Confirma datos del modelo, clasificación, capacitación y mantenimiento directamente con la empresa o fabricante.'],
  badges:['Cizallas','Separadores','Arietes','Combinadas','Batería','Estabilización'],
  typesHeading:'Herramientas y equipos de extricación vehicular.', compareHeading:'Cómo comparar herramientas hidráulicas de rescate.', standardsHeading:'NFPA y clasificación del equipo de rescate vehicular.',
  types:[
    {title:'Cizallas de rescate',eyebrow:'Corte',text:'Una cizalla hidráulica se compara por geometría, apertura, fuerza de corte, clasificación, peso y comportamiento con acero de alta y ultra alta resistencia (UHSS) de vehículos modernos.'},
    {title:'Separadores',eyebrow:'Apertura y tracción',text:'Permiten separar estructuras y, con accesorios previstos, realizar determinadas maniobras de tracción. Evalúa recorrido, fuerza, control y estabilidad.'},
    {title:'Arietes',eyebrow:'Empuje',text:'Ofrecen extensión para desplazar componentes o crear espacio. Compara longitud cerrada, carrera, etapas, puntos de apoyo y control bajo carga.'},
    {title:'Herramientas combinadas',eyebrow:'Versatilidad',text:'Una herramienta combinada integra corte y separación para despliegues donde importa reducir equipo. Su versatilidad debe compararse con capacidad, ergonomía y necesidades reales.'},
  ],
  compare:['Define vehículos, estructuras, materiales, personas atrapadas y operaciones de rescate previstas.','Compara la clasificación completa, no solo una cifra de fuerza.','Evalúa peso, balance, apertura, velocidad, ruido y operación con el EPP adecuado.','Decide entre sistema hidráulico con mangueras y unidad de potencia, herramienta a batería o sistema híbrido según logística.','Incluye herramientas manuales, estabilización, accesorios, baterías, cargadores, capacitación y mantenimiento.'],
  documentation:['Ficha técnica y clasificación del modelo.','Manual de operación y límites de uso.','Documento de certificación o ensayo solicitado.','Lista de baterías, mangueras, accesorios y fluidos compatibles.','Plan de inspección, mantenimiento, registro y servicio.'],
  standards:[
    {title:'NFPA 1936',text:'La edición 2020 trata herramientas de rescate, incluidas herramientas motorizadas y bolsas de elevación. Verifica clasificación y modelo.'},
    {title:'NFPA 1930',text:'La edición 2025 reúne requisitos sobre uso de varias herramientas y equipos del servicio de bomberos, incluidas herramientas de rescate.'},
    {title:'EN 13204',text:'Puede aparecer como referencia para herramientas de rescate de doble acción. Comprueba versión, clasificación y reporte aplicable.'},
  ],
  maintenanceTitle:'Disponibilidad operativa del sistema de rescate.',
  maintenance:[{title:'Revisión posterior al uso',text:'Inspecciona cuchillas, brazos, puntas, mangueras, conexiones, batería y carcasa; registra daños y comportamiento.'},{title:'Pruebas y mantenimiento',text:'Sigue intervalos y procedimientos del fabricante para verificar función, fugas, batería, calibración y piezas de desgaste.'},{title:'Entrenamiento',text:'Documenta prácticas con escenarios y materiales representativos, control de energía, estabilización y coordinación del equipo.'}],
  quoteData:['Escenarios y tipos de vehículos.','Herramientas y cantidades requeridas.','Fuente de energía y ecosistema de baterías.','Apertura, carrera y clasificación solicitadas.','Accesorios y estabilización.','Capacitación, garantía, repuestos y mantenimiento.'],
  faqs:[
    {q:'¿Qué herramientas se usan en rescate vehicular?',a:'Son comunes cizallas, separadores, arietes, herramientas combinadas y sistemas de estabilización. La dotación depende de escenarios, vehículos, personal y procedimientos.'},
    {q:'¿Batería o unidad hidráulica con mangueras?',a:'Ambas soluciones tienen ventajas operativas. Compara autonomía, peso, despliegue, mantenimiento, redundancia, temperatura, recarga y compatibilidad con el parque existente.'},
    {q:'¿Cómo comparar la fuerza de una herramienta?',a:'Revisa clasificación, geometría, recorrido y desempeño completo. Una cifra máxima sin método de ensayo ni contexto puede conducir a comparaciones incorrectas.'},
    {q:'¿La certificación sustituye la capacitación?',a:'No. El equipo requiere procedimientos, estabilización, control de peligros y práctica. La norma del producto no acredita por sí sola la competencia del operador.'},
    {q:'¿Qué debe incluir una cotización?',a:'Modelos, clasificaciones, fuente de energía, accesorios, baterías, cargadores, garantía, capacitación, mantenimiento, repuestos y tiempos que la empresa pueda confirmar.'},
  ],
  related:[{label:'Empresas de equipo para bomberos',href:'/empresas/venta-equipo/',text:'Directorio nacional por estado.'},{label:'Equipos SCBA',href:'/productos/equipos-scba/',text:'Protección respiratoria para rescate.'},{label:'Cámaras térmicas',href:'/productos/camaras-termicas/',text:'Imagen térmica para búsqueda.'},{label:'Guía para cotizar',href:'/cotizacion/',text:'Datos para comparar propuestas.'}],
  sources:[{label:'NFPA 1936 — edición 2020',href:'https://link.nfpa.org/all-publications/1936/2020'},{label:'NFPA 1930 — edición 2025',href:'https://link.nfpa.org/all-publications/1930/2025'}],
  directoryHref:'/empresas/venta-equipo/', directoryLabel:'Buscar empresas de equipo',
};
---
<EditorialCategoryHub {...page} />
