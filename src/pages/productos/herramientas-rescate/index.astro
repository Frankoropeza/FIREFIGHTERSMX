---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import ProductCard from '@components/products/ProductCard.astro';
import { categories } from '@data/categories';
import { featuredProducts } from '@data/products';
import { SITE, whatsappUrl } from '@config/site';

const cat = categories.find((c) => c.slug === 'herramientas-rescate')!;
const canonicalURL = `${SITE.url}/productos/herramientas-rescate/`;

const seoMeta = {
  title: `Herramientas de Rescate NFPA 1936 — Holmatro, Hurst y Weber Rescue · México`,
  description: cat.description,
  canonicalURL,
};

/* Productos por marca */
const holmatroProducts = featuredProducts.filter(
  (p) => p.category === 'Herramientas Rescate' && p.brand === 'Holmatro' && p.specs
);
const hurstProducts = featuredProducts.filter(
  (p) => p.category === 'Herramientas Rescate' && p.brand === 'Hurst' && p.specs
);
const weberProducts = featuredProducts.filter(
  (p) => p.category === 'Herramientas Rescate' && p.brand === 'Weber Rescue' && p.specs
);
const todosProductos = [...holmatroProducts, ...hurstProducts, ...weberProducts];

/* Familias de herramientas (educativo) */
const familias = [
  {
    title: 'Cizallas',
    badge: 'NFPA 1936 · EN 13204',
    accent: '#F75000',
    desc: 'Cortan postes B reforzados, pedales y estructuras de acero al boro de los vehículos modernos. Fuerza de corte hasta ~1,400 kN. La herramienta principal de toda escena de excarcelación.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 7H9.5a2 2 0 0 0 0 4H14"/><path d="M20 17H9.5a2 2 0 0 1 0-4H14"/><path d="M4 7l4 5-4 5"/></svg>`,
  },
  {
    title: 'Separadores',
    badge: 'NFPA 1936 · Apertura',
    accent: '#F5A623',
    desc: 'Abren puertas, desplazan tableros y crean espacio en el habitáculo. Gran apertura de brazos y puntas de retención de carga para tracción y levantamiento. Fuerza hasta ~67 kN.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12H3M21 12h-2M8.5 12a3.5 3.5 0 0 1 7 0"/><path d="M12 5v2M12 17v2M7.05 7.05l1.41 1.41M15.54 15.54l1.41 1.41M7.05 16.95l1.41-1.41M15.54 8.46l1.41-1.41"/></svg>`,
  },
  {
    title: 'Herramientas Combinadas',
    badge: 'NFPA 1936 · 2 en 1',
    accent: '#34D399',
    desc: 'Cortan y separan con una sola herramienta. La solución compacta del primer respondiente: capacidad de excarcelación completa sin cargar dos equipos. Ideal para unidades ligeras.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
  },
  {
    title: 'Arietes Telescópicos',
    badge: 'NFPA 1936 · Empuje',
    accent: '#60A5FA',
    desc: 'Empuje de tablero, desplazamiento de cargas y estabilización de vehículos. Alta fuerza en línea recta (~135 kN) con carrera telescópica larga. Imprescindible en rescate estructural y USAR.',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 12h14M15 8l4 4-4 4"/><path d="M3 8v8"/></svg>`,
  },
];

/* Trust Pillars */
const razones = [
  {
    n: '01',
    t: 'Tres marcas tier-1 mundiales',
    d: 'Holmatro (Pentheon · batería), Hurst Jaws of Life® (eDRAULIC) y Weber Rescue (E-FORCE) — las tres referencias internacionales en herramientas de rescate vehicular a batería, con un solo proveedor en México.',
  },
  {
    n: '02',
    t: 'Certificación NFPA 1936 + EN 13204',
    d: 'Cada herramienta incluye la ficha con la clasificación de corte EN 13204 verificable — el dato que define si la cizalla corta los aceros al boro de los vehículos modernos. Documentación lista para licitación.',
  },
  {
    n: '03',
    t: 'Demostración en sitio con escenarios reales',
    d: 'Cada venta institucional incluye demostración en tu estación con escenarios de excarcelación reales. Tu equipo opera el equipo antes de la decisión de compra — sin costo adicional.',
  },
  {
    n: '04',
    t: 'Servicio y mantenimiento certificado',
    d: 'Mantenimiento preventivo anual con refacciones originales para conservar la certificación NFPA 1936 y EN 13204 del equipo. Soporte técnico en los 32 estados con bitácora para auditoría.',
  },
];

/* Tabla comparativa de familias */
const comparativa = [
  ['Función principal', 'Corte de estructuras', 'Apertura y desplazamiento', 'Corte + separación', 'Empuje lineal'],
  ['Fuerza de referencia', '~1,400 kN de corte', '~67 kN de apertura', 'Corte + sep. combinados', '~135 kN de empuje'],
  ['Rango / carrera', 'Boca ~200 mm', 'Apertura ~850 mm', 'Apertura ~360 mm', 'Carrera ~700 mm'],
  ['Fuente de poder', 'Batería autocontenida', 'Batería autocontenida', 'Batería autocontenida', 'Batería autocontenida'],
  ['Escenario ideal', 'Excarcelación · aceros duros', 'Crear acceso · tablero', 'Primer respondiente', 'Rescate estructural · USAR'],
  ['Norma', 'NFPA 1936 + EN 13204', 'NFPA 1936 + EN 13204', 'NFPA 1936 + EN 13204', 'NFPA 1936 + EN 13204'],
];

/* Guía de selección */
const guia = [
  { n: '01', t: 'Define la misión dominante: excarcelación vehicular → cizalla + separador + ariete; primer respondiente o unidad ligera → combinada; rescate técnico/USAR → ariete + separador.' },
  { n: '02', t: 'Elige la tecnología: la línea a batería (Pentheon, eDRAULIC, E-FORCE) es hoy el estándar — sin mangueras, sin unidad de poder, despliegue en segundos y movilidad total en la escena.' },
  { n: '03', t: 'Dimensiona por los vehículos de tu zona: los autos modernos con acero al boro y postes B reforzados exigen clasificación de corte alta (EN 13204). Verifica la categoría de la cizalla antes de especificar.' },
  { n: '04', t: 'Incluye demostración, capacitación y plan de mantenimiento: la herramienta de rescate debe entrenarse y mantenerse. La certificación NFPA 1936 / EN 13204 depende de ello.' },
];

/* Blog */
const articulos = [
  { label: 'NFPA 1936 vs EN 13204', desc: 'Qué miden y por qué importan en licitación', href: '/blog/nfpa-1936-en-13204-herramientas-rescate' },
  { label: 'Aceros al boro: el reto del rescatista', desc: 'Por qué los autos modernos son más difíciles de abrir', href: '/blog/aceros-boro-vehiculos-modernos-excarcelacion' },
  { label: 'Batería vs unidad de poder', desc: 'Cuándo elegir cada sistema', href: '/blog/herramientas-rescate-bateria-vs-unidad-poder' },
  { label: 'Equipar un equipo de excarcelación', desc: 'Qué herramientas, cuántas y por qué', href: '/blog/equipar-equipo-excarcelacion-vehicular-bomberos' },
];

/* FAQ */
const faqs = [
  {
    q: '¿Qué norma certifica una herramienta hidráulica de rescate en México?',
    a: 'En el mercado mexicano se referencian la NFPA 1936 (estándar de la NFPA para herramientas de rescate motorizadas) y la EN 13204 (norma europea que clasifica la capacidad de corte por categorías). La clasificación EN 13204 es clave: define qué tan duros son los aceros que una cizalla puede cortar. Las herramientas que distribuimos cumplen ambas; te entregamos la ficha con la clasificación exacta por modelo para licitación.',
  },
  {
    q: '¿Batería (Pentheon / eDRAULIC / E-FORCE) o sistema con unidad de poder y mangueras?',
    a: 'La línea a batería es hoy el estándar: autocontenida, sin mangueras ni bomba, se despliega en segundos y el operador se mueve libremente alrededor del vehículo. Es la opción preferida para la mayoría de los cuerpos. El sistema con unidad de poder sigue teniendo sentido para operación muy intensiva con varias herramientas simultáneas desde una sola bomba. Te asesoramos según tu volumen de operación.',
  },
  {
    q: '¿Las cizallas cortan los aceros al boro de los vehículos modernos?',
    a: 'Sí, siempre que tengan la clasificación de corte adecuada. Los vehículos recientes usan aceros al boro y de alta resistencia en postes B y zonas de seguridad que atascan a las herramientas antiguas. Las cizallas Holmatro Pentheon, Hurst eDRAULIC y Weber E-FORCE tienen hojas y geometría diseñadas para estos materiales, con clasificación EN 13204 alta. Dimensionamos la cizalla según los modelos de vehículo más frecuentes en tu zona.',
  },
  {
    q: '¿Qué diferencia a Holmatro, Hurst y Weber Rescue?',
    a: 'Las tres son marcas tier-1 con líneas a batería certificadas NFPA 1936 / EN 13204. Holmatro destaca por la línea Pentheon y el sistema Combi-Tool de cambio rápido. Hurst inventó el Jaws of Life® en 1972 y su línea eDRAULIC es la más reconocida mundialmente. Weber Rescue sobresale por la relación peso-potencia y la maniobrabilidad de la línea E-FORCE. La elección depende de preferencia operativa y ecosistema de baterías. Te facilitamos las tres fichas y, cuando es posible, demostración comparativa.',
  },
  {
    q: '¿Incluyen demostración, capacitación y mantenimiento para licitación pública?',
    a: 'Sí. Cada venta institucional incluye demostración en sitio con escenarios reales, capacitación básica de operación y mantenimiento preventivo anual con refacciones originales. Para concursos públicos (CompraNet, IMSS, gobiernos estatales) generamos el manifiesto de cumplimiento NFPA 1936 / EN 13204 por partida, con la clasificación de corte verificable y el plan de servicio para la vida útil del equipo.',
  },
];

/* JSON-LD */
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Productos', item: `${SITE.url}/productos` },
    { '@type': 'ListItem', position: 3, name: 'Herramientas de Rescate', item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: 'Herramientas de Rescate certificadas NFPA 1936 — México',
  description: cat.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: todosProductos.length,
    itemListElement: todosProductos.map((p, i) => ({
      '@type': 'ListItem', position: i + 1, name: p.title, url: `${SITE.url}${p.href}`,
    })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const otrasCategorias = categories.filter((c) => c.slug !== 'herramientas-rescate').slice(0, 6);
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema, faqSchema]}>

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0 flex-wrap" style="color:#4A7599">
        <li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/productos" class="hover:text-[#FF6B26]">Productos</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:#94A3B8" aria-current="page">Herramientas de Rescate</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background:#040A12;padding-block:5rem">
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" style="background:radial-gradient(ellipse 80% 70% at 90% 30%, rgba(247,80,0,0.08) 0%, transparent 65%)" aria-hidden="true"></div>

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="section-eyebrow mb-5 inline-flex">{cat.norm} · Holmatro · Hurst · Weber Rescue · Distribuidor Autorizado MX</span>
          <h1 class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2.5rem,5.5vw,4.5rem);line-height:0.95">
            Herramientas<br/>
            <span style="color:#F75000">de Rescate.</span>
          </h1>
          <p class="text-sm leading-relaxed mb-8" style="color:#94A3B8">
            Distribuidor autorizado de Holmatro, Hurst Jaws of Life® y Weber Rescue en México.
            Líneas a batería sin mangueras, clasificación EN 13204 verificable y demostración en sitio incluida.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href={whatsappUrl('Hola, quiero cotizar herramientas de rescate vehicular NFPA 1936.')} target="_blank" rel="noopener" class="btn btn-primary btn-lg">Cotizar por WhatsApp</a>
            <a href="/cotizacion" class="btn btn-ghost btn-lg">Cotización formal</a>
          </div>
        </div>
        <div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,0.1)">
          {cat.intro.map((p) => (
            <p class="text-sm leading-[1.9] mb-5" style="color:#94A3B8">{p}</p>
          ))}
          <div class="flex flex-wrap gap-2">
            {['NFPA 1936','EN 13204','Batería autocontenida','Aceros al boro','Cizalla · Separador · Combinada · Ariete','Holmatro · Hurst · Weber'].map(n => (
              <span class="badge badge-dark font-display text-[10px]">{n}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-px" style="background:linear-gradient(90deg, transparent, rgba(247,80,0,0.4) 30%, rgba(247,80,0,0.4) 70%, transparent)" aria-hidden="true"></div>
  </section>

  <!-- Accesos rápidos -->
  <QuickLinksBar />

  <!-- Trust Pillars -->
  <section class="section-tight" style="background:#070E1A" aria-label="Por qué distribuimos estas marcas">
    <div class="container-site">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px" style="border:1px solid rgba(74,117,153,0.18)">
        {razones.map((r, i) => (
          <div class="flex flex-col gap-3 p-6" style={`background:#080F1A;${i < 3 ? 'border-right:1px solid rgba(74,117,153,0.12)' : ''}`}>
            <span class="font-display font-bold text-2xl" style="color:#F75000">{r.n}</span>
            <h3 class="font-display font-bold text-sm uppercase tracking-wide" style="color:#FFFFFF">{r.t}</h3>
            <p class="text-xs leading-relaxed m-0" style="color:#64748B">{r.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Familias de herramientas -->
  <section class="section" style="background:#040A12" aria-labelledby="familias-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Cuatro herramientas, una misión</span>
          <h2 id="familias-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
            La herramienta correcta<br/>
            <span style="color:#F75000">para cada maniobra.</span>
          </h2>
        </div>
        <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed" style="color:#94A3B8">
            En excarcelación vehicular cada herramienta tiene una función específica. Un equipo bien
            dimensionado combina cizalla + separador + ariete para la escena completa; un cuerpo ligero
            puede empezar con la herramienta combinada. Asesoramos la configuración exacta según
            los vehículos y el volumen de operación de tu brigada.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {familias.map((f) => (
          <article class="flex flex-col gap-4 p-7" style="background:#080F1A;border:1px solid rgba(74,117,153,0.18)">
            <div class="flex items-center justify-center rounded-full" style={`width:52px;height:52px;background:${f.accent}1a;border:1.5px solid ${f.accent}59;color:${f.accent}`}>
              <span class="block" style="width:24px;height:24px" set:html={f.icon}/>
            </div>
            <div class="flex flex-col gap-1">
              <h3 class="font-display font-bold text-lg" style="color:#FFFFFF">{f.title}</h3>
              <span class="badge badge-dark text-[9px]">{f.badge}</span>
            </div>
            <p class="text-sm leading-relaxed m-0" style="color:#94A3B8">{f.desc}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Holmatro -->
  <section class="section" style="background:#070E1A" aria-labelledby="holmatro-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Holmatro · Ingeniería neerlandesa · Pentheon a batería</span>
          <h2 id="holmatro-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
            Herramientas Holmatro<br/>
            <span style="color:#F75000">certificadas NFPA 1936.</span>
          </h2>
        </div>
        <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed mb-4" style="color:#94A3B8">
            Holmatro es una de las referencias mundiales en herramientas hidráulicas de rescate.
            Su línea Pentheon es autocontenida a batería: sin mangueras ni unidad de poder,
            se despliega en segundos y el operador se mueve libremente alrededor del vehículo.
            Hojas y geometrías diseñadas para los aceros al boro y postes B de los vehículos modernos.
          </p>
          <div class="flex flex-wrap gap-2">
            {['NFPA 1936','EN 13204','Pentheon a batería','Sin mangueras','Combi-Tool','LED integrado','Distribuidor autorizado MX'].map(b => (
              <span class="badge badge-dark text-[9px]">{b}</span>
            ))}
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {holmatroProducts.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>

      <div class="mt-10 pt-8 flex flex-col sm:flex-row gap-4 items-start" style="border-top:1px solid rgba(74,117,153,0.15)">
        <div class="flex-1">
          <p class="text-sm leading-relaxed m-0" style="color:#64748B">
            ¿Quieres la comparativa técnica completa, la anatomía de la Pentheon y el FAQ de clasificación EN 13204?
            Accede al catálogo dedicado de la marca.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a href="/productos/herramientas-rescate/holmatro" class="btn btn-primary btn-lg">
            Catálogo Holmatro completo →
          </a>
          <a href={whatsappUrl('Hola, quiero cotizar herramientas de rescate Holmatro Pentheon NFPA 1936.')} target="_blank" rel="noopener" class="btn btn-ghost btn-lg">
            Cotizar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Hurst Jaws of Life -->
  <section class="section" style="background:#040A12" aria-labelledby="hurst-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Hurst · Inventor del Jaws of Life® · Desde 1972</span>
          <h2 id="hurst-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
            Hurst Jaws of Life®<br/>
            <span style="color:#F75000">eDRAULIC NFPA 1936.</span>
          </h2>
        </div>
        <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed mb-4" style="color:#94A3B8">
            Hurst inventó el Jaws of Life® en 1972 y define el rescate vehicular desde entonces.
            Su línea eDRAULIC es autocontenida a batería — sin mangueras ni bomba — y es la herramienta
            de excarcelación más reconocida del mundo, presente en miles de cuerpos de bomberos.
            La marca que los bomberos más conocen y en la que más confían.
          </p>
          <div class="flex flex-wrap gap-2">
            {['NFPA 1936','EN 13204','eDRAULIC batería','Jaws of Life®','Sin mangueras','Desde 1972','Distribuidor autorizado MX'].map(b => (
              <span class="badge badge-dark text-[9px]">{b}</span>
            ))}
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {hurstProducts.map((p) => (
          <ProductCard product={p} />
        ))}
      </div>

      <div class="mt-10 pt-8 flex flex-col sm:flex-row gap-4 items-start" style="border-top:1px solid rgba(74,117,153,0.15)">
        <div class="flex-1">
          <p class="text-sm leading-relaxed m-0" style="color:#64748B">
            ¿Tu brigada conoce el Jaws of Life® y quiere la tecnología a batería más moderna?
            El eDRAULIC es la evolución sin mangueras de la herramienta más famosa del rescate.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3 shrink-0">
          <a href="/productos/herramientas-rescate/hurst" class="btn btn-primary btn-lg">
            Catálogo Hurst completo →
          </a>
          <a href={whatsappUrl('Hola, quiero cotizar herramientas de rescate Hurst eDRAULIC Jaws of Life NFPA 1936.')} target="_blank" rel="noopener" class="btn btn-ghost btn-lg">
            Cotizar por WhatsApp
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Weber Rescue -->
  <section class="section" style="background:#070E1A" aria-labelledby="weber-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Weber Rescue · Ingeniería alemana · E-FORCE</span>
