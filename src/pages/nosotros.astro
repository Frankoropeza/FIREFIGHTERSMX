---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { SITE } from '@config/site';

const canonicalURL = `${SITE.url}/nosotros/`;
const seoMeta = {
  title: 'Metodología Editorial de FIREFIGHTERS MX | Directorio',
  description: 'Conoce cómo FIREFIGHTERS MX organiza, distingue y corrige información pública sobre empresas, productos y estaciones del sector contra incendio.',
  canonicalURL,
};

const proceso = [
  { n: '01', title: 'Recolección', text: 'Se parte de registros públicos, fuentes institucionales o información aportada por la entidad correspondiente.' },
  { n: '02', title: 'Normalización', text: 'Nombres, ubicaciones, giros y campos se estructuran para permitir búsqueda y navegación consistentes.' },
  { n: '03', title: 'Atribución', text: 'La ficha distingue información pública, datos confirmados y elementos que requieren verificación adicional.' },
  { n: '04', title: 'Publicación', text: 'El contenido se organiza por entidad, giro y municipio sin completar datos ausentes por inferencia.' },
  { n: '05', title: 'Corrección', text: 'Empresas y usuarios pueden aportar fuentes para revisar errores, actualizar datos o ampliar una ficha.' },
];

const principios = [
  { title: 'Sin datos fabricados', text: 'No se inventan teléfonos, direcciones, certificaciones, reseñas, clientes, años de experiencia ni relaciones con marcas.' },
  { title: 'Fuente antes que claim', text: 'Una afirmación específica debe poder atribuirse a una fuente pertinente y al sujeto correcto.' },
  { title: 'Directorio, no proveedor', text: 'FIREFIGHTERS MX organiza información; cada empresa responde por sus productos, servicios y condiciones.' },
  { title: 'Corrección abierta', text: 'La metodología contempla revisar registros cuando se presenta información comprobable.' },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'FIREFIGHTERS MX', item: `${SITE.url}/empresa/` },
    { '@type': 'ListItem', position: 3, name: 'Metodología editorial', item: canonicalURL },
  ],
};
const aboutSchema = {
  '@context': 'https://schema.org', '@type': 'AboutPage', '@id': `${canonicalURL}#methodology`,
  name: seoMeta.title, description: seoMeta.description, url: canonicalURL, inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` }, about: { '@id': `${SITE.url}/#organization` },
};
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, aboutSchema]}>
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb"><div class="container-site"><ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)"><li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li><li aria-hidden="true">/</li><li><a href="/empresa/" class="hover:text-[#FF6B26]">FIREFIGHTERS MX</a></li><li aria-hidden="true">/</li><li aria-current="page" style="color:#94A3B8">Metodología</li></ol></div></nav>

  <section class="relative overflow-hidden" style="background:#040A12;padding-block:5rem"><div class="container-site relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"><div><span class="section-eyebrow mb-5 inline-flex">Transparencia y datos</span><h1 class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2.4rem,5.5vw,4.4rem);line-height:0.95">Metodología del<br/><span style="color:#F75000">directorio nacional.</span></h1><div class="flex flex-col sm:flex-row gap-3"><a href="#proceso" class="btn btn-primary btn-lg">Conocer el proceso</a><a href="/contacto/" class="btn btn-ghost btn-lg">Solicitar una corrección</a></div></div><div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,0.1)"><p class="text-sm leading-[1.9] mb-5" style="color:#94A3B8">FIREFIGHTERS MX busca que la información del directorio sea útil, atribuible y corregible.</p><p class="text-sm leading-[1.9]" style="color:#64748B">La metodología separa los datos disponibles de cualquier interpretación comercial y evita presentar una ficha como certificación o recomendación de la empresa.</p></div></div></section>

  <QuickLinksBar />

  <section id="proceso" class="section" style="background:#070E1A" aria-labelledby="proceso-title"><div class="container-site"><div class="max-w-3xl mb-10"><span class="section-eyebrow mb-4 inline-flex">Ciclo editorial</span><h2 id="proceso-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.9rem,3.8vw,3rem);line-height:1.05">De la fuente a<br/><span style="color:#F75000">la ficha pública.</span></h2></div><ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 list-none m-0 p-0 gap-px" style="background:rgba(74,117,153,0.18);border:1px solid rgba(74,117,153,0.18)">{proceso.map((paso) => <li class="p-6" style="background:#080F1A"><span class="font-display font-bold text-2xl" style="color:#F75000">{paso.n}</span><h3 class="font-display font-bold text-base my-3" style="color:#FFFFFF">{paso.title}</h3><p class="text-xs leading-relaxed" style="color:#64748B">{paso.text}</p></li>)}</ol></div></section>

  <section class="section" style="background:#040A12" aria-labelledby="principios-title"><div class="container-site"><div class="max-w-3xl mb-10"><span class="section-eyebrow mb-4 inline-flex">Principios</span><h2 id="principios-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.9rem,3.8vw,3rem);line-height:1.05">Criterios que protegen<br/><span style="color:#F75000">la calidad del directorio.</span></h2></div><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px" style="background:rgba(74,117,153,0.18);border:1px solid rgba(74,117,153,0.18)">{principios.map((principio) => <article class="p-7" style="background:#080F1A"><h3 class="font-display font-bold text-lg mb-3" style="color:#FFFFFF">{principio.title}</h3><p class="text-xs leading-relaxed" style="color:#64748B">{principio.text}</p></article>)}</div></div></section>

  <section class="section" style="background:#070E1A" aria-labelledby="participar-title"><div class="container-site grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"><div><span class="section-eyebrow mb-4 inline-flex">Actualización</span><h2 id="participar-title" class="font-display font-bold mb-5" style="color:#FFFFFF;font-size:clamp(1.9rem,3.8vw,3rem);line-height:1.05">Cómo aportar información<br/><span style="color:#F75000">verificable.</span></h2><p class="text-sm leading-relaxed" style="color:#94A3B8">Indica la URL de la ficha, el dato que debe revisarse y una fuente pública o documento que permita comprobar el cambio. No envíes datos personales que no deban publicarse.</p></div><div class="flex flex-col gap-3"><a href="/empresas/registro/" class="btn btn-primary">Registrar o actualizar una empresa</a><a href="/contacto/" class="btn btn-outline">Reportar un problema del directorio</a></div></div></section>
</BaseLayout>
