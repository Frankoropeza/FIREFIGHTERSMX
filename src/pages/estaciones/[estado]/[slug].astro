/* ── Formato fecha verificación ── */
const meses = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
function fmtVerif(v?: string): string | null {
  if (!v) return null;
  const [y, m] = v.split('-');
  return m ? `${meses[parseInt(m, 10) - 1]} ${y}` : y;
}
