/* ── Servicios categorizados (prioridad excluyente: cada item va a una sola categoría) ── */
type CatServ = { titulo: string; color: string; items: string[] };
function categorizarServicios(servicios: string[]): CatServ[] {
  const matched = new Set<string>();
  function cat(titulo: string, color: string, regex: RegExp): CatServ {
    const items = servicios.filter(s => regex.test(s) && !matched.has(s));
    items.forEach(s => matched.add(s));
    return { titulo, color, items };
  }
  const grupos = [
    cat('Extinción de incendios',              '#EF4444', /incendio|extinc|fuego|pastizal|forestal|combusti/i),
    cat('Rescate y salvamento',                '#F75000', /rescate|salvam|vertical|confinado|atrapado|altura|extrication|minero|aeronáut/i),
    cat('Materiales peligrosos',               '#F59E0B', /hazmat|derrame|gas|quím|peligros|tóxico|enjambre/i),
    cat('Atención médica prehospitalaria',     '#34D399', /auxilio|médic|paramé|prehospital|atenc.*médic/i),
    cat('Protección civil y formación',        '#60A5FA', /evacuac|protección.?civil|formación|capacit|coord|escuela/i),
  ];
  const resto = servicios.filter(s => !matched.has(s));
  if (resto.length > 0) grupos.push({ titulo: 'Servicios adicionales', color: '#94A3B8', items: resto });
  return grupos.filter(g => g.items.length > 0);
}
const catServicios: CatServ[] = categorizarServicios(estacion.servicios);

