    { href: '/productos/sistemas-ci',          label: 'Sistemas CI Eléctricos',      norma: 'NFPA 1081',    desc: 'Sistemas de extinción para instalaciones de generación, transmisión y distribución eléctrica' },
    { href: '/productos/hazmat',               label: 'Equipo HAZMAT',               norma: 'NOM-005-STPS', desc: 'Protección ante fugas de SF6, aceite dieléctrico y otros fluidos peligrosos en CFE' },
    { href: '/productos/equipos-scba',         label: 'Equipos SCBA / ERA',          norma: 'NFPA 1981',    desc: 'Equipos de respiración autónoma para brigadas en subestaciones y plantas de generación' },
    { href: '/productos/extintores',           label: 'Extintores CO₂',              norma: 'NOM-154-SCFI', desc: 'Extintores sin residuos de CO₂ y Halotron para equipos eléctricos y electrónicos sensibles' },
  ],
  Aeropuerto: [
    { href: '/productos/sistemas-ci',          label: 'Sistemas ARFF / CI',          norma: 'NFPA 403',     desc: 'Vehículos y sistemas ARFF (Aircraft Rescue Fire Fighting) para aeropuertos categoría OACI' },
    { href: '/productos/hazmat',               label: 'Equipo HAZMAT ARFF',          norma: 'OACI A14',     desc: 'Equipos de contención y decontaminación para derrames de combustible de aviación' },
    { href: '/productos/equipos-scba',         label: 'Equipos SCBA / ERA',          norma: 'NFPA 1981',    desc: 'Aparatos de respiración para operaciones de rescate en cabina y extinción aeroportuaria' },
    { href: '/productos/camaras-termicas',     label: 'Cámaras Térmicas ARFF',       norma: 'NFPA 1801',    desc: 'Cámaras de imagen térmica para localización de puntos calientes en aeronaves y pistas' },
    { href: '/productos/extintores',           label: 'Extintores Aeroportuarios',   norma: 'NOM-154-SCFI', desc: 'Extintores de polvo BC, CO₂ y AFFF para instalaciones aeroportuarias' },
  ],
};
const equipoDescs: EquipoDesc[] = equipoDescByTipo[estacion.tipo] ?? equipoDescByTipo['Municipal'];

/* ── SEO ── */
const seoTitle = estacion.nombre.length <= 38
  ? `${estacion.nombre} — ${estacion.ciudad}`
  : estacion.nombre;
const seoDesc = (
  `${estacion.nombre}: corporación ${estacion.tipo.toLowerCase()} en ${estacion.ciudad}, ${estado.nombre}. ` +
  `${estacion.telefonoEmergencias ? `Emergencias ${estacion.telefonoEmergencias}. ` : ''}` +
  `Contacto, servicios y ubicación. Equipo NFPA certificado.`
).slice(0, 160);

/* ── Schemas ── */
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio',    item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Directorio',item: `${SITE.url}/estaciones` },
    { '@type': 'ListItem', position: 3, name: estado.nombre, item: `${SITE.url}/estaciones/${estado.slug}` },
    { '@type': 'ListItem', position: 4, name: estacion.nombre, item: canonicalURL },
  ],
};
const fireStationSchema = {
  '@context': 'https://schema.org',
  '@type': 'FireStation',
  '@id': `${canonicalURL}#firestation`,
  name: estacion.nombre,
  url: canonicalURL,
  ...(estacion.telefono || estacion.telefonoEmergencias
    ? { telephone: estacion.telefono ?? estacion.telefonoEmergencias }
    : {}),
  address: {
    '@type': 'PostalAddress',
    ...(estacion.direccion ? { streetAddress: estacion.direccion } : {}),
    addressLocality: estacion.ciudad,
    addressRegion: estado.nombre,
    addressCountry: 'MX',
  },
  ...(hasMap ? { geo: { '@type': 'GeoCoordinates', latitude: mapLat, longitude: mapLng } } : {}),
  areaServed: { '@type': 'AdministrativeArea', name: estacion.municipio },
  ...(estacion.sitioWeb ? { sameAs: [estacion.sitioWeb] } : {}),
};
const schemas = [breadcrumbSchema, fireStationSchema];

const waMsg = `Hola, necesito equipo certificado NFPA para ${estacion.nombre} en ${estacion.ciudad}, ${estado.nombre}. ¿Disponibilidad y tiempo de entrega?`;

/* ── SVG icons ── */
const pinIcon    = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`;
const phoneIcon  = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>`;
const checkIcon  = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 6L9 17l-5-5"/></svg>`;
const globeIcon  = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>`;
const mailIcon   = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`;
const arrowIcon  = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>`;
const articleIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`;
const shieldIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`;
const tagIcon    = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>`;
const mapPinIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`;
---

<BaseLayout title={seoTitle} description={seoDesc} canonicalURL={canonicalURL} schema={schemas}>

  {/* Leaflet CSS (solo si hay mapa) */}
  {hasMap && (
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
  )}

  {/* ── Breadcrumb ── */}
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0 flex-wrap" style="color:#4A7599">
        <li><a href="/" class="hover:text-[#FF6B26] transition-colors">Inicio</a></li>
        <li aria-hidden="true" class="opacity-40">/</li>
        <li><a href="/estaciones" class="hover:text-[#FF6B26] transition-colors">Directorio</a></li>
        <li aria-hidden="true" class="opacity-40">/</li>
        <li><a href={`/estaciones/${estado.slug}`} class="hover:text-[#FF6B26] transition-colors">{estado.nombre}</a></li>
        <li aria-hidden="true" class="opacity-40">/</li>
        <li><span style="color:#CBD5E1" aria-current="page">{estacion.nombre}</span></li>
      </ol>
    </div>
  </nav>

  {/* ── Hero 2 columnas (homologado con index) ── */}
  <section class="relative overflow-hidden" style="background:#040A12;padding-block:4rem 3.5rem" aria-labelledby="est-heading">
    {/* Glow naranja derecha */}
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
      style="background:radial-gradient(ellipse 55% 70% at 85% 50%, rgba(247,80,0,0.09) 0%, transparent 60%)"></div>
    {/* Separador vertical central */}
    <div class="absolute top-0 bottom-0 pointer-events-none hidden lg:block" aria-hidden="true"
      style="left:52%;width:1px;background:linear-gradient(to bottom,transparent 5%,rgba(74,117,153,0.18) 30%,rgba(74,117,153,0.18) 70%,transparent 95%)"></div>

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">

        {/* ── Columna izquierda: título + CTAs ── */}
        <div>
          {/* Badges */}
          <div class="flex flex-wrap items-center gap-2 mb-5">
            <span class="font-display font-bold text-[10px] uppercase tracking-wider px-2.5 py-1"
              style={`color:${cfg.color};background:${cfg.bgColor};border:1px solid ${cfg.color}40`}>{cfg.label}</span>
            {conf && (
              <span class="inline-flex items-center gap-1 font-display text-[10px] uppercase tracking-wider px-2.5 py-1"
                style={`color:${conf.color};background:${conf.bgColor};border:1px solid ${conf.color}40`}>
                <span class="w-2.5 h-2.5" set:html={checkIcon} aria-hidden="true"/>{conf.label}{verif ? ` · ${verif}` : ''}
              </span>
            )}
            {estacion.fundacion && (
              <span class="font-display text-[10px] uppercase tracking-wider px-2.5 py-1"
                style="color:#4A7599;border:1px solid rgba(74,117,153,0.3)">Desde {estacion.fundacion}</span>
            )}
            <span class="font-display text-[10px] uppercase tracking-wider px-2.5 py-1"
              style="color:#4A7599;border:1px solid rgba(74,117,153,0.3)">{estado.region}</span>
          </div>

          {/* H1 */}
          <h1 id="est-heading" class="font-display font-bold mb-4"
            style="color:#FFFFFF;font-size:clamp(1.6rem,3.2vw,2.75rem);line-height:1.06">
            {estacion.nombre}
          </h1>

          {/* Ubicación */}
          <p class="flex items-center gap-2 text-sm mb-5" style="color:#94A3B8">
            <span class="w-4 h-4 shrink-0" style="color:#FF6B26" set:html={pinIcon} aria-hidden="true"/>
            {estacion.ciudad}{estacion.municipio !== estacion.ciudad ? ` · Mpio. ${estacion.municipio}` : ''}, {estado.nombre}
          </p>

          {/* Stats operativos (cuando existen) */}
          {(estacion.elementos || estacion.estacionesFisicas || estacion.unidades) && (
            <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mb-6"
              style="border-left:3px solid #F75000;padding-left:0.875rem">
              {estacion.elementos && (
                <div class="flex items-baseline gap-1.5">
                  <span class="font-display font-bold text-2xl" style="color:#F75000">{estacion.elementos}</span>
                  <span class="text-xs" style="color:#64748B">elementos</span>
                </div>
              )}
              {estacion.estacionesFisicas && (
                <div class="flex items-baseline gap-1.5">
                  <span class="font-display font-bold text-2xl" style="color:#F75000">{estacion.estacionesFisicas}</span>
                  <span class="text-xs" style="color:#64748B">cuarteles</span>
                </div>
              )}
              {estacion.unidades && (
                <div class="flex items-baseline gap-1.5">
                  <span class="font-display font-bold text-2xl" style="color:#F75000">{estacion.unidades}</span>
                  <span class="text-xs" style="color:#64748B">vehículos</span>
                </div>
              )}
            </div>
          )}

          {/* CTAs */}
          <div class="flex flex-col sm:flex-row gap-3">
            <a href={whatsappUrl(waMsg)} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
              Cotizar equipo por WhatsApp
            </a>
            <a href={`/estaciones/${estado.slug}`} class="btn btn-ghost btn-lg">
              ← {estado.nombre}
            </a>
          </div>
        </div>

        {/* ── Columna derecha: descripción (2 párrafos) ── */}
        <div>
          {/* Eyebrow */}
          <div class="flex items-center gap-3 mb-5">
            <div class="w-8 h-px shrink-0" style="background:#F75000"></div>
            <span class="font-display font-bold text-[10px] uppercase tracking-widest" style="color:#F75000">
              Acerca de esta corporación
            </span>
          </div>

          {estacion.descripcion ? (
            <div class="flex flex-col gap-5">
              {estacion.descripcion.split('\n\n').slice(0, 2).map((parrafo, i) => (
                <p class="text-sm leading-[1.9] m-0" style={i === 0 ? 'color:#CBD5E1;font-weight:500' : 'color:#94A3B8'}>
                  {parrafo}
                </p>
              ))}
              {estacion.descripcion.split('\n\n').length > 2 && (
                <a href="#perfil" class="text-xs uppercase tracking-wider transition-colors hover:text-[#FF6B26]"
                  style="color:#4A7599">Leer más ↓</a>
              )}
            </div>
          ) : (
            /* Fallback: datos clave cuando no hay descripción */
            <div class="flex flex-col gap-4">
              <div class="grid grid-cols-2 gap-3">
                {[
                  { label: 'Tipo',       value: cfg.label },
                  { label: 'Ciudad',     value: estacion.ciudad },
                  { label: 'Estado',     value: estado.nombre },
                  ...(estacion.fundacion ? [{ label: 'Fundación', value: String(estacion.fundacion) }] : []),
                  { label: 'Emergencias', value: estacion.telefonoEmergencias ?? '911' },
                  { label: 'Municipio',  value: estacion.municipio },
                ].slice(0, 4).map(({ label, value }) => (
                  <div class="flex flex-col gap-1 p-3" style="background:#070E1A;border:1px solid rgba(74,117,153,0.15)">
                    <span class="text-[9px] uppercase tracking-widest" style="color:#4A7599">{label}</span>
                    <span class="text-sm font-medium" style="color:#CBD5E1">{value}</span>
                  </div>
                ))}
              </div>
              <p class="text-xs leading-relaxed m-0" style="color:#64748B">
                Corporación {cfg.label.toLowerCase()} con cobertura en {estacion.municipio}, {estado.nombre}.
                Datos de contacto y servicios disponibles en el directorio verificado.
              </p>
            </div>
          )}
        </div>

      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-px" aria-hidden="true"
      style="background:linear-gradient(90deg,transparent,rgba(247,80,0,0.35) 30%,rgba(247,80,0,0.35) 70%,transparent)"></div>
  </section>

  <QuickLinksBar />

  {/* ── Cuerpo principal ── */}
  <section class="section" style="background:#070E1A" aria-label="Información de la estación">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-10">

        {/* ══ Columna principal (2/3) ══ */}
        <div class="lg:col-span-2 flex flex-col gap-14">

          {/* ── §1 Perfil institucional ── */}
          <section aria-labelledby="perfil-h2">
            <div class="flex items-center gap-3 mb-6">
              <div class="w-1 h-6 shrink-0" style="background:#F75000;border-radius:2px"></div>
              <h2 id="perfil-h2" class="font-display font-bold m-0"
                style="color:#FFFFFF;font-size:clamp(1.1rem,2vw,1.35rem);letter-spacing:-0.01em">
                Perfil institucional
              </h2>
            </div>

            {estacion.descripcion && (
              <div class="flex flex-col gap-5 mb-8">
                {estacion.descripcion.split('\n\n').map((p, i) => (
                  <p class="text-sm leading-[1.95] m-0"
                    style={i === 0 ? 'color:#CBD5E1;font-weight:450' : 'color:#94A3B8'}>{p}</p>
                ))}
              </div>
            )}

            <h3 class="font-display font-bold text-xs uppercase tracking-widest mb-3 m-0" style="color:#4A7599">
              Ficha técnica institucional
            </h3>
            <div class="overflow-hidden" style="border:1px solid rgba(74,117,153,0.2)">
              <table class="w-full text-sm" style="border-collapse:collapse">
                <tbody>
                  {([
                    { campo: 'Denominación oficial',   valor: estacion.nombre },
                    { campo: 'Tipo de corporación',    valor: cfg.label },
                    { campo: 'Dependencia',            valor: estacion.operador ?? `Municipio de ${estacion.municipio}` },
                    { campo: 'Ciudad cabecera',        valor: estacion.ciudad },
                    { campo: 'Estado',                 valor: estado.nombre },
                    { campo: 'Región',                 valor: estado.region },
                    ...(estacion.fundacion ? [{ campo: 'Año de fundación', valor: String(estacion.fundacion) }] : []),
                    ...(estacion.elementos ? [{ campo: 'Personal activo',  valor: `${estacion.elementos} elementos` }] : []),
                    ...(estacion.estacionesFisicas ? [{ campo: 'Cuarteles operativos', valor: String(estacion.estacionesFisicas) }] : []),
                    ...(estacion.unidades ? [{ campo: 'Flota vehicular',   valor: `${estacion.unidades} vehículos` }] : []),
                    { campo: 'Número de emergencias',  valor: estacion.telefonoEmergencias ?? '911' },
                  ] as { campo: string; valor: string }[]).map(({ campo, valor }, i) => (
                    <tr style={`border-bottom:1px solid rgba(74,117,153,0.12);background:${i % 2 === 0 ? '#040A12' : '#060D16'}`}>
                      <td class="px-4 py-3 text-xs font-medium whitespace-nowrap" style="color:#4A7599;width:38%">{campo}</td>
                      <td class="px-4 py-3 text-sm" style="color:#CBD5E1">{valor}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>

          {/* ── §2 Capacidad operativa (condicional) ── */}
          {(estacion.elementos || estacion.estacionesFisicas || estacion.unidades) && (
            <section aria-labelledby="operativa-h2">
              <div class="flex items-center gap-3 mb-6">
                <div class="w-1 h-6 shrink-0" style="background:#F75000;border-radius:2px"></div>
                <h2 id="operativa-h2" class="font-display font-bold m-0"
                  style="color:#FFFFFF;font-size:clamp(1.1rem,2vw,1.35rem);letter-spacing:-0.01em">
                  Capacidad operativa
                </h2>
              </div>
              <div class={`grid gap-4 ${[estacion.elementos, estacion.estacionesFisicas, estacion.unidades].filter(Boolean).length === 1 ? 'grid-cols-1 max-w-xs' : [estacion.elementos, estacion.estacionesFisicas, estacion.unidades].filter(Boolean).length === 2 ? 'grid-cols-2' : 'grid-cols-2 sm:grid-cols-3'}`}>
                {estacion.elementos && (
                  <div class="p-5 flex flex-col gap-2" style="background:#040A12;border:1px solid rgba(74,117,153,0.18);border-top:3px solid #F75000">
                    <h3 class="font-display font-bold m-0 leading-none" style="color:#FFFFFF;font-size:2.5rem">{estacion.elementos}</h3>
                    <p class="text-xs uppercase tracking-wider m-0" style="color:#F75000">Personal activo</p>
                    <p class="text-[11px] leading-relaxed m-0" style="color:#64748B">Elementos en servicio activo incluyendo bomberos de carrera y personal operativo</p>
                  </div>
                )}
                {estacion.estacionesFisicas && (
                  <div class="p-5 flex flex-col gap-2" style="background:#040A12;border:1px solid rgba(74,117,153,0.18);border-top:3px solid #4A7599">
                    <h3 class="font-display font-bold m-0 leading-none" style="color:#FFFFFF;font-size:2.5rem">{estacion.estacionesFisicas}</h3>
                    <p class="text-xs uppercase tracking-wider m-0" style="color:#4A7599">Cuarteles</p>
                    <p class="text-[11px] leading-relaxed m-0" style="color:#64748B">Bases operativas que garantizan cobertura territorial en turnos de 24 horas</p>
                  </div>
                )}
                {estacion.unidades && (
                  <div class="p-5 flex flex-col gap-2" style="background:#040A12;border:1px solid rgba(74,117,153,0.18);border-top:3px solid #34D399">
                    <h3 class="font-display font-bold m-0 leading-none" style="color:#FFFFFF;font-size:2.5rem">{estacion.unidades}</h3>
                    <p class="text-xs uppercase tracking-wider m-0" style="color:#34D399">Vehículos</p>
                    <p class="text-[11px] leading-relaxed m-0" style="color:#64748B">Autobombas, escaleras, unidades de rescate y vehículos de apoyo logístico</p>
                  </div>
                )}
              </div>
            </section>
          )}

          {/* ── §3 Servicios de emergencia (categorizados) ── */}
          <section aria-labelledby="servicios-h2">
            <div class="flex items-center gap-3 mb-3">
              <div class="w-1 h-6 shrink-0" style="background:#F75000;border-radius:2px"></div>
              <h2 id="servicios-h2" class="font-display font-bold m-0"
                style="color:#FFFFFF;font-size:clamp(1.1rem,2vw,1.35rem);letter-spacing:-0.01em">
                Servicios de emergencia
              </h2>
            </div>
            <p class="text-sm mb-6 m-0 leading-relaxed" style="color:#94A3B8">
              Especialidades operativas de {estacion.nombre}, agrupadas por categoría conforme a los estándares NFPA y protocolos de protección civil aplicables.
            </p>
            <div class="flex flex-col gap-6">
              {catServicios.map((cat) => (
                <div>
                  <h3 class="font-display font-semibold text-sm mb-3 flex items-center gap-2 m-0"
                    style={`color:${cat.color}`}>
                    <span class="w-2 h-2 rounded-full shrink-0 inline-block" style={`background:${cat.color}`}></span>
                    {cat.titulo}
                  </h3>
                  <ul class="flex flex-col m-0 p-0 list-none" style="border:1px solid rgba(74,117,153,0.15)">
                    {cat.items.map((s, i) => (
                      <li class="flex items-start gap-3 px-4 py-3 text-sm"
                        style={`color:#CBD5E1;background:#040A12;${i > 0 ? 'border-top:1px solid rgba(74,117,153,0.1)' : ''}`}>
                        <span class="shrink-0 mt-1.5 w-1 h-1 rounded-full" style={`background:${cat.color}`}></span>
                        {s}
                      </li>
                    ))}
                  </ul>
