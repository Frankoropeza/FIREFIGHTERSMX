---
// /estaciones/[estado]/[slug].astro — Ficha L3 de estación v4
// ============================================================
// Sidebar enriquecido con interlinking: productos recomendados,
// estaciones hermanas, artículos técnicos y directorio regional.
// Hero mejorado con stats operativos. Secciones ancladas.
// ============================================================
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { estados, todasLasParejas, tipoConfig, confianzaConfig } from '@data/estaciones';
import { SITE, whatsappUrl } from '@data/site';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => {
  return todasLasParejas.map(({ estado, estacion }) => ({
    params: { estado: estado.slug, slug: estacion.slug },
    props: { estado, estacion },
  }));
}) satisfies GetStaticPaths;

const { estado, estacion } = Astro.props;
const cfg  = tipoConfig[estacion.tipo];
const conf = estacion.confianza ? confianzaConfig[estacion.confianza] : null;
const canonicalURL = `${SITE.url}/estaciones/${estado.slug}/${estacion.slug}`;

/* ── Coordenadas: acepta { lat, lng } y [lat, lng] ── */
const rawCoord = estacion.coordenadas as any;
const mapLat: number | null = rawCoord
  ? (Array.isArray(rawCoord) ? (rawCoord[0] ?? null) : (rawCoord.lat ?? null))
  : null;
const mapLng: number | null = rawCoord
  ? (Array.isArray(rawCoord) ? (rawCoord[1] ?? null) : (rawCoord.lng ?? null))
  : null;
const hasMap = mapLat != null && mapLng != null;

/* ── Hermanas del estado ── */
const todasHermanas  = estado.estaciones.filter((e) => e.slug !== estacion.slug);
const hermanasSidebar = todasHermanas.slice(0, 8);
const herManasGrid    = todasHermanas.slice(0, 6);

/* ── Estados de la misma región (interlinking regional) ── */
const estadosRegion = estados
  .filter((e) => e.region === estado.region && e.slug !== estado.slug)
  .slice(0, 5);

/* ── Formato fecha verificación ── */
const meses = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
function fmtVerif(v?: string): string | null {
  if (!v) return null;
  const [y, m] = v.split('-');
  return m ? `${meses[parseInt(m, 10) - 1]} ${y}` : y;
}
const verif = fmtVerif(estacion.verificadoEl);

/* ── Producto links según tipo de corporación ── */
type ProdLink = { href: string; label: string };
const prodMapByTipo: Record<string, ProdLink[]> = {
  Municipal: [
    { href: '/productos/cascos-nfpa',         label: 'Cascos NFPA 1971' },
    { href: '/productos/trajes-bombero',       label: 'Trajes Estructurales NFPA' },
    { href: '/productos/equipos-scba',         label: 'Equipos SCBA / ERAR' },
    { href: '/productos/herramientas-rescate', label: 'Herramientas de Rescate' },
    { href: '/productos/camaras-termicas',     label: 'Cámaras Térmicas NFPA' },
    { href: '/productos/extintores',           label: 'Extintores NOM-154' },
  ],
  Estatal: [
    { href: '/productos/cascos-nfpa',         label: 'Cascos NFPA 1971' },
    { href: '/productos/trajes-bombero',       label: 'Trajes Estructurales NFPA' },
    { href: '/productos/equipos-scba',         label: 'Equipos SCBA / ERAR' },
    { href: '/productos/herramientas-rescate', label: 'Herramientas de Rescate' },
    { href: '/productos/camaras-termicas',     label: 'Cámaras Térmicas NFPA' },
    { href: '/productos/extintores',           label: 'Extintores NOM-154' },
  ],
  Voluntarios: [
    { href: '/productos/cascos-nfpa',         label: 'Cascos NFPA 1971' },
    { href: '/productos/trajes-bombero',       label: 'Trajes Estructurales NFPA' },
    { href: '/productos/equipos-scba',         label: 'Equipos SCBA / ERAR' },
    { href: '/productos/extintores',           label: 'Extintores NOM-154' },
    { href: '/productos/herramientas-rescate', label: 'Herramientas de Rescate' },
  ],
  PEMEX: [
    { href: '/productos/sistemas-ci',          label: 'Sistemas Contraincendio' },
    { href: '/productos/hazmat',               label: 'Equipo HAZMAT / Derrames' },
    { href: '/productos/equipos-scba',         label: 'Equipos SCBA / ERA' },
    { href: '/productos/extintores',           label: 'Extintores Industriales' },
    { href: '/productos/camaras-termicas',     label: 'Cámaras de Detección' },
  ],
  Industrial: [
    { href: '/productos/sistemas-ci',          label: 'Sistemas Contraincendio' },
    { href: '/productos/hazmat',               label: 'Equipo HAZMAT / Derrames' },
    { href: '/productos/equipos-scba',         label: 'Equipos SCBA / ERA' },
    { href: '/productos/extintores',           label: 'Extintores Industriales' },
    { href: '/productos/camaras-termicas',     label: 'Cámaras de Detección' },
  ],
  CFE: [
    { href: '/productos/sistemas-ci',          label: 'Sistemas Contraincendio' },
    { href: '/productos/hazmat',               label: 'Equipo HAZMAT / Derrames' },
    { href: '/productos/equipos-scba',         label: 'Equipos SCBA / ERA' },
    { href: '/productos/extintores',           label: 'Extintores Industriales' },
  ],
  Aeropuerto: [
    { href: '/productos/sistemas-ci',          label: 'Sistemas ARFF / CI' },
    { href: '/productos/hazmat',               label: 'Equipo HAZMAT ARFF' },
    { href: '/productos/equipos-scba',         label: 'Equipos SCBA / ERA' },
    { href: '/productos/camaras-termicas',     label: 'Cámaras Térmicas ARFF' },
    { href: '/productos/extintores',           label: 'Extintores Aeroportuarios' },
  ],
};
const prodLinks = prodMapByTipo[estacion.tipo] ?? prodMapByTipo['Municipal'];

/* ── Blog posts por tipo ── */
type BlogLink = { href: string; label: string };
const blogMapByTipo: Record<string, BlogLink[]> = {
  Municipal: [
    { href: '/blog/como-equipar-estacion-bomberos-desde-cero',   label: 'Cómo equipar una estación desde cero' },
    { href: '/blog/cascos-bombero-comparativa-marcas-2026',       label: 'Comparativa de cascos NFPA 2026' },
    { href: '/blog/anatomia-traje-bombero-capas-materiales',      label: 'Anatomía del traje de bombero' },
  ],
  Estatal: [
    { href: '/blog/como-equipar-estacion-bomberos-desde-cero',   label: 'Cómo equipar una estación desde cero' },
    { href: '/blog/especificaciones-traje-bombero-licitaciones',  label: 'Especificaciones para licitaciones' },
    { href: '/blog/cascos-bombero-comparativa-marcas-2026',       label: 'Comparativa de cascos NFPA 2026' },
  ],
  Voluntarios: [
    { href: '/blog/como-equipar-estacion-bomberos-desde-cero',   label: 'Cómo equipar una estación desde cero' },
    { href: '/blog/cascos-bombero-comparativa-marcas-2026',       label: 'Comparativa de cascos NFPA 2026' },
    { href: '/blog/cilindros-scba-fibra-carbono-vs-acero',        label: 'Cilindros SCBA: fibra vs acero' },
  ],
  PEMEX: [
    { href: '/blog/epp-brigadista-contra-incendio-que-necesitas', label: 'EPP para brigadistas CI' },
    { href: '/blog/cuantos-brigadistas-nom-002-dimensionamiento', label: 'Cuántos brigadistas por NOM-002' },
    { href: '/blog/expediente-documental-nom-002-stps-checklist', label: 'Checklist NOM-002-STPS' },
  ],
  Industrial: [
    { href: '/blog/epp-brigadista-contra-incendio-que-necesitas', label: 'EPP para brigadistas CI' },
    { href: '/blog/cuantos-brigadistas-nom-002-dimensionamiento', label: 'Cuántos brigadistas por NOM-002' },
    { href: '/blog/expediente-documental-nom-002-stps-checklist', label: 'Checklist NOM-002-STPS' },
  ],
  CFE: [
    { href: '/blog/epp-brigadista-contra-incendio-que-necesitas', label: 'EPP para brigadistas CI' },
    { href: '/blog/cuantos-brigadistas-nom-002-dimensionamiento', label: 'Cuántos brigadistas por NOM-002' },
    { href: '/blog/deteccion-alarma-supresion-nfpa-72-2001',      label: 'Detección y alarma NFPA 72' },
  ],
  Aeropuerto: [
    { href: '/blog/epp-brigadista-contra-incendio-que-necesitas', label: 'EPP para bomberos ARFF' },
    { href: '/blog/cilindros-scba-fibra-carbono-vs-acero',        label: 'Cilindros SCBA: fibra vs acero' },
    { href: '/blog/compatibilidad-casco-scba-bomberos',           label: 'Compatibilidad casco + SCBA' },
  ],
};
const blogLinks = blogMapByTipo[estacion.tipo] ?? blogMapByTipo['Municipal'];

/* ── SEO ── */
const seoTitle = estacion.nombre.length <= 38
  ? `${estacion.nombre} — ${estacion.ciudad}`
  : estacion.nombre;
const seoDesc = (
  `${estacion.nombre}: corporación ${estacion.tipo.toLowerCase()} en ${estacion.ciudad}, ${estado.nombre}. ` +
  `${estacion.telefonoEmergencias ? `Emergencias ${estacion.telefonoEmergencias}. ` : ''}` +
  `Contacto, servicios y ubicación. Equipo NFPA certificado.`
).slice(0, 160);

/* ── Schemas ── */
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio',    item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Directorio',item: `${SITE.url}/estaciones` },
    { '@type': 'ListItem', position: 3, name: estado.nombre, item: `${SITE.url}/estaciones/${estado.slug}` },
    { '@type': 'ListItem', position: 4, name: estacion.nombre, item: canonicalURL },
  ],
};
const fireStationSchema = {
  '@context': 'https://schema.org',
  '@type': 'FireStation',
  '@id': `${canonicalURL}#firestation`,
  name: estacion.nombre,
  url: canonicalURL,
  ...(estacion.telefono || estacion.telefonoEmergencias
    ? { telephone: estacion.telefono ?? estacion.telefonoEmergencias }
    : {}),
  address: {
    '@type': 'PostalAddress',
    ...(estacion.direccion ? { streetAddress: estacion.direccion } : {}),
    addressLocality: estacion.ciudad,
    addressRegion: estado.nombre,
    addressCountry: 'MX',
  },
  ...(hasMap ? { geo: { '@type': 'GeoCoordinates', latitude: mapLat, longitude: mapLng } } : {}),
  areaServed: { '@type': 'AdministrativeArea', name: estacion.municipio },
  ...(estacion.sitioWeb ? { sameAs: [estacion.sitioWeb] } : {}),
};
const schemas = [breadcrumbSchema, fireStationSchema];

const waMsg = `Hola, necesito equipo certificado NFPA para ${estacion.nombre} en ${estacion.ciudad}, ${estado.nombre}. ¿Disponibilidad y tiempo de entrega?`;

/* ── SVG icons ── */
const pinIcon    = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`;
const phoneIcon  = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>`;
const checkIcon  = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 6L9 17l-5-5"/></svg>`;
const globeIcon  = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>`;
const mailIcon   = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>`;
const arrowIcon  = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>`;
const articleIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`;
const shieldIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>`;
const tagIcon    = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>`;
const mapPinIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`;
---

<BaseLayout title={seoTitle} description={seoDesc} canonicalURL={canonicalURL} schema={schemas}>

  {/* Leaflet CSS (solo si hay mapa) */}
  {hasMap && (
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
  )}

  {/* ── Breadcrumb ── */}
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0 flex-wrap" style="color:#4A7599">
        <li><a href="/" class="hover:text-[#FF6B26] transition-colors">Inicio</a></li>
        <li aria-hidden="true" class="opacity-40">/</li>
        <li><a href="/estaciones" class="hover:text-[#FF6B26] transition-colors">Directorio</a></li>
        <li aria-hidden="true" class="opacity-40">/</li>
        <li><a href={`/estaciones/${estado.slug}`} class="hover:text-[#FF6B26] transition-colors">{estado.nombre}</a></li>
        <li aria-hidden="true" class="opacity-40">/</li>
        <li><span style="color:#CBD5E1" aria-current="page">{estacion.nombre}</span></li>
      </ol>
    </div>
  </nav>

  {/* ── Hero ── */}
  <section class="relative overflow-hidden" style="background:#040A12;padding-block:4rem 3.5rem" aria-labelledby="est-heading">
    {/* Glow de fondo */}
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
      style="background:radial-gradient(ellipse 65% 55% at 80% 40%, rgba(247,80,0,0.08) 0%, transparent 60%)"></div>
    {/* Línea naranja vertical derecha */}
    <div class="absolute right-0 top-8 bottom-8 w-px opacity-30 pointer-events-none hidden lg:block" aria-hidden="true"
      style="background:linear-gradient(to bottom, transparent, #F75000, transparent)"></div>

    <div class="container-site relative z-10">
      {/* Badges */}
      <div class="flex flex-wrap items-center gap-2 mb-5">
        <span class="font-display font-bold text-[10px] uppercase tracking-wider px-2.5 py-1"
          style={`color:${cfg.color};background:${cfg.bgColor};border:1px solid ${cfg.color}40`}>{cfg.label}</span>
        {conf && (
          <span class="inline-flex items-center gap-1 font-display text-[10px] uppercase tracking-wider px-2.5 py-1"
            style={`color:${conf.color};background:${conf.bgColor};border:1px solid ${conf.color}40`}>
            <span class="w-2.5 h-2.5" set:html={checkIcon} aria-hidden="true"/>{conf.label}{verif ? ` · ${verif}` : ''}
          </span>
        )}
        {estacion.fundacion && (
          <span class="font-display text-[10px] uppercase tracking-wider px-2.5 py-1"
            style="color:#4A7599;border:1px solid rgba(74,117,153,0.3)">Desde {estacion.fundacion}</span>
        )}
        <span class="font-display text-[10px] uppercase tracking-wider px-2.5 py-1"
          style="color:#4A7599;border:1px solid rgba(74,117,153,0.3)">{estado.region}</span>
      </div>

      {/* H1 */}
      <h1 id="est-heading" class="font-display font-bold mb-4"
        style="color:#FFFFFF;font-size:clamp(1.75rem,3.5vw,3rem);line-height:1.06;max-width:42rem">
        {estacion.nombre}
      </h1>

      {/* Ubicación */}
      <p class="flex items-center gap-2 text-sm mb-4" style="color:#94A3B8">
        <span class="w-4 h-4 shrink-0" style="color:#FF6B26" set:html={pinIcon} aria-hidden="true"/>
        {estacion.ciudad}{estacion.municipio !== estacion.ciudad ? ` · Mpio. ${estacion.municipio}` : ''}, {estado.nombre}
      </p>

      {/* Stats operativos inline (cuando existen) */}
      {(estacion.elementos || estacion.estacionesFisicas || estacion.unidades) && (
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 mb-6" style="border-left:3px solid #F75000;padding-left:0.75rem">
          {estacion.elementos && (
            <div class="flex items-baseline gap-1.5">
              <span class="font-display font-bold text-xl" style="color:#F75000">{estacion.elementos}</span>
              <span class="text-xs" style="color:#64748B">elementos</span>
            </div>
          )}
          {estacion.estacionesFisicas && (
            <div class="flex items-baseline gap-1.5">
              <span class="font-display font-bold text-xl" style="color:#F75000">{estacion.estacionesFisicas}</span>
              <span class="text-xs" style="color:#64748B">cuarteles</span>
            </div>
          )}
          {estacion.unidades && (
            <div class="flex items-baseline gap-1.5">
              <span class="font-display font-bold text-xl" style="color:#F75000">{estacion.unidades}</span>
              <span class="text-xs" style="color:#64748B">vehículos</span>
            </div>
          )}
        </div>
      )}

      {/* CTAs */}
      <div class="flex flex-col sm:flex-row gap-3">
        <a href={whatsappUrl(waMsg)} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">
          Cotizar equipo por WhatsApp
        </a>
        <a href={`/estaciones/${estado.slug}`} class="btn btn-ghost btn-lg">
          ← {estado.nombre}
        </a>
      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-px" aria-hidden="true"
      style="background:linear-gradient(90deg,transparent,rgba(247,80,0,0.35) 30%,rgba(247,80,0,0.35) 70%,transparent)"></div>
  </section>

  <QuickLinksBar />

  {/* ── Cuerpo principal ── */}
  <section class="section" style="background:#070E1A" aria-label="Información de la estación">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-10">

        {/* ══ Columna principal (2/3) ══ */}
        <div class="lg:col-span-2 flex flex-col gap-10">

          {/* ── Perfil / Descripción ── */}
          {estacion.descripcion && (
            <div id="perfil">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-1 h-5 shrink-0" style="background:#F75000"></div>
                <span class="font-display font-bold text-xs uppercase tracking-widest" style="color:#F75000">Perfil</span>
              </div>
              <div class="flex flex-col gap-4">
                {estacion.descripcion.split('\n\n').map((parrafo) => (
                  <p class="text-sm leading-[1.95] m-0" style="color:#94A3B8">{parrafo}</p>
                ))}
              </div>
            </div>
          )}

          {/* ── Stats operativos (cards visuales cuando existen) ── */}
          {(estacion.elementos || estacion.estacionesFisicas || estacion.unidades) && (
            <div>
              <div class="flex items-center gap-3 mb-4">
                <div class="w-1 h-5 shrink-0" style="background:#F75000"></div>
                <span class="font-display font-bold text-xs uppercase tracking-widest" style="color:#F75000">Capacidad operativa</span>
              </div>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                {estacion.elementos && (
                  <div class="flex flex-col gap-1 p-4" style="background:#040A12;border:1px solid rgba(74,117,153,0.18);border-top:2px solid #F75000">
                    <span class="font-display font-bold text-3xl" style="color:#FFFFFF">{estacion.elementos}</span>
                    <span class="text-xs uppercase tracking-wider" style="color:#4A7599">Personal activo</span>
                  </div>
                )}
                {estacion.estacionesFisicas && (
                  <div class="flex flex-col gap-1 p-4" style="background:#040A12;border:1px solid rgba(74,117,153,0.18);border-top:2px solid #4A7599">
                    <span class="font-display font-bold text-3xl" style="color:#FFFFFF">{estacion.estacionesFisicas}</span>
                    <span class="text-xs uppercase tracking-wider" style="color:#4A7599">Cuarteles</span>
                  </div>
                )}
                {estacion.unidades && (
                  <div class="flex flex-col gap-1 p-4" style="background:#040A12;border:1px solid rgba(74,117,153,0.18);border-top:2px solid #34D399">
                    <span class="font-display font-bold text-3xl" style="color:#FFFFFF">{estacion.unidades}</span>
                    <span class="text-xs uppercase tracking-wider" style="color:#4A7599">Flota vehicular</span>
                  </div>
                )}
              </div>
            </div>
          )}

          {/* ── Servicios operativos ── */}
          <div id="servicios">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-1 h-5 shrink-0" style="background:#F75000"></div>
              <span class="font-display font-bold text-xs uppercase tracking-widest" style="color:#F75000">Servicios operativos</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2" style="border:1px solid rgba(74,117,153,0.18)">
              {estacion.servicios.map((s, i) => (
                <div class="flex items-start gap-3 p-4"
                  style={[
                    'background:#040A12',
                    'border-bottom:1px solid rgba(74,117,153,0.12)',
                    i % 2 === 0 ? 'border-right:1px solid rgba(74,117,153,0.12)' : '',
                  ].filter(Boolean).join(';')}>
                  <span class="shrink-0 font-display font-bold text-[11px] mt-0.5" style="color:#F75000;min-width:1.6rem">{String(i + 1).padStart(2, '0')}</span>
                  <span class="text-sm leading-snug" style="color:#CBD5E1">{s}</span>
                </div>
              ))}
            </div>
          </div>

          {/* ── Certificaciones ── */}
          {estacion.certificaciones && estacion.certificaciones.length > 0 && (
            <div id="certificaciones">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-1 h-5 shrink-0" style="background:#34D399"></div>
                <span class="font-display font-bold text-xs uppercase tracking-widest" style="color:#34D399">Certificaciones</span>
              </div>
              <div class="flex flex-wrap gap-2">
                {estacion.certificaciones.map((c) => (
                  <span class="inline-flex items-center gap-1.5 font-display text-[11px] uppercase tracking-wider px-3 py-1.5"
                    style="color:#34D399;background:rgba(52,211,153,0.08);border:1px solid rgba(52,211,153,0.25)">
                    <span class="w-3 h-3" set:html={checkIcon} aria-hidden="true"/>{c}
                  </span>
                ))}
              </div>
            </div>
          )}

          {/* ── Mapa de ubicación ── */}
          {hasMap && (
            <div id="ubicacion">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-1 h-5 shrink-0" style="background:#4A7599"></div>
                <span class="font-display font-bold text-xs uppercase tracking-widest" style="color:#4A7599">Ubicación</span>
              </div>
              <div class="overflow-hidden" style="border:1px solid rgba(74,117,153,0.25)">
                <div
                  id="estacion-map"
                  data-lat={mapLat}
                  data-lng={mapLng}
                  data-nombre={estacion.nombre}
                  style="height:360px;background:#0C1825"
                  role="img"
                  aria-label={`Mapa de ubicación de ${estacion.nombre}`}
                ></div>
              </div>
              {estacion.direccion && (
                <p class="text-xs mt-2 flex items-start gap-1.5" style="color:#4A7599">
                  <span class="w-3.5 h-3.5 shrink-0 mt-0.5" set:html={pinIcon} aria-hidden="true"/>
                  {estacion.direccion}
                </p>
              )}
              {!estacion.direccion && (
                <p class="text-[11px] mt-2" style="color:#4A7599">
                  Ubicación aproximada con fines de referencia. Coordenadas: {mapLat}, {mapLng}.
                </p>
              )}
            </div>
          )}

          {/* ── Fuentes oficiales ── */}
          {estacion.fuentes && estacion.fuentes.length > 0 && (
            <div id="fuentes">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-1 h-5 shrink-0" style="background:#4A7599"></div>
                <span class="font-display font-bold text-xs uppercase tracking-widest" style="color:#4A7599">Fuentes oficiales</span>
              </div>
              <div class="flex flex-col gap-2 p-4" style="background:#040A12;border:1px solid rgba(74,117,153,0.18)">
                {estacion.fuentes.map((f, i) => (
                  <div class="flex items-start gap-2.5">
                    <span class="font-display text-[10px] font-bold shrink-0 mt-1" style="color:#4A7599">{String(i + 1).padStart(2,'0')}</span>
                    <a href={f} target="_blank" rel="noopener noreferrer nofollow"
                      class="text-xs break-all transition-colors hover:text-[#FF6B26]" style="color:#4A7599">{f}</a>
                  </div>
                ))}
              </div>
            </div>
          )}

        </div>

        {/* ══ Sidebar (1/3) sticky ══ */}
        <aside class="lg:col-span-1">
          <div class="flex flex-col gap-5" style="position:sticky;top:1.5rem">

            {/* ── Bloque 1: Contacto ── */}
            <div style={`background:#040A12;border:1px solid rgba(74,117,153,0.2);border-top:2px solid ${cfg.color}`}>
              {/* Header */}
              <div class="px-5 pt-4 pb-3" style="border-bottom:1px solid rgba(74,117,153,0.12)">
                <div class="flex items-center justify-between">
                  <span class="font-display font-bold text-xs uppercase tracking-widest" style="color:#FFFFFF">Contacto</span>
                  {conf && (
                    <span class="inline-flex items-center gap-1 font-display text-[9px] uppercase tracking-wider px-1.5 py-0.5"
                      style={`color:${conf.color};background:${conf.bgColor};border:1px solid ${conf.color}30`}>
                      <span class="w-2 h-2" set:html={checkIcon} aria-hidden="true"/>{conf.label}
                    </span>
                  )}
                </div>
                {verif && <p class="text-[10px] mt-0.5 m-0" style="color:#4A7599">Actualizado {verif}</p>}
              </div>

              <div class="px-5 pt-4 pb-5 flex flex-col gap-4">
                {/* Emergencias */}
                {estacion.telefonoEmergencias && (
                  <div>
                    <div class="text-[9px] uppercase tracking-widest mb-1" style="color:#4A7599">Emergencias</div>
                    <a href={`tel:${estacion.telefonoEmergencias.replace(/[^0-9+]/g, '')}`}
                      class="font-display font-bold text-2xl transition-colors hover:text-[#ff8c5a]" style="color:#F75000">
                      {estacion.telefonoEmergencias}
                    </a>
                  </div>
                )}

                {/* Teléfono directo */}
                {estacion.telefono && (
                  <div class="flex items-start gap-2.5">
                    <span class="w-4 h-4 shrink-0 mt-0.5" style="color:#4A7599" set:html={phoneIcon} aria-hidden="true"/>
                    <div>
                      <div class="text-[9px] uppercase tracking-widest mb-0.5" style="color:#4A7599">Conmutador</div>
                      <a href={`tel:${estacion.telefono.replace(/[^0-9+]/g, '')}`}
                        class="text-sm transition-colors hover:text-[#FF6B26]" style="color:#CBD5E1">{estacion.telefono}</a>
                    </div>
                  </div>
                )}

                {/* Teléfonos adicionales */}
                {estacion.telefonosAdicionales && estacion.telefonosAdicionales.length > 0 && (
                  <div class="flex items-start gap-2.5">
                    <span class="w-4 h-4 shrink-0 mt-0.5" style="color:#4A7599" set:html={phoneIcon} aria-hidden="true"/>
                    <div>
                      <div class="text-[9px] uppercase tracking-widest mb-0.5" style="color:#4A7599">Otras líneas</div>
                      <div class="flex flex-col gap-0.5">
                        {estacion.telefonosAdicionales.map((t) => (
                          <a href={`tel:${t.replace(/[^0-9+]/g, '')}`}
                            class="text-sm transition-colors hover:text-[#FF6B26]" style="color:#CBD5E1">{t}</a>
                        ))}
                      </div>
                    </div>
                  </div>
                )}

                {/* Email */}
                {estacion.email && (
                  <div class="flex items-start gap-2.5">
                    <span class="w-4 h-4 shrink-0 mt-0.5" style="color:#4A7599" set:html={mailIcon} aria-hidden="true"/>
                    <div>
                      <div class="text-[9px] uppercase tracking-widest mb-0.5" style="color:#4A7599">Correo oficial</div>
                      <a href={`mailto:${estacion.email}`} class="text-xs break-all transition-colors hover:text-[#FF6B26]" style="color:#CBD5E1">{estacion.email}</a>
                    </div>
                  </div>
                )}

                {/* Sitio web */}
                {estacion.sitioWeb && (
                  <div class="flex items-start gap-2.5">
                    <span class="w-4 h-4 shrink-0 mt-0.5" style="color:#4A7599" set:html={globeIcon} aria-hidden="true"/>
                    <div>
                      <div class="text-[9px] uppercase tracking-widest mb-0.5" style="color:#4A7599">Sitio oficial</div>
                      <a href={estacion.sitioWeb} target="_blank" rel="noopener noreferrer"
                        class="text-xs break-all transition-colors hover:text-[#FF6B26]" style="color:#CBD5E1">
                        {estacion.sitioWeb.replace(/^https?:\/\//, '').replace(/\/$/, '')}
                      </a>
                    </div>
                  </div>
                )}

                {/* Jurisdicción + operador */}
                <div class="pt-3" style="border-top:1px solid rgba(74,117,153,0.12)">
                  <div class="text-[9px] uppercase tracking-widest mb-1" style="color:#4A7599">Jurisdicción</div>
                  <p class="text-xs m-0" style="color:#94A3B8">
                    <span style={`color:${cfg.color}`}>{cfg.label}</span>
                    {' · '}{estacion.municipio}, {estado.nombre}
                  </p>
                  {estacion.operador && (
                    <p class="text-[11px] m-0 mt-1" style="color:#64748B">Operador: {estacion.operador}</p>
                  )}
                </div>

                {/* Capacidad (mini) si NO hay descripción larga que la muestre */}
                {(estacion.elementos || estacion.estacionesFisicas || estacion.unidades) && !estacion.descripcion && (
                  <div class="pt-3 flex flex-col gap-2" style="border-top:1px solid rgba(74,117,153,0.12)">
                    <div class="text-[9px] uppercase tracking-widest" style="color:#4A7599">Capacidad</div>
                    {estacion.elementos && (
                      <div class="flex items-center justify-between">
                        <span class="text-xs" style="color:#64748B">Personal</span>
                        <span class="font-display font-bold text-sm" style="color:#CBD5E1">{estacion.elementos} elem.</span>
                      </div>
                    )}
                    {estacion.estacionesFisicas && (
                      <div class="flex items-center justify-between">
                        <span class="text-xs" style="color:#64748B">Cuarteles</span>
                        <span class="font-display font-bold text-sm" style="color:#CBD5E1">{estacion.estacionesFisicas}</span>
                      </div>
                    )}
                    {estacion.unidades && (
                      <div class="flex items-center justify-between">
                        <span class="text-xs" style="color:#64748B">Flota</span>
                        <span class="font-display font-bold text-sm" style="color:#CBD5E1">{estacion.unidades} veh.</span>
                      </div>
                    )}
                  </div>
                )}

                {/* CTA */}
                <a href={whatsappUrl(waMsg)} target="_blank" rel="noopener noreferrer"
                  class="btn btn-primary w-full text-center mt-1" style="font-size:0.78rem">
                  Equipar esta corporación →
                </a>
              </div>
            </div>

            {/* ── Bloque 2: Equipo para esta corporación ── */}
            <div style="background:#040A12;border:1px solid rgba(74,117,153,0.2);border-top:2px solid #F75000">
              <div class="px-5 pt-4 pb-3" style="border-bottom:1px solid rgba(74,117,153,0.12)">
                <div class="flex items-center gap-2">
                  <span class="w-3.5 h-3.5 shrink-0" style="color:#F75000" set:html={tagIcon} aria-hidden="true"/>
                  <span class="font-display font-bold text-xs uppercase tracking-widest" style="color:#FFFFFF">
                    Equipo para {cfg.label}
                  </span>
                </div>
                <p class="text-[10px] mt-1 m-0" style="color:#4A7599">Productos certificados NFPA · Entrega en {estado.nombre}</p>
              </div>
              <div class="flex flex-col">
                {prodLinks.map((p, i) => (
                  <a href={p.href}
                    class="flex items-center justify-between px-5 py-2.5 transition-colors hover:bg-[rgba(247,80,0,0.06)] group"
                    style={i > 0 ? 'border-top:1px solid rgba(74,117,153,0.1)' : ''}>
                    <span class="text-xs group-hover:text-[#FF6B26] transition-colors" style="color:#CBD5E1">{p.label}</span>
                    <span class="w-3.5 h-3.5 shrink-0 opacity-40 group-hover:opacity-100 group-hover:text-[#FF6B26] transition-all"
                      style="color:#4A7599" set:html={arrowIcon} aria-hidden="true"/>
                  </a>
                ))}
                <div class="px-5 pt-3 pb-4" style="border-top:1px solid rgba(74,117,153,0.1)">
                  <a href="/productos" class="text-[10px] uppercase tracking-wider transition-colors hover:text-[#FF6B26]" style="color:#4A7599">
                    Ver catálogo completo →
                  </a>
                </div>
              </div>
            </div>

            {/* ── Bloque 3: Otras estaciones en el estado ── */}
            {hermanasSidebar.length > 0 && (
              <div style="background:#040A12;border:1px solid rgba(74,117,153,0.2);border-top:2px solid #4A7599">
                <div class="px-5 pt-4 pb-3" style="border-bottom:1px solid rgba(74,117,153,0.12)">
                  <div class="flex items-center gap-2">
                    <span class="w-3.5 h-3.5 shrink-0" style="color:#4A7599" set:html={mapPinIcon} aria-hidden="true"/>
                    <span class="font-display font-bold text-xs uppercase tracking-widest" style="color:#FFFFFF">
                      En {estado.nombre}
                    </span>
                  </div>
                  <p class="text-[10px] mt-1 m-0" style="color:#4A7599">
                    {estado.estaciones.length - 1} corporacion{estado.estaciones.length - 1 !== 1 ? 'es' : ''} más en el estado
                  </p>
                </div>
                <div class="flex flex-col">
                  {hermanasSidebar.map((h, i) => {
                    const hcfg = tipoConfig[h.tipo];
                    return (
                      <a href={`/estaciones/${estado.slug}/${h.slug}`}
                        class="flex items-start gap-3 px-5 py-3 transition-colors hover:bg-[rgba(74,117,153,0.06)] group"
                        style={i > 0 ? 'border-top:1px solid rgba(74,117,153,0.1)' : ''}>
                        <span class="shrink-0 mt-1 w-1.5 h-1.5 rounded-full" style={`background:${hcfg.color};margin-top:0.35rem`}></span>
                        <div class="flex flex-col gap-0.5 min-w-0">
                          <span class="text-xs leading-snug group-hover:text-[#FF6B26] transition-colors truncate" style="color:#CBD5E1">{h.nombre}</span>
                          <span class="text-[10px]" style={`color:${hcfg.color}`}>{hcfg.label} · {h.ciudad}</span>
                        </div>
                      </a>
                    );
                  })}
                  {todasHermanas.length > 8 && (
                    <div class="px-5 pt-3 pb-4" style="border-top:1px solid rgba(74,117,153,0.1)">
                      <a href={`/estaciones/${estado.slug}`} class="text-[10px] uppercase tracking-wider transition-colors hover:text-[#FF6B26]" style="color:#4A7599">
                        Ver las {todasHermanas.length} corporaciones →
                      </a>
                    </div>
                  )}
                  {todasHermanas.length <= 8 && (
                    <div class="px-5 pt-3 pb-4" style="border-top:1px solid rgba(74,117,153,0.1)">
                      <a href={`/estaciones/${estado.slug}`} class="text-[10px] uppercase tracking-wider transition-colors hover:text-[#FF6B26]" style="color:#4A7599">
                        Directorio {estado.nombre} →
                      </a>
                    </div>
                  )}
                </div>
              </div>
            )}

            {/* ── Bloque 4: Artículos técnicos relacionados ── */}
            <div style="background:#040A12;border:1px solid rgba(74,117,153,0.2);border-top:2px solid #64748B">
              <div class="px-5 pt-4 pb-3" style="border-bottom:1px solid rgba(74,117,153,0.12)">
                <div class="flex items-center gap-2">
                  <span class="w-3.5 h-3.5 shrink-0" style="color:#64748B" set:html={articleIcon} aria-hidden="true"/>
                  <span class="font-display font-bold text-xs uppercase tracking-widest" style="color:#FFFFFF">Guías técnicas</span>
                </div>
              </div>
              <div class="flex flex-col">
                {blogLinks.map((b, i) => (
                  <a href={b.href}
                    class="flex items-start gap-2.5 px-5 py-3 transition-colors hover:bg-[rgba(74,117,153,0.06)] group"
                    style={i > 0 ? 'border-top:1px solid rgba(74,117,153,0.1)' : ''}>
                    <span class="shrink-0 font-display text-[10px] font-bold mt-0.5" style="color:#4A7599">{String(i + 1).padStart(2,'0')}</span>
                    <span class="text-xs leading-snug group-hover:text-[#FF6B26] transition-colors" style="color:#94A3B8">{b.label}</span>
                  </a>
                ))}
                <div class="px-5 pt-3 pb-4" style="border-top:1px solid rgba(74,117,153,0.1)">
                  <a href="/blog" class="text-[10px] uppercase tracking-wider transition-colors hover:text-[#FF6B26]" style="color:#4A7599">
                    Ver blog técnico →
                  </a>
                </div>
              </div>
            </div>

            {/* ── Bloque 5: Directorio regional ── */}
            {estadosRegion.length > 0 && (
              <div style="background:#040A12;border:1px solid rgba(74,117,153,0.2);border-top:2px solid rgba(74,117,153,0.5)">
                <div class="px-5 pt-4 pb-3" style="border-bottom:1px solid rgba(74,117,153,0.12)">
                  <span class="font-display font-bold text-xs uppercase tracking-widest" style="color:#FFFFFF">
                    Región {estado.region}
                  </span>
                  <p class="text-[10px] mt-1 m-0" style="color:#4A7599">Otros estados de la región</p>
                </div>
                <div class="flex flex-col">
                  {estadosRegion.map((e, i) => (
                    <a href={`/estaciones/${e.slug}`}
                      class="flex items-center justify-between px-5 py-2.5 transition-colors hover:bg-[rgba(74,117,153,0.06)] group"
                      style={i > 0 ? 'border-top:1px solid rgba(74,117,153,0.1)' : ''}>
                      <div class="flex flex-col gap-0.5">
                        <span class="text-xs group-hover:text-[#FF6B26] transition-colors" style="color:#CBD5E1">{e.nombre}</span>
                        <span class="text-[10px]" style="color:#4A7599">{e.estaciones.length} corporacion{e.estaciones.length !== 1 ? 'es' : ''}</span>
                      </div>
                      <span class="w-3.5 h-3.5 shrink-0 opacity-30 group-hover:opacity-80 transition-opacity"
                        style="color:#4A7599" set:html={arrowIcon} aria-hidden="true"/>
                    </a>
                  ))}
                  <div class="px-5 pt-3 pb-4" style="border-top:1px solid rgba(74,117,153,0.1)">
                    <a href="/estaciones" class="text-[10px] uppercase tracking-wider transition-colors hover:text-[#FF6B26]" style="color:#4A7599">
                      Ver directorio nacional →
                    </a>
                  </div>
                </div>
              </div>
            )}

          </div>
        </aside>

      </div>
    </div>
  </section>

  {/* ── Más estaciones del estado (grid bottom) ── */}
  {herManasGrid.length > 0 && (
    <section class="section-tight" style="background:#040A12;border-top:1px solid rgba(74,117,153,0.15)"
      aria-labelledby="hermanas-heading">
      <div class="container-site">
        <div class="flex items-end justify-between gap-4 mb-6">
          <h2 id="hermanas-heading" class="font-display font-bold m-0"
            style="color:#FFFFFF;font-size:clamp(1.25rem,2.5vw,1.75rem)">
            Más estaciones en <span style="color:#F75000">{estado.nombre}</span>
          </h2>
          <a href={`/estaciones/${estado.slug}`} class="btn btn-ghost btn-sm shrink-0">Ver todas →</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {herManasGrid.map((h) => {
            const hcfg = tipoConfig[h.tipo];
            return (
              <a href={`/estaciones/${estado.slug}/${h.slug}`}
                class="group flex flex-col gap-2 p-4 transition-colors"
                style={`background:#070E1A;border:1px solid rgba(74,117,153,0.18);border-left:3px solid ${hcfg.color}`}>
                <span class="font-display text-[9px] uppercase tracking-wider" style={`color:${hcfg.color}`}>{hcfg.label}</span>
                <span class="font-display font-bold text-sm leading-tight transition-colors group-hover:text-[#FF6B26]"
                  style="color:#FFFFFF">{h.nombre}</span>
                <span class="text-[11px]" style="color:#64748B">{h.ciudad}</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {/* ── Mapa init script ── */}
  {hasMap && (
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
    <script is:inline>
      window.addEventListener('load', function () {
        var el = document.getElementById('estacion-map');
        if (!el || typeof L === 'undefined') return;
        var lat = parseFloat(el.dataset.lat), lng = parseFloat(el.dataset.lng);
        if (isNaN(lat) || isNaN(lng)) return;
        var map = L.map(el, { scrollWheelZoom: false, attributionControl: true }).setView([lat, lng], 14);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19, attribution: '© OpenStreetMap'
        }).addTo(map);
        var icon = L.divIcon({
          html: '<div style="width:12px;height:12px;background:#F75000;border-radius:50%;border:2px solid #fff;box-shadow:0 0 0 3px rgba(247,80,0,0.3)"></div>',
          iconSize: [12, 12], iconAnchor: [6, 6], className: ''
        });
        L.marker([lat, lng], { icon: icon }).addTo(map).bindPopup(el.dataset.nombre);
      });
    </script>
  )}

</BaseLayout>
