---
// /estaciones/[estado]/[slug].astro — Ficha L3 de una estación
// =====================================================================
// Página dedicada por corporación: datos completos, contacto, mapa,
// fuentes citadas, badge de confianza y schema FireStation (geo).
// Homologada al design system v2. No colisiona con [estado].astro
// (esa ruta es /estaciones/X; esta es /estaciones/X/Y).
// =====================================================================
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { todasLasParejas, tipoConfig, confianzaConfig } from '@data/estaciones';
import { SITE, whatsappUrl } from '@data/site';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => {
  return todasLasParejas.map(({ estado, estacion }) => ({
    params: { estado: estado.slug, slug: estacion.slug },
    props: { estado, estacion },
  }));
}) satisfies GetStaticPaths;

const { estado, estacion } = Astro.props;
const cfg = tipoConfig[estacion.tipo];
const conf = estacion.confianza ? confianzaConfig[estacion.confianza] : null;
const canonicalURL = `${SITE.url}/estaciones/${estado.slug}/${estacion.slug}`;

/* ── Hermanas del estado (cross-link) ── */
const hermanas = estado.estaciones.filter((e) => e.slug !== estacion.slug).slice(0, 6);

/* ── Formato fecha verificación ── */
const meses = ['ene','feb','mar','abr','may','jun','jul','ago','sep','oct','nov','dic'];
function fmtVerif(v?: string): string | null {
  if (!v) return null;
  const [y, m] = v.split('-');
  return m ? `${meses[parseInt(m, 10) - 1]} ${y}` : y;
}
const verif = fmtVerif(estacion.verificadoEl);

/* ── SEO ── */
// El nombre ya es descriptivo y contiene "Bomberos"; evitamos redundancia y títulos largos.
// Si es corto, enriquecemos con la ciudad para reforzar la keyword geo.
const seoTitle = estacion.nombre.length <= 38
  ? `${estacion.nombre} — ${estacion.ciudad}`
  : estacion.nombre;
const seoDescription =
  `${estacion.nombre}: ${estacion.tipo.toLowerCase()} en ${estacion.ciudad}, ${estado.nombre}. ` +
  `${estacion.telefonoEmergencias ? `Emergencias ${estacion.telefonoEmergencias}. ` : ''}` +
  `Servicios, contacto y ubicación. Equipo NFPA con envío a ${estado.nombre}.`;
const seoDesc = seoDescription.slice(0, 160);

/* ── Schemas ── */
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Directorio de Estaciones', item: `${SITE.url}/estaciones` },
    { '@type': 'ListItem', position: 3, name: estado.nombre, item: `${SITE.url}/estaciones/${estado.slug}` },
    { '@type': 'ListItem', position: 4, name: estacion.nombre, item: canonicalURL },
  ],
};

const fireStationSchema = {
  '@context': 'https://schema.org',
  '@type': 'FireStation',
  '@id': `${canonicalURL}#firestation`,
  name: estacion.nombre,
  url: canonicalURL,
  ...(estacion.telefono || estacion.telefonoEmergencias
    ? { telephone: estacion.telefono ?? estacion.telefonoEmergencias }
    : {}),
  address: {
    '@type': 'PostalAddress',
    ...(estacion.direccion ? { streetAddress: estacion.direccion } : {}),
    addressLocality: estacion.ciudad,
    addressRegion: estado.nombre,
    addressCountry: 'MX',
  },
  ...(estacion.coordenadas
    ? { geo: { '@type': 'GeoCoordinates', latitude: estacion.coordenadas.lat, longitude: estacion.coordenadas.lng } }
    : {}),
  areaServed: { '@type': 'AdministrativeArea', name: estacion.municipio },
  ...(estacion.sitioWeb ? { sameAs: [estacion.sitioWeb] } : {}),
};

const schemas = [breadcrumbSchema, fireStationSchema];
const waMsg = `Hola, necesito equipo certificado NFPA para ${estacion.nombre} en ${estacion.ciudad}, ${estado.nombre}. ¿Disponibilidad y tiempo de entrega?`;

const pinIcon   = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`;
const phoneIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>`;
const checkIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path stroke-linecap="round" stroke-linejoin="round" d="M20 6L9 17l-5-5"/></svg>`;
const globeIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20"/></svg>`;
---

<BaseLayout title={seoTitle} description={seoDesc} canonicalURL={canonicalURL} schema={schemas}>

  {/* Leaflet (solo si hay coordenadas) */}
  {estacion.coordenadas && (
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
  )}

  {/* ── Breadcrumb ── */}
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0 flex-wrap" style="color:#4A7599">
        <li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/estaciones" class="hover:text-[#FF6B26]">Directorio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={`/estaciones/${estado.slug}`} class="hover:text-[#FF6B26]">{estado.nombre}</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:#94A3B8" aria-current="page">{estacion.ciudad}</span></li>
      </ol>
    </div>
  </nav>

  {/* ── Hero ── */}
  <section class="relative overflow-hidden" style="background:#040A12;padding-block:4.5rem" aria-labelledby="est-heading">
    <div class="absolute top-0 right-0 w-2/3 h-full pointer-events-none" aria-hidden="true"
      style="background:radial-gradient(ellipse 70% 60% at 85% 40%, rgba(247,80,0,0.07) 0%, transparent 65%)"></div>
    <div class="container-site relative z-10">
      <div class="flex flex-wrap items-center gap-2 mb-5">
        <span class="font-display font-bold text-[10px] uppercase tracking-wider px-2 py-1"
          style={`color:${cfg.color};background:${cfg.bgColor};border:1px solid ${cfg.color}40`}>{cfg.label}</span>
        {conf && (
          <span class="inline-flex items-center gap-1 font-display text-[10px] uppercase tracking-wider px-2 py-1"
            style={`color:${conf.color};background:${conf.bgColor};border:1px solid ${conf.color}40`}>
            <span class="w-2.5 h-2.5" set:html={checkIcon} aria-hidden="true"/>{conf.label}{verif ? ` · ${verif}` : ''}
          </span>
        )}
        {estacion.fundacion && (
          <span class="font-display text-[10px] uppercase tracking-wider px-2 py-1" style="color:#4A7599;border:1px solid rgba(74,117,153,0.3)">Desde {estacion.fundacion}</span>
        )}
      </div>

      <h1 id="est-heading" class="font-display font-bold mb-4" style="color:#FFFFFF;font-size:clamp(1.9rem,4vw,3.25rem);line-height:1.04">
        {estacion.nombre}
      </h1>
      <p class="flex items-center gap-2 text-sm mb-6" style="color:#94A3B8">
        <span class="w-4 h-4 shrink-0" style="color:#FF6B26" set:html={pinIcon} aria-hidden="true"/>
        {estacion.ciudad}{estacion.municipio !== estacion.ciudad ? ` · Mpio. ${estacion.municipio}` : ''}, {estado.nombre}
      </p>

      <div class="flex flex-col sm:flex-row gap-3">
        <a href={whatsappUrl(waMsg)} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-lg">Cotizar equipo por WhatsApp</a>
        <a href={`/estaciones/${estado.slug}`} class="btn btn-ghost btn-lg">← Volver a {estado.nombre}</a>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-px" aria-hidden="true"
      style="background:linear-gradient(90deg, transparent, rgba(247,80,0,0.4) 30%, rgba(247,80,0,0.4) 70%, transparent)"></div>
  </section>

  <QuickLinksBar />

  {/* ── Cuerpo: datos + mapa ── */}
  <section class="section" style="background:#070E1A" aria-label="Información de la estación">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">

        {/* Columna principal */}
        <div class="lg:col-span-2 flex flex-col gap-8">

          {estacion.descripcion && (
            <div>
              <span class="section-eyebrow mb-3 inline-flex">Perfil</span>
              <div class="flex flex-col gap-4">
                {estacion.descripcion.split('\n\n').map((parrafo) => (
                  <p class="text-sm leading-[1.9] m-0" style="color:#94A3B8">{parrafo}</p>
                ))}
              </div>
            </div>
          )}

          {/* Servicios */}
          <div>
            <h2 class="font-display font-bold text-sm uppercase tracking-wider mb-4" style="color:#FF6B26">Servicios operativos</h2>
            <div class="grid grid-cols-1 sm:grid-cols-2" style="border:1px solid rgba(74,117,153,0.18)">
              {estacion.servicios.map((s, i) => (
                <div class="flex items-start gap-3 p-4"
                  style={`background:#040A12;border-bottom:1px solid rgba(74,117,153,0.12);${i % 2 === 0 ? 'border-right:1px solid rgba(74,117,153,0.12);' : ''}`}>
                  <span class="shrink-0 font-display font-bold text-xs" style="color:#F75000;min-width:1.4rem">{String(i + 1).padStart(2, '0')}</span>
                  <span class="text-sm" style="color:#CBD5E1">{s}</span>
                </div>
              ))}
            </div>
          </div>

          {/* Certificaciones */}
          {estacion.certificaciones && estacion.certificaciones.length > 0 && (
            <div>
              <h2 class="font-display font-bold text-sm uppercase tracking-wider mb-4" style="color:#FF6B26">Certificaciones</h2>
              <div class="flex flex-wrap gap-2">
                {estacion.certificaciones.map((c) => (
                  <span class="inline-flex items-center gap-1 font-display text-[11px] uppercase tracking-wider px-2.5 py-1"
                    style="color:#34D399;background:rgba(52,211,153,0.1);border:1px solid rgba(52,211,153,0.25)">
                    <span class="w-3 h-3" set:html={checkIcon} aria-hidden="true"/>{c}
                  </span>
                ))}
              </div>
            </div>
          )}

          {/* Mapa */}
          {estacion.coordenadas && (
            <div>
              <h2 class="font-display font-bold text-sm uppercase tracking-wider mb-4" style="color:#FF6B26">Ubicación</h2>
              <div
                id="estacion-map"
                data-lat={estacion.coordenadas.lat}
                data-lng={estacion.coordenadas.lng}
                data-nombre={estacion.nombre}
                style="height:340px;border:1px solid rgba(74,117,153,0.25);background:#0C1825"
                role="img"
                aria-label={`Mapa de ubicación de ${estacion.nombre}`}
              ></div>
              <p class="text-[11px] mt-2" style="color:#4A7599">
                Ubicación aproximada con fines de referencia. Coordenadas: {estacion.coordenadas.lat}, {estacion.coordenadas.lng}.
              </p>
            </div>
          )}

          {/* Fuentes */}
          {estacion.fuentes && estacion.fuentes.length > 0 && (
            <div>
              <h2 class="font-display font-bold text-sm uppercase tracking-wider mb-4" style="color:#FF6B26">Fuentes</h2>
              <ul class="flex flex-col gap-2 list-none m-0 p-0">
                {estacion.fuentes.map((f) => (
                  <li class="text-xs break-all" style="color:#64748B">
                    <a href={f} target="_blank" rel="noopener noreferrer nofollow" class="hover:text-[#FF6B26]" style="color:#4A7599">{f}</a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>

        {/* Columna lateral: contacto */}
        <aside class="flex flex-col gap-4">
          <div class="flex flex-col gap-4 p-6" style={`background:#040A12;border:1px solid rgba(74,117,153,0.18);border-top:2px solid ${cfg.color}`}>
            <h2 class="font-display font-bold text-sm uppercase tracking-wider" style="color:#FFFFFF">Contacto</h2>

            {estacion.telefonoEmergencias && (
              <div class="flex items-center gap-2">
                <span class="w-4 h-4 shrink-0" style="color:#F75000" set:html={phoneIcon} aria-hidden="true"/>
                <div>
                  <div class="text-[10px] uppercase tracking-widest" style="color:#4A7599">Emergencias</div>
                  <a href={`tel:${estacion.telefonoEmergencias.replace(/[^0-9+]/g, '')}`} class="font-display font-bold text-lg" style="color:#F75000">{estacion.telefonoEmergencias}</a>
                </div>
              </div>
            )}
            {estacion.telefono && (
              <div class="flex items-center gap-2">
                <span class="w-4 h-4 shrink-0" style="color:#4A7599" set:html={phoneIcon} aria-hidden="true"/>
                <div>
                  <div class="text-[10px] uppercase tracking-widest" style="color:#4A7599">Conmutador</div>
                  <a href={`tel:${estacion.telefono.replace(/[^0-9+]/g, '')}`} class="text-sm" style="color:#CBD5E1">{estacion.telefono}</a>
                </div>
              </div>
            )}
            {estacion.telefonosAdicionales && estacion.telefonosAdicionales.length > 0 && (
              <div class="flex items-start gap-2">
                <span class="w-4 h-4 shrink-0 mt-0.5" style="color:#4A7599" set:html={phoneIcon} aria-hidden="true"/>
                <div>
                  <div class="text-[10px] uppercase tracking-widest" style="color:#4A7599">Otras líneas</div>
                  <div class="flex flex-col">
                    {estacion.telefonosAdicionales.map((t) => (
                      <a href={`tel:${t.replace(/[^0-9+]/g, '')}`} class="text-sm" style="color:#CBD5E1">{t}</a>
                    ))}
                  </div>
                </div>
              </div>
            )}
            {estacion.direccion && (
              <div class="flex items-start gap-2">
                <span class="w-4 h-4 shrink-0 mt-0.5" style="color:#4A7599" set:html={pinIcon} aria-hidden="true"/>
                <div>
                  <div class="text-[10px] uppercase tracking-widest" style="color:#4A7599">Dirección</div>
                  <p class="text-sm m-0" style="color:#CBD5E1">{estacion.direccion}</p>
                </div>
              </div>
            )}
            {estacion.sitioWeb && (
              <div class="flex items-center gap-2">
                <span class="w-4 h-4 shrink-0" style="color:#4A7599" set:html={globeIcon} aria-hidden="true"/>
                <a href={estacion.sitioWeb} target="_blank" rel="noopener noreferrer" class="text-sm break-all hover:text-[#FF6B26]" style="color:#CBD5E1">Sitio oficial</a>
              </div>
            )}
            {estacion.email && (
              <div class="flex items-center gap-2">
                <span class="w-4 h-4 shrink-0" style="color:#4A7599">@</span>
                <a href={`mailto:${estacion.email}`} class="text-sm break-all hover:text-[#FF6B26]" style="color:#CBD5E1">{estacion.email}</a>
              </div>
            )}

            {!estacion.telefono && !estacion.direccion && !estacion.sitioWeb && (
              <p class="text-xs leading-relaxed m-0" style="color:#64748B">
                Para esta corporación, las emergencias se atienden vía {estacion.telefonoEmergencias ?? '911'}. Datos de contacto directo en proceso de verificación.
              </p>
            )}

            <div class="pt-3" style="border-top:1px solid rgba(74,117,153,0.15)">
              <div class="text-[10px] uppercase tracking-widest mb-1" style="color:#4A7599">Jurisdicción</div>
              <p class="text-sm m-0" style="color:#CBD5E1">{cfg.label} · {estacion.municipio}, {estado.nombre}</p>
              {estacion.operador && (
                <p class="text-xs m-0 mt-1" style="color:#64748B">Opera: {estacion.operador}</p>
              )}
            </div>

            {(estacion.elementos || estacion.estacionesFisicas || estacion.unidades) && (
              <div class="pt-3 flex flex-col gap-2" style="border-top:1px solid rgba(74,117,153,0.15)">
                <div class="text-[10px] uppercase tracking-widest mb-1" style="color:#4A7599">Capacidad operativa</div>
                {estacion.elementos && (
                  <div class="flex items-center justify-between">
                    <span class="text-xs" style="color:#64748B">Personal activo</span>
                    <span class="font-display font-bold text-sm" style="color:#CBD5E1">{estacion.elementos} elementos</span>
                  </div>
                )}
                {estacion.estacionesFisicas && (
                  <div class="flex items-center justify-between">
                    <span class="text-xs" style="color:#64748B">Cuarteles</span>
                    <span class="font-display font-bold text-sm" style="color:#CBD5E1">{estacion.estacionesFisicas}</span>
                  </div>
                )}
                {estacion.unidades && (
                  <div class="flex items-center justify-between">
                    <span class="text-xs" style="color:#64748B">Flota</span>
                    <span class="font-display font-bold text-sm" style="color:#CBD5E1">{estacion.unidades} vehículos</span>
                  </div>
                )}
              </div>
            )}

            {conf && (
              <div class="flex items-center gap-2 pt-3" style="border-top:1px solid rgba(74,117,153,0.15)">
                <span class="inline-flex items-center gap-1 font-display text-[10px] uppercase tracking-wider px-2 py-0.5"
                  style={`color:${conf.color};background:${conf.bgColor};border:1px solid ${conf.color}40`}>
                  <span class="w-2.5 h-2.5" set:html={checkIcon} aria-hidden="true"/>{conf.label}
                </span>
                {verif && <span class="text-[10px]" style="color:#4A7599">Actualizado {verif}</span>}
              </div>
            )}
          </div>

          <a href={whatsappUrl(waMsg)} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-mobile-full">Equipar esta corporación</a>
        </aside>

      </div>
    </div>
  </section>

  {/* ── Otras estaciones del estado ── */}
  {hermanas.length > 0 && (
    <section class="section-tight" style="background:#040A12;border-top:1px solid rgba(74,117,153,0.15)" aria-labelledby="hermanas-heading">
      <div class="container-site">
        <div class="flex items-end justify-between gap-4 mb-6">
          <h2 id="hermanas-heading" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.4rem,2.5vw,2rem)">
            Más estaciones en <span style="color:#F75000">{estado.nombre}</span>
          </h2>
          <a href={`/estaciones/${estado.slug}`} class="btn btn-ghost btn-sm">Ver todas →</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {hermanas.map((h) => {
            const hcfg = tipoConfig[h.tipo];
            return (
              <a href={`/estaciones/${estado.slug}/${h.slug}`} class="group flex flex-col gap-2 p-4"
                style={`background:#070E1A;border:1px solid rgba(74,117,153,0.18);border-left:2px solid ${hcfg.color}`}>
                <span class="font-display text-[9px] uppercase tracking-wider" style={`color:${hcfg.color}`}>{hcfg.label}</span>
                <span class="font-display font-bold text-sm leading-tight group-hover:text-[#FF6B26]" style="color:#FFFFFF">{h.nombre}</span>
                <span class="text-[11px]" style="color:#64748B">{h.ciudad}</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {/* Mapa init */}
  {estacion.coordenadas && (
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
    <script is:inline>
      window.addEventListener('load', function () {
        var el = document.getElementById('estacion-map');
        if (!el || typeof L === 'undefined') return;
        var lat = parseFloat(el.dataset.lat), lng = parseFloat(el.dataset.lng);
        var map = L.map(el, { scrollWheelZoom: false, attributionControl: true }).setView([lat, lng], 14);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19, attribution: '&copy; OpenStreetMap'
        }).addTo(map);
        L.marker([lat, lng]).addTo(map).bindPopup(el.dataset.nombre);
      });
    </script>
  )}

</BaseLayout>
