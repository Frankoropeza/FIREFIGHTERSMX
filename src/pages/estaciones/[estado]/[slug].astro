  {/* ── Más estaciones del estado (grid bottom) ── */}
  {herManasGrid.length > 0 && (
    <section class="section-tight" style="background:#040A12;border-top:1px solid rgba(74,117,153,0.15)"
      aria-labelledby="hermanas-heading">
      <div class="container-site">
        <div class="flex items-end justify-between gap-4 mb-6">
          <h2 id="hermanas-heading" class="font-display font-bold m-0"
            style="color:#FFFFFF;font-size:clamp(1.25rem,2.5vw,1.75rem)">
            Más estaciones en <span style="color:#F75000">{estado.nombre}</span>
          </h2>
          <a href={`/estaciones/${estado.slug}`} class="btn btn-ghost btn-sm shrink-0">Ver todas →</a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {herManasGrid.map((h) => {
            const hcfg = tipoConfig[h.tipo];
            return (
              <a href={`/estaciones/${estado.slug}/${h.slug}`}
                class="group flex flex-col gap-2 p-4 transition-colors"
                style={`background:#070E1A;border:1px solid rgba(74,117,153,0.18);border-left:3px solid ${hcfg.color}`}>
                <span class="font-display text-[9px] uppercase tracking-wider" style={`color:${hcfg.color}`}>{hcfg.label}</span>
                <span class="font-display font-bold text-sm leading-tight transition-colors group-hover:text-[#FF6B26]"
                  style="color:#FFFFFF">{h.nombre}</span>
                <span class="text-[11px]" style="color:#64748B">{h.ciudad}</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {/* ── Mapa init script ── */}
  {hasMap && (
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
    <script is:inline>
      window.addEventListener('load', function () {
        var el = document.getElementById('estacion-map');
        if (!el || typeof L === 'undefined') return;
        var lat = parseFloat(el.dataset.lat), lng = parseFloat(el.dataset.lng);
        if (isNaN(lat) || isNaN(lng)) return;
        var map = L.map(el, { scrollWheelZoom: false, attributionControl: true }).setView([lat, lng], 14);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19, attribution: '© OpenStreetMap'
        }).addTo(map);
        var icon = L.divIcon({
          html: '<div style="width:12px;height:12px;background:#F75000;border-radius:50%;border:2px solid #fff;box-shadow:0 0 0 3px rgba(247,80,0,0.3)"></div>',
          iconSize: [12, 12], iconAnchor: [6, 6], className: ''
        });
        L.marker([lat, lng], { icon: icon }).addTo(map).bindPopup(el.dataset.nombre);
      });
    </script>
  )}

</BaseLayout>
