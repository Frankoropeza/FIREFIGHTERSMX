---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import EstadoCard from '@components/estaciones/EstadoCard.astro';
import { SITE, contactoUrl } from '@config/site';
import {
  estados,
  totalEstados,
  tiposPresentes,
  tipoConfig,
  todasLasEstaciones,
} from '@data/estaciones';

const canonicalURL = `${SITE.url}/estaciones/`;

const seoMeta = {
  title: 'Directorio de Estaciones de Bomberos en México',
  noBrandSuffix: true,
  description:
    'Directorio de cuerpos de bomberos en los 32 estados de México: ubicación, tipo de corporación, servicios y contacto, con la fuente citada en cada registro.',
  canonicalURL,
};

/* ─── Schemas JSON-LD ──────────────────────────────────────── */

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio',    item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Directorio de Estaciones', item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: 'Directorio de Estaciones de Bomberos en México',
  description: seoMeta.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@type': 'Thing', name: 'Cuerpos de Bomberos México' },
  mainEntity: {
    '@type': 'ItemList',
    name: 'Estados con estaciones de bomberos',
    numberOfItems: totalEstados,
    itemListElement: estados.map((est, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `Estaciones de Bomberos en ${est.nombre}`,
      url: `${SITE.url}/estaciones/${est.slug}/`,
    })),
  },
};

/* Las corporaciones también como ItemList: el CollectionPage solo declaraba
   los 32 estados y dejaba fuera la entidad que la página realmente lista (E-17). */
const estacionesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${canonicalURL}#estaciones`,
  name: 'Estaciones de bomberos del directorio',
  numberOfItems: todasLasEstaciones.length,
  itemListElement: todasLasEstaciones.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'FireStation',
      name: e.nombre,
      url: `${SITE.url}/estaciones/${estados.find((x) => x.nombre === e.estado)?.slug}/${e.slug}/`,
      address: { '@type': 'PostalAddress', addressLocality: e.ciudad, addressRegion: e.estado, addressCountry: 'MX' },
    },
  })),
};

/* ─── Datos de regiones para agrupar ─────────────────────── */
const regiones = [
  { label: 'Noroeste',        estados: estados.filter(e => e.region === 'Noroeste') },
  { label: 'Norte',           estados: estados.filter(e => e.region === 'Norte') },
  { label: 'Noreste',         estados: estados.filter(e => e.region === 'Noreste') },
  { label: 'Centro-Norte',    estados: estados.filter(e => e.region === 'Centro-Norte') },
  { label: 'Centro-Occidente',estados: estados.filter(e => e.region === 'Centro-Occidente') },
  { label: 'Centro',          estados: estados.filter(e => e.region === 'Centro') },
  { label: 'Sur',             estados: estados.filter(e => e.region === 'Sur') },
  { label: 'Peninsular',      estados: estados.filter(e => e.region === 'Peninsular') },
];

/* ─── Estaciones con teléfono de emergencias (llamativas) ── */
const estacionesDestacadas = todasLasEstaciones
  .filter(e => e.descripcion)
  .slice(0, 4);

/* ─── Última verificación real del directorio (derivada de los datos) ─── */
const meses = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];
const ultimaVerif = todasLasEstaciones
  .map((e) => e.verificadoEl)
  .filter(Boolean)
  .sort()
  .pop();
const ultimaVerifLabel = (() => {
  if (!ultimaVerif) return null;
  const [y, m] = ultimaVerif.split('-');
  return m ? `${meses[parseInt(m, 10) - 1]} de ${y}` : y;
})();

/* ─── Conteo por tipo ─────────────────────────────────────── */
const conteoPorTipo = tiposPresentes.map(t => ({
  tipo: t,
  ...tipoConfig[t],
  count: todasLasEstaciones.filter(e => e.tipo === t).length,
})).sort((a, b) => b.count - a.count);

/* ─── FAQ ─────────────────────────────────────────────────── */
const faqs = [
  {
    q: '¿A qué número se llama en una emergencia de bomberos?',
    a: 'Al 911, que es el número único de emergencias en todo México y deriva la llamada al cuerpo de bomberos que corresponde. El antiguo 068 sigue operando en algunos municipios, pero ya no es la vía general. Los teléfonos que aparecen en cada ficha son administrativos y no sustituyen al 911 en una emergencia.',
  },
  {
    q: '¿Cuántos cuerpos de bomberos hay en México?',
    a: 'No hay un padrón nacional único. El DENUE del INEGI registra alrededor de 870 unidades económicas de bomberos en el país, y a esa cifra hay que sumar las unidades ARFF de aeropuerto y las brigadas de PEMEX y CFE, que el DENUE no clasifica como tales. Una corporación puede además operar varios cuarteles: este directorio da de alta una ficha por estación física, no por corporación.',
  },
  {
    q: '¿Cuál es la certificación NFPA para bomberos?',
    a: 'La NFPA 1001 es el estándar de competencias profesionales para bomberos estructurales. En México convive con la NOM-002-STPS para brigadas industriales. Los bomberos aeroportuarios siguen la NFPA 403 y la categorización ICAO.',
  },
  {
    q: '¿Cómo se puede registrar una estación en este directorio?',
    a: 'Si representas un cuerpo de bomberos o estación que no aparece en el directorio, puedes contactarnos por WhatsApp o correo electrónico para solicitar el alta sin costo.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema, estacionesSchema, faqSchema]}>

  <!-- ── Breadcrumb ──────────────────────────────────────────── -->
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:#4A7599">
        <li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:#94A3B8" aria-current="page">Directorio de Estaciones</span></li>
      </ol>
    </div>
  </nav>

  <!-- ── Hero ───────────────────────────────────────────────── -->
  <section class="relative overflow-hidden" style="background:#040A12;padding-block:5rem" aria-labelledby="hero-title">

    <!-- Glow decorativo -->
    <div class="absolute top-0 right-0 w-2/3 h-full pointer-events-none" aria-hidden="true"
      style="background:radial-gradient(ellipse 70% 60% at 85% 40%, rgba(247,80,0,0.07) 0%, transparent 65%)">
    </div>
    <!-- Grid pattern decorativo -->
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
      style="background-image:linear-gradient(rgba(74,117,153,0.04) 1px, transparent 1px),linear-gradient(90deg,rgba(74,117,153,0.04) 1px,transparent 1px);background-size:40px 40px;mask-image:radial-gradient(ellipse 80% 80% at 80% 30%, black, transparent)">
    </div>

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <div>
          <span class="section-eyebrow mb-5 inline-flex">Directorio nacional · 32 estados</span>
          <h1 id="hero-title" class="font-display font-bold uppercase mb-6"
            style="color:#FFFFFF;font-size:clamp(2.4rem,5vw,4.25rem);line-height:0.95">
            Estaciones de<br/>
            <span style="color:#F75000">Bomberos</span><br/>
            en México
          </h1>
          <p class="text-sm leading-[1.9] mb-8" style="color:#94A3B8">
            Cuerpos de bomberos municipales y estatales, voluntarios, brigadas industriales y
            unidades ARFF de los 32 estados, con ubicación, contacto y la fuente citada en cada registro.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="#estados" class="btn btn-primary btn-lg">
              Estaciones de bomberos por estado
            </a>
            <a href="/empresas/" class="btn btn-ghost btn-lg">
              Proveedores de equipo contra incendio →
            </a>
          </div>
        </div>

        <div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,0.1)">
          <p class="font-display font-bold text-xs uppercase tracking-widest mb-4" style="color:#4A7599">Tipos de corporación en el directorio</p>
          <ul class="flex flex-col list-none m-0 p-0" style="border-top:1px solid rgba(74,117,153,0.15)">
            {conteoPorTipo.map(t => (
              <li class="flex items-center gap-3 py-3" style="border-bottom:1px solid rgba(74,117,153,0.15)">
                <span class="w-2.5 h-2.5 shrink-0" style={`background:${t.color}`}></span>
                <span class="font-display font-semibold text-sm" style="color:#FFFFFF">{t.label}</span>
              </li>
            ))}
          </ul>
          <p class="text-xs mt-4" style="color:#64748B">Emergencias en todo el país: <strong style="color:#CBD5E1">911</strong>.</p>
          {ultimaVerifLabel && (
            <p class="text-xs mt-2 m-0" style="color:#64748B">
              Registros verificados en <strong style="color:#CBD5E1">{ultimaVerifLabel}</strong>; cada ficha cita su fuente.
            </p>
          )}

          <div class="mt-5 hidden flex-wrap gap-2">
            {conteoPorTipo.map(t => (
              <span class="badge font-display text-[10px]"
                style={`color:${t.color};background:${t.bgColor};border:1px solid ${t.color}40`}>
                {t.label}
              </span>
            ))}
          </div>
        </div>

      </div>
    </div>

    <!-- Línea de acento inferior -->
    <div class="absolute bottom-0 left-0 right-0 h-px" aria-hidden="true"
      style="background:linear-gradient(90deg, transparent, rgba(247,80,0,0.4) 30%, rgba(247,80,0,0.4) 70%, transparent)">
    </div>
  </section>

  <!-- ── QuickLinksBar ───────────────────────────────────────── -->
  <QuickLinksBar />

  <!-- ── Acerca del directorio ──────────────────────────────── -->
  <section class="section-tight" style="background:#070E1A" aria-label="Sobre el directorio">
    <div class="container-site">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4" style="border:1px solid rgba(74,117,153,0.18)">
        {[
          {
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
            title: 'Cobertura nacional',
            text: 'Estaciones municipales, voluntarias e industriales en los 32 estados de México.',
          },
          {
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>`,
            title: 'Datos actualizados',
            text: 'Información verificada con datos públicos de cuerpos de bomberos municipales y estatales.',
          },
          {
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>`,
            title: 'Búsqueda por estado',
            text: 'Filtra por entidad federativa para encontrar las estaciones más cercanas a tu operación.',
          },
          {
            icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
            title: 'Tipos especializados',
            text: 'Municipal, industrial, ARFF aeroportuario, PEMEX/CFE y brigadas voluntarias.',
          },
        ].map((c, i) => (
          <div class="flex flex-col gap-3 p-6"
            style={`background:#0C1825;${i < 3 ? 'border-right:1px solid rgba(74,117,153,0.18);' : ''}`}>
            <span class="w-6 h-6 block" style="color:#FF6B26" set:html={c.icon}/>
            <h2 class="font-display font-bold text-sm uppercase tracking-wider" style="color:#FF6B26">{c.title}</h2>
            <p class="text-xs leading-relaxed" style="color:#64748B">{c.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Tipos de estaciones ────────────────────────────────── -->
  <section class="section" style="background:#040A12" aria-labelledby="tipos-title">
    <div class="container-site">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Clasificación</span>
          <h2 id="tipos-title" class="font-display font-bold"
            style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
            Tipos de cuerpos<br/>
            <span style="color:#F75000">de bomberos.</span>
          </h2>
        </div>
        <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed" style="color:#94A3B8">
            En México los cuerpos de bomberos operan bajo diferentes jurisdicciones y
            especializaciones. Cada tipo tiene competencias, normas aplicables y
            equipamiento distintos. Conoce las diferencias para identificar la unidad
            correcta para cada tipo de emergencia o proveedor de equipo.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {conteoPorTipo.map(t => (
          <div class="flex flex-col gap-3 p-5"
            style={`background:#070E1A;border:1px solid rgba(74,117,153,0.18);border-top:2px solid ${t.color}`}>
            <div class="flex items-center justify-between">
              <span class="font-display font-bold text-xs uppercase tracking-wider" style={`color:${t.color}`}>
                {t.label}
              </span>
              <span class="font-display font-bold text-2xl" style={`color:${t.color}`}>{t.count}</span>
            </div>
            <p class="text-xs leading-relaxed" style="color:#64748B">
              {t.tipo === 'Municipal'   && 'Dependen del ayuntamiento. Atienden la mayor parte de las emergencias ciudadanas. Certificación base: NFPA 1001 y NOM.'}
              {t.tipo === 'Estatal'     && 'Coordinados por la Secretaría de Seguridad Pública estatal. Apoyan a municipios de menor capacidad.'}
              {t.tipo === 'Industrial'  && 'Brigadas privadas o mixtas en parques industriales. Certificadas NFPA 1001 y NOM-002-STPS.'}
              {t.tipo === 'Aeropuerto' && 'Unidades ARFF (Aircraft Rescue and Fire Fighting). Rigen NFPA 403 e ICAO. Categorización según tráfico.'}
              {t.tipo === 'PEMEX'      && 'Brigadas especializadas en hidrocarburos y petroquímica. NFPA 11, 472 y procedimientos PEMEX.'}
              {t.tipo === 'CFE'        && 'Unidades para instalaciones de generación y transmisión eléctrica. Protocolos CFE y NFPA.'}
              {t.tipo === 'Voluntarios' && 'Cuerpos formados por personal no remunerado. Presentes en municipios pequeños o como apoyo a municipales.'}
            </p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ── Directorio por estado ──────────────────────────────── -->
  <section id="estados" class="section" style="background:#070E1A" aria-labelledby="directorio-title">
    <div class="container-site">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-10">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Directorio · 32 estados</span>
          <h2 id="directorio-title" class="font-display font-bold"
            style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
            Selecciona<br/>
            <span style="color:#F75000">tu estado.</span>
          </h2>
        </div>
        <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed mb-5" style="color:#94A3B8">
            Encuentra las estaciones y cuerpos de bomberos de cada entidad federativa.
            Cada tarjeta muestra el número de estaciones listadas, la región y los tipos disponibles.
          </p>
          <!-- Buscador / filtro JS -->
          <div class="relative">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 pointer-events-none" style="color:#4A7599"
              fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/>
            </svg>
            <input
              id="estado-search"
              type="search"
              placeholder="Buscar estado…"
              aria-label="Buscar estado en el directorio"
              class="w-full pl-10 pr-4 py-2.5 text-sm font-display"
              style="background:#0C1825;border:1px solid rgba(74,117,153,0.3);color:#FFFFFF;outline:none"
            />
          </div>
        </div>
      </div>

      <!-- Grid de estados (todas las regiones) -->
      <div id="estados-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
        {estados.map((est) => <EstadoCard est={est} />)}
      </div>

      <!-- Mensaje cuando no hay resultados -->
      <div id="no-results" class="hidden py-16 text-center">
        <p class="font-display font-bold text-lg mb-2" style="color:#4A7599">Sin resultados</p>
        <p class="text-sm" style="color:#64748B">Intenta con otro nombre de estado.</p>
      </div>

    </div>
  </section>

  <!-- ── Estaciones destacadas ──────────────────────────────── -->
  {estacionesDestacadas.length > 0 && (
    <section class="section" style="background:#040A12" aria-labelledby="destacadas-title">
      <div class="container-site">

        <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
          <div>
            <span class="section-eyebrow mb-4 inline-flex">Cuerpos históricos</span>
            <h2 id="destacadas-title" class="font-display font-bold"
              style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
              Cuerpos de bomberos<br/>
              <span style="color:#F75000">con historia.</span>
            </h2>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-px"
          style="background:rgba(74,117,153,0.18);border:1px solid rgba(74,117,153,0.18)">
          {estacionesDestacadas.map((est) => (
            <div class="grid-cell flex flex-col gap-4 p-7" style="background:#070E1A">
              <div class="flex gap-2 flex-wrap">
                <span class="badge badge-fire">{est.tipo}</span>
                {est.fundacion && (
                  <span class="badge badge-gold">Fundado {est.fundacion}</span>
                )}
                <span class="badge badge-dark">{est.estado}</span>
              </div>
              <h3 class="font-display font-bold text-lg leading-snug" style="color:#FFFFFF">{est.nombre}</h3>
              <p class="text-xs leading-relaxed" style="color:#64748B">{est.descripcion}</p>
              <div class="flex flex-wrap gap-2 mt-auto">
                {est.servicios.slice(0, 4).map(s => (
                  <span class="text-[10px] font-display uppercase tracking-wider px-2 py-0.5"
                    style="color:#4A7599;background:rgba(74,117,153,0.12);border:1px solid rgba(74,117,153,0.2)">
                    {s}
                  </span>
                ))}
              </div>
              {est.telefonoEmergencias && (
                <div class="flex items-center gap-2 pt-3" style="border-top:1px solid rgba(74,117,153,0.15)">
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="#F75000" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                  </svg>
                  <span class="font-display font-bold text-sm" style="color:#F75000">
                    Emergencias: {est.telefonoEmergencias}
                  </span>
                  {est.telefono && (
                    <span class="text-xs ml-2" style="color:#4A7599">{est.telefono}</span>
                  )}
                </div>
              )}
            </div>
          ))}
        </div>

      </div>
    </section>
  )}

  <!-- ── Normas y certificaciones ───────────────────────────── -->
  <section class="section" style="background:#070E1A" aria-labelledby="normas-title">
    <div class="container-site">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">

        <div>
          <span class="section-eyebrow mb-4 inline-flex">Marco normativo</span>
          <h2 id="normas-title" class="font-display font-bold mb-6"
            style="color:#FFFFFF;font-size:clamp(1.75rem,3vw,2.75rem);line-height:1.05">
            Normas que rigen a los<br/>
            <span style="color:#F75000">bomberos en México.</span>
          </h2>
          <p class="text-sm leading-[1.9] mb-6" style="color:#94A3B8">
            Los cuerpos de bomberos en México están sujetos a normas nacionales (NOM) e
            internacionales (NFPA). El equipamiento debe cumplir con estas certificaciones
            para garantizar la seguridad del personal y la eficiencia operativa.
          </p>
          <div class="flex flex-col gap-3">
            {[
              { norm: 'NFPA 1001', desc: 'Competencias profesionales para bomberos estructurales Nivel I y II' },
              { norm: 'NFPA 1002', desc: 'Competencias para conductores-operadores de vehículos de bomberos' },
              { norm: 'NFPA 1006', desc: 'Competencias técnicas de rescate — vehículos, altura, agua, minas' },
              { norm: 'NFPA 403',  desc: 'Servicios de rescate de aeronaves y extinción de incendios (ARFF)' },
              { norm: 'NFPA 472',  desc: 'Respuesta a incidentes con materiales peligrosos (HAZMAT)' },
              { norm: 'NOM-002-STPS', desc: 'Condiciones de seguridad en instalaciones — aplica a brigadas industriales' },
            ].map(({ norm, desc }) => (
              <div class="flex items-start gap-4 py-3" style="border-bottom:1px solid rgba(74,117,153,0.12)">
                <span class="badge badge-fire shrink-0 font-display text-[10px]">{norm}</span>
