---
// /estaciones — Hub L2 del directorio nacional de estaciones de bomberos (plantilla L2, 2026-10)
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import L2Sidebar from '@components/l2/L2Sidebar.astro';
import L2Cotizar from '@components/l2/L2Cotizar.astro';
import { bloqueDirectorio, bloqueGuias, bloqueIndustrias, bloqueServicios, bloqueCategorias, type L2Link } from '@lib/l2';
import '@styles/l2.css';
import { SITE, contactoUrl } from '@config/site';
import { tipoConfig, capacidadLabel, TELEFONO_EMERGENCIAS } from '@data/estaciones-config';
import { estadosConEstaciones, todasLasEstaciones, conteoPorTipo, ultimaVerificacion, fechaLarga, urlEstacion } from '@lib/estaciones';

const estados = await estadosConEstaciones();
const todas = await todasLasEstaciones();
const totalEstados = estados.length;

const canonicalURL = `${SITE.url}/estaciones/`;

const seoMeta = {
  title: 'Directorio de Estaciones de Bomberos en México',
  noBrandSuffix: true,
  description:
    'Directorio de cuerpos de bomberos en los 32 estados de México: ubicación, tipo de corporación, servicios y contacto, con la fuente citada en cada registro.',
  canonicalURL,
};

/* ─── Schemas JSON-LD ──────────────────────────────────────── */

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio',    item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Directorio de Estaciones', item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: 'Directorio de Estaciones de Bomberos en México',
  description: seoMeta.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@type': 'Thing', name: 'Cuerpos de Bomberos México' },
  mainEntity: {
    '@type': 'ItemList',
    name: 'Estados con estaciones de bomberos',
    numberOfItems: totalEstados,
    itemListElement: estados.map((est, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: `Estaciones de Bomberos en ${est.nombre}`,
      url: `${SITE.url}/estaciones/${est.slug}/`,
    })),
  },
};

/* Las corporaciones también como ItemList: el CollectionPage solo declaraba
   los 32 estados y dejaba fuera la entidad que la página realmente lista (E-17). */
const estacionesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  '@id': `${canonicalURL}#estaciones`,
  name: 'Estaciones de bomberos del directorio',
  numberOfItems: todas.length,
  itemListElement: todas.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'FireStation',
      name: e.nombre,
      url: `${SITE.url}${urlEstacion(e)}`,
      address: { '@type': 'PostalAddress', addressLocality: e.ciudad, addressRegion: e.estadoNombre, addressCountry: 'MX' },
    },
  })),
};

/* ─── Regiones para agrupar los estados ───────────────────── */
const nombresRegion = ['Noroeste', 'Norte', 'Noreste', 'Centro-Norte', 'Centro-Occidente', 'Centro', 'Sur', 'Peninsular'];
const regiones = nombresRegion
  .map((label) => ({
    label,
    slug: label.toLowerCase().replace(/[^a-z]+/g, '-'),
    estados: estados
      .filter((e) => e.region === label)
      .map((e) => ({
        slug: e.slug,
        nombre: e.nombre,
        region: e.region,
        n: e.estaciones.length,
        tipos: [...new Set(e.estaciones.map((s) => s.tipo))].map((t) => tipoConfig[t]?.label ?? t),
      })),
  }))
  .filter((r) => r.estados.length > 0);

/* ─── Cuerpos con historia ────────────────────────────────── */
const estacionesDestacadas = todas
  .filter((e) => (e.descripcion?.split(/\s+/).length ?? 0) >= 120)
  .slice(0, 4);

const ultimaVerifLabel = fechaLarga(ultimaVerificacion(todas));

/* ─── Conteo por tipo ─────────────────────────────────────── */
const conteoTipos = (await conteoPorTipo())
  .map((t) => ({ tipo: t.tipo, ...tipoConfig[t.tipo], count: t.total }))
  .sort((a, b) => b.count - a.count);

const descripcionTipo: Record<string, string> = {
  Municipal: 'Dependen del ayuntamiento. Atienden la mayor parte de las emergencias ciudadanas. Certificación base: NFPA 1001 y NOM.',
  Estatal: 'Coordinados por la Secretaría de Seguridad Pública estatal. Apoyan a municipios de menor capacidad.',
  Industrial: 'Brigadas privadas o mixtas en parques industriales. Certificadas NFPA 1001 y NOM-002-STPS.',
  Aeropuerto: 'Unidades ARFF (Aircraft Rescue and Fire Fighting). Rigen NFPA 403 e ICAO. Categorización según tráfico.',
  PEMEX: 'Brigadas especializadas en hidrocarburos y petroquímica. NFPA 11, 472 y procedimientos PEMEX.',
  CFE: 'Unidades para instalaciones de generación y transmisión eléctrica. Protocolos CFE y NFPA.',
  Voluntarios: 'Cuerpos formados por personal no remunerado. Presentes en municipios pequeños o como apoyo a municipales.',
};

const normas = [
  { norm: 'NFPA 1001', desc: 'Competencias profesionales para bomberos estructurales Nivel I y II' },
  { norm: 'NFPA 1002', desc: 'Competencias para conductores-operadores de vehículos de bomberos' },
  { norm: 'NFPA 1006', desc: 'Competencias técnicas de rescate — vehículos, altura, agua, minas' },
  { norm: 'NFPA 403', desc: 'Servicios de rescate de aeronaves y extinción de incendios (ARFF)' },
  { norm: 'NFPA 472', desc: 'Respuesta a incidentes con materiales peligrosos (HAZMAT)' },
  { norm: 'NOM-002-STPS', desc: 'Condiciones de seguridad en instalaciones — aplica a brigadas industriales' },
];

/* ─── FAQ ─────────────────────────────────────────────────── */
const faqs = [
  {
    q: '¿A qué número se llama en una emergencia de bomberos?',
    a: 'Al 911, que es el número único de emergencias en todo México y deriva la llamada al cuerpo de bomberos que corresponde. El antiguo 068 sigue operando en algunos municipios, pero ya no es la vía general. Los teléfonos que aparecen en cada ficha son administrativos y no sustituyen al 911 en una emergencia.',
  },
  {
    q: '¿Cuántos cuerpos de bomberos hay en México?',
    a: 'No hay un padrón nacional único. El DENUE del INEGI registra alrededor de 870 unidades económicas de bomberos en el país, y a esa cifra hay que sumar las unidades ARFF de aeropuerto y las brigadas de PEMEX y CFE, que el DENUE no clasifica como tales. Una corporación puede además operar varios cuarteles: este directorio da de alta una ficha por estación física, no por corporación.',
  },
  {
    q: '¿Cuál es la certificación NFPA para bomberos?',
    a: 'La NFPA 1001 es el estándar de competencias profesionales para bomberos estructurales. En México convive con la NOM-002-STPS para brigadas industriales. Los bomberos aeroportuarios siguen la NFPA 403 y la categorización ICAO.',
  },
  {
    q: '¿Cómo se puede registrar una estación en este directorio?',
    a: 'Si representas un cuerpo de bomberos o estación que no aparece en el directorio, puedes contactarnos por WhatsApp o correo electrónico para solicitar el alta sin costo.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

/* ─── Plantilla L2 (homologada con /productos/, 2026-10) ────────── */
const secciones = [
  { id: 'estados', label: 'Por estado' },
  { id: 'tipos', label: 'Tipos de cuerpo' },
  ...(estacionesDestacadas.length > 0 ? [{ id: 'historicos', label: 'Con historia' }] : []),
  { id: 'normas', label: 'Normas' },
  { id: 'preguntas', label: 'Preguntas' },
  { id: 'registro', label: 'Registro' },
];

const GUIAS_ESTACIONES: L2Link[] = [
  { label: 'Normas NFPA y NOM para bomberos', href: '/certificaciones/' },
  { label: 'Cómo equipar una estación de bomberos', href: '/blog/como-equipar-estacion-bomberos-desde-cero/' },
  { label: 'Guía de compra de equipo para bomberos', href: '/blog/guia-compra-equipo-bomberos-nfpa-mexico-2026/' },
  { label: 'EPP del brigadista contra incendio', href: '/blog/epp-brigadista-contra-incendio-que-necesitas/' },
  { label: 'NFPA 1970: la nueva norma de trajes', href: '/blog/nfpa-1970-nueva-norma-trajes-bombero/' },
  { label: 'Bomberos municipales', href: '/industrias/bomberos-municipales/' },
];

const tambien = [
  { label: 'Equipo para cuerpos de bomberos', desc: 'Trajes NFPA, cascos, SCBA y herramientas', href: '/productos/trajes-bombero' },
  { label: 'Industria bomberos municipales', desc: 'Soluciones específicas para ayuntamientos', href: '/industrias/bomberos-municipales' },
  { label: 'Cobertura nacional', desc: '32 estados · industria y protección civil', href: '/cobertura' },
  { label: 'Soporte a licitaciones', desc: 'CompraNet, PEMEX, CFE y municipios', href: '/licitaciones' },
  { label: 'Blog técnico — normas NFPA', desc: 'Guías sobre certificaciones y equipo', href: '/blog' },
  { label: 'Contacto formal', desc: 'Correcciones, dudas y solicitudes de alta', href: '/contacto' },
];

const altaUrl = contactoUrl('Alta de estación en el directorio', 'Hola, represento a un cuerpo de bomberos y quiero dar de alta nuestra estación en el directorio de INPROSEG FIRE. Estación, municipio y estado:');

const trustPoints = [
  { title: 'Cobertura nacional', text: 'Estaciones municipales, voluntarias e industriales en los 32 estados de México.' },
  { title: 'Datos actualizados', text: 'Información verificada con datos públicos de cuerpos de bomberos municipales y estatales.' },
  { title: 'Búsqueda por estado', text: 'Filtra por entidad federativa para encontrar las estaciones más cercanas a tu operación.' },
  { title: 'Tipos especializados', text: 'Municipal, industrial, ARFF aeroportuario, PEMEX/CFE y brigadas voluntarias.' },
];
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema, estacionesSchema, faqSchema]}>

  <!-- ── Breadcrumb ──────────────────────────────────────────── -->
  <nav class="py-3" style="background:var(--c-bg-alt);border-bottom:1px solid var(--c-line)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
        <li><a href="/" class="hover:text-[var(--c-accent)]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:var(--c-text-2)" aria-current="page">Directorio de Estaciones</span></li>
      </ol>
    </div>
  </nav>

  <!-- ── Hero ───────────────────────────────────────────────── -->
  <section class="relative overflow-hidden" style="background:var(--c-bg);padding-block:5rem" aria-labelledby="hero-title">

    <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
      style="background-image:linear-gradient(var(--c-tint) 1px, transparent 1px),linear-gradient(90deg,var(--c-tint) 1px,transparent 1px);background-size:40px 40px;mask-image:radial-gradient(ellipse 80% 80% at 80% 30%, black, transparent)">
    </div>

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <div>
          <span class="section-eyebrow mb-5 inline-flex">Directorio nacional · 32 estados</span>
          <h1 id="hero-title" class="font-display font-bold mb-6"
            style="color:var(--c-ink);font-size:clamp(2.25rem,4.5vw,3.5rem);line-height:1.08">
            Estaciones de<br/>
            <span style="color:var(--c-accent)">Bomberos</span><br/>
            en México
          </h1>
          <p class="text-sm leading-[1.9] mb-8" style="color:var(--c-text-2)">
            Cuerpos de bomberos municipales y estatales, voluntarios, brigadas industriales y
            unidades ARFF de los 32 estados, con ubicación, contacto y la fuente citada en cada registro.
          </p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="#estados" class="btn btn-primary btn-lg">
              Estaciones de bomberos por estado
            </a>
            <a href="/empresas/" class="btn btn-ghost btn-lg">
              Proveedores de equipo contra incendio
            </a>
          </div>
        </div>

        <div class="lg:pl-16" style="border-left:1px solid var(--c-line)">
          <p class="font-display font-bold text-xs uppercase tracking-widest mb-4" style="color:var(--forge-300)">Tipos de corporación en el directorio</p>
          <ul class="flex flex-col list-none m-0 p-0" style="border-top:1px solid var(--c-line)">
            {conteoTipos.map(t => (
              <li class="flex items-center gap-3 py-3" style="border-bottom:1px solid var(--c-line)">
                <span class="w-2.5 h-2.5 shrink-0" style={`background:${t.color}`}></span>
                <span class="font-display font-semibold text-sm" style="color:var(--c-ink)">{t.label}</span>
              </li>
            ))}
          </ul>
          <p class="text-xs mt-4" style="color:var(--c-muted)">Emergencias en todo el país: <strong style="color:var(--c-text)">911</strong>.</p>
          {ultimaVerifLabel && (
            <p class="text-xs mt-2 m-0" style="color:var(--c-muted)">
              Registros verificados en <strong style="color:var(--c-text)">{ultimaVerifLabel}</strong>; cada ficha cita su fuente.
            </p>
          )}
        </div>

      </div>
    </div>

  </section>

  <!-- ── QuickLinksBar ───────────────────────────────────────── -->
  <QuickLinksBar />

  <!-- Pilares -->
  <section class="section-tight" style="background:var(--c-bg-alt)" aria-labelledby="garantias-title">
    <div class="container-site">
      <h2 id="garantias-title" class="sr-only">Sobre el directorio de estaciones</h2>
      <div class="l2-trust">
        {trustPoints.map((t) => (
          <div><h3>{t.title}</h3><p>{t.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Plantilla L2: columna principal + barra lateral -->
  <div class="container-site l2-shell">
    <L2Sidebar
      resumen="Navegar las estaciones"
      secciones={secciones}
      bloques={[bloqueDirectorio(), bloqueGuias(GUIAS_ESTACIONES, 'Normas y equipamiento del bombero'), bloqueIndustrias(), bloqueServicios(), bloqueCategorias()]}
      accion={{ titulo: 'Datos del directorio', texto: '¿Tu estación no aparece o necesita una corrección?', botones: [{ label: 'Registrar estación', href: altaUrl, primario: true }, { label: 'Contacto formal', href: '/contacto' }] }}
    />

    <div class="l2-main">

      <!-- Estados por región -->
      <section id="estados" class="l2-sec" aria-labelledby="directorio-title">
        <header class="l2-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Directorio · 32 estados</span>
          <h2 id="directorio-title" class="l2-h2">Estaciones de bomberos por estado: encuentra tu entidad</h2>
          <p class="l2-lead">
            Encuentra las estaciones y cuerpos de bomberos de cada entidad federativa, agrupados
            por región. Cada estado muestra el número de estaciones listadas y los tipos de corporación disponibles.
          </p>
        </header>
        <div class="es-buscar">
          <input
            id="estado-search"
            type="search"
            placeholder="Buscar estado…"
            aria-label="Buscar estado en el directorio"
            class="w-full px-4 py-2.5 text-sm font-display"
            style="background:var(--c-surface);border:1px solid var(--c-line-strong);color:var(--c-ink);outline:none"
          />
        </div>
        <div id="estados-grid">
          {regiones.map((g) => (
            <div class="l2-fam es-region" id={`region-${g.slug}`} aria-labelledby={`reg-${g.slug}`}>
              <p class="l2-fam-eyebrow">Región</p>
              <h3 id={`reg-${g.slug}`} class="l2-fam-title es-region-title">{g.label}</h3>
              <ul class="es-grid" role="list">
                {g.estados.map((e) => (
                  <li class="es-card estado-card" data-nombre={e.nombre.toLowerCase()} data-region={e.region.toLowerCase()}>
                    <a href={`/estaciones/${e.slug}/`} class="es-name">Estaciones de bomberos en {e.nombre}</a>
                    <p class="es-meta">{e.n} {e.n === 1 ? 'estación' : 'estaciones'} · {e.tipos.join(', ')}</p>
                    <ul class="es-links" role="list">
                      <li><a href={`/empresas/estado/${e.slug}/`}>Empresas de equipo contra incendio en {e.nombre}</a></li>
                    </ul>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div id="no-results" class="hidden py-12 text-center">
          <p class="font-display font-bold text-lg mb-2" style="color:var(--forge-300)">Sin resultados</p>
          <p class="text-sm" style="color:var(--c-muted)">Intenta con otro nombre de estado.</p>
        </div>
      </section>

      <!-- Tipos de cuerpos de bomberos -->
      <section id="tipos" class="l2-sec" aria-labelledby="tipos-title">
        <header class="l2-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Clasificación</span>
          <h2 id="tipos-title" class="l2-h2">Tipos de cuerpos de bomberos en México</h2>
          <p class="l2-lead">
            En México los cuerpos de bomberos operan bajo diferentes jurisdicciones y
            especializaciones. Cada tipo tiene competencias, normas aplicables y
            equipamiento distintos. Conoce las diferencias para identificar la unidad
            correcta para cada tipo de emergencia o proveedor de equipo.
          </p>
        </header>
        <div class="l2-factores">
          {conteoTipos.map((t) => (
            <article>
              <h3><span style={`color:${t.color}`}>{t.label}</span> <span class="es-n">{t.count}</span></h3>
              <p>{descripcionTipo[t.tipo]}</p>
            </article>
          ))}
        </div>
      </section>

      <!-- Cuerpos con historia -->
      {estacionesDestacadas.length > 0 && (
        <section id="historicos" class="l2-sec" aria-labelledby="destacadas-title">
          <header class="l2-sec-head">
            <span class="section-eyebrow mb-4 inline-flex">Cuerpos históricos</span>
            <h2 id="destacadas-title" class="l2-h2">Cuerpos de bomberos con historia</h2>
          </header>
          <div class="es-hist">
            {estacionesDestacadas.map((est) => (
              <article>
                <div class="flex gap-2 flex-wrap">
                  <span class="badge badge-fire">{est.tipo}</span>
                  {est.fundacion && <span class="badge badge-gold">Fundado {est.fundacion}</span>}
                  <span class="badge badge-dark">{est.estadoNombre}</span>
                </div>
                <h3><a href={urlEstacion(est)}>{est.nombre}</a></h3>
                <p class="es-hist-text">{est.descripcion}</p>
                <div class="flex flex-wrap gap-2 mt-auto">
                  {est.servicios.slice(0, 4).map(s => (
                    <span class="text-[10px] font-display uppercase tracking-wider px-2 py-0.5"
                      style="color:var(--forge-300);background:var(--c-line);border:1px solid var(--c-line)">
                      {capacidadLabel(s)}
                    </span>
                  ))}
                </div>
                {TELEFONO_EMERGENCIAS && (
                  <p class="es-hist-tel">
                    <strong>Emergencias: {TELEFONO_EMERGENCIAS}</strong>
                    {est.telefono && <span>{est.telefono}</span>}
                  </p>
                )}
              </article>
            ))}
          </div>
        </section>
      )}

      <!-- Normas -->
      <section id="normas" class="l2-sec" aria-labelledby="normas-title">
        <header class="l2-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Marco normativo</span>
          <h2 id="normas-title" class="l2-h2">Normas que rigen a los bomberos en México</h2>
          <p class="l2-lead">
            Los cuerpos de bomberos en México están sujetos a normas nacionales (NOM) e
            internacionales (NFPA). El equipamiento debe cumplir con estas certificaciones
            para garantizar la seguridad del personal y la eficiencia operativa.
          </p>
        </header>
        <table class="l2-tabla">
          <caption class="sr-only">Normas que rigen a los cuerpos de bomberos en México</caption>
          <thead><tr><th scope="col">Norma</th><th scope="col">Qué regula</th></tr></thead>
          <tbody>
            {normas.map(({ norm, desc }) => (
              <tr><th scope="row">{norm}</th><td>{desc}</td></tr>
            ))}
          </tbody>
        </table>
        <div class="l2-hub">
          <a href="/certificaciones" class="btn btn-outline btn-sm">Normas NFPA y NOM para bomberos</a>
        </div>
      </section>

      <!-- Preguntas frecuentes -->
      <section id="preguntas" class="l2-sec" aria-labelledby="faq-title">
        <header class="l2-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Preguntas frecuentes</span>
          <h2 id="faq-title" class="l2-h2">Preguntas frecuentes sobre los cuerpos de bomberos en México</h2>
        </header>
        <div class="l2-faq">
          {faqs.map((f) => (
            <details>
              <summary><span>{f.q}</span><span class="l2-faq-mas" aria-hidden="true">+</span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Registro + cross-links -->
      <L2Cotizar
        id="registro"
        eyebrow="¿Tu estación no aparece?"
        titulo="Registra tu cuerpo"
        destacado="de bomberos."
        texto="Si representas un cuerpo de bomberos, brigada o unidad especializada que aún no aparece en el directorio, contáctanos. El alta es gratuita y ayuda a que más ciudadanos e instituciones encuentren tu unidad."
        cta={{ label: 'Registrar estación', href: altaUrl }}
        tambien={tambien}
      />

    </div>
  </div>

  <!-- ── JS: filtro de estados ──────────────────────────────── -->
  <script>
    const input    = document.getElementById('estado-search') as HTMLInputElement | null;
    const grid     = document.getElementById('estados-grid');
    const noResult = document.getElementById('no-results');

    if (input && grid && noResult) {
      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        let visible = 0;

        grid.querySelectorAll<HTMLElement>('.es-region').forEach((reg) => {
          let enRegion = 0;
          reg.querySelectorAll<HTMLElement>('.estado-card').forEach((card) => {
            const nombre = card.dataset.nombre ?? '';
            const region = card.dataset.region ?? '';
            const match  = !q || nombre.includes(q) || region.includes(q);
            card.style.display = match ? '' : 'none';
            if (match) enRegion++;
          });
          reg.style.display = enRegion > 0 ? '' : 'none';
          visible += enRegion;
        });

        noResult.classList.toggle('hidden', visible > 0);
      });
    }
  </script>

</BaseLayout>

<style>
  .es-buscar { max-width: 28rem; margin-bottom: 2rem; }
