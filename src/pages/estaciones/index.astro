  <!-- ── JS: filtro de estados ──────────────────────────────── -->
  <script>
    const input    = document.getElementById('estado-search') as HTMLInputElement | null;
    const grid     = document.getElementById('estados-grid');
    const noResult = document.getElementById('no-results');

    if (input && grid && noResult) {
      input.addEventListener('input', () => {
        const q = input.value.trim().toLowerCase();
        const cards = grid.querySelectorAll<HTMLElement>('.estado-card');
        let visible = 0;

        cards.forEach((card) => {
          const nombre = card.dataset.nombre ?? '';
          const region = card.dataset.region ?? '';
          const match  = !q || nombre.includes(q) || region.includes(q);
          card.style.display = match ? '' : 'none';
          if (match) visible++;
        });

        noResult.classList.toggle('hidden', visible > 0);
      });
    }
  </script>

</BaseLayout>
