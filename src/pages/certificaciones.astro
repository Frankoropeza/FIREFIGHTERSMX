---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { SITE } from '@config/site';

const canonicalURL = `${SITE.url}/certificaciones/`;

const seoMeta = {
  title: `Guía de Normas NFPA y NOM para Equipo Contra Incendio`,
  description:
    'Guía de normas NFPA, NOM e ISO relacionadas con equipo para bomberos, extintores y sistemas contra incendio en México, y cómo verificar documentos.',
  canonicalURL,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Normas y certificación', item: canonicalURL },
  ],
};

const grupos = [
  {
    grupo: 'Equipo de protección personal (NFPA)',
    eyebrow: 'Protección personal',
    items: [
      { norm: 'NFPA 1970', title: 'Conjuntos estructurales y SCBA', desc: 'Referencia de NFPA para conjuntos de protección estructural y de proximidad, ropa de trabajo, SCBA de circuito abierto y PASS.' },
      { norm: 'NFPA 1850', title: 'Selección, cuidado y mantenimiento', desc: 'Referencia de NFPA para selección, cuidado y mantenimiento de conjuntos estructurales, de proximidad y equipos SCBA.' },
      { norm: 'NFPA 1950', title: 'Trajes para incendios forestales', desc: 'Protective Clothing and Equipment for Wildland Fire Fighting, para operaciones de vegetación e interfaz.' },
      { norm: 'NFPA 1990', title: 'Trajes HAZMAT', desc: 'Equipos de protección para materiales peligrosos, Nivel A y Nivel B.' },
    ],
  },
  {
    grupo: 'Sistemas y normas mexicanas',
    eyebrow: 'Sistemas y NOM',
    items: [
      { norm: 'NFPA 13', title: 'Sistemas de rociadores', desc: 'Standard for the Installation of Sprinkler Systems.' },
      { norm: 'NFPA 72', title: 'Sistemas de alarma', desc: 'National Fire Alarm and Signaling Code.' },
      { norm: 'NOM-002-STPS-2010', title: 'Norma mexicana principal', desc: 'Condiciones de seguridad, prevención y protección contra incendios en centros de trabajo.' },
      { norm: 'NOM-154-SCFI-2005', title: 'Mantenimiento y recarga de extintores', desc: 'Establece requerimientos y procedimientos para prestadores de mantenimiento y recarga de extintores portátiles y móviles sobre ruedas.' },
      { norm: 'ISO 9001', title: 'Sistemas de gestión de calidad', desc: 'Referencia para sistemas de gestión. Una certificación de la empresa no demuestra por sí sola el cumplimiento de un producto.' },
    ],
  },
];
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema]}>

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
        <li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:#94A3B8" aria-current="page">Certificaciones</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background:#040A12;padding-block:5rem">
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" style="background:radial-gradient(ellipse 80% 70% at 90% 30%, rgba(247,80,0,0.08) 0%, transparent 65%)" aria-hidden="true"></div>

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="section-eyebrow mb-5 inline-flex">Normatividad · NFPA y NOM</span>
          <h1 class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2.5rem,5.5vw,4.5rem);line-height:0.95">
            Normas y<br/>
            <span style="color:#F75000">certificación</span>
          </h1>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="#verificacion" class="btn btn-primary btn-lg">Cómo verificar documentación</a>
            <a href="/empresas/" class="btn btn-ghost btn-lg">Buscar empresas del sector</a>
          </div>
        </div>
        <div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,0.1)">
          <p class="text-sm leading-[1.9] mb-5" style="color:#94A3B8">
            Las normas NFPA, NOM e ISO tienen alcances distintos y no certifican por sí mismas
            todo un catálogo. Aquí explicamos qué cubre cada referencia y qué documentación
            conviene solicitar a una empresa o fabricante.
          </p>
          <p class="text-sm leading-[1.9] mb-6" style="color:#64748B">
            La presencia de una norma en esta guía no demuestra que una empresa, marca o producto
            específico la cumpla. Verifica el modelo exacto, el organismo emisor, la vigencia y
            el alcance documental antes de comprar o contratar.
          </p>
          <div class="flex flex-wrap gap-2">
            {['NFPA 1970','NFPA 1850','NFPA 1950','NOM-002-STPS','NOM-154-SCFI','ISO 9001'].map(n => (
              <span class="badge badge-dark font-display text-[10px]">{n}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-px" style="background:linear-gradient(90deg, transparent, rgba(247,80,0,0.4) 30%, rgba(247,80,0,0.4) 70%, transparent)" aria-hidden="true"></div>
  </section>

  <!-- Accesos rápidos -->
  <QuickLinksBar />

  <!-- Grupos de normas -->
  {grupos.map((g, gi) => (
    <section class="section" style={`background:${gi % 2 === 0 ? '#040A12' : '#070E1A'}`} aria-label={g.grupo}>
      <div class="container-site">
        <div class="mb-10">
          <span class="section-eyebrow mb-4 inline-flex">{g.eyebrow}</span>
          <h2 class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">{g.grupo}</h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {g.items.map((cert) => (
            <article class="norm-card flex flex-col gap-3 p-6" style="background:#080F1A;border:1px solid rgba(74,117,153,0.18)">
              <span class="badge badge-fire w-fit">{cert.norm}</span>
              <h3 class="font-display font-bold text-lg leading-tight" style="color:#FFFFFF">{cert.title}</h3>
              <p class="text-xs leading-relaxed" style="color:#64748B">{cert.desc}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- CTA + cross-links -->
  <section id="verificacion" class="section" style="background:#040A12" aria-labelledby="cert-cross-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Verificación documental</span>
          <h2 id="cert-cross-title" class="font-display font-bold mb-6" style="color:#FFFFFF;font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
            Qué revisar antes de<br/>
            <span style="color:#F75000">aceptar un certificado.</span>
          </h2>
          <p class="text-sm leading-relaxed mb-8" style="color:#94A3B8">
            Identifica el requisito aplicable, la edición solicitada, el producto o proceso cubierto,
            el organismo emisor y la vigencia. La referencia a una norma en una ficha comercial no
            sustituye el documento correspondiente ni demuestra que todas las configuraciones cumplan.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href="https://www.nfpa.org/1970" target="_blank" rel="noopener" class="btn btn-primary">Consultar NFPA 1970</a>
            <a href="https://dof.gob.mx/normasOficiales/4228/stps.htm" target="_blank" rel="noopener" class="btn btn-ghost">Consultar NOM-002-STPS-2010</a>
          </div>
        </div>
        <div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,0.15)">
          <h2 class="font-display font-bold text-sm uppercase tracking-widest mb-5" style="color:var(--forge-300)">
            También te puede servir
          </h2>
          <ul class="flex flex-col list-none m-0 p-0" style="border-top:1px solid rgba(74,117,153,0.15)">
            {[
              { label: 'Guías de productos', desc: 'Categorías, aplicaciones y criterios de comparación', href: '/productos' },
              { label: 'Blog: NFPA 1970, la nueva norma', desc: 'Qué cambió en trajes estructurales', href: '/blog/nfpa-1970-nueva-norma-trajes-bombero' },
              { label: 'Guía de licitaciones', desc: 'Cómo revisar evidencia por partida', href: '/licitaciones' },
              { label: 'Guías por industria', desc: 'Riesgos y referencias que conviene revisar', href: '/industrias' },
              { label: 'Directorio nacional', desc: 'Empresas por giro y estado', href: '/empresas' },
            ].map((l) => (
              <li style="border-bottom:1px solid rgba(74,117,153,0.15)">
                <a href={l.href} class="group flex items-center justify-between gap-4 py-4">
                  <span class="flex flex-col gap-0.5">
                    <span class="font-display font-semibold text-sm group-hover:text-[#FF6B26]" style="color:#FFFFFF">{l.label}</span>
                    <span class="text-xs" style="color:#64748B">{l.desc}</span>
                  </span>
                  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="var(--forge-300)" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
                  </svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .norm-card:hover { border-color: rgba(247, 80, 0, 0.45) !important; }
</style>
