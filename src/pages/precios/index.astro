---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { SITE } from '@config/site';

const canonicalURL = `${SITE.url}/precios/`;

const seoMeta = {
  title: 'Precios de Equipo para Bomberos: Cómo Cotizar con FIREFIGHTERS MX',
  description:
    'Precios de equipo para bomberos y contra incendio en México: qué cambia el costo y qué datos enviarnos para cotizar trajes, SCBA, extintores y sistemas.',
  canonicalURL,
};

const factores = [
  { title: 'Tipo y configuración', text: 'La familia de equipo, capacidad, materiales, accesorios y compatibilidad con otros componentes cambian el alcance de una propuesta.' },
  { title: 'Documentación solicitada', text: 'Fichas técnicas, manuales, trazabilidad y evidencia de cumplimiento deben definirse desde la solicitud y verificarse antes de comprar.' },
  { title: 'Cantidad y tallas', text: 'El número de unidades, la variedad de tallas y la necesidad de repuestos influyen en la integración de una cotización comparable.' },
  { title: 'Logística y ubicación', text: 'Origen del equipo, destino, maniobras, seguros y condiciones de entrega pueden formar parte del costo total del proyecto.' },
  { title: 'Instalación o puesta en marcha', text: 'Los sistemas que requieren ingeniería, instalación, pruebas o capacitación deben separar esos conceptos del costo del equipo.' },
  { title: 'Mantenimiento y ciclo de vida', text: 'Consumibles, inspecciones, recargas, refacciones y servicio posterior ayudan a comparar el costo más allá de la compra inicial.' },
];

const categorias = [
  { title: 'Extintores', text: 'Define agente, capacidad, aplicación, cantidad y servicio requerido.', guide: '/productos/extintores/', ancla: 'Venta de extintores' },
  { title: 'Sistemas contra incendio', text: 'Separa ingeniería, suministro, instalación, pruebas y mantenimiento.', guide: '/productos/sistemas-ci/', ancla: 'Sistemas contra incendio' },
  { title: 'Trajes para bomberos', text: 'Especifica tipo de operación, tallas, configuración y documentación requerida.', guide: '/productos/trajes-bombero/', ancla: 'Trajes de bombero' },
  { title: 'Equipos SCBA', text: 'Indica duración nominal, cilindros, compatibilidad, accesorios y soporte necesario.', guide: '/productos/equipos-scba/', ancla: 'Equipo de respiración autónoma' },
  { title: 'Cascos y EPP', text: 'Detalla uso, tallas, accesorios, compatibilidad y norma solicitada.', guide: '/productos/cascos-nfpa/', ancla: 'Cascos de bombero' },
  { title: 'Herramientas de rescate', text: 'Compara tecnología, fuente de energía, accesorios, capacitación y mantenimiento.', guide: '/productos/herramientas-rescate/', ancla: 'Herramientas de rescate' },
];

const datosCotizacion = [
  'Equipo, servicio o sistema que necesitas comparar.',
  'Aplicación, riesgo o escenario operativo previsto.',
  'Cantidad, capacidades, tallas o configuraciones.',
  'Ciudad y estado de entrega o ejecución.',
  'Fecha requerida y condiciones logísticas conocidas.',
  'Normas, fichas, pruebas o documentos exigidos por tu proyecto.',
  'Instalación, capacitación, mantenimiento o refacciones que deban cotizarse por separado.',
];

const faqs = [
  { q: '¿Por qué VIGILES no publica una lista de precios fijos?', a: 'Porque el precio de cada partida cambia con la marca, la configuración, las tallas, la cantidad, la documentación solicitada y el destino de entrega. Cotizamos cada solicitud por escrito, con disponibilidad y condiciones de entrega.' },
  { q: '¿Cómo puedo comparar cotizaciones de equipo contra incendio?', a: 'Pide todas las propuestas sobre el mismo alcance y compara por separado equipo, accesorios, impuestos, entrega, instalación, pruebas, capacitación, mantenimiento, garantía y documentación. Revisa también exclusiones y vigencia de cada propuesta.' },
  { q: '¿El precio más bajo representa la misma solución?', a: 'No necesariamente. Dos propuestas pueden incluir capacidades, materiales, accesorios, documentación o servicios diferentes. La comparación debe hacerse sobre especificaciones y alcances equivalentes.' },
  { q: '¿Cómo solicito una cotización a VIGILES?', a: 'Envíanos el alcance desde la página de cotización o por correo: equipo o sistema, cantidades, tallas o configuraciones, norma requerida, documentos para licitación y estado de entrega. Enviamos a los 32 estados.' },
  { q: '¿Qué debo verificar antes de aceptar una cotización?', a: 'Confirma especificaciones, cantidades, documentación, impuestos, forma de pago, entrega, instalación, garantía y servicio posterior. Cuando una norma sea indispensable, solicita evidencia aplicable al modelo y configuración cotizados.' },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Precios de equipo', item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: seoMeta.title,
  description: seoMeta.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })),
};
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema, faqSchema]}>
  <nav class="py-3" style="background:var(--c-bg-alt);border-bottom:1px solid var(--c-line)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
        <li><a href="/" class="hover:text-[var(--c-accent)]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:var(--c-text-2)" aria-current="page">Precios de equipo</span></li>
      </ol>
    </div>
  </nav>

  <section class="relative overflow-hidden" style="background:var(--c-bg);padding-block:5rem">
    <div class="container-site relative z-10">
      <div class="max-w-4xl">
        <span class="section-eyebrow mb-5 inline-flex">Guía de compra · México</span>
        <h1 class="font-display font-bold mb-6" style="color:var(--c-ink);font-size:clamp(2.25rem,4.5vw,3.5rem);line-height:1.08">
          Precios de equipo<br/>
          <span style="color:var(--c-accent)">para bomberos.</span>
        </h1>
        <p class="text-base leading-[1.9] mb-4 max-w-3xl" style="color:var(--c-text-2)">
          El precio de equipo para bomberos y contra incendios depende de la especificación, cantidad, documentación, logística y servicios incluidos. Esta página explica qué información reunir para que te enviemos una cotización completa y comparable.
        </p>
        <p class="text-sm leading-[1.9] mb-8 max-w-3xl" style="color:var(--c-muted)">
          No publicamos una lista de precios fijos: cada partida se cotiza por escrito con disponibilidad, condiciones de entrega y la documentación que requiera tu proyecto.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/cotizacion/" class="btn btn-primary btn-lg">Solicitar cotización</a>
          <a href="/productos/" class="btn btn-ghost btn-lg">Equipo para bomberos NFPA</a>
        </div>
      </div>
    </div>
  </section>

  <QuickLinksBar />

  <section class="section" style="background:var(--c-bg-alt)" aria-labelledby="factores-title">
    <div class="container-site">
      <div class="max-w-3xl mb-10">
        <span class="section-eyebrow mb-4 inline-flex">Costo total</span>
        <h2 id="factores-title" class="font-display font-bold mb-4" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
          Factores que cambian el precio<br/>
          <span style="color:var(--c-accent)">del equipo contra incendio.</span>
        </h2>
        <p class="text-sm leading-relaxed" style="color:var(--c-text-2)">Para comparar propuestas, define primero un alcance común. Un importe aislado no permite saber si dos propuestas cubren la misma solución.</p>
      </div>
      <div class="card-grid card-grid--cells" >
        {factores.map((factor) => (
          <article class="p-7" style="background:var(--c-bg-alt)">
            <h3 class="font-display font-bold text-lg mb-3" style="color:var(--c-ink)">{factor.title}</h3>
            <p class="text-xs leading-relaxed m-0" style="color:var(--c-muted)">{factor.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--c-bg)" aria-labelledby="categorias-title">
    <div class="container-site">
      <div class="max-w-3xl mb-10">
        <span class="section-eyebrow mb-4 inline-flex">Por categoría</span>
        <h2 id="categorias-title" class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">Qué definir antes de<br/><span style="color:var(--c-accent)">solicitar precios.</span></h2>
      </div>
      <div class="card-grid">
        {categorias.map((categoria) => (
          <article class="flex flex-col p-7" style="background:var(--c-bg-alt);border:1px solid var(--c-line)">
            <h3 class="font-display font-bold text-xl mb-3" style="color:var(--c-ink)">{categoria.title}</h3>
            <p class="text-xs leading-relaxed mb-6 flex-1" style="color:var(--c-muted)">{categoria.text}</p>
            <div class="flex flex-wrap gap-2">
              <a href={categoria.guide} class="btn btn-sm btn-dark">{categoria.ancla}</a>
              <a href="/cotizacion/" class="btn btn-sm btn-outline">Cotizar</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--c-bg-alt)" aria-labelledby="datos-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Solicitud comparable</span>
          <h2 id="datos-title" class="font-display font-bold mb-5" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">Datos para pedir una<br/><span style="color:var(--c-accent)">cotización completa.</span></h2>
          <p class="text-sm leading-relaxed" style="color:var(--c-text-2)">Con esta información preparamos una propuesta completa, sin supuestos que después cambien el importe final.</p>
        </div>
        <ol class="flex flex-col list-none m-0 p-0" style="border-top:1px solid var(--c-line)">
          {datosCotizacion.map((dato, index) => (
            <li class="flex items-start gap-4 py-4" style="border-bottom:1px solid var(--c-line)">
              <span class="font-display font-bold text-sm shrink-0" style="color:var(--c-accent)"></span>
              <span class="text-sm leading-relaxed" style="color:var(--c-text-2)">{dato}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section" style="background:var(--c-bg)" aria-labelledby="faq-precios-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Preguntas frecuentes</span>
          <h2 id="faq-precios-title" class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">Cómo comparar precios<br/><span style="color:var(--c-accent)">sin perder alcance.</span></h2>
        </div>
        <div style="border:1px solid var(--c-line);background:var(--c-surface)">
          {faqs.map((faq) => (
            <details class="faq-item group" style="border-bottom:1px solid var(--c-line)">
              <summary class="flex items-start justify-between gap-4 cursor-pointer select-none list-none p-6">
                <h3 class="font-display font-semibold pr-2 m-0" style="color:var(--c-ink);font-size:0.875rem;line-height:1.375">{faq.q}</h3>
                <span class="faq-icon shrink-0" style="color:var(--c-accent)">+</span>
              </summary>
              <p class="px-6 pb-6 text-sm leading-relaxed" style="color:var(--c-muted)">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section style="background:var(--c-accent);padding-block:4rem" aria-label="Solicitar cotización de equipo para bomberos">
    <div class="container-site">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-8">
        <div>
          <p class="text-xs font-display font-bold uppercase tracking-[0.2em] mb-3" style="color:rgba(255,255,255,0.7)">Distribuidor autorizado · envíos a los 32 estados</p>
          <h2 class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.75rem,3.5vw,2.5rem);line-height:1.1">Cotiza tu equipo<br/>con VIGILES.</h2>
        </div>
        <a href="/cotizacion/" class="btn" style="background:#FFFFFF;color:var(--c-accent);font-weight:700">Solicitar cotización</a>
      </div>
    </div>
  </section>
</BaseLayout>
