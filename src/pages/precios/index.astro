---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import LineaCard from '@components/products/LineaCard.astro';
import L2Sidebar from '@components/l2/L2Sidebar.astro';
import L2Cotizar from '@components/l2/L2Cotizar.astro';
import { bloqueCategorias, bloqueMarcas, bloqueIndustrias, bloqueServicios, bloqueGuias, anchoFila, type L2Link } from '@lib/l2';
import '@styles/l2.css';
import { SITE } from '@config/site';

const canonicalURL = `${SITE.url}/precios/`;

const seoMeta = {
  title: 'Precios de Equipo para Bomberos en México',
  description:
    'Precios de equipo para bomberos y contra incendio en México: qué cambia el costo y qué datos enviarnos para cotizar trajes, SCBA, extintores y sistemas.',
  canonicalURL,
};

const C = '/images/catalogo/';

const factores = [
  { title: 'Tipo y configuración', text: 'La familia de equipo, capacidad, materiales, accesorios y compatibilidad con otros componentes cambian el alcance de una propuesta.' },
  { title: 'Documentación solicitada', text: 'Fichas técnicas, manuales, trazabilidad y evidencia de cumplimiento deben definirse desde la solicitud y verificarse antes de comprar.' },
  { title: 'Cantidad y tallas', text: 'El número de unidades, la variedad de tallas y la necesidad de repuestos influyen en la integración de una cotización comparable.' },
  { title: 'Logística y ubicación', text: 'Origen del equipo, destino, maniobras, seguros y condiciones de entrega pueden formar parte del costo total del proyecto.' },
  { title: 'Instalación o puesta en marcha', text: 'Los sistemas que requieren ingeniería, instalación, pruebas o capacitación deben separar esos conceptos del costo del equipo.' },
  { title: 'Mantenimiento y ciclo de vida', text: 'Consumibles, inspecciones, recargas, refacciones y servicio posterior ayudan a comparar el costo más allá de la compra inicial.' },
];

/* Categorías: texto y botón principal conservados; se añaden imagen y guías de costo/compra */
const categorias = [
  {
    title: 'Extintores', norma: 'NOM · NFPA 10',
    text: 'Define agente, capacidad, aplicación, cantidad y servicio requerido.',
    href: '/productos/extintores/', cta: 'Venta de extintores',
    image: `${C}extintores.avif`, alt: 'Extintores portátiles para cotizar',
    hijas: [
      { label: 'Tipos de extintores en México', href: '/blog/tipos-de-extintores-mexico/' },
      { label: 'PQS ABC, CO₂ y tipo K', href: '/blog/pqs-abc-vs-co2-vs-tipo-k-extintores/' },
      { label: 'Cómo elegir un servicio de recarga', href: '/blog/elegir-servicio-de-recarga-de-extintores/' },
      { label: 'Mantenimiento y recarga', href: '/servicios/mantenimiento/' },
    ],
  },
  {
    title: 'Sistemas contra incendio', norma: 'NFPA 13 · NFPA 72',
    text: 'Separa ingeniería, suministro, instalación, pruebas y mantenimiento.',
    href: '/productos/sistemas-ci/', cta: 'Sistemas contra incendio',
    image: `${C}rociadores.avif`, alt: 'Rociador de un sistema contra incendio',
    hijas: [
      { label: 'NFPA 13, 13R y 13D', href: '/blog/nfpa-13-vs-13r-vs-13d-rociadores/' },
      { label: 'Memoria de cálculo hidráulico', href: '/blog/memoria-calculo-hidraulico-rociadores-nfpa-13/' },
      { label: 'FM-200 o Novec 1230', href: '/blog/fm200-vs-novec-1230-agente-limpio/' },
      { label: 'Instalación de sistemas contra incendio', href: '/servicios/instalacion-sistemas-ci/' },
    ],
  },
  {
    title: 'Trajes para bomberos', norma: 'NFPA 1970',
    text: 'Especifica tipo de operación, tallas, configuración y documentación requerida.',
    href: '/productos/trajes-bombero/', cta: 'Trajes de bombero',
    image: `${C}trajes-bombero.avif`, alt: 'Traje estructural de bombero para cotizar',
    hijas: [
      { label: 'Cuánto cuesta un traje de bombero', href: '/blog/cuanto-cuesta-un-traje-de-bombero/' },
      { label: 'Cómo elegir un traje NFPA', href: '/blog/como-elegir-traje-bombero-nfpa/' },
      { label: 'PBI Matrix frente a Nomex', href: '/blog/pbi-matrix-vs-nomex-trajes-bombero/' },
      { label: 'Especificaciones en licitaciones', href: '/blog/especificaciones-traje-bombero-licitaciones/' },
    ],
  },
  {
    title: 'Equipos SCBA', norma: 'NFPA 1970',
    text: 'Indica duración nominal, cilindros, compatibilidad, accesorios y soporte necesario.',
    href: '/productos/equipos-scba/', cta: 'Equipo de respiración autónoma',
    image: `${C}equipos-scba.avif`, alt: 'Equipo de respiración autónoma SCBA para cotizar',
    hijas: [
      { label: 'Guía de compra de SCBA', href: '/blog/guia-compra-scba-equipos-respiracion-autonoma/' },
      { label: 'MSA G1 frente a Dräger PSS 7000', href: '/blog/msa-g1-vs-drager-pss7000-scba/' },
      { label: 'Cilindros de fibra de carbono o acero', href: '/blog/cilindros-scba-fibra-carbono-vs-acero/' },
      { label: 'Prueba hidrostática de cilindros', href: '/blog/prueba-hidrostatica-cilindros-scba-nfpa/' },
    ],
  },
  {
    title: 'Cascos y EPP', norma: 'NFPA 1970',
    text: 'Detalla uso, tallas, accesorios, compatibilidad y norma solicitada.',
    href: '/productos/cascos-nfpa/', cta: 'Cascos de bombero',
    image: `${C}cascos-nfpa.avif`, alt: 'Cascos de bombero certificados para cotizar',
    hijas: [
      { label: 'Comparativa de cascos 2026', href: '/blog/cascos-bombero-comparativa-marcas-2026/' },
      { label: 'Casco europeo o americano', href: '/blog/casco-bombero-europeo-vs-americano/' },
      { label: 'Compatibilidad de casco y SCBA', href: '/blog/compatibilidad-casco-scba-bomberos/' },
      { label: 'EPP del brigadista', href: '/blog/epp-brigadista-contra-incendio-que-necesitas/' },
    ],
  },
  {
    title: 'Herramientas de rescate', norma: 'NFPA 1936',
    text: 'Compara tecnología, fuente de energía, accesorios, capacitación y mantenimiento.',
    href: '/productos/herramientas-rescate/', cta: 'Herramientas de rescate',
    image: `${C}herramientas-rescate.avif`, alt: 'Herramienta hidráulica de rescate para cotizar',
    hijas: [
      { label: 'Holmatro frente a Lukas', href: '/blog/holmatro-vs-lukas-herramientas-rescate/' },
      { label: 'Holmatro, Hurst y Weber', href: '/blog/herramientas-hidraulicas-rescate-holmatro-hurst-weber/' },
      { label: 'NFPA 1936 y excarcelación', href: '/blog/nfpa-1936-herramientas-rescate-excarcelacion/' },
      { label: 'Capacitación certificada', href: '/servicios/capacitacion/' },
    ],
  },
];

const datosCotizacion = [
  'Equipo, servicio o sistema que necesitas comparar.',
  'Aplicación, riesgo o escenario operativo previsto.',
  'Cantidad, capacidades, tallas o configuraciones.',
  'Ciudad y estado de entrega o ejecución.',
  'Fecha requerida y condiciones logísticas conocidas.',
  'Normas, fichas, pruebas o documentos exigidos por tu proyecto.',
  'Instalación, capacitación, mantenimiento o refacciones que deban cotizarse por separado.',
];

const faqs = [
  { q: '¿Por qué VIGILES no publica una lista de precios fijos?', a: 'Porque el precio de cada partida cambia con la marca, la configuración, las tallas, la cantidad, la documentación solicitada y el destino de entrega. Cotizamos cada solicitud por escrito, con disponibilidad y condiciones de entrega.' },
  { q: '¿Cómo puedo comparar cotizaciones de equipo contra incendio?', a: 'Pide todas las propuestas sobre el mismo alcance y compara por separado equipo, accesorios, impuestos, entrega, instalación, pruebas, capacitación, mantenimiento, garantía y documentación. Revisa también exclusiones y vigencia de cada propuesta.' },
  { q: '¿El precio más bajo representa la misma solución?', a: 'No necesariamente. Dos propuestas pueden incluir capacidades, materiales, accesorios, documentación o servicios diferentes. La comparación debe hacerse sobre especificaciones y alcances equivalentes.' },
  { q: '¿Cómo solicito una cotización a VIGILES?', a: 'Envíanos el alcance desde la página de cotización o por correo: equipo o sistema, cantidades, tallas o configuraciones, norma requerida, documentos para licitación y estado de entrega. Enviamos a los 32 estados.' },
  { q: '¿Qué debo verificar antes de aceptar una cotización?', a: 'Confirma especificaciones, cantidades, documentación, impuestos, forma de pago, entrega, instalación, garantía y servicio posterior. Cuando una norma sea indispensable, solicita evidencia aplicable al modelo y configuración cotizados.' },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Precios de equipo', item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: 'Precios de equipo para bomberos: cómo cotizar',
  description: seoMeta.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: categorias.length,
    itemListElement: categorias.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.title, url: `${SITE.url}${c.href}` })),
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })),
};

/* ─── Plantilla L2 (homologada con /productos/, 2026-10) ────────── */
const secciones = [
  { id: 'factores', label: 'Factores de costo' },
  { id: 'categorias', label: 'Por categoría' },
  { id: 'datos', label: 'Datos para cotizar' },
  { id: 'preguntas', label: 'Preguntas' },
  { id: 'cotizar', label: 'Cotizar' },
];

const GUIAS_PRECIOS: L2Link[] = [
  { label: 'Cuánto cuesta un traje de bombero', href: '/blog/cuanto-cuesta-un-traje-de-bombero/' },
  { label: 'Guía de compra de equipo para bomberos', href: '/blog/guia-compra-equipo-bomberos-nfpa-mexico-2026/' },
  { label: 'Comprar en línea o con distribuidor', href: '/blog/comprar-equipo-contra-incendio-en-linea-o-distribuidor/' },
  { label: 'Guía de compra de SCBA', href: '/blog/guia-compra-scba-equipos-respiracion-autonoma/' },
  { label: 'Cómo equipar una estación de bomberos', href: '/blog/como-equipar-estacion-bomberos-desde-cero/' },
  { label: 'Visita técnica del proveedor', href: '/blog/visita-tecnica-proveedor-equipo-contra-incendio/' },
  { label: 'Normas NFPA y NOM aplicables', href: '/certificaciones/' },
  { label: 'Soporte para licitaciones', href: '/licitaciones/' },
];

const tambien = [
  { label: 'Equipo para bomberos', desc: 'Equipo NFPA y NOM en 10 categorías', href: '/productos' },
  { label: 'Cuánto cuesta un traje de bombero', desc: 'Qué incluye el precio de un conjunto NFPA', href: '/blog/cuanto-cuesta-un-traje-de-bombero' },
  { label: 'Soporte para licitaciones', desc: 'CompraNet, PEMEX, CFE y municipios', href: '/licitaciones' },
  { label: 'Guía de normas y certificaciones', desc: 'Qué NOM y NFPA pedir en la cotización', href: '/certificaciones' },
  { label: 'Servicios profesionales', desc: 'Instalación, mantenimiento y capacitación', href: '/servicios' },
  { label: 'Cobertura nacional', desc: 'Entrega y servicio en los 32 estados', href: '/cobertura' },
];

const trustPoints = [
  { title: 'Cotización por escrito', text: 'Cada partida con disponibilidad, vigencia y condiciones de entrega.' },
  { title: 'Alcance comparable', text: 'Equipo, accesorios, entrega y servicios separados para comparar propuestas.' },
  { title: 'Documentación por partida', text: 'Fichas, certificados y manifiestos cuando tu proyecto los exige.' },
  { title: 'Envíos a los 32 estados', text: 'Logística y condiciones de entrega definidas desde la solicitud.' },
];
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema, faqSchema]}>
  <nav class="py-3" style="background:var(--c-bg-alt);border-bottom:1px solid var(--c-line)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
        <li><a href="/" class="hover:text-[var(--c-accent)]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:var(--c-text-2)" aria-current="page">Precios de equipo</span></li>
      </ol>
    </div>
  </nav>

  <section class="relative overflow-hidden" style="background:var(--c-bg);padding-block:5rem">
    <div class="container-site relative z-10">
      <div class="max-w-4xl">
        <span class="section-eyebrow mb-5 inline-flex">Guía de compra · México</span>
        <h1 class="font-display font-bold mb-6" style="color:var(--c-ink);font-size:clamp(2.25rem,4.5vw,3.5rem);line-height:1.08">
          Precios de equipo<br/>
          <span style="color:var(--c-accent)">para bomberos.</span>
        </h1>
        <p class="text-base leading-[1.9] mb-4 max-w-3xl" style="color:var(--c-text-2)">
          El precio de equipo para bomberos y contra incendios depende de la especificación, cantidad, documentación, logística y servicios incluidos. Esta página explica qué información reunir para que te enviemos una cotización completa y comparable.
        </p>
        <p class="text-sm leading-[1.9] mb-8 max-w-3xl" style="color:var(--c-muted)">
          No publicamos una lista de precios fijos: cada partida se cotiza por escrito con disponibilidad, condiciones de entrega y la documentación que requiera tu proyecto.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/cotizacion/" class="btn btn-primary btn-lg">Solicitar cotización</a>
          <a href="/productos/" class="btn btn-ghost btn-lg">Equipo para bomberos NFPA</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Accesos rápidos (interlinking) -->
  <QuickLinksBar />

  <!-- Pilares -->
  <section class="section-tight" style="background:var(--c-bg-alt)" aria-labelledby="garantias-title">
    <div class="container-site">
      <h2 id="garantias-title" class="sr-only">Cómo cotizamos el equipo contra incendio</h2>
      <div class="l2-trust">
        {trustPoints.map((t) => (
          <div><h3>{t.title}</h3><p>{t.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Plantilla L2: columna principal + barra lateral -->
  <div class="container-site l2-shell">
    <L2Sidebar
      resumen="Navegar precios y compra"
      secciones={secciones}
      bloques={[
        bloqueGuias(GUIAS_PRECIOS, 'Guías de costo y compra'),
        bloqueCategorias(),
        bloqueMarcas(),
        bloqueServicios(),
        bloqueIndustrias(),
      ]}
      cotizar={{ titulo: 'Solicita tu cotización', texto: 'Envíanos equipo, cantidades, norma y estado de entrega; te respondemos por escrito.', msg: 'Hola, quiero cotizar equipo para bomberos y contra incendio.' }}
    />

    <div class="l2-main">

      <!-- Factores de costo -->
      <section id="factores" class="l2-sec" aria-labelledby="factores-title">
        <header class="l2-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Costo total</span>
          <h2 id="factores-title" class="l2-h2">Factores que cambian el precio del equipo contra incendio</h2>
          <p class="l2-lead">Para comparar propuestas, define primero un alcance común. Un importe aislado no permite saber si dos propuestas cubren la misma solución.</p>
        </header>
        <div class="l2-factores">
          {factores.map((f) => (
            <article><h3>{f.title}</h3><p>{f.text}</p></article>
          ))}
        </div>
      </section>

      <!-- Por categoría -->
      <section id="categorias" class="l2-sec" aria-labelledby="categorias-title">
        <header class="l2-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Por categoría</span>
          <h2 id="categorias-title" class="l2-h2">Qué definir antes de solicitar precios de cada tipo de equipo</h2>
          <p class="l2-lead">Cada categoría se cotiza con datos distintos. Estas son las especificaciones clave y las guías que ayudan a comparar.</p>
        </header>
        <ul class="l2-grid" role="list">
          {categorias.map((c, i) => (
            <li class={anchoFila(i, categorias.length) || undefined}>
              <LineaCard
                href={c.href}
                norma={c.norma}
                titulo={c.title}
                texto={c.text}
                imagen={c.image}
                imagenAlt={c.alt}
                hijas={c.hijas}
                cta={c.cta}
                nivel="h3"
                subLabel="Guías de compra"
              />
            </li>
          ))}
        </ul>
      </section>

      <!-- Datos para cotizar -->
      <section id="datos" class="l2-sec" aria-labelledby="datos-title">
        <header class="l2-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Solicitud comparable</span>
          <h2 id="datos-title" class="l2-h2">Datos para pedir una cotización completa de equipo para bomberos</h2>
          <p class="l2-lead">Con esta información preparamos una propuesta completa, sin supuestos que después cambien el importe final.</p>
        </header>
        <ol class="l2-steps" role="list">
          {datosCotizacion.map((dato) => <li>{dato}</li>)}
        </ol>
      </section>

      <!-- Preguntas frecuentes -->
      <section id="preguntas" class="l2-sec" aria-labelledby="faq-precios-title">
        <header class="l2-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Preguntas frecuentes</span>
          <h2 id="faq-precios-title" class="l2-h2">Cómo comparar precios de equipo contra incendio sin perder alcance</h2>
        </header>
        <div class="l2-faq">
          {faqs.map((f) => (
            <details>
              <summary><span>{f.q}</span><span class="l2-faq-mas" aria-hidden="true">+</span></summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Cotizar + cross-links -->
      <L2Cotizar
        id="cotizar"
        eyebrow="Distribuidor autorizado · envíos a los 32 estados"
        titulo="Cotiza tu equipo"
        destacado="con VIGILES."
        texto="Cada partida se cotiza por escrito, con disponibilidad, condiciones de entrega y la documentación que requiera tu proyecto. Envíanos el alcance y te respondemos."
        cta={{ label: 'Solicitar cotización', href: '/cotizacion/' }}
        tambien={tambien}
      />

    </div>
  </div>
</BaseLayout>
