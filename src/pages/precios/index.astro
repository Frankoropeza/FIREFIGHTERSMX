---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { SITE } from '@config/site';

const canonicalURL = `${SITE.url}/precios/`;

const seoMeta = {
  title: 'Precios de Equipo para Bomberos: Factores y Cotización',
  description:
    'Guía sobre precios de equipo para bomberos y contra incendios en México. Conoce qué cambia el costo y qué datos comparar al solicitar cotizaciones.',
  canonicalURL,
};

const factores = [
  { title: 'Tipo y configuración', text: 'La familia de equipo, capacidad, materiales, accesorios y compatibilidad con otros componentes cambian el alcance de una propuesta.' },
  { title: 'Documentación solicitada', text: 'Fichas técnicas, manuales, trazabilidad y evidencia de cumplimiento deben definirse desde la solicitud y verificarse antes de comprar.' },
  { title: 'Cantidad y tallas', text: 'El número de unidades, la variedad de tallas y la necesidad de repuestos influyen en la integración de una cotización comparable.' },
  { title: 'Logística y ubicación', text: 'Origen del equipo, destino, maniobras, seguros y condiciones de entrega pueden formar parte del costo total del proyecto.' },
  { title: 'Instalación o puesta en marcha', text: 'Los sistemas que requieren ingeniería, instalación, pruebas o capacitación deben separar esos conceptos del costo del equipo.' },
  { title: 'Mantenimiento y ciclo de vida', text: 'Consumibles, inspecciones, recargas, refacciones y servicio posterior ayudan a comparar el costo más allá de la compra inicial.' },
];

const categorias = [
  { title: 'Extintores', text: 'Define agente, capacidad, aplicación, cantidad y servicio requerido.', guide: '/productos/extintores/', companies: '/empresas/extintores/' },
  { title: 'Sistemas contra incendio', text: 'Separa ingeniería, suministro, instalación, pruebas y mantenimiento.', guide: '/productos/sistemas-ci/', companies: '/empresas/sistemas-ci/' },
  { title: 'Trajes para bomberos', text: 'Especifica tipo de operación, tallas, configuración y documentación requerida.', guide: '/productos/trajes-bombero/', companies: '/empresas/venta-equipo/' },
  { title: 'Equipos SCBA', text: 'Indica duración nominal, cilindros, compatibilidad, accesorios y soporte necesario.', guide: '/productos/equipos-scba/', companies: '/empresas/venta-equipo/' },
  { title: 'Cascos y EPP', text: 'Detalla uso, tallas, accesorios, compatibilidad y norma solicitada.', guide: '/productos/cascos-nfpa/', companies: '/empresas/venta-equipo/' },
  { title: 'Herramientas de rescate', text: 'Compara tecnología, fuente de energía, accesorios, capacitación y mantenimiento.', guide: '/productos/herramientas-rescate/', companies: '/empresas/venta-equipo/' },
];

const datosCotizacion = [
  'Equipo, servicio o sistema que necesitas comparar.',
  'Aplicación, riesgo o escenario operativo previsto.',
  'Cantidad, capacidades, tallas o configuraciones.',
  'Ciudad y estado de entrega o ejecución.',
  'Fecha requerida y condiciones logísticas conocidas.',
  'Normas, fichas, pruebas o documentos exigidos por tu proyecto.',
  'Instalación, capacitación, mantenimiento o refacciones que deban cotizarse por separado.',
];

const faqs = [
  { q: '¿Por qué FIREFIGHTERS MX no publica una lista de precios fijos?', a: 'FIREFIGHTERS MX es un directorio y una plataforma editorial, no el vendedor de los equipos. Además, una propuesta puede cambiar por configuración, cantidad, documentación, logística y servicios asociados. El precio vigente debe confirmarse directamente con cada empresa.' },
  { q: '¿Cómo puedo comparar cotizaciones de equipo contra incendio?', a: 'Entrega el mismo alcance a todas las empresas y compara por separado equipo, accesorios, impuestos, entrega, instalación, pruebas, capacitación, mantenimiento, garantía y documentación. Revisa también exclusiones y vigencia de cada propuesta.' },
  { q: '¿El precio más bajo representa la misma solución?', a: 'No necesariamente. Dos propuestas pueden incluir capacidades, materiales, accesorios, documentación o servicios diferentes. La comparación debe hacerse sobre especificaciones y alcances equivalentes.' },
  { q: '¿Dónde encuentro empresas para solicitar precios?', a: 'Consulta el directorio nacional por giro y estado. FIREFIGHTERS MX facilita la localización de registros; cada empresa es responsable de sus datos, condiciones y cotizaciones.' },
  { q: '¿Qué debo verificar antes de aceptar una cotización?', a: 'Confirma la identidad de la empresa, especificaciones, cantidades, documentación, impuestos, forma de pago, entrega, instalación, garantía y servicio posterior. Cuando una norma sea indispensable, solicita evidencia aplicable al modelo y configuración cotizados.' },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Precios de equipo', item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: seoMeta.title,
  description: seoMeta.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })),
};
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema, faqSchema]}>
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
        <li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:#94A3B8" aria-current="page">Precios de equipo</span></li>
      </ol>
    </div>
  </nav>

  <section class="relative overflow-hidden" style="background:#040A12;padding-block:5rem">
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" style="background:radial-gradient(ellipse 80% 70% at 90% 30%, rgba(247,80,0,0.08) 0%, transparent 65%)" aria-hidden="true"></div>
    <div class="container-site relative z-10">
      <div class="max-w-4xl">
        <span class="section-eyebrow mb-5 inline-flex">Guía de compra · México</span>
        <h1 class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2.4rem,5.5vw,4.4rem);line-height:0.95">
          Precios de equipo<br/>
          <span style="color:#F75000">para bomberos.</span>
        </h1>
        <p class="text-base leading-[1.9] mb-4 max-w-3xl" style="color:#94A3B8">
          El precio de equipo para bomberos y contra incendios depende de la especificación, cantidad, documentación, logística y servicios incluidos. Esta guía explica qué información reunir para solicitar propuestas comparables a empresas del sector en México.
        </p>
        <p class="text-sm leading-[1.9] mb-8 max-w-3xl" style="color:#64748B">
          FIREFIGHTERS MX no vende ni cotiza equipos. Los importes, disponibilidad y condiciones deben confirmarse directamente con cada empresa del directorio.
        </p>
        <div class="flex flex-col sm:flex-row gap-3">
          <a href="/empresas/" class="btn btn-primary btn-lg">Buscar empresas</a>
          <a href="/productos/" class="btn btn-ghost btn-lg">Consultar guías de equipo</a>
        </div>
      </div>
    </div>
  </section>

  <QuickLinksBar />

  <section class="section" style="background:#070E1A" aria-labelledby="factores-title">
    <div class="container-site">
      <div class="max-w-3xl mb-10">
        <span class="section-eyebrow mb-4 inline-flex">Costo total</span>
        <h2 id="factores-title" class="font-display font-bold mb-4" style="color:#FFFFFF;font-size:clamp(1.9rem,3.8vw,3rem);line-height:1.05">
          Factores que cambian el precio<br/>
          <span style="color:#F75000">del equipo contra incendio.</span>
        </h2>
        <p class="text-sm leading-relaxed" style="color:#94A3B8">Para comparar propuestas, define primero un alcance común. Un importe aislado no permite saber si dos empresas están cotizando la misma solución.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px" style="background:rgba(74,117,153,0.18);border:1px solid rgba(74,117,153,0.18)">
        {factores.map((factor) => (
          <article class="p-7" style="background:#080F1A">
            <h3 class="font-display font-bold text-lg mb-3" style="color:#FFFFFF">{factor.title}</h3>
            <p class="text-xs leading-relaxed m-0" style="color:#64748B">{factor.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background:#040A12" aria-labelledby="categorias-title">
    <div class="container-site">
      <div class="max-w-3xl mb-10">
        <span class="section-eyebrow mb-4 inline-flex">Por categoría</span>
        <h2 id="categorias-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.9rem,3.8vw,3rem);line-height:1.05">Qué definir antes de<br/><span style="color:#F75000">solicitar precios.</span></h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {categorias.map((categoria) => (
          <article class="flex flex-col p-7" style="background:#080F1A;border:1px solid rgba(74,117,153,0.18)">
            <h3 class="font-display font-bold text-xl mb-3" style="color:#FFFFFF">{categoria.title}</h3>
            <p class="text-xs leading-relaxed mb-6 flex-1" style="color:#64748B">{categoria.text}</p>
            <div class="flex flex-wrap gap-2">
              <a href={categoria.guide} class="btn btn-sm btn-dark">Ver guía</a>
              <a href={categoria.companies} class="btn btn-sm btn-outline">Buscar empresas</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background:#070E1A" aria-labelledby="datos-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Solicitud comparable</span>
          <h2 id="datos-title" class="font-display font-bold mb-5" style="color:#FFFFFF;font-size:clamp(1.9rem,3.8vw,3rem);line-height:1.05">Datos para pedir una<br/><span style="color:#F75000">cotización completa.</span></h2>
          <p class="text-sm leading-relaxed" style="color:#94A3B8">Utiliza la misma lista con cada empresa. Así podrás identificar diferencias de alcance y evitar comparar solo el importe final.</p>
        </div>
        <ol class="flex flex-col list-none m-0 p-0" style="border-top:1px solid rgba(74,117,153,0.18)">
          {datosCotizacion.map((dato, index) => (
            <li class="flex items-start gap-4 py-4" style="border-bottom:1px solid rgba(74,117,153,0.18)">
              <span class="font-display font-bold text-sm shrink-0" style="color:#F75000">{String(index + 1).padStart(2, '0')}</span>
              <span class="text-sm leading-relaxed" style="color:#94A3B8">{dato}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="section" style="background:#040A12" aria-labelledby="faq-precios-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Preguntas frecuentes</span>
          <h2 id="faq-precios-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.9rem,3.8vw,3rem);line-height:1.05">Cómo comparar precios<br/><span style="color:#F75000">sin perder alcance.</span></h2>
        </div>
        <div style="border:1px solid rgba(74,117,153,0.2);background:#0C1825">
          {faqs.map((faq) => (
            <details class="faq-item group" style="border-bottom:1px solid rgba(74,117,153,0.15)">
              <summary class="flex items-start justify-between gap-4 cursor-pointer select-none list-none p-6">
                <h3 class="font-display font-semibold pr-2 m-0" style="color:#FFFFFF;font-size:0.875rem;line-height:1.375">{faq.q}</h3>
                <span class="faq-icon shrink-0" style="color:#FF6B26">+</span>
              </summary>
              <p class="px-6 pb-6 text-sm leading-relaxed" style="color:#64748B">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section style="background:#F75000;padding-block:4rem" aria-label="Buscar empresas de equipo contra incendio">
    <div class="container-site">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-8">
        <div>
          <p class="text-xs font-display font-bold uppercase tracking-[0.2em] mb-3" style="color:rgba(255,255,255,0.7)">Directorio nacional</p>
          <h2 class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.75rem,3.5vw,2.5rem);line-height:1.1">Compara empresas por<br/>giro, estado y especialidad.</h2>
        </div>
        <a href="/empresas/" class="btn" style="background:#FFFFFF;color:#F75000;font-weight:700">Explorar empresas</a>
      </div>
    </div>
  </section>
</BaseLayout>
