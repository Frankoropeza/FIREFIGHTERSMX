---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout
  title="Página no encontrada — VIGILES"
  description="La página que buscas no existe. Vuelve al inicio o explora el directorio de equipo para bomberos certificado NFPA y NOM."
  noindex={true}
>
  <section class="relative overflow-hidden" style="background:var(--c-bg);min-height:70vh;display:flex;align-items:center">

    <div class="container-site relative z-10 text-center">
      <p class="font-display font-bold mb-2" style="color:var(--c-accent);font-size:clamp(5rem,18vw,11rem);line-height:1.08">404</p>
      <h1 class="font-display font-bold mb-5" style="color:var(--c-ink);font-size:clamp(1.75rem,4vw,3rem);line-height:1">
        Página <span style="color:var(--c-accent)">no encontrada</span>
      </h1>
      <p class="text-sm leading-[1.9] mx-auto mb-10" style="color:var(--c-text-2);max-width:34rem">
        La página que buscas no existe o fue movida. Regresa al inicio o explora
        el directorio de equipo para bomberos certificado.
      </p>
      <div class="flex flex-wrap gap-3 justify-center">
        <a href="/" class="btn btn-primary btn-lg">Volver al inicio</a>
        <a href="/productos" class="btn btn-ghost btn-lg">Directorio de equipo para bomberos</a>
        <a href="/contacto" class="btn btn-dark btn-lg">Contacto</a>
      </div>
    </div>

  </section>
</BaseLayout>
