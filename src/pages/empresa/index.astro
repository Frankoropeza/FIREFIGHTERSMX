---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { SITE } from '@config/site';

const canonicalURL = `${SITE.url}/empresa/`;
const seoMeta = {
  title: 'FIREFIGHTERS MX | Directorio Nacional del Sector',
  description: 'Conoce FIREFIGHTERS MX, directorio nacional de empresas de equipo contra incendio y equipo para bomberos, sus recursos y límites editoriales.',
  canonicalURL,
};

const recursos = [
  { title: 'Directorio de empresas', text: 'Registros organizados por giro, estado y municipio para localizar empresas del sector.', href: '/empresas/' },
  { title: 'Guías de equipo', text: 'Categorías, aplicaciones y criterios para comparar equipo para bomberos y protección contra incendios.', href: '/productos/' },
  { title: 'Guías de servicios', text: 'Preguntas y aspectos que conviene revisar al comparar empresas de servicios relacionados.', href: '/servicios/' },
  { title: 'Normas y certificación', text: 'Orientación para identificar documentos, alcances y referencias que deben verificarse.', href: '/certificaciones/' },
  { title: 'Directorio de estaciones', text: 'Vertical independiente de estaciones de bomberos, organizado por entidad y ficha.', href: '/estaciones/' },
  { title: 'Blog técnico', text: 'Artículos sobre selección, mantenimiento, normativa, licitaciones y operación.', href: '/blog/' },
];

const limites = [
  'FIREFIGHTERS MX no vende equipos ni presta los servicios publicados en el directorio.',
  'Una ficha no acredita automáticamente certificaciones, autorizaciones, experiencia o cobertura comercial.',
  'Los precios, inventario, entrega, garantía y condiciones deben confirmarse directamente con cada empresa.',
  'Los datos se corrigen o amplían únicamente con información y fuentes verificables.',
];

const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Sobre FIREFIGHTERS MX', item: canonicalURL },
  ],
};
const aboutSchema = {
  '@context': 'https://schema.org', '@type': 'AboutPage', '@id': `${canonicalURL}#about`,
  name: seoMeta.title, description: seoMeta.description, url: canonicalURL, inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` }, about: { '@id': `${SITE.url}/#organization` },
};
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, aboutSchema]}>
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb"><div class="container-site"><ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)"><li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li><li aria-hidden="true">/</li><li aria-current="page" style="color:#94A3B8">FIREFIGHTERS MX</li></ol></div></nav>

  <section class="relative overflow-hidden" style="background:#040A12;padding-block:5rem"><div class="container-site relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"><div><span class="section-eyebrow mb-5 inline-flex">Proyecto editorial · México</span><h1 class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2.4rem,5.5vw,4.4rem);line-height:0.95">Directorio nacional<br/><span style="color:#F75000">del sector contra incendio.</span></h1><div class="flex flex-col sm:flex-row gap-3"><a href="/empresas/" class="btn btn-primary btn-lg">Explorar empresas</a><a href="/nosotros/" class="btn btn-ghost btn-lg">Conocer la metodología</a></div></div><div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,0.1)"><p class="text-sm leading-[1.9] mb-5" style="color:#94A3B8">FIREFIGHTERS MX organiza información sobre empresas que venden equipo contra incendio y equipo para bomberos en México.</p><p class="text-sm leading-[1.9]" style="color:#64748B">El proyecto conecta el directorio con guías de productos, servicios, industrias, normas y contenido técnico para facilitar búsquedas y comparaciones informadas.</p></div></div></section>

  <QuickLinksBar />

  <section class="section" style="background:#070E1A" aria-labelledby="recursos-title"><div class="container-site"><div class="max-w-3xl mb-10"><span class="section-eyebrow mb-4 inline-flex">Arquitectura del sitio</span><h2 id="recursos-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.9rem,3.8vw,3rem);line-height:1.05">Recursos para buscar,<br/><span style="color:#F75000">comparar y verificar.</span></h2></div><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">{recursos.map((recurso) => <a href={recurso.href} class="group flex flex-col p-7" style="background:#080F1A;border:1px solid rgba(74,117,153,0.18)"><h3 class="font-display font-bold text-lg mb-3 group-hover:text-[#FF6B26]" style="color:#FFFFFF">{recurso.title}</h3><p class="text-xs leading-relaxed mb-5 flex-1" style="color:#64748B">{recurso.text}</p><span class="text-xs font-display font-semibold uppercase tracking-wider" style="color:#FF8F57">Consultar recurso →</span></a>)}</div></div></section>

  <section class="section" style="background:#040A12" aria-labelledby="limites-title"><div class="container-site grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start"><div><span class="section-eyebrow mb-4 inline-flex">Transparencia editorial</span><h2 id="limites-title" class="font-display font-bold mb-5" style="color:#FFFFFF;font-size:clamp(1.9rem,3.8vw,3rem);line-height:1.05">Qué hace y qué no hace<br/><span style="color:#F75000">FIREFIGHTERS MX.</span></h2><p class="text-sm leading-relaxed" style="color:#94A3B8">Estos límites protegen la utilidad del directorio y evitan confundir información editorial con una oferta comercial.</p></div><ul class="flex flex-col list-none m-0 p-0" style="border-top:1px solid rgba(74,117,153,0.18)">{limites.map((limite) => <li class="flex items-start gap-3 py-4 text-sm leading-relaxed" style="color:#94A3B8;border-bottom:1px solid rgba(74,117,153,0.18)"><span aria-hidden="true" style="color:#F75000">■</span>{limite}</li>)}</ul></div></section>

  <section style="background:#F75000;padding-block:4rem" aria-label="Registrar o corregir una empresa"><div class="container-site"><div class="flex flex-col lg:flex-row items-center justify-between gap-8"><div><p class="text-xs font-display font-bold uppercase tracking-[0.2em] mb-3" style="color:rgba(255,255,255,0.7)">Participa en el directorio</p><h2 class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.75rem,3.5vw,2.5rem);line-height:1.1">Registra una empresa o<br/>solicita una corrección.</h2></div><a href="/empresas/registro/" class="btn" style="background:#FFFFFF;color:#F75000;font-weight:700">Abrir formulario de registro</a></div></div></section>
</BaseLayout>
