---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { SITE } from '@config/site';

const canonicalURL = `${SITE.url}/contacto/`;

const seoMeta = {
  title: `Contacto | FIREFIGHTERS MX`,
  description:
    'Contacta a FIREFIGHTERS MX por correo para solicitar correcciones, registrar una empresa o enviar información verificable para el directorio nacional.',
  canonicalURL,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Empresa', item: `${SITE.url}/empresa` },
    { '@type': 'ListItem', position: 3, name: 'Contacto', item: canonicalURL },
  ],
};

const canales = [
  { label: 'Correo editorial', value: SITE.email, href: `mailto:${SITE.email}`, icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/></svg>` },
];
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema]}>

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
        <li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/empresa" class="hover:text-[#FF6B26]">Empresa</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:#94A3B8" aria-current="page">Contacto</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background:#040A12;padding-block:5rem">
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" style="background:radial-gradient(ellipse 80% 70% at 90% 30%, rgba(247,80,0,0.08) 0%, transparent 65%)" aria-hidden="true"></div>

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="section-eyebrow mb-5 inline-flex">Contacto editorial</span>
          <h1 class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2.5rem,5.5vw,4.5rem);line-height:0.95">
            Contacta al<br/>
            <span style="color:#F75000">directorio nacional</span>
          </h1>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href={`mailto:${SITE.email}`} class="btn btn-primary btn-lg">Enviar correo</a>
            <a href="/empresas/registro/" class="btn btn-ghost btn-lg">Registrar una empresa</a>
          </div>
        </div>
        <div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,0.1)">
          <p class="text-sm leading-[1.9] mb-5" style="color:#94A3B8">
            Usa este canal para <strong style="color:#CBD5E1">corregir una ficha, registrar una empresa,
            aportar una fuente o reportar un problema del sitio</strong>.
          </p>
          <p class="text-sm leading-[1.9] mb-6" style="color:#64748B">
            FIREFIGHTERS MX no vende equipos ni presta los servicios de las empresas listadas.
            Para precios, disponibilidad o cobertura, contacta directamente a cada proveedor.
          </p>
          <div class="flex flex-wrap gap-2">
            {['Corrección de fichas','Alta de empresas','Fuentes verificables','Reporte del sitio'].map(n => (
              <span class="badge badge-dark font-display text-[10px]">{n}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-px" style="background:linear-gradient(90deg, transparent, rgba(247,80,0,0.4) 30%, rgba(247,80,0,0.4) 70%, transparent)" aria-hidden="true"></div>
  </section>

  <!-- Accesos rápidos -->
  <QuickLinksBar />

  <!-- Canales + Formulario -->
  <section class="section" style="background:#040A12" aria-labelledby="contacto-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">

        <!-- Canales -->
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Canales de atención</span>
          <h2 id="contacto-title" class="font-display font-bold mb-8" style="color:#FFFFFF;font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
            Por donde<br/>
            <span style="color:#F75000">prefieras.</span>
          </h2>

          <ul class="flex flex-col list-none m-0 p-0" style="border-top:1px solid rgba(74,117,153,0.18)">
            {canales.map((c) => (
              <li style="border-bottom:1px solid rgba(74,117,153,0.18)">
                <div class="flex items-center gap-4 py-4">
                  <span class="flex items-center justify-center rounded-full shrink-0" style="width:44px;height:44px;background:rgba(247,80,0,0.1);border:1.5px solid rgba(247,80,0,0.35);color:#FF6B26">
                    <span class="block" style="width:20px;height:20px" set:html={c.icon}/>
                  </span>
                  <span class="flex flex-col gap-0.5 min-w-0">
                    <span class="text-[10px] font-display font-semibold uppercase tracking-widest" style="color:var(--forge-300)">{c.label}</span>
                    {c.href ? (
                      <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} rel={c.href.startsWith('http') ? 'noopener' : undefined} class="font-display font-semibold text-sm hover:text-[#FF6B26]" style="color:#FFFFFF">{c.value}</a>
                    ) : (
                      <span class="font-display font-semibold text-sm" style="color:#FFFFFF">{c.value}</span>
                    )}
                  </span>
                </div>
              </li>
            ))}
          </ul>

          <div class="mt-8 p-6" style="background:#080F1A;border:1px solid rgba(74,117,153,0.18)">
            <h3 class="font-display font-bold text-sm uppercase tracking-wider mb-2" style="color:#FF6B26">Alcance del contacto</h3>
            <p class="text-sm leading-relaxed m-0" style="color:#94A3B8">
              Este correo corresponde al proyecto editorial. No representa un canal de ventas,
              soporte técnico ni atención comercial de las empresas del directorio.
            </p>
          </div>
        </div>

        <!-- Formulario -->
        <div class="p-7" style="background:#080F1A;border:1px solid rgba(74,117,153,0.18)">
          <h2 class="font-display font-bold text-xl mb-6" style="color:#FFFFFF">Envíanos un mensaje</h2>
          <form data-mail={SITE.email} method="POST" action={`mailto:${SITE.email}`} class="flex flex-col gap-5">
            <div class="grid sm:grid-cols-2 gap-4">
              <div>
                <label for="nombre" class="label">Nombre *</label>
                <input type="text" id="nombre" name="nombre" required class="input" placeholder="Tu nombre completo"/>
              </div>
              <div>
                <label for="empresa" class="label">Empresa</label>
                <input type="text" id="empresa" name="empresa" class="input" placeholder="Opcional"/>
              </div>
            </div>
            <div>
              <label for="email" class="label">Correo electrónico *</label>
              <input type="email" id="email" name="email" required class="input" placeholder="correo@empresa.com"/>
            </div>
            <div>
              <label for="telefono" class="label">Teléfono</label>
              <input type="tel" id="telefono" name="telefono" class="input" placeholder="55 1234-5678"/>
            </div>
            <div>
              <label for="asunto" class="label">Asunto *</label>
              <select id="asunto" name="asunto" required class="select">
                <option value="">Selecciona un asunto</option>
                <option>Registrar una empresa</option>
                <option>Corregir una ficha</option>
                <option>Aportar una fuente</option>
                <option>Reportar un problema del sitio</option>
                <option>Consulta editorial</option>
              </select>
            </div>
            <div>
              <label for="mensaje" class="label">Mensaje *</label>
              <textarea id="mensaje" name="mensaje" rows="4" required class="textarea" placeholder="Cuéntanos en qué podemos ayudarte..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-full mt-2">Enviar mensaje</button>
            <p class="text-xs text-center m-0" style="color:#64748B">El envío abrirá tu aplicación de correo.</p>
          </form>
        </div>

      </div>
    </div>
  </section>

  <script>
    // Envío sin backend: compone un correo con los campos visibles del formulario.
    document.querySelectorAll('form[data-mail]').forEach((form) => {
      const f = form as HTMLFormElement;
      if (f.dataset.bound) return;
      f.dataset.bound = '1';
      f.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!f.reportValidity()) return;
        const fd = new FormData(f);
        const lines: string[] = ['Hola FIREFIGHTERS MX, envío esta solicitud editorial desde el sitio web:', ''];
        for (const [name, value] of fd.entries()) {
          const v = String(value).trim();
          if (!v) continue;
          const field = f.querySelector(`[name="${name}"]`) as HTMLElement | null;
          const id = field?.id ?? '';
          const labelEl = id ? f.querySelector(`label[for="${id}"]`) : null;
          const label = labelEl?.textContent?.replace('*', '').trim() || name;
          lines.push(`${label}: ${v}`);
        }
        const text = encodeURIComponent(lines.join('\n'));
        const mail = f.getAttribute('data-mail');
        if (mail) window.location.href = `mailto:${mail}?subject=${encodeURIComponent('Solicitud editorial — FIREFIGHTERS MX')}&body=${text}`;
      });
    });
  </script>

</BaseLayout>
