---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { SITE, whatsappUrl, CANAL_CONTACTO } from '@config/site';

const canonicalURL = `${SITE.url}/licitaciones/`;

const seoMeta = {
  title: `Licitaciones de Equipo para Bomberos`,
  description:
    'Soporte para licitaciones de equipo contra incendio: fichas técnicas, manifiestos de norma NOM/NFPA y CFDI 4.0. CompraNet, PEMEX, CFE y municipios.',
  canonicalURL,
};

/* ─── Capacidades (cards) ──────────────────────────────────── */
const capacidades = [
  {
    title: 'Documentación técnica',
    tag: 'Por partida',
    desc: 'Fichas técnicas del fabricante y manifiestos de cumplimiento de norma listos para anexar a tu propuesta.',
    accent: '#C8102E',
    icon: ``,
  },
  {
    title: 'Equipo certificado',
    tag: 'NOM · NFPA',
    desc: 'Catálogo completo con certificación de tercera parte acreditada para cada bien requerido en la convocatoria.',
    accent: '#B54708',
    icon: ``,
  },
  {
    title: 'Proveedor habilitado',
    tag: 'CompraNet',
    desc: 'Empresa registrada como proveedor en CompraNet y en padrones estatales, con expediente al día.',
    accent: '#067647',
    icon: ``,
  },
  {
    title: 'Entrega y cumplimiento',
    tag: 'Conforme a bases',
    desc: 'Compromiso en firme de tiempos, lugar y condiciones de entrega, evitando penas convencionales.',
    accent: '#475467',
    icon: ``,
  },
  {
    title: 'Facturación CFDI 4.0',
    tag: 'Sector gobierno',
    desc: 'Comprobantes fiscales con todos los requisitos para dependencias federales, estatales y municipales.',
    accent: '#C8102E',
    icon: ``,
  },
  {
    title: 'Acompañamiento técnico',
    tag: 'Junta de aclaraciones',
    desc: 'Apoyo en la interpretación de partidas, especificaciones y normas durante todo el proceso.',
    accent: '#C8102E',
    icon: ``,
  },
];

/* ─── Requisito  entregable ───────────────────────────────── */
const requisitos = [
  ['Certificación de norma por partida', 'Certificados NFPA / NOM emitidos por laboratorio acreditado'],
  ['Ficha técnica del bien', 'Ficha del fabricante del modelo exacto ofertado'],
  ['Manifiesto de cumplimiento', 'Manifiesto firmado de normas, por partida'],
  ['Carta de distribuidor', 'Carta de distribuidor autorizado del fabricante'],
  ['Tiempo y condiciones de entrega', 'Compromiso en firme conforme a las bases'],
  ['Facturación a la dependencia', 'CFDI 4.0 con los requisitos fiscales aplicables'],
];

/* ─── Plataformas ──────────────────────────────────────────── */
const plataformas = [
  'CompraNet — Función Pública (Federal)',
  'PEMEX — Petróleos Mexicanos',
  'CFE — Comisión Federal de Electricidad',
  'IMSS e ISSSTE',
  'Secretarías de Seguridad Pública estatales',
  'Protección Civil estatal y municipal',
  'Gobiernos estatales',
  'Municipios en los 32 estados',
];

/* ─── Proceso ──────────────────────────────────────────────── */
const pasos = [
  { n: '01', t: 'Analizamos la convocatoria y sus partidas: identificamos las normas exigidas y los requisitos técnicos de cada bien.' },
  { n: '02', t: 'Armamos la propuesta técnica completa: fichas, manifiestos de norma, catálogos y cartas de distribuidor por partida.' },
  { n: '03', t: 'Cotizamos en firme: precios, tiempos de entrega y condiciones alineados a las bases, sin sorpresas posteriores.' },
  { n: '04', t: 'Entregamos el equipo certificado con su CFDI 4.0 y la evidencia documental lista para el expediente de la dependencia.' },
];

/* ─── FAQ ──────────────────────────────────────────────────── */
const faqs = [
  {
    q: '¿Están registrados como proveedor en CompraNet?',
    a: 'Sí. Somos proveedor habilitado en CompraNet y en padrones de proveedores estatales, con expediente y documentación legal al día para participar en concursos federales, estatales y municipales.',
  },
  {
    q: '¿Entregan fichas técnicas y manifiestos de norma por partida?',
    a: 'Sí. Para cada partida preparamos la ficha técnica del fabricante del modelo ofertado y el manifiesto de cumplimiento de normas (NOM, NFPA, STPS), listos para integrarse a la propuesta técnica.',
  },
  {
    q: '¿Qué normas cumple el equipo que ofertan?',
    a: 'Cada bien se revisa conforme a las normas aplicables: NFPA 1970 para conjuntos estructurales y SCBA, NOM-002-STPS para centros de trabajo, NOM-100-STPS para extintores PQS, NOM-102-STPS para CO₂ y NOM-154-SCFI para su servicio de mantenimiento y recarga.',
  },
  {
    q: '¿Facturan a dependencias de gobierno con CFDI 4.0?',
    a: 'Sí. Emitimos comprobantes fiscales digitales 4.0 con todos los requisitos que exigen las dependencias federales, estatales y municipales para su comprobación del gasto.',
  },
  {
    q: '¿Pueden cumplir los tiempos de entrega y evitar penas convencionales?',
    a: 'Cotizamos los plazos de entrega en firme y conforme a las bases. Coordinamos logística a los 32 estados para cumplir el contrato en tiempo y condiciones, minimizando el riesgo de penalización.',
  },
  {
    q: '¿Atienden solo licitaciones federales?',
    a: 'No. Damos soporte a concursos federales (CompraNet, PEMEX, CFE, IMSS, ISSSTE), estatales y municipales — incluyendo Secretarías de Seguridad Pública y unidades de Protección Civil en todo el país.',
  },
];

/* ─── JSON-LD ──────────────────────────────────────────────── */
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Licitaciones', item: canonicalURL },
  ],
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonicalURL}#service`,
  name: 'Soporte para licitaciones de equipo contra incendio',
  description: seoMeta.description,
  serviceType: 'Soporte técnico para compras públicas y licitaciones',
  provider: { '@id': `${SITE.url}/#business` },
  areaServed: { '@type': 'Country', name: 'México' },
  url: canonicalURL,
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, serviceSchema, faqSchema]}>

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:var(--c-bg-alt);border-bottom:1px solid var(--c-line)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
        <li><a href="/" class="hover:text-[var(--c-accent)]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:var(--c-text-2)" aria-current="page">Licitaciones</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background:var(--c-bg);padding-block:5rem">

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <div>
          <span class="section-eyebrow mb-5 inline-flex">Sector gobierno · CompraNet</span>
          <h1 class="font-display font-bold mb-6" style="color:var(--c-ink);font-size:clamp(2.25rem,4.5vw,3.5rem);line-height:1.08">
            Licitaciones de<br/>
            <span style="color:var(--c-accent)">equipo contra incendio</span>
          </h1>
          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href={whatsappUrl('Hola, necesito soporte técnico para una licitación de equipo contra incendio.')}
              target="_blank" rel="noopener"
              class="btn btn-primary btn-lg"
            >
              Asesoría por {CANAL_CONTACTO}
            </a>
            <a href="/cotizacion" class="btn btn-ghost btn-lg">Solicitar propuesta</a>
          </div>
        </div>

        <div class="lg:pl-16" style="border-left:1px solid var(--c-line)">
          <p class="text-sm leading-[1.9] mb-5" style="color:var(--c-text-2)">
            Acompañamos a dependencias y a proveedores en concursos públicos de equipo para bomberos
            y sistemas contra incendio: <strong style="color:var(--c-text)">fichas técnicas, manifiestos de
            cumplimiento de norma NOM y NFPA, cartas de distribuidor y catálogos</strong> listos para
            integrarse a la propuesta técnica de cada partida.
          </p>
          <p class="text-sm leading-[1.9] mb-6" style="color:var(--c-muted)">
            Somos proveedor habilitado en CompraNet, facturamos con CFDI 4.0 y entregamos en los
            32 estados con tiempos en firme. Federal, estatal o municipal: cubrimos el expediente
            técnico que el órgano fiscalizador va a auditar.
          </p>
          <div class="flex flex-wrap gap-2">
            {['CompraNet','PEMEX','CFE','NOM-002-STPS','NFPA 1970','CFDI 4.0'].map(n => (
            <span class="badge badge-dark font-display text-[10px]">{n}</span>
          ))}
          </div>
        </div>

      </div>
    </div>

  </section>

  <!-- Accesos rápidos (interlinking) -->
  <QuickLinksBar />

  <!-- Capacidades -->
  <section class="section" style="background:var(--c-bg)" aria-labelledby="capacidades-title">
    <div class="container-site">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Qué entregamos</span>
          <h2 id="capacidades-title" class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
            El expediente técnico,<br/>
            <span style="color:var(--c-accent)">resuelto.</span>
          </h2>
        </div>
        <div style="padding-left:1.75rem">
          <p class="text-sm leading-relaxed" style="color:var(--c-text-2)">
            Una propuesta técnica se gana en los detalles: la certificación correcta por partida,
            el manifiesto firmado, la carta de distribuidor y los tiempos de entrega creíbles.
            Eso es exactamente lo que preparamos contigo.
          </p>
        </div>
      </div>

      <div class="card-grid">
        {capacidades.map((c) => (
          <article class="cap-card group relative flex flex-col overflow-hidden" style="background:#FFFFFF;border:1px solid var(--c-line);border-radius:var(--radius-card);box-shadow:var(--shadow-card)">
            <div class="flex flex-col flex-1 p-5 gap-2.5">
              <span class="text-[9px] font-display font-semibold uppercase tracking-widest" style="color:var(--forge-300)">{c.tag}</span>
              <h3 class="font-display font-bold text-lg leading-tight" style="color:var(--c-ink)">{c.title}</h3>
              <p class="text-xs leading-relaxed" style="color:var(--c-muted)">{c.desc}</p>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- Requisito  entregable -->
  <section class="section" style="background:var(--c-bg-alt)" aria-labelledby="requisitos-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Punto por punto</span>
          <h2 id="requisitos-title" class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
            Cada requisito,<br/>
            <span style="color:var(--c-accent)">su documento.</span>
          </h2>
        </div>
        <div style="padding-left:1.75rem">
          <p class="text-sm leading-relaxed" style="color:var(--c-text-2)">
            Las convocatorias se ganan o se descalifican por la documentación. Esto es lo que
            pide una base típica y lo que entregamos para cubrirlo sin observaciones.
          </p>
        </div>
      </div>

      <div style="border:1px solid var(--c-line)">
        <div class="grid grid-cols-1 sm:grid-cols-2" style="background:var(--c-surface);border-bottom:1px solid var(--c-line)">
          <div class="p-4"><span class="font-display font-bold text-xs uppercase tracking-widest" style="color:var(--c-accent)">Requisito de la convocatoria</span></div>
          <div class="p-4" style="border-left:1px solid var(--c-line)"><span class="font-display font-bold text-xs uppercase tracking-widest" style="color:var(--c-accent)">Lo que entregamos</span></div>
        </div>
        {requisitos.map(([req, ent], i) => (
          <div class="grid grid-cols-1 sm:grid-cols-2" style={`background:${i % 2 === 0 ? 'var(--c-bg-alt)' : 'var(--c-bg-alt)'};${i < requisitos.length - 1 ? 'border-bottom:1px solid var(--c-line);' : ''}`}>
            <div class="p-4 flex items-center gap-3">
              <span class="w-1.5 h-1.5 rounded-full shrink-0" style="background:var(--c-line-strong)" aria-hidden="true"></span>
              <span class="text-sm" style="color:var(--c-text)">{req}</span>
            </div>
            <div class="p-4 flex items-center gap-3" style="border-left:1px solid var(--c-line)">
              
              <span class="text-sm" style="color:var(--c-text-2)">{ent}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Plataformas + Proceso -->
  <section class="section" style="background:var(--c-bg)" aria-labelledby="plataformas-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">

        <!-- Plataformas -->
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Dónde participamos</span>
          <h2 id="plataformas-title" class="font-display font-bold mb-6" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
            Federal, estatal<br/>
            <span style="color:var(--c-accent)">y municipal.</span>
          </h2>
          <ul class="grid grid-cols-1 sm:grid-cols-2 list-none m-0 p-0" style="border:1px solid var(--c-line)">
            {plataformas.map((p, i) => (
              <li class="grid-cell flex items-center gap-3 p-4" style={`border-bottom:1px solid var(--c-line);${i % 2 === 0 ? 'border-right:1px solid var(--c-line);' : ''}`}>
                
                <span class="text-xs leading-snug" style="color:var(--c-text-2)">{p}</span>
              </li>
            ))}
          </ul>
        </div>

        <!-- Proceso -->
        <div class="lg:pl-16" style="border-left:1px solid var(--c-line)">
          <span class="section-eyebrow mb-4 inline-flex">Cómo te acompañamos</span>
          <h2 class="font-display font-bold mb-6" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
            De la convocatoria<br/>
            <span style="color:var(--c-accent)">al fallo.</span>
          </h2>
          <ol class="flex flex-col gap-4 list-none m-0 p-0">
            {pasos.map((s) => (
              <li class="flex items-start gap-4">
                
                <p class="text-sm leading-relaxed m-0" style="color:var(--c-text-2)">{s.t}</p>
              </li>
            ))}
          </ol>
          <div class="flex flex-col sm:flex-row gap-3 mt-8">
            <a href={whatsappUrl('Hola, tengo una convocatoria y quiero soporte técnico para la propuesta.')} target="_blank" rel="noopener" class="btn btn-primary">
              Enviar mi convocatoria
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" style="background:var(--c-bg-alt)" aria-labelledby="faq-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">

        <div>
          <span class="section-eyebrow mb-4 inline-flex">Preguntas frecuentes</span>
          <h2 id="faq-title" class="font-display font-bold mb-6" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
            Lo que más nos<br/>
            <span style="color:var(--c-accent)">preguntan.</span>
          </h2>
          <p class="text-sm leading-relaxed" style="color:var(--c-text-2)">
            ¿Tu duda no aparece aquí? Escríbenos por {CANAL_CONTACTO} con los datos de tu convocatoria
            y te respondemos con la solución concreta para esa licitación.
          </p>
        </div>

        <div class="flex flex-col">
          {faqs.map((f, i) => (
            <details class="faq-item group" style={`border-top:1px solid var(--c-line);${i === faqs.length - 1 ? 'border-bottom:1px solid var(--c-line);' : ''}`}>
              <summary class="flex items-center justify-between gap-4 py-5 cursor-pointer">
                <span class="font-display font-semibold text-sm" style="color:var(--c-ink)">{f.q}</span>
                <span class="faq-icon font-display font-bold text-xl shrink-0" style="color:var(--c-accent)">+</span>
              </summary>
              <p class="text-sm leading-relaxed pb-5 m-0" style="color:var(--c-text-2)">{f.a}</p>
            </details>
          ))}
        </div>

      </div>
    </div>
  </section>

  <!-- Cross-links -->
  <section class="section" style="background:var(--c-bg)" aria-labelledby="cross-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">

        <div>
          <span class="section-eyebrow mb-4 inline-flex">Un solo proveedor</span>
          <h2 id="cross-title" class="font-display font-bold mb-6" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
            Equipo, servicio<br/>
            <span style="color:var(--c-accent)">y expediente.</span>
          </h2>
          <p class="text-sm leading-relaxed mb-8" style="color:var(--c-text-2)">
            Más allá de la licitación, somos tu proveedor integral: catálogo certificado,
            servicios que mantienen el equipo vigente y la documentación auditable que cierra
            cada contrato. Cuéntanos tu caso y lo armamos completo.
          </p>
          <a href={whatsappUrl('Hola, quiero cotizar equipo para una licitación.')} target="_blank" rel="noopener" class="btn btn-primary">
            Cotizar por {CANAL_CONTACTO}
          </a>
        </div>

        <div class="lg:pl-16" style="border-left:1px solid var(--c-line)">
          <h2 class="font-display font-bold text-sm mb-5" style="color:var(--forge-300)">
            También te puede servir
          </h2>
          <ul class="flex flex-col list-none m-0 p-0" style="border-top:1px solid var(--c-line)">
            {[
              { label: 'Equipo para bomberos', desc: 'Equipo NFPA y NOM en 10 categorías', href: '/productos' },
              { label: 'Soporte para licitaciones (servicio)', desc: 'Alcance y entregables del servicio', href: '/servicios/licitaciones' },
              { label: 'Guía de normas y certificaciones', desc: 'Qué NOM y NFPA aplican por bien', href: '/certificaciones' },
              { label: 'Cómo especificar trajes en licitaciones', desc: 'Guía técnica para redactar bases', href: '/blog/especificaciones-traje-bombero-licitaciones' },
              { label: 'Cobertura nacional', desc: 'Entrega y servicio en los 32 estados', href: '/cobertura' },
              { label: 'Conoce la empresa', desc: 'Quiénes somos, cobertura y certificaciones', href: '/empresa' },
            ].map((l) => (
              <li style="border-bottom:1px solid var(--c-line)">
                <a href={l.href} class="group flex items-center justify-between gap-4 py-4">
                  <span class="flex flex-col gap-0.5">
                    <span class="font-display font-semibold text-sm group-hover:text-[var(--c-accent)]" style="color:var(--c-ink)">{l.label}</span>
                    <span class="text-xs" style="color:var(--c-muted)">{l.desc}</span>
                  </span>
                  
                </a>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .cap-card:hover { border-color: var(--c-line-strong) !important; }
  details.faq-item summary { list-style: none; }
  details.faq-item summary::-webkit-details-marker { display: none; }
  details.faq-item[open] .faq-icon { transform: rotate(45deg); }
</style>
