---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { SITE } from '@config/site';

const canonicalURL = `${SITE.url}/licitaciones/`;
const seoMeta = {
  title: 'Licitaciones de Equipo Contra Incendio en México | Guía',
  description: 'Guía para revisar licitaciones de equipo contra incendio en México: partidas, fichas técnicas, evidencia documental, entregas y comparación de empresas.',
  canonicalURL,
};

const etapas = [
  { n: '01', title: 'Leer convocatoria y anexos', text: 'Identifica fechas, partidas, cantidades, lugar de entrega, criterios de evaluación, formatos y causas de desechamiento indicadas en el procedimiento.' },
  { n: '02', title: 'Construir una matriz de cumplimiento', text: 'Relaciona cada requisito con la página, formato o documento que lo atiende y registra quién debe emitirlo.' },
  { n: '03', title: 'Aclarar antes de asumir', text: 'Documenta inconsistencias o requisitos ambiguos y utiliza el mecanismo de aclaración previsto en la convocatoria.' },
  { n: '04', title: 'Comparar empresas', text: 'Solicita propuestas sobre el mismo alcance y confirma que cada empresa puede acreditar lo que declara para las partidas que ofrece.' },
  { n: '05', title: 'Revisar la propuesta final', text: 'Comprueba que versiones, firmas, anexos, importes, impuestos, plazos y archivos coincidan antes de presentar.' },
];

const documentos = [
  { title: 'Ficha técnica', text: 'Debe identificar el producto o solución propuesta y permitir comparar sus características con la partida.' },
  { title: 'Evidencia normativa', text: 'Cuando las bases la soliciten, confirma emisor, modelo, configuración, alcance y vigencia del documento.' },
  { title: 'Cartas y manifiestos', text: 'Verifica quién debe firmarlos y evita atribuir al fabricante o distribuidor declaraciones que no haya emitido.' },
  { title: 'Propuesta económica', text: 'Revisa unidad, cantidad, moneda, impuestos, vigencia y cualquier costo adicional o exclusión.' },
  { title: 'Entrega y aceptación', text: 'Confirma destino, plazo, documentación de entrega, pruebas, capacitación y criterios de aceptación.' },
  { title: 'Garantía y servicio', text: 'Distingue garantía de producto, instalación y servicio; documenta responsables, condiciones y exclusiones.' },
];

const datosProveedor = [
  'Identidad legal y datos de contacto comprobables.',
  'Experiencia o referencias solo cuando puedan verificarse.',
  'Capacidad para suministrar exactamente la partida propuesta.',
  'Documentación emitida para el modelo y configuración correctos.',
  'Condiciones de entrega, garantía y servicio por escrito.',
  'Aceptación expresa de plazos, penalizaciones y demás condiciones de las bases.',
];

const faqs = [
  { q: '¿FIREFIGHTERS MX prepara o presenta licitaciones?', a: 'No. FIREFIGHTERS MX es un directorio y una plataforma editorial. Esta guía organiza criterios generales y facilita la localización de empresas; la integración y presentación de cada propuesta corresponde a sus participantes y asesores.' },
  { q: '¿Qué documento demuestra que un producto cumple una norma?', a: 'Depende de lo exigido en las bases y del esquema de evaluación aplicable. Solicita el documento del modelo y configuración exactos, revisa quién lo emitió, qué cubre y si está vigente.' },
  { q: '¿Una carta de distribuidor siempre es obligatoria?', a: 'No existe una respuesta única. Debe revisarse el requisito concreto de la convocatoria, la partida y la forma en que las bases piden acreditarlo.' },
  { q: '¿Cómo comparo proveedores para una licitación?', a: 'Comparte el mismo anexo y matriz de requisitos, pide respuestas por partida y compara evidencia, alcance, exclusiones, entrega, garantía y precio sobre una base equivalente.' },
  { q: '¿Dónde localizo empresas del sector?', a: 'Consulta el directorio por giro y estado. La inclusión de una ficha no acredita capacidad para participar en una convocatoria; esa condición debe verificarse con la empresa y el procedimiento correspondiente.' },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Licitaciones', item: canonicalURL },
  ],
};
const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article', '@id': `${canonicalURL}#article`,
  headline: seoMeta.title, description: seoMeta.description, url: canonicalURL, inLanguage: 'es-MX',
  author: { '@type': 'Organization', '@id': `${SITE.url}/#organization`, name: SITE.name },
  publisher: { '@id': `${SITE.url}/#organization` },
  mainEntityOfPage: canonicalURL,
};
const faqSchema = {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({ '@type': 'Question', name: faq.q, acceptedAnswer: { '@type': 'Answer', text: faq.a } })),
};
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, articleSchema, faqSchema]}>
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb"><div class="container-site"><ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)"><li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li><li aria-hidden="true">/</li><li aria-current="page" style="color:#94A3B8">Licitaciones</li></ol></div></nav>

  <section class="relative overflow-hidden" style="background:#040A12;padding-block:5rem">
    <div class="container-site relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <div><span class="section-eyebrow mb-5 inline-flex">Guía editorial · Compras técnicas</span><h1 class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2.4rem,5.5vw,4.4rem);line-height:0.95">Licitaciones de<br/><span style="color:#F75000">equipo contra incendio.</span></h1><div class="flex flex-col sm:flex-row gap-3"><a href="/empresas/" class="btn btn-primary btn-lg">Buscar empresas</a><a href="/productos/" class="btn btn-ghost btn-lg">Consultar equipos</a></div></div>
      <div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,0.1)"><p class="text-sm leading-[1.9] mb-5" style="color:#94A3B8">Una licitación de equipo contra incendio puede combinar requisitos técnicos, administrativos, económicos y de entrega. La convocatoria y sus anexos son la referencia para construir una matriz de cumplimiento.</p><p class="text-sm leading-[1.9]" style="color:#64748B">Esta página no sustituye las bases, una asesoría legal ni la revisión técnica del procedimiento. Verifica cada requisito en su versión publicada.</p></div>
    </div>
  </section>

  <QuickLinksBar />

  <section class="section" style="background:#070E1A" aria-labelledby="etapas-title"><div class="container-site"><div class="max-w-3xl mb-10"><span class="section-eyebrow mb-4 inline-flex">Proceso de revisión</span><h2 id="etapas-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.9rem,3.8vw,3rem);line-height:1.05">Cómo revisar una<br/><span style="color:#F75000">convocatoria.</span></h2></div><ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 list-none m-0 p-0 gap-px" style="background:rgba(74,117,153,0.18);border:1px solid rgba(74,117,153,0.18)">{etapas.map((etapa) => <li class="p-6" style="background:#080F1A"><span class="font-display font-bold text-2xl" style="color:#F75000">{etapa.n}</span><h3 class="font-display font-bold text-base my-3" style="color:#FFFFFF">{etapa.title}</h3><p class="text-xs leading-relaxed" style="color:#64748B">{etapa.text}</p></li>)}</ol></div></section>

  <section class="section" style="background:#040A12" aria-labelledby="documentos-title"><div class="container-site"><div class="max-w-3xl mb-10"><span class="section-eyebrow mb-4 inline-flex">Expediente técnico</span><h2 id="documentos-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.9rem,3.8vw,3rem);line-height:1.05">Documentos que pueden<br/><span style="color:#F75000">formar parte de la propuesta.</span></h2><p class="text-sm leading-relaxed mt-4" style="color:#94A3B8">La lista exacta depende de cada procedimiento. No presentes una certificación, carta o manifiesto como equivalente si las bases exigen otra evidencia.</p></div><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">{documentos.map((doc) => <article class="p-7" style="background:#080F1A;border:1px solid rgba(74,117,153,0.18)"><h3 class="font-display font-bold text-lg mb-3" style="color:#FFFFFF">{doc.title}</h3><p class="text-xs leading-relaxed" style="color:#64748B">{doc.text}</p></article>)}</div></div></section>

  <section class="section" style="background:#070E1A" aria-labelledby="proveedor-title"><div class="container-site grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start"><div><span class="section-eyebrow mb-4 inline-flex">Debida revisión</span><h2 id="proveedor-title" class="font-display font-bold mb-5" style="color:#FFFFFF;font-size:clamp(1.9rem,3.8vw,3rem);line-height:1.05">Qué confirmar con<br/><span style="color:#F75000">cada empresa.</span></h2><p class="text-sm leading-relaxed" style="color:#94A3B8">Una ficha del directorio ayuda a localizar empresas, pero no acredita por sí misma experiencia, autorización, solvencia o capacidad de entrega.</p></div><ul class="flex flex-col list-none m-0 p-0" style="border-top:1px solid rgba(74,117,153,0.18)">{datosProveedor.map((dato) => <li class="flex items-start gap-3 py-4 text-sm" style="color:#94A3B8;border-bottom:1px solid rgba(74,117,153,0.18)"><span aria-hidden="true" style="color:#F75000">■</span>{dato}</li>)}</ul></div></section>

  <section class="section" style="background:#040A12" aria-labelledby="faq-title"><div class="container-site grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start"><div><span class="section-eyebrow mb-4 inline-flex">Preguntas frecuentes</span><h2 id="faq-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.9rem,3.8vw,3rem);line-height:1.05">Licitaciones y<br/><span style="color:#F75000">selección de empresas.</span></h2></div><div style="border:1px solid rgba(74,117,153,0.2);background:#0C1825">{faqs.map((faq) => <details class="faq-item group" style="border-bottom:1px solid rgba(74,117,153,0.15)"><summary class="flex items-start justify-between gap-4 cursor-pointer list-none p-6"><h3 class="font-display font-semibold pr-2 m-0" style="color:#FFFFFF;font-size:0.875rem;line-height:1.375">{faq.q}</h3><span class="faq-icon" style="color:#FF6B26">+</span></summary><p class="px-6 pb-6 text-sm leading-relaxed" style="color:#64748B">{faq.a}</p></details>)}</div></div></section>

  <section style="background:#F75000;padding-block:4rem" aria-label="Directorio de empresas para licitaciones"><div class="container-site"><div class="flex flex-col lg:flex-row items-center justify-between gap-8"><div><p class="text-xs font-display font-bold uppercase tracking-[0.2em] mb-3" style="color:rgba(255,255,255,0.7)">Directorio nacional</p><h2 class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.75rem,3.5vw,2.5rem);line-height:1.1">Localiza empresas por<br/>giro y estado.</h2></div><a href="/empresas/" class="btn" style="background:#FFFFFF;color:#F75000;font-weight:700">Explorar directorio</a></div></div></section>
</BaseLayout>
