---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import LineaCard from '@components/products/LineaCard.astro';
import L2Sidebar from '@components/l2/L2Sidebar.astro';
import L2Guia from '@components/l2/L2Guia.astro';
import L2Cotizar from '@components/l2/L2Cotizar.astro';
import { bloqueCategorias, bloqueMarcas, bloqueIndustrias, bloqueServicios, bloqueGuias, anchoFila, type L2Link } from '@lib/l2';
import { allCategories } from '@data/categories';
import { lineaPorSlug } from '@lib/linea-card';
import '@styles/l2.css';
import { industries } from '@data/industries';
import { SITE, whatsappUrl, CANAL_CONTACTO } from '@config/site';

const canonicalURL = `${SITE.url}/industrias/`;

const seoMeta = {
  title: 'Equipo contra incendio por industria y sector en México',
  description:
    'Equipo contra incendio por sector: bomberos municipales, brigadas industriales, aeropuertos ARFF, hospitales, hoteles, refinerías y minería.',
  canonicalURL,
};

/* ─── JSON-LD ──────────────────────────────────────────────── */

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Industrias', item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: 'Industrias y sectores que equipamos contra incendio',
  description: seoMeta.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: industries.length,
    itemListElement: industries.map((ind, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: ind.name,
      url: `${SITE.url}${ind.href}`,
    })),
  },
};

/* ─── Plantilla L2 (homologada con /productos/, 2026-10) ────────── */
const secciones = [
  { id: 'sectores', label: 'Sectores' },
  { id: 'soluciones', label: 'Soluciones' },
  { id: 'tu-sector', label: 'Tu sector' },
];
const GUIAS_INDUSTRIAS: L2Link[] = [
  { label: 'Normas NFPA y NOM aplicables', href: '/certificaciones/' },
  { label: 'Guía NOM-002-STPS-2010', href: '/blog/nom-002-stps-guia-completa/' },
  { label: 'Cómo equipar una estación de bomberos', href: '/blog/como-equipar-estacion-bomberos-desde-cero/' },
  { label: 'EPP del brigadista contra incendio', href: '/blog/epp-brigadista-contra-incendio-que-necesitas/' },
  { label: 'Protección contra incendio en bodegas y almacenes', href: '/blog/proteccion-contra-incendio-bodegas-almacenes/' },
  { label: 'Incendios en cocinas comerciales', href: '/blog/incendios-en-cocinas-comerciales-prevencion-extintor-k/' },
  { label: 'Niveles de protección HAZMAT', href: '/blog/niveles-proteccion-hazmat-epa-abc/' },
  { label: 'Licitaciones de equipo contra incendio', href: '/licitaciones/' },
];
const barra = (h: string) => (h.endsWith('/') ? h : `${h}/`);
/* Equipo recomendado del sector (recommendedCategories) → páginas de categoría */
const equipoDe = (slugs: string[]) => slugs
  .map((c) => allCategories.find((x) => x.slug === c))
  .filter((c): c is NonNullable<typeof c> => !!c)
  .map((c) => ({ label: lineaPorSlug(c.slug)?.titulo ?? c.label, href: `/productos/${c.slug}/` }));
const tambien = [
  { label: 'Equipo para bomberos', desc: 'Equipo NFPA y NOM en 10 categorías', href: '/productos' },
  { label: 'Servicios profesionales', desc: 'Capacitación, mantenimiento, instalación y auditoría', href: '/servicios' },
  { label: 'Guía de normas y certificaciones', desc: 'Qué NOM y NFPA aplican según tu giro', href: '/certificaciones' },
  { label: 'Soporte para licitaciones', desc: 'CompraNet, PEMEX, CFE y municipios', href: '/licitaciones' },
  { label: 'Cobertura nacional', desc: 'Entrega y servicio en los 32 estados', href: '/cobertura' },
  { label: 'Conoce la empresa', desc: 'Quiénes somos, cobertura y certificaciones', href: '/empresa' },
];

const trustPoints = [
  { title: 'Experiencia por sector', text: 'Un ejecutivo que ya equipó proyectos como el tuyo: conoce normas, tiempos y presupuestos del giro.' },
  { title: 'Norma correcta por giro', text: 'NOM, NFPA, ASEA, OACI o COFEPRIS — mapeamos el marco que rige tu operación.' },
  { title: 'Cross de producto y servicio', text: 'Equipo + capacitación + mantenimiento en un solo contrato con calendario.' },
  { title: 'Documentación auditable', text: 'Cada entrega con la evidencia que pide tu autoridad, aseguradora o corporativo.' },
];
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema]}>

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:var(--c-bg-alt);border-bottom:1px solid var(--c-line)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
        <li><a href="/" class="hover:text-[var(--c-accent)]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:var(--c-text-2)" aria-current="page">Industrias</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background:var(--c-bg);padding-block:5rem">

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <div>
          <span class="section-eyebrow mb-5 inline-flex">Soluciones por sector</span>
          <h1 class="font-display font-bold mb-6" style="color:var(--c-ink);font-size:clamp(2.25rem,4.5vw,3.5rem);line-height:1.08">
            Industrias que<br/>
            <span style="color:var(--c-accent)">Equipamos</span>
          </h1>
          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href={whatsappUrl('Hola, quiero una solución contra incendio para mi sector.')}
              target="_blank" rel="noopener"
              class="btn btn-primary btn-lg"
            >
              Cotizar por {CANAL_CONTACTO}
            </a>
            <a href="/cotizacion" class="btn btn-ghost btn-lg">Cotización formal</a>
          </div>
        </div>

        <div class="lg:pl-16" style="border-left:1px solid var(--c-line)">
          <p class="text-sm leading-[1.9] mb-5" style="color:var(--c-text-2)">
            Cada sector responde a riesgos y marcos normativos distintos:
            <strong style="color:var(--c-text)">cuerpos de bomberos municipales, brigadas industriales NOM-002,
            aeropuertos ARFF, hospitales, hoteles, refinerías y petroquímica, minería y unidades de
            Protección Civil</strong>. Conocemos los ocho porque llevamos más de 45 años equipándolos.
          </p>
          <p class="text-sm leading-[1.9] mb-6" style="color:var(--c-muted)">
            Por eso no vendemos catálogo genérico: cada solución combina el equipo certificado,
            los servicios y la documentación que tu autoridad específica va a auditar — STPS,
            Protección Civil, AFAC, ASEA, COFEPRIS o el órgano fiscalizador de tu municipio.
          </p>
          <div class="flex flex-wrap gap-2">
            {['NOM-002-STPS','NFPA 1970','NFPA 403','NFPA 101','ASEA','NOM-023-STPS'].map(n => (
            <span class="badge badge-dark font-display text-[10px]">{n}</span>
          ))}
          </div>
        </div>

      </div>
    </div>

  </section>

  <!-- Accesos rápidos (interlinking) -->
  <QuickLinksBar />

  <!-- Pilares -->
  <section class="section-tight" style="background:var(--c-bg-alt)" aria-labelledby="garantias-title">
    <div class="container-site">
      <h2 id="garantias-title" class="sr-only">Por qué una solución por sector</h2>
      <div class="l2-trust">
        {trustPoints.map((t) => (
          <div><h3>{t.title}</h3><p>{t.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Plantilla L2: columna principal + barra lateral -->
  <div class="container-site l2-shell">
    <L2Sidebar
      resumen="Navegar las industrias"
      secciones={secciones}
      bloques={[bloqueIndustrias(), bloqueServicios(), bloqueCategorias(), bloqueGuias(GUIAS_INDUSTRIAS), bloqueMarcas()]}
      cotizar={{ titulo: 'Cotiza para tu sector', texto: 'Equipo certificado, servicios y la documentación que audita tu autoridad, en una sola propuesta.', msg: 'Hola, quiero una solución contra incendio para mi sector.' }}
    />

    <div class="l2-main">

      <!-- Sectores -->
      <section id="sectores" class="l2-sec" aria-labelledby="industrias-title">
        <header class="l2-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Sectores</span>
          <h2 id="industrias-title" class="l2-h2">Equipo contra incendio por industria: ocho sectores, una solución a la medida</h2>
          <p class="l2-lead">
            Cada sector tiene su propia página con los riesgos típicos del giro, la solución
            recomendada, el equipamiento y los servicios que aplican, y respuestas a las
            preguntas que más nos hacen sus responsables de seguridad.
          </p>
        </header>
        <ul class="l2-grid" role="list">
          {industries.map((ind, i) => (
            <li class={anchoFila(i, industries.length) || undefined}>
              <LineaCard
                href={barra(ind.href)}
                norma={ind.norm}
                titulo={ind.name}
                texto={ind.shortDesc}
                imagen={ind.spotlight.image}
                imagenAlt={ind.spotlight.imageAlt}
                hijas={equipoDe(ind.recommendedCategories)}
                cta={`Equipo contra incendio para ${ind.name.toLowerCase()}`}
                nivel="h3"
                subLabel="Equipo recomendado"
              />
            </li>
          ))}
        </ul>
      </section>

      <!-- Soluciones por sector (antes: ocho Spotlight a pantalla completa) -->
      <section id="soluciones" class="l2-sec" aria-labelledby="soluciones-title">
        <header class="l2-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Soluciones por sector</span>
          <h2 id="soluciones-title" class="l2-h2">Cómo resolvemos la protección contra incendio de cada sector</h2>
          <p class="l2-lead">Riesgo típico, norma que lo regula y la combinación de equipo y servicio que aplica en cada giro.</p>
        </header>
        <div class="l2-guias">
          {industries.map((ind) => (
            <L2Guia
              id={ind.slug}
              eyebrow={ind.norm}
              title={ind.spotlight.title}
              highlight={ind.spotlight.highlight}
              paragraph={ind.spotlight.paragraphs[0]}
              subsections={ind.spotlight.subsections}
              image={ind.spotlight.image}
              imageAlt={ind.spotlight.imageAlt}
              cta={{ href: barra(ind.href), label: `Solución contra incendio para ${ind.name.toLowerCase()}` }}
              whatsappMsg={`Hola, quiero una solución contra incendio para ${ind.name.toLowerCase()}.`}
            />
          ))}
        </div>
      </section>

      <!-- ¿Tu sector no aparece? + cross-links -->
      <L2Cotizar
        id="tu-sector"
        eyebrow="¿Tu sector no aparece?"
        titulo="Toda operación con riesgo"
        destacado="tiene una solución."
        texto="Centros logísticos, escuelas, centros comerciales, data centers, agroindustria — si tu operación tiene personal y riesgo de incendio, la NOM-002-STPS ya te aplica y nosotros ya hemos equipado a alguien parecido a ti. Cuéntanos tu caso y armamos la solución con el mismo método: diagnóstico, norma correcta y documentación auditable."
        cta={{ label: `Contar mi caso por ${CANAL_CONTACTO}`, msg: 'Hola, mi sector no aparece en su sitio y quiero una solución contra incendio.' }}
        tambien={tambien}
      />

    </div>
  </div>

</BaseLayout>
