---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout
  title="Equipos para Refinerías y Petroquímica PEMEX — FIREFIGHTERS MX"
  description="Equipo para brigadas de refinerías, plataformas y petroquímicas en México. HAZMAT Nivel A/B, SCBA 60 min, trajes de proximidad, espuma AFFF. PEMEX proveedor."
>
  <section class="bg-gradient-fire py-20">
    <div class="container-site text-white">
      <h1 class="section-title text-white mb-6">Refinerías y Petroquímica</h1>
      <p class="section-subtitle text-fire-200 max-w-2xl">
        Equipamiento especializado para brigadas de PEMEX, petroquímicas y terminales de almacenamiento.
        Proveedor registrado en el sistema de adquisiciones de PEMEX.
      </p>
      <a href="/cotizacion" class="btn-gold btn-lg mt-8 inline-flex">Cotizar para refinería</a>
    </div>
  </section>
  <section class="section bg-white">
    <div class="container-site grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {[
        { icon: "☣️", title: "Trajes HAZMAT Nivel A/B", norm: "NFPA 1991/1992", desc: "Trajes de encapsulamiento total para derrames de hidrocarburos y productos químicos peligrosos." },
        { icon: "😷", title: "SCBA 60 min", norm: "NFPA 1981", desc: "Equipos de aire autónomo de 60 minutos para operaciones prolongadas en atmósferas IDLH." },
        { icon: "🧥", title: "Trajes de Proximidad", norm: "NFPA 1976", desc: "Para operaciones cercanas a llamas de hidrocarburos o metales fundidos. Aluminizados." },
        { icon: "🧴", title: "Espuma AFFF / FP", norm: "NFPA 11", desc: "Concentrado al 3%/6% para grandes derrames de combustible, tanques de almacenamiento." },
        { icon: "🔍", title: "Detectores de Gas Multi-Gas", norm: "ATEX / IECEx", desc: "Detectores portátiles LEL, O₂, H₂S, CO para personal en zonas clasificadas." },
        { icon: "📋", title: "Licitaciones PEMEX", norm: "CompraNet", desc: "Fichas técnicas completas y registro de proveedor para participar en concursos de PEMEX." },
      ].map((item) => (
        <div class="card-fire p-6">
          <span class="text-3xl mb-4 block">{item.icon}</span>
          <span class="badge-gold mb-3 inline-block">{item.norm}</span>
          <h3 class="font-bold text-dark-900 mb-2">{item.title}</h3>
          <p class="text-dark-500 text-sm">{item.desc}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
