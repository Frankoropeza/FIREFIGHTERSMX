---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
---
<BaseLayout
  title="Equipamiento para Protección Civil en México — FIREFIGHTERS MX"
  description="Equipo certificado NFPA y NOM para unidades de Protección Civil estatal y municipal: EPP, rescate, primeros auxilios y capacitación. Soporte para licitaciones."
>
  <section class="bg-gradient-fire py-16">
    <div class="container-site text-white">
      <h1 class="section-title text-white mb-6">Protección Civil Estatal y Municipal</h1>
      <p class="section-subtitle text-fire-200 max-w-2xl">
        Equipamiento integral para coordinaciones y unidades de Protección Civil:
        EPP certificado, rescate urbano, atención prehospitalaria y capacitación NFPA.
      </p>
      <a href="/cotizacion" class="btn-gold btn-lg mt-8 inline-flex">Cotizar equipamiento PC</a>
    </div>
  </section>
  <!-- Accesos rápidos (interlinking) -->
  <QuickLinksBar />

  <section class="section bg-white">
    <div class="container-site grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {[
        { icon: "🦺", title: "EPP para Respondientes", desc: "Cascos de rescate, uniformes, botas, guantes y protección visual certificada para personal operativo." },
        { icon: "🪢", title: "Rescate Urbano y Vertical", desc: "Cuerdas, arneses, camillas canastilla, trípodes y herramienta USAR para estructuras colapsadas." },
        { icon: "🚑", title: "Atención Prehospitalaria", desc: "Botiquines, DEA, férulas, collarines e inmovilizadores para primera respuesta." },
        { icon: "📡", title: "Drones y Evaluación", desc: "Drones con cámara térmica para evaluación de riesgos, búsqueda de personas e incendios forestales." },
        { icon: "🎓", title: "Capacitación Certificada", desc: "Formación NFPA y constancias DC-3: brigadas, materiales peligrosos, búsqueda y rescate." },
        { icon: "📄", title: "Soporte para Licitaciones", desc: "Fichas técnicas, manifiestos NOM/NFPA y acompañamiento en procesos de adjudicación y CompraNet." },
      ].map((item) => (
        <div class="card p-6">
          <span class="text-3xl mb-4 block">{item.icon}</span>
          <h3 class="font-bold text-dark-900 mb-2">{item.title}</h3>
          <p class="text-dark-500 text-sm">{item.desc}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
