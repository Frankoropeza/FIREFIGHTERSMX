---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout
  title="Equipos ARFF para Aeropuertos — FIREFIGHTERS MX México"
  description="Equipos de rescate y extinción de incendios aeronáuticos (ARFF) para aeropuertos en México. Trajes de proximidad, SCBA, agentes AFFF y espuma fluoroproteína."
>
  <section class="bg-gradient-fire py-20">
    <div class="container-site text-white">
      <h1 class="section-title text-white mb-6">Aeropuertos — ARFF</h1>
      <p class="section-subtitle text-fire-200 max-w-2xl">
        Equipamiento especializado para unidades ARFF (Aircraft Rescue and Fire Fighting).
        Cumplimiento ICAO, FAA y NFPA 403.
      </p>
      <a href="/cotizacion" class="btn-gold btn-lg mt-8 inline-flex">Cotizar equipo ARFF</a>
    </div>
  </section>
  <section class="section bg-white">
    <div class="container-site">
      <div class="grid md:grid-cols-3 gap-6">
        {[
          { icon: "🧥", title: "Trajes de Proximidad", norm: "NFPA 1971 / NFPA 1976", desc: "Trajes aluminizados de alta reflectividad para exposición radiante intensa en pistas de aterrizaje." },
          { icon: "😷", title: "SCBA ARFF", norm: "NFPA 1981", desc: "Equipos de respiración autónoma de 45-60 minutos para operaciones prolongadas en fuselaje." },
          { icon: "🧴", title: "Agentes Extintor AFFF", norm: "NFPA 11", desc: "Espuma AFFF al 3% y 6%, espuma fluoroproteína para derrames de combustible de aviación." },
          { icon: "⛑️", title: "Cascos ARFF", norm: "NFPA 1971", desc: "Cascos con visera aluminizada y protector de cuello para operaciones aeronáuticas." },
          { icon: "🔊", title: "Detectores de Gas", norm: "NFPA 72", desc: "Detectores de gas de aviación: Jet A-1, gas de escape de motores, CO y vapores inflamables." },
          { icon: "📋", title: "Capacitación ARFF", norm: "NFPA 1003", desc: "Curso NFPA 1003 — Airport Fire Fighter para personal de aeropuertos con prácticas en pista." },
        ].map((item) => (
          <div class="card p-6">
            <span class="text-3xl mb-4 block">{item.icon}</span>
            <span class="badge-gold mb-3 inline-block">{item.norm}</span>
            <h3 class="font-bold text-dark-900 mb-2">{item.title}</h3>
            <p class="text-dark-500 text-sm">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
