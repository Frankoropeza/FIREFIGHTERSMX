---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import LineaCard from '@components/products/LineaCard.astro';
import L2Sidebar from '@components/l2/L2Sidebar.astro';
import L2Cotizar from '@components/l2/L2Cotizar.astro';
import { bloqueCategorias, bloqueServicios, bloqueIndustrias, anchoFila as anchoFilaBlog, type L2Bloque } from '@lib/l2';
import { tarjetaBlog } from '@lib/blog-l2';
import '@styles/l2.css';
import { getCollection } from 'astro:content';
import { SITE, whatsappUrl, CANAL_CONTACTO } from '@config/site';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = allPosts[0];
const rest = allPosts.slice(1);

// Slugify helper (debe coincidir con /categoria y /tag)
function slugify(s: string): string {
  return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

// Categorías con conteo
const categoryCounts = allPosts.reduce<Record<string, number>>((acc, p) => {
  acc[p.data.category] = (acc[p.data.category] ?? 0) + 1;
  return acc;
}, {});
const categories = Object.keys(categoryCounts);

// Temas (tags) únicos
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags ?? []))].slice(0, 10);

// Recursos para el sidebar (interlinking)
const recursos = [
  { label: 'Directorio de productos', desc: '10 categorías NFPA · NOM', href: '/productos' },
  { label: 'Normas y certificaciones', desc: 'Qué NOM y NFPA aplican', href: '/certificaciones' },
  { label: 'Servicios contra incendio', desc: 'Capacitación · Mantenimiento', href: '/servicios' },
  { label: 'Industrias que atendemos', desc: 'Bomberos · Industria · PC', href: '/industrias' },
  { label: 'Conoce la empresa', desc: 'Quiénes somos y cobertura', href: '/empresa' },
];

/* ─── Plantilla L2 (2026-10) ─────────────────────────────────── */
const tarjeta = tarjetaBlog;
const secciones = [
  { id: 'articulos', label: 'Artículos' },
  { id: 'especialista', label: 'Especialista' },
];
const bloquesBlog: L2Bloque[] = [
  {
    id: 'blog-categorias', titulo: 'Categorías del blog', meta: `${allPosts.length} artículos técnicos`,
    grupos: [{ links: categories.map((c) => ({ label: c, href: `/blog/categoria/${slugify(c)}/`, n: categoryCounts[c] })) }],
  },
  {
    id: 'blog-destacados', titulo: 'Artículos destacados',
    grupos: [{ links: allPosts.slice(0, 5).map((p) => ({ label: p.data.title, href: `/blog/${p.id}/` })) }],
  },
  {
    id: 'blog-temas', titulo: 'Temas frecuentes',
    grupos: [{ links: allTags.map((t) => ({ label: t, href: `/blog/tag/${slugify(t)}/` })) }],
  },
  bloqueCategorias(), bloqueServicios(), bloqueIndustrias(),
];

const canonicalURL = `${SITE.url}/blog/`;

const seoMeta = {
  title: 'Blog técnico de equipo para bomberos: normas NFPA y NOM',
  description:
    'Guías técnicas de equipo para bomberos y protección contra incendio: NFPA 1970, NOM-002-STPS, extintores, SCBA, trajes y sistemas contra incendio.',
  canonicalURL,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: `Blog técnico ${SITE.metaName}`,
  description: seoMeta.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: allPosts.length,
    itemListElement: allPosts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Article',
        headline: p.data.title,
        description: p.data.description,
        url: `${SITE.url}/blog/${p.id}`,
      },
    })),
  },
};
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema]}>

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:var(--c-bg-alt);border-bottom:1px solid var(--c-line)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
        <li><a href="/" class="hover:text-[var(--c-accent)]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:var(--c-text-2)" aria-current="page">Blog</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background:var(--c-bg);padding-block:5rem">

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="section-eyebrow mb-5 inline-flex">Blog técnico · NFPA y NOM</span>
          <h1 class="font-display font-bold mb-6" style="color:var(--c-ink);font-size:clamp(2.25rem,4.5vw,3.5rem);line-height:1.08">
            Conocimiento<br/>
            <span style="color:var(--c-accent)">contra incendio</span>
          </h1>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="#articulos" class="btn btn-primary btn-lg">Artículos sobre equipo para bomberos y normativa</a>
            <a href="/contacto" class="btn btn-ghost btn-lg">Hablar con un especialista</a>
          </div>
        </div>

        <div class="lg:pl-16" style="border-left:1px solid var(--c-line)">
          <p class="text-sm leading-[1.9] mb-5" style="color:var(--c-text-2)">
            Guías técnicas, normatividad y criterios de selección para
            <strong style="color:var(--c-text)">bomberos, brigadas industriales y responsables
            de protección civil</strong>. Material redactado por especialistas y
            referenciado a la norma vigente.
          </p>
          <p class="text-sm leading-[1.9] mb-6" style="color:var(--c-muted)">
            Cada artículo cruza con el directorio, los servicios descritos y la guía de
            certificaciones para que pases de la teoría a la decisión de compra con respaldo documental.
          </p>
          <div class="flex flex-wrap gap-2">
            {['NFPA 1970','NFPA 1850','NOM-002-STPS','NOM-100-STPS','NOM-154-SCFI'].map((n) => (
            <span class="badge badge-dark font-display text-[10px]">{n}</span>
          ))}
          </div>
        </div>
      </div>
    </div>

  </section>

  <!-- Accesos rápidos (interlinking) -->
  <QuickLinksBar />

  <!-- Plantilla L2: columna principal + barra lateral -->
  <div class="container-site l2-shell">
    <L2Sidebar
      resumen="Navegar el blog"
      secciones={secciones}
      bloques={bloquesBlog}
      accion={{ titulo: '¿Dudas sobre normatividad?', texto: 'Un especialista te orienta sobre la norma y el equipo correcto para tu operación.', botones: [{ label: `Preguntar por ${CANAL_CONTACTO}`, href: whatsappUrl('Hola, tengo una duda técnica sobre normatividad contra incendio.'), primario: true }, { label: 'Solicitar cotización de equipo contra incendio', href: '/cotizacion/' }] }}
    />

    <div class="l2-main">

      <!-- Artículos -->
      <section id="articulos" class="l2-sec" aria-labelledby="blog-title">
        {allPosts.length === 0 ? (
          <div class="text-center py-20" style="color:var(--c-muted)">
            <p class="text-lg mb-2" style="color:var(--c-text-2)">Blog próximamente</p>
            <p class="text-sm">Estamos preparando guías técnicas especializadas para el sector bomberos.</p>
          </div>
        ) : (
          <Fragment>
            <header class="l2-sec-head">
              <span class="section-eyebrow mb-4 inline-flex">Últimas publicaciones</span>
              <h2 id="blog-title" class="l2-h2">Artículos técnicos sobre equipo contra incendio y normativa</h2>
              <p class="l2-lead">Guías de selección, normatividad NFPA y NOM y criterios de mantenimiento, ordenados del más reciente al más antiguo.</p>
            </header>

            <!-- Filtros por categoría (JS para UX, href para SEO/accesibilidad) -->
            <div class="flex flex-wrap gap-2 mb-8" id="blog-filters" role="group" aria-label="Filtrar por categoría">
              <a href="/blog/" class="blog-filter is-active" data-filter="all">Todos</a>
              {categories.map((cat) => (
                <a href={`/blog/categoria/${slugify(cat)}/`} class="blog-filter" data-filter={cat}>{cat}</a>
              ))}
            </div>

            <ul class="l2-grid" id="blog-grid" role="list">
              {featured && (
                <li class="blog-item l2-span-6" data-category={featured.data.category}>
                  <LineaCard {...tarjeta(featured)} nivel="h3" max={2} subLabel="Equipo relacionado" />
                </li>
              )}
              {rest.map((post, i) => (
                <li class={`blog-item ${anchoFilaBlog(i, rest.length)}`} data-category={post.data.category}>
                  <LineaCard {...tarjeta(post)} nivel="h3" max={2} subLabel="Equipo relacionado" />
                </li>
              ))}
            </ul>

            <p id="blog-empty" class="py-12 text-center text-sm" style="color:var(--c-muted)" hidden>
              No hay artículos en esta categoría por ahora.
            </p>
          </Fragment>
        )}
      </section>

      <!-- Especialista + cross-links -->
      <L2Cotizar
        id="especialista"
        eyebrow="Asesoría técnica"
        titulo="¿Dudas sobre"
        destacado="normatividad?"
        texto="Un especialista te orienta sobre la norma y el equipo correcto para tu operación."
        cta={{ label: `Preguntar por ${CANAL_CONTACTO}`, msg: 'Hola, tengo una duda técnica sobre normatividad contra incendio.' }}
        tambien={recursos}
      />

    </div>
  </div>

</BaseLayout>

<style>
  /* Filtros por categoría — botones chip (sólo cambian color, fondo y borde) */
  .blog-filter { font-family: var(--font-display); font-size: .8125rem; font-weight: 600; padding: .4rem .9rem; border-radius: var(--radius-btn); background: var(--c-surface); color: var(--c-text-2); border: 1px solid var(--c-line-strong); text-decoration: none; transition: color .15s, background-color .15s, border-color .15s; }
  .blog-filter:hover { color: var(--c-ink); }
  .blog-filter.is-active { background: rgba(200,16,46,0.1); color: var(--c-accent); border-color: rgba(200,16,46,0.5); }
</style>

<script>
  // Filtro por categoría — progressive enhancement
  // Sin JS  cada chip navega a /blog/categoria/[slug] (SEO + accesibilidad)
  // Con JS  filtra en página y previene navegación (mejor UX)
  const filters = document.querySelectorAll<HTMLAnchorElement>('.blog-filter');
  const items = document.querySelectorAll<HTMLElement>('.blog-item');
  const empty = document.getElementById('blog-empty');

  function applyFilter(value: string) {
    let visible = 0;
    items.forEach((item) => {
      const match = value === 'all' || item.dataset.category === value;
      item.hidden = !match;
      if (match) visible++;
    });
    filters.forEach((f) => f.classList.toggle('is-active', f.dataset.filter === value));
    if (empty) empty.hidden = visible !== 0;
  }

  filters.forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault(); // JS activo  filtrar in-page en lugar de navegar
      applyFilter(link.dataset.filter || 'all');
    });
  });
</script>
