---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import BlogCard from '@components/blog/BlogCard.astro';
import { getCollection } from 'astro:content';
import { SITE, whatsappUrl, CANAL_CONTACTO } from '@config/site';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = allPosts[0];
const rest = allPosts.slice(1);

// Slugify helper (debe coincidir con /categoria y /tag)
function slugify(s: string): string {
  return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
}

// Categorías con conteo
const categoryCounts = allPosts.reduce<Record<string, number>>((acc, p) => {
  acc[p.data.category] = (acc[p.data.category] ?? 0) + 1;
  return acc;
}, {});
const categories = Object.keys(categoryCounts);

// Temas (tags) únicos
const allTags = [...new Set(allPosts.flatMap((p) => p.data.tags ?? []))].slice(0, 10);

// Recursos para el sidebar (interlinking)
const recursos = [
  { label: 'Directorio de productos', desc: '10 categorías NFPA · NOM', href: '/productos' },
  { label: 'Normas y certificaciones', desc: 'Qué NOM y NFPA aplican', href: '/certificaciones' },
  { label: 'Servicios contra incendio', desc: 'Capacitación · Mantenimiento', href: '/servicios' },
  { label: 'Industrias que atendemos', desc: 'Bomberos · Industria · PC', href: '/industrias' },
  { label: 'Conoce la empresa', desc: 'Quiénes somos y cobertura', href: '/empresa' },
];

const canonicalURL = `${SITE.url}/blog/`;

const seoMeta = {
  title: `Blog Técnico — Guías NFPA y NOM para Bomberos | ${SITE.name}`,
  description:
    'Blog técnico especializado en equipos para bomberos: guías NFPA 1970, normatividad NOM-002-STPS, extintores, SCBA, trajes y sistemas contra incendio en México.',
  canonicalURL,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: 'Blog técnico VIGILES',
  description: seoMeta.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: allPosts.length,
    itemListElement: allPosts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Article',
        headline: p.data.title,
        description: p.data.description,
        url: `${SITE.url}/blog/${p.id}`,
      },
    })),
  },
};
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema]}>

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:var(--c-bg-alt);border-bottom:1px solid var(--c-line)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
        <li><a href="/" class="hover:text-[var(--c-accent)]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:var(--c-text-2)" aria-current="page">Blog</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background:var(--c-bg);padding-block:5rem">

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="section-eyebrow mb-5 inline-flex">Blog técnico · NFPA y NOM</span>
          <h1 class="font-display font-bold mb-6" style="color:var(--c-ink);font-size:clamp(2.25rem,4.5vw,3.5rem);line-height:1.08">
            Conocimiento<br/>
            <span style="color:var(--c-accent)">contra incendio</span>
          </h1>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="#articulos" class="btn btn-primary btn-lg">Artículos sobre equipo para bomberos y normativa</a>
            <a href="/contacto" class="btn btn-ghost btn-lg">Hablar con un especialista</a>
          </div>
        </div>

        <div class="lg:pl-16" style="border-left:1px solid var(--c-line)">
          <p class="text-sm leading-[1.9] mb-5" style="color:var(--c-text-2)">
            Guías técnicas, normatividad y criterios de selección para
            <strong style="color:var(--c-text)">bomberos, brigadas industriales y responsables
            de protección civil</strong>. Material redactado por especialistas y
            referenciado a la norma vigente.
          </p>
          <p class="text-sm leading-[1.9] mb-6" style="color:var(--c-muted)">
            Cada artículo cruza con el directorio, los servicios descritos y la guía de
            certificaciones para que pases de la teoría a la decisión de compra con respaldo documental.
          </p>
          <div class="flex flex-wrap gap-2">
            {['NFPA 1970','NFPA 1850','NOM-002-STPS','NOM-100-STPS','NOM-154-SCFI'].map((n) => (
            <span class="badge badge-dark font-display text-[10px]">{n}</span>
          ))}
          </div>
        </div>
      </div>
    </div>

  </section>

  <!-- Accesos rápidos (interlinking) -->
  <QuickLinksBar />

  <!-- Artículos + Sidebar -->
  <section id="articulos" class="section" style="background:var(--c-bg)" aria-labelledby="blog-title">
    <div class="container-site">

      {allPosts.length === 0 ? (
        <div class="text-center py-20" style="color:var(--c-muted)">
          <p class="text-lg mb-2" style="color:var(--c-text-2)">Blog próximamente</p>
          <p class="text-sm">Estamos preparando guías técnicas especializadas para el sector bomberos.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">

          <!-- ── Columna principal ────────────────────────────── -->
          <div class="lg:col-span-8">

            <div class="mb-8">
              <span class="section-eyebrow mb-4 inline-flex">Últimas publicaciones</span>
              <h2 id="blog-title" class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
                Artículos <span style="color:var(--c-accent)">técnicos</span>
              </h2>
            </div>

            <!-- Filtros por categoría (JS para UX, href para SEO/accesibilidad) -->
            <div class="flex flex-wrap gap-2 mb-8" id="blog-filters" role="group" aria-label="Filtrar por categoría">
              <a href="/blog" class="blog-filter is-active" data-filter="all" style="text-decoration:none">Todos</a>
              {categories.map((cat) => (
                <a
                  href={`/blog/categoria/${slugify(cat)}`}
                  class="blog-filter"
                  data-filter={cat}
                  style="text-decoration:none"
                >
                  {cat}
                </a>
              ))}
            </div>

            <!-- Destacado -->
            {featured && (
              <div class="blog-item mb-6" data-category={featured.data.category}>
                <BlogCard post={featured} featured={true} />
              </div>
            )}

            <!-- Grid -->
            <div class="card-grid" id="blog-grid">
              {rest.map((post) => (
                <div class="blog-item" data-category={post.data.category}>
                  <BlogCard post={post} />
                </div>
              ))}
            </div>

            <p id="blog-empty" class="py-12 text-center text-sm" style="color:var(--c-muted)" hidden>
              No hay artículos en esta categoría por ahora.
            </p>
          </div>

          <!-- ── Sidebar ──────────────────────────────────────── -->
          <aside class="lg:col-span-4">
            <div class="flex flex-col gap-8 lg:sticky" style="top:124px">

              <!-- Categorías (links reales  SEO crawlable) -->
              <div style="background:var(--c-bg-alt);border:1px solid var(--c-line)">
                <h3 class="font-display font-bold text-sm px-5 py-4" style="color:var(--c-accent);border-bottom:1px solid var(--c-line)">
                  Categorías
                </h3>
                <ul class="flex flex-col list-none m-0 p-0">
                  <li>
                    <a href="/blog" class="side-cat w-full flex items-center justify-between gap-3 px-5 py-3 is-active" style="text-decoration:none">
                      <span class="font-display text-sm">Todas</span>
                      <span class="text-xs" style="color:var(--forge-300)">{allPosts.length}</span>
                    </a>
                  </li>
                  {categories.map((cat) => (
                    <li style="border-top:1px solid var(--c-line)">
                      <a
                        href={`/blog/categoria/${slugify(cat)}`}
                        class="side-cat w-full flex items-center justify-between gap-3 px-5 py-3"
                        style="text-decoration:none"
                      >
                        <span class="font-display text-sm">{cat}</span>
                        <span class="text-xs" style="color:var(--forge-300)">{categoryCounts[cat]}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Artículos destacados (sin fecha) -->
              <div style="background:var(--c-bg-alt);border:1px solid var(--c-line)">
                <h3 class="font-display font-bold text-sm px-5 py-4" style="color:var(--c-accent);border-bottom:1px solid var(--c-line)">
                  Artículos destacados
                </h3>
                <ul class="flex flex-col list-none m-0 p-0">
                  {allPosts.slice(0, 5).map((post) => (
                    <li style="border-top:1px solid var(--c-line)">
                      <a href={`/blog/${post.id}`} class="side-post group flex flex-col gap-1 px-5 py-4">
                        <span class="text-[10px] font-display font-semibold uppercase tracking-widest" style="color:var(--forge-300)">{post.data.category}</span>
                        <span class="font-display font-semibold text-sm leading-snug group-hover:text-[var(--c-accent)]" style="color:var(--c-ink-2)">{post.data.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Temas frecuentes (links reales  SEO crawlable) -->
              {allTags.length > 0 && (
                <div style="background:var(--c-bg-alt);border:1px solid var(--c-line)">
                  <h3 class="font-display font-bold text-sm px-5 py-4" style="color:var(--c-accent);border-bottom:1px solid var(--c-line)">
                    Temas frecuentes
                  </h3>
                  <div class="flex flex-wrap gap-2 p-5">
                    {allTags.map((tag) => (
                      <a
                        href={`/blog/tag/${slugify(tag)}`}
                        class="badge badge-dark text-[10px] hover:bg-[var(--c-accent)] hover:text-white"
                        style="text-decoration:none"
                      >
                        #{tag}
                      </a>
                    ))}
                  </div>
                </div>
              )}

              <!-- Recursos (interlinking) -->
              <div style="background:var(--c-bg-alt);border:1px solid var(--c-line)">
                <h3 class="font-display font-bold text-sm px-5 py-4" style="color:var(--c-accent);border-bottom:1px solid var(--c-line)">
                  También te puede servir
                </h3>
                <ul class="flex flex-col list-none m-0 p-0">
                  {recursos.map((r) => (
                    <li style="border-top:1px solid var(--c-line)">
                      <a href={r.href} class="side-post group flex items-center justify-between gap-3 px-5 py-4">
                        <span class="flex flex-col gap-0.5">
                          <span class="font-display font-semibold text-sm group-hover:text-[var(--c-accent)]" style="color:var(--c-ink-2)">{r.label}</span>
                          <span class="text-xs" style="color:var(--c-muted)">{r.desc}</span>
                        </span>
                        
                      </a>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- CTA -->
              <div class="p-6 text-center" style="background:var(--c-bg-alt);border:1px solid var(--c-line)">
                <h3 class="font-display font-bold text-lg mb-2" style="color:var(--c-ink)">¿Dudas sobre normatividad?</h3>
                <p class="text-xs leading-relaxed mb-5" style="color:var(--c-text-2)">
                  Un especialista te orienta sobre la norma y el equipo correcto para tu operación.
                </p>
                <div class="flex flex-col gap-2">
                  <a href={whatsappUrl('Hola, tengo una duda técnica sobre normatividad contra incendio.')} target="_blank" rel="noopener" class="btn btn-primary btn-sm w-full">
                    Preguntar por {CANAL_CONTACTO}
                  </a>
                  <a href="/cotizacion" class="btn btn-ghost btn-sm w-full">Solicitar cotización de equipo contra incendio</a>
                </div>
              </div>

            </div>
          </aside>

        </div>
      )}

    </div>
  </section>

</BaseLayout>

<style>
  /* Filtros por categoría — botones chip (sin transición, hover instantáneo) */
  .blog-filter {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    padding: 0.4rem 0.9rem;
    border-radius: 2px;
    background: var(--c-surface);
    color: var(--c-text-2);
    border: 1px solid var(--c-line-strong);
    cursor: pointer;
  }
  .blog-filter:hover { color: var(--c-ink); border-color: var(--c-line-strong); }
  .blog-filter.is-active { background: rgba(200,16,46,0.15); color: var(--c-accent); border-color: rgba(200,16,46,0.5); }

  /* Categorías y posts del sidebar */
  .side-cat { background: transparent; color: var(--c-text); border: none; cursor: pointer; text-align: left; }
  .side-cat:hover { background: var(--c-surface); color: var(--c-ink); }
  .side-cat.is-active { background: rgba(200,16,46,0.1); color: var(--c-accent); }
  .side-cat.is-active .text-xs { color: var(--c-accent) !important; }
  .side-post:hover { background: var(--c-surface); }
</style>

<script>
  // Filtro por categoría — progressive enhancement
  // Sin JS  cada chip navega a /blog/categoria/[slug] (SEO + accesibilidad)
  // Con JS  filtra en página y previene navegación (mejor UX)
  const filters = document.querySelectorAll<HTMLAnchorElement>('.blog-filter');
  const items = document.querySelectorAll<HTMLElement>('.blog-item');
  const empty = document.getElementById('blog-empty');

  function applyFilter(value: string) {
    let visible = 0;
    items.forEach((item) => {
      const match = value === 'all' || item.dataset.category === value;
      item.hidden = !match;
      if (match) visible++;
    });
    filters.forEach((f) => f.classList.toggle('is-active', f.dataset.filter === value));
    if (empty) empty.hidden = visible !== 0;
  }

  filters.forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault(); // JS activo  filtrar in-page en lugar de navegar
      applyFilter(link.dataset.filter || 'all');
    });
  });
</script>
