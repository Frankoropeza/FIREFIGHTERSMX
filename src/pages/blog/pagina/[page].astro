---
// /blog/pagina/[page].astro — Paginación del blog (plantilla L2)
// =====================================================================
// /blog/pagina/2, /3… (la 1 la atiende /blog/index.astro).
// Con muchos artículos Google necesita URLs paginadas para indexarlos todos;
// sin paginación el rastreador abandona al terminar /blog.
// =====================================================================
import BaseLayout from '@layouts/BaseLayout.astro';
import BlogArchivoL2 from '@components/blog/BlogArchivoL2.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@config/site';
import { bloqueCategorias, bloqueServicios, bloqueIndustrias } from '@lib/l2';
import {
  bloqueCategoriasBlog, bloqueDestacadosBlog, bloqueTemasBlog, bloqueRecursosBlog, etiquetasPorFrecuencia,
} from '@lib/blog-l2';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const PAGE_SIZE = 8;
  const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);

  // Páginas 2, 3, … (la 1 la atiende /blog/index.astro)
  return Array.from({ length: totalPages - 1 }, (_, i) => {
    const page = i + 2;
    const start = (page - 1) * PAGE_SIZE;
    return {
      params: { page: String(page) },
      props: { posts: allPosts.slice(start, start + PAGE_SIZE), allPosts, currentPage: page, totalPages, totalPosts: allPosts.length },
    };
  });
}) satisfies GetStaticPaths;

const { posts, allPosts, currentPage, totalPages, totalPosts } = Astro.props;
const canonicalURL = `${SITE.url}/blog/pagina/${currentPage}/`;

const seoMeta = {
  title: `Blog de equipo para bomberos y normas NFPA — página ${currentPage}`,
  description:
    `Artículos técnicos de equipo para bomberos, página ${currentPage} de ${totalPages}: normas NFPA y NOM, EPP, SCBA, extintores y sistemas contra incendio.`,
  canonicalURL,
};

const hrefPagina = (p: number) => (p === 1 ? '/blog/' : `/blog/pagina/${p}/`);
const prevHref = hrefPagina(currentPage - 1);
const nextHref = currentPage < totalPages ? hrefPagina(currentPage + 1) : null;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog/` },
    { '@type': 'ListItem', position: 3, name: `Página ${currentPage}`, item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Blog FIREFIGHTERS MX — Página ${currentPage}`,
  url: canonicalURL,
  description: seoMeta.description,
  inLanguage: 'es-MX',
  isPartOf: { '@type': 'Blog', url: `${SITE.url}/blog/` },
};

const bloques = [
  bloqueCategoriasBlog(allPosts),
  bloqueDestacadosBlog(allPosts, posts.map((p) => p.id)),
  bloqueTemasBlog(etiquetasPorFrecuencia(allPosts), 'Temas frecuentes', undefined, 10),
  bloqueCategorias(), bloqueServicios(), bloqueIndustrias(), bloqueRecursosBlog(),
];
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema]}>
  {/* rel prev/next para indexación paginada */}
  <link rel="prev" href={`${SITE.url}${prevHref}`} slot="head" />
  {nextHref && <link rel="next" href={`${SITE.url}${nextHref}`} slot="head" />}

  <BlogArchivoL2
    actual={`Página ${currentPage}`}
    eyebrow={`Blog técnico · Página ${currentPage} de ${totalPages}`}
    posts={posts}
    h2={`Artículos técnicos sobre equipo contra incendio, página ${currentPage}`}
    lead={`Artículos ${(currentPage - 1) * 8 + 1} a ${(currentPage - 1) * 8 + posts.length} de ${totalPosts}, del más reciente al más antiguo.`}
    ariaLabel={`Artículos del blog, página ${currentPage}`}
    bloques={bloques}
  >
    <Fragment slot="titulo">Artículos <span style="color:var(--c-accent)">técnicos</span></Fragment>

    <Fragment slot="texto">
      <p class="text-sm leading-relaxed mb-4" style="color:var(--c-text-2)">
        Continuación del blog técnico de FIREFIGHTERS MX: normas NFPA y NOM, selección de
        equipo para bomberos, EPP y sistemas contra incendio, redactados para
        <strong style="color:var(--c-text)">bomberos, brigadas y responsables de protección civil</strong>.
      </p>
      <a href="/blog/" class="text-sm font-bold hover:text-[var(--c-accent)]" style="color:var(--c-text)">Últimos artículos del blog técnico</a>
    </Fragment>

    <nav aria-label="Paginación del blog" class="l2-pag">
      <a href={prevHref} class="btn btn-ghost" rel="prev">Artículos técnicos anteriores</a>

      <ul class="l2-pag-nums" role="list">
        {Array.from({ length: totalPages }, (_, i) => i + 1).map((p) => (
          <li>
            <a href={hrefPagina(p)} aria-label={`Blog técnico, página ${p}`} aria-current={p === currentPage ? 'page' : undefined}>{p}</a>
          </li>
        ))}
      </ul>

      {nextHref ? (
        <a href={nextHref} class="btn btn-ghost" rel="next">Artículos técnicos siguientes</a>
      ) : (
        <span class="btn btn-ghost l2-pag-off" aria-disabled="true">Artículos técnicos siguientes</span>
      )}
    </nav>
    <p class="l2-pag-info">{totalPosts} artículos · página {currentPage} de {totalPages}</p>
  </BlogArchivoL2>
</BaseLayout>
