---
// /blog/tag/[...tag].astro — Archivo de etiquetas del blog (plantilla L2)
// =====================================================================
// Una URL por etiqueta: /blog/tag/nfpa-1970, /trajes-bomberos, /extintores…
// Cola larga de alta intención: «NFPA 1970 trajes México» rankea mejor con una
// página que reúne los artículos que cubren ese estándar que con uno suelto.
//
// PERO sólo cuando de verdad reúne varios. Medido el 2026-09-11: de las 176
// etiquetas, 140 agrupaban UN artículo. Se indexa la que llega al umbral de
// `MIN_ARTICULOS_TAG`; el resto se genera igual, navegable y pasando enlaces,
// con `noindex, follow`.
// =====================================================================
import BaseLayout from '@layouts/BaseLayout.astro';
import BlogArchivoL2 from '@components/blog/BlogArchivoL2.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@config/site';
import { slugifyTag } from '@lib/slug';
import { tagIndexable } from '@lib/blog-taxonomia';
import { bloqueCategorias, bloqueServicios, bloqueIndustrias } from '@lib/l2';
import {
  bloqueCategoriasBlog, bloqueTemasBlog, bloqueRecursosBlog, etiquetasPorFrecuencia,
  hrefTag, tituloArchivo, descripcionArchivo,
} from '@lib/blog-l2';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  const tagMap = allPosts.reduce<Record<string, typeof allPosts>>((acc, p) => {
    for (const tag of p.data.tags ?? []) {
      if (!acc[tag]) acc[tag] = [];
      acc[tag].push(p);
    }
    return acc;
  }, {});

  return Object.entries(tagMap).map(([tag, posts]) => ({
    params: { tag: slugifyTag(tag) },
    props: { tag, posts, allPosts },
  }));
}) satisfies GetStaticPaths;

const { tag, posts, allPosts } = Astro.props;
const { tag: tagSlug } = Astro.params;
const canonicalURL = `${SITE.url}/blog/tag/${tagSlug}/`;
const n = posts.length;

const seoMeta = {
  title: tituloArchivo(tag),
  description: descripcionArchivo(tag),
  canonicalURL,
  /* Una etiqueta que no reúne varios artículos no es un destino de búsqueda:
     `follow` para no romper el grafo interno, `noindex` para no competir con
     el propio artículo que la lleva. */
  noindex: !tagIndexable(n),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog/` },
    { '@type': 'ListItem', position: 3, name: tag, item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${tag} — Blog FIREFIGHTERS MX`,
  url: canonicalURL,
  description: seoMeta.description,
  inLanguage: 'es-MX',
  isPartOf: { '@type': 'Blog', url: `${SITE.url}/blog/` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: n,
    itemListElement: posts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Article',
        headline: p.data.title,
        description: p.data.description,
        url: `${SITE.url}/blog/${p.id}`,
      },
    })),
  },
};

const bloques = [
  bloqueCategoriasBlog(allPosts),
  bloqueTemasBlog(etiquetasPorFrecuencia(allPosts), 'Otras etiquetas', tag, 14),
  bloqueCategorias(), bloqueServicios(), bloqueIndustrias(), bloqueRecursosBlog(),
];
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema]}>
  <BlogArchivoL2
    actual={tag}
    eyebrow={`Etiqueta · ${n} artículo${n !== 1 ? 's' : ''}`}
    posts={posts}
    h2={`Artículos sobre ${tag}`}
    lead={`${n === 1 ? 'Un artículo' : `${n} artículos`} del blog técnico que tratan este tema, con el equipo contra incendio relacionado en cada uno.`}
    ariaLabel={`Artículos sobre ${tag}`}
    bloques={bloques}
    actualHref={hrefTag(tag)}
    vacio="No hay artículos publicados con esta etiqueta todavía."
  >
    <Fragment slot="titulo"><span style="color:var(--c-accent)">#</span>{tag}</Fragment>

    <Fragment slot="texto">
      <p class="text-sm leading-relaxed" style="color:var(--c-text-2)">
        Artículos técnicos relacionados con <strong style="color:var(--c-text)">{tag}</strong>:
        guías referenciadas a la norma vigente para bomberos, brigadas industriales y
        responsables de protección civil en México.
      </p>
    </Fragment>
  </BlogArchivoL2>
</BaseLayout>
