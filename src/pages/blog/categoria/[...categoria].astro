---
// /blog/categoria/[...categoria].astro — Archivo de categoría del blog
// =====================================================================
// Genera una URL indexable por categoría:
//   /blog/categoria/normatividad
//   /blog/categoria/equipos-epp
//   /blog/categoria/licitaciones
//
// Por qué: las páginas de categoría son landings SEO de intención
// informacional agrupada. "Normatividad NFPA NOM México"  landing
// de todos los artículos de normatividad  mejor ranqueo que el índice.
// =====================================================================
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import BlogCard from '@components/blog/BlogCard.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@config/site';
import { slugifyCategory } from '@lib/slug';
import { categoriaIndexable } from '@lib/blog-taxonomia';
import { blogCategorias } from '@data/blogCategorias';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  // Agrupar por categoría
  const categoryMap = allPosts.reduce<Record<string, typeof allPosts>>((acc, p) => {
    const cat = p.data.category;
    if (!acc[cat]) acc[cat] = [];
    acc[cat].push(p);
    return acc;
  }, {});

  return Object.entries(categoryMap).map(([category, posts]) => ({
    params: { categoria: slugifyCategory(category) },
    props: { category, posts, allCategories: Object.keys(categoryMap) },
  }));
}) satisfies GetStaticPaths;

const { category, posts, allCategories } = Astro.props;
const { categoria } = Astro.params;
const canonicalURL = `${SITE.url}/blog/categoria/${categoria}/`;
const categoriaInfo = categoria ? blogCategorias[categoria] : undefined;

const seoMeta = {
  title: `${category} — Blog técnico bomberos | VIGILES`,
  description:
    `Artículos técnicos sobre ${category.toLowerCase()} en equipo para bomberos y sistemas contra incendio. Normatividad NFPA, NOM y criterios de selección.`.slice(0, 160),
  canonicalURL,
  /* Umbral propio, más bajo que el de las etiquetas: la categoría es la
     navegación del blog y cada artículo declara una sola. Ver
     @lib/blog-taxonomia. */
  noindex: !categoriaIndexable(posts.length),
};

// JSON-LD CollectionPage de categoría
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${category} — Blog VIGILES`,
  url: canonicalURL,
  description: seoMeta.description,
  inLanguage: 'es-MX',
  isPartOf: { '@type': 'Blog', url: `${SITE.url}/blog` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: posts.length,
    itemListElement: posts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Article',
        headline: p.data.title,
        description: p.data.description,
        url: `${SITE.url}/blog/${p.id}`,
      },
    })),
  },
};
---

<BaseLayout {...seoMeta} schema={[collectionSchema]}>

  {/* ─── Breadcrumb ─── */}
  <nav
    class="py-3"
    style="background:var(--c-bg-alt);border-bottom:1px solid var(--c-line)"
    aria-label="Breadcrumb"
  >
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
        <li><a href="/"      class="hover:text-[var(--c-accent)]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/blog"  class="hover:text-[var(--c-accent)]">Blog</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:var(--c-text-2)" aria-current="page">{category}</span></li>
      </ol>
    </div>
  </nav>

  {/* ─── Hero de categoría ─── */}
  <section style="background:var(--c-bg);padding-block:4rem">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="section-eyebrow mb-3 inline-flex">Categoría · {posts.length} artículo{posts.length !== 1 ? 's' : ''}</span>
          <h1
            class="font-display font-bold"
            style="color:var(--c-ink);font-size:clamp(2rem,4.5vw,3.5rem);line-height:1"
          >
            {category.split(' ').map((word, i) => (
              i === 0
                ? <span>{word} </span>
                : <span style="color:var(--c-accent)">{word} </span>
            ))}
          </h1>
        </div>
        <div class="lg:pl-12" style="border-left:1px solid var(--c-line)">
          {categoriaInfo ? (
            <>
              {categoriaInfo.intro.map((paragraph) => (
                <p class="text-sm leading-relaxed" style="color:var(--c-text-2)">{paragraph}</p>
              ))}
              <div class="flex flex-wrap gap-3">
                {categoriaInfo.enlaces.map((enlace) => (
                  <a href={enlace.href} class="text-sm font-bold hover:text-[var(--c-accent)]" style="color:var(--c-text)">{enlace.label} </a>
                ))}
              </div>
            </>
          ) : (
            <p class="text-sm leading-relaxed" style="color:var(--c-text-2)">
            Artículos técnicos en la categoría <strong style="color:var(--c-text)">{category}</strong> —
            guías referenciadas a la norma vigente (NFPA, NOM) para bomberos, brigadas y
            responsables de protección civil.
            </p>
          )}
        </div>
      </div>
    </div>
  </section>

  <QuickLinksBar />

  {/* ─── Artículos + Sidebar ─── */}
  <section class="section" style="background:var(--c-bg)" aria-label={`Artículos de ${category}`}>
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12">

        {/* ── Columna principal ── */}
        <div class="lg:col-span-8">
          {posts.length === 0 ? (
            <p class="py-12 text-center text-sm" style="color:var(--c-muted)">
              No hay artículos publicados en esta categoría todavía.
            </p>
          ) : (
            <div class="card-grid">
              {posts.map((post) => <BlogCard post={post} />)}
            </div>
          )}
        </div>

        {/* ── Sidebar ── */}
        <aside class="lg:col-span-4">
          <div class="flex flex-col gap-6 lg:sticky" style="top:124px">

            {/* Otras categorías */}
            <div style="background:var(--c-bg-alt);border:1px solid var(--c-line)">
              <h2
                class="font-display font-bold text-sm px-5 py-4"
                style="color:var(--c-accent);border-bottom:1px solid var(--c-line)"
              >
                Otras categorías
              </h2>
              <ul class="flex flex-col list-none m-0 p-0">
                <li>
                  <a
                    href="/blog"
                    class="flex items-center justify-between gap-3 px-5 py-3 hover:bg-[var(--c-surface)]"
                    style="border-top:1px solid var(--c-line)"
                  >
                    <span class="font-display text-sm" style="color:var(--c-text)">Todas</span>
                    
                  </a>
                </li>
                {allCategories.filter((c) => c !== category).map((cat) => (
                  <li style="border-top:1px solid var(--c-line)">
                    <a
                      href={`/blog/categoria/${slugifyCategory(cat)}`}
                      class="flex items-center justify-between gap-3 px-5 py-3 hover:bg-[var(--c-surface)]"
                    >
                      <span class="font-display text-sm" style="color:var(--c-text)">{cat}</span>
                      
                    </a>
                  </li>
                ))}
              </ul>
            </div>

            {/* Recursos */}
            <div style="background:var(--c-bg-alt);border:1px solid var(--c-line)">
              <h2
                class="font-display font-bold text-sm px-5 py-4"
                style="color:var(--c-accent);border-bottom:1px solid var(--c-line)"
              >
                También te puede servir
              </h2>
              <ul class="flex flex-col list-none m-0 p-0">
                {[
                  { label: 'Equipo para bomberos', href: '/productos' },
                  { label: 'Certificaciones NFPA/NOM', href: '/certificaciones' },
                  { label: 'Servicios contra incendio', href: '/servicios' },
                  { label: 'Industrias que atendemos', href: '/industrias' },
                ].map((r) => (
                  <li style="border-top:1px solid var(--c-line)">
                    <a
                      href={r.href}
                      class="flex items-center justify-between gap-3 px-5 py-3 hover:bg-[var(--c-surface)]"
                    >
                      <span class="font-display text-sm" style="color:var(--c-text)">{r.label}</span>
                      
                    </a>
                  </li>
                ))}
              </ul>
            </div>

          </div>
        </aside>

      </div>
    </div>
  </section>

</BaseLayout>
