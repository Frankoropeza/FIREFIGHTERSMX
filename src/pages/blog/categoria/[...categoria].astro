---
// /blog/categoria/[...categoria].astro — Archivo de categoría del blog (plantilla L2)
// =====================================================================
// Una URL por categoría: /blog/categoria/normatividad, /equipos-epp, /licitaciones…
// Son landings de intención informacional agrupada: «normatividad NFPA NOM México»
// reúne todos los artículos de la categoría. Indexable desde
// MIN_ARTICULOS_CATEGORIA artículos (ver @lib/blog-taxonomia); por debajo se
// genera igual, navegable y pasando enlaces, con `noindex, follow`.
// =====================================================================
import BaseLayout from '@layouts/BaseLayout.astro';
import BlogArchivoL2 from '@components/blog/BlogArchivoL2.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@config/site';
import { slugifyCategory } from '@lib/slug';
import { categoriaIndexable } from '@lib/blog-taxonomia';
import { blogCategorias } from '@data/blogCategorias';
import { bloqueCategorias, bloqueServicios, bloqueIndustrias } from '@lib/l2';
import {
  bloqueCategoriasBlog, bloqueTemasBlog, bloqueRecursosBlog, etiquetasPorFrecuencia,
  hrefCategoria, tituloArchivo, descripcionArchivo,
} from '@lib/blog-l2';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (async () => {
  const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

  const categoryMap = allPosts.reduce<Record<string, typeof allPosts>>((acc, p) => {
    const cat = p.data.category;
    if (!acc[cat]) acc[cat] = [];
    acc[cat].push(p);
    return acc;
  }, {});

  return Object.entries(categoryMap).map(([category, posts]) => ({
    params: { categoria: slugifyCategory(category) },
    props: { category, posts, allPosts },
  }));
}) satisfies GetStaticPaths;

const { category, posts, allPosts } = Astro.props;
const { categoria } = Astro.params;
const canonicalURL = `${SITE.url}/blog/categoria/${categoria}/`;
const categoriaInfo = categoria ? blogCategorias[categoria] : undefined;

const seoMeta = {
  title: tituloArchivo(category),
  description: descripcionArchivo(category),
  canonicalURL,
  /* Umbral propio, más bajo que el de las etiquetas: la categoría es la
     navegación del blog y cada artículo declara una sola. Ver @lib/blog-taxonomia. */
  noindex: !categoriaIndexable(posts.length),
};

const n = posts.length;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${SITE.url}/blog/` },
    { '@type': 'ListItem', position: 3, name: category, item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${category} — Blog FIREFIGHTERS MX`,
  url: canonicalURL,
  description: seoMeta.description,
  inLanguage: 'es-MX',
  isPartOf: { '@type': 'Blog', url: `${SITE.url}/blog/` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: n,
    itemListElement: posts.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Article',
        headline: p.data.title,
        description: p.data.description,
        url: `${SITE.url}/blog/${p.id}`,
      },
    })),
  },
};

const bloques = [
  bloqueCategoriasBlog(allPosts),
  bloqueTemasBlog(etiquetasPorFrecuencia(posts), `Temas de ${category}`, undefined, 10),
  bloqueCategorias(), bloqueServicios(), bloqueIndustrias(), bloqueRecursosBlog(),
];
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema]}>
  <BlogArchivoL2
    actual={category}
    eyebrow={`Categoría · ${n} artículo${n !== 1 ? 's' : ''}`}
    posts={posts}
    h2={`Artículos técnicos de ${category}`}
    lead={`${n === 1 ? 'Un artículo' : `${n} artículos`} de la categoría, del más reciente al más antiguo, con el equipo contra incendio relacionado en cada uno.`}
    ariaLabel={`Artículos de ${category}`}
    bloques={bloques}
    actualHref={hrefCategoria(category)}
    vacio="No hay artículos publicados en esta categoría todavía."
  >
    <Fragment slot="titulo">
      {category.split(' ').map((word, i) => (
        i === 0 ? <span>{word} </span> : <span style="color:var(--c-accent)">{word} </span>
      ))}
    </Fragment>

    <Fragment slot="texto">
      {categoriaInfo ? (
        <>
          {categoriaInfo.intro.map((paragraph) => (
            <p class="text-sm leading-relaxed mb-4" style="color:var(--c-text-2)">{paragraph}</p>
          ))}
          <div class="flex flex-wrap gap-x-5 gap-y-2">
            {categoriaInfo.enlaces.map((enlace) => (
              <a href={enlace.href} class="text-sm font-bold hover:text-[var(--c-accent)]" style="color:var(--c-text)">{enlace.label}</a>
            ))}
          </div>
        </>
      ) : (
        <p class="text-sm leading-relaxed" style="color:var(--c-text-2)">
          Artículos técnicos de la categoría <strong style="color:var(--c-text)">{category}</strong>:
          guías referenciadas a la norma vigente (NFPA, NOM) para bomberos, brigadas y
          responsables de protección civil.
        </p>
      )}
    </Fragment>
  </BlogArchivoL2>
</BaseLayout>
