---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroPro from '@components/home/HeroPro.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import ProductCards from '@components/home/ProductCards.astro';
import RiskGuide from '@components/home/RiskGuide.astro';
import ValueProps from '@components/home/ValueProps.astro';
import ServicesSection from '@components/home/ServicesSection.astro';
import NormsTable from '@components/home/NormsTable.astro';
import ProcessSteps from '@components/home/ProcessSteps.astro';
import IndustriesSection from '@components/home/IndustriesSection.astro';
import CoverageSection from '@components/home/CoverageSection.astro';
import DirectorioSeccion from '@components/home/DirectorioSeccion.astro';
import MarcasDistribuidas from '@components/home/MarcasDistribuidas.astro';
import BlogTeasers from '@components/home/BlogTeasers.astro';
import FAQSection from '@components/home/FAQSection.astro';
import CTASection from '@components/home/CTASection.astro';
import { SITE, TELEFONO_ACTIVO, DOMICILIO_VERIFICADO } from '@config/site';
import { homeFaqs } from '@data/faqs';
import { services } from '@data/services';

const seoMeta = {
  // Portada de la tienda (2026-09-15). El directorio vive en /directorio/.
  title: 'Distribuidor de Equipo para Bomberos NFPA | FIREFIGHTERS MX',
  noBrandSuffix: true,
  description:
    'Distribuidor autorizado de equipo de protección para bomberos: trajes Globe y Lion, cascos Bullard, SCBA MSA y Dräger, Holmatro. Envíos a todo México.',
  canonicalURL: `${SITE.url}/`,
};

/* ─── JSON-LD ──────────────────────────────────────────────── */
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE.url}/#business`,
  name: SITE.name,
  alternateName: ['Firefighters MX', 'FFMX', 'FireFighters México'],
  description: SITE.description,
  url: SITE.url,
  ...(TELEFONO_ACTIVO ? { telephone: SITE.phoneE164 } : {}),
  email: SITE.email,
  image: `${SITE.url}/images/og-default.jpg`,
  areaServed: { '@type': 'Country', name: 'México' },
  openingHours: ['Mo-Fr 08:00-18:00', 'Sa 09:00-14:00'],
  ...(DOMICILIO_VERIFICADO
    ? {
        address: {
          '@type': 'PostalAddress',
          streetAddress: SITE.address.street,
          addressLocality: `${SITE.address.colonia}, ${SITE.address.delegacion}`,
          addressRegion: 'CDMX',
          postalCode: SITE.address.postalCode,
          addressCountry: SITE.address.country,
        },
      }
    : {}),
  knowsAbout: [
    'NFPA 1970', 'NFPA 1950', 'NFPA 1850', 'NFPA 1990', 'NFPA 10', 'NFPA 13', 'NFPA 72',
    'NOM-002-STPS-2010', 'NOM-154-SCFI-2005', 'NOM-026-STPS-2008', 'LAASSP',
    'Equipo para bomberos', 'Trajes estructurales NFPA', 'SCBA', 'Cascos para bomberos',
    'Herramientas de rescate vehicular', 'Equipos HAZMAT', 'Extintores', 'Sistemas contra incendio',
    'Brigadas industriales', 'Equipo ARFF', 'Licitaciones de equipo contra incendio',
  ],
};

const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: 'es-MX',
  publisher: { '@id': `${SITE.url}/#business` },
  // La búsqueda del sitio es la del directorio de empresas.
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${SITE.url}/empresas/?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Servicios de protección contra incendio',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.title,
      description: s.description,
      url: `${SITE.url}${s.href}`,
      provider: { '@id': `${SITE.url}/#business` },
      areaServed: { '@type': 'Country', name: 'México' },
    },
  })),
};

const schemas = [localBusinessSchema, webSiteSchema, faqSchema, servicesSchema];
---

<BaseLayout {...seoMeta} schema={schemas}>
  {/* 1. Hero: propuesta de valor + stats + CTAs */}
  <HeroPro />

  {/* 2. Accesos rápidos (botones a secciones clave) */}
  <QuickLinksBar />

  {/* 3. Catálogo por categorías (intención de compra) */}
  <ProductCards />

  {/* 3b. Marcas que distribuimos (decisión SEO 2026-09-15: especialista en marcas y líneas) */}
  <MarcasDistribuidas />

  {/* 4. Guía de selección por nivel de riesgo (SEO + autoridad técnica) */}
  <RiskGuide />

  {/* 5. Por qué elegirnos (diferenciadores) */}
  <ValueProps />

  {/* 6. Servicios profesionales 01–06 */}
  <ServicesSection />

  {/* 7. Respaldo normativo NOM/NFPA (tabla SEO) */}
  <NormsTable />

  {/* 8. Proceso de consulta a entrega */}
  <ProcessSteps />

  {/* 9. Sectores que atendemos */}
  <IndustriesSection />

  {/* 10. Cobertura nacional y logística */}
  <CoverageSection />

  {/* 11. Sección del sitio: directorio nacional (terceros) */}
  <DirectorioSeccion />

  {/* 12. Blog técnico (frescura + internal linking) */}
  <BlogTeasers />

  {/* 13. FAQ + formulario de cotización */}
  <FAQSection />

  {/* 14. CTA final de conversión */}
  <CTASection />
</BaseLayout>
