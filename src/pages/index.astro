---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroPro from '@components/home/HeroPro.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import ProductCards from '@components/home/ProductCards.astro';
import RiskGuide from '@components/home/RiskGuide.astro';
import ValueProps from '@components/home/ValueProps.astro';
import ServicesSection from '@components/home/ServicesSection.astro';
import NormsTable from '@components/home/NormsTable.astro';
import ProcessSteps from '@components/home/ProcessSteps.astro';
import IndustriesSection from '@components/home/IndustriesSection.astro';
import CoverageSection from '@components/home/CoverageSection.astro';
import TestimonialsSection from '@components/home/TestimonialsSection.astro';
import BlogTeasers from '@components/home/BlogTeasers.astro';
import FAQSection from '@components/home/FAQSection.astro';
import CTASection from '@components/home/CTASection.astro';
import { SITE } from '@config/site';
import { homeFaqs } from '@data/faqs';
import { services } from '@data/services';

const seoMeta = {
  // Title: 55c (≤60) — keyword-first, sin truncado Google
  title: 'Equipo para Bomberos Certificado NFPA | FIREFIGHTERS MX',
  // Description: 143c (≤160) — modelos reales + segmentos para mayor CTR
  description:
    'Trajes NFPA 1970 Globe y Lion, SCBA MSA G1 y Dräger, cascos Bullard y Gallet. Distribuidor autorizado en México: bomberos, brigadas e industria.',
  canonicalURL: `${SITE.url}/`,
};

/* ─── JSON-LD ──────────────────────────────────────────────── */

// Negocio local — distribuidor especializado
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE.url}/#business`,
  name: SITE.name,
  alternateName: ['Firefighters MX', 'FFMX', 'FireFighters México', 'Firefighters Mexico'],
  description: SITE.description,
  url: SITE.url,
  telephone: SITE.phoneE164,
  email: SITE.email,
  image: `${SITE.url}/images/og-default.jpg`,
  priceRange: '$$',
  currenciesAccepted: 'MXN',
  paymentAccepted: 'Transferencia, Tarjeta, CFDI 4.0',
  areaServed: { '@type': 'Country', name: 'México' },
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: `${SITE.address.colonia}, ${SITE.address.delegacion}`,
    postalCode: SITE.address.postalCode,
    addressCountry: SITE.address.country,
  },
  knowsAbout: [
    // Normas NFPA — EPP y sistemas
    'NFPA 1970',               // Trajes estructurales (antes 1971)
    'NFPA 1950',               // Trajes forestales
    'NFPA 1850',               // Vida útil y retiro de EPP
    'NFPA 1970',               // SCBA para emergencias de servicio de urgencias
    'NFPA 1970',               // PASS — dispositivos de alerta personal
    'NFPA 1990',               // Trajes CBRN / HAZMAT clase 1–4
    'NFPA 1021',               // Cualificaciones oficiales de bomberos
    'NFPA 1001',               // Cualificaciones bombero nivel I y II
    'NFPA 10',                 // Extintores portátiles
    'NFPA 13',                 // Rociadores automáticos
    'NFPA 72',                 // Detección y alarma de incendio
    // Normas mexicanas
    'NOM-002-STPS-2010',       // Prevención y protección CI en centros de trabajo
    'NOM-154-SCFI-2005',       // Mantenimiento y recarga de extintores
    'NOM-026-STPS-2008',       // Colores y señales de seguridad
    // Estándares internacionales de referencia
    'OACI ARFF',               // Categorías de protección contra incendio en aeropuertos
    'LAASSP',                  // Ley de Adquisiciones — licitaciones públicas México
    // Familias de producto y servicios
    'Equipo para bomberos',
    'Trajes estructurales NFPA',
    'SCBA aire autónomo',
    'Cascos para bomberos',
    'Herramientas de rescate vehicular',
    'Equipos HAZMAT CBRN',
    'Extintores y sistemas contra incendio',
    'Brigadas industriales',
    'Equipo ARFF aeropuertos',
    'Licitaciones equipo bomberos',
  ],
};

// Sitio web
const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: 'es-MX',
  publisher: { '@id': `${SITE.url}/#business` },
};

// FAQ visible en esta página
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

// Servicios ofrecidos
const servicesSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Servicios de protección contra incendio',
  itemListElement: services.map((s, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Service',
      name: s.title,
      description: s.description,
      url: `${SITE.url}${s.href}`,
      provider: { '@id': `${SITE.url}/#business` },
      areaServed: { '@type': 'Country', name: 'México' },
    },
  })),
};

const schemas = [localBusinessSchema, webSiteSchema, faqSchema, servicesSchema];
---

<BaseLayout {...seoMeta} schema={schemas}>
  <!-- 1. Hero: propuesta de valor + stats + CTAs -->
  <HeroPro />

  <!-- 2. Accesos rápidos (botones a secciones clave) -->
  <QuickLinksBar />

  <!-- 3. Catálogo por categorías (intención de compra) -->
  <ProductCards />

  <!-- 4. Guía de selección por nivel de riesgo (SEO + autoridad técnica) -->
  <RiskGuide />

  <!-- 5. Por qué elegirnos (diferenciadores) -->
  <ValueProps />

  <!-- 6. Servicios profesionales 01–06 -->
  <ServicesSection />

  <!-- 7. Respaldo normativo NOM/NFPA (tabla SEO) -->
  <NormsTable />

  <!-- 8. Proceso de consulta a entrega -->
  <ProcessSteps />

  <!-- 9. Sectores que atendemos -->
  <IndustriesSection />

  <!-- 10. Cobertura nacional y logística -->
  <CoverageSection />

  <!-- 11. Testimonios -->
  <TestimonialsSection />

  <!-- 12. Blog técnico (frescura + internal linking) -->
  <BlogTeasers />

  <!-- 13. FAQ + formulario de cotización -->
  <FAQSection />

  <!-- 14. CTA final de conversión -->
  <CTASection />
</BaseLayout>
