---
// Home v3 — portal-directorio (2026-09). Orden: buscar → giros → mapa → estados →
// confianza → dos lados → estaciones → guías → marcas → normativa → blog → FAQ → CTA.
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import DirHero from '@components/home/directorio/DirHero.astro';
import DirGiros from '@components/home/directorio/DirGiros.astro';
import DirMapa from '@components/home/directorio/DirMapa.astro';
import DirEstados from '@components/home/directorio/DirEstados.astro';
import DirConfianza from '@components/home/directorio/DirConfianza.astro';
import DirDosLados from '@components/home/directorio/DirDosLados.astro';
import DirEstaciones from '@components/home/directorio/DirEstaciones.astro';
import DirGuias from '@components/home/directorio/DirGuias.astro';
import DirMarcas from '@components/home/directorio/DirMarcas.astro';
import NormsTable from '@components/home/NormsTable.astro';
import BlogTeasers from '@components/home/BlogTeasers.astro';
import DirFAQ from '@components/home/directorio/DirFAQ.astro';
import DirCTA from '@components/home/directorio/DirCTA.astro';
import { SITE, CONTACTO_DIRECTO_ACTIVO } from '@config/site';
import { directorioFaqs } from '@data/faqs';
import { giros } from '@data/giros';
import { statsDirectorio } from '@lib/empresas';
import { totalEstaciones } from '@data/estaciones';

const stats = await statsDirectorio();
const fmt = (n: number) => n.toLocaleString('es-MX');

const seoMeta = {
  // ≤60c, keyword-first
  title: 'Directorio de Equipo Contra Incendio en México | FIREFIGHTERS MX',
  // ≤160c
  description: `${fmt(stats.total)} empresas de equipo para bomberos, extintores, sistemas contra incendio y capacitación en los 32 estados, más ${fmt(totalEstaciones)} cuerpos de bomberos. Busca por giro y estado.`,
  canonicalURL: `${SITE.url}/`,
};

/* ─── JSON-LD ─────────────────────────────────────────────── */
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#business`,
  name: SITE.name,
  alternateName: ['Firefighters MX', 'FFMX', 'FireFighters México'],
  description: 'Directorio nacional de empresas de equipo contra incendio y de cuerpos de bomberos en México.',
  url: SITE.url,
  ...(CONTACTO_DIRECTO_ACTIVO ? { telephone: SITE.phoneE164 } : {}),
  email: SITE.email,
  image: `${SITE.url}/images/og-default.jpg`,
  areaServed: { '@type': 'Country', name: 'México' },
  address: { '@type': 'PostalAddress', streetAddress: SITE.address.street, addressLocality: `${SITE.address.colonia}, ${SITE.address.delegacion}`, postalCode: SITE.address.postalCode, addressCountry: SITE.address.country },
  knowsAbout: ['Equipo para bomberos', 'Extintores NOM-154', 'Sistemas contra incendio NFPA 13', 'Detección NFPA 72', 'Capacitación de brigadas NOM-002-STPS', 'NFPA 1970', 'NFPA 1990', 'Licitaciones de equipo contra incendio'],
};
const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.name,
  url: SITE.url,
  description: seoMeta.description,
  inLanguage: 'es-MX',
  publisher: { '@id': `${SITE.url}/#business` },
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: `${SITE.url}/empresas/?q={search_term_string}` },
    'query-input': 'required name=search_term_string',
  },
};
const directorioSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Directorio nacional de empresas de equipo contra incendio',
  numberOfItems: giros.length,
  itemListElement: giros.map((g, i) => ({ '@type': 'ListItem', position: i + 1, name: g.label, url: `${SITE.url}/empresas/${g.slug}/` })),
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: directorioFaqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const schemas = [organizationSchema, webSiteSchema, directorioSchema, faqSchema];
---
<BaseLayout {...seoMeta} schema={schemas}>
  {/* 1. Hero: buscador protagonista + stats reales */}
  <DirHero />

  {/* 2. Accesos rápidos (interlinking global) */}
  <QuickLinksBar />

  {/* 3. Los 4 giros con conteos */}
  <DirGiros />

  {/* 4. Mapa nacional con clustering */}
  <DirMapa />

  {/* 5. Los 32 estados por oferta */}
  <DirEstados />

  {/* 6. Cómo se construye: fuente, clasificación, verificación */}
  <DirConfianza />

  {/* 7. Bandas editoriales: quien compra / quien vende */}
  <DirDosLados />

  {/* 8. Directorio de estaciones (la demanda) */}
  <DirEstaciones />

  {/* 9. Guías de compra (el catálogo, reencuadrado) */}
  <DirGuias />

  {/* 10. Fabricantes de referencia */}
  <DirMarcas />

  {/* 11. Normativa NOM / NFPA */}
  <NormsTable />

  {/* 12. Blog técnico */}
  <BlogTeasers />

  {/* 13. FAQ del directorio */}
  <DirFAQ />

  {/* 14. Cierre */}
  <DirCTA />
</BaseLayout>
