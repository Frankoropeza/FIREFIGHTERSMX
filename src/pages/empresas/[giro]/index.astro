---
// /empresas/[giro] — L2: un giro a nivel nacional, agrupado por estado
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import MapaEmpresas from '@components/empresas/MapaEmpresas.astro';
import EmpresasGrid from '@components/empresas/EmpresasGrid.astro';
import { SITE } from '@config/site';
import { giros, giroMap, type GiroKey } from '@data/giros';
import { allCategories } from '@data/categories';
import { services } from '@data/services';
import { empresasPorGiro, conteoPorEstado, especialidadesPresentes, topCiudades } from '@lib/empresas';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => giros.map((g) => ({ params: { giro: g.slug }, props: { giro: g.slug } }))) satisfies GetStaticPaths;

const { giro } = Astro.props as { giro: GiroKey };
const g = giroMap[giro];
const lista = await empresasPorGiro(giro);
const porEstado = (await conteoPorEstado(giro)).filter((s) => s.total > 0).sort((a, b) => b.total - a.total);
const esp = especialidadesPresentes(lista, giro);
const ciudades = topCiudades(lista, 10);
const cats = allCategories.filter((c) => g.categoriasRelacionadas.includes(c.slug));
const servs = services.filter((s) => g.serviciosRelacionados.includes(s.slug));
const otros = giros.filter((x) => x.slug !== giro);
const seoTitles: Record<GiroKey, string> = {
  'venta-equipo': 'Empresas de venta de equipo para bomberos en México | EPP y equipo contra incendio NFPA',
  'equipos-contra-incendio': 'Empresas de equipos contra incendios en México | Sistemas y extintores',
  extintores: 'Empresas de extintores en México | Venta, recarga y mantenimiento',
  'sistemas-ci': 'Empresas de sistemas contra incendio en México | Rociadores, detección y bombas',
  capacitacion: 'Empresas de capacitación contra incendios en México | Brigadas y cursos',
};
const seoDescriptions: Record<GiroKey, string> = {
  'venta-equipo': 'Directorio de empresas de venta de equipo para bomberos y equipo contra incendio en México: EPP certificado NFPA, trajes estructurales, SCBA, cascos, mangueras y herramientas de rescate para cuerpos de bomberos y brigadas industriales.',
  'equipos-contra-incendio': 'Directorio de empresas de equipo contra incendio en México: sistemas contra incendio, extintores, hidrantes, detectores de humo y equipo certificado NOM y NFPA, por estado y especialidad.',
  extintores: 'Directorio de empresas de extintores en México: venta de extintores, recarga y mantenimiento de extintores PQS, CO₂ y agente limpio, con servicio por estado y NOM-154-SCFI-2005.',
  'sistemas-ci': 'Directorio de empresas de sistemas contra incendio en México: diseño e ingeniería, instalación de sistemas contra incendio, rociadores automáticos, detección y alarma, hidrantes y bombas contra incendios.',
  capacitacion: 'Directorio de empresas de capacitación contra incendios en México: cursos de prevención y combate de incendios, formación de brigadas contra incendio, práctica con fuego real, simulacros y DC-3 ante la STPS.',
};
const decisionGuide: Record<GiroKey, {
  intro: string;
  comparar: { title: string; text: string }[];
  verificar: string[];
  cotizar: string[];
  faq: { q: string; a: string }[];
}> = {
  'venta-equipo': {
    intro: 'Las empresas de venta de equipo para bomberos pueden manejar líneas, marcas y alcances distintos. Conviene separar el equipo de protección personal (EPP), la protección respiratoria, las herramientas y los accesorios, y después verificar cada partida con documentación del fabricante.',
    comparar: [
      { title: 'EPP para bomberos', text: 'Trajes estructurales o forestales, cascos, guantes, botas y capuchas. Define la operación, tallas, configuración y norma solicitada antes de comparar.' },
      { title: 'Protección respiratoria', text: 'Para equipos SCBA, precisa duración nominal, cilindros, máscara, accesorios, compatibilidad y soporte de mantenimiento requerido.' },
      { title: 'Rescate y apoyo operativo', text: 'Separa herramientas hidráulicas, cámaras térmicas, iluminación, detección de gases y equipo HAZMAT para evaluar cada sistema completo.' },
    ],
    verificar: ['Identidad, domicilio y medio de contacto de la empresa.', 'Marca y modelo exactos, configuración, accesorios y consumibles incluidos.', 'Documento aplicable al producto; una mención comercial a NFPA no sustituye la evidencia.', 'Origen, garantía, servicio posterior y disponibilidad de refacciones.', 'Experiencia documentable cuando la compra corresponda a una licitación pública.'],
    cotizar: ['Cantidad y tallas por elemento.', 'Uso estructural, forestal, industrial, rescate o HAZMAT.', 'Norma, edición o especificación técnica requerida por el comprador.', 'Lugar de entrega y fecha objetivo.', 'Capacitación, puesta en servicio o mantenimiento que deba cotizarse por separado.'],
    faq: [
      { q: '¿Dónde comprar equipo de protección personal para bomberos?', a: 'Consulta las empresas por estado y especialidad, revisa su ficha y solicita una propuesta con marca, modelo, configuración y documentos. El directorio ayuda a localizar opciones, pero no vende ni garantiza los equipos.' },
      { q: '¿Qué certificaciones debe tener el equipo para bomberos?', a: 'Depende del producto, el uso, la especificación del proyecto y los requisitos del comprador. Solicita el documento correspondiente al modelo y verifica su alcance; no asumas que una certificación de empresa cubre todo su catálogo.' },
      { q: '¿Qué tipos de EPP necesita una brigada o cuerpo de bomberos?', a: 'La selección depende de la operación y del riesgo. Puede incluir protección estructural o forestal, casco, capucha, guantes, botas y protección respiratoria, pero el conjunto debe definirse mediante una evaluación técnica y criterios de compatibilidad.' },
      { q: '¿Cuánto cuesta un equipo de bombero completo?', a: 'No existe un precio único: cambian la configuración, tallas, materiales, norma solicitada, accesorios, cantidad y servicio posterior. Para comparar, pide a varios proveedores la misma lista de partidas y consulta la guía de factores de precio.' },
      { q: '¿Qué diferencia hay entre fabricante, distribuidor y proveedor de equipo?', a: 'El fabricante produce el equipo; un distribuidor puede comercializar determinadas líneas; y proveedor es un término comercial más amplio. Si una autorización es requisito, solicita evidencia vigente y confírmala con la marca.' },
    ],
  },
  'equipos-contra-incendio': {
    intro: 'Este giro reúne proveedores de equipo contra incendio con alcances diferentes: suministro, mantenimiento, señalización, redes y componentes. Antes de elegir, define si necesitas productos portátiles, equipos de combate, un sistema fijo o servicios especializados.',
    comparar: [
      { title: 'Equipo portátil', text: 'Extintores, gabinetes, mangueras, boquillas y señalamiento deben especificarse por tipo de riesgo, capacidad, compatibilidad y ubicación prevista.' },
      { title: 'Detección y alarma', text: 'Distingue paneles, detectores de humo o calor, dispositivos de notificación, integración, programación y pruebas de aceptación.' },
      { title: 'Redes y supresión', text: 'Rociadores, hidrantes, bombas, válvulas y agentes de supresión requieren una base de diseño y un alcance técnico claramente documentados.' },
    ],
    verificar: ['Alcance real: venta, instalación, mantenimiento, recarga, ingeniería o inspección.', 'Modelos, capacidades, agentes y componentes incluidos.', 'Normas NOM, NFPA, UL o FM solicitadas y evidencia aplicable al producto.', 'Personal, procedimientos y entregables previstos para cada servicio.', 'Garantía, refacciones, mantenimiento preventivo y atención posterior.'],
    cotizar: ['Tipo de inmueble, proceso o riesgo protegido.', 'Inventario existente y necesidad detectada.', 'Planos, áreas, alturas y condiciones relevantes cuando aplique.', 'Suministro, instalación y mantenimiento como conceptos separados.', 'Pruebas, memoria, planos finales y capacitación requeridos.'],
    faq: [
      { q: '¿Qué servicios ofrecen las empresas de equipo contra incendios?', a: 'El alcance puede incluir venta de equipos, recarga y mantenimiento de extintores, detección y alarma, instalación de sistemas o ingeniería. Confirma en cada ficha y cotización cuáles actividades realiza realmente la empresa.' },
      { q: '¿Cómo elegir un proveedor de equipo contra incendio?', a: 'Compara el alcance técnico, los documentos del equipo, los entregables, la garantía y el mantenimiento. La opción adecuada depende del riesgo y de la especificación, no únicamente del precio.' },
      { q: '¿Por qué se solicitan referencias NOM, NFPA, UL o FM?', a: 'Sirven para definir requisitos distintos de seguridad, diseño, producto o servicio. No son intercambiables: identifica cuál aplica a la partida y verifica el documento del modelo, sistema o prestador correspondiente.' },
    ],
  },
  extintores: {
    intro: 'Las empresas de extintores pueden dedicarse a venta, inspección, mantenimiento, recarga o pruebas. Para comparar propuestas primero identifica el riesgo, la clase de fuego prevista, el agente, la capacidad y el servicio que realmente necesitas.',
    comparar: [
      { title: 'Tipo y agente', text: 'PQS, dióxido de carbono, agua, espuma u otros agentes responden a aplicaciones distintas. La selección debe partir del riesgo y de la evaluación competente del sitio.' },
      { title: 'Equipo y accesorios', text: 'Registra capacidad, condición, ubicación, señalamiento, soporte, gabinete y cualquier requisito de instalación o reposición.' },
      { title: 'Mantenimiento y recarga', text: 'Pide que la propuesta identifique actividades, piezas, agente, etiquetas, registros y alcance del servicio para cada extintor.' },
    ],
    verificar: ['Datos de la empresa y alcance como prestador de mantenimiento o recarga.', 'Aplicación de la NOM-154-SCFI-2005 cuando corresponda al servicio.', 'Identificación del extintor, capacidad, agente y condición reportada.', 'Desglose de recarga, refacciones, pruebas y sustituciones propuestas.', 'Evidencia del trabajo realizado y fecha indicada por el prestador.'],
    cotizar: ['Cantidad, tipo, capacidad y ubicación de los extintores.', 'Servicio requerido: suministro, inspección, mantenimiento o recarga.', 'Estado visible, historial y última intervención disponible.', 'Acceso al inmueble y horario permitido para el servicio.', 'Entregables y señalamiento que deban incluirse.'],
    faq: [
      { q: '¿Dónde comprar o dar mantenimiento a extintores en México?', a: 'Usa el listado por estado para localizar empresas de extintores y confirma directamente si ofrecen venta, recarga o mantenimiento en tu municipio. Revisa documentos y alcance antes de contratar.' },
      { q: '¿Qué es la NOM-154-SCFI-2005?', a: 'Es la norma mexicana aplicable a prestadores de servicios de mantenimiento y recarga de extintores. Consulta el texto oficial y verifica cómo aplica al servicio específico que vas a contratar.' },
    ],
  },
  'sistemas-ci': {
    intro: 'Las empresas de sistemas contra incendio pueden participar en ingeniería, suministro, instalación, programación, pruebas o mantenimiento. Un proyecto comparable necesita una base de diseño, límites de responsabilidad y entregables definidos.',
    comparar: [
      { title: 'Detección y alarma', text: 'Paneles, detectores, módulos y notificación deben evaluarse como un sistema, con compatibilidad, programación, pruebas e integración documentadas.' },
      { title: 'Sistemas de agua', text: 'Red hidráulica, rociadores automáticos, hidrantes, válvulas y bombas contra incendio dependen del riesgo, la demanda y el diseño del proyecto.' },
      { title: 'Sistemas de supresión', text: 'Los agentes y equipos de supresión requieren criterios de selección, cálculo, dispositivos de seguridad, pruebas y mantenimiento específicos.' },
    ],
    verificar: ['Responsable y alcance de diseño, suministro, instalación y mantenimiento.', 'Normas y edición de referencia definidas por el proyecto o la autoridad.', 'Listado de equipos y componentes con fabricante y modelo.', 'Planos, cálculos, programación, pruebas y criterios de aceptación.', 'Manual, planos finales, garantías y programa de mantenimiento.'],
    cotizar: ['Uso, ocupación, procesos y riesgos del inmueble.', 'Planos, superficies, alturas y servicios disponibles.', 'Sistemas existentes e interfaces requeridas.', 'Base de diseño y requisitos de Protección Civil o del comprador.', 'Entregables, pruebas, capacitación y mantenimiento posterior.'],
    faq: [
      { q: '¿Qué servicios ofrecen las empresas de sistemas contra incendio?', a: 'Pueden ofrecer diseño, suministro, instalación, programación, pruebas, inspección o mantenimiento. Verifica que la propuesta separe cada etapa y nombre al responsable de los entregables.' },
      { q: '¿Qué factores influyen en el costo de un sistema contra incendio?', a: 'Influyen el riesgo, el área, la infraestructura existente, la tecnología, la ingeniería, los equipos, la instalación, las pruebas y el mantenimiento. Una cifra útil requiere información técnica del proyecto.' },
    ],
  },
  capacitacion: {
    intro: 'Las empresas de capacitación contra incendios ofrecen cursos con objetivos, prácticas y alcances diferentes. La comparación debe partir de los riesgos del centro de trabajo, las funciones de la brigada y la evidencia que necesita la organización.',
    comparar: [
      { title: 'Prevención y respuesta', text: 'El temario puede abarcar prevención, alarma, evacuación, uso de extintores y organización de la respuesta; pide objetivos y límites claros.' },
      { title: 'Práctica de combate', text: 'Si existe práctica con fuego o equipo, confirma escenario, controles, EPP, proporción de participantes e instructor responsable.' },
      { title: 'Brigadas y simulacros', text: 'Distingue formación de brigadistas, primeros auxilios, evacuación, búsqueda y rescate, y planeación o evaluación de simulacros.' },
    ],
    verificar: ['Experiencia y documentos del instructor o centro de capacitación.', 'Temario, duración, modalidad, nivel y población objetivo.', 'Evaluación de riesgos y condiciones de la práctica.', 'Equipo, instalaciones, EPP y medidas de seguridad incluidos.', 'Constancia, lista, evaluación y demás evidencias acordadas; confirma si una DC-3 resulta aplicable.'],
    cotizar: ['Número y perfil de participantes.', 'Objetivo del curso y funciones de la brigada.', 'Riesgos, instalaciones y equipos disponibles.', 'Modalidad, sede y necesidad de práctica.', 'Evidencias, evaluación y calendario requeridos.'],
    faq: [
      { q: '¿Qué incluye una capacitación contra incendios?', a: 'Depende del objetivo y nivel. Solicita un temario que detalle teoría, práctica, evaluación, equipo, condiciones de seguridad y evidencias de participación.' },
      { q: '¿La capacitación tiene validez oficial o genera DC-3?', a: 'No debe asumirse. Pide al proveedor que indique por escrito qué constancia entrega, bajo qué figura y para qué alcance. La aplicabilidad depende del curso, del prestador y de la situación laboral correspondiente.' },
    ],
  },
};
const guide = decisionGuide[giro];
const faqItems = [
  { q: '¿Qué empresas aparecen en el directorio de ' + g.sustantivo + '?', a: 'La sección reúne empresas clasificadas en el giro de ' + g.sustantivo + ' que cuentan con un registro editorial y una fuente de origen. La ficha muestra únicamente los datos disponibles y el nivel de confianza correspondiente.' },
  { q: '¿Cómo busco un proveedor de ' + g.sustantivo + ' en México?', a: 'Puedes explorar el listado nacional, filtrar por estado o ciudad y revisar las especialidades publicadas en cada ficha. Antes de contratar, confirma directamente con la empresa su cobertura, disponibilidad, documentación y alcance del servicio.' },
  { q: '¿Cómo se verifica la información de las empresas?', a: 'Las fichas distinguen entre datos verificados, datos confirmados y registros públicos pendientes de verificación. La clasificación no equivale a una certificación, recomendación comercial ni garantía de desempeño.' },
  { q: '¿Puedo registrar o corregir una empresa?', a: 'Sí. La solicitud se realiza desde el formulario de registro. El alta, la corrección y cualquier cambio relevante quedan sujetos a revisión editorial y a la disponibilidad de fuentes comprobables.' },
  ...guide.faq,
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const canonicalURL = `${SITE.url}/empresas/${giro}/`;
const seoMeta = {
  title: seoTitles[giro],
  description: seoDescriptions[giro],
  canonicalURL,
};
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
  { '@type': 'ListItem', position: 2, name: 'Directorio de Empresas', item: `${SITE.url}/empresas/` },
  { '@type': 'ListItem', position: 3, name: g.label, item: canonicalURL } ] };
const collectionSchema = { '@context': 'https://schema.org', '@type': 'CollectionPage', name: `${g.label} en México`, url: canonicalURL, inLanguage: 'es-MX', isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: { '@type': 'ItemList', numberOfItems: porEstado.length, itemListElement: porEstado.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: `${g.labelCorto} en ${s.nombre}`, url: `${SITE.url}/empresas/${giro}/${s.slug}/` })) } };
---
<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema, faqSchema]} noBrandSuffix>
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site"><ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
      <li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li><li aria-hidden="true">/</li>
      <li><a href="/empresas/" class="hover:text-[#FF6B26]">Directorio de Empresas</a></li><li aria-hidden="true">/</li>
      <li><span style="color:#94A3B8" aria-current="page">{g.labelCorto}</span></li></ol></div>
  </nav>

  <section class="relative overflow-hidden" style="background:#040A12;padding-block:5rem" aria-labelledby="giro-heading">
    <div class="absolute top-0 right-0 w-2/3 h-full pointer-events-none" aria-hidden="true" style={`background:radial-gradient(ellipse 70% 60% at 85% 40%, ${g.color}14 0%, transparent 65%)`}></div>
    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="section-eyebrow mb-5 inline-flex">Directorio nacional · {g.labelCorto}</span>
          <h1 id="giro-heading" class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2rem,4.6vw,3.6rem);line-height:0.95">
            {g.outline.h1.linea1}<br/><span style={`color:${g.color}`}>{g.outline.h1.linea2}</span>
          </h1>
          {g.intro.map((p) => <p class="text-sm leading-[1.9] mb-4" style="color:#94A3B8">{p}</p>)}
          <div class="flex flex-wrap gap-2 mt-2 mb-8">{g.normas.map((n) => <span class="badge badge-dark font-display text-[10px]">{n}</span>)}</div>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="#empresas" class="btn btn-primary btn-lg">{g.labelCorto} en México</a>
            <a href="/empresas/registro/" class="btn btn-ghost btn-lg">Registrar empresa de {g.sustantivo} →</a>
          </div>
        </div>
        <div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,0.1)">
          <p class="font-display font-bold text-xs uppercase tracking-widest mb-4" style="color:var(--forge-300)">Principales estados</p>
          <ul class="flex flex-col list-none m-0 p-0" style="border-top:1px solid rgba(74,117,153,0.15)">
            {porEstado.slice(0, 8).map((s) => (
              <li style="border-bottom:1px solid rgba(74,117,153,0.15)">
                <a href={`/empresas/${giro}/${s.slug}/`} class="group flex items-center justify-between gap-4 py-3">
                  <span class="font-display font-semibold text-sm group-hover:text-[#FF6B26]" style="color:#FFFFFF">{g.labelCorto} en {s.nombre}</span>
                  <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke={g.color} stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/></svg>
                </a>
              </li>))}
          </ul>
          <a href="#estados" class="inline-flex mt-4 font-display font-semibold text-xs uppercase tracking-wider hover:text-[#FF6B26]" style="color:#FF8F57">{g.labelCorto} en todos los estados →</a>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-px" aria-hidden="true" style="background:linear-gradient(90deg, transparent, rgba(247,80,0,0.4) 30%, rgba(247,80,0,0.4) 70%, transparent)"></div>
  </section>

  <QuickLinksBar />

  <section class="section-tight" style="background:#070E1A" aria-labelledby="alcance-heading">
    <div class="container-site grid grid-cols-1 lg:grid-cols-[1fr_1.7fr] gap-8 lg:gap-16 items-start">
      <div>
        <span class="section-eyebrow mb-4 inline-flex">Alcance del directorio</span>
        <h2 id="alcance-heading" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.5rem,3vw,2.4rem);line-height:1.05">{g.outline.alcance.linea1}<br/><span style={`color:${g.color}`}>{g.outline.alcance.linea2}</span></h2>
      </div>
      <p class="text-sm leading-[1.9] m-0" style="color:#94A3B8">
        Esta página organiza empresas de {g.sustantivo} por entidad, ciudad y especialidad. Puedes revisar {esp.slice(0, 6).map((e) => e.label).join(', ')} y confirmar con cada ficha los datos de contacto, alcance, documentación y disponibilidad.
      </p>
    </div>
  </section>

  <section class="section" style="background:#040A12" aria-labelledby="comparar-heading">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.35fr] gap-10 lg:gap-20 mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Guía de comparación</span>
          <h2 id="comparar-heading" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">{g.outline.comparar.linea1}<br/><span style={`color:${g.color}`}>{g.outline.comparar.linea2}</span></h2>
        </div>
        <p class="text-sm leading-[1.9] m-0" style="color:#94A3B8">{guide.intro}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-px" style="background:rgba(74,117,153,0.18);border:1px solid rgba(74,117,153,0.18)">
        {guide.comparar.map((item, i) => (
          <article class="p-7" style="background:#070E1A">
            <span class="font-display font-bold text-xs" style={`color:${g.color}`}>{String(i + 1).padStart(2, '0')}</span>
            <h3 class="font-display font-bold text-lg mt-3 mb-3" style="color:#FFFFFF">{item.title}</h3>
            <p class="text-sm leading-relaxed m-0" style="color:#94A3B8">{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-tight" style="background:#070E1A" aria-labelledby="verificar-heading">
    <div class="container-site grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">
      <div>
        <span class="section-eyebrow mb-4 inline-flex">Selección responsable</span>
        <h2 id="verificar-heading" class="font-display font-bold mb-6" style="color:#FFFFFF;font-size:clamp(1.75rem,3.5vw,2.75rem);line-height:1.05">{g.outline.verificar.linea1}<br/><span style={`color:${g.color}`}>{g.outline.verificar.linea2}</span></h2>
        <ol class="flex flex-col gap-3 m-0 pl-5 text-sm leading-relaxed" style="color:#CBD5E1">
          {guide.verificar.map((item) => <li>{item}</li>)}
        </ol>
      </div>
      <div style="border-left:1px solid rgba(74,117,153,0.18);padding-left:clamp(1.5rem,4vw,3rem)">
        <span class="section-eyebrow mb-4 inline-flex">Solicitud comparable</span>
        <h2 class="font-display font-bold mb-6" style="color:#FFFFFF;font-size:clamp(1.75rem,3.5vw,2.75rem);line-height:1.05">{g.outline.cotizar.linea1}<br/><span style={`color:${g.color}`}>{g.outline.cotizar.linea2}</span></h2>
        <ul class="flex flex-col gap-3 m-0 pl-5 text-sm leading-relaxed" style="color:#CBD5E1">
          {guide.cotizar.map((item) => <li>{item}</li>)}
        </ul>
        <a href="/cotizacion/" class="inline-flex mt-7 font-display font-semibold text-xs uppercase tracking-wider hover:text-[#FF6B26]" style="color:#FF8F57">Consultar la guía de cotización →</a>
      </div>
    </div>
  </section>

  <section class="section-tight" style="background:#070E1A" aria-label={`Mapa nacional de ${g.sustantivo}`}>
    <div class="container-site">
      <span class="section-eyebrow mb-4 inline-flex">Mapa</span>
      <h2 class="font-display font-bold mb-6" style="color:#FFFFFF;font-size:clamp(1.5rem,3vw,2.4rem);line-height:1.05">{g.outline.mapa.linea1}<br/><span style={`color:${g.color}`}>{g.outline.mapa.linea2}</span></h2>
      <MapaEmpresas src="/data/empresas-puntos.json" filtroGiro={giro} id={`mapa-${giro}`} ariaLabel={`Mapa de empresas de ${g.sustantivo} en México`} />
    </div>
  </section>

  <section id="estados" class="section" style="background:#040A12" aria-labelledby="estados-heading">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Por estado</span>
          <h2 id="estados-heading" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">{g.outline.estados.linea1}<br/><span style={`color:${g.color}`}>{g.outline.estados.linea2}</span></h2>
        </div>
        <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed" style="color:#94A3B8">Cada estado tiene su directorio propio con mapa, buscador y filtros por especialidad. Presencia destacada en {ciudades.slice(0, 5).map((c) => c.ciudad).join(', ')}.</p>
        </div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-8 gap-px" style="background:rgba(74,117,153,0.18);border:1px solid rgba(74,117,153,0.18)">
        {porEstado.map((s) => (
          <a href={`/empresas/${giro}/${s.slug}/`} class="grid-cell ledger-cell flex flex-col gap-1 p-4" style="background:#070E1A">
            <span class="font-display font-semibold text-sm leading-tight" style="color:#FFFFFF">{s.nombre}</span>
          </a>))}
      </div>
    </div>
  </section>

  <section id="empresas" class="section" style="background:#070E1A" aria-labelledby="lista-heading">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-10">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Listado nacional</span>
          <h2 id="lista-heading" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">{g.outline.lista.linea1}<br/><span style={`color:${g.color}`}>{g.outline.lista.linea2}</span></h2>
        </div>
        <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed" style="color:#94A3B8">Busca por nombre, ciudad o municipio y filtra por especialidad. Cada ficha indica el nivel de verificación de sus datos y la fuente de origen.</p>
        </div>
      </div>
      <EmpresasGrid empresas={lista} mostrarEstado dimension="esp" filtros={esp.map((s) => ({ key: s.slug, label: `${s.label} · ${s.total}`, color: g.color }))} id={`giro-${giro}`} indexSrc="/data/empresas-index.json" alcance={{ giro }} limite={36} />
    </div>
  </section>

  <section class="section" style="background:#040A12" aria-labelledby="faq-heading">
    <div class="container-site max-w-4xl">
      <span class="section-eyebrow mb-4 inline-flex">Preguntas frecuentes</span>
      <h2 id="faq-heading" class="font-display font-bold mb-8" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">{g.outline.faq.linea1}<br/><span style={`color:${g.color}`}>{g.outline.faq.linea2}</span></h2>
      <div class="flex flex-col" style="border-top:1px solid rgba(74,117,153,0.18)">
        {faqItems.map((f) => (
          <details style="border-bottom:1px solid rgba(74,117,153,0.18)">
            <summary class="cursor-pointer py-5 font-display font-semibold text-base" style="color:#FFFFFF">{f.q}</summary>
            <p class="pb-5 text-sm leading-relaxed" style="color:#94A3B8">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="background:#040A12" aria-label="Contenido relacionado">
    <div class="container-site grid grid-cols-1 lg:grid-cols-3 gap-10">
      <div>
        <p class="font-display font-bold text-xs uppercase tracking-widest mb-4" style="color:var(--forge-300)">Otros giros del directorio</p>
        <ul class="flex flex-col list-none m-0 p-0" style="border-top:1px solid rgba(74,117,153,0.15)">
          {otros.map((o) => (<li style="border-bottom:1px solid rgba(74,117,153,0.15)"><a href={`/empresas/${o.slug}/`} class="group flex items-center justify-between gap-4 py-4"><span class="flex flex-col gap-0.5"><span class="font-display font-semibold text-sm group-hover:text-[#FF6B26]" style="color:#FFFFFF">{o.label}</span><span class="text-xs" style="color:#64748B">{o.description}</span></span><span style={`color:${o.color}`}>→</span></a></li>))}
        </ul>
      </div>
      <div>
        <p class="font-display font-bold text-xs uppercase tracking-widest mb-4" style="color:var(--forge-300)">Guías de compra relacionadas</p>
        <ul class="flex flex-col list-none m-0 p-0" style="border-top:1px solid rgba(74,117,153,0.15)">
          {cats.map((c) => (<li style="border-bottom:1px solid rgba(74,117,153,0.15)"><a href={`/productos/${c.slug}/`} class="group flex items-center justify-between gap-4 py-4"><span class="flex flex-col gap-0.5"><span class="font-display font-semibold text-sm group-hover:text-[#FF6B26]" style="color:#FFFFFF">{c.label}</span><span class="text-xs" style="color:#64748B">{c.norm}</span></span><span style="color:var(--forge-300)">→</span></a></li>))}
        </ul>
      </div>
      <div>
        <p class="font-display font-bold text-xs uppercase tracking-widest mb-4" style="color:var(--forge-300)">Servicios y normativa</p>
        <ul class="flex flex-col list-none m-0 p-0" style="border-top:1px solid rgba(74,117,153,0.15)">
          {servs.map((s) => (<li style="border-bottom:1px solid rgba(74,117,153,0.15)"><a href={s.href} class="group flex items-center justify-between gap-4 py-4"><span class="font-display font-semibold text-sm group-hover:text-[#FF6B26]" style="color:#FFFFFF">{s.title}</span><span style="color:var(--forge-300)">→</span></a></li>))}
          <li style="border-bottom:1px solid rgba(74,117,153,0.15)"><a href="/blog/categoria/normatividad/" class="group flex items-center justify-between gap-4 py-4"><span class="font-display font-semibold text-sm group-hover:text-[#FF6B26]" style="color:#FFFFFF">Normatividad NFPA y NOM</span><span style="color:var(--forge-300)">→</span></a></li>
          <li style="border-bottom:1px solid rgba(74,117,153,0.15)"><a href="/estaciones/" class="group flex items-center justify-between gap-4 py-4"><span class="font-display font-semibold text-sm group-hover:text-[#FF6B26]" style="color:#FFFFFF">Directorio de estaciones de bomberos</span><span style="color:var(--forge-300)">→</span></a></li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
