---
// /empresas — Hub L2 del directorio nacional de empresas (plantilla L2, 2026-10)
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import MapaEmpresas from '@components/empresas/MapaEmpresas.astro';
import EmpresasGrid from '@components/empresas/EmpresasGrid.astro';
import LineaCard from '@components/products/LineaCard.astro';
import L2Sidebar from '@components/l2/L2Sidebar.astro';
import L2Cotizar from '@components/l2/L2Cotizar.astro';
import { bloqueDirectorio, bloqueGuias, bloqueCategorias, bloqueServicios, bloqueIndustrias, anchoFila, type L2Link } from '@lib/l2';
import '@styles/l2.css';
import { SITE } from '@config/site';
import { giros } from '@data/giros';
import { todasLasEmpresas, estadosMeta } from '@lib/empresas';
import { ANCLA_GIRO, INDUSTRIAS_POR_GIRO, guiasPara } from '@lib/enlaces-directorio';

const all = await todasLasEmpresas();
const porEstado = estadosMeta.map((e) => ({ slug: e.slug, nombre: e.nombre, region: e.region }));
const totalEmpresas = all.length;

const canonicalURL = `${SITE.url}/empresas/`;
const seoMeta = {
  title: 'Directorio de empresas de equipo contra incendio en México',
  description: 'Directorio de empresas de equipo contra incendio en México: venta de extintores, hidrantes, sistemas contra incendio, EPP para bomberos y capacitación.',
  canonicalURL,
};
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
  { '@type': 'ListItem', position: 2, name: 'Directorio de Empresas', item: canonicalURL } ] };
const collectionSchema = { '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': `${canonicalURL}#collection`,
  name: 'Directorio de Empresas de Equipo Contra Incendio en México', description: seoMeta.description, url: canonicalURL, inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: { '@type': 'ItemList', name: 'Giros del directorio', numberOfItems: giros.length,
    itemListElement: giros.map((g, i) => ({ '@type': 'ListItem', position: i + 1, name: g.label, url: `${SITE.url}/empresas/${g.slug}/` })) } };
const faqItems = [
  { pregunta: '¿Qué es este directorio?', respuesta: 'Es un directorio nacional que organiza por giro y ubicación a las empresas de venta de equipos contra incendios y equipo de bombero: EPP, equipos de combate, extintores, sistemas contra incendios y capacitación. No vende equipo: sirve para que un cuerpo de bomberos o una brigada localice proveedores en toda la República y compare lo que cada uno publica.' },
  { pregunta: '¿Cómo busco una empresa?', respuesta: 'Puedes entrar por giro, elegir un estado o usar el buscador por nombre, ciudad o municipio. Si buscas un servicio concreto —recarga de extintores portátiles, mantenimiento preventivo, pruebas hidrostáticas, supresión con agente limpio, boquillas y mangueras, señalización, sistemas de alarma, bombas contra incendio o sistemas de rociadores— conviene entrar por el giro correspondiente y filtrar después por estado. Las fichas muestran el nivel de confianza disponible.' },
  { pregunta: '¿De dónde salen los datos?', respuesta: 'Los registros básicos provienen de fuentes públicas y cada ficha muestra la fuente de origen disponible. La información puede solicitar corrección o actualización por parte de la empresa.' },
  { pregunta: '¿INPROSEG vende directamente todo el equipo?', respuesta: 'Esta sección funciona como directorio. Su objetivo es ayudarte a localizar y comparar información publicada de empresas de venta y mantenimiento de equipo de seguridad contra incendios; la disponibilidad, cobertura y condiciones deben confirmarse directamente con cada empresa.' },
  { pregunta: '¿Qué giro me conviene según el tipo de riesgo?', respuesta: 'Depende de lo que hay que proteger. Una planta industrial que necesita sistemas hidráulicos, bombas contra incendio y sistemas de detección y alarma entra por sistemas contra incendio; un inmueble que sólo requiere extintores y señalización, por extintores; y un cuerpo de bomberos o una brigada que va a equiparse, por equipo para bomberos y EPP. Si operas en la zona metropolitana o en cualquier otro punto del país, filtra después por estado.' },
  { pregunta: '¿Qué certificaciones debo pedir al comparar equipo contra incendio?', respuesta: 'Depende del producto y del uso. En la normativa mexicana, la NOM-002-STPS-2010 fija obligaciones del centro de trabajo; NOM-100-STPS aplica a extintores PQS, NOM-102-STPS a CO₂ y NOM-154-SCFI al servicio de mantenimiento y recarga. Pide siempre el documento del modelo concreto: una mención comercial a la norma NFPA no sustituye la evidencia.' },
  { pregunta: '¿Cómo registro o corrijo una ficha?', respuesta: 'Puedes solicitar el alta, reclamación o corrección desde la página de registro del directorio.' },
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.pregunta, acceptedAnswer: { '@type': 'Answer', text: f.respuesta } })) };

/* Tarjetas de giro: imagen del giro + lista índice (2 industrias temáticas + 2 guías del blog) */
const tarjetasGiro = await Promise.all(giros.map(async (g) => {
  const guias = await guiasPara(g.slug, `hub-${g.slug}`, 2);
  return {
    g,
    hijas: [
      ...INDUSTRIAS_POR_GIRO[g.slug],
      ...guias.map((p) => ({ label: p.data.title, href: `/blog/${p.id}/` })),
    ],
  };
}));

/* ─── Plantilla L2 (homologada con /productos/, 2026-10) ────────── */
const secciones = [
  { id: 'buscar', label: 'Buscador' },
  { id: 'giros', label: 'Por giro' },
  { id: 'mapa', label: 'Mapa nacional' },
  { id: 'estados', label: 'Por estado' },
  { id: 'preguntas', label: 'Preguntas' },
  { id: 'registro', label: 'Registro' },
];

const GUIAS_DIRECTORIO: L2Link[] = [
  { label: 'Comprar en línea o con distribuidor', href: '/blog/comprar-equipo-contra-incendio-en-linea-o-distribuidor/' },
  { label: 'Visita técnica del proveedor', href: '/blog/visita-tecnica-proveedor-equipo-contra-incendio/' },
  { label: 'Guía de compra de equipo para bomberos', href: '/blog/guia-compra-equipo-bomberos-nfpa-mexico-2026/' },
  { label: 'Guía NOM-002-STPS-2010', href: '/blog/nom-002-stps-guia-completa/' },
  { label: 'Elegir un servicio de recarga de extintores', href: '/blog/elegir-servicio-de-recarga-de-extintores/' },
  { label: 'Normas NFPA y NOM aplicables', href: '/certificaciones/' },
];

const tambien = [
  { label: 'Estaciones de bomberos por estado', desc: 'Directorio nacional de estaciones', href: '/estaciones' },
  { label: 'Empresas por estado', desc: 'Cobertura del directorio en los 32 estados', href: '/cobertura' },
  { label: 'Normas y certificaciones', desc: 'Qué NOM y NFPA pedir al comparar', href: '/certificaciones' },
  { label: 'Industrias', desc: 'Sectores que usan equipo contra incendio', href: '/industrias' },
  { label: 'Blog técnico', desc: 'Guías NFPA y NOM para bomberos y brigadas', href: '/blog' },
  { label: 'Contacto del directorio', desc: 'Correcciones, dudas y solicitudes de baja', href: '/contacto' },
];

const trustPoints = [
  { title: 'Por giro y estado', text: 'Cinco giros y 32 estados para localizar empresas por actividad y ubicación.' },
  { title: 'Fuente de origen visible', text: 'Cada ficha muestra de dónde proviene su información y cuándo se verificó.' },
  { title: 'Nivel de confianza', text: 'Las fichas indican si sus datos están verificados contra fuente oficial.' },
  { title: 'Corrección por la empresa', text: 'Cualquier empresa puede reclamar, completar o corregir su ficha.' },
];
---
<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema, faqSchema]}>
  <nav class="py-3" style="background:var(--c-bg-alt);border-bottom:1px solid var(--c-line)" aria-label="Breadcrumb">
    <div class="container-site"><ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
      <li><a href="/" class="hover:text-[var(--c-accent)]">Inicio</a></li><li aria-hidden="true">/</li>
      <li><span style="color:var(--c-text-2)" aria-current="page">Directorio de Empresas</span></li></ol></div>
  </nav>

  <section class="relative overflow-hidden" style="background:var(--c-bg);padding-block:5rem" aria-labelledby="emp-heading">
    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="section-eyebrow mb-5 inline-flex">Directorio nacional · 32 estados</span>
          <h1 id="emp-heading" class="font-display font-bold mb-6" style="color:var(--c-ink);font-size:clamp(2.25rem,4.5vw,3.5rem);line-height:1.08">
            Directorio de empresas<br/><span style="color:var(--c-accent)">de equipo contra incendio</span><br/>en México
          </h1>
          <p class="text-sm leading-[1.9] mb-4" style="color:var(--c-text-2)">
            Encuentra empresas que equipan a cuerpos de bomberos, brigadas y protección civil con equipo para bomberos y EPP, extintores, sistemas contra incendios y capacitación en los 32 estados. Cada registro muestra su ubicación y la fuente de origen disponible.
          </p>
          <p class="text-sm leading-[1.9] mb-8" style="color:var(--c-text-2)">
            Clasificamos a cada empresa por giro y especialidad —venta de equipos, protección contra incendio, sistemas de detección, hidrantes, mangueras, gabinetes y rociadores— para que un cuerpo de bomberos, una brigada industrial o un comprador institucional pueda equipar su operación y elegir un sistema contra incendios comparando la información publicada de proveedores y distribuidores en su estado.
          </p>
          <p class="font-display text-xs uppercase tracking-widest mb-8" style="color:var(--forge-300)">{totalEmpresas.toLocaleString('es-MX')} empresas registradas · 32 estados</p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="#buscar" class="btn btn-primary btn-lg">Buscar empresas contra incendio</a>
            <a href="/empresas/registro/" class="btn btn-ghost btn-lg">Registrar mi empresa</a>
          </div>
        </div>
        <div class="lg:pl-16" style="border-left:1px solid var(--c-line)">
          <p class="font-display font-bold text-xs uppercase tracking-widest mb-4" style="color:var(--forge-300)">Entra por giro</p>
          <ul class="flex flex-col list-none m-0 p-0" style="border-top:1px solid var(--c-line)">
            {giros.map((g) => (
              <li style="border-bottom:1px solid var(--c-line)">
                <a href={`/empresas/${g.slug}/`} class="group flex items-center justify-between gap-4 py-3.5">
                  <span class="flex flex-col gap-0.5"><span class="font-display font-semibold text-sm group-hover:text-[var(--c-accent)]" style="color:var(--c-ink)">{g.label}</span><span class="text-xs" style="color:var(--c-muted)">{g.description}</span></span>
                </a>
              </li>))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <QuickLinksBar />

  <!-- Pilares -->
  <section class="section-tight" style="background:var(--c-bg-alt)" aria-labelledby="garantias-title">
    <div class="container-site">
      <h2 id="garantias-title" class="sr-only">Cómo funciona el directorio</h2>
      <div class="l2-trust">
        {trustPoints.map((t) => (
          <div><h3>{t.title}</h3><p>{t.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Plantilla L2: columna principal + barra lateral -->
  <div class="container-site l2-shell">
    <L2Sidebar
      resumen="Navegar el directorio"
      secciones={secciones}
      bloques={[bloqueDirectorio(), bloqueGuias(GUIAS_DIRECTORIO, 'Cómo comparar proveedores'), bloqueCategorias(), bloqueServicios(), bloqueIndustrias()]}
      accion={{ titulo: 'Datos del directorio', texto: '¿Tu empresa no aparece o necesita una corrección?', botones: [{ label: 'Registrar o corregir ficha', href: '/empresas/registro/', primario: true }] }}
    />

    <div class="l2-main">

      <!-- Buscador -->
      <section id="buscar" class="l2-sec" aria-labelledby="buscar-heading">
        <header class="l2-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Buscador</span>
          <h2 id="buscar-heading" class="l2-h2">Busca entre distribuidores y empresas de equipo de bombero en toda la República</h2>
          <p class="l2-lead">Escribe el nombre de la empresa, la ciudad o el municipio. Filtra por giro. El listado prioriza a las empresas con ficha verificada o destacada.</p>
        </header>
        <EmpresasGrid empresas={all} mostrarEstado filtros={giros.map((g) => ({ key: g.slug, label: g.labelCorto, color: g.color }))} id="hub" indexSrc="/data/empresas-index.json" limite={36} />
      </section>

      <!-- Giros -->
      <section id="giros" class="l2-sec" aria-labelledby="giros-heading">
        <header class="l2-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Por giro</span>
          <h2 id="giros-heading" class="l2-h2">Cinco giros para equipar a bomberos, brigadas y protección civil en un solo directorio</h2>
          <p class="l2-lead">Agrupamos a las empresas por la actividad que describen sus fuentes públicas: equipo de protección personal, equipos para redes contra incendio, servicio a extintores, sistemas fijos o capacitación de brigadas. Una empresa puede aparecer en más de un giro.</p>
        </header>
        <ul class="l2-grid" role="list">
          {tarjetasGiro.map(({ g, hijas }, i) => (
            <li class={anchoFila(i, tarjetasGiro.length) || undefined}>
              <LineaCard
                href={`/empresas/${g.slug}/`}
                norma={g.labelCorto}
                titulo={g.label}
                texto={g.claim}
                imagen={g.imagen}
                imagenAlt={g.imagenAlt}
                hijas={hijas}
                cta={ANCLA_GIRO[g.slug]}
                nivel="h3"
                subLabel="Sectores y guías"
              />
            </li>
          ))}
        </ul>
      </section>

      <!-- Mapa nacional -->
      <section id="mapa" class="l2-sec" aria-labelledby="mapa-heading">
        <header class="l2-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Mapa nacional</span>
          <h2 id="mapa-heading" class="l2-h2">Proveedores de equipos contra incendios y sistemas de detección en el mapa nacional</h2>
        </header>
        <MapaEmpresas src="/data/empresas-puntos.json" ariaLabel="Mapa nacional de empresas de equipo contra incendio" />
        <div class="flex flex-wrap gap-4 mt-3">
          {giros.map((g) => <span class="inline-flex items-center gap-2 text-2xs" style="color:var(--c-text-2)"><span class="w-2.5 h-2.5 rounded-full" style={`background:${g.color}`}></span>{g.labelCorto}</span>)}
          <span class="text-2xs" style="color:var(--forge-300)">Coordenadas del registro público DENUE (INEGI).</span>
        </div>
      </section>

      <!-- Por estado -->
      <section id="estados" class="l2-sec" aria-labelledby="estados-heading">
        <header class="l2-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Por estado</span>
          <h2 id="estados-heading" class="l2-h2">Equipo contra incendio, extintores, hidrantes, mangueras y gabinetes en los 32 estados</h2>
          <p class="l2-lead">Cada estado tiene su propio directorio con mapa, buscador y filtros por giro. Elige tu entidad para ver a los proveedores más cercanos.</p>
        </header>
        <ul class="em-estados" role="list">
          {porEstado.map((s) => (
            <li>
              <a href={`/empresas/estado/${s.slug}/`}>
                <span class="em-estado-nombre">{s.nombre}</span>
                <span class="em-estado-region">{s.region}</span>
              </a>
            </li>))}
        </ul>
      </section>

      <!-- Preguntas frecuentes -->
      <section id="preguntas" class="l2-sec" aria-labelledby="faq-heading">
        <header class="l2-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Preguntas frecuentes</span>
          <h2 id="faq-heading" class="l2-h2">Cómo elegir un proveedor y verificar equipo certificado bajo norma NFPA</h2>
          <p class="l2-lead">Consulta la metodología, el alcance de las fichas y la forma correcta de contactar a cada empresa antes de solicitar una cotización.</p>
        </header>
        <div class="l2-faq">
          {faqItems.map((f) => (
            <details>
              <summary><span>{f.pregunta}</span><span class="l2-faq-mas" aria-hidden="true">+</span></summary>
              <p>{f.respuesta}{f.pregunta === '¿Cómo registro o corrijo una ficha?' && <> <a href="/empresas/registro/" class="underline" style="color:var(--c-accent)">Ir al registro.</a></>}</p>
            </details>
          ))}
        </div>
      </section>

      <!-- Registro + cross-links -->
      <L2Cotizar
        id="registro"
        eyebrow="Para empresas del sector"
        titulo="¿Tu empresa ya está listada?"
        destacado="Reclama y verifica tu ficha."
        texto="Los registros básicos provienen del registro público del DENUE. Al reclamar tu ficha puedes completar contacto, marcas que distribuyes, certificaciones y cobertura, y obtener el sello de datos verificados. Las fichas destacadas aparecen primero en su giro y estado."
        cta={{ label: 'Registrar o reclamar ficha', href: '/empresas/registro/' }}
        tambien={tambien}
      />

    </div>
  </div>
</BaseLayout>

<style>
  /* Buscador dentro de la columna L2: 3 fichas por fila (la rejilla global asume ancho completo) */
  :global(#hub-grid) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 1024px) { :global(#hub-grid) { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .em-estados { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin: 0; padding: 0; list-style: none; background: var(--c-line); border: 1px solid var(--c-line); }
  @media (min-width: 640px) { .em-estados { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .em-estados { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .em-estados li { display: flex; background: var(--c-surface); }
  .em-estados a { display: flex; flex: 1; flex-direction: column; gap: .25rem; padding: .875rem 1rem; text-decoration: none; transition: background-color .15s; }
  .em-estados a:hover, .em-estados a:focus-visible { background: var(--c-bg-alt); }
  .em-estado-nombre { font-family: var(--font-display); font-size: .875rem; font-weight: 600; line-height: 1.3; color: var(--c-ink); }
  .em-estados a:hover .em-estado-nombre, .em-estados a:focus-visible .em-estado-nombre { color: var(--c-accent); }
  .em-estado-region { font-size: .75rem; letter-spacing: .08em; text-transform: uppercase; color: var(--forge-300); }
</style>
