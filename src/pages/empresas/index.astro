---
// /empresas — Hub L1 del directorio nacional de empresas
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import MapaEmpresas from '@components/empresas/MapaEmpresas.astro';
import EmpresasGrid from '@components/empresas/EmpresasGrid.astro';
import { SITE } from '@config/site';
import { giros } from '@data/giros';
import { todasLasEmpresas, estadosMeta } from '@lib/empresas';

const all = await todasLasEmpresas();
const porEstado = estadosMeta.map((e) => ({ slug: e.slug, nombre: e.nombre }));
const totalEmpresas = all.length;

const canonicalURL = `${SITE.url}/empresas/`;
const seoMeta = {
  title: 'Directorio de Empresas de Equipo Contra Incendio en México',
  description: 'Directorio de empresas de equipo para bomberos, extintores, sistemas contra incendio y capacitación en los 32 estados de México. Busca por giro, estado y ciudad.',
  canonicalURL,
};
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
  { '@type': 'ListItem', position: 2, name: 'Directorio de Empresas', item: canonicalURL } ] };
const collectionSchema = { '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': `${canonicalURL}#collection`,
  name: 'Directorio de Empresas de Equipo Contra Incendio en México', description: seoMeta.description, url: canonicalURL, inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: { '@type': 'ItemList', name: 'Giros del directorio', numberOfItems: giros.length,
    itemListElement: giros.map((g, i) => ({ '@type': 'ListItem', position: i + 1, name: g.label, url: `${SITE.url}/empresas/${g.slug}/` })) } };
const faqItems = [
  { pregunta: '¿Qué es este directorio?', respuesta: 'Es un directorio nacional que organiza por giro y ubicación a las empresas de equipo para bomberos y EPP, equipos contra incendios, extintores, sistemas contra incendio y capacitación. No vende equipo: sirve para localizar proveedores en toda la República y comparar lo que cada uno publica.' },
  { pregunta: '¿Cómo busco una empresa?', respuesta: 'Puedes entrar por giro, elegir un estado o usar el buscador por nombre, ciudad o municipio. Si buscas un servicio concreto —recarga y mantenimiento preventivo de extintores, pruebas hidrostáticas, sistemas de supresión con agente limpio, boquillas y mangueras o un sistema de detección— conviene entrar por el giro correspondiente y filtrar después por estado. Las fichas muestran el nivel de confianza disponible.' },
  { pregunta: '¿De dónde salen los datos?', respuesta: 'Los registros básicos provienen de fuentes públicas y cada ficha muestra la fuente de origen disponible. La información puede solicitar corrección o actualización por parte de la empresa.' },
  { pregunta: '¿FIREFIGHTERS MX vende directamente todo el equipo?', respuesta: 'Esta sección funciona como directorio. Su objetivo es ayudarte a localizar y comparar información publicada de empresas del sector; la disponibilidad, cobertura y condiciones deben confirmarse directamente con cada empresa.' },
  { pregunta: '¿Qué certificaciones debo pedir al comparar equipo contra incendio?', respuesta: 'Depende del producto y del uso. La NOM-002-STPS-2010 fija obligaciones del centro de trabajo, mientras que las referencias NFPA, UL o FM aplican al equipo certificado según su tipo. Pide siempre el documento del modelo concreto: una mención comercial a la norma NFPA no sustituye la evidencia.' },
  { pregunta: '¿Cómo registro o corrijo una ficha?', respuesta: 'Puedes solicitar el alta, reclamación o corrección desde la página de registro del directorio.' },
];
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqItems.map((f) => ({ '@type': 'Question', name: f.pregunta, acceptedAnswer: { '@type': 'Answer', text: f.respuesta } })) };
---
<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema, faqSchema]}>
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site"><ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
      <li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li><li aria-hidden="true">/</li>
      <li><span style="color:#94A3B8" aria-current="page">Directorio de Empresas</span></li></ol></div>
  </nav>

  <section class="relative overflow-hidden" style="background:#040A12;padding-block:5rem" aria-labelledby="emp-heading">
    <div class="absolute top-0 right-0 w-2/3 h-full pointer-events-none" aria-hidden="true" style="background:radial-gradient(ellipse 70% 60% at 85% 40%, rgba(247,80,0,0.07) 0%, transparent 65%)"></div>
    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="section-eyebrow mb-5 inline-flex">Directorio nacional · 32 estados</span>
          <h1 id="emp-heading" class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2.2rem,5vw,4rem);line-height:0.95">
            Directorio de empresas<br/><span style="color:#F75000">de equipo contra incendio</span><br/>en México
          </h1>
          <p class="text-sm leading-[1.9] mb-4" style="color:#94A3B8">
            Encuentra empresas que equipan a cuerpos de bomberos, brigadas y protección civil con equipo para bomberos y EPP, extintores, sistemas contra incendios y capacitación en los 32 estados. Cada registro muestra su ubicación y la fuente de origen disponible.
          </p>
          <p class="text-sm leading-[1.9] mb-8" style="color:#94A3B8">
            Clasificamos a cada empresa por giro y especialidad —venta de equipos, protección contra incendio, sistemas de detección, hidrantes, mangueras, gabinetes y rociadores— para que un cuerpo de bomberos, una brigada industrial o un comprador institucional pueda equipar su operación comparando la información publicada de proveedores y distribuidores en su estado.
          </p>
          <p class="font-display text-xs uppercase tracking-widest mb-8" style="color:var(--forge-300)">{totalEmpresas.toLocaleString('es-MX')} empresas registradas · 32 estados</p>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="#buscar" class="btn btn-primary btn-lg">Buscar empresas contra incendio</a>
            <a href="/empresas/registro/" class="btn btn-ghost btn-lg">Registrar mi empresa →</a>
          </div>
        </div>
        <div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,0.1)">
          <p class="font-display font-bold text-xs uppercase tracking-widest mb-4" style="color:var(--forge-300)">Entra por giro</p>
          <ul class="flex flex-col list-none m-0 p-0" style="border-top:1px solid rgba(74,117,153,0.15)">
            {giros.map((g) => (
              <li style="border-bottom:1px solid rgba(74,117,153,0.15)">
                <a href={`/empresas/${g.slug}/`} class="group flex items-center justify-between gap-4 py-3.5">
                  <span class="flex flex-col gap-0.5"><span class="font-display font-semibold text-sm group-hover:text-[#FF6B26]" style="color:#FFFFFF">{g.label}</span><span class="text-xs" style="color:#64748B">{g.description}</span></span>
                  <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke={g.color} stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/></svg>
                </a>
              </li>))}
          </ul>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-px" aria-hidden="true" style="background:linear-gradient(90deg, transparent, rgba(247,80,0,0.4) 30%, rgba(247,80,0,0.4) 70%, transparent)"></div>
  </section>

  <QuickLinksBar />

  {/* Giros */}
  <section class="section" style="background:#070E1A" aria-labelledby="giros-heading">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Por giro</span>
          <h2 id="giros-heading" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">Cinco giros de equipo contra incendio, EPP y sistemas<br/><span style="color:#F75000">en un solo directorio.</span></h2>
        </div>
        <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed" style="color:#94A3B8">Agrupamos a las empresas por la actividad que describen sus fuentes públicas: vender equipo de protección personal, suministrar equipos para redes contra incendio, dar servicio a extintores, instalar sistemas fijos o capacitar brigadas. Una empresa puede aparecer en más de un giro.</p>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-px" style="background:rgba(74,117,153,0.18);border:1px solid rgba(74,117,153,0.18)">
        {giros.map((g) => { return (
          <a href={`/empresas/${g.slug}/`} class="grid-cell flex flex-col gap-4 p-7" style="background:#040A12">
            <span class="w-10 h-10 flex items-center justify-center" style={`color:${g.color};border:1px solid ${g.color}55`}>
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={g.icon} aria-hidden="true"/></span>
            <span class="font-display font-bold text-lg leading-snug" style="color:#FFFFFF">{g.label}</span>
            <span class="text-xs leading-relaxed" style="color:#64748B">{g.description}</span>
            <span class="mt-auto font-display font-semibold text-xs uppercase tracking-wider" style="color:#FF8F57">{g.labelCorto} en México →</span>
          </a>); })}
      </div>
    </div>
  </section>

  {/* Mapa nacional */}
  <section class="section-tight" style="background:#040A12" aria-label="Mapa nacional de empresas">
    <div class="container-site">
      <span class="section-eyebrow mb-4 inline-flex">Mapa nacional</span>
      <h2 class="font-display font-bold mb-6" style="color:#FFFFFF;font-size:clamp(1.5rem,3vw,2.4rem);line-height:1.05">Proveedores y distribuidores de equipo contra incendio<br/><span style="color:#F75000">en el mapa nacional.</span></h2>
      <MapaEmpresas src="/data/empresas-puntos.json" ariaLabel="Mapa nacional de empresas de equipo contra incendio" />
      <div class="flex flex-wrap gap-4 mt-3">
        {giros.map((g) => <span class="inline-flex items-center gap-2 text-[11px]" style="color:#94A3B8"><span class="w-2.5 h-2.5 rounded-full" style={`background:${g.color}`}></span>{g.labelCorto}</span>)}
        <span class="text-[11px]" style="color:var(--forge-300)">Coordenadas del registro público DENUE (INEGI).</span>
      </div>
    </div>
  </section>

  {/* Por estado */}
  <section class="section" style="background:#070E1A" aria-labelledby="estados-heading">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Por estado</span>
          <h2 id="estados-heading" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">Equipo contra incendio, extintores, hidrantes y mangueras<br/><span style="color:#F75000">en los 32 estados.</span></h2>
        </div>
        <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed" style="color:#94A3B8">Cada estado tiene su propio directorio con mapa, buscador y filtros por giro. Elige tu entidad para ver a los proveedores más cercanos.</p>
        </div>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-8 gap-px" style="background:rgba(74,117,153,0.18);border:1px solid rgba(74,117,153,0.18)">
        {porEstado.map((s) => (
          <a href={`/empresas/estado/${s.slug}/`} class="grid-cell ledger-cell flex flex-col gap-1 p-4" style="background:#040A12">
            <span class="font-display font-semibold text-sm leading-tight" style="color:#FFFFFF">{s.nombre}</span>
            <span class="text-[10px] uppercase tracking-widest" style="color:var(--forge-300)">{estadosMeta.find((e) => e.slug === s.slug)?.region}</span>
          </a>))}
      </div>
    </div>
  </section>

  {/* Buscador global */}
  <section id="buscar" class="section" style="background:#040A12" aria-labelledby="buscar-heading">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-10">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Buscador</span>
          <h2 id="buscar-heading" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">Busca entre todas las empresas<br/><span style="color:#F75000">de equipo contra incendio en México.</span></h2>
        </div>
        <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed" style="color:#94A3B8">Escribe el nombre de la empresa, la ciudad o el municipio. Filtra por giro. El listado prioriza a las empresas con ficha verificada o destacada.</p>
        </div>
      </div>
      <EmpresasGrid empresas={all} mostrarEstado filtros={giros.map((g) => ({ key: g.slug, label: g.labelCorto, color: g.color }))} id="hub" indexSrc="/data/empresas-index.json" limite={36} />
    </div>
  </section>

  {/* Registro */}
  <section class="section" style="background:#070E1A" aria-labelledby="alta-heading">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto] gap-10 items-center p-8 lg:p-12" style="background:#0C1825;border:1px solid rgba(74,117,153,0.25);border-left:3px solid #F5A623">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Para empresas del sector</span>
          <h2 id="alta-heading" class="font-display font-bold mb-3" style="color:#FFFFFF;font-size:clamp(1.6rem,3vw,2.5rem);line-height:1.05">¿Tu empresa ya está listada?<br/><span style="color:#F5A623">Reclama y verifica tu ficha.</span></h2>
          <p class="text-sm leading-relaxed max-w-2xl" style="color:#94A3B8">Los registros básicos provienen del registro público del DENUE. Al reclamar tu ficha puedes completar contacto, marcas que distribuyes, certificaciones y cobertura, y obtener el sello de datos verificados. Las fichas destacadas aparecen primero en su giro y estado.</p>
        </div>
        <div class="flex flex-col gap-3 shrink-0">
          <a href="/empresas/registro/" class="btn btn-gold btn-lg">Registrar o reclamar ficha</a>
          <a href="/contacto/" class="btn btn-ghost">Hablar con FIREFIGHTERS MX →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="background:#040A12" aria-labelledby="faq-heading">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-start">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Preguntas frecuentes</span>
          <h2 id="faq-heading" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">Cómo elegir un proveedor de equipo contra incendio<br/><span style="color:#F75000">y cómo funciona el directorio.</span></h2>
          <p class="text-sm leading-relaxed mt-6" style="color:#94A3B8">Consulta la metodología, el alcance de las fichas y la forma correcta de contactar a cada empresa antes de solicitar una cotización.</p>
        </div>
        <div class="flex flex-col" style="border-top:1px solid rgba(74,117,153,0.2)">
          {faqItems.map((f) => (
            <details style="border-bottom:1px solid rgba(74,117,153,0.2)">
              <summary class="flex items-center justify-between gap-4 py-5 cursor-pointer font-display font-semibold text-sm" style="color:#FFFFFF">{f.pregunta}<span style="color:#F75000" aria-hidden="true">+</span></summary>
              <p class="text-sm leading-relaxed pb-5" style="color:#94A3B8">{f.respuesta}{f.pregunta === '¿Cómo registro o corrijo una ficha?' && <> <a href="/empresas/registro/" class="underline" style="color:#FF8F57">Ir al registro.</a></>}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
