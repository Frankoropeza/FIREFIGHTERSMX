---
import BaseLayout from '@layouts/BaseLayout.astro';

const estados = [
  { name: "Ciudad de México", dias: "24-48 hrs", type: "express" },
  { name: "Estado de México", dias: "24-48 hrs", type: "express" },
  { name: "Jalisco", dias: "2-3 días", type: "normal" },
  { name: "Nuevo León", dias: "2-3 días", type: "normal" },
  { name: "Puebla", dias: "2-3 días", type: "normal" },
  { name: "Querétaro", dias: "24-48 hrs", type: "express" },
  { name: "Guanajuato", dias: "2-3 días", type: "normal" },
  { name: "Baja California", dias: "3-5 días", type: "normal" },
  { name: "Coahuila", dias: "3-4 días", type: "normal" },
  { name: "Veracruz", dias: "3-4 días", type: "normal" },
  { name: "Chihuahua", dias: "3-5 días", type: "normal" },
  { name: "Sonora", dias: "3-5 días", type: "normal" },
  { name: "Tamaulipas", dias: "3-4 días", type: "normal" },
  { name: "Sinaloa", dias: "3-5 días", type: "normal" },
  { name: "San Luis Potosí", dias: "2-3 días", type: "normal" },
  { name: "Michoacán", dias: "2-3 días", type: "normal" },
  { name: "Hidalgo", dias: "24-48 hrs", type: "express" },
  { name: "Morelos", dias: "24-48 hrs", type: "express" },
  { name: "Oaxaca", dias: "3-5 días", type: "normal" },
  { name: "Chiapas", dias: "4-6 días", type: "normal" },
  { name: "Yucatán", dias: "3-5 días", type: "normal" },
  { name: "Quintana Roo", dias: "3-5 días", type: "normal" },
  { name: "Campeche", dias: "4-5 días", type: "normal" },
  { name: "Tabasco", dias: "3-5 días", type: "normal" },
  { name: "Guerrero", dias: "3-5 días", type: "normal" },
  { name: "Tlaxcala", dias: "24-48 hrs", type: "express" },
  { name: "Aguascalientes", dias: "2-3 días", type: "normal" },
  { name: "Colima", dias: "3-4 días", type: "normal" },
  { name: "Durango", dias: "3-5 días", type: "normal" },
  { name: "Nayarit", dias: "3-5 días", type: "normal" },
  { name: "Zacatecas", dias: "2-4 días", type: "normal" },
  { name: "Baja California Sur", dias: "5-7 días", type: "normal" },
];
---
<BaseLayout
  title="Cobertura Nacional — Envíos a 32 Estados | FIREFIGHTERS MX"
  description="FIREFIGHTERS MX entrega equipos para bomberos en los 32 estados de México. Envío express en CDMX, Estado de México, Querétaro, Hidalgo, Morelos y Tlaxcala."
>
  <section class="bg-gradient-fire py-16">
    <div class="container-site text-center text-white">
      <h1 class="section-title text-white mb-4">Cobertura Nacional</h1>
      <p class="section-subtitle text-fire-200 mx-auto">
        Enviamos equipos certificados a los 32 estados de México.
        Empaque seguro y seguro de carga incluido.
      </p>
    </div>
  </section>

  <section class="section bg-dark-50">
    <div class="container-site">
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-12">
        {[
          { emoji: "⚡", label: "Envío express", desc: "CDMX y área metropolitana en 24-48 hrs" },
          { emoji: "🛡️", label: "Seguro de carga", desc: "Todos los envíos asegurados sin costo extra" },
          { emoji: "📦", label: "Empaque especializado", desc: "Cajas reforzadas para equipos técnicos" },
          { emoji: "📍", label: "Rastreo en tiempo real", desc: "Número de guía al confirmar pedido" },
        ].map((item) => (
          <div class="bg-white rounded-2xl p-6 text-center">
            <div class="text-3xl mb-3">{item.emoji}</div>
            <div class="font-bold text-dark-900 mb-1 text-sm">{item.label}</div>
            <div class="text-dark-400 text-xs">{item.desc}</div>
          </div>
        ))}
      </div>

      <h2 class="section-title text-center mb-8">Tiempos de Entrega por Estado</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-3">
        {estados.map((e) => (
          <div class={`bg-white rounded-xl p-4 flex items-center justify-between border ${e.type === 'express' ? 'border-fire-200' : 'border-transparent'}`}>
            <div>
              <div class="font-semibold text-dark-800 text-sm">{e.name}</div>
              <div class="text-dark-400 text-xs">{e.dias} hábiles</div>
            </div>
            {e.type === 'express' && <span class="badge-fire text-2xs">Express</span>}
          </div>
        ))}
      </div>

      <div class="text-center mt-10 text-dark-400 text-sm">
        Los tiempos son estimados. Sujetos a disponibilidad de stock y paquetería.
        Envíos urgentes disponibles bajo consulta.
      </div>
    </div>
  </section>
</BaseLayout>
