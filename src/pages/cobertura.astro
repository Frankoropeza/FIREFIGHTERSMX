---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { estados, regionesPresentes } from '@data/estados';
import { SITE } from '@config/site';

const canonicalURL = `${SITE.url}/cobertura/`;
const seoMeta = {
  title: 'Empresas de Equipo Contra Incendio por Estado | México',
  description: 'Consulta empresas de equipo contra incendio y equipo para bomberos en los 32 estados de México. Explora el directorio por entidad y especialidad.',
  canonicalURL,
};

const criterios = [
  { title: 'Ubicación registrada', text: 'La página estatal organiza empresas por la entidad y el municipio presentes en su registro.' },
  { title: 'Giro relacionado', text: 'Cada ficha se agrupa por actividades como equipo, extintores, sistemas o capacitación.' },
  { title: 'Datos por confirmar', text: 'Cobertura comercial, envíos y servicio en sitio deben confirmarse directamente con cada empresa.' },
  { title: 'Correcciones', text: 'Las empresas pueden solicitar revisión de datos o aportar información verificable para completar su ficha.' },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Empresas por estado', item: canonicalURL },
  ],
};
const collectionSchema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': `${canonicalURL}#collection`,
  name: seoMeta.title, description: seoMeta.description, url: canonicalURL, inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
};
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema]}>
  <nav class="py-3" style="background:var(--c-bg-alt);border-bottom:1px solid var(--c-line)" aria-label="Breadcrumb"><div class="container-site"><ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)"><li><a href="/" class="hover:text-[var(--c-accent)]">Inicio</a></li><li aria-hidden="true">/</li><li aria-current="page" style="color:var(--c-text-2)">Empresas por estado</li></ol></div></nav>

  <section class="relative overflow-hidden" style="background:var(--c-bg);padding-block:5rem">
    <div class="container-site relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <div><span class="section-eyebrow mb-5 inline-flex">Directorio nacional · 32 estados</span><h1 class="font-display font-bold uppercase mb-6" style="color:var(--c-ink);font-size:clamp(2.4rem,5.5vw,4.4rem);line-height:0.95">Empresas por<br/><span style="color:var(--c-accent)">estado de México.</span></h1><div class="flex flex-col sm:flex-row gap-3"><a href="#estados" class="btn btn-primary btn-lg">Elegir estado</a><a href="/empresas/" class="btn btn-ghost btn-lg">Directorio nacional</a></div></div>
      <div class="lg:pl-16" style="border-left:1px solid var(--c-line)"><p class="text-sm leading-[1.9] mb-5" style="color:var(--c-text-2)">Explora empresas de equipo contra incendio y equipo para bomberos según la ubicación registrada en cada ficha.</p><p class="text-sm leading-[1.9]" style="color:var(--c-muted)">La presencia de una empresa en un estado no demuestra cobertura de entrega o servicio fuera de su ubicación. Confirma directamente alcance, disponibilidad y condiciones comerciales.</p></div>
    </div>
  </section>

  <QuickLinksBar />

  <section class="section-tight" style="background:var(--c-bg-alt)" aria-label="Cómo interpretar la cobertura del directorio"><div class="container-site"><div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px" style="background:var(--c-line);border:1px solid var(--c-line)">{criterios.map((criterio) => <article class="p-6" style="background:var(--c-bg-alt)"><h2 class="font-display font-bold text-sm uppercase tracking-wider mb-3" style="color:var(--c-ink)">{criterio.title}</h2><p class="text-xs leading-relaxed" style="color:var(--c-muted)">{criterio.text}</p></article>)}</div></div></section>

  <section id="estados" class="section" style="background:var(--c-bg)" aria-labelledby="estados-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12"><div><span class="section-eyebrow mb-4 inline-flex">Cobertura del directorio</span><h2 id="estados-title" class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(1.9rem,3.8vw,3rem);line-height:1.05">Directorio de empresas<br/><span style="color:var(--c-accent)">en cada entidad.</span></h2></div><p class="text-sm leading-relaxed" style="color:var(--c-text-2)">Las 32 entidades se organizan en {regionesPresentes.length} regiones editoriales. Entra a un estado para consultar giros, municipios y fichas disponibles.</p></div>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 list-none m-0 p-0" style="border-top:1px solid var(--c-line);border-left:1px solid var(--c-line)">{estados.map((estado) => <li style="border-bottom:1px solid var(--c-line);border-right:1px solid var(--c-line)"><a href={`/empresas/estado/${estado.slug}/`} class="grid-cell flex items-center justify-between gap-3 p-4 group"><span><span class="block font-display font-semibold text-sm group-hover:text-[var(--c-accent)]" style="color:var(--c-ink)">{estado.nombre}</span><span class="block text-[10px] uppercase tracking-wider mt-1" style="color:var(--c-muted)">{estado.region}</span></span><span aria-hidden="true" style="color:var(--c-accent)"></span></a></li>)}</ul>
    </div>
  </section>

  <section style="background:var(--c-accent);padding-block:4rem" aria-label="Registrar o corregir una empresa"><div class="container-site"><div class="flex flex-col lg:flex-row items-center justify-between gap-8"><div><p class="text-xs font-display font-bold uppercase tracking-[0.2em] mb-3" style="color:rgba(16,24,40,0.7)">Datos del directorio</p><h2 class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(1.75rem,3.5vw,2.5rem);line-height:1.1">¿Tu empresa no aparece o<br/>necesita una corrección?</h2></div><a href="/empresas/registro/" class="btn" style="background:#FFFFFF;color:var(--c-accent);font-weight:700">Registrar o corregir ficha</a></div></div></section>
</BaseLayout>
