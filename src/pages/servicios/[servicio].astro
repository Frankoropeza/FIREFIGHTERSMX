---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { services, type Service } from '@data/services';
import { SITE, whatsappUrl } from '@data/site';

export function getStaticPaths() {
  return services.map((service) => ({
    params: { servicio: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service: s } = Astro.props;
const canonicalURL = `${SITE.url}${s.href}`;

/* ─── JSON-LD: Service + BreadcrumbList + FAQPage ─────────── */

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${canonicalURL}#service`,
  name: s.title,
  description: s.description,
  url: canonicalURL,
  serviceType: s.title,
  provider: { '@id': `${SITE.url}/#store` },
  areaServed: { '@type': 'Country', name: 'México' },
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: `Alcances de ${s.title}`,
    itemListElement: s.items.map((item) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: item.name, description: item.detail },
    })),
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Servicios', item: `${SITE.url}/servicios` },
    { '@type': 'ListItem', position: 3, name: s.title, item: canonicalURL },
  ],
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: s.faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const otherServices = services.filter((x) => x.slug !== s.slug);
---

<BaseLayout
  title={`${s.title} — ${SITE.name} México`}
  description={s.description}
  canonicalURL={canonicalURL}
  schema={[serviceSchema, breadcrumbSchema, faqSchema]}
>
  <!-- Breadcrumb -->
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:#4A7599">
        <li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/servicios" class="hover:text-[#FF6B26]">Servicios</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:#94A3B8" aria-current="page">{s.title}</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background:#040A12;padding-block:4.5rem">
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" style="background:radial-gradient(ellipse 80% 70% at 90% 30%, rgba(247,80,0,0.08) 0%, transparent 65%)" aria-hidden="true"></div>
    <div class="container-site relative z-10">
      <span class="section-eyebrow mb-5 inline-flex">{s.norm}</span>
      <h1 class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2.5rem,6vw,4.5rem);line-height:0.95">
        {s.title}
      </h1>
      <div class="max-w-3xl flex flex-col gap-4">
        {s.intro.map((p) => (
          <p class="text-sm leading-[1.9]" style="color:#94A3B8">{p}</p>
        ))}
      </div>
      <div class="flex flex-col sm:flex-row gap-3 mt-8">
        <a
          href={whatsappUrl(`Hola, quiero cotizar el servicio de ${s.title.toLowerCase()}.`)}
          target="_blank" rel="noopener"
          class="btn btn-primary"
        >
          Cotizar este servicio
        </a>
        <a href="/servicios" class="btn btn-ghost">Ver todos los servicios</a>
      </div>
    </div>
  </section>

  <!-- Accesos rápidos (interlinking) -->
  <QuickLinksBar />

  <!-- Qué incluye -->
  <section class="section" style="background:#070E1A" aria-labelledby="incluye-title">
    <div class="container-site">
      <h2 id="incluye-title" class="font-display font-bold mb-8" style="color:#FFFFFF;font-size:clamp(1.5rem,2.5vw,2.25rem)">
        Qué incluye el servicio
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4" style="border-top:1px solid rgba(74,117,153,0.18);border-left:1px solid rgba(74,117,153,0.18)">
        {s.items.map((item) => (
          <div class="grid-cell flex flex-col gap-2 p-6" style="border-right:1px solid rgba(74,117,153,0.18);border-bottom:1px solid rgba(74,117,153,0.18)">
            <h3 class="font-display font-bold text-base" style="color:#FFFFFF">{item.name}</h3>
            <p class="text-xs leading-relaxed" style="color:#64748B">{item.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Detalle (subsecciones del spotlight) + imagen -->
  <section class="section" style="background:#040A12" aria-labelledby={`detalle-${s.slug}`}>
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <div>
          <span class="section-eyebrow mb-5 inline-flex">{s.norm}</span>
          <h2 id={`detalle-${s.slug}`} class="font-display font-bold mb-6" style="color:#FFFFFF;font-size:clamp(2rem,3.8vw,3rem);line-height:1.05">
            {s.spotlight.title}<br/>
            <span style="color:#F75000">{s.spotlight.highlight}</span>
          </h2>
          {s.spotlight.paragraphs.map((p) => (
            <p class="text-sm leading-[1.9] mb-4" style="color:#94A3B8">{p}</p>
          ))}
          <div class="flex flex-col mt-6" style="border-top:1px solid rgba(74,117,153,0.18)">
            {s.spotlight.subsections.map((sub) => (
              <div class="flex items-start gap-4 py-4" style="border-bottom:1px solid rgba(74,117,153,0.18)">
                <span class="w-1.5 h-1.5 mt-2 shrink-0" style="background:#F75000" aria-hidden="true"></span>
                <div>
                  <h3 class="font-display font-bold text-base leading-tight mb-1" style="color:#FFFFFF">{sub.name}</h3>
                  <p class="text-xs leading-relaxed m-0" style="color:#64748B">{sub.detail}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <figure class="relative m-0">
          <div class="relative overflow-hidden" style="border:1px solid rgba(74,117,153,0.25)">
            <img src={s.spotlight.image} alt={s.spotlight.imageAlt} width="640" height="720" loading="lazy" decoding="async" class="w-full h-auto block" />
            <div class="absolute top-0 left-0 w-12 h-12 pointer-events-none" style="border-top:3px solid #F75000;border-left:3px solid #F75000" aria-hidden="true"></div>
            <div class="absolute bottom-0 right-0 w-12 h-12 pointer-events-none" style="border-bottom:3px solid #F75000;border-right:3px solid #F75000" aria-hidden="true"></div>
          </div>
          <figcaption class="flex items-center justify-between gap-3 mt-3 text-[10px] font-display font-semibold uppercase tracking-widest" style="color:#4A7599">
            <span>{s.title}</span>
            <span style="color:#FF8F57">{s.norm}</span>
          </figcaption>
        </figure>

      </div>
    </div>
  </section>

  <!-- FAQ del servicio -->
  <section class="section" style="background:#070E1A" aria-labelledby="faq-servicio-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-start">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Preguntas frecuentes</span>
          <h2 id="faq-servicio-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
            Lo que más nos preguntan<br/>
            <span style="color:#F75000">sobre este servicio.</span>
          </h2>
          <p class="text-sm mt-4 leading-relaxed" style="color:#64748B">
            ¿Tu duda no aparece? Escríbenos por WhatsApp y un especialista te responde
            el mismo día hábil.
          </p>
          <a href={whatsappUrl(`Hola, tengo una duda sobre ${s.title.toLowerCase()}.`)} target="_blank" rel="noopener" class="btn btn-outline btn-sm mt-6">
            Preguntar por WhatsApp
          </a>
        </div>

        <div style="border:1px solid rgba(74,117,153,0.2);background:#0C1825">
          {s.faqs.map((faq) => (
            <details class="faq-item group" style="border-bottom:1px solid rgba(74,117,153,0.15)">
              <summary class="flex items-start justify-between gap-4 cursor-pointer select-none list-none p-6">
                <h3 class="font-display font-semibold pr-2 group-open:text-[#FF6B26] m-0" style="color:#FFFFFF;font-size:0.875rem;line-height:1.375">
                  {faq.q}
                </h3>
                <span class="faq-icon shrink-0 mt-0.5 w-5 h-5 flex items-center justify-center" style="border:1px solid rgba(74,117,153,0.3);color:#4A7599">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M12 5v14M5 12h14"/></svg>
                </span>
              </summary>
              <p class="px-6 pb-6 text-sm leading-relaxed" style="color:#64748B">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Otros servicios (internal linking) -->
  <section class="section-tight" style="background:#040A12" aria-labelledby="otros-title">
    <div class="container-site">
      <h2 id="otros-title" class="font-display font-bold text-sm uppercase tracking-widest mb-6" style="color:#4A7599">
        Otros servicios
      </h2>
      <div class="flex flex-wrap gap-3">
        {otherServices.map((x) => (
          <a href={x.href} class="btn btn-sm btn-dark">{x.title}</a>
        ))}
        <a href="/servicios" class="btn btn-sm btn-outline">Todos los servicios →</a>
      </div>
    </div>
  </section>
</BaseLayout>
