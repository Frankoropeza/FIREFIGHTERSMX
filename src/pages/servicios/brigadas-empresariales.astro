---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
---
<BaseLayout
  title="Brigadas Empresariales Contra Incendio con DC-3 — FIREFIGHTERS MX"
  description="Diseño, equipamiento y capacitación de brigadas contra incendio empresariales. NOM-002-STPS cumplimiento garantizado, constancia DC-3, protocolo de emergencias."
>
  <section class="bg-gradient-fire py-16">
    <div class="container-site text-center text-white">
      <h1 class="section-title text-white mb-4">Brigadas Empresariales</h1>
      <p class="section-subtitle text-fire-200 mx-auto">
        Armamos tu brigada contra incendio desde cero: diseño organizacional,
        equipamiento NOM, capacitación DC-3 y protocolos de emergencia.
      </p>
    </div>
  </section>
  <!-- Accesos rápidos (interlinking) -->
  <QuickLinksBar />

  <section class="section bg-white">
    <div class="container-site">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="section-title mb-6">Proceso de Implementación</h2>
          <div class="flex flex-col gap-5">
            {[
              { step: "01", title: "Diagnóstico", desc: "Evaluamos tu planta, riesgos, número de trabajadores y turnosdad para dimensionar la brigada." },
              { step: "02", title: "Diseño organizacional", desc: "Definimos la estructura: coordinador, jefes de brigada, brigadistas. Roles y turnos." },
              { step: "03", title: "Equipamiento", desc: "Proveemos todo el equipo NOM certificado: chalecos, cascos, extintores, kits de primeros auxilios." },
              { step: "04", title: "Capacitación DC-3", desc: "24-40 horas de formación teórico-práctica con constancia DC-3 STPS para cada brigadista." },
              { step: "05", title: "Simulacro y protocolo", desc: "Ejecutamos el primer simulacro, documentamos el Plan de Atención a Emergencias." },
              { step: "06", title: "Soporte continuo", desc: "Mantenemos el programa vigente: reentrenamiento anual, reposición de equipo, actualización normativa." },
            ].map((item) => (
              <div class="flex gap-4">
                <div class="text-2xl font-heading font-black text-fire-200 w-10 shrink-0 text-right">{item.step}</div>
                <div class="border-l-2 border-fire-100 pl-5">
                  <h3 class="font-bold text-dark-900 mb-1">{item.title}</h3>
                  <p class="text-dark-500 text-sm">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="card-fire p-8">
          <h3 class="font-heading font-bold text-xl text-dark-900 mb-6">Lo que incluye</h3>
          <ul class="flex flex-col gap-3">
            {[
              "Diagnóstico de planta sin costo",
              "Diseño del organigrama de la brigada",
              "Equipamiento completo NOM certificado",
              "Capacitación 24-40 horas",
              "Constancia DC-3 STPS por participante",
              "Plan de Atención a Emergencias (PAE)",
              "Primer simulacro documentado",
              "Manual de procedimientos de emergencia",
            ].map((item) => (
              <li class="flex items-start gap-3 text-sm text-dark-600">
                <svg class="w-4 h-4 text-fire-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
          <a href="/cotizacion" class="btn-primary btn-lg w-full justify-center mt-8">Cotizar brigada empresarial</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
