---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import Spotlight from '@components/common/Spotlight.astro';
import { services } from '@data/services';

/* Ancla de cada card: la keyword del servicio, no un «Ver servicio» genérico. */
const anclaServicio: Record<string, string> = {
  capacitacion: 'Capacitación de brigadas con DC-3',
  mantenimiento: 'Mantenimiento y recarga de extintores',
  'instalacion-sistemas-ci': 'Instalación de sistemas contra incendio',
  'auditoria-seguridad': 'Auditoría NOM-002-STPS',
  'brigadas-empresariales': 'Brigadas contra incendio empresariales',
  licitaciones: 'Soporte para licitaciones de equipo',
};
import { SITE, whatsappUrl, CANAL_CONTACTO } from '@config/site';

const canonicalURL = `${SITE.url}/servicios/`;

const seoMeta = {
  title: `Servicios Contra Incendio en México — ${SITE.name}`,
  description:
    'Servicios contra incendio en México: capacitación DC-3, mantenimiento y recarga, instalación de sistemas NFPA, auditoría NOM-002, brigadas y licitaciones.',
  canonicalURL,
};

/* ─── JSON-LD ──────────────────────────────────────────────── */

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Servicios', item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: 'Servicios profesionales de protección contra incendio',
  description: seoMeta.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: services.length,
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        name: s.title,
        description: s.shortDesc,
        url: `${SITE.url}${s.href}`,
        provider: { '@id': `${SITE.url}/#business` },
        areaServed: { '@type': 'Country', name: 'México' },
      },
    })),
  },
};

const trustPoints = [
  { title: 'Evidencia documental', text: 'DC-3, bitácoras, reportes y collares de garantía — todo listo para STPS y Protección Civil.' },
  { title: 'Personal certificado', text: 'Instructores con registro STPS y técnicos formados por fábrica en cada especialidad.' },
  { title: 'Un solo proveedor', text: 'Equipo + servicio + documentación sin coordinar a tres empresas para un mismo expediente.' },
  { title: 'Cobertura nacional', text: 'Servicio en sitio en los 32 estados; pólizas anuales con calendario y recordatorios.' },
];
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema]}>

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:var(--c-bg-alt);border-bottom:1px solid var(--c-line)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
        <li><a href="/" class="hover:text-[var(--c-accent)]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:var(--c-text-2)" aria-current="page">Servicios</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background:var(--c-bg);padding-block:5rem">

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <div>
          <span class="section-eyebrow mb-5 inline-flex">Servicios profesionales · NFPA y NOM</span>
          <h1 class="font-display font-bold mb-6" style="color:var(--c-ink);font-size:clamp(2.25rem,4.5vw,3.5rem);line-height:1.08">
            Servicios Contra<br/>
            <span style="color:var(--c-accent)">Incendio</span>
          </h1>
          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href={whatsappUrl('Hola, quiero cotizar un servicio contra incendio.')}
              target="_blank" rel="noopener"
              class="btn btn-primary btn-lg"
            >
              Cotizar por {CANAL_CONTACTO}
            </a>
            <a href="/cotizacion" class="btn btn-ghost btn-lg">Cotización formal</a>
          </div>
        </div>

        <div class="lg:pl-16" style="border-left:1px solid var(--c-line)">
          <p class="text-sm leading-[1.9] mb-5" style="color:var(--c-text-2)">
            Seis servicios para que tu operación cumpla la normativa y tu gente sepa responder:
            <strong style="color:var(--c-text)">capacitación con constancia DC-3 STPS, mantenimiento y recarga
            certificada, instalación de sistemas contra incendio NFPA 13/72, auditoría NOM-002-STPS,
            brigadas empresariales llave en mano y soporte técnico para licitaciones</strong>.
          </p>
          <p class="text-sm leading-[1.9] mb-6" style="color:var(--c-muted)">
            Cada servicio entrega la evidencia documental que pide la autoridad: constancias,
            bitácoras, reportes fotográficos, collares de garantía y memorias de cálculo.
            Personal certificado, cobertura en los 32 estados y un ejecutivo responsable de tu cuenta.
          </p>
          <div class="flex flex-wrap gap-2">
            {['DC-3 STPS','NOM-002-STPS','NFPA 1850','NFPA 13 · 72','NOM-154-SCFI','CompraNet'].map(n => (
            <span class="badge badge-dark font-display text-[10px]">{n}</span>
          ))}
          </div>
        </div>

      </div>
    </div>

  </section>

  <!-- Accesos rápidos (interlinking) -->
  <QuickLinksBar />

  <!-- Pilares -->
  <section class="section-tight" style="background:var(--c-bg-alt)" aria-label="Por qué nuestros servicios">
    <div class="container-site">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4" style="border:1px solid var(--c-line)">
        {trustPoints.map((t, i) => (
          <div class="flex flex-col gap-2 p-6" style={`background:var(--c-surface);${i < 3 ? 'border-right:1px solid var(--c-line);' : ''}`}>
            <h2 class="font-display font-bold text-sm" style="color:var(--c-accent)">{t.title}</h2>
            <p class="text-xs leading-relaxed" style="color:var(--c-muted)">{t.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Grid de servicios -->
  <section class="section" style="background:var(--c-bg)" aria-labelledby="servicios-title">
    <div class="container-site">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Servicios</span>
          <h2 id="servicios-title" class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
            Seis servicios,<br/>
            <span style="color:var(--c-accent)">un solo expediente.</span>
          </h2>
        </div>
        <div style="padding-left:1.75rem">
          <p class="text-sm leading-relaxed" style="color:var(--c-text-2)">
            Cada servicio tiene su propia página con alcances, entregables y preguntas frecuentes.
            Si tu necesidad cruza varios — equipar, capacitar y documentar a la vez —
            armamos un programa integral con un solo contrato y calendario.
          </p>
        </div>
      </div>

      <div class="card-grid">
        {services.map((s, i) => (
          <a href={s.href} class="service-card group relative flex flex-col overflow-hidden" style="background:#FFFFFF;border:1px solid var(--c-line);border-radius:var(--radius-card);box-shadow:var(--shadow-card)">

            <div class="flex flex-col flex-1 p-5 gap-3">
              <span class="text-[9px] font-display font-semibold uppercase tracking-widest" style="color:var(--forge-300)">{s.norm}</span>
              <h3 class="font-display font-bold text-lg leading-tight" style="color:var(--c-ink)">{s.title}</h3>
              <p class="text-xs leading-relaxed" style="color:var(--c-muted);flex:1">{s.shortDesc}</p>
              <ul class="flex flex-col gap-1.5 py-3 list-none m-0" style="border-top:1px solid var(--c-line);border-bottom:1px solid var(--c-line)">
                {s.items.slice(0, 3).map((item) => (
                  <li class="flex items-center gap-2 text-[11px]" style="color:var(--c-muted)">
                    <span class="w-1 h-1 rounded-full shrink-0" style={`background:${s.accent};opacity:0.7`} aria-hidden="true"></span>
                    {item.name}
                  </li>
                ))}
              </ul>
              <div class="pt-1">
                <span class="inline-flex items-center gap-2 w-full justify-center text-[0.8125rem] font-semibold py-2.5 px-4" style="color:var(--c-ink);background:#FFFFFF;border:1px solid var(--c-line-strong);border-radius:var(--radius-btn)">
                  {anclaServicio[s.slug] ?? s.title}
                  
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>

    </div>
  </section>

  <!-- Spotlights por servicio -->
  {services.map((s, i) => (
    <Spotlight
      id={s.slug}
      eyebrow={s.norm}
      title={s.spotlight.title}
      highlight={s.spotlight.highlight}
      paragraphs={s.spotlight.paragraphs}
      subsections={s.spotlight.subsections}
      image={s.spotlight.image}
      imageAlt={s.spotlight.imageAlt}
      href={s.href}
      ctaLabel={`Servicio de ${s.title.toLowerCase()}`}
      whatsappMsg={`Hola, quiero cotizar el servicio de ${s.title.toLowerCase()}.`}
      captionLeft={s.title}
      captionRight={s.norm}
      background={i % 2 === 0 ? '#F7F8FA' : '#FFFFFF'}
    />
  ))}

  <!-- Cómo trabajamos + cross-links -->
  <section class="section" style="background:var(--c-bg-alt)" aria-labelledby="como-trabajamos-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">

        <div>
          <span class="section-eyebrow mb-4 inline-flex">Cómo trabajamos</span>
          <h2 id="como-trabajamos-title" class="font-display font-bold mb-6" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
            De la necesidad al expediente<br/>
            <span style="color:var(--c-accent)">en tres pasos.</span>
          </h2>
          <ol class="flex flex-col gap-4 list-none m-0 p-0">
            {[
              { n: '01', t: 'Diagnóstico sin costo: visitamos tu instalación o revisamos tu requerimiento y te decimos qué aplica según norma.' },
              { n: '02', t: 'Propuesta con alcances, entregables, calendario y precio cerrado — en menos de 48 horas hábiles.' },
              { n: '03', t: 'Ejecutamos, documentamos y te entregamos la evidencia lista para STPS, Protección Civil o tu aseguradora.' },
            ].map((s) => (
              <li class="flex items-start gap-4">
                
                <p class="text-sm leading-relaxed m-0" style="color:var(--c-text-2)">{s.t}</p>
              </li>
            ))}
          </ol>
          <div class="flex flex-col sm:flex-row gap-3 mt-8">
            <a href={whatsappUrl('Hola, quiero un diagnóstico de servicios contra incendio.')} target="_blank" rel="noopener" class="btn btn-primary">
              Solicitar diagnóstico gratuito
            </a>
          </div>
        </div>

        <div class="lg:pl-16" style="border-left:1px solid var(--c-line)">
          <h2 class="font-display font-bold text-sm mb-5" style="color:var(--forge-300)">
            También te puede servir
          </h2>
          <ul class="flex flex-col list-none m-0 p-0" style="border-top:1px solid var(--c-line)">
            {[
              { label: 'Equipo para bomberos', desc: 'Equipo NFPA y NOM en 10 categorías', href: '/productos' },
              { label: 'Guía de normas y certificaciones', desc: 'Qué NOM y NFPA aplican según tu giro', href: '/certificaciones' },
              { label: 'Industrias que atendemos', desc: 'Soluciones por sector: bomberos, industria, PC', href: '/industrias' },
              { label: 'Blog técnico', desc: 'Guías de normativa, selección y mantenimiento', href: '/blog' },
              { label: 'Cobertura de servicio', desc: 'En sitio en los 32 estados', href: '/cobertura' },
              { label: 'Conoce la empresa', desc: 'Quiénes somos, cobertura y certificaciones', href: '/empresa' },
            ].map((l) => (
              <li style="border-bottom:1px solid var(--c-line)">
                <a href={l.href} class="group flex items-center justify-between gap-4 py-4">
                  <span class="flex flex-col gap-0.5">
                    <span class="font-display font-semibold text-sm group-hover:text-[var(--c-accent)]" style="color:var(--c-ink)">{l.label}</span>
                    <span class="text-xs" style="color:var(--c-muted)">{l.desc}</span>
                  </span>
                  
                </a>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .service-card:hover { border-color: var(--c-line-strong) !important; }
</style>
