---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import LineaCard from '@components/products/LineaCard.astro';
import L2Sidebar from '@components/l2/L2Sidebar.astro';
import L2Guia from '@components/l2/L2Guia.astro';
import L2Cotizar from '@components/l2/L2Cotizar.astro';
import { bloqueCategorias, bloqueMarcas, bloqueIndustrias, bloqueServicios, bloqueGuias, anchoFila, type L2Link } from '@lib/l2';
import { slugify } from '@lib/slug';
import '@styles/l2.css';
import { services } from '@data/services';

/* Ancla de cada card: la keyword del servicio, no un «Ver servicio» genérico. */
const anclaServicio: Record<string, string> = {
  capacitacion: 'Capacitación de brigadas con DC-3',
  mantenimiento: 'Mantenimiento y recarga de extintores',
  'instalacion-sistemas-ci': 'Instalación de sistemas contra incendio',
  'auditoria-seguridad': 'Auditoría NOM-002-STPS',
  'brigadas-empresariales': 'Brigadas contra incendio empresariales',
  licitaciones: 'Soporte para licitaciones de equipo',
};
import { SITE, whatsappUrl, CANAL_CONTACTO } from '@config/site';

const canonicalURL = `${SITE.url}/servicios/`;

const seoMeta = {
  title: 'Servicios contra incendio: capacitación DC-3 y mantenimiento',
  description:
    'Servicios contra incendio en México: capacitación DC-3, mantenimiento y recarga, instalación de sistemas NFPA, auditoría NOM-002, brigadas y licitaciones.',
  canonicalURL,
};

/* ─── JSON-LD ──────────────────────────────────────────────── */

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Servicios', item: canonicalURL },
  ],
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: 'Servicios profesionales de protección contra incendio',
  description: seoMeta.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: services.length,
    itemListElement: services.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Service',
        name: s.title,
        description: s.shortDesc,
        url: `${SITE.url}${s.href}`,
        provider: { '@id': `${SITE.url}/#business` },
        areaServed: { '@type': 'Country', name: 'México' },
      },
    })),
  },
};

/* ─── Plantilla L2 (homologada con /productos/, 2026-10) ────────── */
const secciones = [
  { id: 'servicios', label: 'Servicios' },
  { id: 'alcance', label: 'Alcance' },
  { id: 'como-trabajamos', label: 'Cómo trabajamos' },
];
const GUIAS_SERVICIOS: L2Link[] = [
  { label: 'Normas NFPA y NOM aplicables', href: '/certificaciones/' },
  { label: 'Guía NOM-002-STPS-2010', href: '/blog/nom-002-stps-guia-completa/' },
  { label: 'Expediente documental NOM-002: checklist', href: '/blog/expediente-documental-nom-002-stps-checklist/' },
  { label: 'NOM-002 vs DC-3 en la capacitación de brigadas', href: '/blog/nom-002-vs-dc3-capacitacion-brigadas/' },
  { label: 'Cómo documentar un simulacro de incendio', href: '/blog/simulacro-incendio-stps-como-documentarlo/' },
  { label: 'Cómo elegir un servicio de recarga de extintores', href: '/blog/elegir-servicio-de-recarga-de-extintores/' },
  { label: 'Licitaciones de equipo contra incendio', href: '/licitaciones/' },
];
const barra = (h: string) => (h.endsWith('/') ? h : `${h}/`);

const pasos = [
  'Diagnóstico sin costo: visitamos tu instalación o revisamos tu requerimiento y te decimos qué aplica según norma.',
  'Propuesta con alcances, entregables, calendario y precio cerrado — en menos de 48 horas hábiles.',
  'Ejecutamos, documentamos y te entregamos la evidencia lista para STPS, Protección Civil o tu aseguradora.',
];
const tambien = [
  { label: 'Equipo para bomberos', desc: 'Equipo NFPA y NOM en 10 categorías', href: '/productos' },
  { label: 'Guía de normas y certificaciones', desc: 'Qué NOM y NFPA aplican según tu giro', href: '/certificaciones' },
  { label: 'Industrias que atendemos', desc: 'Soluciones por sector: bomberos, industria, PC', href: '/industrias' },
  { label: 'Blog técnico', desc: 'Guías de normativa, selección y mantenimiento', href: '/blog' },
  { label: 'Cobertura de servicio', desc: 'En sitio en los 32 estados', href: '/cobertura' },
  { label: 'Conoce la empresa', desc: 'Quiénes somos, cobertura y certificaciones', href: '/empresa' },
];

const trustPoints = [
  { title: 'Evidencia documental', text: 'DC-3, bitácoras, reportes y collares de garantía — todo listo para STPS y Protección Civil.' },
  { title: 'Personal certificado', text: 'Instructores con registro STPS y técnicos formados por fábrica en cada especialidad.' },
  { title: 'Un solo proveedor', text: 'Equipo + servicio + documentación sin coordinar a tres empresas para un mismo expediente.' },
  { title: 'Cobertura nacional', text: 'Servicio en sitio en los 32 estados; pólizas anuales con calendario y recordatorios.' },
];
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema]}>

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:var(--c-bg-alt);border-bottom:1px solid var(--c-line)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
        <li><a href="/" class="hover:text-[var(--c-accent)]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:var(--c-text-2)" aria-current="page">Servicios</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background:var(--c-bg);padding-block:5rem">

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <div>
          <span class="section-eyebrow mb-5 inline-flex">Servicios profesionales · NFPA y NOM</span>
          <h1 class="font-display font-bold mb-6" style="color:var(--c-ink);font-size:clamp(2.25rem,4.5vw,3.5rem);line-height:1.08">
            Servicios Contra<br/>
            <span style="color:var(--c-accent)">Incendio</span>
          </h1>
          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href={whatsappUrl('Hola, quiero cotizar un servicio contra incendio.')}
              target="_blank" rel="noopener"
              class="btn btn-primary btn-lg"
            >
              Cotizar por {CANAL_CONTACTO}
            </a>
            <a href="/cotizacion" class="btn btn-ghost btn-lg">Cotización formal</a>
          </div>
        </div>

        <div class="lg:pl-16" style="border-left:1px solid var(--c-line)">
          <p class="text-sm leading-[1.9] mb-5" style="color:var(--c-text-2)">
            Seis servicios para que tu operación cumpla la normativa y tu gente sepa responder:
            <strong style="color:var(--c-text)">capacitación con constancia DC-3 STPS, mantenimiento y recarga
            certificada, instalación de sistemas contra incendio NFPA 13/72, auditoría NOM-002-STPS,
            brigadas empresariales llave en mano y soporte técnico para licitaciones</strong>.
          </p>
          <p class="text-sm leading-[1.9] mb-6" style="color:var(--c-muted)">
            Cada servicio entrega la evidencia documental que pide la autoridad: constancias,
            bitácoras, reportes fotográficos, collares de garantía y memorias de cálculo.
            Personal certificado, cobertura en los 32 estados y un ejecutivo responsable de tu cuenta.
          </p>
          <div class="flex flex-wrap gap-2">
            {['DC-3 STPS','NOM-002-STPS','NFPA 1850','NFPA 13 · 72','NOM-154-SCFI','CompraNet'].map(n => (
            <span class="badge badge-dark font-display text-2xs">{n}</span>
          ))}
          </div>
        </div>

      </div>
    </div>

  </section>

  <!-- Accesos rápidos (interlinking) -->
  <QuickLinksBar />

  <!-- Pilares -->
  <section class="section-tight" style="background:var(--c-bg-alt)" aria-labelledby="garantias-title">
    <div class="container-site">
      <h2 id="garantias-title" class="sr-only">Por qué nuestros servicios</h2>
      <div class="l2-trust">
        {trustPoints.map((t) => (
          <div><h3>{t.title}</h3><p>{t.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Plantilla L2: columna principal + barra lateral -->
  <div class="container-site l2-shell">
    <L2Sidebar
      resumen="Navegar los servicios"
      secciones={secciones}
      bloques={[bloqueServicios(), bloqueIndustrias(), bloqueCategorias(), bloqueGuias(GUIAS_SERVICIOS), bloqueMarcas()]}
      cotizar={{ titulo: 'Cotiza un servicio', texto: 'Diagnóstico sin costo y propuesta con alcances, entregables y calendario en menos de 48 horas hábiles.', msg: 'Hola, quiero cotizar un servicio contra incendio.' }}
    />

    <div class="l2-main">

      <!-- Servicios -->
      <section id="servicios" class="l2-sec" aria-labelledby="servicios-title">
        <header class="l2-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Servicios</span>
          <h2 id="servicios-title" class="l2-h2">Servicios contra incendio: seis servicios, un solo expediente</h2>
          <p class="l2-lead">
            Cada servicio tiene su propia página con alcances, entregables y preguntas frecuentes.
            Si tu necesidad cruza varios — equipar, capacitar y documentar a la vez —
            armamos un programa integral con un solo contrato y calendario.
          </p>
        </header>
        <ul class="l2-grid" role="list">
          {services.map((s, i) => {
            const base = barra(s.href);
            return (
              <li class={anchoFila(i, services.length) || undefined}>
                <LineaCard
                  href={base}
                  norma={s.norm}
                  titulo={s.title}
                  texto={s.shortDesc}
                  imagen={s.spotlight?.image ?? `/images/servicios/${s.slug}.avif`}
                  imagenAlt={s.spotlight?.imageAlt ?? s.title}
                  hijas={s.items.map((it) => ({ label: it.name, href: `${base}#incluye-${slugify(it.name)}` }))}
                  cta={anclaServicio[s.slug] ?? s.cta}
                  nivel="h3"
                  subLabel="Qué incluye"
                />
              </li>
            );
          })}
        </ul>
      </section>

      <!-- Alcance y entregables (antes: seis Spotlight a pantalla completa) -->
      <section id="alcance" class="l2-sec" aria-labelledby="alcance-title">
        <header class="l2-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Alcance y entregables</span>
          <h2 id="alcance-title" class="l2-h2">Qué incluye cada servicio contra incendio</h2>
          <p class="l2-lead">Entregables, evidencia documental y norma que respalda cada servicio.</p>
        </header>
        <div class="l2-guias">
          {services.map((s) => (
            <L2Guia
              id={s.slug}
              eyebrow={s.norm}
              title={s.spotlight.title}
              highlight={s.spotlight.highlight}
              paragraph={s.spotlight.paragraphs[0]}
              subsections={s.spotlight.subsections}
              image={s.spotlight.image}
              imageAlt={s.spotlight.imageAlt}
              cta={{ href: barra(s.href), label: `Servicio de ${s.title.toLowerCase()}` }}
              whatsappMsg={`Hola, quiero cotizar el servicio de ${s.title.toLowerCase()}.`}
            />
          ))}
        </div>
      </section>

      <!-- Cómo trabajamos + cross-links -->
      <L2Cotizar
        id="como-trabajamos"
        eyebrow="Cómo trabajamos"
        titulo="De la necesidad al expediente"
        destacado="en tres pasos."
        pasos={pasos}
        cta={{ label: 'Solicitar diagnóstico gratuito', msg: 'Hola, quiero un diagnóstico de servicios contra incendio.' }}
        tambien={tambien}
      />

    </div>
  </div>

</BaseLayout>
