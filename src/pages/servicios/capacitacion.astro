---
import BaseLayout from '@layouts/BaseLayout.astro';
---
<BaseLayout
  title="Capacitación para Bomberos NFPA y NOM-002 con DC-3 — FIREFIGHTERS MX"
  description="Cursos de capacitación para bomberos y brigadas contra incendio. NFPA 1001, NFPA 1041, NOM-002-STPS. Constancia DC-3 STPS incluida. México."
>
  <section class="bg-gradient-fire py-20">
    <div class="container-site text-center text-white">
      <h1 class="section-title text-white mb-6">Capacitación Certificada</h1>
      <p class="section-subtitle text-fire-200 mx-auto">
        Cursos NFPA, NOM-002 y DC-3 STPS para bomberos profesionales y brigadas empresariales.
        Instructores certificados con experiencia operativa.
      </p>
      <a href="/cotizacion" class="btn-gold btn-lg mt-8 inline-flex">Cotizar capacitación</a>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-site">
      <div class="grid lg:grid-cols-2 gap-12">
        <div>
          <h2 class="section-title mb-8">Cursos Disponibles</h2>
          <div class="flex flex-col gap-6">
            {[
              { code: "NFPA 1001", title: "Bombero Nivel I y II", desc: "Curso completo de combate estructural, uso de SCBA, rescate y primeros auxilios.", duration: "80 horas" },
              { code: "NFPA 1041", title: "Instructor de Bomberos", desc: "Formación de instructores para cuerpos municipales y estatales.", duration: "40 horas" },
              { code: "NOM-002", title: "Brigada Empresarial DC-3", desc: "Brigadas contra incendio conforme NOM-002-STPS con constancia DC-3.", duration: "24 horas" },
              { code: "NFPA 472", title: "Primer Respondiente HAZMAT", desc: "Respuesta a emergencias con materiales peligrosos, nivel operativo.", duration: "40 horas" },
              { code: "NFPA 1521", title: "Oficial de Seguridad de Incidente", desc: "Funciones del safety officer en el sistema de comando de incidentes.", duration: "16 horas" },
            ].map((course) => (
              <div class="flex gap-4 p-5 bg-dark-50 rounded-xl">
                <div class="shrink-0 text-center">
                  <div class="text-xs font-bold text-fire-700 bg-fire-50 rounded-lg px-2 py-1">{course.code}</div>
                </div>
                <div>
                  <h3 class="font-bold text-dark-900 mb-1">{course.title}</h3>
                  <p class="text-dark-500 text-sm mb-2">{course.desc}</p>
                  <span class="text-xs text-dark-400">⏱ {course.duration}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="flex flex-col gap-6">
          <div class="card-fire p-8">
            <h3 class="font-heading font-bold text-xl text-dark-900 mb-4">¿Por qué nuestra capacitación?</h3>
            <ul class="flex flex-col gap-3">
              {[
                "Instructores con experiencia en cuerpos de bomberos activos",
                "Prácticas con equipo real NFPA certificado",
                "Constancia DC-3 STPS — válida ante cualquier revisión IMSS/STPS",
                "Disponible en tus instalaciones o en nuestras sedes",
                "Grupos desde 10 participantes",
                "Material didáctico incluido (manuales NFPA en español)",
              ].map((item) => (
                <li class="flex items-start gap-3 text-sm text-dark-600">
                  <svg class="w-4 h-4 text-fire-600 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>
          <a href="/cotizacion" class="btn-primary btn-lg justify-center">Solicitar programa de capacitación</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
