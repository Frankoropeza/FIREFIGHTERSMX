---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { SITE, whatsappUrl, CONTACTO_DIRECTO_ACTIVO } from '@config/site';

const canonicalURL = `${SITE.url}/distribuidores/`;

const seoMeta = {
  title: `Cobertura y Envíos en los 32 Estados`,
  description:
    'Cobertura de FIREFIGHTERS MX en los 32 estados: envíos de equipo para bomberos a toda la República y coordinación de servicio en sitio.',
  canonicalURL,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Empresa', item: `${SITE.url}/empresa` },
    { '@type': 'ListItem', position: 3, name: 'Distribuidores', item: canonicalURL },
  ],
};

const ventajas = [
  { label: 'Garantía de fábrica', desc: 'Equipo original de las marcas líderes, con su garantía vigente', icon: `` },
  { label: 'Refacciones locales', desc: 'Disponibilidad de partes y servicio en tu región', icon: `` },
  { label: 'Precios institucionales', desc: 'Esquemas para gobierno, industria y volumen', icon: `` },
  { label: 'Cobertura completa', desc: 'Presencia y logística en los 32 estados', icon: `` },
];

const estados = [
  'Ciudad de México', 'Estado de México', 'Jalisco', 'Nuevo León',
  'Puebla', 'Querétaro', 'Guanajuato', 'Baja California',
  'Coahuila', 'Veracruz', 'Chihuahua', 'Sonora',
  'Tamaulipas', 'Sinaloa', 'San Luis Potosí', 'Michoacán',
  'Oaxaca', 'Chiapas', 'Yucatán', 'Quintana Roo',
];
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema]}>

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:var(--c-bg-alt);border-bottom:1px solid var(--c-line)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
        <li><a href="/" class="hover:text-[var(--c-accent)]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/empresa" class="hover:text-[var(--c-accent)]">Empresa</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:var(--c-text-2)" aria-current="page">Distribuidores</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background:var(--c-bg);padding-block:5rem">

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <span class="section-eyebrow mb-5 inline-flex">Cobertura · 32 estados</span>
          <h1 class="font-display font-bold mb-6" style="color:var(--c-ink);font-size:clamp(2.25rem,4.5vw,3.5rem);line-height:1.08">
            Cobertura<br/>
            <span style="color:var(--c-accent)">nacional</span>
          </h1>
          <div class="flex flex-col sm:flex-row gap-3">
            <a href={whatsappUrl('Hola, quiero saber cómo envían a mi ciudad.')} target="_blank" rel="noopener" class="btn btn-primary btn-lg">Consultar envío a mi estado</a>
            <a href="/cotizacion" class="btn btn-ghost btn-lg">Solicitar cotización de equipo contra incendio</a>
          </div>
        </div>
        <div class="lg:pl-16" style="border-left:1px solid var(--c-line)">
          <p class="text-sm leading-[1.9] mb-5" style="color:var(--c-text-2)">
            Enviamos equipo certificado a
            <strong style="color:var(--c-text)">los 32 estados de la República</strong>, con garantía de
            fábrica, refacciones originales y coordinación de servicio en sitio.
          </p>
          <p class="text-sm leading-[1.9] mb-6" style="color:var(--c-muted)">
            ¿Te interesa ser distribuidor o no encuentras tu estado? Enviamos a toda la República
            y evaluamos nuevas alianzas comerciales para acercar el equipo certificado a tu región.
          </p>
          <div class="flex flex-wrap gap-2">
            {['Garantía de fábrica','Refacciones','Servicio local','Precios institucionales'].map(n => (
            <span class="badge badge-dark font-display text-[10px]">{n}</span>
          ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Accesos rápidos -->
  <QuickLinksBar />

  <!-- Ventajas -->
  <section class="section-tight" style="background:var(--c-bg-alt)" aria-label="Ventajas de la red">
    <div class="container-site">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4" style="border:1px solid var(--c-line)">
        {ventajas.map((v, i) => (
          <div class="flex flex-col gap-3 p-6" style={`background:var(--c-surface);${i < 3 ? 'border-right:1px solid var(--c-line);' : ''}`}>
            <span class="block" style="width:24px;height:24px;color:var(--c-accent)" set:html={v.icon}/>
            <h2 class="font-display font-bold text-sm" style="color:var(--c-ink)">{v.label}</h2>
            <p class="text-xs leading-relaxed" style="color:var(--c-muted)">{v.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Estados con presencia -->
  <section class="section" style="background:var(--c-bg)" aria-labelledby="dist-estados-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Dónde estamos</span>
          <h2 id="dist-estados-title" class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
            Presencia<br/>
            <span style="color:var(--c-accent)">en todo México.</span>
          </h2>
        </div>
        <div style="padding-left:1.75rem">
          <p class="text-sm leading-relaxed" style="color:var(--c-text-2)">
            Estados a los que enviamos con mayor frecuencia. ¿No ves el tuyo?
            Enviamos a toda la República y coordinamos servicio en sitio donde lo necesites.
          </p>
        </div>
      </div>

      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 list-none m-0 p-0" style="border-top:1px solid var(--c-line);border-left:1px solid var(--c-line)">
        {estados.map((e) => (
          <li class="grid-cell flex items-center gap-3 p-4" style="border-bottom:1px solid var(--c-line);border-right:1px solid var(--c-line)">
            
            <span class="flex flex-col gap-0.5 min-w-0">
              <span class="font-display font-semibold text-sm" style="color:var(--c-ink)">{e}</span>
              <span class="text-xs" style="color:var(--c-muted)">Envíos y servicio</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- CTA + cross-links -->
  <section class="section" style="background:var(--c-bg-alt)" aria-labelledby="dist-cross-title">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">¿Quieres ser distribuidor?</span>
          <h2 id="dist-cross-title" class="font-display font-bold mb-6" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
            Hagamos equipo<br/>
            <span style="color:var(--c-accent)">en tu región.</span>
          </h2>
          <p class="text-sm leading-relaxed mb-8" style="color:var(--c-text-2)">
            Buscamos aliados comerciales que quieran llevar equipo certificado a su estado.
            Si te interesa distribuir o necesitas ubicar el punto más cercano, escríbenos.
          </p>
          <a href={whatsappUrl('Hola, me interesa ser distribuidor de VIGILES.')} target="_blank" rel="noopener" class="btn btn-primary">Quiero ser distribuidor</a>
        </div>
        <div class="lg:pl-16" style="border-left:1px solid var(--c-line)">
          <h2 class="font-display font-bold text-sm mb-5" style="color:var(--forge-300)">
            También te puede servir
          </h2>
          <ul class="flex flex-col list-none m-0 p-0" style="border-top:1px solid var(--c-line)">
            {[
              { label: 'Cobertura nacional', desc: 'Tiempos de entrega por estado', href: '/cobertura' },
              { label: 'Marcas que distribuimos', desc: 'Globe, MSA, Dräger, Holmatro y más', href: '/marcas' },
              { label: 'Equipo para bomberos', desc: 'Equipo certificado por categoría', href: '/productos' },
              { label: 'Contacto', desc: CONTACTO_DIRECTO_ACTIVO ? 'Teléfono, WhatsApp y correo' : 'Teléfono, correo y formulario de cotización', href: '/contacto' },
              { label: 'Volver a la empresa', desc: 'Visión general de VIGILES', href: '/empresa' },
            ].map((l) => (
              <li style="border-bottom:1px solid var(--c-line)">
                <a href={l.href} class="group flex items-center justify-between gap-4 py-4">
                  <span class="flex flex-col gap-0.5">
                    <span class="font-display font-semibold text-sm group-hover:text-[var(--c-accent)]" style="color:var(--c-ink)">{l.label}</span>
                    <span class="text-xs" style="color:var(--c-muted)">{l.desc}</span>
                  </span>
                  
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
