---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { estados } from '@data/estados';
import { SITE } from '@config/site';

const canonicalURL = `${SITE.url}/distribuidores/`;
const seoMeta = {
  title: 'Distribuidores de Equipo Contra Incendio en México',
  description: 'Guía para localizar y verificar distribuidores de equipo contra incendio en México. Consulta empresas por especialidad y estado en el directorio nacional.',
  canonicalURL,
};

const criterios = [
  { title: 'Identidad y ubicación', text: 'Confirma razón social, domicilio, medios de contacto y la entidad desde la que opera la empresa.' },
  { title: 'Relación con la marca', text: 'Si una autorización es indispensable, solicita evidencia vigente y comprueba su alcance directamente con el fabricante.' },
  { title: 'Producto exacto', text: 'Verifica modelo, configuración, accesorios, documentación y compatibilidad; una marca no acredita automáticamente todos sus productos.' },
  { title: 'Condiciones comerciales', text: 'Solicita por escrito precio, impuestos, entrega, garantía, devoluciones, instalación y servicio posterior.' },
];

const giros = [
  { label: 'Equipo para bomberos y EPP', href: '/empresas/venta-equipo/', text: 'Empresas relacionadas con protección personal, respiración, rescate y equipamiento operativo.' },
  { label: 'Equipo contra incendio', href: '/empresas/equipos-contra-incendio/', text: 'Empresas que aparecen en registros relacionados con suministro o servicio del sector.' },
  { label: 'Extintores', href: '/empresas/extintores/', text: 'Empresas relacionadas con venta, recarga, inspección o mantenimiento de extintores.' },
  { label: 'Sistemas contra incendio', href: '/empresas/sistemas-ci/', text: 'Empresas relacionadas con detección, alarma, redes, rociadores y supresión.' },
  { label: 'Capacitación', href: '/empresas/capacitacion/', text: 'Empresas y centros relacionados con capacitación y preparación de brigadas.' },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Distribuidores', item: canonicalURL },
  ],
};
const collectionSchema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': `${canonicalURL}#collection`,
  name: seoMeta.title, description: seoMeta.description, url: canonicalURL, inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
};
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema]} noBrandSuffix>
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site"><ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)"><li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li><li aria-hidden="true">/</li><li aria-current="page" style="color:#94A3B8">Distribuidores</li></ol></div>
  </nav>

  <section class="relative overflow-hidden" style="background:#040A12;padding-block:5rem">
    <div class="container-site relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
      <div>
        <span class="section-eyebrow mb-5 inline-flex">Directorio nacional · México</span>
        <h1 class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2.4rem,5.5vw,4.4rem);line-height:0.95">Distribuidores de<br/><span style="color:#F75000">equipo contra incendio.</span></h1>
        <div class="flex flex-col sm:flex-row gap-3"><a href="/empresas/" class="btn btn-primary btn-lg">Buscar empresas</a><a href="/productos/" class="btn btn-ghost btn-lg">Consultar equipos</a></div>
      </div>
      <div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,0.1)">
        <p class="text-sm leading-[1.9] mb-5" style="color:#94A3B8">Esta página ayuda a localizar empresas relacionadas con equipo contra incendio y equipo para bomberos por giro y estado.</p>
        <p class="text-sm leading-[1.9]" style="color:#64748B">FIREFIGHTERS MX no acredita que una empresa sea distribuidor autorizado. Confirma directamente con el fabricante y el proveedor cualquier autorización, disponibilidad, garantía o cobertura.</p>
      </div>
    </div>
  </section>

  <QuickLinksBar />

  <section class="section" style="background:#070E1A" aria-labelledby="criterios-title">
    <div class="container-site">
      <div class="max-w-3xl mb-10"><span class="section-eyebrow mb-4 inline-flex">Verificación</span><h2 id="criterios-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.9rem,3.8vw,3rem);line-height:1.05">Cómo verificar un<br/><span style="color:#F75000">distribuidor.</span></h2></div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px" style="background:rgba(74,117,153,0.18);border:1px solid rgba(74,117,153,0.18)">{criterios.map((c) => <article class="p-6" style="background:#080F1A"><h3 class="font-display font-bold text-base mb-3" style="color:#FFFFFF">{c.title}</h3><p class="text-xs leading-relaxed" style="color:#64748B">{c.text}</p></article>)}</div>
    </div>
  </section>

  <section class="section" style="background:#040A12" aria-labelledby="giros-title">
    <div class="container-site">
      <div class="max-w-3xl mb-10"><span class="section-eyebrow mb-4 inline-flex">Por especialidad</span><h2 id="giros-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.9rem,3.8vw,3rem);line-height:1.05">Empresas del sector<br/><span style="color:#F75000">por tipo de actividad.</span></h2></div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">{giros.map((g) => <a href={g.href} class="group flex flex-col p-7" style="background:#080F1A;border:1px solid rgba(74,117,153,0.18)"><h3 class="font-display font-bold text-lg mb-3 group-hover:text-[#FF6B26]" style="color:#FFFFFF">{g.label}</h3><p class="text-xs leading-relaxed mb-5 flex-1" style="color:#64748B">{g.text}</p><span class="text-xs font-display font-semibold uppercase tracking-wider" style="color:#FF8F57">Ver empresas →</span></a>)}</div>
    </div>
  </section>

  <section class="section" style="background:#070E1A" aria-labelledby="estados-title">
    <div class="container-site">
      <div class="max-w-3xl mb-10"><span class="section-eyebrow mb-4 inline-flex">32 entidades</span><h2 id="estados-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.9rem,3.8vw,3rem);line-height:1.05">Buscar empresas<br/><span style="color:#F75000">por estado.</span></h2></div>
      <ul class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 list-none m-0 p-0" style="border-top:1px solid rgba(74,117,153,0.18);border-left:1px solid rgba(74,117,153,0.18)">{estados.map((estado) => <li style="border-right:1px solid rgba(74,117,153,0.18);border-bottom:1px solid rgba(74,117,153,0.18)"><a href={`/empresas/estado/${estado.slug}/`} class="grid-cell flex items-center justify-between gap-3 p-4 group"><span class="font-display font-semibold text-sm group-hover:text-[#FF6B26]" style="color:#FFFFFF">{estado.nombre}</span><span aria-hidden="true" style="color:#FF8F57">→</span></a></li>)}</ul>
    </div>
  </section>
</BaseLayout>
