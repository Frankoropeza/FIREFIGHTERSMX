---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { brands } from '@data/brands';
import { brandPages } from '@data/brandPages';
import { featuredProducts } from '@data/products';
import { allCategories } from '@data/categories';
import { marcaDeBrand } from '@data/interlinking';
import { imagenLinea, lineaPorSlug } from '@lib/linea-card';
import LineaCard from '@components/products/LineaCard.astro';
import L2Sidebar from '@components/l2/L2Sidebar.astro';
import L2Cotizar from '@components/l2/L2Cotizar.astro';
import { bloqueCategorias, bloqueMarcas, bloqueIndustrias, bloqueServicios, bloqueGuias, anchoFila, type L2Link } from '@lib/l2';
import '@styles/l2.css';
import { SITE, whatsappUrl, CANAL_CONTACTO } from '@config/site';

const canonicalURL = `${SITE.url}/marcas/`;

const seoMeta = {
  title: 'Marcas de equipo para bomberos: MSA, Dräger, Scott y Globe',
  description:
    'Marcas de equipo para bomberos con distribución autorizada en México: MSA Safety, Dräger, 3M Scott, Globe, Holmatro, Bullard, Honeywell y más.',
  canonicalURL,
};

/* ─── Datos de la plantilla L2 (2026-10) ──────────────────────── */
const hrefMarca = (slug: string) => `/marcas/${slug}/`;
/* Categorías reales de cada marca (derivadas de sus modelos en el catálogo) */
const catsDe = (slug: string) => [...new Set(featuredProducts
  .filter((p) => marcaDeBrand(p.brand)?.href === hrefMarca(slug))
  .map((p) => p.href.split('/').filter(Boolean)[1])
  .filter((c): c is string => !!c && allCategories.some((x) => x.slug === c)))];
const modelosDe = (slug: string) => featuredProducts.filter((p) => marcaDeBrand(p.brand)?.href === hrefMarca(slug)).length;
const marcas = brands
  .map((b) => {
    const cats = catsDe(b.slug);
    const lineas = brandPages
      .filter((bp) => marcaDeBrand(bp.brand)?.href === hrefMarca(b.slug))
      .map((bp) => {
        /* «Bullard» a secas no dice qué línea es: se completa con la categoría. */
        const n = (x: string) => x.toLowerCase().replace(/[^a-z0-9]/g, '');
        const soloMarca = n(b.name).includes(n(bp.brandLabel));
        const cat = lineaPorSlug(bp.categorySlug)?.titulo ?? allCategories.find((x) => x.slug === bp.categorySlug)?.label ?? '';
        const catMin = cat.split(' ').map((w) => (/^[(]?[A-ZÁÉÍÓÚÑ0-9-]{2,}[)]?$/.test(w) ? w : w.toLowerCase())).join(' ');
        return { label: soloMarca && cat ? `${bp.brandLabel} en ${catMin}` : bp.brandLabel, href: `/productos/${bp.categorySlug}/${bp.slug}/` };
      });
    const hijas = [...lineas, ...cats.map((c) => ({ label: lineaPorSlug(c)?.titulo ?? allCategories.find((x) => x.slug === c)!.label, href: `/productos/${c}/` }))];
    return { ...b, cats, hijas, modelos: modelosDe(b.slug), imagen: cats.map((c) => imagenLinea(c)).find(Boolean) ?? null };
  })
  .sort((a, b) => b.modelos - a.modelos || a.name.localeCompare(b.name, 'es'));

/* Marcas por categoría: cada categoría con las marcas que tienen página propia */
const porCategoria = allCategories
  .map((c) => ({ c, marcas: marcas.filter((m) => m.cats.includes(c.slug)) }))
  .filter((x) => x.marcas.length > 0);

const secciones = [
  { id: 'marcas', label: 'Marcas' },
  { id: 'por-categoria', label: 'Por categoría' },
  { id: 'pedido-especial', label: 'Pedido especial' },
];
const GUIAS_MARCAS: L2Link[] = [
  { label: 'Mejores marcas de equipo para bomberos', href: '/blog/mejores-marcas-equipo-bomberos-mexico/' },
  { label: 'Cascos para bombero: comparativa de marcas', href: '/blog/cascos-bombero-comparativa-marcas-2026/' },
  { label: 'MSA G1 vs Dräger PSS 7000', href: '/blog/msa-g1-vs-drager-pss7000-scba/' },
  { label: 'FLIR vs MSA vs Bullard: cámaras térmicas', href: '/blog/flir-vs-msa-vs-bullard-camaras-termicas/' },
  { label: 'Holmatro, Hurst y Weber: herramientas de rescate', href: '/blog/herramientas-hidraulicas-rescate-holmatro-hurst-weber/' },
  { label: 'Botas de bombero: HAIX, Lion Apparel y Jolly', href: '/blog/botas-bombero-comparativa-haix-lion-apparel-jolly/' },
  { label: 'Normas NFPA y NOM aplicables', href: '/certificaciones/' },
];
const tambien = [
  { label: 'Equipo para bomberos', desc: 'Catálogo NFPA y NOM por categoría', href: '/productos/' },
  { label: 'Servicios profesionales', desc: 'Mantenimiento, capacitación e instalación', href: '/servicios/' },
  { label: 'Guía de normas y certificaciones', desc: 'Qué NOM y NFPA aplican según tu giro', href: '/certificaciones/' },
  { label: 'Soporte para licitaciones', desc: 'Cartas de fabricante y fichas técnicas', href: '/licitaciones/' },
  { label: 'Cobertura nacional', desc: 'Entrega en los 32 estados', href: '/cobertura/' },
];

/* ─── JSON-LD ──────────────────────────────────────────────── */
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Marcas', item: canonicalURL },
  ],
};

/* CollectionPage + ItemList de fabricantes (antes la página sólo tenía BreadcrumbList) */
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${canonicalURL}#collection`,
  name: 'Marcas de equipo para bomberos y contra incendio',
  description: seoMeta.description,
  url: canonicalURL,
  inLanguage: 'es-MX',
  isPartOf: { '@id': `${SITE.url}/#website` },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: marcas.length,
    itemListElement: marcas.map((m, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: { '@type': 'Brand', name: m.name, url: `${SITE.url}${hrefMarca(m.slug)}` },
    })),
  },
};
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, collectionSchema]}>

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:var(--c-bg-alt);border-bottom:1px solid var(--c-line)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
        <li><a href="/" class="hover:text-[var(--c-accent)]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:var(--c-text-2)" aria-current="page">Marcas</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background:var(--c-bg);padding-block:5rem">

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <div>
          <span class="section-eyebrow mb-5 inline-flex">Distribuidores autorizados</span>
          <h1 class="font-display font-bold mb-6" style="color:var(--c-ink);font-size:clamp(2.25rem,4.5vw,3.5rem);line-height:1.08">
            Marcas que<br/>
            <span style="color:var(--c-accent)">Distribuimos</span>
          </h1>
          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href={whatsappUrl('Hola, quiero información sobre las marcas que distribuyen.')}
              target="_blank" rel="noopener"
              class="btn btn-primary btn-lg"
            >
              Consultar por {CANAL_CONTACTO}
            </a>
            <a href="/cotizacion" class="btn btn-ghost btn-lg">Solicitar cotización de equipo contra incendio</a>
          </div>
        </div>

        <div class="lg:pl-16" style="border-left:1px solid var(--c-line)">
          <p class="text-sm leading-[1.9] mb-5" style="color:var(--c-text-2)">
            Distribuidores autorizados de <strong style="color:var(--c-text)">fabricantes internacionales
            a nivel mundial en equipos de protección personal y sistemas contra incendio</strong>:
            MSA Safety, Dräger, 3M Scott, Globe Manufacturing, Holmatro, Bullard, Honeywell y más.
          </p>
          <p class="text-sm leading-[1.9] mb-6" style="color:var(--c-muted)">
            Cada equipo se entrega con número de serie verificable, certificado de laboratorio
            acreditado y ficha técnica lista para licitación, auditoría STPS o expediente de
            Protección Civil — bajo las normas NFPA 1970 (antes 1971) y NOM aplicables.
          </p>
          <div class="flex flex-wrap gap-2">
            {['MSA','Dräger','3M Scott','Globe','Holmatro','NFPA 1970'].map(n => (
            <span class="badge badge-dark font-display text-[10px]">{n}</span>
          ))}
          </div>
        </div>

      </div>
    </div>

  </section>

  <!-- Accesos rápidos (interlinking) -->
  <QuickLinksBar />

  <!-- Plantilla L2: columna principal + barra lateral -->
  <div class="container-site l2-shell">
    <L2Sidebar
      resumen="Navegar las marcas"
      secciones={secciones}
      bloques={[bloqueMarcas(), bloqueCategorias(), bloqueServicios(), bloqueIndustrias(), bloqueGuias(GUIAS_MARCAS, 'Comparativas y normas')]}
      cotizar={{ titulo: 'Cotiza por marca', texto: 'Dinos la marca y el modelo, o la especificación técnica que necesitas cumplir.', msg: 'Hola, quiero información sobre las marcas que distribuyen.' }}
    />

    <div class="l2-main">

      <!-- Marcas -->
      <section id="marcas" class="l2-sec" aria-labelledby="marcas-title">
        <header class="l2-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Fabricantes</span>
          <h2 id="marcas-title" class="l2-h2">Marcas de equipo para bomberos: líderes con respaldo de fábrica</h2>
          <p class="l2-lead">
            Trabajamos directo con fabricantes del sector para garantizar
            equipo original, repuestos verificables y soporte técnico.
          </p>
        </header>
        <ul class="l2-grid" role="list">
          {marcas.map((m, i) => (
            <li class={anchoFila(i, marcas.length) || undefined}>
              <LineaCard
                href={hrefMarca(m.slug)}
                norma={[m.country, ...m.norms.slice(0, 1)].filter(Boolean).join(' · ')}
                titulo={m.name}
                texto={m.description}
                imagen={m.imagen}
                imagenAlt={`Equipo ${m.name} para bomberos y contra incendio`}
                hijas={m.hijas}
                cta={`Equipo ${m.name}`}
                nivel="h3"
                subLabel="Líneas y categorías"
              />
            </li>
          ))}
        </ul>
      </section>

      <!-- Marcas por categoría -->
      <section id="por-categoria" class="l2-sec" aria-labelledby="por-categoria-title">
        <header class="l2-sec-head">
          <span class="section-eyebrow mb-4 inline-flex">Marcas por categoría</span>
          <h2 id="por-categoria-title" class="l2-h2">Qué marcas encuentras en cada categoría de equipo</h2>
          <p class="l2-lead">Fabricantes con ficha en el catálogo, agrupados por la categoría de equipo contra incendio que surten.</p>
        </header>
        <ul class="mc-list" role="list">
          {porCategoria.map(({ c, marcas: ms }) => (
            <li class="mc-row">
              <a href={`/productos/${c.slug}/`} class="mc-cat">{lineaPorSlug(c.slug)?.titulo ?? c.label}</a>
              <ul class="mc-brands" role="list">
                {ms.map((m) => <li><a href={hrefMarca(m.slug)} class="mc-brand">{m.name}</a></li>)}
              </ul>
            </li>
          ))}
        </ul>
      </section>

      <!-- Pedido especial + cross-links -->
      <L2Cotizar
        id="pedido-especial"
        eyebrow="Pedido especial"
        titulo="¿Buscas una marca"
        destacado="que no aparece?"
        texto="Si no encuentras una marca específica, la conseguimos: manejamos pedidos especiales sobre especificación técnica."
        cta={{ label: `Consultar por ${CANAL_CONTACTO}`, msg: 'Hola, busco una marca de equipo contra incendio que no aparece en su sitio.' }}
        tambien={tambien}
      />

    </div>
  </div>

</BaseLayout>

<style>
  .mc-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--c-line); }
  .mc-row { display: grid; gap: .5rem; padding: 1rem 0; border-bottom: 1px solid var(--c-line); }
  @media (min-width: 768px) { .mc-row { grid-template-columns: 16rem minmax(0, 1fr); gap: 1.5rem; align-items: baseline; } }
  .mc-cat { font-family: var(--font-display); font-size: .9375rem; font-weight: 600; color: var(--c-ink); text-decoration: none; transition: color .15s; }
  .mc-cat:hover, .mc-cat:focus-visible { color: var(--c-accent); }
  .mc-brands { display: flex; flex-wrap: wrap; gap: .375rem .5rem; margin: 0; padding: 0; list-style: none; }
  .mc-brand { display: inline-flex; align-items: center; min-height: 2rem; padding: .25rem .75rem; font-size: .8125rem; font-weight: 500; color: var(--c-ink-2); text-decoration: none; background: var(--c-bg-alt); border: 1px solid var(--c-line); border-radius: var(--radius-btn); transition: color .15s, border-color .15s, background-color .15s; }
  .mc-brand:hover, .mc-brand:focus-visible { color: var(--c-accent); border-color: var(--c-accent); background: var(--c-surface); }
</style>
