---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { brands } from '@data/brands';
import { SITE, whatsappUrl } from '@config/site';

const canonicalURL = `${SITE.url}/marcas/`;

const seoMeta = {
  title: `Marcas y Fabricantes de Equipo para Bomberos — FIREFIGHTERS MX`,
  description:
    'Guía de marcas y fabricantes de equipo para bomberos y sistemas contra incendio. Compara categorías, normas y fichas antes de contactar a una empresa.',
  canonicalURL,
};

/* ─── JSON-LD ──────────────────────────────────────────────── */
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Marcas', item: canonicalURL },
  ],
};
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema]}>

  <!-- Breadcrumb -->
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb">
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
        <li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:#94A3B8" aria-current="page">Marcas</span></li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative overflow-hidden" style="background:#040A12;padding-block:5rem">
    <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" style="background:radial-gradient(ellipse 80% 70% at 90% 30%, rgba(247,80,0,0.08) 0%, transparent 65%)" aria-hidden="true"></div>

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        <div>
          <span class="section-eyebrow mb-5 inline-flex">Fabricantes de referencia</span>
          <h1 class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2.5rem,5.5vw,4.5rem);line-height:0.95">
            Marcas y<br/>
            <span style="color:#F75000">fabricantes</span>
          </h1>
          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href={whatsappUrl('Hola, quiero información sobre una marca o fabricante del directorio.')}
              target="_blank" rel="noopener"
              class="btn btn-primary btn-lg"
            >
              Consultar por correo
            </a>
            <a href="/empresas/" class="btn btn-ghost btn-lg">Buscar empresas relacionadas</a>
          </div>
        </div>

        <div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,0.1)">
          <p class="text-sm leading-[1.9] mb-5" style="color:#94A3B8">
            Esta guía reúne <strong style="color:#CBD5E1">fabricantes y marcas mencionados
            en las categorías editoriales del sector</strong>:
            MSA Safety, Dräger, 3M Scott, Globe Manufacturing, Holmatro, Bullard, Honeywell y más.
          </p>
          <p class="text-sm leading-[1.9] mb-6" style="color:#64748B">
            La presencia de una marca no implica distribución, autorización, certificación
            ni disponibilidad por parte de FIREFIGHTERS MX. Confirma directamente con cada
            empresa del directorio el alcance comercial y la documentación vigente.
          </p>
          <div class="flex flex-wrap gap-2">
            {['MSA','Dräger','3M Scott','Globe','Holmatro','NFPA 1970'].map(n => (
              <span class="badge badge-dark font-display text-[10px]">{n}</span>
            ))}
          </div>
        </div>

      </div>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-px" style="background:linear-gradient(90deg, transparent, rgba(247,80,0,0.4) 30%, rgba(247,80,0,0.4) 70%, transparent)" aria-hidden="true"></div>
  </section>

  <!-- Accesos rápidos (interlinking) -->
  <QuickLinksBar />

  <!-- Marcas -->
  <section class="section" style="background:#040A12" aria-labelledby="marcas-title">
    <div class="container-site">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Fabricantes</span>
          <h2 id="marcas-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
            Marcas para comparar,<br/>
            <span style="color:#F75000">fuentes que revisar.</span>
          </h2>
        </div>
        <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed" style="color:#94A3B8">
            Usa esta sección para identificar fabricantes, categorías y normas de referencia.
            Antes de tomar una decisión, revisa la ficha técnica del producto y confirma con
            la empresa proveedora la representación, cobertura, disponibilidad y soporte.
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px" style="background:rgba(74,117,153,0.18);border:1px solid rgba(74,117,153,0.18)">
        {brands.map((brand) => {
          const monogram = brand.name.replace(/[^A-Za-z0-9]/g, '').charAt(0).toUpperCase();
          const country = brand.country?.replace(/[\u{1F1E6}-\u{1F1FF}]/gu, '').trim();
          return (
            <a
              href={`/marcas/${brand.slug}`}
              class="grid-cell flex items-start gap-4 p-6 group"
              style="text-decoration:none"
            >
              <span
                class="flex items-center justify-center rounded-full shrink-0 font-display font-bold"
                style="width:48px;height:48px;background:rgba(247,80,0,0.1);border:1.5px solid rgba(247,80,0,0.35);color:#FF6B26;font-size:1.25rem"
              >
                {monogram}
              </span>
              <div>
                <h3
                  class="font-display font-bold mb-1 group-hover:text-[#FF6B26]"
                  style="color:#FFFFFF"
                >
                  {brand.name}
                </h3>
                <p class="text-sm leading-relaxed mb-2" style="color:#64748B">
                  {brand.description}
                </p>
                <div class="flex items-center gap-2 flex-wrap">
                  {country && <span class="badge badge-dark">{country}</span>}
                  <span class="text-[10px] font-display" style="color:var(--forge-300)">
                    Ver productos →
                  </span>
                </div>
              </div>
            </a>
          );
        })}
      </div>

    </div>
  </section>

</BaseLayout>
