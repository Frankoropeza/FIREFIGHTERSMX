---
// /marcas/[marca].astro — Landing individual por marca
// =====================================================================
// Genera una URL propia para cada fabricante que distribuimos:
//   /marcas/msa-safety, /marcas/globe-manufacturing, etc.
//
// Propósito SEO:
//   • Captura búsquedas de marca + México: "MSA G1 SCBA México",
//     "Globe GX-7 traje bombero", "Bullard USTM distribuidor México"
//   • Schema Organization del fabricante + ItemList de productos
//   • Breadcrumb para navegación y schema
//
// Los datos vienen 100% de src/data/brands.ts — sin hardcodear nada aquí.
// =====================================================================
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { brands } from '@data/brands';
import { SITE, whatsappUrl } from '@config/site';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => {
  return brands.map((brand) => ({
    params: { marca: brand.slug },
    props: { brand },
  }));
}) satisfies GetStaticPaths;

const { brand } = Astro.props;
const canonicalURL = `${SITE.url}/marcas/${brand.slug}/`;

// ── SEO: title (≤60c) y description (≤160c) keyword-first ───────────
// Patrón: "[Marca] en México | Distribuidor autorizado | FIREFIGHTERS MX"
const seoTitle = `${brand.name} en México | Distribuidor autorizado FFMX`;
const seoDescription = [
  brand.description,
  `Distribuidor autorizado ${brand.name} en México.`,
  `Cotización en 24 h.`,
].join(' ').slice(0, 160);

// ── JSON-LD ───────────────────────────────────────────────────────────

// Breadcrumb
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio',  item: `${SITE.url}/`       },
    { '@type': 'ListItem', position: 2, name: 'Marcas',  item: `${SITE.url}/marcas` },
    { '@type': 'ListItem', position: 3, name: brand.name, item: canonicalURL         },
  ],
};

// Organización del fabricante (no confundir con FIREFIGHTERS MX)
const manufacturerSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${canonicalURL}/#manufacturer`,
  name: brand.name,
  description: brand.description,
  ...(brand.website ? { url: brand.website } : {}),
};

// Productos que distribuimos de esta marca
const productListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `Productos ${brand.name} distribuidos por FIREFIGHTERS MX`,
  numberOfItems: brand.products.length,
  itemListElement: brand.products.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: p.name,
      description: p.detail,
      brand: { '@type': 'Brand', name: brand.name },
      offers: {
        '@type': 'Offer',
        availability: 'https://schema.org/InStock',
        areaServed: { '@type': 'Country', name: 'México' },
        seller: { '@type': 'Store', name: SITE.name, url: SITE.url },
      },
    },
  })),
};

const schemas = [breadcrumbSchema, manufacturerSchema, productListSchema];

// ── WA message ────────────────────────────────────────────────────────
const waMsg = `Hola, quiero información sobre productos ${brand.name} que distribuyen.`;
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonicalURL={canonicalURL}
  schema={schemas}
>

  {/* ─── Breadcrumb ─── */}
  <nav
    class="py-3"
    style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)"
    aria-label="Breadcrumb"
  >
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:#4A7599">
        <li><a href="/"        class="hover:text-[#FF6B26] transition-colors">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/marcas"  class="hover:text-[#FF6B26] transition-colors">Marcas</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:#94A3B8" aria-current="page">{brand.name}</span></li>
      </ol>
    </div>
  </nav>

  {/* ─── Hero de la marca ─── */}
  <section
    class="relative overflow-hidden"
    style="background:#040A12;padding-block:5rem"
    aria-labelledby="marca-heading"
  >
    {/* Glow decorativo */}
    <div
      class="absolute top-0 right-0 w-1/2 h-full pointer-events-none"
      style="background:radial-gradient(ellipse 80% 70% at 90% 30%, rgba(247,80,0,0.07) 0%, transparent 65%)"
      aria-hidden="true"
    ></div>

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        {/* Col izquierda — identidad + CTAs */}
        <div>
          <span class="section-eyebrow mb-5 inline-flex">Distribuidor autorizado</span>

          {/* Monograma visual de la marca */}
          <div
            class="flex items-center justify-center rounded-2xl mb-6 font-display font-bold"
            style="width:80px;height:80px;background:rgba(247,80,0,0.1);border:2px solid rgba(247,80,0,0.35);color:#FF6B26;font-size:2.5rem"
            aria-hidden="true"
          >
            {brand.name.replace(/[^A-Za-z0-9]/g, '').charAt(0).toUpperCase()}
          </div>

          <h1
            id="marca-heading"
            class="font-display font-bold uppercase mb-3"
            style="color:#FFFFFF;font-size:clamp(2.2rem,5vw,4rem);line-height:0.95"
          >
            {brand.name}
          </h1>

          {brand.country && (
            <p class="text-sm mb-6" style="color:#4A7599">{brand.country}</p>
          )}

          {/* Badges de normas */}
          <div class="flex flex-wrap gap-2 mb-8">
            {brand.norms.map((n) => (
              <span class="badge badge-dark font-display text-[10px]">{n}</span>
            ))}
          </div>

          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href={whatsappUrl(waMsg)}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary btn-lg"
            >
              Cotizar por WhatsApp
            </a>
            <a href="/cotizacion" class="btn btn-ghost btn-lg">Solicitar cotización</a>
          </div>
        </div>

        {/* Col derecha — descripción larga */}
        <div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,0.1)">
          {brand.longDesc.map((para) => (
            <p class="text-sm leading-[1.9] mb-4 last:mb-0" style="color:#94A3B8">{para}</p>
          ))}
        </div>

      </div>
    </div>

    <div
      class="absolute bottom-0 left-0 right-0 h-px"
      style="background:linear-gradient(90deg, transparent, rgba(247,80,0,0.4) 30%, rgba(247,80,0,0.4) 70%, transparent)"
      aria-hidden="true"
    ></div>
  </section>

  {/* ─── Accesos rápidos ─── */}
  <QuickLinksBar />

  {/* ─── Productos que distribuimos ─── */}
  <section
    class="section"
    style="background:#040A12"
    aria-labelledby="productos-heading"
  >
    <div class="container-site">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
        <div>
          <span class="section-eyebrow mb-4 inline-flex">Catálogo</span>
          <h2
            id="productos-heading"
            class="font-display font-bold"
            style="color:#FFFFFF;font-size:clamp(1.8rem,3.5vw,2.8rem);line-height:1.05"
          >
            Productos <span style="color:#F75000">{brand.name}</span><br/>
            que distribuimos
          </h2>
        </div>
        <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
          <p class="text-sm leading-relaxed" style="color:#94A3B8">
            Cada equipo se entrega con número de serie verificable, certificado de laboratorio
            acreditado y carta de fabricante — listo para licitación CompraNet, auditoría STPS
            y expediente de Protección Civil.
          </p>
        </div>
      </div>

      {/* Grid de productos */}
      <div
        class="grid grid-cols-1 sm:grid-cols-2 gap-px"
        style="background:rgba(74,117,153,0.18);border:1px solid rgba(74,117,153,0.18)"
      >
        {brand.products.map((product, i) => (
          <div class="grid-cell p-6">
            <div class="flex items-start gap-4">
              {/* Número de orden */}
              <span
                class="shrink-0 font-display font-bold text-xs"
                style="color:#F75000;min-width:1.5rem"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3
                  class="font-display font-bold mb-2"
                  style="color:#FFFFFF;font-size:1rem"
                >
                  {product.name}
                </h3>
                <p class="text-sm leading-relaxed" style="color:#64748B">
                  {product.detail}
                </p>
              </div>
            </div>
          </div>
        ))}
      </div>

      {/* CTA bajo el grid */}
      <div class="mt-8 text-center">
        <p class="text-sm mb-4" style="color:#64748B">
          ¿Buscas un modelo específico? Lo conseguimos: manejamos pedidos sobre especificación técnica.
        </p>
        <a
          href={whatsappUrl(waMsg)}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          Consultar disponibilidad por WhatsApp
        </a>
      </div>

    </div>
  </section>

  {/* ─── Respaldo normativo ─── */}
  {brand.norms.length > 0 && (
    <section
      class="section"
      style="background:#070E1A"
      aria-labelledby="normas-heading"
    >
      <div class="container-site">
        <span class="section-eyebrow mb-4 inline-flex">Certificaciones</span>
        <h2
          id="normas-heading"
          class="font-display font-bold mb-8"
          style="color:#FFFFFF;font-size:clamp(1.6rem,3vw,2.4rem)"
        >
          Normas y certificaciones que<br/>
          <span style="color:#F75000">respaldan esta marca</span>
        </h2>

        <div class="flex flex-wrap gap-3 mb-8">
          {brand.norms.map((norm) => (
            <span
              class="inline-flex items-center gap-2 px-4 py-2 rounded font-display font-bold text-xs"
              style="background:rgba(247,80,0,0.08);border:1px solid rgba(247,80,0,0.3);color:#FF6B26"
            >
              ✓ {norm}
            </span>
          ))}
        </div>

        <p class="text-sm max-w-2xl" style="color:#64748B">
          Cada equipo {brand.name} que entregamos lleva certificado de laboratorio
          acreditado, número de serie verificable y ficha técnica — la documentación que
          el área de compras, el órgano fiscalizador y tu aseguradora pueden auditar.
        </p>
      </div>
    </section>
  )}

  {/* ─── CTA de cierre ─── */}
  <section
    class="section"
    style="background:#040A12;border-top:1px solid rgba(74,117,153,0.12)"
  >
    <div class="container-site text-center">
      <span class="section-eyebrow mb-4 inline-flex">Siguiente paso</span>
      <h2
        class="font-display font-bold mb-4"
        style="color:#FFFFFF;font-size:clamp(1.8rem,3.5vw,2.8rem)"
      >
        ¿Necesitas <span style="color:#F75000">equipo {brand.name}</span>?
      </h2>
      <p class="text-sm mb-8 max-w-xl mx-auto" style="color:#94A3B8">
        Cuéntanos qué necesitas — modelo, cantidad y destino — y te respondemos
        con disponibilidad, precio y tiempos de entrega en menos de 24 horas.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={whatsappUrl(waMsg)}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary btn-lg"
        >
          Cotizar {brand.name} por WhatsApp
        </a>
        <a href="/cotizacion" class="btn btn-ghost btn-lg">
          Formulario de cotización
        </a>
        <a href="/marcas" class="btn btn-ghost btn-lg">
          Ver todas las marcas
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
