---
// /cobertura/[estado].astro — Landing individual SEO por estado
// =====================================================================
// Genera una URL propia para cada estado de cobertura:
//   /cobertura/ciudad-de-mexico, /cobertura/jalisco, etc.
//
// Propósito SEO:
//   • Captura búsquedas geo-específicas: "equipo bomberos Jalisco",
//     "brigadas industriales Nuevo León NFPA", "extintores CDMX"
//   • LocalBusiness schema con areaServed por estado
//   • Breadcrumb + FAQPage del estado
// =====================================================================
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { estados } from '@data/cobertura';
import { estados as estadosMeta } from '@data/estados';
import { empresasPorEstado } from '@lib/empresas';
import { estadoConEstaciones } from '@lib/estaciones';
import { vecinosEnAnillo } from '@lib/enlazado';
import { SITE, CONTACTO_DIRECTO_ACTIVO, whatsappUrl } from '@config/site';
import RelatedLinks from '@components/common/RelatedLinks.astro';
import { giros } from '@data/giros';
import { ANCLA_GIRO } from '@lib/enlaces-directorio';
import { lineaPorSlug } from '@lib/linea-card';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths = (() => {
  return estados.map((estado) => ({
    params: { estado: estado.slug },
    props: { estado },
  }));
}) satisfies GetStaticPaths;

const { estado } = Astro.props;
const canonicalURL = `${SITE.url}/cobertura/${estado.slug}/`;
const metaEstado = estadosMeta.find((e) => e.slug === estado.slug);
const indiceCobertura = estados.findIndex((e) => e.slug === estado.slug);
const mismaRegion = metaEstado
  ? estados.filter((e) => e.slug !== estado.slug && estadosMeta.find((m) => m.slug === e.slug)?.region === metaEstado.region)
  : [];
const otrosEstados = [...mismaRegion];
for (const candidato of vecinosEnAnillo(estados, indiceCobertura, 6)) {
  if (!otrosEstados.some((e) => e.slug === candidato.slug) && otrosEstados.length < 6) otrosEstados.push(candidato);
}
const tieneEmpresas = (await empresasPorEstado(estado.slug)).length > 0;
const tieneEstaciones = !!(await estadoConEstaciones(estado.slug))?.estaciones.length;

/* ── Interlinking 2026-09-30: cobertura ↔ catálogo, directorio, servicios, industrias y guías.
   Antes ninguna de las 33 páginas de cobertura enlazaba a una categoría de producto ni al blog. */
const empresasEdo = await empresasPorEstado(estado.slug);
const girosEdo = giros.filter((g) => empresasEdo.some((e) => e.giros.includes(g.slug)));
const CATS_COBERTURA = ['extintores', 'sistemas-ci', 'trajes-bombero', 'equipos-scba', 'cascos-nfpa', 'senalizacion-emergencia'];
const enlacesEstado = [
  ...CATS_COBERTURA.map((c) => ({ href: `/productos/${c}/`, label: lineaPorSlug(c)?.titulo ?? (c === 'sistemas-ci' ? 'Sistemas contra incendio' : c) })),
  ...girosEdo.map((g) => ({ href: `/empresas/${g.slug}/${estado.slug}/`, label: `${ANCLA_GIRO[g.slug]} en ${estado.name}` })),
  ...(tieneEstaciones ? [{ href: `/estaciones/${estado.slug}/`, label: `Estaciones de bomberos en ${estado.name}` }] : []),
  { href: '/servicios/mantenimiento/', label: 'Mantenimiento y recarga de extintores' },
  { href: '/servicios/capacitacion/', label: 'Capacitación contra incendio DC-3' },
  { href: '/servicios/instalacion-sistemas-ci/', label: 'Instalación de sistemas contra incendio' },
  { href: '/servicios/auditoria-seguridad/', label: 'Auditoría NOM-002-STPS' },
  { href: '/industrias/proteccion-civil/', label: 'Equipo para Protección Civil' },
  { href: '/industrias/bomberos-municipales/', label: 'Equipo para bomberos municipales' },
  { href: '/industrias/brigadas-industriales/', label: 'Equipo para brigadas industriales' },
  { href: '/blog/nom-002-stps-guia-completa/', label: 'Guía NOM-002-STPS-2010' },
  { href: '/blog/tipos-de-extintores-mexico/', label: 'Tipos de extintores en México' },
  { href: '/blog/como-equipar-estacion-bomberos-desde-cero/', label: 'Cómo equipar una estación de bomberos' },
];

// ── SEO: title (≤60c) y description (≤160c) keyword-first ──────────
// Patrón: "Equipo Bomberos [Estado] | Distribuidor NFPA | INPROSEG FIRE"
const seoTitle = `Cobertura en ${estado.name}: industria, bomberos y protección civil`;
const seoDescription =
  `Qué demanda equipo contra incendio en ${estado.name}: corredores industriales, cuerpos de bomberos y organismos de protección civil. ${estado.description}`
    .slice(0, 160);

// ── JSON-LD ──────────────────────────────────────────────────────────

// Breadcrumb
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio',    item: `${SITE.url}/`           },
    { '@type': 'ListItem', position: 2, name: 'Cobertura', item: `${SITE.url}/cobertura`  },
    { '@type': 'ListItem', position: 3, name: estado.name,  item: canonicalURL             },
  ],
};

/* Sin schema de negocio local. El sitio es un directorio: declararse `Store`
   con `hasOfferCatalog` de servicios de suministro afirmaba un comercio que no
   existe. La identidad del sitio ya se declara una sola vez como `Organization`
   en SEO.astro, así que aquí no se pierde nada. */

// FAQPage de cobertura
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: `¿Qué empresas del directorio ofrecen equipo para bomberos en ${estado.name}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Consulta las fichas de empresas registradas para bomberos, brigadas industriales y sistemas contra incendio en ${estado.name}. Cada empresa debe confirmar directamente su disponibilidad, cobertura y condiciones.`,
      },
    },
    {
      '@type': 'Question',
      name: `¿Cuánto tarda el servicio de una empresa en ${estado.name}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `El plazo depende de la empresa, el producto o servicio y la ruta acordada. Solicita una fecha por escrito y confirma disponibilidad directamente con el proveedor seleccionado.`,
      },
    },
    {
      '@type': 'Question',
      name: `¿Emiten documentación para licitaciones en ${estado.name}?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Solicita a la empresa seleccionada certificado de laboratorio acreditado, número de serie verificable, ficha técnica en español y carta de distribución del fabricante cuando aplique — documentación útil para un anexo técnico de licitación pública (CompraNet / LAASSP) o una auditoría de STPS o Protección Civil.',
      },
    },
  ],
};

const schemas = [breadcrumbSchema, faqSchema];

// ── WA message ───────────────────────────────────────────────────────
const waMsg = `Hola, necesito equipo para bomberos en ${estado.name}. ¿Cuál es el tiempo de entrega y disponibilidad?`;
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  canonicalURL={canonicalURL}
  schema={schemas}
>

  {/* ─── Breadcrumb ─── */}
  <nav
    class="py-3"
    style="background:var(--c-bg-alt);border-bottom:1px solid var(--c-line)"
    aria-label="Breadcrumb"
  >
    <div class="container-site">
      <ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)">
        <li><a href="/"           class="hover:text-[var(--c-accent)]">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/cobertura"  class="hover:text-[var(--c-accent)]">Cobertura</a></li>
        <li aria-hidden="true">/</li>
        <li><span style="color:var(--c-text-2)" aria-current="page">{estado.name}</span></li>
      </ol>
    </div>
  </nav>

  {/* ─── Hero del estado ─── */}
  <section
    class="relative overflow-hidden"
    style="background:var(--c-bg);padding-block:5rem"
    aria-labelledby="estado-heading"
  >

    <div class="container-site relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

        {/* Col izquierda */}
        <div>
          <span class="section-eyebrow mb-5 inline-flex">Cobertura · {estado.name}</span>
          <h1
            id="estado-heading"
            class="font-display font-bold mb-4"
            style="color:var(--c-ink);font-size:clamp(2.25rem,4.5vw,3.5rem);line-height:1.08"
          >
            Cobertura en<br/>
            <span style="color:var(--c-accent)">{estado.name}</span>
          </h1>

          <div class="flex flex-wrap gap-2 mb-8">
            <span class="badge badge-fire font-display text-[10px]">
              Empresas registradas
            </span>
            <span class="badge badge-dark font-display text-[10px]">Datos por confirmar</span>
            <span class="badge badge-dark font-display text-[10px]">Cobertura declarada</span>
            <span class="badge badge-dark font-display text-[10px]">Comparación por municipio</span>
          </div>

          <div class="flex flex-col sm:flex-row gap-3">
            <a
              href={whatsappUrl(waMsg)}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-primary btn-lg"
            >
              Consultar empresas
            </a>
            <a href="/empresas/" class="btn btn-ghost btn-lg">Directorio nacional</a>
            {tieneEmpresas && <a href={`/empresas/estado/${estado.slug}/`} class="btn btn-ghost btn-lg">Empresas en {estado.name}</a>}
            {tieneEstaciones && <a href={`/estaciones/${estado.slug}/`} class="btn btn-ghost btn-lg">Cuerpos de bomberos en {estado.name}</a>}
          </div>
        </div>

        {/* Col derecha — descripción larga */}
        <div class="lg:pl-16" style="border-left:1px solid var(--c-line)">
          {estado.longDesc.map((para) => (
            <p class="text-sm leading-[1.9] mb-4 last:mb-0" style="color:var(--c-text-2)">{para}</p>
          ))}
        </div>

      </div>
    </div>

  </section>

  {/* ─── Accesos rápidos ─── */}
  <QuickLinksBar />

  {/* ─── Sectores que atendemos en este estado ─── */}
  <section
    class="section"
    style="background:var(--c-bg)"
    aria-labelledby="sectores-heading"
  >
    <div class="container-site">
      <span class="section-eyebrow mb-4 inline-flex">Sectores</span>
      <h2
        id="sectores-heading"
        class="font-display font-bold mb-8"
        style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05"
      >
          Actividades registradas<br/>
        <span style="color:var(--c-accent)">en {estado.name}</span>
      </h2>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px"
        style="background:var(--c-line);border:1px solid var(--c-line)"
      >
        {estado.industries.map((sector, i) => (
          <div class="grid-cell flex items-start gap-4 p-5">
            <span
              class="shrink-0 font-display font-bold text-xs"
              style="color:var(--c-accent);min-width:1.5rem"
              aria-hidden="true"
            >
              
            </span>
            <span class="text-sm font-semibold" style="color:var(--c-text)">{sector}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ─── Cuerpos de bomberos representativos ─── */}
  {estado.bomberos.length > 0 && (
    <section
      class="section"
      style="background:var(--c-bg-alt)"
      aria-labelledby="bomberos-heading"
    >
      <div class="container-site">
        <span class="section-eyebrow mb-4 inline-flex">Organismos</span>
        <h2
          id="bomberos-heading"
          class="font-display font-bold mb-6"
          style="color:var(--c-ink);font-size:clamp(1.6rem,3vw,2.4rem)"
        >
          Cuerpos de bomberos y<br/>
          <span style="color:var(--c-accent)">organismos de PC en {estado.name}</span>
        </h2>

        <ul class="list-none m-0 p-0" style="border-top:1px solid var(--c-line)">
          {estado.bomberos.map((cuerpo) => (
            <li
              class="flex items-center gap-4 py-4"
              style="border-bottom:1px solid var(--c-line)"
            >
              <span style="color:var(--c-accent)" aria-hidden="true">▸</span>
              <span class="text-sm font-semibold" style="color:var(--c-text)">{cuerpo}</span>
            </li>
          ))}
        </ul>

        <p class="text-sm mt-6" style="color:var(--c-muted)">
          ¿Tu cuerpo de bomberos no está en la lista? Consulta el directorio para localizar empresas de la entidad
          y confirma directamente con ellas disponibilidad y cotizaciones para licitación.
        </p>
      </div>
    </section>
  )}

  {/* ─── Cómo leer la cobertura del directorio ─── */}
  <section
    class="section"
    style="background:var(--c-bg)"
    aria-labelledby="logistica-heading"
  >
    <div class="container-site">
        <span class="section-eyebrow mb-4 inline-flex">Datos por confirmar</span>
      <h2
        id="logistica-heading"
        class="font-display font-bold mb-8"
        style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem)"
      >
        Empresas registradas en {estado.name}:<br/>
        <span style="color:var(--c-accent)">compara su cobertura</span>
      </h2>

      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px"
        style="background:var(--c-line);border:1px solid var(--c-line)"
      >
        {[
          { icon: '', title: 'Empresas registradas', desc: 'Consulta los giros y municipios presentes en cada ficha' },
          { icon: '️', title: 'Alcance declarado', desc: 'Confirma directamente la cobertura comercial y de servicio' },
          { icon: '', title: 'Condiciones comerciales', desc: 'Solicita precios, disponibilidad y plazos a cada empresa' },
          { icon: '', title: 'Ubicación', desc: 'Compara empresas por estado y municipio' },
        ].map((f) => (
          <div class="grid-cell flex flex-col gap-3 p-6">
            <span class="text-2xl" aria-hidden="true">{f.icon}</span>
            <h3 class="font-display font-bold text-sm" style="color:var(--c-ink)">
              {f.title}
            </h3>
            <p class="text-xs leading-relaxed" style="color:var(--c-muted)">{f.desc}</p>
          </div>
        ))}
      </div>

      <p class="text-sm mt-6" style="color:var(--c-muted)">
        La presencia de una empresa en este estado no acredita cobertura fuera de su ubicación.
        Confirma directamente con cada empresa disponibilidad, alcance, tiempos y condiciones de servicio.
      </p>
    </div>
  </section>

  {/* ─── FAQ del estado ─── */}
  <section
    class="section"
    style="background:var(--c-bg-alt)"
    aria-labelledby="faq-heading"
  >
    <div class="container-site">
      <span class="section-eyebrow mb-4 inline-flex">FAQ</span>
      <h2
        id="faq-heading"
        class="font-display font-bold mb-8"
        style="color:var(--c-ink);font-size:clamp(1.6rem,3vw,2.4rem)"
      >
        Preguntas frecuentes sobre<br/>
        <span style="color:var(--c-accent)">cobertura en {estado.name}</span>
      </h2>

      <dl
        class="flex flex-col gap-px"
        style="background:var(--c-line);border:1px solid var(--c-line)"
      >
        {[
          {
            q: `¿Qué empresas del directorio ofrecen equipo para bomberos en ${estado.name}?`,
            a: `Consulta las fichas de empresas registradas para bomberos, brigadas industriales y sistemas contra incendio en ${estado.name}. Cada empresa debe confirmar directamente su disponibilidad, cobertura y condiciones.`,
          },
          {
            q: `¿Cuánto tarda el servicio de una empresa en ${estado.name}?`,
            a: `El plazo depende de la empresa, el producto o servicio y la ruta acordada. Solicita una fecha por escrito y confirma disponibilidad directamente con el proveedor seleccionado.`,
          },
          {
            q: `¿Emiten documentación para licitaciones en ${estado.name}?`,
            a: 'Solicita a la empresa seleccionada certificado de laboratorio acreditado, número de serie verificable, ficha técnica en español y carta de distribución del fabricante cuando aplique — documentación útil para un anexo técnico de licitación pública (CompraNet / LAASSP) o una auditoría de STPS o Protección Civil.',
          },
        ].map(({ q, a }) => (
          <div class="grid-cell p-6">
            <dt class="font-display font-bold mb-2" style="color:var(--c-ink);font-size:0.95rem">{q}</dt>
            <dd class="text-sm leading-relaxed m-0" style="color:var(--c-muted)">{a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  {/* ─── Estados relacionados ─── */}
  <RelatedLinks ruta={`/cobertura/${estado.slug}/`} titulo={`Equipo contra incendio con entrega en ${estado.name}`} incluirDirectorio={false} incluirCobertura={false} enlacesExtra={enlacesEstado} />

  {otrosEstados.length > 0 && (
    <section class="section-tight" style="background:var(--c-bg-alt);border-top:1px solid var(--c-line)" aria-labelledby="otros-estados-heading">
      <div class="container-site">
        <span class="section-eyebrow mb-4 inline-flex">Cobertura nacional</span>
        <h2 id="otros-estados-heading" class="font-display font-bold mb-6" style="color:var(--c-ink);font-size:clamp(1.5rem,3vw,2.25rem)">Otros estados con cobertura</h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 list-none m-0 p-0" style="border-top:1px solid var(--c-line);border-left:1px solid var(--c-line)">
          {otrosEstados.map((otro) => <li style="border-bottom:1px solid var(--c-line);border-right:1px solid var(--c-line)"><a href={`/cobertura/${otro.slug}/`} class="group flex items-center justify-between gap-4 p-4"><span class="font-display font-semibold text-sm group-hover:text-[var(--c-accent)]" style="color:var(--c-ink)">Cobertura en {otro.name}</span><span style="color:var(--forge-300)"></span></a></li>)}
        </ul>
      </div>
    </section>
  )}

  {/* ─── CTA de cierre ─── */}
  <section
    class="section"
    style="background:var(--c-bg);border-top:1px solid var(--c-line)"
  >
    <div class="container-site text-center">
      <span class="section-eyebrow mb-4 inline-flex">Siguiente paso</span>
      <h2
        class="font-display font-bold mb-4"
        style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem)"
      >
        ¿Necesitas equipo para<br/>
        <span style="color:var(--c-accent)">bomberos en {estado.name}?</span>
      </h2>
      <p class="text-sm mb-8 max-w-xl mx-auto" style="color:var(--c-text-2)">
        Cuéntanos qué necesitas — producto, cantidad y destino — y te respondemos
        con disponibilidad, precio y tiempo de entrega en menos de 24 horas.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href={whatsappUrl(waMsg)}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary btn-lg"
        >
          Cotizar por WhatsApp
        </a>
        <a href="/cotizacion" class="btn btn-ghost btn-lg">Formulario de cotización</a>
        <a href="/cobertura"  class="btn btn-ghost btn-lg">Cobertura nacional en 32 estados</a>
      </div>
    </div>
  </section>

</BaseLayout>
