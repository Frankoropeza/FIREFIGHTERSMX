---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { SITE } from '@config/site';

const canonicalURL = `${SITE.url}/cotizacion/`;
const seoMeta = {
  title: 'Cómo Solicitar una Cotización de Equipo Contra Incendio',
  description: 'Prepara una solicitud de cotización de equipo contra incendio: especificaciones, cantidades, entrega, documentación y empresas para comparar en México.',
  canonicalURL,
};

const pasos = [
  { n: '01', title: 'Define la necesidad', text: 'Describe el uso, riesgo, equipo o sistema que necesitas resolver; evita comenzar únicamente con una marca.' },
  { n: '02', title: 'Especifica el alcance', text: 'Indica cantidades, capacidades, tallas, accesorios, compatibilidad, instalación, pruebas o capacitación.' },
  { n: '03', title: 'Aclara la documentación', text: 'Señala fichas, manuales, evidencias normativas o formatos de licitación que deban entregarse.' },
  { n: '04', title: 'Comparte datos logísticos', text: 'Incluye ciudad, estado, fecha requerida y condiciones conocidas de entrega o trabajo en sitio.' },
  { n: '05', title: 'Compara sobre la misma base', text: 'Envía el mismo requerimiento a varias empresas y revisa inclusiones, exclusiones, vigencia y responsables.' },
];

const rutas = [
  { title: 'Equipo para bomberos y EPP', text: 'Trajes, cascos, SCBA, rescate, cámaras térmicas, HAZMAT y otras categorías.', href: '/empresas/venta-equipo/' },
  { title: 'Extintores', text: 'Venta, recarga, inspección o mantenimiento según la actividad declarada por cada empresa.', href: '/empresas/extintores/' },
  { title: 'Sistemas contra incendio', text: 'Detección, alarma, redes, rociadores, bombeo y supresión.', href: '/empresas/sistemas-ci/' },
  { title: 'Equipo contra incendio', text: 'Empresas relacionadas con suministro y servicios generales del sector.', href: '/empresas/equipos-contra-incendio/' },
  { title: 'Capacitación', text: 'Empresas y centros relacionados con capacitación contra incendios y brigadas.', href: '/empresas/capacitacion/' },
];

const checklist = [
  'Descripción del equipo, servicio o sistema requerido.',
  'Cantidad, unidad de medida y configuración por partida.',
  'Aplicación, entorno y condiciones relevantes de operación.',
  'Normas o documentos solicitados, con edición si el proyecto la define.',
  'Lugar y fecha requeridos para entrega, instalación o capacitación.',
  'Impuestos, moneda, forma de pago y vigencia de la propuesta.',
  'Garantía, mantenimiento, consumibles, refacciones y soporte posterior.',
];

const breadcrumbSchema = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${SITE.url}/` },
    { '@type': 'ListItem', position: 2, name: 'Cómo solicitar una cotización', item: canonicalURL },
  ],
};
const articleSchema = {
  '@context': 'https://schema.org', '@type': 'Article', '@id': `${canonicalURL}#article`,
  headline: seoMeta.title, description: seoMeta.description, url: canonicalURL, inLanguage: 'es-MX',
  author: { '@type': 'Organization', '@id': `${SITE.url}/#organization`, name: SITE.name },
  publisher: { '@id': `${SITE.url}/#organization` }, mainEntityOfPage: canonicalURL,
};
---

<BaseLayout {...seoMeta} schema={[breadcrumbSchema, articleSchema]}>
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.15)" aria-label="Breadcrumb"><div class="container-site"><ol class="flex items-center gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)"><li><a href="/" class="hover:text-[#FF6B26]">Inicio</a></li><li aria-hidden="true">/</li><li aria-current="page" style="color:#94A3B8">Solicitar cotización</li></ol></div></nav>

  <section class="relative overflow-hidden" style="background:#040A12;padding-block:5rem"><div class="container-site relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"><div><span class="section-eyebrow mb-5 inline-flex">Guía de compra</span><h1 class="font-display font-bold uppercase mb-6" style="color:#FFFFFF;font-size:clamp(2.4rem,5.5vw,4.4rem);line-height:0.95">Cómo solicitar una<br/><span style="color:#F75000">cotización completa.</span></h1><div class="flex flex-col sm:flex-row gap-3"><a href="#pasos" class="btn btn-primary btn-lg">Preparar solicitud</a><a href="/empresas/" class="btn btn-ghost btn-lg">Buscar empresas</a></div></div><div class="lg:pl-16" style="border-left:1px solid rgba(74,117,153,0.1)"><p class="text-sm leading-[1.9] mb-5" style="color:#94A3B8">Una solicitud clara permite comparar equipos, documentación, entrega, instalación y servicio sobre una base equivalente.</p><p class="text-sm leading-[1.9]" style="color:#64748B">FIREFIGHTERS MX no emite cotizaciones ni representa a las empresas listadas. Utiliza esta guía y contacta directamente a los proveedores del directorio.</p></div></div></section>

  <QuickLinksBar />

  <section id="pasos" class="section" style="background:#070E1A" aria-labelledby="pasos-title"><div class="container-site"><div class="max-w-3xl mb-10"><span class="section-eyebrow mb-4 inline-flex">Paso a paso</span><h2 id="pasos-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.9rem,3.8vw,3rem);line-height:1.05">Preparar una solicitud<br/><span style="color:#F75000">comparable.</span></h2></div><ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 list-none m-0 p-0 gap-px" style="background:rgba(74,117,153,0.18);border:1px solid rgba(74,117,153,0.18)">{pasos.map((paso) => <li class="p-6" style="background:#080F1A"><span class="font-display font-bold text-2xl" style="color:#F75000">{paso.n}</span><h3 class="font-display font-bold text-base my-3" style="color:#FFFFFF">{paso.title}</h3><p class="text-xs leading-relaxed" style="color:#64748B">{paso.text}</p></li>)}</ol></div></section>

  <section class="section" style="background:#040A12" aria-labelledby="rutas-title"><div class="container-site"><div class="max-w-3xl mb-10"><span class="section-eyebrow mb-4 inline-flex">Directorio por giro</span><h2 id="rutas-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.9rem,3.8vw,3rem);line-height:1.05">Empresas a las que puedes<br/><span style="color:#F75000">solicitar información.</span></h2></div><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">{rutas.map((ruta) => <a href={ruta.href} class="group flex flex-col p-7" style="background:#080F1A;border:1px solid rgba(74,117,153,0.18)"><h3 class="font-display font-bold text-lg mb-3 group-hover:text-[#FF6B26]" style="color:#FFFFFF">{ruta.title}</h3><p class="text-xs leading-relaxed mb-5 flex-1" style="color:#64748B">{ruta.text}</p><span class="text-xs font-display font-semibold uppercase tracking-wider" style="color:#FF8F57">Explorar empresas →</span></a>)}</div></div></section>

  <section class="section" style="background:#070E1A" aria-labelledby="checklist-title"><div class="container-site grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-start"><div><span class="section-eyebrow mb-4 inline-flex">Checklist</span><h2 id="checklist-title" class="font-display font-bold mb-5" style="color:#FFFFFF;font-size:clamp(1.9rem,3.8vw,3rem);line-height:1.05">Información para enviar<br/><span style="color:#F75000">a cada empresa.</span></h2><p class="text-sm leading-relaxed mb-6" style="color:#94A3B8">Copia esta lista en tu solicitud y adapta únicamente lo que conozcas. No inventes una norma o especificación: pide apoyo técnico al responsable de tu proyecto cuando falte definirla.</p><a href="/precios/" class="btn btn-outline">Factores que cambian el precio</a></div><ul class="flex flex-col list-none m-0 p-0" style="border-top:1px solid rgba(74,117,153,0.18)">{checklist.map((item, index) => <li class="flex items-start gap-4 py-4" style="border-bottom:1px solid rgba(74,117,153,0.18)"><span class="font-display font-bold text-sm shrink-0" style="color:#F75000">{String(index + 1).padStart(2, '0')}</span><span class="text-sm leading-relaxed" style="color:#94A3B8">{item}</span></li>)}</ul></div></section>

  <section style="background:#F75000;padding-block:4rem" aria-label="Buscar proveedores en el directorio"><div class="container-site"><div class="flex flex-col lg:flex-row items-center justify-between gap-8"><div><p class="text-xs font-display font-bold uppercase tracking-[0.2em] mb-3" style="color:rgba(255,255,255,0.7)">Siguiente paso</p><h2 class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(1.75rem,3.5vw,2.5rem);line-height:1.1">Compara empresas por<br/>giro y ubicación.</h2></div><a href="/empresas/" class="btn" style="background:#FFFFFF;color:#F75000;font-weight:700">Abrir directorio</a></div></div></section>
</BaseLayout>
