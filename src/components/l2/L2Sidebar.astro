---
/**
 * Barra lateral de la plantilla L2 (hubs de sección) — homologada a partir de /productos/
 * (Frank, 2026-09-30). Tarjetas apiladas de enlazado interno que avanzan con la página
 * (sin scroll interno) y, al final, una tarjeta fija con «En esta página» y cotización.
 * Bajo 1280 px los bloques se pliegan en un <details>. Sin íconos ni animaciones.
 * Los bloques salen de src/lib/l2.ts; cada hub decide el orden (el suyo primero).
 */
import type { L2Bloque, L2Seccion } from '@lib/l2';
import { whatsappUrl, CANAL_CONTACTO } from '@config/site';

export interface Props {
  bloques: L2Bloque[];
  secciones: L2Seccion[];
  /** Texto del plegable en móvil y nombre accesible de la barra */
  resumen?: string;
  /** URL de la página actual para marcarla si aparece en un bloque */
  actual?: string;
  cotizar?: { titulo: string; texto: string; msg: string };
}
const {
  bloques, secciones, resumen = 'Navegar la sección', actual,
  cotizar = { titulo: 'Cotiza tu equipo', texto: 'Envíanos tu lista, las bases de tu licitación o una foto del equipo a renovar.', msg: 'Hola, quiero cotizar equipo contra incendio.' },
} = Astro.props;
---


<aside class="sb" aria-label={resumen}>
  <details class="sb-wrap" open data-sb>
    <summary class="sb-sum">{resumen}</summary>

    <div class="sb-body">
      {bloques.map((b) => (
        <nav class="sb-card" aria-label={b.titulo}>
          <header class="sb-head">
            <p class="sb-title">{b.titulo}</p>
            {b.meta && <p class="sb-meta">{b.meta}</p>}
          </header>
          {b.grupos.map((g) => (
            <div class="sb-group">
              {g.label && <p class="sb-group-label">{g.label}</p>}
              <ul class="sb-list" role="list">
                {g.links.map((l) => (
                  <li><a href={l.href} class="sb-row" aria-current={actual && l.href === actual ? 'page' : undefined}><span class="sb-row-label">{l.label}</span>{l.n != null && <span class="sb-count" aria-label={`${l.n} modelos`}>{l.n}</span>}</a></li>
                ))}
              </ul>
              {g.foot && <a href={g.foot.href} class="sb-foot">{g.foot.label}</a>}
            </div>
          ))}
          {b.foot && <a href={b.foot.href} class="sb-foot">{b.foot.label}</a>}
        </nav>
      ))}
    </div>
  </details>

  <!-- Tarjeta fija: accesos de la página + cotización -->
      <div class="sb-card sb-sticky">
        <nav aria-label="En esta página">
          <p class="sb-group-label">En esta página</p>
          <ul class="sb-tabs" role="list">
            {secciones.map((s) => <li><a href={`#${s.id}`} class="sb-tab" data-spy={s.id}>{s.label}</a></li>)}
          </ul>
        </nav>
        <div class="sb-quote">
          <p class="sb-quote-title">{cotizar.titulo}</p>
          <p class="sb-quote-text">{cotizar.texto}</p>
          <a href={whatsappUrl(cotizar.msg)} target="_blank" rel="noopener" class="btn btn-primary sb-btn">Cotizar por {CANAL_CONTACTO}</a>
          <a href="/cotizacion/" class="btn btn-ghost sb-btn">Cotización formal</a>
        </div>
      </div>
</aside>

<script>
  const wrap = document.querySelector<HTMLDetailsElement>('[data-sb]');
  if (wrap) {
    const mq = window.matchMedia('(min-width: 1280px)');
    const sync = () => { wrap.open = mq.matches; };
    sync();
    mq.addEventListener('change', sync);
  }
  // Scroll-spy de «En esta página» (sin desplazamiento suave)
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-spy]'));
  const targets = links.map((a) => document.getElementById(a.dataset.spy!)).filter((el): el is HTMLElement => !!el);
  if ('IntersectionObserver' in window && targets.length) {
    const visibles = new Set<string>();
    const pintar = () => {
      const activo = targets.find((t) => visibles.has(t.id))?.id;
      links.forEach((a) => (a.dataset.spy === activo ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? visibles.add(e.target.id) : visibles.delete(e.target.id)));
      pintar();
    }, { rootMargin: '-35% 0px -55% 0px' });
    targets.forEach((t) => io.observe(t));
  }
</script>

<style>
  .sb { min-width: 0; }
  @media (min-width: 1280px) { .sb { align-self: stretch; display: flex; flex-direction: column; gap: 1.25rem; } }

  /* Plegable en móvil y tablet */
  .sb-wrap { border: 1px solid var(--c-line); border-radius: var(--radius-card); background: var(--c-surface); }
  @media (min-width: 1280px) { .sb-wrap { border: 0; background: transparent; border-radius: 0; } }
  .sb-sum { display: flex; align-items: center; justify-content: space-between; min-height: 3rem; padding: .75rem 1rem; font-size: .9375rem; font-weight: 600; color: var(--c-ink); cursor: pointer; list-style: none; }
  .sb-sum::-webkit-details-marker { display: none; }
  .sb-sum::after { content: "Mostrar"; font-size: .8125rem; font-weight: 500; color: var(--c-accent); }
  .sb-wrap[open] .sb-sum::after { content: "Ocultar"; }
  @media (min-width: 1280px) { .sb-sum { display: none; } }

  .sb-body { display: flex; flex-direction: column; gap: 1.25rem; padding: 0 1rem 1rem; }
  @media (min-width: 1280px) { .sb-body { padding: 0; } }

  /* Tarjeta de bloque */
  .sb-card { background: var(--c-surface); border: 1px solid var(--c-line); border-radius: var(--radius-card); box-shadow: var(--shadow-card); overflow: hidden; }
  .sb-head { padding: 1rem 1.25rem .875rem; border-bottom: 1px solid var(--c-line); background: var(--c-bg-alt); }
  .sb-title { margin: 0; font-family: var(--font-display); font-size: 1rem; font-weight: 700; letter-spacing: -.01em; line-height: 1.3; color: var(--c-ink); }
  .sb-meta { margin: .1875rem 0 0; font-size: .75rem; color: var(--c-muted); }

  .sb-group + .sb-group { border-top: 1px solid var(--c-line); }
  .sb-group-label { margin: 0; padding: .875rem 1.25rem .375rem; font-size: .6875rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--c-accent); }

  .sb-list { margin: 0; padding: 0 .5rem .25rem; list-style: none; }
  .sb-row { display: flex; align-items: center; gap: .75rem; min-height: 2.375rem; padding: .375rem .75rem; font-size: .875rem; line-height: 1.3; color: var(--c-ink-2); text-decoration: none; border-radius: 6px; border-left: 2px solid transparent; transition: color .15s, background-color .15s, border-color .15s; }
  .sb-row[aria-current] { color: var(--c-accent); background: var(--c-bg-alt); border-left-color: var(--c-accent); font-weight: 600; }
  .sb-row:hover, .sb-row:focus-visible { color: var(--c-accent); background: var(--c-bg-alt); border-left-color: var(--c-accent); }
  .sb-row-label { flex: 1; min-width: 0; font-weight: 500; }
  .sb-count { flex: none; min-width: 1.75rem; padding: .0625rem .4375rem; font-size: .75rem; font-weight: 600; font-variant-numeric: tabular-nums; text-align: center; color: var(--c-text-2); background: var(--c-bg-alt); border: 1px solid var(--c-line); border-radius: 999px; }
  .sb-row:hover .sb-count { color: var(--c-accent); border-color: rgba(200, 16, 46, .25); }

  .sb-foot { display: block; margin: .25rem 0 0; padding: .75rem 1.25rem; font-size: .8125rem; font-weight: 600; color: var(--c-accent); text-decoration: none; border-top: 1px solid var(--c-line); transition: color .15s, background-color .15s; }
  .sb-foot:hover, .sb-foot:focus-visible { color: var(--c-accent-hover); background: var(--c-bg-alt); }

  /* Tarjeta fija final */
  .sb-sticky { display: flex; flex-direction: column; gap: 1rem; padding: 0 1.25rem 1.25rem; }
  .sb-sticky .sb-group-label { padding-inline: 0; }
  .sb-sticky { display: none; }
  @media (min-width: 1280px) { .sb-sticky { display: flex; position: sticky; top: calc(var(--header-height) + 1rem); } }
  .sb-tabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .375rem; margin: 0; padding: 0; list-style: none; }
  .sb-tabs li:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .sb-tab { display: flex; align-items: center; justify-content: center; min-height: 2.25rem; padding: .25rem .5rem; font-size: .8125rem; font-weight: 600; color: var(--c-ink-2); text-align: center; text-decoration: none; background: var(--c-bg-alt); border: 1px solid var(--c-line); border-radius: var(--radius-btn); transition: color .15s, background-color .15s, border-color .15s; }
  .sb-tab:hover, .sb-tab:focus-visible { color: var(--c-accent); border-color: var(--c-accent); background: var(--c-surface); }
  .sb-tab[aria-current] { color: #FFFFFF; background: var(--c-accent); border-color: var(--c-accent); }
  .sb-quote { display: flex; flex-direction: column; gap: .5rem; padding-top: 1rem; border-top: 1px solid var(--c-line); }
  .sb-quote-title { margin: 0; font-family: var(--font-display); font-size: 1rem; font-weight: 700; color: var(--c-ink); }
  .sb-quote-text { margin: 0 0 .25rem; font-size: .8125rem; line-height: 1.55; color: var(--c-text-2); }
  .sb-btn { width: 100%; justify-content: center; text-align: center; white-space: normal; }
</style>
