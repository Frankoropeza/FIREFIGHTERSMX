---
/**
 * EstadoCard — tarjeta de estado del directorio de estaciones.
 * Diseño profesional: header visual (placeholder listo para foto futura),
 * eyebrow, título, texto, chips de tipo y botón "Ver estaciones".
 *
 * Sin animaciones de layout (solo el botón y el borde en hover),
 * homologado al sistema de diseño v2 (navy + naranja).
 *
 * Para activar foto real más adelante: pasa `image` (y opcional `imageAlt`).
 *   <EstadoCard est={est} image={`/images/estaciones/${est.slug}.avif`} />
 * Si `image` está vacío, se muestra el header gráfico de marca.
 */
import type { EstadoConEstaciones } from '@lib/estaciones';
import { tipoConfig, capacidadLabel } from '@data/estaciones-config';

export interface Props {
  est: EstadoConEstaciones;
  image?: string;
  imageAlt?: string;
}

const { est, image, imageAlt } = Astro.props;

const href         = `/estaciones/${est.slug}`;
const count        = est.estaciones.length;
const tiposUnicos  = [...new Set(est.estaciones.map((e) => e.tipo))];
const patternId    = `grid-${est.slug}`;

/* ─── Descripción ampliada (generada con los datos reales) ────────── */
const join = (arr: string[]): string =>
  arr.length <= 1
    ? (arr[0] ?? '')
    : `${arr.slice(0, -1).join(', ')} y ${arr[arr.length - 1]}`;

// Minúscula inicial salvo siglas/acrónimos (HAZMAT, ARFF, PEMEX…)
const lcFirst = (s: string): string =>
  s[0] && s[0] === s[0].toUpperCase() && s[1] && s[1] === s[1].toLowerCase()
    ? s[0].toLowerCase() + s.slice(1)
    : s;

const municipios = [...new Set(est.estaciones.map((e) => e.municipio))];

// Jurisdicción / tipos de cuerpo
const tipoAdj: Record<string, string> = {
  Municipal:  'municipales',
  Estatal:    'estatales',
  Industrial: 'industriales',
  Aeropuerto: 'aeroportuarios (ARFF)',
  PEMEX:      'de PEMEX',
  CFE:        'de CFE',
  Voluntarios:'voluntarios',
};
const jurisdiccion =
  tiposUnicos.length === 1 && tiposUnicos[0] === 'Municipal'
    ? (count === 1 ? 'de jurisdicción municipal' : 'todas de jurisdicción municipal')
    : `con cuerpos ${join(tiposUnicos.map((t) => tipoAdj[t] ?? tipoConfig[t].label.toLowerCase()))}`;

// Servicios más frecuentes del estado
const freq = new Map<string, number>();
est.estaciones.forEach((e) => e.servicios.forEach((s) => freq.set(s, (freq.get(s) ?? 0) + 1)));
const topServicios = [...freq.entries()].sort((a, b) => b[1] - a[1]).slice(0, 4).map(([s]) => lcFirst(capacidadLabel(s)));
const serviciosFrase = topServicios.length ? ` Entre sus servicios destacan ${join(topServicios)}` : '';

// Corporaciones históricas
const anios   = est.estaciones.map((e) => e.fundacion).filter(Boolean) as number[];
const minAnio = anios.length ? Math.min(...anios) : null;
const historia = minAnio ? `, con corporaciones históricas fundadas desde ${minAnio}` : '';

// Certificaciones
const certs   = [...new Set(est.estaciones.flatMap((e) => e.certificaciones ?? []))];
const hasNFPA = certs.some((c) => c.includes('NFPA'));
const cierre  = hasNFPA
  ? 'Consulta direcciones, teléfonos de emergencia y certificaciones NFPA de cada corporación.'
  : 'Consulta direcciones, teléfonos de emergencia y los servicios operativos de cada corporación.';

// Verbo variado por estado (evita repetición visual)
const verbos = ['reúne', 'concentra', 'agrupa', 'integra', 'documenta'];
const hash   = est.slug.split('').reduce((a, c) => a + c.charCodeAt(0), 0);
const verbo  = verbos[hash % verbos.length];

const estTxt   = count === 1 ? 'estación activa' : 'estaciones activas';
const muniFrase = municipios.length === 1
  ? `en el municipio de ${municipios[0]} (${est.region})`
  : `distribuidas en ${municipios.length} municipios de la región ${est.region}`;

const descripcion =
  `El directorio de bomberos de ${est.nombre} ${verbo} ${count} ${estTxt} ${muniFrase}, ${jurisdiccion}.` +
  `${serviciosFrase}${historia}. ${cierre}`;
---

<a
  href={href}
  class="estado-card group relative flex flex-col overflow-hidden"
  data-nombre={est.nombre.toLowerCase()}
  data-region={est.region.toLowerCase()}
  style="background:#080F1A;border:1px solid rgba(74,117,153,0.18)"
  aria-label={`Ver las ${count} estaciones de bomberos en ${est.nombre}`}
>
  {/* ══ HEADER VISUAL ════════════════════════════════════════════════ */}
  <div class="ec-visual relative flex flex-col justify-between overflow-hidden" style="height:152px;padding:0.9rem 1rem">

    {image ? (
      <>
        <img
          src={image}
          alt={imageAlt ?? `Estaciones de bomberos en ${est.nombre}`}
          width="380" height="152"
          loading="lazy" decoding="async"
          class="absolute inset-0 w-full h-full block"
          style="object-fit:cover;object-position:center 30%"
        />
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
          style="background:linear-gradient(to bottom, rgba(4,10,18,0.45) 0%, rgba(4,10,18,0.25) 45%, rgba(4,10,18,0.85) 100%)"></div>
      </>
    ) : (
      <>
        {/* Fondo placeholder de marca: gradiente navy + glow naranja */}
        <div class="absolute inset-0" aria-hidden="true"
          style="background:linear-gradient(140deg,#0E2236 0%,#0A1626 45%,#060E18 100%)"></div>
        <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
          style="background:radial-gradient(ellipse 75% 70% at 80% 15%, rgba(247,80,0,0.16) 0%, transparent 65%)"></div>
        {/* Patrón de grid */}
        <svg class="absolute inset-0 w-full h-full" style="opacity:0.10" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <pattern id={patternId} width="30" height="30" patternUnits="userSpaceOnUse">
              <path d="M 30 0 L 0 0 0 30" fill="none" stroke="#7AA4C4" stroke-width="0.5"/>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill={`url(#${patternId})`}/>
        </svg>
        {/* Abreviatura watermark */}
        <span class="ec-watermark absolute font-display font-bold pointer-events-none select-none"
          aria-hidden="true"
          style="bottom:-0.35em;left:0.4rem;line-height:1;font-size:5.5rem;color:rgba(255,255,255,0.05);letter-spacing:-0.04em">
          {est.abreviatura}
        </span>
      </>
    )}

    {/* Eyebrow región — arriba izquierda */}
    <div class="relative z-10 flex items-start justify-between gap-2">
      <span class="font-display font-semibold text-[9px] uppercase tracking-[0.22em] px-2 py-1"
        style="background:rgba(4,10,18,0.55);border:1px solid rgba(74,117,153,0.30);color:#7AA4C4;backdrop-filter:blur(2px)">
        {est.abreviatura} · {est.region}
      </span>

      {/* Pill de conteo — arriba derecha */}
      <span class="flex items-baseline gap-1 px-2.5 py-1"
        style="background:rgba(247,80,0,0.14);border:1px solid rgba(247,80,0,0.45)">
        <span class="font-display font-bold text-lg leading-none" style="color:#FF6B26">{count}</span>
        <span class="font-display font-semibold text-[8px] uppercase tracking-widest" style="color:#FF8F57">
          {count === 1 ? 'estación' : 'estaciones'}
        </span>
      </span>
    </div>

    {/* Ícono circular — abajo izquierda */}
    <div class="relative z-10 flex items-center gap-2.5">
      <span class="flex items-center justify-center rounded-full shrink-0"
        style="width:42px;height:42px;background:rgba(4,10,18,0.65);border:1.5px solid rgba(247,80,0,0.45);color:#FF6B26">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
        </svg>
      </span>
      <span class="font-display font-semibold text-[10px] uppercase tracking-widest" style="color:rgba(255,255,255,0.55)">
        Directorio
      </span>
    </div>

    {/* Línea naranja inferior */}
    <div class="absolute bottom-0 left-0 right-0" style="height:2px;background:linear-gradient(90deg,#F75000 0%,rgba(247,80,0,0) 85%)" aria-hidden="true"></div>
  </div>

  {/* ══ CONTENIDO ════════════════════════════════════════════════════ */}
  <div class="flex flex-col flex-1 gap-3 p-5">

    {/* Título */}
    <h3 class="ec-title font-display font-bold text-xl leading-tight m-0" style="color:#FFFFFF">
      {est.nombre}
    </h3>

    {/* Texto — descripción ampliada del estado */}
    <p class="text-xs m-0" style="color:#7C8DA3;line-height:1.75">
      {descripcion}
    </p>

    {/* Chips de tipo */}
    <div class="flex flex-wrap gap-1.5 pt-3" style="border-top:1px solid rgba(74,117,153,0.12)">
      {tiposUnicos.map((t) => (
        <span class="font-display font-semibold text-[9px] uppercase tracking-wider px-2 py-0.5"
          style={`color:${tipoConfig[t].color};background:${tipoConfig[t].bgColor};border:1px solid ${tipoConfig[t].color}33`}>
          {tipoConfig[t].label}
        </span>
      ))}
    </div>

    {/* Botón — Ver estaciones del estado */}
    <div class="mt-auto pt-1">
      <span
        class="ec-cta inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 font-display font-bold text-xs uppercase tracking-wider"
        style="background:#F75000;color:#040A12;letter-spacing:0.08em"
      >
        Bomberos en {est.nombre}
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
        </svg>
      </span>
    </div>
  </div>
</a>

<style>
  /* Hover: solo borde (instantáneo) + brillo del botón. Sin movimiento de layout. */
  .estado-card:hover { border-color: rgba(247,80,0,0.50) !important; }
  .estado-card:hover .ec-title { color: #FF6B26; }
  .estado-card:hover .ec-cta { background: #FF6B26 !important; }
</style>
