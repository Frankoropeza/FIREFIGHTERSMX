---
const year = new Date().getFullYear();
---

<footer class="bg-[var(--forge-900)] border-t border-[var(--color-border)]">

  <!-- Barra superior naranja con CTA -->
  <div class="bg-[var(--ember-500)]">
    <div class="container-site py-5 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="font-display font-bold text-white text-lg uppercase tracking-wider">
        ¿Necesitas equipo certificado?
      </p>
      <div class="flex items-center gap-3">
        <a href="/cotizacion" class="btn btn-sm bg-white text-[var(--ember-500)] hover:bg-[var(--ember-100)] border-white font-display">
          Solicitar cotización
        </a>
        <a
          href="https://wa.me/525512345678"
          target="_blank" rel="noopener"
          class="btn btn-sm bg-[var(--ember-600)] hover:bg-[var(--ember-600)] text-white border-[var(--ember-600)] font-display"
        >
          WhatsApp
        </a>
      </div>
    </div>
  </div>

  <!-- Main -->
  <div class="container-site py-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-10 lg:gap-12">

    <!-- Brand -->
    <div class="lg:col-span-2 flex flex-col gap-6">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 w-fit" aria-label="FIREFIGHTERS MX">
        <div class="relative w-9 h-9 shrink-0">
          <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
            <polygon points="18,2 32,10 32,26 18,34 4,26 4,10" fill="var(--ember-500)"/>
            <path d="M18 10c0 0-5 4-3 8 1 2 3 2 3 2s-1-2 0-4c1-2 3-2 3-2s-1 3 1 5c.8.8 1 2 1 2s2-1.5 2-4c0-3-2-5-2-5s1 2 0 4c0 0-2-4-5-6z" fill="white" opacity="0.95"/>
          </svg>
        </div>
        <div>
          <div class="font-display font-bold text-[1.1rem] text-white leading-none tracking-[0.06em] uppercase">
            Firefighters<span class="text-[var(--ember-500)]"> MX</span>
          </div>
          <div class="text-[9px] text-[var(--forge-300)] font-medium tracking-[0.22em] uppercase mt-0.5">Equipo Certificado</div>
        </div>
      </a>

      <p class="text-sm leading-relaxed text-[var(--forge-200)]">
        Portal líder en México para equipos de bomberos y sistemas contra incendio.
        Distribuidores autorizados con cobertura en los 32 estados.
        Certificados NFPA y NOM-002-STPS.
      </p>

      <!-- Contact info -->
      <div class="flex flex-col gap-2 text-sm text-[var(--forge-200)]">
        <a href="tel:+525512345678" class="flex items-center gap-2 hover:text-[var(--ember-400)]">
          <svg class="w-4 h-4 shrink-0 text-[var(--ember-500)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          55 1234-5678
        </a>
        <a href="mailto:contacto@firefightersmx.com" class="flex items-center gap-2 hover:text-[var(--ember-400)]">
          <svg class="w-4 h-4 shrink-0 text-[var(--ember-500)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          contacto@firefightersmx.com
        </a>
        <span class="flex items-center gap-2 text-[var(--forge-300)]">
          <svg class="w-4 h-4 shrink-0 text-[var(--forge-300)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
          Lun–Vie 8am–6pm · Sáb 9am–2pm
        </span>
      </div>

      <!-- Certificaciones -->
      <div class="flex flex-wrap gap-2">
        {['NFPA Certified','ISO 9001','NOM-002','STPS','UL Listed'].map(c => (
          <span class="badge badge-dark text-[10px]">{c}</span>
        ))}
      </div>

      <!-- Social -->
      <div class="flex items-center gap-2">
        {[
          { href:'https://facebook.com/firefightersmx', label:'Facebook', icon:'<path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>' },
          { href:'https://instagram.com/firefightersmx', label:'Instagram', icon:'<rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>' },
          { href:'https://linkedin.com/company/firefightersmx', label:'LinkedIn', icon:'<path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>' },
          { href:'https://youtube.com/@firefightersmx', label:'YouTube', icon:'<path d="M22.54 6.42a2.78 2.78 0 00-1.95-1.96C18.88 4 12 4 12 4s-6.88 0-8.59.46a2.78 2.78 0 00-1.95 1.96A29 29 0 001 12a29 29 0 00.46 5.58A2.78 2.78 0 003.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.46a2.78 2.78 0 001.95-1.95A29 29 0 0023 12a29 29 0 00-.46-5.58z"/><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/>' },
        ].map(({ href, label, icon }) => (
          <a
            href={href} target="_blank" rel="noopener noreferrer"
            class="w-8 h-8 flex items-center justify-center border border-[var(--color-border)] hover:border-[var(--ember-500)] hover:text-[var(--ember-400)] text-[var(--forge-300)]"
            aria-label={label}
          >
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true" set:html={icon}/>
          </a>
        ))}
      </div>
    </div>

    <!-- Productos -->
    <div>
      <h4 class="font-display font-bold text-white text-xs uppercase tracking-[0.15em] mb-5 flex items-center gap-2">
        <span class="w-3 h-[1px] bg-[var(--ember-500)]"></span>
        Productos
      </h4>
      <ul class="flex flex-col gap-2 text-sm text-[var(--forge-200)]">
        {[
          ['Trajes para Bomberos','/productos/trajes-bombero'],
          ['Cascos NFPA','/productos/cascos-nfpa'],
          ['Equipos SCBA','/productos/equipos-scba'],
          ['Herramientas de Rescate','/productos/herramientas-rescate'],
          ['Extintores','/productos/extintores'],
          ['Sistemas CI','/productos/sistemas-ci'],
          ['Cámaras Térmicas','/productos/camaras-termicas'],
          ['Equipos HAZMAT','/productos/hazmat'],
          ['Drones de Emergencia','/productos/drones-emergencia'],
        ].map(([label, href]) => (
          <li>
            <a href={href} class="hover:text-[var(--ember-400)]">{label}</a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Servicios -->
    <div>
      <h4 class="font-display font-bold text-white text-xs uppercase tracking-[0.15em] mb-5 flex items-center gap-2">
        <span class="w-3 h-[1px] bg-[var(--ember-500)]"></span>
        Servicios
      </h4>
      <ul class="flex flex-col gap-2 text-sm text-[var(--forge-200)]">
        {[
          ['Capacitación','/servicios/capacitacion'],
          ['Instalación CI','/servicios/instalacion-sistemas-ci'],
          ['Mantenimiento','/servicios/mantenimiento'],
          ['Auditoría NOM-002','/servicios/auditoria-seguridad'],
          ['Brigadas Empresariales','/servicios/brigadas-empresariales'],
          ['Licitaciones','/servicios/licitaciones'],
        ].map(([label, href]) => (
          <li>
            <a href={href} class="hover:text-[var(--ember-400)]">{label}</a>
          </li>
        ))}
      </ul>

      <h4 class="font-display font-bold text-white text-xs uppercase tracking-[0.15em] mt-8 mb-5 flex items-center gap-2">
        <span class="w-3 h-[1px] bg-[var(--ember-500)]"></span>
        Industrias
      </h4>
      <ul class="flex flex-col gap-2 text-sm text-[var(--forge-200)]">
        {[
          ['Bomberos Municipales','/industrias/bomberos-municipales'],
          ['Brigadas Industriales','/industrias/brigadas-industriales'],
          ['Aeropuertos ARFF','/industrias/aeropuertos-arff'],
          ['Refinerías PEMEX','/industrias/refinerias-pemex'],
          ['Hospitales','/industrias/hospitales'],
        ].map(([label, href]) => (
          <li>
            <a href={href} class="hover:text-[var(--ember-400)]">{label}</a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Empresa -->
    <div>
      <h4 class="font-display font-bold text-white text-xs uppercase tracking-[0.15em] mb-5 flex items-center gap-2">
        <span class="w-3 h-[1px] bg-[var(--ember-500)]"></span>
        Empresa
      </h4>
      <ul class="flex flex-col gap-2 text-sm text-[var(--forge-200)]">
        {[
          ['Nosotros','/nosotros'],
          ['Blog Técnico','/blog'],
          ['Certificaciones','/certificaciones'],
          ['Distribuidores','/distribuidores'],
          ['Cobertura Nacional','/cobertura'],
          ['Licitaciones','/licitaciones'],
          ['Contacto','/contacto'],
          ['Cotizar','/cotizacion'],
        ].map(([label, href]) => (
          <li>
            <a href={href} class="hover:text-[var(--ember-400)]">{label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Bottom -->
  <div class="border-t border-[var(--color-border)] py-5">
    <div class="container-site flex flex-col sm:flex-row items-center justify-between gap-3 text-xs text-[var(--forge-300)]">
      <p>© {year} FIREFIGHTERS MX — Todos los derechos reservados.</p>
      <div class="flex items-center gap-4">
        <a href="/aviso-privacidad" class="hover:text-[var(--slate-300)]">Aviso de Privacidad</a>
        <a href="/terminos-condiciones" class="hover:text-[var(--slate-300)]">Términos</a>
        <a href="/sitemap-index.xml" class="hover:text-[var(--slate-300)]">Sitemap</a>
      </div>
    </div>
  </div>

</footer>
