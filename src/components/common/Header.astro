---
import { navigation } from '@data/navigation';
import { SITE, whatsappUrl } from '@data/site';
import TopBar from '@components/common/TopBar.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header id="site-header" class="fixed top-0 inset-x-0 z-50">
  <TopBar />
  <div class="h-[3px] bg-gradient-to-r from-[var(--ember-600)] via-[var(--ember-500)] to-[var(--gold-500)]"></div>

  <div class="header-glass backdrop-blur-md" style="background-color:rgba(7,14,26,0.97);border-bottom:1px solid rgba(74,117,153,0.22)">
    <div class="container-site h-[68px] flex items-center justify-between gap-6">

      <!-- ── LOGO ─────────────────────────────────────────────────── -->
      <a href="/" class="flex items-center gap-3 shrink-0" aria-label="FIREFIGHTERS MX">
        <div class="w-9 h-9 shrink-0">
          <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
            <polygon points="18,2 32,10 32,26 18,34 4,26 4,10" fill="var(--ember-500)"/>
            <path d="M18 10c0 0-5 4-3 8 1 2 3 2 3 2s-1-2 0-4c1-2 3-2 3-2s-1 3 1 5c.8.8 1 2 1 2s2-1.5 2-4c0-3-2-5-2-5s1 2 0 4c0 0-2-4-5-6z" fill="white" opacity="0.95"/>
          </svg>
        </div>
        <div>
          <div class="font-display font-bold text-[1.1rem] text-white leading-none tracking-[0.06em] uppercase">
            Firefighters<span style="color:var(--ember-500)"> MX</span>
          </div>
          <div class="text-[9px] font-medium tracking-[0.22em] uppercase mt-0.5" style="color:var(--forge-200)">Equipo Certificado</div>
        </div>
      </a>

      <!-- ── DESKTOP NAV ───────────────────────────────────────────── -->
      <nav class="hidden lg:flex items-center gap-0.5" role="navigation" aria-label="Navegación principal">
        {navigation.main.map((item) => (
          <div class="nav-group relative">
            {item.children ? (
              <>
                <!-- Trigger -->
                <a
                  href={item.href}
                  class={`nav-trigger flex items-center gap-1.5 px-3 py-2 text-sm font-medium rounded-sm
                    ${isActive(item.href) ? 'text-[var(--ember-400)]' : 'text-[var(--slate-300)] hover:text-white'}`}
                  aria-haspopup="true"
                >
                  {item.label}
                  <svg class="nav-caret w-3 h-3 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                  </svg>
                </a>

                <!-- Dropdown panel (pt-2 = puente continuo de hover) -->
                <div class="nav-dropdown absolute top-full left-0 pt-2 z-50" style="width:19rem" role="menu">
                  <div class="drop-panel" style="background:#080F1A;border:1px solid rgba(74,117,153,0.22);border-top:2px solid var(--ember-500);box-shadow:0 12px 40px rgba(4,10,18,0.85)">
                    <div class="py-1.5">
                      {item.children.map((child) => (
                        child.children ? (
                          /* ── Ítem con subcategorías → fly-out ── */
                          <div class="nav-sub-group relative">
                            <a
                              href={child.href}
                              class={`drop-item flex items-center justify-between gap-2 px-4 py-3 text-sm
                                ${isActive(child.href) ? 'text-[var(--ember-400)]' : 'text-[var(--slate-300)] hover:text-white'}`}
                              role="menuitem"
                            >
                              <span class="flex flex-col gap-0.5">
                                <span class="flex items-center gap-2.5">
                                  <span class="w-1 h-1 rounded-full bg-[var(--ember-500)] shrink-0 opacity-70"></span>
                                  <span class="font-medium">{child.label}</span>
                                </span>
                                {child.description && (
                                  <span class="pl-[18px] text-[10px]" style="color:#4A7599">{child.description}</span>
                                )}
                              </span>
                              <!-- Chevron derecho: indica submenú -->
                              <svg class="sub-chevron w-3.5 h-3.5 shrink-0" style="color:#4A7599" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                              </svg>
                            </a>

                            <!-- Sub-panel fly-out a la derecha (pl-0.5 = puente) -->
                            <div class="nav-sub-panel absolute top-0 left-full pl-0.5 z-50" style="width:15rem">
                              <div style="background:#0A1320;border:1px solid rgba(74,117,153,0.22);border-top:2px solid var(--ember-500);box-shadow:0 12px 40px rgba(4,10,18,0.85)">
                                <div class="px-4 py-2.5" style="border-bottom:1px solid rgba(74,117,153,0.15)">
                                  <span class="text-[9px] font-display font-bold uppercase tracking-[0.16em]" style="color:#F75000">Subcategorías</span>
                                </div>
                                {child.children.map((sub) => (
                                  <a
                                    href={sub.href}
                                    class={`flex flex-col gap-0.5 px-4 py-3 text-sm group/sub
                                      ${isActive(sub.href) ? 'text-[var(--ember-400)]' : 'text-[var(--slate-300)] hover:text-white hover:bg-[rgba(74,117,153,0.08)]'}`}
                                    role="menuitem"
                                  >
                                    <span class="flex items-center gap-2">
                                      <svg class="w-3 h-3 shrink-0 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                                      </svg>
                                      <span class="font-medium">{sub.label}</span>
                                    </span>
                                    {sub.description && (
                                      <span class="pl-5 text-[10px]" style="color:#4A7599">{sub.description}</span>
                                    )}
                                  </a>
                                ))}
                              </div>
                            </div>

                          </div>
                        ) : (
                          /* ── Ítem normal ── */
                          <a
                            href={child.href}
                            class={`drop-item flex flex-col gap-0.5 px-4 py-3 text-sm
                              ${child.label.startsWith('Ver') ? 'text-[var(--ember-400)] hover:text-[var(--ember-300)] border-t border-[rgba(74,117,153,0.15)] mt-1 pt-3' : ''}
                              ${isActive(child.href) && !child.label.startsWith('Ver') ? 'text-[var(--ember-400)]' : !child.label.startsWith('Ver') ? 'text-[var(--slate-300)] hover:text-white' : ''}`}
                            role="menuitem"
                          >
                            {!child.label.startsWith('Ver') && (
                              <span class="flex items-center gap-2.5">
                                <span class="w-1 h-1 rounded-full bg-[var(--ember-500)] shrink-0 opacity-50"></span>
                                <span class="font-medium">{child.label}</span>
                              </span>
                            )}
                            {child.label.startsWith('Ver') && (
                              <span class="flex items-center gap-2 text-xs font-display font-semibold uppercase tracking-wide">
                                {child.label}
                                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
                                </svg>
                              </span>
                            )}
                            {child.description && !child.label.startsWith('Ver') && (
                              <span class="pl-[18px] text-[10px]" style="color:#4A7599">{child.description}</span>
                            )}
                          </a>
                        )
                      ))}
                    </div>
                  </div>
                </div>
              </>
            ) : (
              <a
                href={item.href}
                class={`block px-3 py-2 text-sm font-medium rounded-sm
                  ${isActive(item.href) ? 'text-[var(--ember-400)]' : 'text-[var(--slate-300)] hover:text-white'}`}
              >
                {item.label}
              </a>
            )}
          </div>
        ))}
      </nav>

      <!-- ── ACCIONES DESKTOP ─────────────────────────────────────── -->
      <div class="flex items-center gap-2">
        <a
          href={`tel:${SITE.phoneE164}`}
          class="hidden xl:flex items-center gap-1.5 text-xs font-medium px-3 py-2 border border-[var(--color-border)] rounded-sm hover:border-[var(--ember-500)]"
          style="color:var(--forge-200)"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {SITE.phone}
        </a>

        <a
          href={whatsappUrl('Hola, quiero cotizar equipo para bomberos.')}
          target="_blank" rel="noopener"
          class="hidden md:flex items-center justify-center w-9 h-9 rounded-sm text-white"
          style="background:#25d366"
          aria-label="WhatsApp"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          </svg>
        </a>

        <a href="/cotizacion" class="btn btn-primary btn-sm hidden sm:inline-flex">
          Cotizar ahora
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>

        <!-- Hamburger móvil -->
        <button
          id="mobile-menu-btn"
          class="lg:hidden p-2"
          style="color:var(--slate-300)"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg id="icon-burger" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- ══ MOBILE MENU ══════════════════════════════════════════════════════ -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden overflow-y-auto overscroll-contain"
    style="background:#040A12;border-bottom:1px solid rgba(74,117,153,0.2);max-height:calc(100dvh - 71px)"
    role="dialog" aria-modal="true" aria-label="Menú principal"
  >

    <!-- Search / CTA bar -->
    <div class="container-site pt-5 pb-4 flex gap-3" style="border-bottom:1px solid rgba(74,117,153,0.15)">
      <a href="/cotizacion" class="btn btn-primary flex-1 justify-center text-sm">Solicitar cotización</a>
      <a
        href={whatsappUrl('Hola, quiero información.')}
        target="_blank" rel="noopener"
        class="flex items-center justify-center w-11 h-11 rounded-sm shrink-0 text-white"
        style="background:#25d366"
        aria-label="WhatsApp"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        </svg>
      </a>
    </div>

    <!-- Nav items -->
    <nav class="container-site pb-6" aria-label="Menú móvil">
      {navigation.main.map((item, idx) => (
        <div class="mob-l1" style="border-bottom:1px solid rgba(74,117,153,0.12)">

          {item.children ? (
            /* ── Item con dropdown ── */
            <>
              <div class="flex items-stretch">
                <a
                  href={item.href}
                  class={`mob-link flex-1 flex items-center px-1 py-4 text-[15px] font-display font-semibold
                    ${isActive(item.href) ? 'text-[var(--ember-400)]' : 'text-white'}`}
                >
                  {item.label}
                </a>
                <button
                  class="mob-acc-btn flex items-center justify-center w-12 shrink-0"
                  style="color:var(--forge-300)"
                  data-l1={idx}
                  aria-expanded="false"
                  aria-label={`Expandir ${item.label}`}
                >
                  <svg class="mob-caret w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                  </svg>
                </button>
              </div>

              <!-- L1 panel -->
              <div class="mob-l1-panel hidden" data-l1-panel={idx}>
                <div class="ml-3 pl-3 flex flex-col pb-2" style="border-left:1px solid rgba(74,117,153,0.2)">
                  {item.children.map((child, cidx) => (
                    child.children ? (
                      /* ── L2 ítem con sub-dropdown ── */
                      <div class="mob-l2">
                        <div class="flex items-stretch">
                          <a
                            href={child.href}
                            class={`mob-link flex-1 flex flex-col justify-center px-3 py-3 text-sm
                              ${isActive(child.href) ? 'text-[var(--ember-400)]' : 'text-[var(--slate-300)]'}`}
                          >
                            <span class="font-medium">{child.label}</span>
                            {child.description && (
                              <span class="text-[10px] mt-0.5" style="color:#4A7599">{child.description}</span>
                            )}
                          </a>
                          <button
                            class="mob-sub-btn flex items-center justify-center w-10 shrink-0"
                            style="color:var(--forge-400)"
                            data-l2={`${idx}-${cidx}`}
                            aria-expanded="false"
                            aria-label={`Expandir ${child.label}`}
                          >
                            <svg class="mob-sub-caret w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                            </svg>
                          </button>
                        </div>

                        <!-- L2 sub-panel -->
                        <div class="mob-l2-panel hidden" data-l2-panel={`${idx}-${cidx}`}>
                          <div class="ml-4 pl-3 py-1" style="border-left:2px solid rgba(247,80,0,0.3)">
                            {child.children.map((sub) => (
                              <a
                                href={sub.href}
                                class={`mob-link flex flex-col px-2 py-2.5 text-xs
                                  ${isActive(sub.href) ? 'text-[var(--ember-400)]' : 'text-[var(--slate-400)] hover:text-[var(--ember-300)]'}`}
                              >
                                <span class="flex items-center gap-1.5">
                                  <svg class="w-2.5 h-2.5 shrink-0 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                                  </svg>
                                  <span class="font-medium">{sub.label}</span>
                                </span>
                                {sub.description && (
                                  <span class="pl-4 text-[10px]" style="color:#4A7599">{sub.description}</span>
                                )}
                              </a>
                            ))}
                          </div>
                        </div>
                      </div>
                    ) : (
                      /* ── L2 ítem normal ── */
                      <a
                        href={child.href}
                        class={`mob-link flex flex-col px-3 py-3 text-sm
                          ${child.label.startsWith('Ver') ? 'mt-1 pt-3' : ''}
                          ${isActive(child.href) ? 'text-[var(--ember-400)]' : child.label.startsWith('Ver') ? 'text-[var(--ember-500)] font-semibold' : 'text-[var(--slate-400)] hover:text-white'}`}
                        style={child.label.startsWith('Ver') ? 'border-top:1px solid rgba(74,117,153,0.15)' : ''}
                      >
                        <span class="font-medium">{child.label}</span>
                        {child.description && !child.label.startsWith('Ver') && (
                          <span class="text-[10px] mt-0.5" style="color:#4A7599">{child.description}</span>
                        )}
                      </a>
                    )
                  ))}
                </div>
              </div>
            </>
          ) : (
            /* ── Item simple sin dropdown ── */
            <a
              href={item.href}
              class={`mob-link block px-1 py-4 text-[15px] font-display font-semibold
                ${isActive(item.href) ? 'text-[var(--ember-400)]' : 'text-white'}`}
            >
              {item.label}
            </a>
          )}
        </div>
      ))}

      <!-- Info de contacto al pie del menú -->
      <div class="mt-5 pt-4 flex flex-col gap-2" style="border-top:1px solid rgba(74,117,153,0.15)">
        <a
          href={`tel:${SITE.phoneE164}`}
          class="flex items-center gap-2 text-sm py-1"
          style="color:var(--forge-200)"
        >
          <svg class="w-4 h-4 shrink-0" style="color:var(--ember-500)" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {SITE.phone}
        </a>
        <p class="text-xs" style="color:var(--forge-400)">{SITE.hours}</p>
      </div>
    </nav>
  </div>
</header>

<!-- Spacer para compensar el header fixed -->
<div class="h-[71px] md:h-[107px]" aria-hidden="true"></div>

<style>
  /* ── Dropdown desktop — hover continuo con puente pt-2 ── */
  .nav-dropdown          { opacity:0; visibility:hidden; pointer-events:none; }
  .nav-sub-panel         { opacity:0; visibility:hidden; pointer-events:none; }

  .nav-group:hover      > .nav-dropdown,
  .nav-group:focus-within > .nav-dropdown {
    opacity:1; visibility:visible; pointer-events:auto;
  }

  /* Fly-out: hover sobre el ítem padre O sobre el sub-panel */
  .nav-sub-group:hover  > .nav-sub-panel,
  .nav-sub-group:focus-within > .nav-sub-panel {
    opacity:1; visibility:visible; pointer-events:auto;
  }

  /* Caret del trigger principal */
  .nav-group:hover .nav-caret,
  .nav-group:focus-within .nav-caret { transform:rotate(180deg); opacity:0.9; }

  /* Hover highlight en drop-items */
  .drop-item:hover { background:rgba(74,117,153,0.08); }

  /* Highlight del sub-group cuando su panel está abierto */
  .nav-sub-group:hover > a  { background:rgba(247,80,0,0.07); }
  .nav-sub-group:hover .sub-chevron { color:var(--ember-400) !important; }

  /* ── Acordeón móvil ── */
  .mob-acc-btn[aria-expanded="true"]  .mob-caret    { transform:rotate(180deg); }
  .mob-sub-btn[aria-expanded="true"]  .mob-sub-caret { transform:rotate(90deg); color:var(--ember-400) !important; }

  /* Scroll shadow en header */
  .header-glass.scrolled { box-shadow:0 4px 24px rgba(4,10,18,0.8); }
</style>

<script>
/* ════════════════════════════════════════════════════════════════
   MOBILE MENU — abrir/cerrar + scroll lock
════════════════════════════════════════════════════════════════ */
const btn        = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
const menu       = document.getElementById('mobile-menu');
const iconBurger = document.getElementById('icon-burger');
const iconClose  = document.getElementById('icon-close');

function setMenuOpen(open: boolean) {
  if (!menu) return;
  menu.classList.toggle('hidden', !open);
  iconBurger?.classList.toggle('hidden', open);
  iconClose?.classList.toggle('hidden', !open);
  btn?.setAttribute('aria-expanded', String(open));
  btn?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  document.body.style.overflow = open ? 'hidden' : '';
}

btn?.addEventListener('click', () => {
  setMenuOpen(menu?.classList.contains('hidden') ?? true);
});

/* Cerrar al tocar cualquier enlace del menú móvil */
menu?.querySelectorAll('a.mob-link').forEach((a) => {
  a.addEventListener('click', () => setMenuOpen(false));
});

/* Cerrar con Escape */
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && !menu?.classList.contains('hidden')) setMenuOpen(false);
});

/* Volver a desktop cierra el menú */
window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
  if (e.matches) setMenuOpen(false);
});

/* ════════════════════════════════════════════════════════════════
   ACORDEÓN MÓVIL — nivel 1 (top-level con children)
════════════════════════════════════════════════════════════════ */
document.querySelectorAll<HTMLButtonElement>('.mob-acc-btn').forEach((b) => {
  b.addEventListener('click', () => {
    const id    = b.dataset.l1;
    const panel = menu?.querySelector(`[data-l1-panel="${id}"]`);
    const open  = b.getAttribute('aria-expanded') === 'true';
    b.setAttribute('aria-expanded', String(!open));
    panel?.classList.toggle('hidden', open);
  });
});

/* ════════════════════════════════════════════════════════════════
   ACORDEÓN MÓVIL — nivel 2 (sub-categorías)
════════════════════════════════════════════════════════════════ */
document.querySelectorAll<HTMLButtonElement>('.mob-sub-btn').forEach((b) => {
  b.addEventListener('click', () => {
    const id    = b.dataset.l2;
    const panel = menu?.querySelector(`[data-l2-panel="${id}"]`);
    const open  = b.getAttribute('aria-expanded') === 'true';
    b.setAttribute('aria-expanded', String(!open));
    panel?.classList.toggle('hidden', open);
  });
});

/* ════════════════════════════════════════════════════════════════
   SCROLL SHADOW en header
════════════════════════════════════════════════════════════════ */
const header = document.getElementById('site-header');
const glass  = header?.querySelector('.header-glass');
window.addEventListener('scroll', () => {
  glass?.classList.toggle('scrolled', window.scrollY > 8);
}, { passive: true });
</script>
