---
import { navigation } from '@data/navigation';
import { SITE, CONTACTO_DIRECTO_ACTIVO, whatsappUrl } from '@config/site';
import TopBar from '@components/common/TopBar.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header id="site-header" class="fixed top-0 inset-x-0 z-50">
  <TopBar />
  <div class="h-[3px] bg-gradient-to-r from-[var(--ember-600)] via-[var(--ember-500)] to-[var(--gold-500)]"></div>

  <div class="header-glass backdrop-blur-md" style="background-color:rgba(7,14,26,0.97);border-bottom:1px solid rgba(74,117,153,0.22)">
    <div class="container-site h-[68px] flex items-center justify-between gap-6 xl:gap-2 2xl:gap-6">

      <!-- ── LOGO ─────────────────────────────────────────────────── -->
      <a href="/" class="flex items-center gap-3 shrink-0" aria-label="FIREFIGHTERS MX">
        <div class="w-9 h-9 shrink-0">
          <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
            <polygon points="18,2 32,10 32,26 18,34 4,26 4,10" fill="var(--ember-500)"/>
            <path d="M18 10c0 0-5 4-3 8 1 2 3 2 3 2s-1-2 0-4c1-2 3-2 3-2s-1 3 1 5c.8.8 1 2 1 2s2-1.5 2-4c0-3-2-5-2-5s1 2 0 4c0 0-2-4-5-6z" fill="white" opacity="0.95"/>
          </svg>
        </div>
        <div>
          <div class="font-display font-bold text-[1.1rem] text-white leading-none tracking-[0.06em] uppercase">
            Firefighters<span style="color:var(--ember-500)"> MX</span>
          </div>
          <div class="text-[9px] font-medium tracking-[0.22em] uppercase mt-0.5" style="color:var(--forge-200)">Equipo Certificado</div>
        </div>
      </a>

      <!-- ── DESKTOP NAV ───────────────────────────────────────────── -->
      <nav class="hidden xl:flex items-center gap-0.5" role="navigation" aria-label="Navegación principal">
        {navigation.main.map((item) => (
          <div class="nav-group relative">
            {item.children ? (
              <>
                <!-- Trigger -->
                <a
                  href={item.href}
                  class={`nav-trigger flex items-center gap-1.5 px-3 py-2 text-sm font-medium rounded-sm ${isActive(item.href) ? 'text-[var(--ember-400)]' : 'text-[var(--slate-300)] hover:text-white'}`}
                  aria-haspopup="true"
                >
                  {item.label}
                  <svg class="nav-caret w-3 h-3 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                  </svg>
                </a>

                <!-- Dropdown panel (pt-2 = puente continuo de hover) -->
                <div class="nav-dropdown absolute top-full left-0 pt-2 z-50" style="width:19rem" role="menu">
                  <div class="drop-panel" style="background:#080F1A;border:1px solid rgba(74,117,153,0.22);border-top:2px solid var(--ember-500);box-shadow:0 12px 40px rgba(4,10,18,0.85)">
                    <div class="py-1.5">
                      {item.children.map((child) => (
                        child.children ? (
                          /* ── Ítem con subcategorías → fly-out ── */
                          <div class="nav-sub-group relative">
                            <a
                              href={child.href}
                              class={`drop-item flex items-center justify-between gap-2 px-4 py-3 text-sm ${isActive(child.href) ? 'text-[var(--ember-400)]' : 'text-[var(--slate-300)] hover:text-white'}`}
                              role="menuitem"
                            >
                              <span class="flex flex-col gap-0.5">
                                <span class="flex items-center gap-2.5">
                                  <span class="w-1 h-1 rounded-full bg-[var(--ember-500)] shrink-0 opacity-70"></span>
                                  <span class="font-medium">{child.label}</span>
                                </span>
                                {child.description && (
                                  <span class="pl-[18px] text-[10px]" style="color:var(--forge-300)">{child.description}</span>
                                )}
                              </span>
                              <!-- Chevron derecho: indica submenú -->
                              <svg class="sub-chevron w-3.5 h-3.5 shrink-0" style="color:var(--forge-300)" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                              </svg>
                            </a>

                            <!-- Sub-panel fly-out a la derecha (pl-0.5 = puente) -->
                            <div class="nav-sub-panel absolute top-0 left-full pl-0.5 z-50" style="width:15rem">
                              <div style="background:#0A1320;border:1px solid rgba(74,117,153,0.22);border-top:2px solid var(--ember-500);box-shadow:0 12px 40px rgba(4,10,18,0.85)">
                                <div class="px-4 py-2.5" style="border-bottom:1px solid rgba(74,117,153,0.15)">
                                  <span class="text-[9px] font-display font-bold uppercase tracking-[0.16em]" style="color:#F75000">Subcategorías</span>
                                </div>
                                {child.children.map((sub) => (
                                  <a
                                    href={sub.href}
                                    class={`flex flex-col gap-0.5 px-4 py-3 text-sm group/sub ${isActive(sub.href) ? 'text-[var(--ember-400)]' : 'text-[var(--slate-300)] hover:text-white hover:bg-[rgba(74,117,153,0.08)]'}`}
                                    role="menuitem"
                                  >
                                    <span class="flex items-center gap-2">
                                      <svg class="w-3 h-3 shrink-0 opacity-60" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                                      </svg>
                                      <span class="font-medium">{sub.label}</span>
                                    </span>
                                    {sub.description && (
                                      <span class="pl-5 text-[10px]" style="color:var(--forge-300)">{sub.description}</span>
                                    )}
                                  </a>
                                ))}
                              </div>
                            </div>

                          </div>
                        ) : (
                          /* ── Ítem normal ── */
                          <a
                            href={child.href}
                            class={`drop-item flex flex-col gap-0.5 px-4 py-3 text-sm ${child.label.startsWith('Ver') ? 'text-[var(--ember-400)] hover:text-[var(--ember-300)] border-t border-[rgba(74,117,153,0.15)] mt-1 pt-3' : ''}${isActive(child.href) && !child.label.startsWith('Ver') ? 'text-[var(--ember-400)]' : !child.label.startsWith('Ver') ? 'text-[var(--slate-300)] hover:text-white' : ''}`}
                            role="menuitem"
                          >
                            {!child.label.startsWith('Ver') && (
                              <span class="flex items-center gap-2.5">
                                <span class="w-1 h-1 rounded-full bg-[var(--ember-500)] shrink-0 opacity-50"></span>
                                <span class="font-medium">{child.label}</span>
                              </span>
                            )}
                            {child.label.startsWith('Ver') && (
                              <span class="flex items-center gap-2 text-xs font-display font-semibold uppercase tracking-wide">
                                {child.label}
                                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
                                </svg>
                              </span>
                            )}
                            {child.description && !child.label.startsWith('Ver') && (
                              <span class="pl-[18px] text-[10px]" style="color:var(--forge-300)">{child.description}</span>
                            )}
                          </a>
                        )
                      ))}
                    </div>
                  </div>
                </div>
              </>
            ) : (
              <a
                href={item.href}
                class={`block px-3 py-2 text-sm font-medium rounded-sm ${isActive(item.href) ? 'text-[var(--ember-400)]' : 'text-[var(--slate-300)] hover:text-white'}`}
              >
                {item.label}
              </a>
            )}
          </div>
        ))}
      </nav>

      <!-- ── ACCIONES DESKTOP ─────────────────────────────────────── -->
      <div class="flex items-center gap-2">
        {CONTACTO_DIRECTO_ACTIVO && (
<a
          href={`tel:${SITE.phoneE164}`}
          class="hidden 2xl:flex items-center gap-1.5 text-xs font-medium px-3 py-2 border border-[var(--color-border)] rounded-sm hover:border-[var(--ember-500)]"
          style="color:var(--forge-200)"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {SITE.phone}
        </a>
)}

        <a
          href={whatsappUrl('Hola, quiero cotizar equipo para bomberos.')}
          target="_blank" rel="noopener"
          class="hidden md:flex items-center justify-center w-9 h-9 rounded-sm text-white"
          style="background:#25d366"
          aria-label="WhatsApp"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          </svg>
        </a>

        <!-- El wrapper lleva el `hidden`: en el propio <a> la regla .btn de
             global.css (display:inline-flex) gana a la utilidad .hidden por
             orden de cascada y el botón se mostraba en móvil, empujando el
             hamburguesa fuera de la pantalla. -->
        <div class="hidden sm:block">
          <a href="/empresas/registro/" class="btn btn-primary btn-sm">
            Registrar empresa
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <!-- Hamburger móvil -->
        <button
          id="mobile-menu-btn"
          class="xl:hidden p-2"
          style="color:var(--slate-300)"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg id="icon-burger" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- ══ MOBILE MENU ═══════════════════════════════════════════════════════
       Contenedor vacío: el contenido se pide a /parciales/menu-movil/ la
       primera vez que se abre. Ver MenuMovilContenido.astro.
  ══════════════════════════════════════════════════════════════════════ -->
  <div
    id="mobile-menu"
    class="xl:hidden hidden overflow-y-auto overscroll-contain"
    style="background:#040A12;border-bottom:1px solid rgba(74,117,153,0.2);max-height:calc(100dvh - 71px)"
    role="dialog" aria-modal="true" aria-label="Menú principal"
    data-parcial="/parciales/menu-movil/"
  ></div>
</header>

<!-- Spacer para compensar el header fixed -->
<div class="h-[71px] md:h-[107px]" aria-hidden="true"></div>

<style>
  /* ── Dropdown desktop — hover continuo con puente pt-2 ── */
  .nav-dropdown          { opacity:0; visibility:hidden; pointer-events:none; }
  .nav-sub-panel         { opacity:0; visibility:hidden; pointer-events:none; }

  .nav-group:hover      > .nav-dropdown,
  .nav-group:focus-within > .nav-dropdown {
    opacity:1; visibility:visible; pointer-events:auto;
  }

  /* Fly-out: hover sobre el ítem padre O sobre el sub-panel */
  .nav-sub-group:hover  > .nav-sub-panel,
  .nav-sub-group:focus-within > .nav-sub-panel {
    opacity:1; visibility:visible; pointer-events:auto;
  }

  /* Caret del trigger principal */
  .nav-group:hover .nav-caret,
  .nav-group:focus-within .nav-caret { transform:rotate(180deg); opacity:0.9; }

  /* Hover highlight en drop-items */
  .drop-item:hover { background:rgba(74,117,153,0.08); }

  /* Highlight del sub-group cuando su panel está abierto */
  .nav-sub-group:hover > a  { background:rgba(247,80,0,0.07); }
  .nav-sub-group:hover .sub-chevron { color:var(--ember-400) !important; }

  /* ── Acordeón móvil ──
     :global() porque el markup se inyecta por fetch desde
     /parciales/menu-movil/ y no lleva el atributo de scope de Astro. */
  :global(.mob-acc-btn[aria-expanded="true"] .mob-caret)     { transform:rotate(180deg); }
  :global(.mob-sub-btn[aria-expanded="true"] .mob-sub-caret) { transform:rotate(90deg); color:var(--ember-400) !important; }

  /* Scroll shadow en header */
  .header-glass.scrolled { box-shadow:0 4px 24px rgba(4,10,18,0.8); }
</style>

<script>
/* ════════════════════════════════════════════════════════════════
   MOBILE MENU — abrir/cerrar + scroll lock
════════════════════════════════════════════════════════════════ */
const btn        = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
const menu       = document.getElementById('mobile-menu');
const iconBurger = document.getElementById('icon-burger');
const iconClose  = document.getElementById('icon-close');

/* El contenido del drawer vive en /parciales/menu-movil/ y se pide una
   sola vez, al primer toque del hamburguesa. Ver MenuMovilContenido.astro. */
let cargando = false;

function bindAcordeones(root: HTMLElement) {
  root.querySelectorAll<HTMLButtonElement>('.mob-acc-btn').forEach((b) => {
    b.addEventListener('click', () => {
      const panel = root.querySelector(`[data-l1-panel="${b.dataset.l1}"]`);
      const open  = b.getAttribute('aria-expanded') === 'true';
      b.setAttribute('aria-expanded', String(!open));
      panel?.classList.toggle('hidden', open);
    });
  });
  root.querySelectorAll<HTMLButtonElement>('.mob-sub-btn').forEach((b) => {
    b.addEventListener('click', () => {
      const panel = root.querySelector(`[data-l2-panel="${b.dataset.l2}"]`);
      const open  = b.getAttribute('aria-expanded') === 'true';
      b.setAttribute('aria-expanded', String(!open));
      panel?.classList.toggle('hidden', open);
    });
  });
  root.querySelectorAll('a.mob-link').forEach((a) => {
    a.addEventListener('click', () => setMenuOpen(false));
  });
}

/* El parcial es común a todo el sitio: el enlace de la sección actual se
   resalta aquí, con la misma regla que usa la barra de escritorio. */
function marcaActivos(root: HTMLElement) {
  const aqui = location.pathname;
  root.querySelectorAll<HTMLAnchorElement>('a.mob-link[href^="/"]').forEach((a) => {
    const href = a.getAttribute('href') || '';
    const activo = href === '/' ? aqui === '/' : aqui.startsWith(href);
    if (!activo) return;
    a.classList.remove('text-white', 'text-[var(--slate-300)]', 'text-[var(--slate-400)]');
    a.style.color = 'var(--ember-400)';
    a.setAttribute('aria-current', 'page');
  });
}

async function cargarMenu() {
  if (!menu || cargando || menu.dataset.cargado === '1') return;
  const url = menu.dataset.parcial;
  if (!url) return;
  cargando = true;
  try {
    const r = await fetch(url);
    if (!r.ok) throw new Error(String(r.status));
    /* El parcial se sirve como página estática: Astro le antepone un
       doctype que aquí no pinta nada. */
    menu.innerHTML = (await r.text()).replace(/^\s*<!DOCTYPE[^>]*>/i, '');
    menu.dataset.cargado = '1';
    bindAcordeones(menu);
    marcaActivos(menu);
  } catch {
    /* Sin red o parcial caído: el menú queda vacío pero el sitio sigue
       navegable por el footer y por la barra de escritorio. */
    menu.innerHTML =
      '<div class="container-site py-6 text-sm" style="color:var(--forge-200)">' +
      'No se pudo cargar el menú. <a class="underline" href="/">Ir al inicio</a></div>';
  } finally {
    cargando = false;
  }
}

/* Precarga en cuanto el dedo toca el botón, para que el panel ya esté
   listo cuando termine el tap. */
btn?.addEventListener('pointerdown', () => { void cargarMenu(); }, { once: true });

function setMenuOpen(open: boolean) {
  if (!menu) return;
  if (open) void cargarMenu();
  menu.classList.toggle('hidden', !open);
  iconBurger?.classList.toggle('hidden', open);
  iconClose?.classList.toggle('hidden', !open);
  btn?.setAttribute('aria-expanded', String(open));
  btn?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  document.body.style.overflow = open ? 'hidden' : '';
}

btn?.addEventListener('click', () => {
  setMenuOpen(menu?.classList.contains('hidden') ?? true);
});

/* Cerrar con Escape */
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && !menu?.classList.contains('hidden')) setMenuOpen(false);
});

/* Volver a desktop cierra el menú */
window.matchMedia('(min-width: 1280px)').addEventListener('change', (e) => {
  if (e.matches) setMenuOpen(false);
});

/* ════════════════════════════════════════════════════════════════
   DROPDOWNS DESKTOP — encajar siempre dentro de la ventana

   El menú "Productos" mide ~740 px de alto y los fly-out de nivel 3
   nacen a la altura de su ítem padre: en pantallas de 768–900 px de
   alto (y en ventanas angostas) varios enlaces caían fuera de la
   pantalla y eran imposibles de clicar. Aquí se recalcula la posición
   de cada panel al abrirlo.
════════════════════════════════════════════════════════════════ */
const MARGIN = 10;
const headerEl = document.getElementById('site-header');
const safeTop = () => (headerEl?.getBoundingClientRect().bottom ?? 0) + 4;

/* Panel de nivel 2 — alto máximo y volteo horizontal si no cabe */
function placeDropdown(group: Element) {
  const dd    = group.querySelector<HTMLElement>('.nav-dropdown');
  const panel = dd?.querySelector<HTMLElement>('.drop-panel');
  if (!dd || !panel) return;

  dd.style.left = ''; dd.style.right = '';
  panel.style.maxHeight = ''; panel.style.overflowY = '';

  const r = dd.getBoundingClientRect();
  const avail = window.innerHeight - r.top - MARGIN * 2;
  if (panel.scrollHeight > avail) {
    panel.style.maxHeight = `${Math.max(200, avail)}px`;
    panel.style.overflowY = 'auto';
  }
  if (r.left + r.width + MARGIN > window.innerWidth) {
    dd.style.left = 'auto';
    dd.style.right = '0px';
  }
}

/* Fly-out de nivel 3 — se saca del panel con position:fixed para que
   el scroll del panel padre no lo recorte, y se clava dentro de la ventana.
   El origen del bloque contenedor se mide en caliente (el backdrop-filter
   del header lo convierte en contenedor de los elementos fixed). */
function placeFlyout(sub: Element) {
  const panel = sub.querySelector<HTMLElement>('.nav-sub-panel');
  const inner = panel?.firstElementChild as HTMLElement | null;
  if (!panel || !inner) return;

  const anchor = sub.getBoundingClientRect();
  panel.style.position = 'fixed';
  panel.style.top = '0px';
  panel.style.left = '0px';
  panel.style.zIndex = '60';

  const origin = panel.getBoundingClientRect();
  const box    = inner.getBoundingClientRect();
  const w = box.width  || 240;
  const h = box.height || 0;

  let x = anchor.right;
  if (x + w + MARGIN > window.innerWidth) x = anchor.left - w;
  x = Math.max(MARGIN, Math.min(x, window.innerWidth - w - MARGIN));

  let y = Math.min(anchor.top, window.innerHeight - h - MARGIN);
  y = Math.max(safeTop(), y);

  panel.style.left = `${x - origin.left}px`;
  panel.style.top  = `${y - origin.top}px`;
}

function resetFlyout(sub: Element) {
  const panel = sub.querySelector<HTMLElement>('.nav-sub-panel');
  if (!panel) return;
  panel.style.position = ''; panel.style.top = ''; panel.style.left = ''; panel.style.zIndex = '';
}

document.querySelectorAll('.nav-group').forEach((g) => {
  const open = () => {
    placeDropdown(g);
    g.querySelectorAll('.nav-sub-group').forEach(resetFlyout);
  };
  g.addEventListener('mouseenter', open);
  g.addEventListener('focusin', open);
});

document.querySelectorAll('.nav-sub-group').forEach((s) => {
  s.addEventListener('mouseenter', () => placeFlyout(s));
  s.addEventListener('focusin',    () => placeFlyout(s));
  s.addEventListener('mouseleave', () => resetFlyout(s));
});

/* ════════════════════════════════════════════════════════════════
   SCROLL SHADOW en header
════════════════════════════════════════════════════════════════ */
const header = document.getElementById('site-header');
const glass  = header?.querySelector('.header-glass');
window.addEventListener('scroll', () => {
  glass?.classList.toggle('scrolled', window.scrollY > 8);
}, { passive: true });
</script>
