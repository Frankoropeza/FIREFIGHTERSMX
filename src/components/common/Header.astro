---
import { navigation } from '@data/navigation';
import { SITE, whatsappUrl } from '@data/site';
import TopBar from '@components/common/TopBar.astro';

const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<header id="site-header" class="fixed top-0 inset-x-0 z-50">
  <!-- TopBar -->
  <TopBar />

  <!-- Línea naranja top -->
  <div class="h-[3px] bg-gradient-to-r from-[var(--ember-600)] via-[var(--ember-500)] to-[var(--gold-500)]"></div>

  <div class="backdrop-blur-md" style="background-color:rgba(7,14,26,0.97);border-bottom:1px solid rgba(74,117,153,0.22)">
    <div class="container-site h-[68px] flex items-center justify-between gap-6">

      <!-- LOGO -->
      <a href="/" class="flex items-center gap-3 shrink-0 group" aria-label="FIREFIGHTERS MX">
        <div class="relative w-9 h-9 shrink-0">
          <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-full">
            <polygon points="18,2 32,10 32,26 18,34 4,26 4,10" fill="var(--ember-500)"/>
            <path d="M18 10c0 0-5 4-3 8 1 2 3 2 3 2s-1-2 0-4c1-2 3-2 3-2s-1 3 1 5c.8.8 1 2 1 2s2-1.5 2-4c0-3-2-5-2-5s1 2 0 4c0 0-2-4-5-6z"
                  fill="white" opacity="0.95"/>
          </svg>
        </div>
        <div>
          <div class="font-display font-bold text-[1.1rem] text-white leading-none tracking-[0.06em] uppercase">
            Firefighters<span class="text-[var(--ember-500)]"> MX</span>
          </div>
          <div class="text-[9px] text-[var(--forge-200)] font-medium tracking-[0.22em] uppercase mt-0.5">
            Equipo Certificado
          </div>
        </div>
      </a>

      <!-- DESKTOP NAV -->
      <nav class="hidden lg:flex items-center gap-0.5" role="navigation" aria-label="Navegación principal">
        {navigation.main.map((item) => (
          <div class="nav-group relative">
            {item.children ? (
              <>
                <a
                  href={item.href}
                  class={`nav-trigger flex items-center gap-1.5 px-3 py-2 text-sm font-medium rounded-sm
                    ${isActive(item.href) ? 'text-[var(--ember-400)]' : 'text-[var(--slate-300)] hover:text-white'}`}
                  aria-haspopup="true"
                >
                  {item.label}
                  <svg class="nav-caret w-3 h-3 opacity-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                  </svg>
                </a>
                <!-- Dropdown: wrapper con puente (pt-2) para hover continuo -->
                <div class="nav-dropdown absolute top-full left-0 pt-2 w-64 z-50" role="menu">
                  <div
                    class="bg-[var(--forge-700)] border border-[var(--color-border)] shadow-[0_8px_32px_rgba(4,10,18,0.8)]"
                    style="border-top:2px solid var(--ember-500)"
                  >
                    <div class="py-1.5">
                      {item.children.map((child) => (
                        <a
                          href={child.href}
                          class={`flex items-center gap-2.5 px-4 py-2.5 text-sm
                            ${isActive(child.href)
                              ? 'text-[var(--ember-400)] bg-[var(--forge-600)]'
                              : 'text-[var(--slate-300)] hover:text-white hover:bg-[var(--forge-600)]'}`}
                          role="menuitem"
                        >
                          <span class="w-1 h-1 rounded-full bg-[var(--ember-500)] shrink-0 opacity-50"></span>
                          {child.label}
                        </a>
                      ))}
                    </div>
                  </div>
                </div>
              </>
            ) : (
              <a
                href={item.href}
                class={`block px-3 py-2 text-sm font-medium rounded-sm
                  ${isActive(item.href) ? 'text-[var(--ember-400)]' : 'text-[var(--slate-300)] hover:text-white'}`}
              >
                {item.label}
              </a>
            )}
          </div>
        ))}
      </nav>

      <!-- ACCIONES -->
      <div class="flex items-center gap-2">
        <a
          href={`tel:${SITE.phoneE164}`}
          class="hidden xl:flex items-center gap-1.5 text-xs font-medium text-[var(--forge-200)] hover:text-[var(--ember-400)] px-3 py-2 border border-[var(--color-border)] rounded-sm"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {SITE.phone}
        </a>

        <a
          href={whatsappUrl('Hola, quiero cotizar equipo para bomberos.')}
          target="_blank" rel="noopener"
          class="hidden md:flex items-center justify-center w-9 h-9 bg-[#25d366] hover:bg-[#1fc45b] text-white rounded-sm"
          aria-label="WhatsApp"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          </svg>
        </a>

        <a href="/cotizacion" class="btn btn-primary btn-sm hidden sm:inline-flex">
          Cotizar ahora
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>

        <button
          id="mobile-menu-btn"
          class="lg:hidden p-2 text-[var(--slate-300)] hover:text-white"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg id="menu-icon-open" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- MOBILE MENU -->
  <div
    id="mobile-menu"
    class="lg:hidden hidden bg-[var(--forge-800)] border-b border-[var(--color-border)] overflow-y-auto overscroll-contain"
    style="max-height:calc(100dvh - 71px)"
    role="dialog" aria-modal="true" aria-label="Menú principal"
  >
    <div class="container-site py-4 flex flex-col">
      {navigation.main.map((item, idx) => (
        <div style="border-bottom:1px solid rgba(74,117,153,0.12)">
          {item.children ? (
            <>
              <div class="flex items-stretch">
                <a
                  href={item.href}
                  class={`mobile-link flex-1 flex items-center px-2 py-3.5 text-[15px] font-display font-semibold
                    ${isActive(item.href) ? 'text-[var(--ember-400)]' : 'text-white'}`}
                >
                  {item.label}
                </a>
                <button
                  type="button"
                  class="mobile-acc-btn flex items-center justify-center w-12 shrink-0 text-[var(--forge-300)]"
                  data-acc={idx}
                  aria-expanded="false"
                  aria-label={`Mostrar submenú de ${item.label}`}
                >
                  <svg class="acc-caret w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                  </svg>
                </button>
              </div>
              <div class="mobile-acc-panel hidden pb-2" data-acc-panel={idx}>
                <div class="ml-2 pl-3 flex flex-col" style="border-left:1px solid rgba(74,117,153,0.2)">
                  {item.children.map((child) => (
                    <a
                      href={child.href}
                      class={`mobile-link flex items-center gap-2.5 px-3 py-2.5 text-sm
                        ${isActive(child.href) ? 'text-[var(--ember-400)]' : 'text-[var(--slate-400)] hover:text-white'}`}
                    >
                      <span class="w-1 h-1 rounded-full bg-[var(--ember-500)] shrink-0 opacity-60"></span>
                      {child.label}
                    </a>
                  ))}
                </div>
              </div>
            </>
          ) : (
            <a
              href={item.href}
              class={`mobile-link block px-2 py-3.5 text-[15px] font-display font-semibold
                ${isActive(item.href) ? 'text-[var(--ember-400)]' : 'text-white'}`}
            >
              {item.label}
            </a>
          )}
        </div>
      ))}

      <div class="mt-5 flex flex-col gap-2.5">
        <a href="/cotizacion" class="btn btn-primary btn-mobile-full justify-center">Solicitar cotización</a>
        <a href={whatsappUrl('Hola, quiero información.')} target="_blank" rel="noopener" class="btn btn-whatsapp btn-mobile-full justify-center">
          WhatsApp
        </a>
        <a href={`tel:${SITE.phoneE164}`} class="flex items-center justify-center gap-2 py-2 text-sm text-[var(--forge-200)]">
          <svg class="w-4 h-4 text-[var(--ember-500)]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {SITE.phone}
        </a>
      </div>
    </div>
  </div>
</header>

<div class="h-[71px] md:h-[107px]" aria-hidden="true"></div>

<style>
  /* ── Dropdown desktop: hover continuo (puente pt-2) + foco teclado ── */
  .nav-dropdown { opacity: 0; visibility: hidden; }
  .nav-group:hover > .nav-dropdown,
  .nav-group:focus-within > .nav-dropdown {
    opacity: 1;
    visibility: visible;
  }
  /* Caret indica estado abierto (instantáneo, sin transición) */
  .nav-group:hover .nav-caret,
  .nav-group:focus-within .nav-caret { transform: rotate(180deg); opacity: 0.9; }

  /* ── Acordeón móvil ── */
  .mobile-acc-btn[aria-expanded="true"] .acc-caret { transform: rotate(180deg); }
</style>

<script>
  /* ── Menú móvil: abrir/cerrar + bloqueo de scroll ── */
  const btn = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  function setMenu(open: boolean) {
    if (!menu) return;
    menu.classList.toggle('hidden', !open);
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    btn?.setAttribute('aria-expanded', String(open));
    btn?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    document.body.style.overflow = open ? 'hidden' : '';
  }

  btn?.addEventListener('click', () => {
    setMenu(menu?.classList.contains('hidden') ?? true);
  });

  /* Cerrar al navegar (tap en cualquier enlace del menú) */
  menu?.querySelectorAll('a.mobile-link').forEach((a) => {
    a.addEventListener('click', () => setMenu(false));
  });

  /* Cerrar con Escape */
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu?.classList.contains('hidden')) setMenu(false);
  });

  /* Volver a desktop cierra y limpia el bloqueo de scroll */
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });

  /* ── Acordeón móvil: expandir/colapsar submenús ── */
  document.querySelectorAll<HTMLButtonElement>('.mobile-acc-btn').forEach((b) => {
    b.addEventListener('click', () => {
      const id = b.dataset.acc;
      const panel = menu?.querySelector(`[data-acc-panel="${id}"]`);
      const open = b.getAttribute('aria-expanded') === 'true';
      b.setAttribute('aria-expanded', String(!open));
      panel?.classList.toggle('hidden', open);
    });
  });

  /* ── Sombra del header al hacer scroll ── */
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    header?.classList.toggle('shadow-[0_4px_24px_rgba(4,10,18,0.8)]', window.scrollY > 8);
  }, { passive: true });
</script>
