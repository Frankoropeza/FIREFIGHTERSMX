---
import { navigation } from '@data/navigation';
import { SITE, CONTACTO_DIRECTO_ACTIVO, whatsappUrl, TELEFONO_ACTIVO } from '@config/site';
import TopBar from '@components/common/TopBar.astro';

const pathname = Astro.url.pathname;
const sinBarra = (href: string) => href.replace(/\/$/, '');
// Coincidencia por segmento: /empresa no debe marcarse activo dentro de /empresas/.
const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  const base = sinBarra(href);
  return pathname === base || pathname.startsWith(`${base}/`);
};
const isExact = (href: string) => (href === '/' ? pathname === '/' : sinBarra(pathname) === sinBarra(href));
const ZONA_DIRECTORIO = ['/directorio', '/empresas', '/estaciones', '/cobertura'];
const activoItem = (item: { href: string; zona?: string }) =>
  item.zona === 'directorio' ? ZONA_DIRECTORIO.some((p) => isActive(p)) : isActive(item.href);
const esVer = (label: string) => label.startsWith('Ver');
---

<header id="site-header" class="fixed top-0 inset-x-0 z-50">
  <TopBar />

  <div class="header-glass hd-bar">
    <div class="container-site hd-row">

      <!-- ── LOGO ─────────────────────────────────────────────────── -->
      <a href="/" class="hd-brand" aria-label="FIREFIGHTERS MX">
        <svg data-logo viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" class="hd-mark">
          <polygon points="18,2 32,10 32,26 18,34 4,26 4,10" fill="var(--c-accent)"/>
          <path d="M18 10c0 0-5 4-3 8 1 2 3 2 3 2s-1-2 0-4c1-2 3-2 3-2s-1 3 1 5c.8.8 1 2 1 2s2-1.5 2-4c0-3-2-5-2-5s1 2 0 4c0 0-2-4-5-6z" fill="white" opacity="0.95"/>
        </svg>
        <span>
          <span class="hd-name">Firefighters<span> MX</span></span>
          <span class="hd-tag">Equipo contra incendio</span>
        </span>
      </a>

      <!-- ── NAVEGACIÓN DE ESCRITORIO (≥ 1280 px) ───────────────────── -->
      <nav class="hd-nav" aria-label="Navegación principal">
        <ul class="nav-list">
          {navigation.main.map((item) => {
            const drop = item.children ?? null;
            const mega = !!drop?.some((c) => c.children);
            const filasPanel = mega ? Math.max(...drop!.map((c) => c.children?.length ?? 1)) : 0;
            const porDefecto = mega ? drop!.findIndex((c) => c.children) : -1;
            return (
              <>
                {item.zona === 'directorio' && <li class="nav-sep" aria-hidden="true"></li>}
                <li class:list={['nav-group', drop && 'has-drop', activoItem(item) && 'is-current']}>
                  <a href={item.href} class="nav-link" aria-current={isExact(item.href) ? 'page' : undefined}>{item.label}</a>
                  {drop && (
                    <>
                      <button type="button" class="nav-toggle" aria-expanded="false" aria-label={`Mostrar submenú de ${item.label}`}>
                        <span class="caret" aria-hidden="true"></span>
                      </button>
                      <div class:list={['nav-drop', mega ? 'nav-drop--mega' : 'nav-drop--simple', item.zona === 'directorio' && 'nav-drop--right']}>
                        <div class="drop-panel" style={mega ? `--pane-rows:${filasPanel}` : undefined}>
                          <ul class="drop-list">
                            {drop.map((child, i) => {
                              const conPanel = mega && !esVer(child.label) && (child.children || child.description);
                              return (
                                <li class:list={['drop-row', conPanel && 'has-pane', mega && i === porDefecto && 'is-default', esVer(child.label) && 'is-more']}>
                                  <a
                                    href={child.href}
                                    class:list={['drop-link', isActive(child.href) && !esVer(child.label) && (sinBarra(child.href) !== sinBarra(item.href) || isExact(child.href)) && 'is-current']}
                                    aria-current={isExact(child.href) ? 'page' : undefined}
                                  >
                                    <span class="drop-title">{child.label}</span>
                                    {!mega && child.description && !esVer(child.label) && <span class="drop-desc">{child.description}</span>}
                                    {mega && child.children && <span class="caret caret--r" aria-hidden="true"></span>}
                                  </a>
                                  {conPanel && (
                                    <div class="drop-pane">
                                      <p class="pane-title">{child.label}</p>
                                      {child.description && <p class="pane-desc">{child.description}</p>}
                                      {child.children && (
                                        <ul class="pane-list">
                                          {child.children.map((sub) => (
                                            <li>
                                              <a
                                                href={sub.href}
                                                class:list={['pane-link', isActive(sub.href) && 'is-current']}
                                                aria-current={isExact(sub.href) ? 'page' : undefined}
                                              >
                                                <span class="drop-title">{sub.label}</span>
                                                {sub.description && <span class="drop-desc">{sub.description}</span>}
                                              </a>
                                            </li>
                                          ))}
                                        </ul>
                                      )}
                                    </div>
                                  )}
                                </li>
                              );
                            })}
                          </ul>
                        </div>
                      </div>
                    </>
                  )}
                </li>
              </>
            );
          })}
        </ul>
      </nav>

      <!-- ── ACCIONES ─────────────────────────────────────────────── -->
      <div class="hd-actions">
        {TELEFONO_ACTIVO && (
          <a href={`tel:${SITE.phoneE164}`} class="hd-phone">{SITE.phone}</a>
        )}

        <!-- Los wrappers llevan la visibilidad: la regla .btn de global.css
             (display:inline-flex) ganaría a un display:none puesto en el <a>. -->
        {CONTACTO_DIRECTO_ACTIVO && (
          <div class="hd-wa">
            <a href={whatsappUrl('Hola, quiero cotizar equipo para bomberos.')} target="_blank" rel="noopener" class="btn btn-whatsapp btn-sm">WhatsApp</a>
          </div>
        )}

        <div class="hd-cta">
          <a href="/cotizacion/" class="btn btn-primary btn-sm">Cotizar equipo</a>
        </div>

        <!-- Botón del menú móvil / tablet (< 1280 px) -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="mm-open-btn"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span data-mm-label>Menú</span>
        </button>
      </div>
    </div>
  </div>

  <!-- ══ MENÚ MÓVIL ════════════════════════════════════════════════════════
       Panel a pantalla completa bajo el header. El contenido se pide a
       /parciales/menu-movil/ la primera vez que se abre (ver
       MenuMovilContenido.astro), así el markup no viaja en cada página.
  ══════════════════════════════════════════════════════════════════════ -->
  <div id="mobile-menu" hidden role="dialog" aria-modal="true" aria-label="Menú principal" data-parcial="/parciales/menu-movil/">
    <p class="mm-status" role="status">Cargando menú…</p>
  </div>
</header>

<!-- Spacer para compensar el header fixed -->
<div class="h-[71px] md:h-[107px]" aria-hidden="true"></div>

<style is:global>
  /* ════════════════════════════════════════════════════════════════
     HEADER — barra
     Sin animaciones ni transiciones (regla del sitio): los paneles
     aparecen y desaparecen al instante.
  ════════════════════════════════════════════════════════════════ */
  .hd-bar { background: var(--c-bg); border-bottom: 1px solid var(--c-line); }
  .hd-bar.scrolled { box-shadow: 0 4px 16px rgba(16, 24, 40, 0.08); }
  .hd-row { height: 68px; display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; }

  .hd-brand { display: flex; align-items: center; gap: 0.75rem; flex-shrink: 0; }
  .hd-mark { width: 36px; height: 36px; flex-shrink: 0; }
  .hd-name { display: block; font-family: var(--font-display); font-weight: 700; font-size: 1.125rem; line-height: 1; letter-spacing: -0.01em; color: var(--c-ink); }
  .hd-name > span { color: var(--c-accent); }
  .hd-tag { display: block; margin-top: 0.3125rem; font-size: 0.625rem; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; line-height: 1; color: var(--c-muted); }

  /* ── Navegación de escritorio ── */
  .hd-nav { display: none; align-self: stretch; }
  @media (min-width: 1280px) { .hd-nav { display: block; } }
  .nav-list { display: flex; align-items: stretch; height: 100%; margin: 0; padding: 0; list-style: none; }
  .nav-sep { align-self: center; width: 1px; height: 1.5rem; margin: 0 0.5rem; background: var(--c-line-strong); }
  .nav-group { position: relative; display: flex; align-items: stretch; }

  .nav-link { display: flex; align-items: center; padding: 0 0.625rem; font-size: 0.875rem; font-weight: 500; color: var(--c-ink-2); white-space: nowrap; }
  .nav-group.has-drop .nav-link { padding-right: 0.125rem; }
  .nav-toggle { display: flex; align-items: center; justify-content: center; width: 1.375rem; margin: 0 0.125rem 0 0; padding: 0; background: none; border: 0; color: var(--c-muted); cursor: pointer; }
  .nav-link:focus-visible, .nav-toggle:focus-visible { outline: 2px solid var(--c-accent); outline-offset: -3px; border-radius: 6px; }

  /* Caret dibujado con bordes (indicador funcional, no es un ícono) */
  .caret { display: block; width: 0.4375rem; height: 0.4375rem; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-2px) rotate(45deg); }
  .caret--r { flex: none; transform: rotate(-45deg); color: var(--c-muted); }

  /* Estado: hover, abierto por clic/teclado, sección actual */
  .nav-group:hover .nav-link, .nav-group.is-open .nav-link { color: var(--c-ink); }
  .nav-group.is-current .nav-link { color: var(--c-accent); }
  .nav-group:hover .nav-toggle, .nav-group.is-open .nav-toggle { color: var(--c-accent); }
  .nav-group:hover .nav-toggle .caret, .nav-group.is-open .nav-toggle .caret { transform: translateY(2px) rotate(225deg); }
  .nav-group::after { content: ''; position: absolute; left: 0.625rem; right: 0.5rem; bottom: -1px; height: 2px; background: var(--c-ink); display: none; }
  .nav-group.has-drop::after { right: 0.375rem; }
  .nav-group:hover::after, .nav-group.is-open::after, .nav-group.is-current::after { display: block; }

  /* ── Paneles desplegables ── */
  .nav-drop { display: none; position: absolute; top: calc(100% + 1px); left: 0; z-index: 60; }
  .nav-drop--right { left: auto; right: 0; }
  .nav-group:hover > .nav-drop, .nav-group.is-open > .nav-drop, .nav-group:has(.nav-drop :focus-visible) > .nav-drop { display: block; }

  .drop-panel {
    position: relative; display: flex; flex-direction: column;
    max-height: calc(100dvh - 132px);
    background: var(--c-bg); border: 1px solid var(--c-line); border-top: 0;
    border-radius: 0 0 var(--radius-card) var(--radius-card);
    box-shadow: 0 16px 40px rgba(16, 24, 40, 0.12), 0 2px 6px rgba(16, 24, 40, 0.05);
  }
  .nav-drop--simple .drop-panel { width: 21rem; }
  .nav-drop--mega .drop-panel { --col: 16.5rem; width: 41rem; }

  .drop-list { margin: 0; padding: 0.5rem; list-style: none; overflow-y: auto; overscroll-behavior: contain; }
  .drop-link { display: block; padding: 0.5625rem 0.75rem; border-radius: 6px; color: var(--c-ink-2); }
  .drop-title { display: block; font-size: 0.875rem; font-weight: 500; line-height: 1.35; color: inherit; }
  .drop-desc { display: block; margin-top: 0.125rem; font-size: 0.75rem; line-height: 1.4; color: var(--c-muted); }
  .drop-link:hover, .drop-row:hover > .drop-link { background: var(--c-tint); color: var(--c-ink); }
  .drop-link.is-current, .pane-link.is-current { color: var(--c-accent); }
  .drop-link:focus-visible, .pane-link:focus-visible { outline: 2px solid var(--c-accent); outline-offset: -2px; }
  .drop-row.is-more { margin-top: 0.25rem; padding-top: 0.25rem; border-top: 1px solid var(--c-line); }

  /* Mega: lista de categorías a la izquierda, detalle a la derecha.
     La lista hace scroll propio; el detalle (.drop-pane) se ancla al panel,
     no a la lista, así que ni el scroll ni el ancho lo recortan. */
  .nav-drop--mega .drop-list { width: var(--col); min-height: calc(var(--pane-rows) * 3.1rem + 7.5rem); }
  .drop-row { position: static; }
  .nav-drop--mega .drop-link { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .drop-pane {
    display: none; position: absolute; top: 0; bottom: 0; left: var(--col); right: 0;
    padding: 1.25rem 1.5rem; overflow-y: auto; overscroll-behavior: contain;
    background: var(--c-tint); border-left: 1px solid var(--c-line);
    border-radius: 0 0 var(--radius-card) 0;
  }
  .drop-row:hover > .drop-pane, .drop-row:focus-within > .drop-pane { display: block; }
  .drop-panel:not(:has(.drop-row:hover, .drop-row:focus-within)) .drop-row.is-default > .drop-pane { display: block; }
  .drop-panel:not(:has(.drop-row:hover, .drop-row:focus-within)) .drop-row.is-default > .drop-link,
  .drop-row.has-pane:focus-within > .drop-link { background: var(--c-tint); color: var(--c-ink); }
  .pane-title { margin: 0; font-size: 1rem; font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; color: var(--c-ink); }
  .pane-desc { margin: 0.25rem 0 0; font-size: 0.8125rem; line-height: 1.45; color: var(--c-muted); }
  .pane-list { margin: 0.875rem 0 0; padding: 0.5rem 0 0; list-style: none; border-top: 1px solid var(--c-line); }
  .pane-link { display: block; margin: 0 -0.5rem; padding: 0.3125rem 0.5rem; border-radius: 6px; color: var(--c-ink-2); }
  .pane-link:hover { background: var(--c-bg); color: var(--c-accent); }

  /* ── Acciones ── */
  .hd-actions { display: flex; align-items: center; gap: 0.5rem; flex-shrink: 0; }
  .hd-phone { display: none; padding: 0 0.5rem; font-size: 0.875rem; font-weight: 500; color: var(--c-ink-2); white-space: nowrap; }
  .hd-phone:hover { color: var(--c-accent); }
  .hd-wa { display: none; }
  .hd-cta { display: none; }
  @media (min-width: 640px)  { .hd-cta { display: block; } }
  @media (min-width: 1440px) { .hd-wa { display: block; } }
  @media (min-width: 1600px) { .hd-phone { display: inline-flex; } }

  .mm-open-btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 5rem; min-height: 2.75rem; padding: 0 1rem;
    background: var(--c-bg); color: var(--c-ink);
    border: 1px solid var(--c-line-strong); border-radius: var(--radius-btn);
    font-family: inherit; font-size: 0.875rem; font-weight: 600; line-height: 1; cursor: pointer;
  }
  .mm-open-btn[aria-expanded="true"] { background: var(--c-ink); border-color: var(--c-ink); color: #fff; }
  @media (min-width: 1280px) { .mm-open-btn { display: none; } }
  /* Pantallas muy angostas (320–380 px): sin la línea descriptiva del logo para que el botón siempre quepa. */
  @media (max-width: 380px) { .hd-tag { display: none; } .hd-row { gap: 0.75rem; } .mm-open-btn { min-width: 4.5rem; padding: 0 0.75rem; } }

  /* ════════════════════════════════════════════════════════════════
     MENÚ MÓVIL / TABLET — panel a pantalla completa bajo el header
     El markup llega por fetch: los estilos viven aquí y son globales.
  ════════════════════════════════════════════════════════════════ */
  #mobile-menu {
    position: absolute; left: 0; right: 0; top: 100%;
    height: calc(100dvh - var(--mm-top, 69px));
    display: flex; flex-direction: column;
    background: var(--c-bg); border-top: 1px solid var(--c-line);
  }
  #mobile-menu[hidden] { display: none; }
  html.mm-lock, html.mm-lock body { overflow: hidden; }
  /* El botón flotante de WhatsApp taparía las acciones del panel (que ya incluyen WhatsApp). */
  html.mm-lock #whatsapp-btn { display: none; }

  .mm-scroll { flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; padding: 0.25rem 0 1.5rem; }
  .mm-nav { max-width: 42rem; margin: 0 auto; padding: 0 1rem; }
  .mm-list { margin: 0; padding: 0; list-style: none; }
  .mm-l1 { border-bottom: 1px solid var(--c-line); }
  .mm-row { display: flex; align-items: stretch; }

  .mm-link { flex: 1 1 auto; display: flex; flex-direction: column; justify-content: center; min-height: 3.25rem; padding: 0.5rem 0.25rem; font-size: 1rem; font-weight: 600; line-height: 1.3; color: var(--c-ink); }
  .mm-l2 .mm-link { min-height: 3rem; font-size: 0.9375rem; font-weight: 500; color: var(--c-ink-2); }
  .mm-l3 .mm-link { min-height: 2.75rem; font-size: 0.875rem; font-weight: 500; color: var(--c-text-2); }
  .mm-link.is-current { color: var(--c-accent); }
  .mm-desc { display: block; margin-top: 0.125rem; font-size: 0.75rem; font-weight: 400; line-height: 1.4; color: var(--c-muted); }
  .mm-link:active { background: var(--c-tint); }
  .mm-link:focus-visible, .mm-toggle:focus-visible { outline: 2px solid var(--c-accent); outline-offset: -2px; border-radius: 6px; }

  .mm-toggle { flex: none; display: flex; align-items: center; justify-content: center; width: 3.25rem; min-height: 3rem; margin: 0; padding: 0; background: none; border: 0; border-left: 1px solid var(--c-line); color: var(--c-muted); cursor: pointer; }
  .mm-toggle[aria-expanded="true"] { color: var(--c-accent); }
  .mm-toggle .caret { width: 0.5rem; height: 0.5rem; transform: translateY(-2px) rotate(45deg); }
  .mm-toggle[aria-expanded="true"] .caret { transform: translateY(2px) rotate(225deg); }

  .mm-panel { margin: 0 0 0.5rem 0.25rem; padding: 0 0 0 0.75rem; border-left: 2px solid var(--c-line); }
  .mm-panel[hidden] { display: none; }
  .mm-sublist { margin: 0; padding: 0; list-style: none; }
  .mm-l3 { margin: 0; padding: 0; }
  .mm-l2 > .mm-row .mm-toggle { min-height: 3rem; }

  .mm-eyebrow { margin: 1.5rem 0 0.25rem; padding: 0 0.25rem; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--c-muted); }

  .mm-foot { flex: none; padding: 0.75rem 1rem calc(0.75rem + env(safe-area-inset-bottom)); background: var(--c-bg); border-top: 1px solid var(--c-line); box-shadow: 0 -4px 12px rgba(16, 24, 40, 0.06); }
  .mm-cta { display: grid; grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); gap: 0.75rem; max-width: 42rem; margin: 0 auto; }
  .mm-cta .btn { width: 100%; min-height: 3rem; }
  .mm-contact { max-width: 42rem; margin: 0.625rem auto 0; font-size: 0.8125rem; line-height: 1.4; color: var(--c-muted); text-align: center; }
  .mm-contact a { font-weight: 600; color: var(--c-ink-2); }
  @media (max-height: 520px) { .mm-contact { display: none; } }

  .mm-status { margin: 0; padding: 2rem 1rem; text-align: center; font-size: 0.9375rem; color: var(--c-muted); }
  .mm-status .btn { margin: 0.75rem 0.25rem 0; }
</style>

<script>
/* ════════════════════════════════════════════════════════════════
   MENÚ MÓVIL / TABLET — abrir, cerrar, acordeones, foco y accesibilidad
════════════════════════════════════════════════════════════════ */
const hdr   = document.getElementById('site-header');
const btn   = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
const menu  = document.getElementById('mobile-menu') as HTMLElement | null;
const label = btn?.querySelector<HTMLElement>('[data-mm-label]');
const XL    = window.matchMedia('(min-width: 1280px)');

let cargando = false;

const abierto = () => !!menu && !menu.hidden;

/* El panel ocupa todo el alto libre bajo el header (con o sin TopBar). */
function medirHeader() {
  if (hdr && menu) menu.style.setProperty('--mm-top', `${Math.round(hdr.getBoundingClientRect().height)}px`);
}

/* Mientras el menú está abierto, el resto de la página no recibe foco ni lector de pantalla. */
function aislarPagina(aislar: boolean) {
  Array.from(document.body.children).forEach((el) => {
    if (el === hdr || el.tagName === 'SCRIPT') return;
    (el as HTMLElement).inert = aislar;
  });
}

function abrirPanel(b: HTMLButtonElement, abrir: boolean) {
  const panel = b.getAttribute('aria-controls') ? document.getElementById(b.getAttribute('aria-controls')!) : null;
  b.setAttribute('aria-expanded', String(abrir));
  if (panel) panel.hidden = !abrir;
}

function alternar(b: HTMLButtonElement) {
  const abrir = b.getAttribute('aria-expanded') !== 'true';
  /* Acordeón exclusivo en el primer nivel: una sección abierta a la vez. */
  if (abrir && b.dataset.nivel === '1') {
    menu?.querySelectorAll<HTMLButtonElement>('.mm-toggle[data-nivel="1"]').forEach((o) => {
      if (o !== b) abrirPanel(o, false);
    });
  }
  abrirPanel(b, abrir);
  if (abrir) b.closest('.mm-l1')?.scrollIntoView({ block: 'nearest' });
}

/* Mismo criterio que el header de escritorio: coincidencia por segmento. */
const sinBarra = (s: string) => s.replace(/\/$/, '');
function enSegmento(aqui: string, href: string) {
  if (href === '/') return aqui === '/';
  const base = sinBarra(href);
  return sinBarra(aqui) === base || aqui.startsWith(base + '/');
}

/* El parcial es el mismo para todas las páginas: la sección actual se marca
   aquí, en cliente, y su acordeón se abre solo. */
function marcaActivos(root: HTMLElement) {
  const aqui = location.pathname;
  root.querySelectorAll<HTMLAnchorElement>('a.mm-link[href^="/"]').forEach((a) => {
    const href = a.getAttribute('href') || '';
    const exacto = sinBarra(aqui) === sinBarra(href) || (href === '/' && aqui === '/');
    /* Un enlace anidado que apunta al mismo destino que su sección (p. ej.
       «Catálogo completo» → /productos) sólo cuenta cuando es exacto. */
    const l1 = a.closest('.mm-l1')?.querySelector<HTMLAnchorElement>(':scope > .mm-row > .mm-link');
    const repite = l1 && l1 !== a && sinBarra(l1.getAttribute('href') || '') === sinBarra(href);
    if (!(repite ? exacto : enSegmento(aqui, href))) return;
    a.classList.add('is-current');
    if (exacto) a.setAttribute('aria-current', 'page');
    let p = a.closest<HTMLElement>('.mm-panel');
    while (p) {
      const t = root.querySelector<HTMLButtonElement>(`[aria-controls="${p.id}"]`);
      if (t) abrirPanel(t, true);
      p = p.parentElement?.closest<HTMLElement>('.mm-panel') ?? null;
    }
  });
  /* La zona Directorio se resalta cuando cualquiera de sus páginas está activa. */
  root.querySelectorAll<HTMLElement>('.mm-l1').forEach((li) => {
    if (li.querySelector('.mm-panel a.is-current')) {
      li.querySelector(':scope > .mm-row > .mm-link')?.classList.add('is-current');
    }
  });
}

/* Sin red o parcial caído: se arma un menú mínimo con los enlaces de la
   barra de escritorio, que siempre viajan en el HTML. */
function menuDeEmergencia() {
  if (!menu) return;
  menu.replaceChildren();
  const scroll = document.createElement('div');
  scroll.className = 'mm-scroll';
  const aviso = document.createElement('div');
  aviso.className = 'mm-status';
  const p = document.createElement('p');
  p.textContent = 'No se pudo cargar el menú completo.';
  const reintentar = document.createElement('button');
  reintentar.type = 'button';
  reintentar.className = 'btn btn-primary btn-sm';
  reintentar.dataset.mmRetry = '1';
  reintentar.textContent = 'Reintentar';
  aviso.append(p, reintentar);
  const ul = document.createElement('ul');
  ul.className = 'mm-list mm-nav';
  document.querySelectorAll<HTMLAnchorElement>('.hd-nav .nav-link').forEach((src) => {
    const li = document.createElement('li');
    li.className = 'mm-l1';
    const a = document.createElement('a');
    a.className = 'mm-link';
    a.href = src.getAttribute('href') || '/';
    a.textContent = src.textContent;
    const row = document.createElement('div');
    row.className = 'mm-row';
    row.append(a);
    li.append(row);
    ul.append(li);
  });
  scroll.append(aviso, ul);
  menu.append(scroll);
}

async function cargarMenu() {
  if (!menu || cargando || menu.dataset.cargado === '1') return;
  const url = menu.dataset.parcial;
  if (!url) return;
  cargando = true;
  menu.setAttribute('aria-busy', 'true');
  try {
    const r = await fetch(url);
    if (!r.ok) throw new Error(String(r.status));
    /* El parcial se sirve como página estática: Astro le antepone un
       doctype que aquí no pinta nada. */
    menu.innerHTML = (await r.text()).replace(/^\s*<!DOCTYPE[^>]*>/i, '');
    menu.dataset.cargado = '1';
    marcaActivos(menu);
  } catch {
    menuDeEmergencia();
  } finally {
    cargando = false;
    menu.removeAttribute('aria-busy');
  }
}

/* Precarga en cuanto el dedo o el cursor llega al botón. */
['pointerenter', 'touchstart', 'focus'].forEach((ev) =>
  btn?.addEventListener(ev, () => { void cargarMenu(); }, { once: true, passive: true }),
);

function setMenuOpen(open: boolean) {
  if (!menu || !btn || open === abierto()) return;
  if (open) { medirHeader(); void cargarMenu(); }
  menu.hidden = !open;
  btn.setAttribute('aria-expanded', String(open));
  btn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  if (label) label.textContent = open ? 'Cerrar' : 'Menú';
  document.documentElement.classList.toggle('mm-lock', open);
  aislarPagina(open);
}

btn?.addEventListener('click', () => setMenuOpen(!abierto()));

/* Delegación: el contenido llega por fetch, así que un solo listener sirve
   para el markup actual y para cualquier recarga. */
menu?.addEventListener('click', (e) => {
  const t = e.target as HTMLElement;
  const toggle = t.closest<HTMLButtonElement>('.mm-toggle');
  if (toggle) { alternar(toggle); return; }
  if (t.closest('[data-mm-retry]')) {
    menu.dataset.cargado = '';
    menu.replaceChildren();
    const s = document.createElement('p');
    s.className = 'mm-status';
    s.textContent = 'Cargando menú…';
    menu.append(s);
    void cargarMenu();
    return;
  }
  if (t.closest('a[href]')) setMenuOpen(false);
});

document.addEventListener('keydown', (e) => {
  if (!abierto() || !menu || !btn) return;
  if (e.key === 'Escape') { e.preventDefault(); setMenuOpen(false); btn.focus(); return; }
  if (e.key !== 'Tab') return;
  /* Foco atrapado: botón del header + contenido visible del panel. */
  const foco = [btn, ...Array.from(menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'))]
    .filter((el) => el === btn || el.offsetParent !== null);
  const primero = foco[0];
  const ultimo = foco[foco.length - 1];
  if (e.shiftKey && document.activeElement === primero) { e.preventDefault(); ultimo.focus(); }
  else if (!e.shiftKey && document.activeElement === ultimo) { e.preventDefault(); primero.focus(); }
});

/* Rotar el dispositivo o cambiar el tamaño reajusta el panel; llegar a escritorio lo cierra. */
window.addEventListener('resize', () => { if (abierto()) medirHeader(); }, { passive: true });
XL.addEventListener('change', (e) => { if (e.matches) setMenuOpen(false); });

/* ════════════════════════════════════════════════════════════════
   NAVEGACIÓN DE ESCRITORIO — paneles por hover, clic (táctil) y teclado
   El hover abre por CSS. El botón de flecha abre por clic y por teclado
   (pantallas táctiles ≥ 1280 px, lectores de pantalla). Escape y clic
   fuera cierran.
════════════════════════════════════════════════════════════════ */
const grupos = Array.from(document.querySelectorAll<HTMLElement>('.nav-group.has-drop'));

function cerrarGrupos(salvo?: HTMLElement) {
  grupos.forEach((g) => {
    if (g === salvo) return;
    g.classList.remove('is-open');
    g.querySelector('.nav-toggle')?.setAttribute('aria-expanded', 'false');
  });
}

/* El panel se recoloca si se saldría de la ventana por el lado horizontal. */
function ajustar(g: HTMLElement) {
  const d = g.querySelector<HTMLElement>('.nav-drop');
  if (!d) return;
  d.style.left = ''; d.style.right = '';
  const r = d.getBoundingClientRect();
  if (!r.width) return;
  const M = 8;
  if (r.right > window.innerWidth - M) { d.style.left = 'auto'; d.style.right = '0px'; }
  else if (r.left < M) { d.style.right = 'auto'; d.style.left = '0px'; }
}

grupos.forEach((g) => {
  const t = g.querySelector<HTMLButtonElement>('.nav-toggle');
  t?.addEventListener('click', (e) => {
    e.stopPropagation();
    const abrir = !g.classList.contains('is-open');
    cerrarGrupos(g);
    g.classList.toggle('is-open', abrir);
    t.setAttribute('aria-expanded', String(abrir));
    if (abrir) ajustar(g);
  });
  g.addEventListener('mouseenter', () => { cerrarGrupos(g); ajustar(g); });
  g.addEventListener('focusin', () => ajustar(g));
});

document.addEventListener('click', (e) => {
  if (!(e.target as HTMLElement).closest('.nav-group')) cerrarGrupos();
});

document.addEventListener('keydown', (e) => {
  if (e.key !== 'Escape') return;
  const g = grupos.find((x) => x.classList.contains('is-open') || x.contains(document.activeElement));
  if (!g) return;
  cerrarGrupos();
  const t = g.querySelector<HTMLElement>('.nav-toggle');
  if (g.contains(document.activeElement) && document.activeElement !== t) t?.focus();
});

/* ════════════════════════════════════════════════════════════════
   SOMBRA del header al hacer scroll
════════════════════════════════════════════════════════════════ */
const barra = hdr?.querySelector('.header-glass');
window.addEventListener('scroll', () => {
  barra?.classList.toggle('scrolled', window.scrollY > 8);
}, { passive: true });
</script>
