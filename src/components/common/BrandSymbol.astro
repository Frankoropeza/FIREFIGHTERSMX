---
/**
 * Símbolo VIGILES (concepto C: V + llama). Decorativo: el enlace que lo contiene
 * lleva el aria-label. `variant="dark"` para fondos oscuros (footer).
 */
interface Props { variant?: 'light' | 'dark'; class?: string }
const { variant = 'light', class: cls = '' } = Astro.props;
const v = variant === 'dark' ? '#FFFFFF' : '#0A0A0A';
---
<svg data-logo viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false" class={cls}>
  <g transform="translate(1.28 1.28) scale(.96)">
    <path fill="#C8102E" transform="translate(0 0.6)" d="M32 43.2 15.6 18.6C15.4 13.600 18 10.600 22 6.600c0 4 2 6.500 4 8-1-6 3-10 8-14 0 5 2 8 4 11 2-1.500 3-4 3-7 4 4 7 8 7 14z"/>
    <path fill={v} d="M4 22h12l16 24 16-24h12L32 62z"/>
  </g>
</svg>
