---
/** Logo raster horizontal de INPROSEG FIRE; `tagline` se conserva por compatibilidad. */
interface Props {
  tagline?: string;
  variant?: 'light' | 'dark';
  class?: string;
}
const { variant = 'light', class: cls = '' } = Astro.props;
const dark = variant === 'dark';
const stem = dark ? '/brand/inproseg-fire-horizontal-dark' : '/brand/inproseg-fire-horizontal';
---

<span class:list={['bl', `bl--${variant}`, cls]}>
  <picture>
    <source srcset={`${stem}-h120.webp 1x, ${stem}-h240.webp 2x`} type="image/webp" />
    <img src={`${stem}-h240.png`} width="444" height="120" alt="INPROSEG FIRE" decoding="async" fetchpriority={dark ? undefined : "high"} loading={dark ? "lazy" : undefined} />
  </picture>
</span>

<style is:global>
  .bl { display: inline-flex; align-items: center; min-width: 0; }
  .bl picture, .bl img { display: block; }
  .bl img { width: auto; height: var(--logo-h, 54px); max-width: 100%; object-fit: contain; }
</style>
