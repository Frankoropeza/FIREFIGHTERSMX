---
/**
 * Barra de botones segmentados full-width para interlinking.
 * - variant="top": bajo el hero (secciones principales + CTA WhatsApp)
 * - variant="footer": arriba del footer (secciones de empresa + CTA cotización)
 * Excluye automáticamente el link de la página actual y rellena desde el pool.
 */

export interface Props {
  variant?: 'top' | 'footer';
}

const { variant = 'top' } = Astro.props;

interface QuickLink {
  label: string;
  sub: string;
  href: string;
  icon: string;
}

// Dos juegos de accesos: la tienda (FIREFIGHTERS MX como vendedor) y el
// directorio (registros de terceros). La zona sale de la ruta actual.
const rutaActual = Astro.url.pathname;
const esDirectorio = ['/directorio', '/empresas', '/estaciones', '/cobertura'].some((p) => rutaActual.startsWith(p));

const poolsTienda: Record<'top' | 'footer', QuickLink[]> = {
  top: [
    { label: 'Catálogo de equipo', sub: '10 categorías NFPA · NOM', href: '/productos', icon: `` },
    { label: 'Trajes para bomberos', sub: 'NFPA 1970 · Globe · Lion', href: '/productos/trajes-bombero', icon: `` },
    { label: 'Sistemas contra incendio', sub: 'Rociadores · Detección · Alarma', href: '/productos/sistemas-ci', icon: `` },
    { label: 'Extintores', sub: 'PQS NOM-100-STPS · CO₂ NOM-102-STPS · NFPA 10', href: '/productos/extintores', icon: `` },
    { label: 'Nuestros servicios', sub: 'Capacitación · Mantenimiento', href: '/servicios', icon: `` },
  ],
  footer: [
    { label: 'Industrias que equipamos', sub: 'Bomberos · Industria · PC', href: '/industrias', icon: `` },
    { label: 'Blog técnico', sub: 'Guías NFPA y NOM', href: '/blog', icon: `` },
    { label: 'Certificaciones', sub: 'Qué normas aplican a tu giro', href: '/certificaciones', icon: `` },
    { label: 'Cobertura y envíos', sub: '32 estados · 24-48 h CDMX', href: '/distribuidores', icon: `` },
    { label: 'Soporte a licitaciones', sub: 'CompraNet · fichas técnicas', href: '/licitaciones', icon: `` },
  ],
};

const poolsDirectorio: Record<'top' | 'footer', QuickLink[]> = {
  top: [
    { label: 'Directorio de empresas', sub: '5 giros · 32 estados', href: '/empresas', icon: `` },
    { label: 'Estaciones de bomberos', sub: 'Directorio · 32 estados', href: '/estaciones', icon: `` },
    { label: 'Equipo para bomberos', sub: 'Catálogo FIREFIGHTERS MX', href: '/productos', icon: `` },
    { label: 'Nuestros servicios', sub: 'Capacitación · Mantenimiento', href: '/servicios', icon: `` },
    { label: 'Trajes para bomberos', sub: 'NFPA 1970 · SCBA', href: '/productos/trajes-bombero', icon: `` },
    { label: 'Sistemas contra incendio', sub: 'Rociadores · Alarmas NFPA', href: '/productos/sistemas-ci', icon: `` },
    { label: 'Extintores', sub: 'PQS NOM-100-STPS · CO₂ NOM-102-STPS · NFPA 10', href: '/productos/extintores', icon: `` },
  ],
  footer: [
    { label: 'Directorio de empresas', sub: 'Proveedores por giro y estado', href: '/empresas', icon: `` },
    { label: 'Industrias', sub: 'Bomberos · Industria · PC', href: '/industrias', icon: `` },
    { label: 'Blog técnico', sub: 'Guías NFPA y NOM', href: '/blog', icon: `` },
    { label: 'Estaciones de Bomberos', sub: 'Directorio · 32 estados', href: '/estaciones', icon: `` },
    { label: 'Certificaciones', sub: 'Qué normas aplican a tu giro', href: '/certificaciones', icon: `` },
    { label: 'Empresas por estado', sub: 'Directorio · 32 estados', href: '/cobertura', icon: `` },
    { label: 'Soporte a licitaciones', sub: 'CompraNet · PEMEX · CFE', href: '/licitaciones', icon: `` },
  ],
};

const ctasTienda = {
  top:    { label: 'Cotizar equipo', sub: 'Envíos a los 32 estados', href: '/cotizacion', external: false },
  footer: { label: 'Solicitar cotización', sub: 'Distribuidor autorizado', href: '/cotizacion', external: false },
};

const ctasDirectorio = {
  top: {
    label: 'Registrar mi empresa',
    sub: 'Alta básica gratuita',
    href: '/empresas/registro',
    external: false,
  },
  footer: {
    label: 'Reclamar mi ficha',
    sub: 'Verifica tus datos',
    href: '/empresas/registro',
    external: false,
  },
};

// Excluir el link de la página actual; mostrar 4 + CTA
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const pools = esDirectorio ? poolsDirectorio : poolsTienda;
const links = pools[variant].filter((l) => l.href !== pathname).slice(0, 4);
const cta = (esDirectorio ? ctasDirectorio : ctasTienda)[variant];
---

<nav aria-label={variant === 'top' ? 'Accesos rápidos' : 'Más secciones del sitio'} style="background:#070E1A;border-top:1px solid rgba(74,117,153,0.25);border-bottom:1px solid rgba(74,117,153,0.25)">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 w-full">

    {links.map((l) => (
      <a
        href={l.href}
        class="quick-link group flex items-center justify-center gap-3 py-5 px-4"
        style="border-bottom:1px solid rgba(74,117,153,0.15);border-right:1px solid rgba(74,117,153,0.15)"
      >
        <span class="w-6 h-6 shrink-0 block" style="color:#FF6B26" set:html={l.icon}/>
        <span class="flex flex-col min-w-0">
          <span class="font-display font-bold text-sm uppercase tracking-wider leading-tight group-hover:text-[#FF6B26]" style="color:#FFFFFF;letter-spacing:0.08em">
            {l.label}
          </span>
          <span class="text-[10px] uppercase tracking-widest mt-0.5" style="color:var(--forge-300)">{l.sub}</span>
        </span>
      </a>
    ))}

    <!-- CTA primario -->
    <a
      href={cta.href}
      target={cta.external ? '_blank' : undefined}
      rel={cta.external ? 'noopener' : undefined}
      class="quick-link-cta group flex items-center justify-center gap-3 py-5 px-4"
      style="background:#F75000;border-bottom:1px solid rgba(74,117,153,0.15)"
    >
      <span class="flex flex-col min-w-0">
        <span class="font-display font-bold text-sm uppercase tracking-wider leading-tight" style="color:#FFFFFF;letter-spacing:0.08em">
          {cta.label}
        </span>
        <span class="text-[10px] uppercase tracking-widest mt-0.5" style="color:rgba(255,255,255,0.75)" set:html={cta.sub}/>
      </span>
    </a>

  </div>
</nav>

<style>
  /* Hover instantáneo, sin transiciones */
  .quick-link { background: #070E1A; }
  .quick-link:hover { background: #0C1825; }
  .quick-link-cta:hover { background: #FF6B26 !important; }
</style>
