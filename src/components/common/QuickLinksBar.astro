---
/**
 * Barra de botones segmentados full-width para interlinking.
 * - variant="top": bajo el hero (secciones principales + CTA WhatsApp)
 * - variant="footer": arriba del footer (secciones de empresa + CTA cotización)
 * Excluye automáticamente el link de la página actual y rellena desde el pool.
 */

export interface Props {
  variant?: 'top' | 'footer';
}

const { variant = 'top' } = Astro.props;

interface QuickLink {
  label: string;
  sub: string;
  href: string;
  icon: string;
}

const pools: Record<'top' | 'footer', QuickLink[]> = {
  top: [
    { label: 'Directorio de empresas', sub: '5 giros · 32 estados', href: '/empresas', icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6M9 9h.01M15 9h.01M9 13h.01M15 13h.01"/></svg>` },
    { label: 'Estaciones de bomberos', sub: 'Directorio · 32 estados', href: '/estaciones', icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>` },
    { label: 'Guías de compra', sub: '9 categorías NFPA · NOM', href: '/productos', icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>` },
    { label: 'Nuestros servicios', sub: 'Capacitación · Mantenimiento', href: '/servicios', icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>` },
    { label: 'Equipo para bomberos', sub: 'Trajes NFPA 1970 · SCBA', href: '/productos/trajes-bombero', icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>` },
    { label: 'Sistemas contra incendio', sub: 'Rociadores · Alarmas NFPA', href: '/productos/sistemas-ci', icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2z"/><path d="M8 12h8M12 8v8"/></svg>` },
    { label: 'Extintores certificados', sub: 'NOM-154-SCFI · NFPA 10', href: '/productos/extintores', icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M15 6v-3a3 3 0 0 0-6 0v3"/><rect x="6" y="6" width="12" height="14" rx="2"/><path d="M10 11h4M12 11v4"/></svg>` },
  ],
  footer: [
    { label: 'Directorio de empresas', sub: 'Proveedores por giro y estado', href: '/empresas', icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 21v-6h6v6M9 9h.01M15 9h.01M9 13h.01M15 13h.01"/></svg>` },
    { label: 'Industrias que atendemos', sub: 'Bomberos · Industria · PC', href: '/industrias', icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>` },
    { label: 'Blog técnico', sub: 'Guías NFPA y NOM', href: '/blog', icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>` },
    { label: 'Estaciones de Bomberos', sub: 'Directorio · 32 estados', href: '/estaciones', icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>` },
    { label: 'Certificaciones', sub: 'Qué normas aplican a tu giro', href: '/certificaciones', icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>` },
    { label: 'Cobertura nacional', sub: '32 estados · 24-48 h CDMX', href: '/cobertura', icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>` },
    { label: 'Soporte a licitaciones', sub: 'CompraNet · PEMEX · CFE', href: '/licitaciones', icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8"/></svg>` },
  ],
};

const ctas = {
  top: {
    label: 'Registrar mi empresa',
    sub: 'Alta básica gratuita',
    href: '/empresas/registro',
    external: false,
  },
  footer: {
    label: 'Reclamar mi ficha',
    sub: 'Verifica tus datos',
    href: '/empresas/registro',
    external: false,
  },
};

// Excluir el link de la página actual; mostrar 4 + CTA
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = pools[variant].filter((l) => l.href !== pathname).slice(0, 4);
const cta = ctas[variant];
---

<nav aria-label={variant === 'top' ? 'Accesos rápidos' : 'Más secciones del sitio'} style="background:#070E1A;border-top:1px solid rgba(74,117,153,0.25);border-bottom:1px solid rgba(74,117,153,0.25)">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 w-full">

    {links.map((l) => (
      <a
        href={l.href}
        class="quick-link group flex items-center justify-center gap-3 py-5 px-4"
        style="border-bottom:1px solid rgba(74,117,153,0.15);border-right:1px solid rgba(74,117,153,0.15)"
      >
        <span class="w-6 h-6 shrink-0 block" style="color:#FF6B26" set:html={l.icon}/>
        <span class="flex flex-col min-w-0">
          <span class="font-display font-bold text-sm uppercase tracking-wider leading-tight group-hover:text-[#FF6B26]" style="color:#FFFFFF;letter-spacing:0.08em">
            {l.label}
          </span>
          <span class="text-[10px] uppercase tracking-widest mt-0.5" style="color:#4A7599">{l.sub}</span>
        </span>
      </a>
    ))}

    <!-- CTA primario -->
    <a
      href={cta.href}
      target={cta.external ? '_blank' : undefined}
      rel={cta.external ? 'noopener' : undefined}
      class="quick-link-cta group flex items-center justify-center gap-3 py-5 px-4"
      style="background:#F75000;border-bottom:1px solid rgba(74,117,153,0.15)"
    >
      {cta.external ? (
        <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24" style="color:#FFFFFF" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        </svg>
      ) : (
        <svg class="w-5 h-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="#FFFFFF" stroke-width="2" aria-hidden="true">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8"/>
        </svg>
      )}
      <span class="flex flex-col min-w-0">
        <span class="font-display font-bold text-sm uppercase tracking-wider leading-tight" style="color:#FFFFFF;letter-spacing:0.08em">
          {cta.label}
        </span>
        <span class="text-[10px] uppercase tracking-widest mt-0.5" style="color:rgba(255,255,255,0.75)" set:html={cta.sub}/>
      </span>
    </a>

  </div>
</nav>

<style>
  /* Hover instantáneo, sin transiciones */
  .quick-link { background: #070E1A; }
  .quick-link:hover { background: #0C1825; }
  .quick-link-cta:hover { background: #FF6B26 !important; }
</style>
