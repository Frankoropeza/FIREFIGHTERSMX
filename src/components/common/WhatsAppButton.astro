---
import { SITE } from '@data/site';
const phone = SITE.whatsapp;
const message = '¡Hola! Visité FIREFIGHTERS MX y me gustaría obtener información sobre sus equipos y servicios.';
const whatsappUrl = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-6 right-6 z-50 w-14 h-14 bg-green-500 hover:bg-green-600 active:bg-green-700
         rounded-full flex items-center justify-center shadow-lg hover:shadow-xl
         transition-all duration-300 hover:scale-110 group"
  aria-label="Contactar por WhatsApp"
  id="whatsapp-btn"
>
  <!-- WhatsApp Icon -->
  <svg
    class="w-7 h-7 text-white"
    fill="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
  >
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347zM12 0C5.373 0 0 5.373 0 12c0 2.107.548 4.086 1.508 5.808L.057 23.386a.5.5 0 00.615.614l5.578-1.451C7.914 23.452 9.893 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22c-1.922 0-3.717-.516-5.258-1.415l-.377-.22-3.934 1.023 1.026-3.934-.228-.389A9.944 9.944 0 012 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/>
  </svg>

  <!-- Tooltip -->
  <span
    class="absolute right-16 bg-dark-800 text-white text-xs font-medium px-3 py-2 rounded-lg
           whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-200
           pointer-events-none shadow-lg"
  >
    ¡Chatea con nosotros!
    <span class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-1 w-2 h-2 bg-dark-800 rotate-45"></span>
  </span>

  <!-- Notification pulse -->
  <span class="absolute -top-0.5 -right-0.5 w-3.5 h-3.5 bg-red-500 rounded-full border-2 border-white animate-pulse"></span>
</a>

<style>
  /* Animate-in on page load */
  #whatsapp-btn {
    animation: slideInBtn 0.5s 1s ease both;
  }
  @keyframes slideInBtn {
    from { opacity: 0; transform: scale(0.5) translateY(20px); }
    to   { opacity: 1; transform: scale(1) translateY(0); }
  }
</style>
