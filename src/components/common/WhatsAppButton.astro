---
import { CONTACTO_DIRECTO_ACTIVO, whatsappUrl as buildContactUrl } from '@config/site';
const message = '¡Hola! Visité FIREFIGHTERS MX y me gustaría obtener información sobre sus equipos y servicios.';
const whatsappUrl = buildContactUrl(message);
---

<a
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-6 right-6 z-50 bg-green-500 hover:bg-green-600 active:bg-green-700 rounded-full flex items-center justify-center px-4 py-3 text-sm font-semibold text-white shadow-lg hover:shadow-xl group"
  aria-label={CONTACTO_DIRECTO_ACTIVO ? "Contactar por WhatsApp" : "Contactar por correo"}
  id="whatsapp-btn"
>
  WhatsApp

  <!-- Tooltip -->
  <span
    class="absolute right-16 bg-dark-800 text-white text-xs font-medium px-3 py-2 rounded-lg whitespace-nowrap opacity-0 group-hover:opacity-100 pointer-events-none shadow-lg"
  >
    ¡Chatea con nosotros!
    <span class="absolute right-0 top-1/2 -translate-y-1/2 translate-x-1 w-2 h-2 bg-dark-800 rotate-45"></span>
  </span>

  <!-- Notification pulse -->
  <span class="absolute -top-0.5 -right-0.5 w-3.5 h-3.5 bg-red-500 rounded-full border-2 border-white"></span>
</a>
