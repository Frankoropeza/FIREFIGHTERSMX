---
import { SITE, CONTACTO_DIRECTO_ACTIVO } from '@config/site';
export interface Props {
  title: string;
  description: string;
  canonicalURL: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  /** true = no anexar " | FIREFIGHTERS MX" (home: título de 3 módulos de keywords) */
  noBrandSuffix?: boolean;
  schema?: object | object[];
}

const {
  title,
  description,
  canonicalURL,
  ogImage = '/images/og-default.jpg',
  ogType = 'website',
  noindex = false,
  noBrandSuffix = false,
  schema,
} = Astro.props;

const fullTitle = noBrandSuffix || title.includes('FIREFIGHTERS MX') ? title : `${title} | FIREFIGHTERS MX`;
const absoluteOgImageRaw = ogImage.startsWith('http') ? ogImage : `https://firefighters.mx${ogImage}`;

// OG requiere formatos universales (WhatsApp/Facebook/Twitter no soportan AVIF/WebP):
// si la imagen resuelta es .avif/.webp, usar su espejo JPEG 1200×630 en /images/og/
// (naming aplanado dir-a-guiones, generado en public/images/og/).
const ogPathname = absoluteOgImageRaw.startsWith('http')
  ? new URL(absoluteOgImageRaw).pathname
  : absoluteOgImageRaw;
const ogExt = (ogPathname.split('.').pop() ?? '').toLowerCase();
const needsJpegMirror = ogExt === 'avif' || ogExt === 'webp';
const ogFlatName = ogPathname
  .replace(/^\//, '')
  .replace(/^images\//, '')
  .replace(/\.(avif|webp)$/i, '')
  .split('/')
  .join('-');
const absoluteOgImage = needsJpegMirror
  ? `https://firefighters.mx/images/og/${ogFlatName}.jpg`
  : absoluteOgImageRaw;
const ogMimeType = absoluteOgImage.toLowerCase().endsWith('.png') ? 'image/png' : 'image/jpeg';

const schemas = Array.isArray(schema) ? schema : schema ? [schema] : [];

// Organization schema base
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'FIREFIGHTERS MX',
  url: 'https://firefighters.mx',
  logo: {
    '@type': 'ImageObject',
    url: 'https://firefighters.mx/logo.png',
    width: 512,
    height: 512,
  },
  email: SITE.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: `${SITE.address.colonia}, ${SITE.address.delegacion}`,
    postalCode: SITE.address.postalCode,
    addressCountry: SITE.address.country,
  },
  contactPoint: {
    '@type': 'ContactPoint',
    ...(CONTACTO_DIRECTO_ACTIVO ? { telephone: SITE.phoneE164 } : {}),
    email: SITE.email,
    contactType: 'customer service',
    areaServed: 'MX',
    availableLanguage: 'Spanish',
  },
  sameAs: [
    SITE.social.facebook,
    SITE.social.instagram,
    SITE.social.linkedin,
    SITE.social.youtube,
  ],
};
---

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content={ogMimeType} />
<meta property="og:image:alt" content={fullTitle} />
<meta property="og:site_name" content="FIREFIGHTERS MX" />
<meta property="og:locale" content="es_MX" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteOgImage} />
<meta name="twitter:site" content="@firefightersmx" />

<!-- Additional SEO -->
<meta name="author" content="FIREFIGHTERS MX" />
<meta name="publisher" content="FIREFIGHTERS MX" />
<meta name="language" content="es-MX" />
<meta name="geo.region" content="MX" />
<meta name="geo.placename" content="México" />
<meta name="copyright" content={`© ${new Date().getFullYear()} FIREFIGHTERS MX`} />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
{schemas.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}
