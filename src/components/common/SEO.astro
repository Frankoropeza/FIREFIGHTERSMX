---
import { metaCerrada } from '@lib/meta-seo';
import { acortarTitulo, TITULO_MAX } from '@lib/titulo-seo';
import { SITE, CONTACTO_DIRECTO_ACTIVO, DOMICILIO_VERIFICADO, REDES_VERIFICADAS, TELEFONO_ACTIVO } from '@config/site';
export interface Props {
  title: string;
  description: string;
  canonicalURL: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  /** Obsoleto (2026-10-03): ya no se anexa marca a ningún title. Se acepta por compatibilidad. */
  noBrandSuffix?: boolean;
  schema?: object | object[];
}

const {
  title,
  description,
  canonicalURL,
  ogImage = '/images/og-default.jpg',
  ogType = 'website',
  noindex = false,
  schema,
} = Astro.props;

/*
  Regla de Frank (2026-10-03): títulos meta y meta descriptions sólo con
  palabras clave de la página y su sección; NUNCA la marca. No se anexa sufijo
  de marca y tampoco se emiten og:site_name, author, publisher ni copyright.
  scripts/verificar-metas.mjs (postbuild) rompe el build si la marca reaparece.
*/
const fullTitle = acortarTitulo(title, TITULO_MAX);
/* Catálogo (/productos/, /marcas/): la meta se cierra en frase completa ≤155
   caracteres, sin «…» ni cortes a media palabra (auditoría del catálogo 2026-09-28).
   El resto del sitio conserva el recorte a 160 con elipsis. */
const esCatalogo = /^\/(productos|marcas)(\/|$)/.test(Astro.url.pathname);
/* Todo el sitio: frase cerrada ≤155, sin «…» ni cortes a media palabra. */
const metaDescription = esCatalogo
  ? metaCerrada(description, ['Ficha técnica y cotización en todo México'])
  : metaCerrada(description);
const absoluteOgImageRaw = ogImage.startsWith('http') ? ogImage : `https://firefighters.mx${ogImage}`;

// OG requiere formatos universales (WhatsApp/Facebook/Twitter no soportan AVIF/WebP):
// si la imagen resuelta es .avif/.webp, usar su espejo JPEG 1200×630 en /images/og/
// (naming aplanado dir-a-guiones, generado en public/images/og/).
const ogPathname = absoluteOgImageRaw.startsWith('http')
  ? new URL(absoluteOgImageRaw).pathname
  : absoluteOgImageRaw;
const ogExt = (ogPathname.split('.').pop() ?? '').toLowerCase();
const needsJpegMirror = ogExt === 'avif' || ogExt === 'webp';
const ogFlatName = ogPathname
  .replace(/^\//, '')
  .replace(/^images\//, '')
  .replace(/\.(avif|webp)$/i, '')
  .split('/')
  .join('-');
const absoluteOgImage = needsJpegMirror
  ? `https://firefighters.mx/images/og/${ogFlatName}.jpg`
  : absoluteOgImageRaw;
const ogMimeType = absoluteOgImage.toLowerCase().endsWith('.png') ? 'image/png' : 'image/jpeg';

const schemas = Array.isArray(schema) ? schema : schema ? [schema] : [];

// Organization schema base
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${SITE.url}/#business`,
  name: 'FIREFIGHTERS MX',
  description: SITE.description,
  url: 'https://firefighters.mx',
  logo: {
    '@type': 'ImageObject',
    url: 'https://firefighters.mx/logo.png',
    width: 512,
    height: 512,
  },
  email: SITE.email,
  // Sin domicilio verificado no se emite `address` (regla: cero NAP fabricado)
  ...(DOMICILIO_VERIFICADO
    ? {
        address: {
          '@type': 'PostalAddress',
          streetAddress: SITE.address.street,
          addressLocality: `${SITE.address.colonia}, ${SITE.address.delegacion}`,
          postalCode: SITE.address.postalCode,
          addressCountry: SITE.address.country,
        },
      }
    : {}),
  contactPoint: {
    '@type': 'ContactPoint',
    ...(TELEFONO_ACTIVO ? { telephone: SITE.phoneE164 } : {}),
    email: SITE.email,
    contactType: 'customer service',
    areaServed: 'MX',
    availableLanguage: 'Spanish',
  },
  // Sin redes verificadas no se emite `sameAs` (apuntaba a 5 perfiles inexistentes)
  ...(REDES_VERIFICADAS
    ? {
        sameAs: [
          SITE.social.facebook,
          SITE.social.instagram,
          SITE.social.linkedin,
          SITE.social.youtube,
        ].filter(Boolean),
      }
    : {}),
};
// Nodo WebSite común: las páginas lo referencian con isPartOf  #website.
const webSiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  name: SITE.metaName,
  url: SITE.url,
  inLanguage: 'es-MX',
  publisher: { '@id': `${SITE.url}/#business` },
};
---

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={metaDescription} />
{noindex && <meta name="robots" content="noindex, follow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
{/* Una página noindex no declara canonical: la 404 se enlazaba a sí misma (Ahrefs, 2026-09-23). */}
{!noindex && <link rel="canonical" href={canonicalURL} />}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={metaDescription} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content={ogMimeType} />
<meta property="og:image:alt" content={fullTitle} />
<meta property="og:locale" content="es_MX" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={metaDescription} />
<meta name="twitter:image" content={absoluteOgImage} />

<!-- Additional SEO -->
<meta name="language" content="es-MX" />
<meta name="geo.region" content="MX" />
<meta name="geo.placename" content="México" />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
{!schemas.some((s) => s?.['@type'] === 'WebSite') && (
  <script type="application/ld+json" set:html={JSON.stringify(webSiteSchema)} />
)}
{schemas.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}
