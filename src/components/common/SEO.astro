---
export interface Props {
  title: string;
  description: string;
  canonicalURL: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  schema?: object | object[];
}

const {
  title,
  description,
  canonicalURL,
  ogImage = '/images/og-default.jpg',
  ogType = 'website',
  noindex = false,
  schema,
} = Astro.props;

const fullTitle = title.includes('FIREFIGHTERS MX') ? title : `${title} | FIREFIGHTERS MX`;
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : `https://firefighters.mx${ogImage}`;

const schemas = Array.isArray(schema) ? schema : schema ? [schema] : [];

// Organization schema base
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'FIREFIGHTERS MX',
  url: 'https://firefighters.mx',
  logo: 'https://firefighters.mx/logo.png',
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: '+52-55-1234-5678',
    contactType: 'customer service',
    areaServed: 'MX',
    availableLanguage: 'Spanish',
  },
  sameAs: [
    'https://www.facebook.com/firefightersmx',
    'https://www.instagram.com/firefightersmx',
    'https://www.linkedin.com/company/firefightersmx',
    'https://www.youtube.com/@firefightersmx',
  ],
};
---

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="title" content={fullTitle} />
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
{!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:site_name" content="FIREFIGHTERS MX" />
<meta property="og:locale" content="es_MX" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteOgImage} />
<meta name="twitter:site" content="@firefightersmx" />

<!-- Additional SEO -->
<meta name="author" content="FIREFIGHTERS MX" />
<meta name="publisher" content="FIREFIGHTERS MX" />
<meta name="language" content="es-MX" />
<meta name="geo.region" content="MX" />
<meta name="geo.placename" content="México" />
<meta name="copyright" content={`© ${new Date().getFullYear()} FIREFIGHTERS MX`} />

<!-- Structured Data (JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
{schemas.map((s) => (
  <script type="application/ld+json" set:html={JSON.stringify(s)} />
))}
