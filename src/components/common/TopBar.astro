---
import { SITE, CONTACTO_DIRECTO_ACTIVO, whatsappUrl, TELEFONO_ACTIVO } from '@config/site';
---

<div class="hidden md:block w-full" style="background:#020810;border-bottom:1px solid rgba(74,117,153,0.12)">
  <div class="container-site h-9 flex items-center justify-between gap-4">

    <!-- Izquierda: marca + disponibilidad + cobertura -->
    <div class="flex items-center gap-5 min-w-0">

      <span class="font-display font-bold text-[11px] tracking-[0.18em] uppercase shrink-0 whitespace-nowrap" style="color:#F75000">
        Equipo para bomberos y contra incendio
      </span>

      <span class="w-px h-3 shrink-0" style="background:rgba(74,117,153,0.2)"></span>

      <div class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full shrink-0" style="background:#34D399"></span>
        <span class="text-[11px] font-medium tracking-wide whitespace-nowrap" style="color:#64748B">
          Envíos a los 32 estados
        </span>
      </div>

      <span class="w-px h-3 shrink-0" style="background:rgba(74,117,153,0.2)"></span>

      <div class="hidden 2xl:flex items-center gap-1.5">
        
        <span class="text-[11px] whitespace-nowrap" style="color:var(--forge-300)">Polanco, CDMX</span>
      </div>

    </div>

    <!-- Derecha: contacto + normas -->
    <div class="flex items-center gap-4 shrink-0">

      <!-- Normas -->
      <div class="hidden xl:flex items-center gap-2">
        {['NFPA 1970', 'NOM-002-STPS', 'UL Listed'].map(n => (
          <span class="text-[10px] font-display font-semibold tracking-wider px-2 py-0.5 whitespace-nowrap"
                style="color:rgba(74,117,153,0.7);border:1px solid rgba(74,117,153,0.15);letter-spacing:0.08em">
            {n}
          </span>
        ))}
      </div>

      <span class="hidden xl:block w-px h-3 shrink-0" style="background:rgba(74,117,153,0.2)"></span>

      <!-- Email -->
      <a
        href={`mailto:${SITE.email}`}
        class="hidden lg:flex items-center gap-1.5"
        style="color:var(--forge-300)"
        onmouseover="this.style.color='#CBD5E1'"
        onmouseout="this.style.color='var(--forge-300)'"
      >
        
        <span class="text-[11px]">{SITE.email}</span>
      </a>

      <span class="hidden lg:block w-px h-3 shrink-0" style="background:rgba(74,117,153,0.2)"></span>

      <!-- Teléfono (solo si hay número verificado) -->
      {TELEFONO_ACTIVO && (
            <a
        href={`tel:${SITE.phoneE164}`}
        class="flex items-center gap-1.5"
        style="color:#94A3B8"
        onmouseover="this.style.color='#F75000'"
        onmouseout="this.style.color='#94A3B8'"
      >
        
        <span class="text-[11px] font-medium">{SITE.phone}</span>
      </a>

      )}

      <span class="w-px h-3 shrink-0" style="background:rgba(74,117,153,0.2)"></span>

      <!-- Canal de contacto verificado -->
      <a
        href={whatsappUrl('Hola, necesito información sobre equipo de bomberos.')}
        target="_blank" rel="noopener"
        class="flex items-center gap-1.5 px-2.5 py-1"
        style={CONTACTO_DIRECTO_ACTIVO ? 'background:rgba(37,211,102,0.1);border:1px solid rgba(37,211,102,0.2);color:#25d366' : 'background:rgba(247,80,0,0.1);border:1px solid rgba(247,80,0,0.2);color:#FF8F57'}
        onmouseover="this.style.background='rgba(37,211,102,0.18)'"
        onmouseout="this.style.background='rgba(37,211,102,0.1)'"
      >
        
        <span class="text-[11px] font-medium">{CONTACTO_DIRECTO_ACTIVO ? 'WhatsApp' : 'Correo'}</span>
      </a>

    </div>
  </div>
</div>
