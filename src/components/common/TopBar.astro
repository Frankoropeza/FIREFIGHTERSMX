---
import { SITE, whatsappUrl } from '@data/site';
---

<div class="hidden md:block w-full" style="background:#020810;border-bottom:1px solid rgba(74,117,153,0.12)">
  <div class="container-site h-9 flex items-center justify-between gap-4">

    <!-- Izquierda: marca + disponibilidad + cobertura -->
    <div class="flex items-center gap-5">

      <span class="font-display font-bold text-[11px] tracking-[0.18em] uppercase shrink-0" style="color:#F75000">
        Equipo para Bomberos
      </span>

      <span class="w-px h-3 shrink-0" style="background:rgba(74,117,153,0.2)"></span>

      <div class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full shrink-0" style="background:#34D399"></span>
        <span class="text-[11px] font-medium tracking-wide" style="color:#64748B">
          Disponibilidad inmediata · Stock permanente
        </span>
      </div>

      <span class="w-px h-3 shrink-0" style="background:rgba(74,117,153,0.2)"></span>

      <div class="hidden lg:flex items-center gap-1.5">
        <svg class="w-3 h-3 shrink-0" style="color:#4A7599" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <span class="text-[11px]" style="color:#4A7599">Cobertura nacional · 32 estados</span>
      </div>

    </div>

    <!-- Derecha: contacto + normas -->
    <div class="flex items-center gap-4">

      <!-- Normas -->
      <div class="hidden xl:flex items-center gap-2">
        {['NFPA 1970', 'NOM-002-STPS', 'UL Listed'].map(n => (
          <span class="text-[10px] font-display font-semibold tracking-wider px-2 py-0.5"
                style="color:rgba(74,117,153,0.7);border:1px solid rgba(74,117,153,0.15);letter-spacing:0.08em">
            {n}
          </span>
        ))}
      </div>

      <span class="hidden xl:block w-px h-3 shrink-0" style="background:rgba(74,117,153,0.2)"></span>

      <!-- Email -->
      <a
        href={`mailto:${SITE.email}`}
        class="hidden lg:flex items-center gap-1.5"
        style="color:#4A7599"
        onmouseover="this.style.color='#CBD5E1'"
        onmouseout="this.style.color='#4A7599'"
      >
        <svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        </svg>
        <span class="text-[11px]">{SITE.email}</span>
      </a>

      <span class="hidden lg:block w-px h-3 shrink-0" style="background:rgba(74,117,153,0.2)"></span>

      <!-- Teléfono -->
      <a
        href={`tel:${SITE.phoneE164}`}
        class="flex items-center gap-1.5"
        style="color:#94A3B8"
        onmouseover="this.style.color='#F75000'"
        onmouseout="this.style.color='#94A3B8'"
      >
        <svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
        </svg>
        <span class="text-[11px] font-medium">{SITE.phone}</span>
      </a>

      <span class="w-px h-3 shrink-0" style="background:rgba(74,117,153,0.2)"></span>

      <!-- WhatsApp pill -->
      <a
        href={whatsappUrl('Hola, necesito información sobre equipo de bomberos.')}
        target="_blank" rel="noopener"
        class="flex items-center gap-1.5 px-2.5 py-1"
        style="background:rgba(37,211,102,0.1);border:1px solid rgba(37,211,102,0.2);color:#25d366"
        onmouseover="this.style.background='rgba(37,211,102,0.18)'"
        onmouseout="this.style.background='rgba(37,211,102,0.1)'"
      >
        <svg class="w-3 h-3 shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        </svg>
        <span class="text-[11px] font-medium">WhatsApp</span>
      </a>

    </div>
  </div>
</div>
