---
/*
  Contenido del panel móvil / tablet del header.

  Vive fuera de Header.astro porque se sirve como parcial estático en
  /parciales/menu-movil/ y el header lo inyecta la primera vez que se
  toca el botón del menú. Así el markup deja de viajar en cada una de
  las páginas del sitio. No pierde enlaces: los mismos destinos ya están
  en la navegación de escritorio, que sí viaja en el HTML.

  Los estilos (.mm-*) y el comportamiento (acordeones, sección activa,
  foco) viven en Header.astro: el parcial no lleva CSS ni JS propios.
  El parcial es el mismo para todas las páginas, así que no puede saber
  la ruta actual: el resaltado lo pone el header en cliente.
*/
import { navigation } from '@data/navigation';
import { SITE, CONTACTO_DIRECTO_ACTIVO, whatsappUrl, TELEFONO_ACTIVO } from '@config/site';

const esVer = (label: string) => label.startsWith('Ver');
const grupos = [
  { titulo: null as string | null, items: navigation.main.filter((i) => i.zona !== 'directorio') },
  { titulo: 'Directorio nacional · registros de terceros', items: navigation.main.filter((i) => i.zona === 'directorio') },
].filter((g) => g.items.length);
---

<div class="mm-scroll">
  <nav class="mm-nav" aria-label="Menú móvil">
    {grupos.map((grupo) => (
      <>
        {grupo.titulo && <p class="mm-eyebrow">{grupo.titulo}</p>}
        <ul class="mm-list">
          {grupo.items.map((item) => {
            const idx = navigation.main.indexOf(item);
            return (
              <li class="mm-l1">
                <div class="mm-row">
                  <a href={item.href} class="mm-link">{item.label}</a>
                  {item.children && (
                    <button
                      type="button"
                      class="mm-toggle"
                      data-nivel="1"
                      aria-expanded="false"
                      aria-controls={`mm-p1-${idx}`}
                      aria-label={`Mostrar opciones de ${item.label}`}
                    >
                      <span class="caret" aria-hidden="true"></span>
                    </button>
                  )}
                </div>

                {item.children && (
                  <div class="mm-panel" id={`mm-p1-${idx}`} hidden>
                    <ul class="mm-sublist">
                      {item.children.map((child, cidx) => (
                        <li class="mm-l2">
                          <div class="mm-row">
                            <a href={child.href} class="mm-link">
                              <span>{child.label}</span>
                              {child.description && !esVer(child.label) && <span class="mm-desc">{child.description}</span>}
                            </a>
                            {child.children && (
                              <button
                                type="button"
                                class="mm-toggle"
                                data-nivel="2"
                                aria-expanded="false"
                                aria-controls={`mm-p2-${idx}-${cidx}`}
                                aria-label={`Mostrar opciones de ${child.label}`}
                              >
                                <span class="caret" aria-hidden="true"></span>
                              </button>
                            )}
                          </div>

                          {child.children && (
                            <div class="mm-panel" id={`mm-p2-${idx}-${cidx}`} hidden>
                              <ul class="mm-sublist">
                                {child.children.map((sub) => (
                                  <li class="mm-l3">
                                    <a href={sub.href} class="mm-link">
                                      <span>{sub.label}</span>
                                      {sub.description && <span class="mm-desc">{sub.description}</span>}
                                    </a>
                                  </li>
                                ))}
                              </ul>
                            </div>
                          )}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
              </li>
            );
          })}
        </ul>
      </>
    ))}
  </nav>
</div>

<!-- Pie fijo del panel: acciones siempre a la mano -->
<div class="mm-foot">
  <div class="mm-cta">
    <a href="/cotizacion/" class="btn btn-primary">Cotizar equipo</a>
    {CONTACTO_DIRECTO_ACTIVO && (
      <a href={whatsappUrl('Hola, quiero cotizar equipo para bomberos.')} target="_blank" rel="noopener" class="btn btn-whatsapp">WhatsApp</a>
    )}
  </div>
  <p class="mm-contact">
    {TELEFONO_ACTIVO && <><a href={`tel:${SITE.phoneE164}`}>{SITE.phone}</a> · </>}{SITE.hours}
  </p>
</div>
