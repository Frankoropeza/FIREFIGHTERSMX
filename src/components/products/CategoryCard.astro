---
/**
 * Card de categoría de /productos/ y del directorio: envuelve LineaCard para que toda
 * card de producto del sitio tenga la misma estructura (imagen · norma · título · texto ·
 * subcategorías · botón principal). Textos, subcategorías y botón salen de src/data/catalogo.ts;
 * si la categoría no tiene línea propia, se arman con los datos de la categoría.
 */
import type { Category } from '@data/categories';
import LineaCard from './LineaCard.astro';
import { imagenLinea, lineaPorSlug } from '@lib/linea-card';

type CategoryProps = { cat: Category; href?: string; norm?: string; label?: string; desc?: string; items?: string[]; ctaLabel?: string; accent?: string; image?: string; imageAlt?: string; };
type ExplicitProps = { cat?: never; href: string; norm: string; label: string; desc: string; items: string[]; ctaLabel?: string; accent: string; image?: string; imageAlt?: string; };
export type Props = CategoryProps | ExplicitProps;

const props = Astro.props;
const cat = 'cat' in props && props.cat ? props.cat : undefined;
const slug = cat?.slug ?? '';
const linea = lineaPorSlug(slug);

// Categorías que agrupan varias líneas o no tienen línea propia en el catálogo
const HIJAS_EXTRA: Record<string, { label: string; href: string }[]> = {
  'sistemas-ci': ['rociadores', 'deteccion-alarma', 'bombas-red-hidraulica', 'hidrantes-gabinetes']
    .map((s) => lineaPorSlug(s)!)
    .map((l) => ({ label: l.cta, href: l.href })),
  'drones-emergencia': [{ label: 'Drones DJI Enterprise', href: '/productos/drones-emergencia/dji-enterprise/' }],
};
const CTA_EXTRA: Record<string, string> = { 'sistemas-ci': 'Sistemas contra incendio para inmuebles' };

const href = (cat ? props.href ?? `/productos/${cat.slug}/` : props.href) as string;
const norma = (cat ? props.norm ?? cat.norm : props.norm) as string;
const titulo = (cat ? props.label ?? linea?.titulo ?? cat.label : props.label) as string;
const texto = (cat ? props.desc ?? linea?.texto ?? cat.shortDesc : props.desc) as string;
const hijas = linea?.hijas ?? HIJAS_EXTRA[slug] ?? [];
const cta = props.ctaLabel ?? linea?.cta ?? CTA_EXTRA[slug] ?? titulo;
const imagen = cat
  ? props.image ?? imagenLinea(slug) ?? cat.spotlight?.image ?? null
  : props.image ?? null;
const imagenAlt = cat
  ? props.imageAlt ?? linea?.imagenAlt ?? cat.spotlight?.imageAlt ?? cat.label
  : (props.imageAlt ?? props.label) as string;
---
<LineaCard href={href} norma={norma} titulo={titulo} texto={texto} imagen={imagen} imagenAlt={imagenAlt} hijas={hijas} cta={cta} nivel="h3" />
