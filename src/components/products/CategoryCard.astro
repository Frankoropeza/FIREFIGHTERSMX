---
/**
 * Card de categoría — diseño compartido entre el home (ProductCards)
 * y el hub /productos. Sin animaciones ni transiciones (solo .btn las tiene).
 */
import type { Category } from '@data/categories';

export interface Props {
  cat: Category;
}

const { cat } = Astro.props;
const href = `/productos/${cat.slug}`;
const patternId = `g-${cat.slug}`;
---

<a href={href} class="cat-card group relative flex flex-col overflow-hidden" style="background:#080F1A;border:1px solid rgba(74,117,153,0.18)">

  <!-- Visual top: imagen de categoría con ícono overlay -->
  <div class="relative flex items-center justify-center overflow-hidden" style="height:148px">
    {cat.spotlight?.image ? (
      <>
        <img
          src={cat.spotlight.image}
          alt={cat.spotlight.imageAlt ?? cat.label}
          width="320"
          height="148"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 w-full h-full block"
          style="object-fit:cover;object-position:center 20%"
        />
        <div class="absolute inset-0 pointer-events-none" style="background:linear-gradient(135deg, rgba(4,10,18,0.55) 0%, rgba(4,10,18,0.25) 50%, rgba(4,10,18,0.55) 100%)" aria-hidden="true"></div>
      </>
    ) : (
      <>
        <div class="absolute inset-0" style={`background:linear-gradient(135deg, ${cat.accent}26 0%, rgba(4,10,18,0.94) 100%)`}></div>
        <svg class="absolute inset-0 w-full h-full" style="opacity:0.06" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <defs>
            <pattern id={patternId} width="32" height="32" patternUnits="userSpaceOnUse">
              <path d="M 32 0 L 0 0 0 32" fill="none" stroke="#7AA4C4" stroke-width="0.5"/>
            </pattern>
          </defs>
          <rect width="100%" height="100%" fill={`url(#${patternId})`}/>
        </svg>
        <div class="absolute inset-0 pointer-events-none" style={`background:radial-gradient(circle at 50% 50%, ${cat.accent}22 0%, transparent 65%)`}></div>
      </>
    )}
    <div class="relative z-10 flex items-center justify-center rounded-full"
         style={`width:72px;height:72px;background:rgba(4,10,18,0.7);border:1.5px solid ${cat.accent}44;color:${cat.accent}`}>
      <span class="block" style="width:32px;height:32px" set:html={cat.icon}/>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-8 pointer-events-none" style="background:linear-gradient(to bottom, transparent, #080F1A)"></div>
  </div>

  <!-- Contenido -->
  <div class="flex flex-col flex-1 p-5 gap-3">
    <span class="text-[9px] font-display font-semibold uppercase tracking-widest" style="color:#4A7599">{cat.norm}</span>

    <h3 class="font-display font-bold text-lg leading-tight" style="color:#FFFFFF">
      {cat.label}
    </h3>

    <p class="text-xs leading-relaxed" style="color:#64748B;flex:1">
      {cat.shortDesc}
    </p>

    <ul class="flex flex-col gap-1.5 py-3 list-none m-0" style="border-top:1px solid rgba(74,117,153,0.12);border-bottom:1px solid rgba(74,117,153,0.12)">
      {cat.items.slice(0, 3).map((item) => (
        <li class="flex items-center gap-2 text-[11px]" style="color:#64748B">
          <span class="w-1 h-1 rounded-full shrink-0" style={`background:${cat.accent};opacity:0.7`} aria-hidden="true"></span>
          {item.name}
        </li>
      ))}
    </ul>

    <div class="pt-1">
      <span
        class="inline-flex items-center gap-2 w-full justify-center text-xs font-display font-semibold uppercase tracking-wider py-2.5 px-4"
        style={`color:#040A12;background:${cat.accent};letter-spacing:0.08em`}
      >
        Guía de {cat.label}
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
        </svg>
      </span>
    </div>
  </div>
</a>

<style>
  /* Hover instantáneo (sin transición) — solo cambio de borde */
  .cat-card:hover { border-color: rgba(247, 80, 0, 0.45) !important; }
</style>
