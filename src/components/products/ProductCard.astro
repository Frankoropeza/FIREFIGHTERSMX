---
/**
 * ProductCard — card individual de producto con imagen, tier, norma,
 * specs chips, features y CTA doble (ficha + WhatsApp).
 * Diseño: dark navy + naranja. Sin animaciones (solo hover en borde).
 */
import type { Product } from '@data/products';
import { whatsappUrl } from '@data/site';

export interface Props {
  product: Product;
}

const { product: p } = Astro.props;

const waMsg = `Hola, quiero cotizar el ${p.title} (${p.norm ?? 'NFPA 1971'}).`;
const hasSpecs = p.specs && Object.values(p.specs).some(Boolean);
const hasFeatures = p.features && p.features.length > 0;
---

<article class="product-card group flex flex-col" style="background:#080F1A;border:1px solid rgba(74,117,153,0.18);position:relative">

  {/* Highlight ribbon */}
  {p.highlight && (
    <div
      class="absolute top-0 left-0 z-20 text-[9px] font-display font-bold uppercase tracking-widest px-3 py-1"
      style="background:#F75000;color:#040A12;letter-spacing:0.12em"
      aria-label="Producto más solicitado"
    >
      ★ Más solicitado
    </div>
  )}

  {/* ── Imagen / visual ─────────────────────────────────────── */}
  <div class="relative overflow-hidden" style="height:200px">
    {p.image ? (
      <>
        <img
          src={p.image}
          alt={`${p.title} — ${p.brand ?? ''} ${p.norm ?? ''} certificado México`}
          width="480"
          height="200"
          loading="lazy"
          decoding="async"
          class="absolute inset-0 w-full h-full block"
          style="object-fit:cover;object-position:center 20%"
        />
        {/* dark overlay para que el texto legible */}
        <div
          class="absolute inset-0 pointer-events-none"
          style="background:linear-gradient(to bottom, rgba(4,10,18,0.35) 0%, rgba(4,10,18,0.08) 40%, rgba(4,10,18,0.75) 100%)"
          aria-hidden="true"
        ></div>
      </>
    ) : (
      <div
        class="absolute inset-0"
        style="background:linear-gradient(135deg, rgba(247,80,0,0.12) 0%, rgba(4,10,18,0.95) 100%)"
        aria-hidden="true"
      ></div>
    )}

    {/* Tier badge — top right */}
    {p.tier && (
      <span
        class="absolute top-3 right-3 z-10 text-[9px] font-display font-semibold uppercase tracking-widest px-2.5 py-1"
        style="background:rgba(4,10,18,0.82);border:1px solid rgba(74,117,153,0.35);color:#4A9ED4;letter-spacing:0.1em;backdrop-filter:blur(4px)"
      >
        {p.tier}
      </span>
    )}

    {/* Brand logo placeholder — bottom left sobre imagen */}
    <div
      class="absolute bottom-3 left-4 z-10 text-[10px] font-display font-bold uppercase tracking-wider"
      style="color:rgba(255,255,255,0.55)"
    >
      {p.brand}
    </div>
  </div>

  {/* ── Contenido ───────────────────────────────────────────── */}
  <div class="flex flex-col flex-1 gap-4 p-5">

    {/* Norma badge */}
    <div class="flex flex-wrap gap-2">
      {p.norm && (
        <span class="badge badge-fire text-[9px]">{p.norm}</span>
      )}
      {p.badge && (
        <span
          class="text-[9px] font-display font-semibold uppercase tracking-widest px-2 py-0.5"
          style="background:rgba(247,80,0,0.12);border:1px solid rgba(247,80,0,0.3);color:#FF6B26"
        >
          {p.badge}
        </span>
      )}
    </div>

    {/* Título */}
    <h3 class="font-display font-bold text-xl leading-tight m-0" style="color:#FFFFFF">
      {p.title}
    </h3>

    {/* Descripción corta */}
    <p class="text-xs leading-relaxed m-0" style="color:#64748B">
      {p.description}
    </p>

    {/* Specs chips */}
    {hasSpecs && (
      <div class="flex flex-wrap gap-1.5 py-3" style="border-top:1px solid rgba(74,117,153,0.12);border-bottom:1px solid rgba(74,117,153,0.12)">
        {p.specs?.tpp && (
          <span class="spec-chip">{p.specs.tpp}</span>
        )}
        {p.specs?.thl && (
          <span class="spec-chip">{p.specs.thl}</span>
        )}
        {p.specs?.outer && (
          <span class="spec-chip">Shell: {p.specs.outer}</span>
        )}
        {p.specs?.weight && (
          <span class="spec-chip">{p.specs.weight}</span>
        )}
        {p.specs?.extra && (
          <span class="spec-chip">{p.specs.extra}</span>
        )}
      </div>
    )}

    {/* Features */}
    {hasFeatures && (
      <ul class="flex flex-col gap-2 list-none m-0 p-0">
        {p.features!.map((f) => (
          <li class="flex items-start gap-2.5 text-[11px] leading-relaxed" style="color:#94A3B8">
            <svg class="w-3 h-3 shrink-0 mt-0.5" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <circle cx="8" cy="8" r="7.5" stroke="#F75000" stroke-width="1"/>
              <path d="M5 8l2.5 2.5L11 5.5" stroke="#F75000" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {f}
          </li>
        ))}
      </ul>
    )}

    {/* CTAs */}
    <div class="flex flex-col gap-2 mt-auto pt-2">
      <a
        href={whatsappUrl(waMsg)}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 text-xs font-display font-bold uppercase tracking-wider py-2.5 px-4 w-full"
        style="background:#F75000;color:#040A12;letter-spacing:0.08em"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        Cotizar por WhatsApp
      </a>

      <a
        href={p.href}
        class="inline-flex items-center justify-center gap-2 text-xs font-display font-semibold uppercase tracking-wider py-2 px-4 w-full group-hover:border-[#FF6B26]"
        style="border:1px solid rgba(74,117,153,0.3);color:#94A3B8;letter-spacing:0.08em"
      >
        Ver ficha técnica
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .product-card:hover {
    border-color: rgba(247, 80, 0, 0.45) !important;
  }

  .spec-chip {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-display, 'Barlow Condensed', sans-serif);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 8px;
    background: rgba(74, 117, 153, 0.1);
    border: 1px solid rgba(74, 117, 153, 0.22);
    color: #7AA4C4;
  }
</style>
