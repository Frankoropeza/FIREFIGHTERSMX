---
export interface Props {
  title: string;
  description: string;
  image?: string;
  href: string;
  brand?: string;
  norm?: string;
  category?: string;
  badge?: string;
}

const { title, description, image, href, brand, norm, category, badge } = Astro.props;
---

<article class="product-card">
  <!-- Image -->
  <a href={href} class="product-card-img" aria-label={title} tabindex="-1">
    {image ? (
      <img
        src={image}
        alt={title}
        class="w-full h-full object-contain p-4 group-hover:scale-105 transition-transform duration-500"
        loading="lazy"
        width="400"
        height="400"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center text-dark-300">
        <svg class="w-16 h-16" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1"
            d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
        </svg>
      </div>
    )}

    {badge && (
      <div class="absolute top-3 left-3">
        <span class="badge-fire shadow-sm">{badge}</span>
      </div>
    )}
  </a>

  <!-- Body -->
  <div class="product-card-body">
    <!-- Badges -->
    <div class="flex flex-wrap gap-1.5 mb-3">
      {category && <span class="badge-dark text-2xs">{category}</span>}
      {norm && <span class="badge-gold text-2xs">{norm}</span>}
      {brand && <span class="text-2xs text-dark-400 font-medium">{brand}</span>}
    </div>

    <!-- Title -->
    <h3 class="font-heading font-bold text-dark-900 text-base leading-snug mb-2 line-clamp-2 group-hover:text-fire-700 transition-colors">
      <a href={href}>{title}</a>
    </h3>

    <!-- Description -->
    <p class="text-dark-500 text-xs leading-relaxed line-clamp-2 mb-4">{description}</p>

    <!-- Actions -->
    <div class="flex gap-2 mt-auto">
      <a
        href={href}
        class="flex-1 btn-primary btn-sm justify-center"
      >
        Ver producto
      </a>
      <a
        href={`https://wa.me/525512345678?text=Hola, me interesa: ${encodeURIComponent(title)}`}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-sm bg-green-500 hover:bg-green-600 text-white p-2"
        aria-label="Consultar por WhatsApp"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        </svg>
      </a>
    </div>
  </div>
</article>
