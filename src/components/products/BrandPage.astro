---
import BaseLayout from '@layouts/BaseLayout.astro';
import QuickLinksBar from '@components/common/QuickLinksBar.astro';
import { featuredProducts } from '@data/products';
import { SITE } from '@config/site';
import { categoriaMarca, hermanasMarca, type EquipmentBrand } from '@data/brandPages';

interface Props { brand: EquipmentBrand }
const { brand } = Astro.props;
const cat = categoriaMarca[brand.categorySlug];
const hubURL = `/productos/${brand.categorySlug}/`;
const canonicalURL = `${SITE.url}/productos/${brand.categorySlug}/${brand.slug}/`;
const productos = featuredProducts.filter((item) => item.category === cat.productCategory && item.brand === brand.brand);
const otrasMarcas = hermanasMarca(brand);
const directoryByCategory: Record<string, string> = { 'Extintores': '/empresas/extintores/', 'Sistemas CI': '/empresas/sistemas-ci/' };
const directoryHref = directoryByCategory[cat.productCategory] ?? '/empresas/venta-equipo/';
const description = `Referencias editoriales de ${brand.brandLabel} en la categoría ${cat.label}. Consulta modelos catalogados, datos por verificar y empresas del sector en México.`;
const breadcrumbSchema = {
  '@context':'https://schema.org','@type':'BreadcrumbList', itemListElement:[
    {'@type':'ListItem',position:1,name:'Inicio',item:`${SITE.url}/`},
    {'@type':'ListItem',position:2,name:'Guías de equipo',item:`${SITE.url}/productos/`},
    {'@type':'ListItem',position:3,name:cat.label,item:`${SITE.url}${hubURL}`},
    {'@type':'ListItem',position:4,name:brand.brandLabel,item:canonicalURL},
  ],
};
const collectionSchema = {
  '@context':'https://schema.org','@type':'CollectionPage','@id':`${canonicalURL}#collection`,
  name:`Referencias ${brand.brandLabel} — ${cat.label}`,description,url:canonicalURL,inLanguage:'es-MX',
  isPartOf:{'@id':`${SITE.url}/#website`},
  mainEntity:{'@type':'ItemList',numberOfItems:productos.length,itemListElement:productos.map((item,index)=>({'@type':'ListItem',position:index+1,name:item.title,url:`${SITE.url}${item.href}/`}))},
};
---

<BaseLayout title={`${brand.brandLabel} ${cat.label} | Referencias en México`} description={description} canonicalURL={canonicalURL} schema={[breadcrumbSchema,collectionSchema]} noBrandSuffix>
  <nav class="py-3" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,.15)" aria-label="Breadcrumb"><div class="container-site"><ol class="flex items-center flex-wrap gap-2 text-xs list-none m-0 p-0" style="color:var(--forge-300)"><li><a href="/">Inicio</a></li><li aria-hidden="true">/</li><li><a href="/productos/">Guías de equipo</a></li><li aria-hidden="true">/</li><li><a href={hubURL}>{cat.label}</a></li><li aria-hidden="true">/</li><li aria-current="page" style="color:#94A3B8">{brand.brandLabel}</li></ol></div></nav>

  <section class="section" style="background:#040A12" aria-labelledby="brand-heading"><div class="container-site max-w-5xl"><span class="section-eyebrow mb-5 inline-flex">Colección editorial · Datos por verificar</span><h1 id="brand-heading" class="font-display font-bold uppercase mb-7" style="color:#FFFFFF;font-size:clamp(2.5rem,6vw,4.6rem);line-height:.95">{brand.brandLabel}<br/><span style="color:#F75000">{cat.label}</span></h1><p class="text-sm leading-[1.9] max-w-3xl mb-4" style="color:#94A3B8">Esta página agrupa referencias asociadas en el catálogo a {brand.brandLabel}. No acredita representación, distribución autorizada, certificación, disponibilidad ni relación comercial entre la marca y FIREFIGHTERS MX.</p><p class="text-sm leading-[1.9] max-w-3xl mb-8" style="color:#94A3B8">Antes de utilizar cualquier dato técnico, confirma fabricante, modelo, configuración, norma, edición y documento vigente. Para una compra, compara propuestas directamente con empresas del directorio nacional.</p><div class="flex flex-col sm:flex-row gap-3"><a href={directoryHref} class="btn btn-primary btn-lg">Buscar empresas del sector</a><a href={hubURL} class="btn btn-ghost btn-lg">Ver guía de categoría</a></div></div></section>

  <QuickLinksBar />

  <section class="section" style="background:#070E1A" aria-labelledby="models-heading"><div class="container-site"><span class="section-eyebrow mb-4 inline-flex">Inventario editorial</span><h2 id="models-heading" class="font-display font-bold mb-4" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.2rem)">Referencias catalogadas de {brand.brandLabel}.</h2><p class="text-sm leading-relaxed max-w-3xl mb-10" style="color:#64748B">Los nombres sirven para navegar el catálogo. Cada ficha indica los documentos que deben comprobarse; no constituye una oferta ni una recomendación de compra.</p>
    {productos.length > 0 ? <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">{productos.map((item)=><a href={`${item.href}/`} class="group p-6" style="background:#040A12;border:1px solid rgba(74,117,153,.18)"><span class="text-[10px] uppercase tracking-widest" style="color:#F75000">Ficha de referencia</span><h3 class="font-display font-bold text-lg mt-2 mb-3 group-hover:text-[#FF6B26]" style="color:#FFFFFF">{item.title}</h3><span class="text-xs" style="color:#64748B">Ver datos a comprobar →</span></a>)}</div> : <p class="p-6 text-sm" style="background:#040A12;color:#94A3B8;border:1px solid rgba(74,117,153,.18)">No hay modelos activos asociados a esta colección. Consulta la guía de categoría o el directorio.</p>}
  </div></section>

  <section class="section" style="background:#040A12" aria-labelledby="check-heading"><div class="container-site grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20"><div><span class="section-eyebrow mb-4 inline-flex">Antes de comparar</span><h2 id="check-heading" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.2rem);line-height:1.05">Verifica la referencia, no solo la marca.</h2></div><ul class="flex flex-col gap-4 m-0 pl-5 text-sm leading-relaxed" style="color:#CBD5E1"><li>Identificación exacta del modelo y sus opciones.</li><li>Ficha técnica y manual emitidos por el fabricante.</li><li>Certificado o reporte aplicable a esa configuración, cuando se exija.</li><li>Compatibilidad, mantenimiento, refacciones y criterios de retiro.</li><li>Responsable, alcance y condiciones de cada propuesta comercial.</li></ul></div></section>

  <section class="section-tight" style="background:#F75000"><div class="container-site flex flex-col lg:flex-row justify-between items-start lg:items-center gap-6"><div><p class="font-display font-bold text-xs uppercase tracking-widest mb-2" style="color:rgba(255,255,255,.7)">Directorio nacional</p><h2 class="font-display font-bold text-2xl" style="color:#FFFFFF">Localiza empresas y confirma la información directamente.</h2></div><a href={directoryHref} class="btn btn-lg" style="background:#FFFFFF;color:#F75000">Consultar empresas</a></div></section>

  {otrasMarcas.length > 0 && <section class="section" style="background:#070E1A" aria-labelledby="other-heading"><div class="container-site"><h2 id="other-heading" class="font-display font-bold text-2xl mb-8" style="color:#FFFFFF">Otras colecciones de {cat.label}</h2><div class="grid grid-cols-1 md:grid-cols-3 gap-4">{otrasMarcas.map((item)=><a href={`${item.href}/`} class="p-5" style="background:#040A12;border:1px solid rgba(74,117,153,.18)"><strong class="block mb-2" style="color:#FFFFFF">{item.label}</strong><span class="text-xs" style="color:#64748B">{item.desc}</span></a>)}</div></div></section>}
</BaseLayout>
