---
/**
 * Barra lateral de /productos/ — navegación fija del catálogo (Frank, 2026-09-30).
 * Regla: SIN scroll interno. Todo el contenido cabe en la ventana: accesos de la
 * página en una fila y familias en listas de dos columnas (la cotización ya vive en el
 * header y en el botón fijo de WhatsApp). Sticky sólo si el panel completo cabe bajo el
 * header; si no, acompaña al contenido (lo decide un script con el alto real).
 * En móvil y tablet (<1280 px) es un <details> plegado arriba del contenido.
 * Sin íconos ni animaciones: sólo cambian color, fondo y borde de los enlaces.
 */
import { catalogo } from '@data/catalogo';
import { allCategories } from '@data/categories';

export interface Props {
  secciones: { id: string; label: string }[];
}
const { secciones } = Astro.props;

// Categorías con página propia que no son línea de catalogo.ts
const EXTRA: Record<string, string[]> = { 'equipo-bomberos': ['drones-emergencia'] };
const familias = catalogo.map((f) => ({
  slug: f.slug,
  label: f.eyebrow,
  links: [
    ...f.lineas.map((l) => ({ label: l.titulo, href: l.href })),
    ...(EXTRA[f.slug] ?? [])
      .map((s) => allCategories.find((c) => c.slug === s))
      .filter(Boolean)
      .map((c) => ({ label: c!.label, href: `/productos/${c!.slug}/` })),
  ],
  hub: f.hub,
}));
---

<aside class="pc-side" aria-label="Navegación del catálogo" data-fija>
  <details class="pc-nav" open data-pc-nav>
    <summary class="pc-sum">Navegar el catálogo</summary>

    <div class="pc-panel">
      <nav aria-label="En esta página">
        <ul class="pc-tabs" role="list">
          {secciones.map((s) => <li><a href={`#${s.id}`} class="pc-tab" data-spy={s.id}>{s.label}</a></li>)}
        </ul>
      </nav>

      {familias.map((f) => (
        <nav class="pc-fam" aria-label={f.label}>
          <p class="pc-label">{f.label}</p>
          <ul class="pc-grid" role="list">
            {f.links.map((l) => <li><a href={l.href} class="pc-link">{l.label}</a></li>)}
            <li class="pc-hub-li"><a href={f.hub.href} class="pc-link pc-link--hub">{f.hub.label}</a></li>
          </ul>
        </nav>
      ))}

    </div>
  </details>
</aside>

<script>
  const nav = document.querySelector<HTMLDetailsElement>('[data-pc-nav]');
  if (nav) {
    const mq = window.matchMedia('(min-width: 1280px)');
    const sync = () => { nav.open = mq.matches; };
    sync();
    mq.addEventListener('change', sync);
  }
  // Sin scroll interno: la barra sólo se fija si cabe completa bajo el header
  const side = document.querySelector<HTMLElement>('.pc-side');
  if (side) {
    const ajustar = () => {
      const header = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) || 106;
      side.toggleAttribute('data-fija', side.offsetHeight + header + 32 <= window.innerHeight);
    };
    ajustar();
    window.addEventListener('resize', ajustar);
  }
  // Scroll-spy: marca la sección visible (sin desplazamiento suave)
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-spy]'));
  const targets = links.map((a) => document.getElementById(a.dataset.spy!)).filter((el): el is HTMLElement => !!el);
  if ('IntersectionObserver' in window && targets.length) {
    const visibles = new Set<string>();
    const pintar = () => {
      const activo = targets.find((t) => visibles.has(t.id))?.id;
      links.forEach((a) => (a.dataset.spy === activo ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
    };
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => (e.isIntersecting ? visibles.add(e.target.id) : visibles.delete(e.target.id)));
      pintar();
    }, { rootMargin: '-35% 0px -55% 0px' });
    targets.forEach((t) => io.observe(t));
  }
</script>

<style>
  .pc-side { min-width: 0; }
  /* Sticky sólo con alto suficiente para mostrar TODO el panel sin scroll interno */
  @media (min-width: 1280px) {
    .pc-side[data-fija] { position: sticky; top: calc(var(--header-height) + 1rem); }
  }

  .pc-nav { background: var(--c-surface); border: 1px solid var(--c-line); border-radius: var(--radius-card); box-shadow: var(--shadow-card); }
  .pc-sum { display: flex; align-items: center; justify-content: space-between; min-height: 3rem; padding: .75rem 1rem; font-size: .9375rem; font-weight: 600; color: var(--c-ink); cursor: pointer; list-style: none; }
  .pc-sum::-webkit-details-marker { display: none; }
  .pc-sum::after { content: "Mostrar"; font-size: .8125rem; font-weight: 500; color: var(--c-accent); }
  .pc-nav[open] .pc-sum::after { content: "Ocultar"; }
  @media (min-width: 1280px) { .pc-sum { display: none; } }

  .pc-panel { display: flex; flex-direction: column; gap: 1rem; padding: 0 1rem 1rem; }
  @media (min-width: 1280px) { .pc-panel { padding: 1.25rem; } }

  /* Accesos de la página: una fila de pestañas del mismo ancho */
  .pc-tabs { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); margin: 0; padding: 0; list-style: none; border: 1px solid var(--c-line); border-radius: var(--radius-btn); overflow: hidden; }
  .pc-tabs li + li { border-left: 1px solid var(--c-line); }
  .pc-tab { display: flex; align-items: center; justify-content: center; min-height: 2.25rem; padding: .25rem .375rem; font-size: .8125rem; font-weight: 600; line-height: 1.2; text-align: center; color: var(--c-ink-2); text-decoration: none; background: var(--c-bg-alt); transition: color .15s, background-color .15s; }
  .pc-tab:hover, .pc-tab:focus-visible { color: var(--c-accent); background: var(--c-surface); }
  .pc-tab[aria-current] { color: #FFFFFF; background: var(--c-accent); }

  /* Familias: lista de dos columnas; cada fila de la rejilla toma el alto de su celda mayor */
  .pc-label { margin: 0 0 .375rem; font-size: .6875rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--c-accent); }
  .pc-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: .75rem; margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--c-line); }
  .pc-grid li { display: flex; border-bottom: 1px solid var(--c-line); }
  .pc-grid .pc-hub-li { grid-column: 1 / -1; }
  .pc-link { display: flex; flex: 1; align-items: center; min-height: 2.125rem; padding: .3125rem .375rem; font-size: .8125rem; font-weight: 500; line-height: 1.25; color: var(--c-ink-2); text-decoration: none; transition: color .15s, background-color .15s; }
  .pc-link:hover, .pc-link:focus-visible { color: var(--c-accent); background: var(--c-bg-alt); }
  .pc-link--hub { font-weight: 600; color: var(--c-ink); }

</style>
