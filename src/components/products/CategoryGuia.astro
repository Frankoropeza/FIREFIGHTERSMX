---
/**
 * Guía de selección de una categoría para /productos/ — envoltura de L2Guia.
 * Datos: campo `spotlight` de src/data/categories.ts — sólo el primer párrafo;
 * el desarrollo completo vive en la página de categoría.
 */
import type { Category } from '@data/categories';
import { lineaPorSlug } from '@lib/linea-card';
import L2Guia from '@components/l2/L2Guia.astro';

export interface Props { cat: Category; }
const { cat } = Astro.props;
const s = cat.spotlight;
if (!s) throw new Error(`La categoría "${cat.slug}" no tiene spotlight definido en categories.ts`);
---
<L2Guia
  id={cat.slug}
  eyebrow={cat.norm}
  title={s.title}
  highlight={s.highlight}
  paragraph={s.paragraphs[0]}
  subsections={s.subsections}
  image={s.image}
  imageAlt={s.imageAlt}
  cta={{ href: `/productos/${cat.slug}/`, label: lineaPorSlug(cat.slug)?.cta ?? cat.label }}
  whatsappMsg={`Hola, quiero cotizar ${cat.label.toLowerCase()}.`}
/>
