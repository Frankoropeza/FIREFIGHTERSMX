---
/**
 * Card de empresa para listados del directorio.
 * Jerarquía visual: el plan (comercial) define borde y densidad;
 * la confianza (editorial) es un badge discreto. Nunca se mezclan.
 * Sin transiciones (regla del design system): hover instantáneo vía .emp-card.
 */
import { giroMap, planConfig, confianzaConfig } from '@data/giros';
import type { Empresa } from '@lib/empresas';
import { urlEmpresa } from '@lib/empresas';

export interface Props { e: Empresa; mostrarEstado?: boolean; }
const { e, mostrarEstado = false } = Astro.props;
const g = giroMap[e.giroPrincipal];
const plan = planConfig[e.plan];
const conf = confianzaConfig[e.confianza];
const esp = e.especialidades.map((s) => g.especialidades[s]).filter(Boolean).slice(0, 3);
const otros = e.giros.filter((x) => x !== e.giroPrincipal).map((x) => giroMap[x].labelCorto);
const destacado = e.plan === 'destacado';
---
<article
  class="emp-card flex flex-col gap-3 p-5"
  data-nombre={`${e.nombre} ${e.razonSocial ?? ''}`.toLowerCase()}
  data-ciudad={`${e.ciudad} ${e.municipio} ${e.estadoNombre}`.toLowerCase()}
  data-giro={e.giros.join(' ')}
  data-giro-txt={e.giros.map((x) => giroMap[x].labelCorto).join(' ')}
  data-esp={e.especialidades.join(' ')}
  data-estado={e.estado}
  style={`background:${destacado ? '#0C1825' : '#040A12'};border:1px solid ${destacado ? 'rgba(245,166,35,0.35)' : 'rgba(74,117,153,0.18)'};border-top:2px solid ${destacado ? '#F5A623' : g.color}`}
>
  <div class="flex items-start justify-between gap-3">
    <span class="inline-flex items-center gap-1.5 font-display font-bold text-[10px] uppercase tracking-wider px-2 py-1"
      style={`color:${g.color};background:${g.color}1A;border:1px solid ${g.color}40`}>
      <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={g.icon} aria-hidden="true"/>
      {g.labelCorto}
    </span>
    <span class="flex items-center gap-1.5 shrink-0">
      {destacado && (
        <span class="font-display text-[9px] uppercase tracking-wider px-1.5 py-0.5"
          style={`color:${plan.color};background:${plan.bgColor};border:1px solid ${plan.color}55`}>{plan.label}</span>
      )}
      <span class="font-display text-[9px] uppercase tracking-wider px-1.5 py-0.5" title={conf.descripcion}
        style={`color:${conf.color};background:${conf.bgColor};border:1px solid ${conf.color}33`}>{conf.label}</span>
    </span>
  </div>

  <h3 class="font-display font-bold text-base leading-snug" style="color:#FFFFFF">
    <a href={urlEmpresa(e)} class="hover:text-[#FF6B26]">{e.nombre}</a>
  </h3>

  <div class="flex items-start gap-2">
    <svg class="w-4 h-4 shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="#FF6B26" stroke-width="1.8" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
    <span class="text-xs leading-relaxed" style="color:#94A3B8">
      {e.ciudad}{e.municipio !== e.ciudad && <span style="color:#64748B"> · {e.municipio}</span>}
      {mostrarEstado && <span style="color:#64748B"> · {e.estadoNombre}</span>}
    </span>
  </div>

  {(esp.length > 0 || otros.length > 0) && (
    <div class="flex flex-wrap gap-1.5">
      {esp.map((s) => <span class="text-[10px] px-2 py-0.5" style="color:#94A3B8;border:1px solid rgba(74,117,153,0.3)">{s}</span>)}
      {otros.map((s) => <span class="text-[10px] px-2 py-0.5" style="color:#4A7599;border:1px dashed rgba(74,117,153,0.3)">+ {s}</span>)}
    </div>
  )}

  <div class="mt-auto pt-3 flex items-center justify-between gap-3" style="border-top:1px solid rgba(74,117,153,0.12)">
    <span class="text-[10px] uppercase tracking-widest" style="color:#4A7599">{e.estrato ? e.estrato.replace(' personas', ' pers.') : 'Registro público'}</span>
    <a href={urlEmpresa(e)} class="font-display font-semibold text-xs uppercase tracking-wider hover:text-[#FF6B26]" style="color:#FF8F57">Ver ficha →</a>
  </div>
</article>
