---
import { SITE, whatsappUrl } from '@data/site';
---

<section class="relative overflow-hidden" style="background:#040A12;min-height:calc(100vh - 71px)" aria-label="Hero">

  <!-- Glow naranja lateral derecho -->
  <div class="absolute top-0 right-0 w-[55%] h-full pointer-events-none" style="background:radial-gradient(ellipse 70% 60% at 85% 40%, rgba(247,80,0,0.12) 0%, transparent 70%)" aria-hidden="true"></div>
  <!-- Glow azul sutil abajo izquierdo -->
  <div class="absolute bottom-0 left-0 w-[40%] h-[50%] pointer-events-none" style="background:radial-gradient(ellipse 80% 60% at 10% 100%, rgba(18,33,51,0.9) 0%, transparent 70%)" aria-hidden="true"></div>

  <!-- Grid de líneas -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none" style="opacity:0.03" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="g" width="60" height="60" patternUnits="userSpaceOnUse">
        <path d="M 60 0 L 0 0 0 60" fill="none" stroke="#7AA4C4" stroke-width="0.5"/>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#g)"/>
  </svg>

  <!-- Línea vertical decorativa -->
  <div class="absolute top-0 right-[35%] h-full w-px hidden xl:block" style="background:linear-gradient(to bottom, transparent, rgba(247,80,0,0.15) 30%, rgba(247,80,0,0.15) 70%, transparent)" aria-hidden="true"></div>

  <div class="container-site relative z-10 flex flex-col justify-center" style="min-height:calc(100vh - 71px); padding-top:4rem; padding-bottom:4rem">

    <!-- Eyebrow -->
    <div class="flex flex-wrap items-center gap-3 mb-8">
      <span class="section-eyebrow">Distribución Autorizada · México</span>
      <span class="flex items-center gap-1.5 text-xs font-medium" style="color:#FF6B26">
        <span class="w-1.5 h-1.5 rounded-full animate-pulse" style="background:#F75000"></span>
        Disponibilidad inmediata · 32 estados
      </span>
    </div>

    <!-- Headline full-width -->
    <div class="mb-6">
      <h1 class="font-display font-bold uppercase leading-[0.9] tracking-[0.01em]" style="font-size:clamp(4rem,10vw,9rem);color:#FFFFFF">
        Equipo<br/>
        <span style="color:#F75000">Certificado</span><br/>
        <span style="font-size:0.45em;color:#94A3B8;letter-spacing:0.04em">para Bomberos · Protección Civil · Industria</span>
      </h1>
    </div>

    <!-- Stats row — horizontal, full width -->
    <div class="grid grid-cols-2 sm:grid-cols-4 mb-10" style="border-top:1px solid rgba(74,117,153,0.2);border-bottom:1px solid rgba(74,117,153,0.2)">
      {[
        { n: '+15', label: 'Años en el sector' },
        { n: '500+', label: 'Estaciones equipadas' },
        { n: '32', label: 'Estados con cobertura' },
        { n: '16+', label: 'Marcas autorizadas' },
      ].map((s, i) => (
        <div class={`py-6 flex flex-col ${i > 0 ? 'border-l' : ''}`} style={`border-color:rgba(74,117,153,0.2);padding-left:${i > 0 ? '2rem' : '0'}`}>
          <span class="font-display font-bold" style="font-size:clamp(2rem,4vw,3.5rem);color:#FFFFFF;line-height:1">{s.n}</span>
          <span class="text-sm mt-1" style="color:#64748B;text-transform:uppercase;letter-spacing:0.08em">{s.label}</span>
        </div>
      ))}
    </div>

    <!-- Descripción + CTAs -->
    <div class="flex flex-col lg:flex-row gap-10 lg:gap-16 items-start lg:items-center">

      <p class="text-base lg:text-lg leading-relaxed max-w-2xl" style="color:#94A3B8">
        Distribuidores directos de <strong style="color:#CBD5E1">Globe, MSA, Dräger, Bullard, Holmatro y 3M Scott</strong>.
        Trajes NFPA 1971, SCBA, cascos, herramientas hidráulicas de rescate, HAZMAT
        y sistemas contra incendio. Asesoría técnica real, documentación lista para licitación CompraNet y PEMEX.
      </p>

      <div class="flex flex-col sm:flex-row gap-3 shrink-0">
        <a
          href={whatsappUrl('Hola, necesito una cotización para equipo de bomberos.')}
          target="_blank" rel="noopener"
          class="btn btn-primary btn-lg"
        >
          Cotización gratuita
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="/productos" class="btn btn-ghost btn-lg">Ver catálogo</a>
      </div>
    </div>

    <!-- Certifications -->
    <div class="flex flex-wrap gap-2 mt-8">
      {['NFPA 1971','NFPA 1981','UL Listed','NOM-002-STPS','ISO 9001','NIOSH'].map(n => (
        <span class="badge badge-dark font-display text-[10px]">{n}</span>
      ))}
    </div>

  </div>

  <!-- Línea de acento inferior -->
  <div class="h-px w-full" style="background:linear-gradient(90deg, transparent, rgba(247,80,0,0.5) 30%, rgba(247,80,0,0.5) 70%, transparent)"></div>

</section>
