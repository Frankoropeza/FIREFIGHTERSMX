---
import { SITE, whatsappUrl } from '@data/site';
---

<section class="relative overflow-hidden" style="background:#040A12;min-height:calc(100vh - 108px)" aria-label="Hero">

  <!-- Glow naranja derecho -->
  <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" style="background:radial-gradient(ellipse 80% 70% at 90% 30%, rgba(247,80,0,0.10) 0%, transparent 65%)" aria-hidden="true"></div>
  <!-- Glow azul abajo izquierdo -->
  <div class="absolute bottom-0 left-0 w-2/5 h-2/3 pointer-events-none" style="background:radial-gradient(ellipse 80% 60% at 0% 100%, rgba(18,33,51,0.95) 0%, transparent 70%)" aria-hidden="true"></div>

  <!-- Grid de líneas sutil -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none" style="opacity:0.025" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs>
      <pattern id="grid" width="64" height="64" patternUnits="userSpaceOnUse">
        <path d="M 64 0 L 0 0 0 64" fill="none" stroke="#7AA4C4" stroke-width="0.5"/>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#grid)"/>
  </svg>

  <!-- Línea divisoria vertical decorativa -->
  <div class="absolute inset-y-0 left-[52%] w-px hidden xl:block pointer-events-none"
       style="background:linear-gradient(to bottom, transparent 5%, rgba(247,80,0,0.12) 25%, rgba(247,80,0,0.12) 75%, transparent 95%)"
       aria-hidden="true"></div>

  <!-- Layout principal -->
  <div class="container-site relative z-10 grid grid-cols-1 xl:grid-cols-[55fr_45fr] gap-0" style="min-height:calc(100vh - 108px)">

    <!-- ─── COLUMNA IZQUIERDA: Título ─── -->
    <div class="flex flex-col justify-center py-16 lg:py-20 xl:pr-20">

      <!-- Eyebrow -->
      <div class="flex flex-wrap items-center gap-3 mb-8">
        <span class="section-eyebrow">Distribución Autorizada · México</span>
        <span class="flex items-center gap-1.5 text-xs font-medium" style="color:#FF6B26">
          <span class="w-1.5 h-1.5 rounded-full shrink-0" style="background:#F75000"></span>
          32 estados · Respuesta &lt; 24 h
        </span>
      </div>

      <!-- Headline principal -->
      <h1 class="font-display font-bold uppercase mb-8" style="line-height:0.88;letter-spacing:0.01em">
        <span class="block" style="font-size:clamp(3.5rem,9vw,8.5rem);color:#FFFFFF">Equipo</span>
        <span class="block" style="font-size:clamp(3.5rem,9vw,8.5rem);color:#F75000">Para Bomberos</span>
        <span class="block mt-3" style="font-size:clamp(1.1rem,2.2vw,1.75rem);color:#94A3B8;letter-spacing:0.06em;font-weight:600">
          Venta y Distribución en México · Protección Civil · Industria
        </span>
      </h1>


    </div>

    <!-- ─── COLUMNA DERECHA: Dos párrafos ─── -->
    <div class="flex flex-col justify-center py-16 lg:py-20 xl:pl-20"
         style="border-left:1px solid rgba(74,117,153,0.1)">

      <!-- Eyebrow columna derecha -->
      <div class="flex items-center gap-2 mb-8">
        <span class="w-8 h-px shrink-0" style="background:#F75000"></span>
        <span class="text-xs font-display font-semibold uppercase tracking-[0.18em]" style="color:#F75000">
          Por qué elegirnos
        </span>
      </div>

      <!-- Párrafo 1 -->
      <div class="mb-8 pb-8" style="border-bottom:1px solid rgba(74,117,153,0.15)">
        <h2 class="font-display font-bold text-xl mb-4 leading-snug" style="color:#FFFFFF">
          Distribuidores directos con más de 15 años equipando a quienes protegen vidas.
        </h2>
        <p class="text-sm leading-[1.9]" style="color:#64748B">
          Somos distribuidores autorizados de <strong style="color:#CBD5E1">Globe, MSA, Dräger, Bullard,
          Holmatro y 3M Scott</strong> en México. Cada equipo que entregamos lleva número de serie
          verificable con fábrica, certificado de laboratorio acreditado y ficha técnica lista para
          auditoría STPS, CompraNet o PEMEX. Sin intermediarios, sin copias, sin sorpresas en la entrega.
        </p>
      </div>

      <!-- Párrafo 2 -->
      <div class="mb-10">
        <h2 class="font-display font-bold text-xl mb-4 leading-snug" style="color:#FFFFFF">
          Asesoría técnica real, documentación lista para licitación en menos de 24 horas.
        </h2>
        <p class="text-sm leading-[1.9]" style="color:#64748B">
          Nuestro equipo certificado en <strong style="color:#CBD5E1">NFPA 1001, NOM-002-STPS y HAZMAT</strong>
          analiza tu operación, detecta brechas normativas y entrega una propuesta detallada en menos de
          24 horas hábiles. Cobertura en los 32 estados, stock permanente, capacitación DC-3 incluida y
          garantía de fábrica de hasta 10 años. La relación no termina con la entrega del equipo.
        </p>
      </div>


    </div>
  </div>

  <!-- Línea de acento inferior -->
  <div class="h-px w-full" style="background:linear-gradient(90deg, transparent, rgba(247,80,0,0.4) 30%, rgba(247,80,0,0.4) 70%, transparent)"></div>

</section>
