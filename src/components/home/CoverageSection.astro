---
/**
 * Cobertura nacional — regiones, tiempos de entrega y diferenciadores logísticos.
 */
import CardMedia from '@components/common/CardMedia.astro';

const regions = [
  { name: 'CDMX y Zona Metropolitana', img: '/images/home/cobertura-cdmx.avif', time: 'Entrega 24–48 h', detail: 'Centro de operaciones y stock principal', featured: true },
  { name: 'Centro y Bajío', img: '/images/home/cobertura-centro-bajio.avif', time: '2–3 días hábiles', detail: 'EdoMex, Querétaro, Guanajuato, Puebla, Hidalgo, Morelos', featured: false },
  { name: 'Norte', img: '/images/home/cobertura-norte.avif', time: '3–5 días hábiles', detail: 'Nuevo León, Coahuila, Chihuahua, Tamaulipas, Sonora, BC', featured: false },
  { name: 'Occidente y Pacífico', img: '/images/home/cobertura-occidente-pacifico.avif', time: '3–5 días hábiles', detail: 'Jalisco, Michoacán, Sinaloa, Nayarit, Colima', featured: false },
  { name: 'Sur y Sureste', img: '/images/home/cobertura-sur-sureste.avif', time: '3–5 días hábiles', detail: 'Veracruz, Oaxaca, Chiapas, Tabasco, Yucatán, Q. Roo', featured: false },
  { name: 'Proyectos especiales', img: '/images/home/cobertura-proyectos-especiales.avif', time: 'Logística dedicada', detail: 'Plataformas, minas y sitios remotos con embalaje certificado', featured: false },
];

const badges = [
  'Envíos a los 32 estados',
  'Seguro de envío incluido',
  'Factura electrónica CFDI 4.0',
  'Embalaje especializado',
];
---

<section class="home-deferred-section section" style="background:var(--c-bg-alt)" aria-labelledby="coverage-title">
  <div class="container-site">

    <!-- Header -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
      <div>
        <span class="section-eyebrow mb-4 inline-flex">Cobertura</span>
        <h2 id="coverage-title" class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
          Entrega directa en<br/>
          <span style="color:var(--c-accent)">los 32 estados.</span>
        </h2>
      </div>
      <div style="padding-left:1.75rem">
        <p class="text-sm leading-relaxed mb-4" style="color:var(--c-text-2)">
          Operamos desde la Ciudad de México con stock permanente de los equipos más
          demandados. Entregamos en 24–48 horas en la zona metropolitana y coordinamos
          logística dedicada para proyectos de volumen en cualquier punto del país.
        </p>
        <div class="flex flex-wrap gap-2">
          {badges.map(b => (
            <span class="badge badge-dark font-display text-2xs">{b}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Grid de regiones -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3" style="border-top:1px solid var(--c-line);border-left:1px solid var(--c-line)">
      {regions.map((r) => (
        <div
          class="coverage-cell relative flex flex-col gap-2 p-7"
          style={`background:${r.featured ? 'var(--c-surface-2)' : 'var(--c-surface)'};border-right:1px solid var(--c-line);border-bottom:1px solid var(--c-line)`}
        >
          <CardMedia src={r.img} alt={`Cobertura de entrega: ${r.name}`} />
          <div class="flex items-center justify-between gap-3">
            <h3 class="font-display font-bold text-lg leading-tight" style="color:var(--c-ink)">{r.name}</h3>
            {r.featured && <span class="badge badge-fire shrink-0">HQ</span>}
          </div>
          <p class="text-xs font-semibold" style="color:var(--c-success)">{r.time}</p>
          <p class="text-xs leading-relaxed" style="color:var(--c-muted)">{r.detail}</p>
        </div>
      ))}
    </div>

    <p class="text-sm mt-6" style="color:var(--c-muted)">
      ¿Tu proyecto está fuera de estas rutas?
      <a href="/cobertura" class="font-semibold hover:text-[var(--c-accent)]" style="color:var(--c-accent)">Consulta la cobertura completa </a>
    </p>

  </div>
</section>

<style>
  .coverage-cell:hover { background: var(--c-surface-2) !important; }
</style>
