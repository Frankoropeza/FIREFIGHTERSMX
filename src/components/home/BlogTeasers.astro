---
/**
 * Últimos artículos del blog — internal linking + frescura SEO en el home.
 */
import { getCollection } from 'astro:content';
import CardMedia from '@components/common/CardMedia.astro';
import { portadaBlog } from '@lib/portada-blog';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const curatedIds = ['tipos-de-extintores-mexico', 'nom-002-stps-guia-completa', 'deteccion-alarma-supresion-nfpa-72-2001', 'como-elegir-traje-bombero-nfpa'];
const curatedPosts = curatedIds.map((id) => allPosts.find((post) => post.id === id)).filter((post) => post !== undefined);
const posts = [...curatedPosts, ...allPosts.filter((post) => !curatedPosts.some((curated) => curated.id === post.id))].slice(0, 4);

const fmt = new Intl.DateTimeFormat('es-MX', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<section class="section home-deferred-section" style="background:var(--c-bg)" aria-labelledby="blog-title">
  <div class="container-site">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
      <div>
        <span class="section-eyebrow mb-4 inline-flex">Blog técnico</span>
        <h2 id="blog-title" class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
          Guías escritas por<br/>
          <span style="color:var(--c-accent)">especialistas del sector.</span>
        </h2>
        <p class="text-sm mt-4 max-w-xl leading-relaxed" style="color:var(--c-muted)">
          Tipos de extintores, NOM-002-STPS, detección y alarma, rociadores y selección de equipo para bomberos: guías técnicas para comprar e inspeccionar sin tecnicismos innecesarios.
        </p>
      </div>
      <a href="/blog" class="btn btn-outline btn-sm self-start sm:self-auto shrink-0">
        Todos los artículos del blog técnico 
      </a>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4" style="border-top:1px solid var(--c-line);border-left:1px solid var(--c-line)">
      {posts.map((post) => (
        <article class="h-full" style="border-right:1px solid var(--c-line);border-bottom:1px solid var(--c-line)">
          <a href={`/blog/${post.id}`} class="blog-card group flex flex-col gap-4 p-6 h-full" style="background:var(--c-surface)">
            {portadaBlog(post) && <CardMedia src={portadaBlog(post)!.url} alt={portadaBlog(post)!.alt} />}
            <div class="flex items-center justify-between gap-3">
              <span class="badge badge-fire">{post.data.category}</span>
              <time datetime={post.data.pubDate.toISOString().split('T')[0]} class="text-[11px] uppercase tracking-wider" style="color:var(--forge-300)">
                {fmt.format(post.data.pubDate)}
              </time>
            </div>
            <h3 class="font-display font-bold text-lg leading-snug group-hover:text-[var(--c-accent)]" style="color:var(--c-ink)">
              {post.data.title}
            </h3>
            <p class="text-sm leading-relaxed flex-1" style="color:var(--c-muted)">{post.data.description}</p>
            <span class="flex items-center gap-1.5 text-xs font-display font-semibold uppercase tracking-wider group-hover:text-[var(--c-accent)]" style="color:var(--forge-300);letter-spacing:0.1em">
              Guía: {post.data.tags[0] ?? post.data.category}
              
            </span>
          </a>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .blog-card:hover { background: var(--c-surface-2) !important; }
</style>
