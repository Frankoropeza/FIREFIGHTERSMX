---
/**
 * Últimos artículos del blog — internal linking + frescura SEO en el home.
 */
import { getCollection } from 'astro:content';
import CardMedia from '@components/common/CardMedia.astro';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const curatedIds = ['tipos-de-extintores-mexico', 'nom-002-stps-guia-completa', 'deteccion-alarma-supresion-nfpa-72-2001', 'como-elegir-traje-bombero-nfpa'];
const curatedPosts = curatedIds.map((id) => allPosts.find((post) => post.id === id)).filter((post) => post !== undefined);
const posts = [...curatedPosts, ...allPosts.filter((post) => !curatedPosts.some((curated) => curated.id === post.id))].slice(0, 4);

const fmt = new Intl.DateTimeFormat('es-MX', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<section class="section home-deferred-section" style="background:#040A12" aria-labelledby="blog-title">
  <div class="container-site">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4 mb-10">
      <div>
        <span class="section-eyebrow mb-4 inline-flex">Blog técnico</span>
        <h2 id="blog-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
          Guías escritas por<br/>
          <span style="color:#F75000">especialistas del sector.</span>
        </h2>
        <p class="text-sm mt-4 max-w-xl leading-relaxed" style="color:#64748B">
          Tipos de extintores, NOM-002-STPS, detección y alarma, rociadores y selección de equipo para bomberos: guías técnicas para comprar e inspeccionar sin tecnicismos innecesarios.
        </p>
      </div>
      <a href="/blog" class="btn btn-outline btn-sm self-start sm:self-auto shrink-0">
        Todos los artículos del blog técnico →
      </a>
    </div>

    <!-- Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4" style="border-top:1px solid rgba(74,117,153,0.18);border-left:1px solid rgba(74,117,153,0.18)">
      {posts.map((post) => (
        <article class="h-full" style="border-right:1px solid rgba(74,117,153,0.18);border-bottom:1px solid rgba(74,117,153,0.18)">
          <a href={`/blog/${post.id}`} class="blog-card group flex flex-col gap-4 p-6 h-full" style="background:#0C1825">
            {post.data.image && <CardMedia src={post.data.image.url} alt={post.data.image.alt} />}
            <div class="flex items-center justify-between gap-3">
              <span class="badge badge-fire">{post.data.category}</span>
              <time datetime={post.data.pubDate.toISOString().split('T')[0]} class="text-[11px] uppercase tracking-wider" style="color:var(--forge-300)">
                {fmt.format(post.data.pubDate)}
              </time>
            </div>
            <h3 class="font-display font-bold text-lg leading-snug group-hover:text-[#FF6B26]" style="color:#FFFFFF">
              {post.data.title}
            </h3>
            <p class="text-sm leading-relaxed flex-1" style="color:#64748B">{post.data.description}</p>
            <span class="flex items-center gap-1.5 text-xs font-display font-semibold uppercase tracking-wider group-hover:text-[#FF6B26]" style="color:var(--forge-300);letter-spacing:0.1em">
              Leer sobre {post.data.tags[0] ?? post.data.category}
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
              </svg>
            </span>
          </a>
        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .blog-card:hover { background: #122133 !important; }
</style>
