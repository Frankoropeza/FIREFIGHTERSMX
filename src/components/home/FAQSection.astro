---
import { SITE, CONTACTO_DIRECTO_ACTIVO, whatsappUrl, CANAL_CONTACTO } from '@config/site';
import { homeFaqs as faqs } from '@data/faqs';
---

<section class="home-deferred-section" style="background:#040A12;padding-block:5rem" aria-labelledby="faq-title">

  <!-- Header -->
  <div class="container-site mb-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end">
      <div>
        <span class="section-eyebrow mb-4 inline-flex">FAQ</span>
        <h2 id="faq-title" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
          Resolvemos tus dudas<br/>
          <span style="color:#F75000">y cotizamos al instante.</span>
        </h2>
        <p class="text-sm mt-4 leading-relaxed" style="color:#64748B">
          Lo más consultado por jefes de cuerpo, coordinadores de seguridad y áreas de compras.
        </p>
      </div>
      <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
        <p class="text-sm leading-relaxed mb-3" style="color:#94A3B8">
          Sabemos que detrás de cada compra hay un proceso interno: comparativos,
          validación técnica, presupuesto, autorización. Por eso publicamos respuestas
          claras a las preguntas reales que recibimos cada semana, sin letra chica.
        </p>
        <p class="text-sm leading-relaxed" style="color:#94A3B8">
          Si lo tuyo no aparece, escríbenos por {CANAL_CONTACTO} y un ejecutivo te contesta
          en menos de 24 horas hábiles con propuesta concreta.
        </p>
      </div>
    </div>
  </div>

  <!-- FAQ + Formulario -->
  <div class="container-site">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-start">

      <!-- Accordion -->
      <div style="border:1px solid rgba(74,117,153,0.2);background:#0C1825">
        <div class="flex flex-col">
          {faqs.map((faq) => (
            <details class="faq-item group" style="border-bottom:1px solid rgba(74,117,153,0.15)">
              <summary class="flex items-start justify-between gap-4 cursor-pointer select-none list-none p-6">
                <h3 class="font-display font-semibold text-sm leading-snug pr-2 group-open:text-[#FF6B26] m-0" style="color:#FFFFFF;font-size:0.875rem;line-height:1.375">
                  {faq.q}
                </h3>
                <span class="faq-icon shrink-0 mt-0.5 w-5 h-5 flex items-center justify-center" style="border:1px solid rgba(74,117,153,0.3);color:var(--forge-300)">
                  
                </span>
              </summary>
              <p class="px-6 pb-6 text-sm leading-relaxed" style="color:#64748B">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>

      <!-- Formulario -->
      <div class="sticky top-24" style="background:#0C1825;border:1px solid rgba(74,117,153,0.2)">
        <div class="p-7 md:p-8">
          <h3 class="font-display font-bold text-xl mb-1" style="color:#FFFFFF">Cotización inmediata</h3>
          <p class="text-sm mb-6" style="color:#64748B">
            Respuesta en menos de 2 horas en días hábiles. Con fichas técnicas incluidas.
          </p>

          <form data-wa-form data-wa={SITE.whatsapp} data-mail={SITE.email} method="POST" action="/api/cotizacion" class="flex flex-col gap-4">
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label for="faq-nombre" class="label">Nombre *</label>
                <input type="text" id="faq-nombre" name="nombre" required class="input" placeholder="Tu nombre" />
              </div>
              <div>
                <label for="faq-empresa" class="label">Empresa</label>
                <input type="text" id="faq-empresa" name="empresa" class="input" placeholder="Opcional" />
              </div>
            </div>
            <div>
              <label for="faq-email" class="label">Correo *</label>
              <input type="email" id="faq-email" name="email" required class="input" placeholder="correo@empresa.com" />
            </div>
            <div>
              <label for="faq-tel" class="label">Teléfono</label>
              <input type="tel" id="faq-tel" name="telefono" class="input" placeholder="55 1234-5678" />
            </div>
            <div>
              <label for="faq-msg" class="label">¿Qué necesitas? *</label>
              <textarea id="faq-msg" name="mensaje" rows="3" required class="input" style="resize:none" placeholder="Tipo de equipo, cantidad, norma requerida..."></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-full justify-center mt-1">
              Enviar cotización
              
            </button>
          </form>

          <div class="mt-4 pt-4" style="border-top:1px solid rgba(74,117,153,0.2)">
            <a href={whatsappUrl('Hola, quiero cotizar equipo para bomberos.')}
               target="_blank" rel="noopener"
               class={`btn ${CONTACTO_DIRECTO_ACTIVO ? 'btn-whatsapp' : 'btn-outline'} w-full justify-center text-sm`}>
              
              O escribe por {CANAL_CONTACTO}
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>

</section>

<script>
  // Envío sin backend  arma un mensaje de WhatsApp con los campos del formulario.
  document.querySelectorAll('form[data-wa-form]').forEach((form) => {
    const f = form as HTMLFormElement;
    if (f.dataset.bound) return;
    f.dataset.bound = '1';
    f.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!f.reportValidity()) return;
      const num = f.getAttribute('data-wa');
      const fd = new FormData(f);
      const lines: string[] = ['Hola FIREFIGHTERS MX, solicito una cotización:', ''];
      for (const [name, value] of fd.entries()) {
        const v = String(value).trim();
        if (!v) continue;
        const field = f.querySelector(`[name="${name}"]`) as HTMLElement | null;
        const id = field?.id ?? '';
        const labelEl = id ? f.querySelector(`label[for="${id}"]`) : null;
        const label = labelEl?.textContent?.replace('*', '').trim() || name;
        lines.push(`${label}: ${v}`);
      }
      const text = encodeURIComponent(lines.join('\n'));
      // Sin número verificado (CONTACTO_DIRECTO_ACTIVO=false) el form cae a correo.
      const mail = f.getAttribute('data-mail');
      if (num) {
        window.open(`https://api.whatsapp.com/send/?phone=${num}&text=${text}`, '_blank', 'noopener');
      } else if (mail) {
        window.location.href = `mailto:${mail}?subject=${encodeURIComponent('Cotización — FIREFIGHTERS MX')}&body=${text}`;
      }
    });
  });
</script>
