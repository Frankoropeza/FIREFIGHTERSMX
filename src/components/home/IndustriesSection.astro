---
const industries = [
  { slug: 'bomberos-municipales',  name: 'Bomberos Municipales',  tagline: 'Equipamiento integral y soporte para licitaciones CompraNet', color: '#F75000', image: '/images/industrias/bomberos-municipales.avif',  imageAlt: 'Cuerpo de bomberos municipales con equipo NFPA certificado México', icon: `` },
  { slug: 'brigadas-industriales', name: 'Brigadas Industriales', tagline: 'NOM-002-STPS llave en mano: equipo + capacitación DC-3',         color: '#F5A623', image: '/images/industrias/brigadas-industriales.avif', imageAlt: 'Brigada industrial equipada NOM-002-STPS capacitación contra incendio', icon: `` },
  { slug: 'aeropuertos-arff',      name: 'Aeropuertos ARFF',      tagline: 'Trajes de proximidad, SCBA 60 min y espuma AFFF',               color: '#F75000', image: '/images/industrias/aeropuertos-arff.avif',      imageAlt: 'Equipo ARFF para aeropuertos traje proximidad SCBA 60 minutos', icon: `` },
  { slug: 'hospitales',            name: 'Hospitales y Salud',    tagline: 'Agentes limpios FM-200, alarmas y brigada certificada',         color: '#34D399', image: '/images/industrias/hospitales.avif',            imageAlt: 'Sistema contra incendio hospitales FM-200 NFPA brigada certificada', icon: `` },
  { slug: 'refinerias-pemex',      name: 'Refinerías PEMEX',      tagline: 'HAZMAT Nivel A/B, SCBA 60 min, detectores ATEX',               color: '#F75000', image: '/images/industrias/refinerias-pemex.avif',      imageAlt: 'Equipo HAZMAT nivel A/B refinería PEMEX SCBA 60 min detectores ATEX', icon: `` },
  { slug: 'hoteles',               name: 'Hoteles y Turismo',     tagline: 'Rociadores NFPA 13, alarmas de voz y brigada',                  color: '#F5A623', image: '/images/industrias/hoteles.avif',               imageAlt: 'Sistema contra incendio hotel rociadores NFPA 13 alarmas voz', icon: `` },
  { slug: 'mineria',               name: 'Minería',               tagline: 'SCBA espacios confinados, detectores multi-gas NOM-032',        color: '#F75000', image: '/images/industrias/mineria.avif',               imageAlt: 'SCBA espacios confinados minería detectores multi-gas NOM-032 México', icon: `` },
  { slug: 'proteccion-civil',      name: 'Protección Civil',      tagline: 'Equipamiento y capacitación NFPA para PC estatal y municipal',  color: '#34D399', image: '/images/industrias/proteccion-civil.avif',      imageAlt: 'Protección civil estatal municipal equipo NFPA capacitación México', icon: `` },
].map((ind) => ({
  ...ind,
  cta: {
    'bomberos-municipales': 'Equipo para bomberos',
    'brigadas-industriales': 'Brigadas industriales',
    'aeropuertos-arff': 'Equipo ARFF',
    hospitales: 'Protección para hospitales',
    'refinerias-pemex': 'Equipo para refinerías',
    hoteles: 'Sistemas para hoteles',
    mineria: 'Equipo para minería',
    'proteccion-civil': 'Equipo para protección civil',
  }[ind.slug],
}));
---

<section class="home-deferred-section" style="background:#040A12;padding-block:5rem" aria-label="Sectores que atendemos">

  <!-- Header -->
  <div class="container-site mb-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end">
      <div>
        <span class="section-eyebrow mb-4 inline-flex">Sectores</span>
        <h2 class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
          Protección contra incendios<br/>
          <span style="color:#F75000">para cada industria.</span>
        </h2>
      </div>
      <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
        <p class="text-sm leading-relaxed mb-3" style="color:#94A3B8">
          Más de 15 años atendiendo industrias, comercios y cuerpos de emergencia: desde brigadas internas de empresas hasta cuerpos de bomberos estatales y plantas petroquímicas.
        </p>
        <p class="text-sm leading-relaxed" style="color:#94A3B8">
          Cada sector tiene normas, presupuestos y calendarios distintos.
          Te asignamos un ejecutivo que ya equipó proyectos similares al tuyo.
        </p>
      </div>
    </div>
  </div>

  <!-- Grid full-width -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4" style="border-top:1px solid rgba(74,117,153,0.18);border-left:1px solid rgba(74,117,153,0.18)">
    {industries.map((ind) => (
      <a
        href={`/industrias/${ind.slug}`}
        class="grid-cell group relative flex flex-col overflow-hidden"
        style="border-right:1px solid rgba(74,117,153,0.18);border-bottom:1px solid rgba(74,117,153,0.18)"
      >
        <!-- Accent bar left -->
        <div class="absolute left-0 top-0 bottom-0 w-[3px] z-10 opacity-0 group-hover:opacity-100" style={`background:${ind.color}`}></div>

        <!-- Imagen de sector -->
        {ind.image && (
          <div class="relative overflow-hidden shrink-0" style="height:9rem">
            <img
              src={ind.image}
              alt={ind.imageAlt}
              width="320"
              height="144"
              loading="lazy"
              decoding="async"
              class="w-full h-full block"
              style="object-fit:cover;object-position:center 20%"
            />
            <div class="absolute inset-0 pointer-events-none" style="background:linear-gradient(to bottom, rgba(4,10,18,0.1) 0%, rgba(4,10,18,0.0) 30%, rgba(4,10,18,0.88) 100%)" aria-hidden="true"></div>
          </div>
        )}

        <!-- Contenido -->
        <div class="flex flex-col gap-3 p-5 flex-1">
          <!-- Ícono -->
          <div class="w-10 h-10 flex items-center justify-center shrink-0" style={`border:1px solid rgba(74,117,153,0.3);color:${ind.color}`}>
            <span class="w-5 h-5 block" set:html={ind.icon}/>
          </div>

          <!-- Título + tagline -->
          <div class="flex flex-col gap-1.5 flex-1">
            <h3 class="font-display font-bold" style="font-size:1.1rem;color:#FFFFFF;line-height:1.1">
              {ind.name}
            </h3>
            <p class="text-xs leading-relaxed" style="color:#64748B">{ind.tagline}</p>
          </div>

          <!-- CTA -->
          <div class="flex items-center gap-1.5 text-xs font-display font-semibold uppercase tracking-wider group-hover:text-[#FF6B26]" style="color:var(--forge-300);letter-spacing:0.1em">
            {ind.cta}
            
          </div>
        </div>
      </a>
    ))}
  </div>

</section>
