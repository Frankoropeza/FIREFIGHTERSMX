---
const industries = [
  { slug: 'bomberos-municipales',  name: 'Bomberos Municipales',  tagline: 'Equipamiento integral y soporte para licitaciones CompraNet', color: '#C8102E', image: '/images/industrias/bomberos-municipales.avif',  imageAlt: 'Cuerpo de bomberos municipales con equipo NFPA certificado México', icon: `` },
  { slug: 'brigadas-industriales', name: 'Brigadas Industriales', tagline: 'NOM-002-STPS llave en mano: equipo + capacitación DC-3',         color: '#B54708', image: '/images/industrias/brigadas-industriales.avif', imageAlt: 'Brigada industrial equipada NOM-002-STPS capacitación contra incendio', icon: `` },
  { slug: 'aeropuertos-arff',      name: 'Aeropuertos ARFF',      tagline: 'Trajes de proximidad, SCBA 60 min y espuma AFFF',               color: '#C8102E', image: '/images/industrias/aeropuertos-arff.avif',      imageAlt: 'Equipo ARFF para aeropuertos traje proximidad SCBA 60 minutos', icon: `` },
  { slug: 'hospitales',            name: 'Hospitales y Salud',    tagline: 'Agentes limpios FM-200, alarmas y brigada certificada',         color: '#067647', image: '/images/industrias/hospitales.avif',            imageAlt: 'Sistema contra incendio hospitales FM-200 NFPA brigada certificada', icon: `` },
  { slug: 'refinerias-pemex',      name: 'Refinerías PEMEX',      tagline: 'HAZMAT Nivel A/B, SCBA 60 min, detectores ATEX',               color: '#C8102E', image: '/images/industrias/refinerias-pemex.avif',      imageAlt: 'Equipo HAZMAT nivel A/B refinería PEMEX SCBA 60 min detectores ATEX', icon: `` },
  { slug: 'hoteles',               name: 'Hoteles y Turismo',     tagline: 'Rociadores NFPA 13, alarmas de voz y brigada',                  color: '#B54708', image: '/images/industrias/hoteles.avif',               imageAlt: 'Sistema contra incendio hotel rociadores NFPA 13 alarmas voz', icon: `` },
  { slug: 'mineria',               name: 'Minería',               tagline: 'SCBA espacios confinados, detectores multi-gas NOM-032',        color: '#C8102E', image: '/images/industrias/mineria.avif',               imageAlt: 'SCBA espacios confinados minería detectores multi-gas NOM-032 México', icon: `` },
  { slug: 'proteccion-civil',      name: 'Protección Civil',      tagline: 'Equipamiento y capacitación NFPA para PC estatal y municipal',  color: '#067647', image: '/images/industrias/proteccion-civil.avif',      imageAlt: 'Protección civil estatal municipal equipo NFPA capacitación México', icon: `` },
].map((ind) => ({
  ...ind,
  cta: {
    'bomberos-municipales': 'Equipo para bomberos',
    'brigadas-industriales': 'Brigadas industriales',
    'aeropuertos-arff': 'Equipo ARFF',
    hospitales: 'Protección para hospitales',
    'refinerias-pemex': 'Equipo para refinerías',
    hoteles: 'Sistemas para hoteles',
    mineria: 'Equipo para minería',
    'proteccion-civil': 'Equipo para protección civil',
  }[ind.slug],
}));
---

<section class="home-deferred-section" style="background:var(--c-bg);padding-block:5rem" aria-label="Sectores que atendemos">

  <!-- Header -->
  <div class="container-site mb-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end">
      <div>
        <span class="section-eyebrow mb-4 inline-flex">Sectores</span>
        <h2 class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
          Protección contra incendios<br/>
          <span style="color:var(--c-accent)">para cada industria.</span>
        </h2>
      </div>
      <div style="padding-left:1.75rem">
        <p class="text-sm leading-relaxed mb-3" style="color:var(--c-text-2)">
          Más de 15 años atendiendo industrias, comercios y cuerpos de emergencia: desde brigadas internas de empresas hasta cuerpos de bomberos estatales y plantas petroquímicas.
        </p>
        <p class="text-sm leading-relaxed" style="color:var(--c-text-2)">
          Cada sector tiene normas, presupuestos y calendarios distintos.
          Te asignamos un ejecutivo que ya equipó proyectos similares al tuyo.
        </p>
      </div>
    </div>
  </div>

  <!-- Grid full-width -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4" style="border-top:1px solid var(--c-line);border-left:1px solid var(--c-line)">
    {industries.map((ind) => (
      <a
        href={`/industrias/${ind.slug}`}
        class="grid-cell group relative flex flex-col overflow-hidden"
        style="border-right:1px solid var(--c-line);border-bottom:1px solid var(--c-line)"
      >
        <!-- Accent bar left -->

        <!-- Imagen de sector -->
        {ind.image && (
          <div class="relative overflow-hidden shrink-0" style="height:9rem">
            <img
              src={ind.image}
              alt={ind.imageAlt}
              width="320"
              height="144"
              loading="lazy"
              decoding="async"
              class="w-full h-full block"
              style="object-fit:cover;object-position:center 20%"
            />
          </div>
        )}

        <!-- Contenido -->
        <div class="flex flex-col gap-3 p-5 flex-1">
          <!-- Ícono -->

          <!-- Título + tagline -->
          <div class="flex flex-col gap-1.5 flex-1">
            <h3 class="font-display font-bold" style="font-size:1.1rem;color:var(--c-ink);line-height:1.1">
              {ind.name}
            </h3>
            <p class="text-xs leading-relaxed" style="color:var(--c-muted)">{ind.tagline}</p>
          </div>

          <!-- CTA -->
          <div class="flex items-center gap-1.5 text-xs font-display font-semibold uppercase tracking-wider group-hover:text-[var(--c-accent)]" style="color:var(--forge-300);letter-spacing:0.1em">
            {ind.cta}
            
          </div>
        </div>
      </a>
    ))}
  </div>

</section>
