---
/**
 * Servicios de la portada — cards estándar del sitio (LineaCard): imagen · norma ·
 * título · texto · conceptos incluidos (enlazan a su ancla) · botón principal.
 * Fuente de datos: src/data/services.ts
 */
import { services } from '@data/services';
import LineaCard from '@components/products/LineaCard.astro';
import { slugify } from '@lib/slug';
---

<section class="home-deferred-section section" style="background:var(--c-bg-alt)" aria-labelledby="services-title">
  <div class="container-site">

    <!-- Header -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
      <div>
        <span class="section-eyebrow mb-4 inline-flex">Servicios profesionales</span>
        <h2 id="services-title" class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
          Servicios contra incendio para empresas,<br/>
          <span style="color:var(--c-accent)">brigadas y cuerpos de bomberos.</span>
        </h2>
      </div>
      <div style="padding-left:1.75rem">
        <p class="text-sm leading-relaxed mb-3" style="color:var(--c-text-2)">
          Venta, capacitación, mantenimiento, instalación y soporte para licitaciones.
          Todo desde un solo proveedor, para que tu operación cumpla la normativa
          vigente sin coordinar a tres empresas distintas.
        </p>
        <a href="/servicios" class="inline-flex items-center gap-2 text-xs font-display font-semibold uppercase tracking-wider hover:text-[var(--c-accent)]" style="color:var(--c-accent);letter-spacing:0.1em">
          Todos los servicios contra incendio
          
        </a>
      </div>
    </div>

    <!-- Cards de servicio: misma pieza que el catálogo (LineaCard) -->
    <ul class="card-grid sv-grid" role="list">
      {services.map((s, i) => {
        const base = s.href.endsWith('/') ? s.href : `${s.href}/`;
        // Fila final incompleta (4 por fila): sus cards se ensanchan y pasan a formato horizontal.
        const n = services.length, r = n % 4, enUltimaFila = r > 0 && i >= n - r;
        const ancho = !enUltimaFila ? '' : r === 1 ? 'sv-span-4' : r === 2 ? 'sv-span-2' : (i === n - r ? 'sv-span-2' : '');
        return (
          <li class={ancho || undefined}>
            <LineaCard
              href={base}
              norma={s.norm}
              titulo={s.title}
              texto={s.shortDesc}
              imagen={s.spotlight?.image ?? `/images/servicios/${s.slug}.avif`}
              imagenAlt={s.spotlight?.imageAlt ?? s.title}
              hijas={s.items.map((it) => ({ label: it.name, href: `${base}#incluye-${slugify(it.name)}` }))}
              cta={s.cta}
              nivel="h3"
              subLabel="Qué incluye"
            />
          </li>
        );
      })}
    </ul>

  </div>
</section>

<style>
  .sv-grid { margin: 0; padding: 0; list-style: none; }
  @media (min-width: 1024px) {
    .sv-span-2 { grid-column: span 2; }
    .sv-span-4 { grid-column: span 4; }
    .sv-span-2 :global(.lc), .sv-span-4 :global(.lc) { flex-direction: row; }
    .sv-span-2 :global(.lc-media), .sv-span-4 :global(.lc-media) { flex: 0 0 46%; aspect-ratio: auto; min-height: 100%; }
    .sv-span-4 :global(.lc-media) { flex-basis: 40%; }
    .sv-span-2 :global(.lc-body), .sv-span-4 :global(.lc-body) { padding: 1.5rem; }
  }
</style>
