---
/**
 * Servicios numerados 01–06 — lista editorial estilo"ledger".
 * Fuente de datos: src/data/services.ts
 */
import { services } from '@data/services';
import CardMedia from '@components/common/CardMedia.astro';
---

<section class="home-deferred-section section" style="background:var(--c-bg-alt)" aria-labelledby="services-title">
  <div class="container-site">

    <!-- Header -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
      <div>
        <span class="section-eyebrow mb-4 inline-flex">Servicios profesionales</span>
        <h2 id="services-title" class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
          Servicios contra incendio para empresas,<br/>
          <span style="color:var(--c-accent)">brigadas y cuerpos de bomberos.</span>
        </h2>
      </div>
      <div style="padding-left:1.75rem">
        <p class="text-sm leading-relaxed mb-3" style="color:var(--c-text-2)">
          Venta, capacitación, mantenimiento, instalación y soporte para licitaciones.
          Todo desde un solo proveedor, para que tu operación cumpla la normativa
          vigente sin coordinar a tres empresas distintas.
        </p>
        <a href="/servicios" class="inline-flex items-center gap-2 text-xs font-display font-semibold uppercase tracking-wider hover:text-[var(--c-accent)]" style="color:var(--c-accent);letter-spacing:0.1em">
          Todos los servicios contra incendio
          
        </a>
      </div>
    </div>

    <!-- Lista numerada -->
    <ol class="card-grid card-grid--cells list-none m-0 p-0" >
      {services.map((s, i) => (
        <li class="m-0 p-0" style="background:var(--c-bg-alt)">
          <a
            href={s.href}
            class="service-row group flex flex-col gap-5 p-6 lg:p-7"
            style="background:var(--c-bg-alt);height:100%"
          >
            <CardMedia src={s.spotlight?.image ?? `/images/servicios/${s.slug}.avif`} alt={s.spotlight?.imageAlt ?? s.title} />
            <span class="flex items-start gap-5">
            <span class="font-display font-bold text-2xl shrink-0 group-hover:text-[var(--c-accent)]" style="color:var(--c-muted);min-width:2.5rem" aria-hidden="true">
              
            </span>
            <span class="flex flex-col gap-1.5 flex-1">
              <span class="font-display font-bold text-lg leading-tight group-hover:text-[var(--c-accent)]" style="color:var(--c-ink)">{s.title}</span>
              <span class="text-sm leading-relaxed" style="color:var(--c-muted)">{s.shortDesc}</span>
            </span>
            
            </span>
          </a>
        </li>
      ))}
    </ol>

  </div>
</section>

<style>
  .service-row:hover { background: var(--c-surface) !important; }
</style>
