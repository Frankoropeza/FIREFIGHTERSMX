---
import { brands, type Brand } from '@data/brands';

const destacadas = ['globe-manufacturing', 'lion-apparel', 'msa-safety', 'drager', '3m-scott', 'bullard', 'cairns-helmets', 'holmatro', 'flir-teledyne'];
const lista = destacadas
  .map((s) => brands.find((b) => b.slug === s))
  .filter((brand): brand is Brand => Boolean(brand));
---

<section class="section home-deferred-section" style="background:#040A12" aria-labelledby="marcas-home-heading">
  <div class="container-site mb-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end">
      <div>
        <span class="section-eyebrow mb-4 inline-flex">Distribuidor autorizado</span>
        <h2 id="marcas-home-heading" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
          Marcas de equipo para bomberos<br/>
          <span style="color:#F75000">que distribuimos en México.</span>
        </h2>
      </div>
      <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
        <p class="text-sm leading-relaxed mb-3" style="color:#94A3B8">
          Trajes estructurales Globe y Lion, cascos Bullard, Cairns y MSA Gallet, equipo de respiración autónoma MSA, Dräger y 3M Scott, herramientas de rescate Holmatro y cámaras térmicas FLIR. Cada equipo de protección personal para bomberos se entrega con número de serie verificable y certificado NFPA.
        </p>
        <a href="/marcas/"
           class="inline-flex items-center gap-2 text-xs font-display font-semibold uppercase tracking-wider hover:text-[#FF6B26]"
           style="color:#FF8F57;letter-spacing:0.1em">
          Todas las marcas que distribuimos
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <div class="container-site">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px" style="background:rgba(74,117,153,0.18);border:1px solid rgba(74,117,153,0.18)">
      {lista.map((b) => (
        <a href={`/marcas/${b.slug}/`} class="grid-cell ledger-cell flex flex-col gap-2 p-6" style="background:#070E1A">
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="font-display font-bold text-lg" style="color:#FFFFFF">{b.name}</h3>
            {b.country && <span class="text-xs shrink-0" style="color:var(--forge-300)">{b.country}</span>}
          </div>
          <p class="text-xs leading-relaxed" style="color:#64748B">{b.description}</p>
          <p class="text-[11px] uppercase tracking-wider" style="color:#FF8F57">
            {b.products.slice(0, 3).map((product) => product.name).join(' · ')}
          </p>
        </a>
      ))}
    </div>
  </div>
</section>
