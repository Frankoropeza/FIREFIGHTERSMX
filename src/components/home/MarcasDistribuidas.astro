---
import { brands, type Brand } from '@data/brands';
import CardMedia from '@components/common/CardMedia.astro';

const destacadas = ['tyco-johnson-controls', 'honeywell', 'msa-safety', 'drager', '3m-scott', 'globe-manufacturing', 'bullard', 'holmatro'];
const lista = destacadas
  .map((s) => brands.find((b) => b.slug === s))
  .filter((brand): brand is Brand => Boolean(brand));
---

<section class="section home-deferred-section" style="background:var(--c-bg)" aria-labelledby="marcas-home-heading">
  <div class="container-site mb-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end">
      <div>
        <span class="section-eyebrow mb-4 inline-flex">Distribuidor autorizado</span>
        <h2 id="marcas-home-heading" class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
          Marcas de equipo contra incendio<br/>
          <span style="color:var(--c-accent)">que distribuimos en México.</span>
        </h2>
      </div>
      <div style="border-left:2px solid rgba(200,16,46,0.4);padding-left:1.75rem">
        <p class="text-sm leading-relaxed mb-3" style="color:var(--c-text-2)">
          Rociadores y válvulas Tyco, paneles de alarma Notifier y detectores Honeywell para el sistema contra incendio; trajes Globe y Lion, cascos Bullard y MSA Gallet, equipo de respiración autónoma MSA, Dräger y 3M Scott, herramientas de rescate Holmatro y cámaras térmicas FLIR para el equipo de bomberos. Cada equipo se entrega con número de serie verificable y certificado de fábrica.
        </p>
        <a href="/marcas/"
           class="inline-flex items-center gap-2 text-xs font-display font-semibold uppercase tracking-wider hover:text-[var(--c-accent)]"
           style="color:var(--c-accent);letter-spacing:0.1em">
          Todas las marcas que distribuimos
          
        </a>
      </div>
    </div>
  </div>

  <div class="container-site">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px" style="background:var(--c-line);border:1px solid var(--c-line)">
      {lista.map((b) => (
        <a href={`/marcas/${b.slug}/`} class="grid-cell ledger-cell flex flex-col gap-2 p-6" style="background:var(--c-bg-alt)">
          <CardMedia src={`/images/home/marca-${b.slug}.avif`} alt={`Equipo de la línea ${b.name}`} class="mb-2" />
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="font-display font-bold text-lg" style="color:var(--c-ink)">{b.name}</h3>
            {b.country && <span class="text-xs shrink-0" style="color:var(--forge-300)">{b.country}</span>}
          </div>
          <p class="text-xs leading-relaxed" style="color:var(--c-muted)">{b.description}</p>
          <p class="text-[11px] uppercase tracking-wider" style="color:var(--c-accent)">
            {b.products.slice(0, 3).map((product) => product.name).join(' · ')}
          </p>
        </a>
      ))}
    </div>
  </div>
</section>
