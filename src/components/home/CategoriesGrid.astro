---
const categorias = [
  {
    titulo: 'Trajes para Bomberos',
    norm: 'NFPA 1971 · 1977 · 1976',
    href: '/productos/trajes-bombero',
    color: '#F75000',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>`,
    items: ['Globe GX-7 Estructural','Lion TechGen NFPA 1971','Traje Forestal NFPA 1977'],
    span: 'lg:col-span-2 lg:row-span-2',
    large: true,
  },
  {
    titulo: 'Cascos NFPA',
    norm: 'NFPA 1971 · 1977',
    href: '/productos/cascos-nfpa',
    color: '#F75000',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 17a10 10 0 0 1 20 0"/><path d="M2 17h20v3H2z"/></svg>`,
    items: ['MSA Gallet F1 XF','Bullard USTERM','Cairns N6A Houston'],
    span: '',
    large: false,
  },
  {
    titulo: 'Equipos SCBA',
    norm: 'NFPA 1981 · NIOSH',
    href: '/productos/equipos-scba',
    color: '#F5A623',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M9 9h.01M15 9h.01M9.5 15a3.5 3.5 0 0 0 5 0"/></svg>`,
    items: ['MSA G1 SCBA','Dräger PSS 7000','3M Scott Air-Pak NxG7'],
    span: '',
    large: false,
  },
  {
    titulo: 'Herramientas de Rescate',
    norm: 'NFPA 1936',
    href: '/productos/herramientas-rescate',
    color: '#F75000',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
    items: ['Holmatro SPR 4250 SC','Holmatro CT 4260 HCS','Ariete SP 3220'],
    span: '',
    large: false,
  },
  {
    titulo: 'Extintores',
    norm: 'NOM-100-SCFI · NFPA 10',
    href: '/productos/extintores',
    color: '#F5A623',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M15 6v-3a3 3 0 0 0-6 0v3"/><rect x="6" y="6" width="12" height="14" rx="2"/><path d="M10 10h4M12 10v5"/></svg>`,
    items: ['CO₂ 10 kg Clase BC','PQS ABC 9 kg','AFFF 6% espuma'],
    span: '',
    large: false,
  },
  {
    titulo: 'Sistemas CI',
    norm: 'NFPA 13 · 72 · 2001',
    href: '/productos/sistemas-ci',
    color: '#34D399',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2z"/><path d="M12 8v4l3 3"/></svg>`,
    items: ['Rociadores Tyco NFPA 13','Panel Honeywell','FM-200 Agente limpio'],
    span: '',
    large: false,
  },
  {
    titulo: 'Cámaras Térmicas',
    norm: 'NFPA 1801',
    href: '/productos/camaras-termicas',
    color: '#F5A623',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>`,
    items: ['FLIR K65','MSA Evolution 6000','Bullard TXS'],
    span: '',
    large: false,
  },
  {
    titulo: 'Equipos HAZMAT',
    norm: 'NFPA 1991 · 1992',
    href: '/productos/hazmat',
    color: '#F75000',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>`,
    items: ['Traje Nivel A encapsulado','Traje Nivel B splash','DuPont Tychem 10000'],
    span: '',
    large: false,
  },
];
---

<section style="background:#040A12;padding-block:5rem" aria-label="Catálogo">

  <!-- Header -->
  <div class="container-site mb-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end">
      <div>
        <span class="section-eyebrow mb-4 inline-flex">Catálogo</span>
        <h2 class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
          Ocho categorías,<br/>
          <span style="color:#F75000">un solo proveedor.</span>
        </h2>
      </div>
      <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
        <p class="text-sm leading-relaxed mb-3" style="color:#94A3B8">
          Concentramos todo el equipamiento que un cuerpo de bomberos, brigada industrial
          o área de protección civil necesita: <strong style="color:#CBD5E1">trajes NFPA 1971, SCBA NFPA 1981,
          herramientas de rescate, extintores, sistemas CI, cámaras térmicas y HAZMAT</strong> —
          cada categoría con ficha técnica y certificado listos.
        </p>
        <a href="/productos" class="inline-flex items-center gap-2 text-xs font-display font-semibold uppercase tracking-wider transition-colors hover:text-[#FF6B26]" style="color:#FF8F57;letter-spacing:0.1em">
          Ver catálogo completo
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Grid full-width -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4" style="border-top:1px solid rgba(74,117,153,0.18);border-left:1px solid rgba(74,117,153,0.18)">
    {categorias.map((cat, i) => (
      <a
        href={cat.href}
        class={`grid-cell group relative flex flex-col gap-4 p-7 ${cat.span}`}
        style="border-right:1px solid rgba(74,117,153,0.18);border-bottom:1px solid rgba(74,117,153,0.18)"
      >
        <!-- Barra izquierda de acento en hover -->
        <div class="absolute left-0 top-0 bottom-0 w-[3px] opacity-0 group-hover:opacity-100 transition-opacity" style={`background:${cat.color}`}></div>

        <!-- Ícono + norm -->
        <div class="flex items-start justify-between">
          <div class="w-9 h-9 flex items-center justify-center shrink-0" style={`border:1px solid rgba(74,117,153,0.3);color:${cat.color}`}>
            <span class="w-4 h-4 block" set:html={cat.icon}/>
          </div>
          <span class="text-[10px] font-display font-semibold uppercase tracking-wider text-right" style="color:#4A7599">{cat.norm}</span>
        </div>

        <!-- Título -->
        <h3 class={`font-display font-bold transition-colors ${cat.large ? 'text-3xl lg:text-4xl' : 'text-xl'}`}
            style="color:#FFFFFF;line-height:1.1">
          {cat.titulo}
        </h3>

        <!-- Modelos -->
        <ul class="flex flex-col gap-1.5 mt-auto">
          {cat.items.map(item => (
            <li class="flex items-center gap-2 text-xs" style="color:#64748B">
              <span class="w-1 h-1 rounded-full shrink-0" style={`background:${cat.color};opacity:0.6`}></span>
              {item}
            </li>
          ))}
        </ul>

        <!-- Ver más -->
        <div class="flex items-center gap-1.5 text-xs font-display font-semibold uppercase tracking-wider transition-colors group-hover:text-[#FF6B26]" style="color:#4A7599;letter-spacing:0.1em;margin-top:0.5rem">
          Ver más
          <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </div>
      </a>
    ))}
  </div>
</section>
