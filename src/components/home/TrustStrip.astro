---
/**
 * Marcas autorizadas — strip estático (sin marquee ni animaciones).
 */
const marcas = [
  { name: 'Globe', sub: 'Trajes estructurales' },
  { name: 'MSA Safety', sub: 'SCBA & cascos' },
  { name: 'Dräger', sub: 'Equipos respiratorios' },
  { name: '3M Scott', sub: 'Aire autónomo' },
  { name: 'Bullard', sub: 'EPP & cascos' },
  { name: 'Holmatro', sub: 'Rescate hidráulico' },
  { name: 'Honeywell', sub: 'Detección & alarmas' },
  { name: 'FLIR', sub: 'Cámaras térmicas' },
  { name: 'Rosenbauer', sub: 'Sistemas CI' },
  { name: 'Haix', sub: 'Botas técnicas' },
];
---

<div style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.25)">
  <div class="container-site py-8">

    <p class="text-center text-[10px] font-display font-semibold uppercase tracking-[0.2em] mb-6" style="color:#4A7599">
      Distribuidores autorizados · Equipos originales certificados
    </p>

    <ul class="flex flex-wrap justify-center gap-x-10 gap-y-5 list-none m-0 p-0">
      {marcas.map(m => (
        <li class="flex flex-col items-center gap-1 select-none">
          <span class="font-display font-bold text-lg whitespace-nowrap" style="color:#7AA4C4">
            {m.name}
          </span>
          <span class="text-[10px] uppercase tracking-wider whitespace-nowrap" style="color:#4A7599">
            {m.sub}
          </span>
        </li>
      ))}
    </ul>

    <div class="text-center mt-6">
      <a href="/marcas" class="btn btn-sm btn-outline">Ver todas las marcas →</a>
    </div>
  </div>
</div>
