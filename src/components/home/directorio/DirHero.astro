---
import { imgAttrs, SIZES } from '@lib/img';
/**
 * Hero del portal-directorio — v2 (2026-09-04, a petición de Frank).
 * Dos columnas:
 *   izquierda  eyebrow + h1 + buscador (texto · giro · estado · botón) + búsquedas frecuentes
 *   derecha    dos párrafos SEO/marketing con el patrón prose + border-left del design system
 * Sin franja de stats. Foto de fondo con velo navy.
 */
import { giros } from '@data/giros';
import { estadosMeta } from '@lib/empresas';
---
<section class="relative overflow-hidden" style="background:var(--c-bg)" aria-labelledby="hero-heading">

  {/* Fondo: foto con velo navy — ambiente, no mensaje */}
  <picture aria-hidden="true">
    <img src="/images/hero/hero-portada-bombero-equipo-estructural.avif" {...imgAttrs("/images/hero/hero-portada-bombero-equipo-estructural.avif", SIZES.full)} alt="" width="1920" height="1080" fetchpriority="high" decoding="async"
      class="absolute inset-0 w-full h-full object-cover" style="object-position:70% 40%;opacity:0.22;filter:saturate(0.6) contrast(1.05)" />
  </picture>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background:linear-gradient(90deg, var(--c-bg) 0%, rgba(255,255,255,0.94) 45%, rgba(255,255,255,0.8) 100%)"></div>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background:linear-gradient(180deg, transparent 60%, var(--c-bg) 100%)"></div>
  

  <div class="container-site relative z-10 grid grid-cols-1 xl:grid-cols-[56fr_44fr] gap-0">

    {/* ─── IZQUIERDA: título + buscador ─── */}
    <div class="flex flex-col justify-center py-14 lg:py-20 xl:pr-16">

      <div class="flex flex-wrap items-center gap-3 mb-7">
        <span class="section-eyebrow">Directorio de equipo para bomberos · 32 estados</span>
      </div>

      <h1 id="hero-heading" class="font-display font-bold mb-9" style="line-height:1.08;letter-spacing:0.005em">
        <span class="block" style="font-size:clamp(2.25rem,4.5vw,3.5rem);color:var(--c-ink)">El directorio de estaciones de bomberos</span>
        <span class="block" style="font-size:clamp(2.25rem,4.5vw,3.5rem);color:var(--c-accent)">y equipo contra incendio</span>
        <span class="block" style="font-size:clamp(2.25rem,4.5vw,3.5rem);color:var(--c-ink)">de México</span>
      </h1>

      <form action="/empresas/" method="get" data-hero-search role="search" aria-label="Buscar empresas">
        <div class="hero-search flex flex-col">
          <div class="flex items-center gap-3 px-4" style="border-bottom:1px solid var(--c-line-strong)">
            
            <label class="sr-only" for="hs-q">Qué buscas</label>
            <input id="hs-q" name="q" type="search" autocomplete="off" placeholder="Empresa, ciudad o producto…" class="input w-full py-4 text-base font-display" />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2">
            <div class="flex items-center gap-2 px-4" style="border-bottom:1px solid var(--c-line-strong)">
              <span class="font-display text-[10px] uppercase tracking-widest shrink-0" style="color:var(--forge-300)">Giro</span>
              <label class="sr-only" for="hs-giro">Giro</label>
              <select id="hs-giro" name="giro" class="select py-3.5 font-display text-sm w-full">
                <option value="">Todos los giros</option>
                {giros.map((g) => <option value={g.slug}>{g.labelCorto}</option>)}
              </select>
            </div>
            <div class="flex items-center gap-2 px-4 sm:border-l" style="border-bottom:1px solid var(--c-line-strong);border-left-color:var(--c-line-strong)">
              <span class="font-display text-[10px] uppercase tracking-widest shrink-0" style="color:var(--forge-300)">Estado</span>
              <label class="sr-only" for="hs-estado">Estado</label>
              <select id="hs-estado" name="estado" class="select py-3.5 font-display text-sm w-full">
                <option value="">Todo México</option>
                {estadosMeta.map((e) => <option value={e.slug}>{e.nombre}</option>)}
              </select>
            </div>
          </div>
          <button type="submit" class="btn btn-primary btn-lg w-full rounded-none" style="min-height:60px">Buscar empresas</button>
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mt-4 text-xs" style="color:var(--forge-300)">
          <span class="font-display uppercase tracking-wider">Búsquedas frecuentes:</span>
          {[
            { l: 'Extintores en CDMX', h: '/empresas/extintores/ciudad-de-mexico/' },
            { l: 'Recarga en Jalisco', h: '/empresas/extintores/jalisco/' },
            { l: 'EPP en Nuevo León', h: '/empresas/venta-equipo/nuevo-leon/' },
            { l: 'Sistemas CI en Edomex', h: '/empresas/sistemas-ci/estado-de-mexico/' },
            { l: 'Capacitación en Guanajuato', h: '/empresas/capacitacion/guanajuato/' },
          ].map((x) => <a href={x.h} class="hover:text-[var(--c-accent)]" style="color:var(--c-text-2)">{x.l}</a>)}
        </div>
      </form>
    </div>

    {/* ─── DERECHA: dos párrafos SEO / marketing ─── */}
    <div class="flex flex-col justify-center py-10 xl:py-20 xl:pl-14">
      <div style="padding-left:1.75rem">
        <div class="flex items-center gap-2 mb-5">
          <span class="text-xs font-display font-semibold uppercase tracking-[0.18em]" style="color:var(--c-accent)">Un solo lugar para todo el sector</span>
        </div>
        <p class="text-sm lg:text-[15px] leading-[1.9] mb-5" style="color:var(--c-text)">
          FIREFIGHTERS MX reúne dos directorios en uno. Del lado operativo, las <strong style="color:var(--c-ink)">estaciones de bomberos</strong> del país: una ficha por estación física, con sus servicios y su fuente citada. Del lado del suministro, las empresas de <strong style="color:var(--c-ink)">equipo contra incendios y equipo de bombero</strong>: distribuidores de equipo de protección personal estructural, cascos, guantes y equipo de respiración autónoma; venta, recarga de extintores y mantenimiento preventivo; ingenierías de <strong style="color:var(--c-ink)">sistemas contra incendios</strong>, hidrantes, mangueras, rociadores y detección y alarma; equipo forestal y herramientas de rescate; y centros de capacitación de brigadas. Todo clasificado por giro y especialidad, georreferenciado y con fuente, en toda la República.
        </p>
        <p class="text-sm lg:text-[15px] leading-[1.9]" style="color:var(--c-text-2)">
          Si equipas a cuerpos de bomberos municipales, una brigada industrial o un área de protección civil estatal, aquí encuentras al proveedor correcto para tu tipo de riesgo y llegas a la cotización o a la licitación con la norma adecuada: <strong style="color:var(--c-text)">NOM-002-STPS, NOM-154-SCFI, NFPA 1970, NFPA 13 y NFPA 72</strong>. Pide siempre el certificado NFPA del modelo: la certificación NFPA acredita un producto certificado, no un catálogo completo, y una mención comercial no sustituye la evidencia. Si vendes, instalas, recargas o das asesoría y capacitación para el combate de incendios, reclama tu ficha y aparece frente a quienes ya consultan este directorio con el equipo certificado en la mano.
        </p>
      </div>
    </div>
  </div>


  <script>
    // Ruteo del buscador: giro+estado  L3; giro  L2; estado  L2 geo; solo texto  hub con ?q
    document.querySelectorAll<HTMLFormElement>('[data-hero-search]').forEach((f) => {
      f.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const d = new FormData(f);
        const q = String(d.get('q') ?? '').trim(), giro = String(d.get('giro') ?? ''), estado = String(d.get('estado') ?? '');
        let url = '/empresas/';
        if (giro && estado) url = `/empresas/${giro}/${estado}/`;
        else if (giro) url = `/empresas/${giro}/`;
        else if (estado) url = `/empresas/estado/${estado}/`;
        const anchor = giro || estado ? '#empresas' : '#buscar';
        window.location.href = url + (q ? `?q=${encodeURIComponent(q)}` : '') + anchor;
      });
    });
  </script>
</section>
