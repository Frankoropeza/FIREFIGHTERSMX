---
/**
 * Hero del portal-directorio — v2 (2026-09-04, a petición de Frank).
 * Dos columnas:
 *   izquierda  eyebrow + h1 + buscador (texto · giro · estado · botón) + búsquedas frecuentes
 *   derecha    dos párrafos SEO/marketing con el patrón prose + border-left del design system
 * Sin franja de stats. Foto de fondo con velo navy.
 */
import { giros } from '@data/giros';
import { estadosMeta } from '@lib/empresas';
---
<section class="relative overflow-hidden" style="background:#040A12;min-height:calc(100vh - 108px)" aria-labelledby="hero-heading">

  {/* Fondo: foto con velo navy — ambiente, no mensaje */}
  <picture aria-hidden="true">
    <img src="/images/hero/hero-portada-bombero-equipo-estructural.avif" alt="" width="1920" height="1080" fetchpriority="high" decoding="async"
      class="absolute inset-0 w-full h-full object-cover" style="object-position:70% 40%;opacity:0.22;filter:saturate(0.6) contrast(1.05)" />
  </picture>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background:linear-gradient(90deg, #040A12 0%, rgba(4,10,18,0.94) 40%, rgba(4,10,18,0.72) 100%)"></div>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true" style="background:linear-gradient(180deg, transparent 60%, #040A12 100%)"></div>
  <div class="absolute top-0 right-0 w-1/2 h-full pointer-events-none" aria-hidden="true" style="background:radial-gradient(ellipse 80% 70% at 90% 30%, rgba(247,80,0,0.12) 0%, transparent 65%)"></div>
  <svg class="absolute inset-0 w-full h-full pointer-events-none" style="opacity:0.03" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <defs><pattern id="hgrid" width="64" height="64" patternUnits="userSpaceOnUse"><path d="M 64 0 L 0 0 0 64" fill="none" stroke="#7AA4C4" stroke-width="0.5"/></pattern></defs>
    <rect width="100%" height="100%" fill="url(#hgrid)"/>
  </svg>
  {/* Línea vertical decorativa entre columnas */}
  <div class="absolute inset-y-0 left-[56%] w-px hidden xl:block pointer-events-none" aria-hidden="true"
    style="background:linear-gradient(to bottom, transparent 8%, rgba(247,80,0,0.14) 30%, rgba(247,80,0,0.14) 70%, transparent 92%)"></div>

  <div class="container-site relative z-10 grid grid-cols-1 xl:grid-cols-[56fr_44fr] gap-0" style="min-height:calc(100vh - 108px)">

    {/* ─── IZQUIERDA: título + buscador ─── */}
    <div class="flex flex-col justify-center py-14 lg:py-20 xl:pr-16">

      <div class="flex flex-wrap items-center gap-3 mb-7">
        <span class="section-eyebrow">Directorio de equipo para bomberos · 32 estados</span>
      </div>

      <h1 id="hero-heading" class="font-display font-bold uppercase mb-9" style="line-height:0.9;letter-spacing:0.005em">
        <span class="block" style="font-size:clamp(2.3rem,4.7vw,4.5rem);color:#FFFFFF">El directorio de estaciones de bomberos</span>
        <span class="block" style="font-size:clamp(2.3rem,4.7vw,4.5rem);color:#F75000">y equipo contra incendio</span>
        <span class="block" style="font-size:clamp(2.3rem,4.7vw,4.5rem);color:#FFFFFF">de México</span>
      </h1>

      <form action="/empresas/" method="get" data-hero-search role="search" aria-label="Buscar empresas">
        <div class="hero-search flex flex-col">
          <div class="flex items-center gap-3 px-4" style="border-bottom:1px solid rgba(74,117,153,0.3)">
            <svg class="w-5 h-5 shrink-0" style="color:var(--forge-300)" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <label class="sr-only" for="hs-q">Qué buscas</label>
            <input id="hs-q" name="q" type="search" autocomplete="off" placeholder="Empresa, ciudad o producto…" class="input w-full py-4 text-base font-display" />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2">
            <div class="flex items-center gap-2 px-4" style="border-bottom:1px solid rgba(74,117,153,0.3)">
              <span class="font-display text-[10px] uppercase tracking-widest shrink-0" style="color:var(--forge-300)">Giro</span>
              <label class="sr-only" for="hs-giro">Giro</label>
              <select id="hs-giro" name="giro" class="select py-3.5 font-display text-sm w-full">
                <option value="">Todos los giros</option>
                {giros.map((g) => <option value={g.slug}>{g.labelCorto}</option>)}
              </select>
            </div>
            <div class="flex items-center gap-2 px-4 sm:border-l" style="border-bottom:1px solid rgba(74,117,153,0.3);border-left-color:rgba(74,117,153,0.3)">
              <span class="font-display text-[10px] uppercase tracking-widest shrink-0" style="color:var(--forge-300)">Estado</span>
              <label class="sr-only" for="hs-estado">Estado</label>
              <select id="hs-estado" name="estado" class="select py-3.5 font-display text-sm w-full">
                <option value="">Todo México</option>
                {estadosMeta.map((e) => <option value={e.slug}>{e.nombre}</option>)}
              </select>
            </div>
          </div>
          <button type="submit" class="btn btn-primary btn-lg w-full rounded-none" style="min-height:60px">Buscar empresas</button>
        </div>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mt-4 text-xs" style="color:var(--forge-300)">
          <span class="font-display uppercase tracking-wider">Búsquedas frecuentes:</span>
          {[
            { l: 'Extintores en CDMX', h: '/empresas/extintores/ciudad-de-mexico/' },
            { l: 'Recarga en Jalisco', h: '/empresas/extintores/jalisco/' },
            { l: 'EPP en Nuevo León', h: '/empresas/venta-equipo/nuevo-leon/' },
            { l: 'Sistemas CI en Edomex', h: '/empresas/sistemas-ci/estado-de-mexico/' },
            { l: 'Capacitación en Guanajuato', h: '/empresas/capacitacion/guanajuato/' },
          ].map((x) => <a href={x.h} class="hover:text-[#FF6B26]" style="color:#94A3B8">{x.l}</a>)}
        </div>
      </form>
    </div>

    {/* ─── DERECHA: dos párrafos SEO / marketing ─── */}
    <div class="flex flex-col justify-center py-10 xl:py-20 xl:pl-14">
      <div style="border-left:2px solid rgba(247,80,0,0.45);padding-left:1.75rem">
        <div class="flex items-center gap-2 mb-5">
          <span class="text-xs font-display font-semibold uppercase tracking-[0.18em]" style="color:#F75000">Un solo lugar para todo el sector</span>
        </div>
        <p class="text-sm lg:text-[15px] leading-[1.9] mb-5" style="color:#CBD5E1">
          FIREFIGHTERS MX reúne dos directorios en uno. Del lado operativo, las <strong style="color:#FFFFFF">estaciones de bomberos</strong> del país: una ficha por estación física, con sus servicios y su fuente citada. Del lado del suministro, las empresas de <strong style="color:#FFFFFF">equipo contra incendios y equipo de bombero</strong>: distribuidores de equipo de protección personal estructural, cascos, guantes y equipo de respiración autónoma; venta, recarga de extintores y mantenimiento preventivo; ingenierías de <strong style="color:#FFFFFF">sistemas contra incendios</strong>, hidrantes, mangueras, rociadores y detección y alarma; equipo forestal y herramientas de rescate; y centros de capacitación de brigadas. Todo clasificado por giro y especialidad, georreferenciado y con fuente, en toda la República.
        </p>
        <p class="text-sm lg:text-[15px] leading-[1.9]" style="color:#94A3B8">
          Si equipas a cuerpos de bomberos municipales, una brigada industrial o un área de protección civil estatal, aquí encuentras al proveedor correcto para tu tipo de riesgo y llegas a la cotización o a la licitación con la norma adecuada: <strong style="color:#CBD5E1">NOM-002-STPS, NOM-154-SCFI, NFPA 1970, NFPA 13 y NFPA 72</strong>. Pide siempre el certificado NFPA del modelo: la certificación NFPA acredita un producto certificado, no un catálogo completo, y una mención comercial no sustituye la evidencia. Si vendes, instalas, recargas o das asesoría y capacitación para el combate de incendios, reclama tu ficha y aparece frente a quienes ya consultan este directorio con el equipo certificado en la mano.
        </p>
      </div>
    </div>
  </div>

  <div class="absolute bottom-0 left-0 right-0 h-px" aria-hidden="true" style="background:linear-gradient(90deg, transparent, rgba(247,80,0,0.4) 30%, rgba(247,80,0,0.4) 70%, transparent)"></div>

  <script>
    // Ruteo del buscador: giro+estado → L3; giro → L2; estado → L2 geo; solo texto → hub con ?q
    document.querySelectorAll<HTMLFormElement>('[data-hero-search]').forEach((f) => {
      f.addEventListener('submit', (ev) => {
        ev.preventDefault();
        const d = new FormData(f);
        const q = String(d.get('q') ?? '').trim(), giro = String(d.get('giro') ?? ''), estado = String(d.get('estado') ?? '');
        let url = '/empresas/';
        if (giro && estado) url = `/empresas/${giro}/${estado}/`;
        else if (giro) url = `/empresas/${giro}/`;
        else if (estado) url = `/empresas/estado/${estado}/`;
        const anchor = giro || estado ? '#empresas' : '#buscar';
        window.location.href = url + (q ? `?q=${encodeURIComponent(q)}` : '') + anchor;
      });
    });
  </script>
</section>
