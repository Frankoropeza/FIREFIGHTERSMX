---
/** Cómo se construye el directorio — la credibilidad como diferenciador */
import { confianzaConfig } from '@data/giros';
const pilares = [
  { t: 'Fuente citada en cada registro', d: 'Ningún registro entra sin fuente. Los básicos vienen del DENUE del INEGI con enlace a la ficha original; los verificados suman el sitio de la empresa, padrones de fabricantes o CompraNet.', i: `<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8"/>` },
  { t: 'Clasificación editorial por giro', d: 'El SCIAN no distingue una recargadora de extintores de un distribuidor de EPP: los mete en la misma clase. Nosotros leemos cada registro y lo asignamos a su giro y especialidades reales.', i: `<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/>` },
  { t: 'Verificación separada del dinero', d: 'El sello de datos verificados lo otorga la redacción contra fuentes. Un plan de pago compra visibilidad, nunca credibilidad: pagar no sube el nivel de verificación de una ficha.', i: `<path d="M12 2 4 5v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V5l-8-3z"/><path d="m9 12 2 2 4-4"/>` },
  { t: 'Georreferenciado desde el origen', d: 'Cada empresa tiene coordenadas de su registro público, no un centroide de ciudad. El mapa muestra dónde está realmente el proveedor respecto al cuartel, la planta o el aeropuerto que lo necesita.', i: `<path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/>` },
];
---
<section class="section" style="background:#040A12" aria-labelledby="conf-heading">
  <div class="container-site">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
      <div class="reveal">
        <span class="section-eyebrow mb-4 inline-flex">Cómo se construye</span>
        <h2 id="conf-heading" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">Un directorio que<br/><span style="color:#F75000">se puede citar.</span></h2>
      </div>
      <div class="reveal" data-delay="1" style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
        <p class="text-sm leading-relaxed mb-4" style="color:#94A3B8">Hay directorios del sector que inventan estaciones, teléfonos en secuencia y años de fundación. Éste sigue una regla dura: <strong style="color:#CBD5E1">un dato sin fuente se omite, nunca se inventa.</strong> Cada ficha declara su nivel de verificación.</p>
        <div class="flex flex-wrap gap-2">
          {(Object.keys(confianzaConfig) as (keyof typeof confianzaConfig)[]).map((k) => { const c = confianzaConfig[k]; return <span class="font-display text-[10px] uppercase tracking-wider px-2 py-1" title={c.descripcion} style={`color:${c.color};background:${c.bgColor};border:1px solid ${c.color}33`}>{c.label}</span>; })}
        </div>
      </div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-px" style="background:rgba(74,117,153,0.18);border:1px solid rgba(74,117,153,0.18)">
      {pilares.map((p, i) => (
        <div class="reveal flex flex-col gap-4 p-7" data-delay={String(i)} style="background:#070E1A">
          <span class="w-10 h-10 flex items-center justify-center" style="color:#F75000;border:1px solid rgba(247,80,0,0.35)"><svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" set:html={p.i} aria-hidden="true"/></span>
          <h3 class="font-display font-bold text-lg leading-snug" style="color:#FFFFFF">{p.t}</h3>
          <p class="text-sm leading-relaxed" style="color:#94A3B8">{p.d}</p>
        </div>))}
    </div>
  </div>
</section>
