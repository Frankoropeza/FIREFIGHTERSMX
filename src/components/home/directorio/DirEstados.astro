---
/** Los 32 estados — enlaces limpios, agrupados por región, sin contadores */
import { estadosMeta } from '@lib/empresas';
const regiones = [...new Set(estadosMeta.map((e) => e.region))];
const porRegion = regiones.map((r) => ({ r, estados: estadosMeta.filter((e) => e.region === r) }));
---
<section class="section home-deferred-section" style="background:var(--c-bg-alt)" aria-labelledby="estados-heading">
  <div class="container-site">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
      <div>
        <span class="section-eyebrow mb-4 inline-flex">Por estado</span>
        <h2 id="estados-heading" class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">Equipo contra incendio y proveedores certificados<br/><span style="color:var(--c-accent)">en los 32 estados.</span></h2>
      </div>
      <div style="padding-left:1.75rem">
        <p class="text-sm leading-relaxed" style="color:var(--c-text-2)">Cada estado tiene su directorio propio de empresas —con mapa, buscador y filtros por giro— y su directorio de cuerpos de bomberos, que son los compradores naturales del sector. Elige tu entidad para ver los proveedores más cercanos.</p>
      </div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px" style="background:var(--c-line);border:1px solid var(--c-line)">
      {porRegion.map((g) => (
        <div class="flex flex-col p-6" style="background:var(--c-bg)">
          <span class="font-display font-bold text-2xs uppercase tracking-widest mb-3" style="color:var(--c-accent)">{g.r}</span>
          <ul class="flex flex-col list-none m-0 p-0" style="border-top:1px solid var(--c-line)">
            {g.estados.map((e) => (
              <li style="border-bottom:1px solid var(--c-line)">
                <a href={`/empresas/estado/${e.slug}/`} class="ledger-cell block py-2 pl-3 -ml-3 font-display font-semibold text-sm hover:text-[var(--c-accent)]" style="color:var(--c-text)">Equipo contra incendio en {e.nombre}</a>
              </li>))}
          </ul>
        </div>))}
    </div>
  </div>
</section>
