---
/** El catálogo, reencuadrado: guías de compra por categoría (autoridad, no oferta) */
import CategoryCard from '@components/products/CategoryCard.astro';
import { allCategories } from '@data/categories';
const cards = allCategories.filter((c) => c.slug !== 'drones-emergencia');
---
<section class="section" style="background:#070E1A" aria-labelledby="guias-heading">
  <div class="container-site">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
      <div class="reveal">
        <span class="section-eyebrow mb-4 inline-flex">Guías de compra</span>
        <h2 id="guias-heading" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">Qué pedir, qué norma aplica<br/><span style="color:#F75000">y cómo comparar.</span></h2>
      </div>
      <div class="reveal" data-delay="1" style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
        <p class="text-sm leading-relaxed mb-3" style="color:#94A3B8">Ocho categorías de equipo con ficha técnica de referencia, norma NFPA o NOM aplicable, marcas del mercado y criterios de evaluación para licitación. Úsalas antes de pedir cotización a cualquier empresa del directorio.</p>
        <a href="/productos/" class="inline-flex items-center gap-2 text-xs font-display font-semibold uppercase tracking-wider hover:text-[#FF6B26]" style="color:#FF8F57;letter-spacing:0.1em">Ver todas las guías <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/></svg></a>
      </div>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {cards.map((cat, i) => <div class="reveal" data-delay={String(i % 4)}><CategoryCard cat={cat} /></div>)}
    </div>
  </div>
</section>
