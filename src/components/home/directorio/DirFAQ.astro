---
/** FAQ del directorio — acordeón nativo <details>, sin JS */
import { directorioFaqs as faqs } from '@data/faqs';
---
<section class="section" style="background:#070E1A" aria-labelledby="faq-heading">
  <div class="container-site grid grid-cols-1 lg:grid-cols-[minmax(0,420px)_1fr] gap-10 lg:gap-20 items-start">
    <div class="reveal lg:sticky lg:top-28">
      <span class="section-eyebrow mb-4 inline-flex">Preguntas frecuentes</span>
      <h2 id="faq-heading" class="font-display font-bold mb-4" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">Cómo funciona<br/><span style="color:#F75000">el directorio.</span></h2>
      <p class="text-sm leading-relaxed mb-6" style="color:#94A3B8">Lo que preguntan jefes de cuerpo, coordinadores de seguridad, áreas de compras y las propias empresas del sector.</p>
      <div class="flex flex-col gap-3">
        <a href="/empresas/" class="btn btn-primary">Buscar empresas</a>
        <a href="/contacto/" class="btn btn-ghost">Contactar al equipo →</a>
      </div>
    </div>
    <div class="reveal" data-delay="1" style="border:1px solid rgba(74,117,153,0.2);background:#0C1825">
      {faqs.map((f, i) => (
        <details class="group" style="border-bottom:1px solid rgba(74,117,153,0.15)" open={i === 0}>
          <summary class="flex items-start justify-between gap-4 px-6 py-5 cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            <span class="font-display font-semibold text-base leading-snug" style="color:#FFFFFF">{f.q}</span>
            <span class="shrink-0 w-6 h-6 flex items-center justify-center font-display text-lg group-open:rotate-45" style="color:#F75000;border:1px solid rgba(247,80,0,0.35)" aria-hidden="true">+</span>
          </summary>
          <p class="px-6 pb-6 text-sm leading-[1.85]" style="color:#94A3B8">{f.a}</p>
        </details>))}
    </div>
  </div>
</section>
