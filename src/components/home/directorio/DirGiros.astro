---
/**
 * Los 5 giros del directorio — cards con imagen, título, texto y botón.
 * Es el módulo principal del home: son las categorías del directorio.
 * Imagen y claim vienen de giros.ts (cambiar la foto = una línea).
 * Hover instantáneo (borde y velo de la imagen), sin transform.
 */
import { giros } from '@data/giros';
import { conteoPorEstado } from '@lib/empresas';
const topPorGiro = Object.fromEntries(await Promise.all(giros.map(async (g) => [g.slug, (await conteoPorEstado(g.slug)).filter((s) => s.total > 0).sort((a, b) => b.total - a.total).slice(0, 3)])));
---
<section class="section home-deferred-section" style="background:var(--c-bg-alt)" aria-labelledby="giros-heading">
  <div class="container-site">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
      <div>
        <span class="section-eyebrow mb-4 inline-flex">Por giro</span>
        <h2 id="giros-heading" class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">Cinco giros de equipo contra incendio:<br/><span style="color:var(--c-accent)">extintores, hidrantes, sistemas y EPP.</span></h2>
      </div>
      <div style="padding-left:1.75rem">
        <p class="text-sm leading-relaxed mb-3" style="color:var(--c-text-2)">El sector no tiene clasificación oficial propia: el SCIAN reparte a estas empresas en más de treinta clases. Nosotros las agrupamos por lo que realmente hacen, para que un jefe de bomberos, una brigada industrial o un comprador de gobierno encuentre al proveedor correcto sin intermediarios.</p>
        <a href="/empresas/" class="inline-flex items-center gap-2 text-xs font-display font-semibold uppercase tracking-wider hover:text-[var(--c-accent)]" style="color:var(--c-accent);letter-spacing:0.1em">Directorio completo de equipo contra incendios </a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-5 gap-5">
      {giros.map((g) => {
        const top = topPorGiro[g.slug] as { slug: string; nombre: string; total: number }[];
        return (
          <article class="giro-card group relative flex flex-col overflow-hidden" style={`--giro:${g.color};background:var(--c-bg);border:1px solid var(--c-line)`}>

            {/* Imagen */}
            <a href={`/empresas/${g.slug}/`} class="relative block overflow-hidden" style="aspect-ratio:16/10" aria-label={`Empresas de ${g.labelCorto.toLowerCase()} en México`}>
              <img src={g.imagen} alt={g.imagenAlt} width="640" height="400" loading="lazy" decoding="async"
                class="giro-img absolute inset-0 w-full h-full object-cover" style="object-position:center 30%" />
              {/* Chip del giro */}
              <span class="absolute top-4 left-4 inline-flex items-center gap-1.5 font-display font-bold text-[10px] uppercase tracking-wider px-2 py-1" style={`color:#FFFFFF;background:${g.color};box-shadow:0 2px 12px ${g.color}66`}>
                {g.labelCorto}
              </span>
            </a>

            {/* Cuerpo */}
            <div class="flex flex-col flex-1 gap-3 p-6">
              <h3 class="font-display font-bold text-[1.35rem] leading-tight" style="color:var(--c-ink)">
                <a href={`/empresas/${g.slug}/`} class="hover:text-[var(--c-accent)]">{g.label}</a>
              </h3>
              <p class="text-sm leading-relaxed" style="color:var(--c-text-2)">{g.claim}</p>
              <p class="text-xs leading-relaxed" style="color:var(--forge-300)">
                <span class="font-display uppercase tracking-wider" style="color:var(--c-muted)">Mayor oferta:</span>{' '}
                {top.map((t, k) => <Fragment>{k > 0 && ' · '}<a href={`/empresas/${g.slug}/${t.slug}/`} class="hover:text-[var(--c-accent)]" style="color:var(--c-text-2)">{t.nombre}</a></Fragment>)}
              </p>
              <a href={`/empresas/${g.slug}/`} class="btn btn-primary w-full justify-center mt-auto" style="margin-top:auto">{g.labelCorto} en México </a>
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* Hover instantáneo, sin transiciones ni transform (regla del design system) */
  .giro-card:hover { border-color: var(--giro); }
  .giro-img { filter: saturate(0.75) contrast(1.05); }
  .giro-card:hover .giro-img { filter: saturate(1) contrast(1.05); }
</style>
