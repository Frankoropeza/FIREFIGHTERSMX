---
import CategoryCard from '@components/products/CategoryCard.astro';
import { allCategories } from '@data/categories';

const categoryBySlug = new Map(allCategories.map((category) => [category.slug, category]));
const category = (slug: string) => categoryBySlug.get(slug)!;

const lineas = [
  {
    label: 'Extintores',
    norm: 'NOM-100-STPS · NOM-102-STPS · NFPA 10',
    desc: 'Extintores portátiles de polvo químico seco, CO₂ y tipo K, y sobre ruedas para alto riesgo.',
    items: ['PQS ABC', 'CO₂', 'Tipo K'],
    href: '/productos/extintores/',
    ctaLabel: 'Extintores',
    icon: category('extintores').icon,
    accent: category('extintores').accent,
  },
  {
    label: 'Rociadores automáticos',
    norm: 'NFPA 13',
    desc: 'Rociadores que liberan agua sobre el fuego en su etapa inicial, diseñados por densidad de riesgo.',
    items: ['Tyco', 'Viking', 'ESFR'],
    href: '/productos/sistemas-ci/rociadores-contra-incendio/',
    ctaLabel: 'Rociadores contra incendio',
    icon: '',
    accent: category('sistemas-ci').accent,
  },
  {
    label: 'Detectores de humo y alarmas',
    norm: 'NFPA 72',
    desc: 'Paneles direccionables, detectores y estaciones manuales que alertan a los ocupantes.',
    items: ['Notifier', 'Honeywell', 'System Sensor'],
    href: '/productos/sistemas-ci/alarma-contra-incendio/',
    ctaLabel: 'Alarma contra incendio',
    icon: '',
    accent: '#F5A623',
  },
  {
    label: 'Red hidráulica y bombas',
    norm: 'NFPA 14 · 20',
    desc: 'Bombas, gabinetes, mangueras, monitores y conexiones para un suministro constante de agua.',
    items: ['Bomba jockey', 'Bomba diésel', 'Gabinete tipo I y II'],
    href: '/productos/sistemas-ci/bombas-contra-incendio/',
    ctaLabel: 'Bombas contra incendio',
    icon: '',
    accent: '#F75000',
  },
  {
    label: 'Hidrantes y gabinetes',
    norm: 'NFPA 14',
    desc: 'Hidrantes, gabinetes con manguera, válvulas y conexiones para la red de hidrantes.',
    items: ['Gabinete tipo I', 'Gabinete tipo II', 'Toma siamesa'],
    href: '/productos/sistemas-ci/hidrantes-contra-incendio/',
    ctaLabel: 'Hidrantes contra incendio',
    icon: '',
    accent: '#60A5FA',
  },
  {
    label: 'Supresión con agentes limpios',
    norm: 'NFPA 2001',
    desc: 'Sistemas fijos sin agua para centros de datos, archivos y cuartos eléctricos.',
    items: ['FM-200', 'Novec 1230', 'CO₂ alta presión'],
    href: '/productos/sistemas-ci/fm200-novec/',
    ctaLabel: 'Sistemas de supresión',
    icon: '',
    accent: category('sistemas-ci').accent,
  },
  {
    label: 'Señalización y emergencia',
    norm: 'NOM-003-SSPC-2011 · NOM-026-STPS',
    desc: 'Señales de protección civil y seguridad industrial, lámparas de emergencia y botiquines.',
    items: ['Señales de protección civil', 'Lámparas de emergencia', 'Botiquines'],
    href: '/productos/senalizacion-emergencia/',
    ctaLabel: 'Señalización y emergencia',
    icon: category('senalizacion-emergencia').icon,
    accent: category('senalizacion-emergencia').accent,
  },
  {
    label: 'Equipo para bomberos',
    norm: 'NFPA 1970',
    desc: 'Trajes estructurales, cascos, guantes y botas con certificación de laboratorio acreditado.',
    items: ['Globe', 'Lion', 'Bullard y MSA'],
    href: '/productos/trajes-bombero/',
    ctaLabel: 'Equipo para bomberos',
    icon: category('trajes-bombero').icon,
    accent: category('trajes-bombero').accent,
  },
  {
    label: 'Respiración y rescate',
    norm: 'NFPA 1970 · 1936',
    desc: 'Equipo de respiración autónoma, herramientas hidráulicas, cámaras térmicas y HAZMAT.',
    items: ['MSA y Dräger', '3M Scott', 'Holmatro'],
    href: '/productos/equipos-scba/',
    ctaLabel: 'Equipos SCBA',
    icon: category('equipos-scba').icon,
    accent: category('equipos-scba').accent,
  },
];
---

<section class="section home-deferred-section" style="background:#040A12" aria-labelledby="lineas-ci-heading">
  <div class="container-site mb-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end">
      <div>
        <span class="section-eyebrow mb-4 inline-flex">Catálogo contra incendio</span>
        <h2 id="lineas-ci-heading" class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
          Equipo contra incendio<br/>
          <span style="color:#F75000">para cada tipo de riesgo.</span>
        </h2>
      </div>
      <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
        <p class="text-sm leading-relaxed mb-3" style="color:#94A3B8">
          Los equipos contra incendios se dividen en cuatro grupos: los que detectan el fuego en su etapa inicial (detectores de humo y alarmas), los que lo combaten (extintores, hidrantes y rociadores), los que orientan la evacuación (señalamientos y lámparas de emergencia) y el equipo de protección personal de quien responde. Surtimos las cuatro familias con equipo contra incendios certificado bajo normas internacionales y Normas Oficiales Mexicanas, y te ayudamos a ubicarlo en los lugares estratégicos de oficinas, comercios, hoteles, almacenes e industria de alto riesgo.
        </p>
        <a href="/productos/"
           class="inline-flex items-center gap-2 text-xs font-display font-semibold uppercase tracking-wider hover:text-[#FF6B26]"
           style="color:#FF8F57;letter-spacing:0.1em">
          Catálogo de equipo contra incendio
          
        </a>
      </div>
    </div>
  </div>

  <div class="container-site">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {lineas.map((linea) => (
        <CategoryCard
          href={linea.href}
          norm={linea.norm}
          label={linea.label}
          desc={linea.desc}
          items={linea.items}
          ctaLabel={linea.ctaLabel}
          accent={linea.accent}
        />
      ))}
    </div>
  </div>
</section>
