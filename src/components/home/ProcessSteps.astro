---
import { whatsappUrl } from '@data/site';

const steps = [
  {
    n: '01',
    title: 'Consulta y diagnóstico',
    text: 'Analizamos tu operación, nivel de riesgo y normativas aplicables. Detectamos brechas vs. NFPA y NOM-002-STPS. Sin costo, sin compromiso.',
    metric: 'Sin costo · Sin compromiso',
    href: '/contacto', cta: 'Iniciar consulta',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>`,
  },
  {
    n: '02',
    title: 'Cotización formal',
    text: 'Propuesta detallada en menos de 24 horas con fichas técnicas, certificaciones y precios. Plantillas listas para licitación CompraNet, PEMEX y CFE.',
    metric: 'Respuesta < 24 horas hábiles',
    href: whatsappUrl('Hola, necesito una cotización formal de equipos.'), cta: 'Cotizar ahora',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg>`,
  },
  {
    n: '03',
    title: 'Entrega coordinada',
    text: 'Stock permanente para los productos más demandados. 24-48 hrs en CDMX, 3-5 días al resto del país. Embalaje especializado y seguro de envío incluido.',
    metric: '24-48h CDMX · 3-5 días nacional',
    href: '/cobertura', cta: 'Ver cobertura',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>`,
  },
  {
    n: '04',
    title: 'Soporte post-venta',
    text: 'Capacitación de uso, refacciones originales, mantenimiento programado y recordatorios de renovación de equipos según vida útil NFPA 1851.',
    metric: 'Garantía hasta 10 años · NFPA 1851',
    href: '/servicios/mantenimiento', cta: 'Ver servicios',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
  },
];
---

<section style="background:#070E1A;padding-block:5rem" aria-label="Cómo trabajamos">

  <!-- Header -->
  <div class="container-site mb-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end">
      <div>
        <span class="section-eyebrow mb-4 inline-flex">Cómo trabajamos</span>
        <h2 class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
          Un proceso claro<br/>
          <span style="color:#F75000">de consulta a entrega.</span>
        </h2>
      </div>
      <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
        <p class="text-sm leading-relaxed mb-3" style="color:#94A3B8">
          Sin sorpresas, sin demoras. Equipar a un cuerpo de bomberos o una brigada
          industrial requiere precisión técnica y seguimiento profesional.
        </p>
        <p class="text-sm leading-relaxed" style="color:#94A3B8">
          Un solo ejecutivo te acompaña de principio a fin: conoce tu operación, tus
          fechas de licitación y tus criterios técnicos. Cero rotación, cero intermediarios.
        </p>
      </div>
    </div>
  </div>

  <!-- Steps grid full-width -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4" style="border-top:1px solid rgba(74,117,153,0.2)">
    {steps.map((step, i) => (
      <article
        class="grid-cell group relative flex flex-col gap-5 p-8 xl:p-10"
        style={`border-right:${i < 3 ? '1px solid rgba(74,117,153,0.15)' : 'none'};border-bottom:1px solid rgba(74,117,153,0.15)`}
      >
        <!-- Número de fondo -->
        <span class="absolute bottom-4 right-6 font-display font-bold select-none pointer-events-none"
              style="font-size:7rem;line-height:1;color:rgba(44,74,99,0.25)" aria-hidden="true">{step.n}</span>

        <!-- Ícono + número step -->
        <div class="flex items-start justify-between gap-4 relative z-10">
          <div class="w-10 h-10 flex items-center justify-center shrink-0" style="border:1px solid rgba(74,117,153,0.3);color:#FF6B26">
            <span class="w-5 h-5 block" set:html={step.icon}/>
          </div>
          <span class="font-display font-bold text-xs tracking-widest" style="color:rgba(74,117,153,0.5);letter-spacing:0.2em">
            PASO {step.n}
          </span>
        </div>

        <!-- Contenido -->
        <div class="relative z-10 flex flex-col gap-3 flex-1">
          <h3 class="font-display font-bold" style="font-size:1.4rem;color:#FFFFFF;line-height:1.1">
            {step.title}
          </h3>
          <p class="text-sm leading-relaxed" style="color:#64748B">{step.text}</p>
        </div>

        <!-- Métrica -->
        <div class="relative z-10 flex items-center gap-2 text-xs font-semibold" style="color:#34D399">
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true">
            <path d="M20 6L9 17l-5-5"/>
          </svg>
          {step.metric}
        </div>

        <!-- CTA -->
        <a
          href={step.href}
          target={step.href.startsWith('http') ? '_blank' : undefined}
          rel={step.href.startsWith('http') ? 'noopener' : undefined}
          class="relative z-10 flex items-center gap-2 text-xs font-display font-semibold uppercase tracking-wider transition-colors group-hover:text-[#FF6B26]"
          style="color:#4A7599;letter-spacing:0.1em"
        >
          {step.cta}
          <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
      </article>
    ))}
  </div>

</section>
