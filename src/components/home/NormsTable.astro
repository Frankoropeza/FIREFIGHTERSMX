---
/**
 * Tabla de normas y certificaciones — respaldo normativo (SEO: NOM/NFPA keywords).
 */
const norms = [
  { norma: 'NOM-002-STPS-2010', alcance: 'Grado de riesgo de incendio, extintores, brigadas, simulacros y sistemas fijos en centros de trabajo', aplica: 'Todas las empresas con trabajadores en México' },
  { norma: 'NFPA 10 · NOM-154-SCFI', alcance: 'Extintores portátiles: selección e instalación; servicio de mantenimiento y recarga', aplica: 'Todos los inmuebles comerciales e industriales' },
  { norma: 'NFPA 13', alcance: 'Diseño e instalación de rociadores automáticos en edificios residenciales, comerciales e industriales', aplica: 'Naves industriales, almacenes, hoteles y edificios' },
  { norma: 'NFPA 14 · NFPA 20', alcance: 'Hidrantes y gabinetes con manguera; bombas contra incendio y cuarto de bombas', aplica: 'Redes hidráulicas contra incendio' },
  { norma: 'NFPA 72', alcance: 'Detección y alarma de incendio: paneles, detectores de humo y calor, estaciones manuales y notificación', aplica: 'Cualquier inmueble que requiera detección temprana' },
  { norma: 'NFPA 2001', alcance: 'Sistemas de supresión con agentes limpios (FM-200, Novec 1230)', aplica: 'Centros de datos, archivos y cuartos eléctricos' },
  { norma: 'NOM-026-STPS · NOM-003-SSPC-2011', alcance: 'Colores, señales de seguridad e higiene y señalización para protección civil', aplica: 'Centros de trabajo e inmuebles con afluencia de público' },
  { norma: 'NFPA 1970', alcance: 'Conjuntos de protección estructural y de proximidad, equipos SCBA y sistema de alerta PASS (consolida NFPA 1971, 1981 y 1982 desde 2024)', aplica: 'Trajes, cascos, guantes, botas y equipos de respiración para bomberos y brigadas' },
  { norma: 'NFPA 1850', alcance: 'Selección, cuidado y mantenimiento del EPP estructural (antes NFPA 1851)', aplica: 'Programas de inspección y mantenimiento de EPP' },
  { norma: 'NFPA 1960 (antes 1936)', alcance: 'Herramientas de rescate accionadas (hidráulicas, eléctricas y neumáticas)', aplica: 'Rescate vehicular y estructural' },
];
---

<section class="section home-deferred-section" style="background:var(--c-bg)" aria-labelledby="norms-title">
  <div class="container-site">

    <!-- Header -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end mb-12">
      <div>
        <span class="section-eyebrow mb-4 inline-flex">Respaldo normativo</span>
        <h2 id="norms-title" class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
          NOM y NFPA:<br/>
          <span style="color:var(--c-accent)">las normas que respaldan cada compra.</span>
        </h2>
      </div>
      <div style="border-left:2px solid rgba(200,16,46,0.4);padding-left:1.75rem">
        <p class="text-sm leading-relaxed mb-3" style="color:var(--c-text-2)">
          Tener el equipo no basta si no puedes demostrar su conformidad. En una inspección,
          la autoridad verifica certificados de laboratorio acreditado, número de serie,
          vigencia de mantenimiento y bitácora — no solo la presencia física del equipo.
        </p>
        <p class="text-sm leading-relaxed" style="color:var(--c-text-2)">
          Usa esta tabla para saber qué norma debe cumplir cada equipo que compras. Con cada
          entrega te damos la documentación: ficha técnica, certificado de laboratorio acreditado
          y bitácora de mantenimiento, lista para STPS, Protección Civil o CompraNet.
        </p>
      </div>
    </div>

    <!-- Tabla -->
    <div class="overflow-x-auto" style="border:1px solid var(--c-line)">
      <table class="w-full text-left" style="border-collapse:collapse;min-width:760px">
        <caption class="sr-only">Normas NOM y NFPA aplicables a equipos contra incendio en México</caption>
        <thead>
          <tr style="background:var(--c-surface-2)">
            <th scope="col" class="p-5 font-display font-bold text-xs uppercase tracking-widest" style="color:var(--c-ink);border-bottom:1px solid var(--c-line-strong)">Norma / Estándar</th>
            <th scope="col" class="p-5 font-display font-bold text-xs uppercase tracking-widest" style="color:var(--c-ink);border-bottom:1px solid var(--c-line-strong)">Alcance</th>
            <th scope="col" class="p-5 font-display font-bold text-xs uppercase tracking-widest" style="color:var(--c-ink);border-bottom:1px solid var(--c-line-strong)">Aplica a</th>
          </tr>
        </thead>
        <tbody>
          {norms.map((n, i) => (
            <tr style={`background:${i % 2 === 0 ? 'var(--c-surface)' : 'var(--c-bg-alt)'}`}>
              <th scope="row" class="p-5 align-top font-display font-bold text-sm whitespace-nowrap" style="color:var(--c-accent);border-bottom:1px solid var(--c-line)">{n.norma}</th>
              <td class="p-5 align-top text-sm leading-relaxed" style="color:var(--c-text-2);border-bottom:1px solid var(--c-line)">{n.alcance}</td>
              <td class="p-5 align-top text-sm leading-relaxed" style="color:var(--c-muted);border-bottom:1px solid var(--c-line)">{n.aplica}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="text-sm leading-relaxed mt-6 max-w-3xl" style="color:var(--c-muted)">
      ¿No sabes qué normas aplican a tu centro de trabajo? El marco depende del tamaño,
      la actividad y el nivel de riesgo —
      <a href="/certificaciones" class="font-semibold hover:text-[var(--c-accent)]" style="color:var(--c-accent)">consulta la guía completa de certificaciones </a>
    </p>

  </div>
</section>
