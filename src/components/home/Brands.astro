---
import { brands } from '@data/brands';
---

<section class="section-sm border-y border-dark-100 bg-white" aria-label="Marcas distribuidas">
  <div class="container-site">
    <p class="text-center text-dark-400 text-sm uppercase tracking-widest mb-8 font-medium">
      Distribuidores Autorizados de las Mejores Marcas del Mundo
    </p>
    <!-- Marquee / scroll de marcas -->
    <div class="overflow-hidden" aria-hidden="true">
      <div class="flex gap-10 animate-[marquee_30s_linear_infinite] w-max">
        {[...brands, ...brands].map((brand) => (
          <div class="flex items-center gap-2 shrink-0 text-dark-400 hover:text-fire-700 transition-colors cursor-default">
            <span class="text-xl" aria-hidden="true">{brand.emoji}</span>
            <span class="font-semibold text-sm whitespace-nowrap">{brand.name}</span>
          </div>
        ))}
      </div>
    </div>
    <div class="text-center mt-8">
      <a href="/marcas" class="btn-ghost text-sm">
        Ver todas las marcas →
      </a>
    </div>
  </div>
</section>

<style>
  @keyframes marquee {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
