---
const stats = [
  { value: '500+', label: 'Estaciones equipadas' },
  { value: '32', label: 'Estados cubiertos' },
  { value: '15+', label: 'Años de experiencia' },
  { value: '99%', label: 'Clientes satisfechos' },
];
---

<section
  class="relative min-h-[90vh] flex items-center bg-dark-800 overflow-hidden"
  aria-label="Bienvenida a FIREFIGHTERS MX"
>
  <!-- Background -->
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-gradient-to-br from-dark-900 via-fire-900/40 to-dark-800"></div>
    <!-- Decorative grid -->
    <div
      class="absolute inset-0 opacity-10"
      style="background-image: linear-gradient(rgba(192,57,43,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(192,57,43,0.3) 1px, transparent 1px); background-size: 60px 60px;"
      aria-hidden="true"
    ></div>
    <!-- Glow effect -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-fire-700/20 rounded-full blur-3xl" aria-hidden="true"></div>
  </div>

  <div class="container-site relative z-10 py-24 md:py-32 grid lg:grid-cols-2 gap-12 items-center">

    <!-- Content -->
    <div class="flex flex-col gap-8 animate-fade-in">
      <!-- Badge -->
      <div class="flex items-center gap-3">
        <span class="px-3 py-1 bg-fire-700/20 border border-fire-700/40 text-fire-400 text-xs font-semibold rounded-full uppercase tracking-widest">
          🔥 Portal #1 en México
        </span>
        <span class="px-3 py-1 bg-dark-700/50 border border-dark-600 text-dark-300 text-xs font-medium rounded-full">
          Certificado NFPA
        </span>
      </div>

      <!-- Headline -->
      <div>
        <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl font-black text-white leading-[1.08] text-balance">
          Equipo para Bomberos
          <span class="text-gradient-fire block">Profesional y Certificado</span>
          en México
        </h1>
      </div>

      <!-- Sub -->
      <p class="text-dark-300 text-lg md:text-xl leading-relaxed max-w-xl text-pretty">
        Distribuidor autorizado de las marcas líderes mundiales.
        Trajes NFPA, SCBA, herramientas de rescate, sistemas contra incendio
        y capacitación especializada para bomberos, brigadas e industria en los 32 estados.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-4">
        <a href="/productos" class="btn-primary btn-lg group">
          Ver catálogo completo
          <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href="/cotizacion" class="btn bg-white/10 border border-white/20 text-white hover:bg-white/20 btn-lg">
          Solicitar cotización
        </a>
      </div>

      <!-- Trust line -->
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-dark-400">
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          NFPA Certificado
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          Envío express CDMX 24h
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          Factura electrónica
        </div>
        <div class="flex items-center gap-1.5">
          <svg class="w-4 h-4 text-green-500 shrink-0" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
          </svg>
          Soporte para licitaciones
        </div>
      </div>
    </div>

    <!-- Stats + visual -->
    <div class="flex flex-col gap-6 animate-slide-up delay-200">
      <!-- Stats grid -->
      <div class="grid grid-cols-2 gap-4">
        {stats.map((stat) => (
          <div class="bg-white/5 border border-white/10 rounded-2xl p-6 text-center hover:bg-white/10 transition-colors">
            <div class="text-3xl md:text-4xl font-heading font-black text-white">{stat.value}</div>
            <div class="text-dark-400 text-sm mt-1">{stat.label}</div>
          </div>
        ))}
      </div>

      <!-- Brands strip -->
      <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
        <p class="text-dark-400 text-xs uppercase tracking-widest mb-4 text-center">Marcas autorizadas</p>
        <div class="flex flex-wrap justify-center items-center gap-4">
          {['MSA Safety', 'Dräger', '3M Scott', 'Globe Mfg', 'Holmatro', 'Bullard'].map((brand) => (
            <span class="text-dark-300 font-semibold text-sm">{brand}</span>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-dark-400 animate-bounce" aria-hidden="true">
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
    </svg>
  </div>
</section>
