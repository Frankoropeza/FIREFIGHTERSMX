---
/**
 * Barra de accesos rápidos bajo el hero — botones segmentados que ocupan
 * el 100% del ancho del viewport, repartidos en partes iguales.
 */
import { whatsappUrl } from '@data/site';

const links = [
  {
    label: 'Catálogo de productos',
    sub: '9 categorías NFPA · NOM',
    href: '/productos',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>`,
  },
  {
    label: 'Nuestros servicios',
    sub: 'Capacitación · Mantenimiento',
    href: '/servicios',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
  },
  {
    label: 'Equipo para bomberos',
    sub: 'Trajes NFPA 1971 · SCBA',
    href: '/productos/trajes-bombero',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.38 3.46 16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>`,
  },
  {
    label: 'Sistemas contra incendio',
    sub: 'Rociadores · Alarmas NFPA',
    href: '/productos/sistemas-ci',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2z"/><path d="M8 12h8M12 8v8"/></svg>`,
  },
];
---

<nav aria-label="Accesos rápidos" style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.25)">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 w-full">

    {links.map((l, i) => (
      <a
        href={l.href}
        class="quick-link group flex items-center justify-center gap-3 py-5 px-4"
        style={`border-bottom:1px solid rgba(74,117,153,0.15);${i < links.length ? 'border-right:1px solid rgba(74,117,153,0.15);' : ''}`}
      >
        <span class="w-6 h-6 shrink-0 block" style="color:#FF6B26" set:html={l.icon}/>
        <span class="flex flex-col min-w-0">
          <span class="font-display font-bold text-sm uppercase tracking-wider leading-tight group-hover:text-[#FF6B26]" style="color:#FFFFFF;letter-spacing:0.08em">
            {l.label}
          </span>
          <span class="text-[10px] uppercase tracking-widest mt-0.5" style="color:#4A7599">{l.sub}</span>
        </span>
      </a>
    ))}

    <!-- CTA primario -->
    <a
      href={whatsappUrl('Hola, quiero una cotización gratuita de equipo contra incendio.')}
      target="_blank" rel="noopener"
      class="quick-link-cta group flex items-center justify-center gap-3 py-5 px-4"
      style="background:#F75000;border-bottom:1px solid rgba(74,117,153,0.15)"
    >
      <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 24 24" style="color:#FFFFFF" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
      </svg>
      <span class="flex flex-col min-w-0">
        <span class="font-display font-bold text-sm uppercase tracking-wider leading-tight" style="color:#FFFFFF;letter-spacing:0.08em">
          Cotización gratuita
        </span>
        <span class="text-[10px] uppercase tracking-widest mt-0.5" style="color:rgba(255,255,255,0.75)">Respuesta &lt; 24 h</span>
      </span>
    </a>

  </div>
</nav>

<style>
  /* Hover instantáneo, sin transiciones */
  .quick-link { background: #070E1A; }
  .quick-link:hover { background: #0C1825; }
  .quick-link-cta:hover { background: #FF6B26 !important; }
</style>
