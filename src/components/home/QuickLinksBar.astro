---
/**
 * Barra de accesos rápidos bajo el hero — botones a las secciones clave.
 * Sustituye al strip de marcas.
 */
import { whatsappUrl } from '@data/site';

const links = [
  { label: 'Catálogo de productos', href: '/productos' },
  { label: 'Nuestros servicios', href: '/servicios' },
  { label: 'Equipo para bomberos', href: '/productos/trajes-bombero' },
  { label: 'Sistemas contra incendio', href: '/productos/sistemas-ci' },
];
---

<div style="background:#070E1A;border-bottom:1px solid rgba(74,117,153,0.25)">
  <div class="container-site py-6">
    <div class="flex flex-wrap items-center justify-center gap-3">
      {links.map((l) => (
        <a href={l.href} class="btn btn-dark btn-sm">{l.label}</a>
      ))}
      <a
        href={whatsappUrl('Hola, quiero una cotización gratuita de equipo contra incendio.')}
        target="_blank" rel="noopener"
        class="btn btn-primary btn-sm"
      >
        Cotización gratuita
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</div>
