---

<section class="section bg-dark-50" id="categorias">
  <div class="container-site">

    <!-- Header -->
    <div class="text-center mb-12">
      <p class="section-eyebrow mb-3">Catálogo Completo</p>
      <h2 class="section-title mb-4">
        Todos los Equipos que tu
        <span class="text-gradient-fire"> Cuerpo de Bomberos Necesita</span>
      </h2>
      <p class="section-subtitle mx-auto">
        Más de 500 productos certificados NFPA y NOM. Desde EPP personal hasta sistemas
        completos de supresión. Todo en un solo lugar.
      </p>
    </div>

    <!-- Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {categories.map((cat) => (
        <a
          href={`/productos/${cat.slug}`}
          class={`group card p-6 flex flex-col gap-4 hover:shadow-card-hover
                  ${cat.featured ? 'ring-2 ring-fire-700/20' : ''}`}
        >
          <!-- Icon + count -->
          <div class="flex items-start justify-between">
            <div class={`w-12 h-12 rounded-xl flex items-center justify-center ${cat.color}`}>
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <Fragment set:html={cat.icon} />
              </svg>
            </div>
            <span class="text-xs text-dark-400 font-medium">{cat.count}+ productos</span>
          </div>

          <!-- Text -->
          <div class="flex-1">
            <h3 class="font-heading font-bold text-dark-900 mb-2 group-hover:text-fire-700 transition-colors">
              {cat.title}
            </h3>
            <p class="text-sm text-dark-500 leading-relaxed">{cat.description}</p>
          </div>

          <!-- Arrow link -->
          <div class="flex items-center gap-2 text-fire-700 text-sm font-semibold mt-auto">
            Ver productos
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </div>
        </a>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-10">
      <a href="/productos" class="btn-secondary btn-lg">
        Ver catálogo completo (500+ productos)
      </a>
    </div>

  </div>
</section>
