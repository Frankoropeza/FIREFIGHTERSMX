---
/**
 * CTA final — cierre del home. El formulario completo vive en FAQSection;
 * aquí solo conversión directa: WhatsApp + catálogo + teléfono.
 */
import { SITE, whatsappUrl } from '@data/site';
---

<section class="relative overflow-hidden" style="background:#070E1A;padding-block:6rem" aria-labelledby="cta-final-title">

  <!-- Glow central -->
  <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(ellipse 60% 80% at 50% 100%, rgba(247,80,0,0.12) 0%, transparent 70%)" aria-hidden="true"></div>

  <div class="container-site relative z-10 text-center max-w-4xl mx-auto">
    <span class="section-eyebrow mb-6 inline-flex">Cotización sin compromiso</span>

    <h2 id="cta-final-title" class="font-display font-bold mb-6" style="color:#FFFFFF;font-size:clamp(2.25rem,5vw,4rem);line-height:1.02">
      ¿Listo para equipar a quienes<br/>
      <span style="color:#F75000">protegen vidas?</span>
    </h2>

    <p class="text-base leading-relaxed mb-10 max-w-2xl mx-auto" style="color:#94A3B8">
      Mándanos por WhatsApp tu lista de equipo, las bases de tu licitación o simplemente
      cuéntanos tu operación. Regresamos propuesta con precios, fichas técnicas y tiempos
      de entrega en menos de 24 horas hábiles.
    </p>

    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href={whatsappUrl('Hola, quiero una cotización de equipo para bomberos / contra incendio.')}
        target="_blank" rel="noopener"
        class="btn btn-primary btn-lg"
      >
        Cotizar por WhatsApp
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
        </svg>
      </a>
      <a href="/productos" class="btn btn-ghost btn-lg">Ver catálogo completo</a>
    </div>

    <p class="text-xs mt-8 uppercase tracking-widest font-display font-semibold" style="color:#4A7599">
      Respuesta &lt; 24 h hábiles · Fichas técnicas incluidas ·
      <a href={`tel:${SITE.phoneE164}`} class="transition-colors hover:text-[#FF6B26]" style="color:#7AA4C4">Tel. {SITE.phone}</a>
    </p>
  </div>

  <!-- Línea de acento inferior -->
  <div class="absolute bottom-0 left-0 right-0 h-px" style="background:linear-gradient(90deg, transparent, rgba(247,80,0,0.4) 30%, rgba(247,80,0,0.4) 70%, transparent)" aria-hidden="true"></div>
</section>
