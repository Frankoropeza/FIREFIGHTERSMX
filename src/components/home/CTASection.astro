---
/**
 * CTA final — cierre del home en dos columnas:
 * izquierda mensaje, derecha acciones de conversión.
 */
import { SITE, TELEFONO_ACTIVO, CONTACTO_DIRECTO_ACTIVO, whatsappUrl, CANAL_CONTACTO } from '@config/site';
---

<section class="home-deferred-section relative overflow-hidden" style="background:var(--c-bg-alt);padding-block:6rem" aria-labelledby="cta-final-title">


  <div class="container-site relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">

      <!-- Columna izquierda: mensaje -->
      <div>
        <span class="section-eyebrow mb-6 inline-flex">Cotización sin compromiso</span>

        <h2 id="cta-final-title" class="font-display font-bold mb-6" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.02">
          ¿Listo para equipar<br/>
          a quienes <span style="color:var(--c-accent)">protegen vidas?</span>
        </h2>

        <p class="text-base leading-relaxed" style="color:var(--c-text-2)">
          Mándanos por {CANAL_CONTACTO} tu lista de equipo, las bases de tu licitación o
          simplemente cuéntanos tu operación. Regresamos propuesta con precios,
          fichas técnicas y tiempos de entrega en menos de 24 horas hábiles.
        </p>
      </div>

      <!-- Columna derecha: acciones -->
      <div class="flex flex-col gap-4 lg:pl-16" style="border-left:1px solid var(--c-line)">
        <div class="flex flex-col gap-3 lg:max-w-md">
          <a
            href={whatsappUrl('Hola, quiero una cotización de equipo para bomberos / contra incendio.')}
            target="_blank" rel="noopener"
            class="btn btn-primary btn-lg w-full justify-center"
          >
            Cotizar por {CANAL_CONTACTO}
            
          </a>
          <a href="/productos" class="btn btn-ghost btn-lg w-full justify-center">Catálogo de equipo contra incendio</a>
        </div>

        <div class="flex flex-col gap-2 mt-4 lg:max-w-md">
          {[
            'Respuesta en menos de 24 h hábiles',
            'Fichas técnicas y certificados incluidos',
          ].map((t) => (
            <div class="flex items-center gap-3 text-sm" style="color:var(--c-text-2)">
              
              {t}
            </div>
          ))}
          {TELEFONO_ACTIVO && (
<a href={`tel:${SITE.phoneE164}`} class="flex items-center gap-3 text-sm hover:text-[var(--c-accent)]" style="color:var(--c-text-2)">
            
            Tel. {SITE.phone}
          </a>
)}
        </div>
      </div>

    </div>
  </div>

  <!-- Línea de acento inferior -->
  <div class="absolute bottom-0 left-0 right-0 h-px" style="background:linear-gradient(90deg, transparent, rgba(200,16,46,0.4) 30%, rgba(200,16,46,0.4) 70%, transparent)" aria-hidden="true"></div>
</section>
