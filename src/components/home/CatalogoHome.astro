---
/**
 * Catálogo de la portada — sustituye a LineasContraIncendio + ProductCards
 * (que repetían las mismas líneas). Fuente única: src/data/catalogo.ts.
 * Sin animaciones: sólo el botón cambia de estado.
 */
import { catalogo } from '@data/catalogo';
import { imagenLinea } from '@lib/linea-card';
import LineaCard from '@components/products/LineaCard.astro';
---

<section class="section home-deferred-section ch" aria-labelledby="catalogo-heading">
  <div class="container-site ch-head">
    <div>
      <span class="section-eyebrow mb-4 inline-flex">Catálogo contra incendio</span>
      <h2 id="catalogo-heading" class="font-display font-bold ch-h2">
        Equipo contra incendio<br/>
        <span>para cada tipo de riesgo.</span>
      </h2>
    </div>
    <div class="ch-intro">
      <p>
        Los equipos contra incendios se dividen en cuatro grupos: los que detectan el fuego en su etapa inicial (detectores de humo y alarmas), los que lo combaten (extintores, hidrantes y rociadores), los que orientan la evacuación (señalamientos y lámparas de emergencia) y el equipo de protección personal de quien responde. Surtimos las cuatro familias con equipo contra incendios certificado bajo normas internacionales y Normas Oficiales Mexicanas, y te ayudamos a ubicarlo en los lugares estratégicos de oficinas, comercios, hoteles, almacenes e industria de alto riesgo.
      </p>
      <a href="/productos/" class="ch-link">
        Catálogo de equipo contra incendio
      </a>
    </div>
  </div>

  {catalogo.map((familia, fi) => (
    <div class="container-site ch-fam" aria-labelledby={`fam-${familia.slug}`}>
      <header class="ch-fam-head">
        <div>
          <p class="ch-fam-eyebrow">{familia.eyebrow}</p>
          <h3 id={`fam-${familia.slug}`} class="ch-fam-title">{familia.titulo}</h3>
        </div>
        <p class="ch-fam-text">{familia.texto}</p>
      </header>

      <ul class="card-grid ch-grid" role="list">
        {familia.lineas.map((l, i) => {
          // Fila final incompleta (4 por fila): sus cards se ensanchan para cerrar la fila sin huecos.
          const n = familia.lineas.length, r = n % 4, enUltimaFila = r > 0 && i >= n - r;
          const ancho = !enUltimaFila ? '' : r === 1 ? 'ch-span-4' : r === 2 ? 'ch-span-2' : (i === n - r ? 'ch-span-2' : '');
          return (
          <li class={ancho || undefined}>
            <LineaCard href={l.href} norma={l.norma} titulo={l.titulo} texto={l.texto} imagen={imagenLinea(l.slug)} imagenAlt={l.imagenAlt} hijas={l.hijas} cta={l.cta} />
          </li>
          );
        })}
      </ul>

      <div class="ch-hub"><a href={familia.hub.href} class="btn btn-ghost">{familia.hub.label}</a></div>
    </div>
  ))}
</section>

<style>
  /* Catálogo de la portada · v3 — rejilla de 4 columnas en escritorio */
  .ch { background: var(--c-bg); }
  /* Encabezados a dos columnas 50/50: título | texto, separados por una
     regla vertical y centrados entre sí para que ninguna columna quede hueca. */
  .ch-head, .ch-fam-head { display: grid; gap: 1.25rem; }
  @media (min-width: 1024px) {
    .ch-head, .ch-fam-head { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0; align-items: center; }
    .ch-head > :first-child, .ch-fam-head > :first-child { padding-right: 3rem; }
    .ch-head > :last-child, .ch-fam-head > :last-child { padding-left: 3rem; border-left: 1px solid var(--c-line); }
    .ch-intro p, .ch-fam-text { text-align: justify; hyphens: auto; }
  }
  .ch-head { margin-bottom: 3rem; padding-bottom: 3rem; border-bottom: 1px solid var(--c-line); }
  /* Escala ligada a la mitad del contenedor: la línea más larga («para cada
     tipo de riesgo.» ≈ 11.45em) ocupa ~93 % de su columna sin partirse. */
  .ch-h2 { margin: 0; color: var(--c-ink); font-size: clamp(1.625rem, 7.2vw, 2.5rem); line-height: 1.05; letter-spacing: -.025em; text-wrap: balance; }
  @media (min-width: 1024px) { .ch-h2 { font-size: clamp(2rem, calc(4.1vw - 8px), 4.25rem); } }
  .ch-h2 span { color: var(--c-accent); }
  .ch-intro p { margin: 0 0 1rem; font-size: 1rem; line-height: 1.75; color: var(--c-text-2); }
  .ch-link { display: inline-flex; align-items: center; gap: .5rem; font-size: .875rem; font-weight: 600; color: var(--c-accent); text-decoration: none; }
  .ch-link:hover { color: var(--c-accent-hover); text-decoration: underline; text-underline-offset: 3px; }

  /* Familia */
  .ch-fam + .ch-fam { margin-top: 4rem; padding-top: 4rem; border-top: 1px solid var(--c-line); }
  .ch-fam-head { margin-bottom: 2rem; }
  .ch-fam-eyebrow { margin: 0; font-size: .75rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--c-accent); }
  .ch-fam-title { margin: .375rem 0 0; font-family: var(--font-display); font-size: clamp(1.5rem, 2.4vw, 2.125rem); font-weight: 700; letter-spacing: -.02em; line-height: 1.2; color: var(--c-ink); text-wrap: balance; }
  .ch-fam-text { margin: 0; font-size: 1rem; line-height: 1.7; color: var(--c-text-2); }

  /* Rejilla: 1 · 2 · 4 columnas */
  .ch-grid { margin: 0; padding: 0; list-style: none; }
  /* Cards que cierran una fila incompleta: ocupan 2 (o 4) columnas y pasan a
     formato horizontal (imagen a la izquierda, contenido a la derecha). */
  @media (min-width: 1024px) {
    .ch-span-2 { grid-column: span 2; }
    .ch-span-4 { grid-column: span 4; }
    .ch-span-2 :global(.lc), .ch-span-4 :global(.lc) { flex-direction: row; }
    .ch-span-2 :global(.lc-media), .ch-span-4 :global(.lc-media) { flex: 0 0 46%; aspect-ratio: auto; min-height: 100%; }
    .ch-span-4 :global(.lc-media) { flex-basis: 40%; }
    .ch-span-2 :global(.lc-body), .ch-span-4 :global(.lc-body) { padding: 1.5rem; }
  }

  .ch-hub { display: flex; justify-content: flex-end; margin-top: 1.75rem; }
  @media (max-width: 639px) { .ch-hub .btn { width: 100%; white-space: normal; text-align: center; } }
</style>
