---

<section style="background:#040A12;padding-block:5rem" aria-label="Catálogo de productos">

  <!-- Header -->
  <div class="container-site mb-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end">
      <div>
        <span class="section-eyebrow mb-4 inline-flex">Catálogo</span>
        <h2 class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
          Ocho categorías,<br/>
          <span style="color:#F75000">un solo proveedor.</span>
        </h2>
      </div>
      <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
        <p class="text-sm leading-relaxed mb-3" style="color:#94A3B8">
          Todo el equipamiento que un cuerpo de bomberos, brigada industrial o área de protección civil necesita:
          <strong style="color:#CBD5E1">trajes NFPA 1971, SCBA, herramientas de rescate, extintores, sistemas CI, cámaras térmicas y HAZMAT</strong> —
          cada categoría con ficha técnica y certificado listos.
        </p>
        <a href="/productos"
           class="inline-flex items-center gap-2 text-xs font-display font-semibold uppercase tracking-wider hover:text-[#FF6B26]"
           style="color:#FF8F57;letter-spacing:0.1em">
          Ver catálogo completo
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Cards grid -->
  <div class="container-site">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {cards.map((card) => (
        <a
          href={card.href}
          class="group relative flex flex-col overflow-hidden"
          style="background:#080F1A;border:1px solid rgba(74,117,153,0.18);:border-color 0.2s,transform 0.2s"
          onmouseover="this.style.borderColor='rgba(247,80,0,0.45)';this.style.transform='translateY(-3px)'"
          onmouseout={`this.style.borderColor='rgba(74,117,153,0.18)';this.style.transform='translateY(0)'`}
        >
          <!-- Visual top: gradient + icon -->
          <div class="relative flex items-center justify-center overflow-hidden" style="height:148px">
            <!-- Background gradient -->
            <div class="absolute inset-0" style={`background:linear-gradient(135deg, ${card.gradFrom} 0%, ${card.gradTo} 100%)`}></div>
            <!-- Grid pattern overlay -->
            <svg class="absolute inset-0 w-full h-full" style="opacity:0.06" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <defs>
                <pattern id={`g-${card.titulo.replace(/\s/g,'')}`} width="32" height="32" patternUnits="userSpaceOnUse">
                  <path d="M 32 0 L 0 0 0 32" fill="none" stroke="#7AA4C4" stroke-width="0.5"/>
                </pattern>
              </defs>
              <rect width="100%" height="100%" fill={`url(#g-${card.titulo.replace(/\s/g,'')})`}/>
            </svg>
            <!-- Glow spot -->
            <div class="absolute inset-0 pointer-events-none" style={`background:radial-gradient(circle at 50% 50%, ${card.accent}22 0%, transparent 65%)`}></div>
            <!-- Icon -->
            <div class="relative z-10 flex items-center justify-center rounded-full"
                 style={`width:72px;height:72px;background:rgba(4,10,18,0.7);border:1.5px solid ${card.accent}44;color:${card.accent}`}>
              <span class="block" style="width:32px;height:32px" set:html={card.icon}/>
            </div>
            <!-- Bottom fade -->
            <div class="absolute bottom-0 left-0 right-0 h-8 pointer-events-none"
                 style="background:linear-gradient(to bottom, transparent, #080F1A)"></div>
          </div>

          <!-- Content -->
          <div class="flex flex-col flex-1 p-5 gap-3">
            <!-- Norm badge -->
            <span class="text-[9px] font-display font-semibold uppercase tracking-widest" style="color:#4A7599">{card.norm}</span>

            <!-- Title -->
            <h3 class="font-display font-bold text-lg leading-tight" style="color:#FFFFFF">
              {card.titulo}
            </h3>

            <!-- Description -->
            <p class="text-xs leading-relaxed" style="color:#64748B;flex:1">
              {card.desc}
            </p>

            <!-- Items list -->
            <ul class="flex flex-col gap-1.5 py-3" style="border-top:1px solid rgba(74,117,153,0.12);border-bottom:1px solid rgba(74,117,153,0.12)">
              {card.items.map(item => (
                <li class="flex items-center gap-2 text-[11px]" style="color:#64748B">
                  <span class="w-1 h-1 rounded-full shrink-0" style={`background:${card.accent};opacity:0.7`}></span>
                  {item}
                </li>
              ))}
            </ul>

            <!-- CTA button -->
            <div class="pt-1">
              <span
                class="inline-flex items-center gap-2 w-full justify-center text-xs font-display font-semibold uppercase tracking-wider py-2.5 px-4"
                style={`color:#040A12;background:${card.accent};letter-spacing:0.08em`}
              >
                Ver productos
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
                </svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>

</section>
