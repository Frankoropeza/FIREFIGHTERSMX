---
/**
 * Catálogo en el home — 8 categorías (sin drones) con la card compartida
 * CategoryCard. Fuente única de datos: src/data/categories.ts
 */
import CategoryCard from '@components/products/CategoryCard.astro';
import { allCategories } from '@data/categories';

const cards = allCategories.filter((c) => c.slug !== 'drones-emergencia');
---

<section style="background:#040A12;padding-block:5rem" aria-label="Catálogo de productos">

  <!-- Header -->
  <div class="container-site mb-12">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-20 items-end">
      <div>
        <span class="section-eyebrow mb-4 inline-flex">Catálogo</span>
        <h2 class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
          Ocho categorías,<br/>
          <span style="color:#F75000">un solo proveedor.</span>
        </h2>
      </div>
      <div style="border-left:2px solid rgba(247,80,0,0.4);padding-left:1.75rem">
        <p class="text-sm leading-relaxed mb-3" style="color:#94A3B8">
          Todo el equipamiento que un cuerpo de bomberos, brigada industrial o área de protección civil necesita:
          <strong style="color:#CBD5E1">trajes NFPA 1971, SCBA, herramientas de rescate, extintores, sistemas CI, cámaras térmicas y HAZMAT</strong> —
          cada categoría con ficha técnica y certificado listos.
        </p>
        <a href="/productos"
           class="inline-flex items-center gap-2 text-xs font-display font-semibold uppercase tracking-wider hover:text-[#FF6B26]"
           style="color:#FF8F57;letter-spacing:0.1em">
          Ver catálogo completo
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Cards grid -->
  <div class="container-site">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {cards.map((cat) => <CategoryCard cat={cat} />)}
    </div>
  </div>

</section>
