---
const props = [
  {
    n: '01',
    title: 'Distribución directa',
    text: 'Contratos activos con Globe, MSA, Dräger, Bullard, Holmatro y 3M Scott. Equipos originales con número de serie verificable con fábrica. Sin intermediarios.',
    metric: '16+ marcas autorizadas',
    href: '/marcas',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>`,
  },
  {
    n: '02',
    title: 'Certificación verificable',
    text: 'NFPA 1971, 1981, 1977, NOM-002-STPS, UL Listed, ISO 9001. Cada equipo incluye ficha técnica y certificado de laboratorio acreditado de tercera parte.',
    metric: '100% con documentación técnica',
    href: '/certificaciones',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/></svg>`,
  },
  {
    n: '03',
    title: 'Asesoría especializada',
    text: 'Técnicos certificados en NFPA y NOM-002-STPS. Cotización técnica en menos de 24 horas con fichas listas para CompraNet, PEMEX y CFE.',
    metric: 'Respuesta < 24 horas',
    href: '/cotizacion',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
  },
  {
    n: '04',
    title: 'Soporte post-venta',
    text: 'Garantía de fábrica, refacciones originales, mantenimiento programado y alertas de renovación. La relación no termina con la entrega del equipo.',
    metric: 'Garantía hasta 10 años',
    href: '/servicios/mantenimiento',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
  },
];
---

<section style="background:#070E1A;padding-block:5rem" aria-label="Por qué elegirnos">

  <!-- Header dentro de container -->
  <div class="container-site mb-12">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6">
      <div>
        <span class="section-eyebrow mb-4 inline-flex">Por qué elegirnos</span>
        <h2 class="font-display font-bold" style="color:#FFFFFF;font-size:clamp(2rem,4vw,3.25rem);line-height:1.05">
          Cuatro pilares.<br/>
          <span style="color:#F75000">Sin compromisos.</span>
        </h2>
      </div>
      <p class="text-sm max-w-xs leading-relaxed sm:text-right" style="color:#64748B">
        Más de 15 años equipando cuerpos de bomberos, brigadas industriales y protección civil en México.
      </p>
    </div>
  </div>

  <!-- Grid full-width -->
  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4" style="border-top:1px solid rgba(74,117,153,0.2)">
    {props.map((p, i) => (
      <a
        href={p.href}
        class="group relative flex flex-col gap-5 p-8 xl:p-10"
        style={`background:#0C1825;border-right:${i < 3 ? '1px solid rgba(74,117,153,0.15)' : 'none'};border-bottom:1px solid rgba(74,117,153,0.15)`}
        onmouseover="this.style.background='#122133'"
        onmouseout="this.style.background='#0C1825'"
      >
        <!-- Número gigante de fondo -->
        <span class="absolute bottom-4 right-6 font-display font-bold select-none pointer-events-none"
              style="font-size:7rem;line-height:1;color:rgba(44,74,99,0.25)" aria-hidden="true">{p.n}</span>

        <!-- Top: ícono + métrica -->
        <div class="flex items-start justify-between gap-4 relative z-10">
          <div class="w-10 h-10 flex items-center justify-center shrink-0" style="border:1px solid rgba(74,117,153,0.3);color:#FF6B26">
            <span class="w-5 h-5 block" set:html={p.icon}/>
          </div>
          <span class="text-xs font-display font-semibold uppercase tracking-wider text-right" style="color:#34D399;letter-spacing:0.08em">
            ✓ {p.metric}
          </span>
        </div>

        <!-- Contenido -->
        <div class="relative z-10 flex flex-col gap-3 flex-1">
          <h3 class="font-display font-bold" style="font-size:1.5rem;color:#FFFFFF;line-height:1.1">
            {p.title}
          </h3>
          <p class="text-sm leading-relaxed" style="color:#64748B">{p.text}</p>
        </div>

        <!-- CTA -->
        <div class="relative z-10 flex items-center gap-2 text-xs font-display font-semibold uppercase tracking-wider" style="color:#4A7599;letter-spacing:0.1em">
          Ver más
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </div>
      </a>
    ))}
  </div>
</section>
