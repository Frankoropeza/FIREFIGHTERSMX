---
import CardMedia from '@components/common/CardMedia.astro';

const props = [
  {
    n: '01',
    title: 'Distribución directa',
    img: '/images/home/por-que-distribucion-directa.avif',
    alt: 'Almacén con equipo contra incendio y para bomberos listo para envío',
    text: 'Contratos activos con Tyco, Honeywell, Globe, MSA, Dräger, Bullard, Holmatro y 3M Scott. Equipos originales con número de serie verificable con fábrica. Sin intermediarios.',
    metric: '16+ marcas autorizadas',
    href: '/marcas',
    icon: ``,
  },
  {
    n: '02',
    title: 'Certificación verificable',
    img: '/images/home/por-que-certificacion-verificable.avif',
    alt: 'Certificado técnico junto a un casco de bombero',
    text: 'NFPA 1970 (antes 1971/1981), NFPA 1950, NOM-002-STPS, UL Listed, ISO 9001. Cada equipo incluye ficha técnica y certificado de laboratorio acreditado de tercera parte.',
    metric: '100% con documentación técnica',
    href: '/certificaciones',
    icon: ``,
  },
  {
    n: '03',
    title: 'Asesoría especializada',
    img: '/images/home/por-que-asesoria-especializada.avif',
    alt: 'Ingeniero revisando planos de protección contra incendio',
    text: 'Técnicos certificados en NFPA y NOM-002-STPS. Cotización técnica en menos de 24 horas con fichas listas para CompraNet, PEMEX y CFE.',
    metric: 'Respuesta < 24 horas',
    href: '/cotizacion',
    icon: ``,
  },
  {
    n: '04',
    title: 'Soporte post-venta',
    img: '/images/home/por-que-soporte-postventa.avif',
    alt: 'Técnico dando servicio a un regulador de equipo de respiración',
    text: 'Garantía de fábrica, refacciones originales, mantenimiento programado y alertas de renovación. La relación no termina con la entrega del equipo.',
    metric: 'Garantía hasta 10 años',
    href: '/servicios/mantenimiento',
    icon: ``,
  },
];
---

<section class="home-deferred-section" style="background:var(--c-bg-alt);padding-block:5rem" aria-label="Por qué elegirnos">

  <!-- Header dentro de container -->
  <div class="container-site mb-12">
    <div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-6">
      <div>
        <span class="section-eyebrow mb-4 inline-flex">Por qué elegirnos</span>
        <h2 class="font-display font-bold" style="color:var(--c-ink);font-size:clamp(1.75rem,3vw,2.5rem);line-height:1.05">
          Equipo contra incendio certificado<br/>
          <span style="color:var(--c-accent)">con respaldo de fábrica.</span>
        </h2>
      </div>
      <p class="text-sm max-w-xs leading-relaxed sm:text-right" style="color:var(--c-muted)">
        35 años equipando empresas, industria, cuerpos de bomberos y protección civil en México.
      </p>
    </div>
  </div>

  <!-- Grid full-width -->
  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4" style="border-top:1px solid var(--c-line)">
    {props.map((p, i) => (
      <a
        href={p.href}
        class="group relative flex flex-col gap-5 p-8 xl:p-10"
        style={`background:var(--c-surface);border-right:${i < 3 ? '1px solid var(--c-line)' : 'none'};border-bottom:1px solid var(--c-line)`}
        onmouseover="this.style.background='#F2F4F7'"
        onmouseout="this.style.background='#FFFFFF'"
      >
        <!-- Número gigante de fondo -->
        

        <CardMedia src={p.img} alt={p.alt} class="relative z-10" />

        <!-- Top: ícono + métrica -->
        <div class="flex items-start justify-between gap-4 relative z-10">
          <span class="text-xs font-display font-semibold uppercase tracking-wider text-right" style="color:var(--c-success);letter-spacing:0.08em">
            Sí {p.metric}
          </span>
        </div>

        <!-- Contenido -->
        <div class="relative z-10 flex flex-col gap-3 flex-1">
          <h3 class="font-display font-bold" style="font-size:1.5rem;color:var(--c-ink);line-height:1.1">
            {p.title}
          </h3>
          <p class="text-sm leading-relaxed" style="color:var(--c-muted)">{p.text}</p>
        </div>

        <!-- CTA -->
        <div class="relative z-10 flex items-center gap-2 text-xs font-display font-semibold uppercase tracking-wider" style="color:var(--forge-300);letter-spacing:0.1em">
          Conocer INPROSEG FIRE
          
        </div>
      </a>
    ))}
  </div>
</section>
