# ─── SITE ────────────────────────────────────────────────────────────────────
PUBLIC_SITE_URL=https://firefightersmx.com
PUBLIC_SITE_NAME="FIREFIGHTERS MX"

# ─── CONTACT ─────────────────────────────────────────────────────────────────
PUBLIC_WHATSAPP_NUMBER=525512345678
PUBLIC_PHONE=5512345678
PUBLIC_EMAIL=contacto@firefightersmx.com

# ─── ANALYTICS ───────────────────────────────────────────────────────────────
PUBLIC_GA_ID=G-XXXXXXXXXX
PUBLIC_GTM_ID=GTM-XXXXXXX
PUBLIC_FB_PIXEL_ID=

# ─── FORMS ───────────────────────────────────────────────────────────────────
# Resend / EmailJS / etc.
RESEND_API_KEY=

# ─── MAPS ────────────────────────────────────────────────────────────────────
PUBLIC_GOOGLE_MAPS_KEY=

# ─── DIRECTORIO / DATOS ──────────────────────────────────────────────────────
# Token del API del DENUE (INEGI). Gratuito, se solicita con un correo en:
# https://www.inegi.org.mx/app/api/denue/v1/tokenVerify.aspx
# Uso: extraccion de empresas por palabra clave, estado por estado.
# NUNCA commitear el valor real: va en .env, que esta en .gitignore.
DENUE_TOKEN=
